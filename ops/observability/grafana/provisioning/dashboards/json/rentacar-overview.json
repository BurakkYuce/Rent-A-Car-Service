{
  "uid": "racar-overview",
  "title": "RentACar — Genel Bakış (RED + İş KPI)",
  "tags": ["rentacar"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Servis",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_server_request_duration_seconds_count, service_name)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "title": "İstek hızı (req/s)", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [ { "refId": "A",
        "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[5m]))",
        "legendFormat": "{{service_name}}" } ]
    },
    {
      "id": 2, "title": "Hata oranı (5xx %)", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [ { "refId": "A",
        "expr": "100 * sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\",service_name=~\"$service\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[5m])), 1)",
        "legendFormat": "5xx %" } ]
    },
    {
      "id": 3, "title": "Gecikme p95 (sn)", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [ { "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\"}[5m])))",
        "legendFormat": "{{service_name}}" } ]
    },
    {
      "id": 4, "title": "Login (başarı/başarısız)", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [ { "refId": "A",
        "expr": "sum by (result) (rate(racar_login_total[5m]))",
        "legendFormat": "{{result}}" } ]
    },
    {
      "id": 5, "title": "Tahsilat + defter red + rate-limit red", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (rate(racar_tahsilat_total[5m]))", "legendFormat": "tahsilat {{result}}" },
        { "refId": "B", "expr": "sum(rate(racar_ledger_idempotent_reject_total[5m]))", "legendFormat": "defter idempotent red" },
        { "refId": "C", "expr": "sum(rate(racar_ratelimit_reject_total[5m]))", "legendFormat": "rate-limit red" }
      ]
    },
    {
      "id": 6, "title": "Job hataları", "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [ { "refId": "A",
        "expr": "sum by (job) (increase(racar_job_fail_total[1h]))",
        "legendFormat": "{{job}}" } ]
    },
    {
      "id": 7, "title": "Son loglar (hata/uyarı)", "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [ { "refId": "A",
        "expr": "{service_name=~\"rentacar-.*\"} | json | level=~\"Error|Warning\"" } ]
    }
  ]
}
