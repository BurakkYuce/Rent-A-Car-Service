# RentACar observability yığını — .env örneği. `cp .env.example .env` yapıp DOLDUR (secret'ları commit'leme).

# Grafana admin şifresi (ZORUNLU — compose açılışta reddeder). Güçlü seç: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=<buraya-guclu-sifre>

# Alarm webhook Bearer anahtarı — UYGULAMADAKİ Observability:AlertToken ile AYNI olmalı. openssl rand -base64 32
# Uygulama tarafında: appsettings/env → Observability__AlertToken=<aynı-değer>
ALERT_TOKEN=<buraya-uzun-rastgele-anahtar>

# Grafana alarm webhook'unun ulaşacağı uygulama adresi (host'ta çalışan Web).
# Docker → host için host.docker.internal; ters-proxy arkasındaysa iç adresi ver.
ALERT_URL=http://host.docker.internal:5220/internal/alert
