@page "/musaitlik"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("public-search")]
@using RentACar.Application.Branches
@using RentACar.Application.Common
@using RentACar.Application.Fleet
@using RentACar.PublicSite.Components.Shared
@inject FleetShowcaseService Showcase
@inject BranchService Subeler

<PageTitle>Müsaitlik ve Fiyat — @(_branding?.Marka ?? "RentPro")</PageTitle>

<SayfaMeta Baslik="@($"Müsaitlik ve Fiyat — {_branding?.Marka ?? "RentPro"}")"
           Aciklama="@($"{_branding?.Marka ?? "Firmamız"} filosunda tarihlerinize göre müsait araçları ve net günlük fiyatı görün. Kayıt gerekmez, teklif bırakmak ücretsizdir.")"
           Yol="/musaitlik" Marka="_branding" KanonikKok="@_kanonikKok" />

<div class="container">
    <a class="back-link" href="/">← Ana sayfa</a>
    <h1>Müsaitlik ve Fiyat Sorgula</h1>

    @if (!string.IsNullOrEmpty(_hata))
    {
        <p class="empty-state">@_hata</p>
    }

    @* PR-19: form ORTAK bileşene çıkarıldı (T4) — Hero ile aynı alan adları/doğrulama.
       GET-querystring deseni korunuyor: JS yok, paylaşılabilir/geri-tuşuna dost URL. *@
    <AramaFormu Bas="@Bas" Bit="@Bit" Sube="@Sube" Subeler="_subeler" />

    @if (_arandi)
    {
        @* ---- (a) TARİH SEÇİLMİŞ: gerçek müsaitlik + dönem toplamı ---- *@
        @if (_sonuclar is { Count: > 0 })
        {
            <p class="muted-note"><strong>@_sonuclar.Count araç</strong> müsait ·
                @_sonuclar[0].Gun günlük kiralama · fiyatlar seçtiğiniz gün sayısına göre hesaplandı.</p>
            <div class="grid">
                @foreach (var r in _sonuclar)
                {
                    <AracKarti Slug="@r.Slug" Baslik="@r.Baslik" CoverPhotoId="r.CoverPhotoId"
                               YilAralik="@r.YilAralik" GunlukFiyat="r.GunlukFiyat" KdvDahil="r.KdvDahil"
                               Ozellikler="r.Ozellikler" Gun="r.Gun" Toplam="r.Toplam" Adet="r.Adet"
                               TeklifLinki="@TeklifLinki(r.Slug, r.GunlukFiyat)" />
                }
            </div>
        }
        else
        {
            @* PR-20: eskiden burada tek cümle vardı ve ziyaretçi ÇIKMAZ SOKAKTA kalıyordu.
               Sonuç yoksa bile üç çıkış yolu sunulur: tarihi değiştir (form yukarıda), tüm filoyu
               gör, ya da doğrudan ulaş. Metin bir vaat içermez — yalnız durumu söyler. *@
            <p class="empty-state">Seçtiğiniz tarihlerde müsait araç bulunamadı.</p>
            <p class="ust-linkler">
                <a href="/musaitlik">Tüm filoyu gör</a>
                <a href="/iletisim">Bize ulaşın</a>
            </p>
            <p class="muted small">Tarihleri biraz esnetmek çoğu zaman sonucu değiştirir;
                yukarıdaki formdan yeniden deneyebilirsiniz.</p>
        }
    }
    else if (_filo is { Count: > 0 })
    {
        @* ---- (b) TARİH YOK: misafir filoyu serbestçe geziyor ----
           Tarih girmek ZORUNLU DEĞİL. Eskiden iki alan da `required`'dı ve tarihsiz açılan sayfa
           bomboş kalıyordu: "önce ne zaman gideceğime karar vereyim" diyen ziyaretçi araçları
           HİÇ göremiyordu. Artık tüm yayındaki filo, günlük fiyatlarıyla listelenir.

           BURADA "müsait" DENMEZ: tarih olmadan hangi aracın boşta olduğu bilinemez. Kart adet
           çipi de "9 araç" der, "9 araç müsait" demez (bkz. AracKarti). Yanlış söz vermemek,
           ziyaretçiyi tarih girmeye zorlamaktan daha önemli. *@
        <p class="muted-note"><strong>@_filo.Count araç</strong> · günlük fiyatlar aşağıda.
            Tarih girerseniz o aralıkta <strong>gerçekten boşta olanları</strong> ve
            seçtiğiniz gün sayısına göre toplam tutarı gösteririz.</p>
        <div class="grid">
            @foreach (var k in _filo)
            {
                <AracKarti Slug="@k.Slug" Baslik="@k.Baslik" CoverPhotoId="k.CoverPhotoId"
                           YilAralik="@k.YilAralik" GunlukFiyat="k.GunlukFiyat" KdvDahil="k.KdvDahil"
                           Ozellikler="k.Ozellikler" Adet="k.Adet"
                           TeklifLinki="@TeklifLinki(k.Slug, k.GunlukFiyat)" />
            }
        </div>
    }
    else if (_filo is { Count: 0 })
    {
        <p class="empty-state">Şu anda sitede yayınlanmış araç yok.</p>
        <p class="ust-linkler"><a href="/iletisim">Bize ulaşın</a></p>
    }
</div>

@* Ana sayfa ve detayla AYNI kapanış çağrısı — anlatı tek yerde. *@
<BolumCta Telefon="@_branding?.Tel" WhatsApp="@_branding?.WhatsApp" />

@code {
    [CascadingParameter] public HttpContext? Http { get; set; }

    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }
    [SupplyParameterFromQuery(Name = "sube")] public string? Sube { get; set; }

    private FleetBranding? _branding;
    private string? _kanonikKok;
    private IReadOnlyList<string> _subeler = [];
    private IReadOnlyList<PublicAvailabilityResult>? _sonuclar;
    /// <summary>Tarihsiz mod: yayındaki TÜM filo (müsaitlik süzgeci uygulanmadan).</summary>
    private IReadOnlyList<FleetShowcaseCard>? _filo;
    private bool _arandi;
    private string? _hata;

    /// <summary>PR-8 talep formuna bağlam taşır: İLAN + tarihler + ziyaretçinin GÖRDÜĞÜ fiyat (snapshot).
    /// Fiyat InvariantCulture ile yazılır — tr-TR virgülü query string'de yanlış ayrıştırılırdı.
    /// Tarihler BOŞ olabilir (misafir tarihsiz geziyorsa): talep formu onları kendisi sorar.</summary>
    private string TeklifLinki(string slug, decimal gunlukFiyat)
    {
        var q = System.Web.HttpUtility.ParseQueryString(string.Empty);
        q["ilan"] = slug; // slug: sayfa ilanı yeniden çözer (yayından kalkmışsa fiyat/başlık taşınmaz)
        if (!string.IsNullOrWhiteSpace(Bas)) q["bas"] = Bas;
        if (!string.IsNullOrWhiteSpace(Bit)) q["bit"] = Bit;
        if (!string.IsNullOrWhiteSpace(Sube)) q["sube"] = Sube;
        q["fiyat"] = gunlukFiyat.ToString(System.Globalization.CultureInfo.InvariantCulture);
        return "/rezervasyon-talebi?" + q;
    }

    protected override async Task OnInitializedAsync()
    {
        _branding = await Showcase.GetBrandingAsync();
        if (Http is not null) _kanonikKok = $"https://{Http.Request.Host.Value}";
        _subeler = (await Subeler.ListActiveAsync()).Select(s => s.Ad).ToList();

        var bas = ParseDate(Bas);
        var bit = ParseDate(Bit);

        // İKİ tarih de girilmemişse (ya da yalnız biri girilmişse) müsaitlik HESAPLANMAZ — tek
        // tarihten aralık uydurmak ziyaretçinin niyetini varsaymak olurdu. Bunun yerine filo
        // listelenir; ziyaretçi isterse ikinci tarihi girip daraltır.
        if (bas is null || bit is null)
        {
            _filo = await Showcase.ListShowcaseGroupsAsync();
            return;
        }

        _arandi = true;
        try
        {
            _sonuclar = await Showcase.SearchAvailabilityAsync(bas.Value, bit.Value,
                string.IsNullOrWhiteSpace(Sube) ? null : Sube);
        }
        catch (ValidationException ex)
        {
            // Geçersiz aralık (ör. iade < alış): hata gösterilir AMA ziyaretçi boş sayfada
            // bırakılmaz — filo yine listelenir, düzeltip yeniden deneyebilir.
            _hata = ex.Message;
            _arandi = false;
            _filo = await Showcase.ListShowcaseGroupsAsync();
        }
    }

    private static DateTimeOffset? ParseDate(string? s)
        => DateTimeOffset.TryParse(s, out var d) ? new DateTimeOffset(d.Date, TimeSpan.Zero) : null;
}
