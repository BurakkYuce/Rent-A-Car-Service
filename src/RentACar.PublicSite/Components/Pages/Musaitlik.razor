@page "/musaitlik"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("public-search")]
@using RentACar.Application.Branches
@using RentACar.Application.Common
@using RentACar.Application.Fleet
@using RentACar.PublicSite.Components.Shared
@inject FleetShowcaseService Showcase
@inject BranchService Subeler

<PageTitle>Müsaitlik ve Fiyat — @(_branding?.Marka ?? "RentPro")</PageTitle>

<SayfaMeta Baslik="@($"Müsaitlik ve Fiyat — {_branding?.Marka ?? "RentPro"}")"
           Aciklama="@($"{_branding?.Marka ?? "Firmamız"} filosunda tarihlerinize göre müsait araçları ve net günlük fiyatı görün. Kayıt gerekmez, teklif bırakmak ücretsizdir.")"
           Yol="/musaitlik" Marka="_branding" KanonikKok="@_canonicalRoot" />

<Breadcrumbs Items="Crumbs" KanonikKok="@_crumbRoot" />

<div class="wrap sayfa-ust">
    <h1>Müsait araçlar ve fiyatlar</h1>
    <p class="giris">Alış ve iade tarihini girin; o aralıkta boşta olan araçları ve gün sayısına göre toplam
        fiyatı gösterelim. Tarih girmeden de tüm filoya göz atabilirsiniz.</p>

    @* PR-19: form ORTAK bileşen (T4) — Hero ile aynı alan adları/doğrulama. GET-querystring: JS yok,
       paylaşılabilir/geri-tuşuna dost URL. `ilan` taşınır: ilan detayından gelindiyse o araç öne alınır. *@
    <AramaFormu Satir="true" Bas="@Bas" Bit="@Bit" BasSaat="@BasSaat" BitSaat="@BitSaat" Sube="@Sube" Ilan="@Ilan"
                Subeler="_branches" ButonMetni="Ara" />

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="not-kutu hata" role="alert">@_error</p>
    }
</div>

<div class="wrap">
    @* Sonuç da tarihsiz filo da aynı Fleet slotuyla çizilir; kartlar, özet ve boş durum aşağıda (BuildList). *@
    @if (_list is not null)
    {
        <ThemedFleet Model="_list" />
    }
</div>

@* Ana sayfa ve detayla AYNI kapanış çağrısı — anlatı tek yerde. *@
<BolumCta Telefon="@_branding?.Tel" WhatsApp="@_branding?.WhatsApp" />

@code {
    [CascadingParameter] public HttpContext? Http { get; set; }

    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }
    /// <summary>V0: alış/iade saati ("HH:mm", İstanbul). İkisi de geçerliyse arama o saatlerle yapılır; biri bile
    /// yoksa ESKİ davranış (yalnız günler) — saatsiz eski bağlantılar ve paylaşılmış adresler aynı sonucu verir.</summary>
    [SupplyParameterFromQuery(Name = "basSaat")] public string? BasSaat { get; set; }
    [SupplyParameterFromQuery(Name = "bitSaat")] public string? BitSaat { get; set; }
    [SupplyParameterFromQuery(Name = "sube")] public string? Sube { get; set; }
    /// <summary>İlan detayından gelindiyse o ilanın slug'ı — sonuçta öne alınır.</summary>
    [SupplyParameterFromQuery(Name = "ilan")] public string? Ilan { get; set; }
    /// <summary>Süzgeç (FleetFilter): boyut başına birden çok değer (`?vites=Otomatik&vites=Manuel`).</summary>
    [SupplyParameterFromQuery(Name = "sinif")] public string[]? Sinif { get; set; }
    [SupplyParameterFromQuery(Name = "vites")] public string[]? Vites { get; set; }
    [SupplyParameterFromQuery(Name = "yakit")] public string[]? Yakit { get; set; }
    [SupplyParameterFromQuery(Name = "koltuk")] public string[]? Koltuk { get; set; }

    private static readonly IReadOnlyList<Breadcrumbs.Item> Crumbs =
        [new("Ana sayfa", "/"), new("Araçlar ve fiyatlar", "/musaitlik")];

    private FleetBranding? _branding;
    private string? _canonicalRoot;
    private string? _crumbRoot;
    private IReadOnlyList<string> _branches = [];
    private IReadOnlyList<PublicAvailabilityResult>? _results;
    /// <summary>Tarihsiz mod: yayındaki TÜM filo (müsaitlik süzgeci uygulanmadan).</summary>
    private IReadOnlyList<FleetShowcaseCard>? _fleet;
    private bool _searched;
    private string? _error;
    private string? _requestedTitle;
    private bool _requestedAvailable;
    private DateTimeOffset? _start, _end;
    private TimeOnly? _fromTime, _toTime;
    /// <summary>Fleet slotunun modeli (sonuç ya da tarihsiz filo); null → liste alanı boş.</summary>
    private FleetModel? _list;

    private string RangeText => _start is { } s && _end is { } e
        ? $"{PriceText.ShortDate(s)} – {PriceText.ShortDate(e)}" : "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _list = BuildList();
    }

    /// <summary>
    /// Sonuç listesinin temadan bağımsız verisi: kartlar (teklif bağlantısı, "Baktığınız araç" işareti, ilk kartın
    /// önceliği), özet cümlesi ve boş durum. Sunum temanın Fleet slotunda.
    /// </summary>
    private FleetModel? BuildList()
    {
        if (_searched && _results is not null)
        {
            // ---- (a) TARİH SEÇİLMİŞ: gerçek müsaitlik + dönem toplamı. Gün sayısı aralığın kendisinden
            // (BookingMath) — tüm sonuçlarda aynı.
            var (fromDay, toDay) = (DateOnly.FromDateTime(_start!.Value.Date), DateOnly.FromDateTime(_end!.Value.Date));
            var all = _results.Select((r, i) => ListingCard.From(r, QuoteLink.Build(r.Slug, Bas, Bit, Sube, r.GunlukFiyat),
                r.Slug == Ilan ? "Baktığınız araç" : null, i == 0) with
            {
                WaLinki = WhatsAppAsk.Link(_branding, r.Baslik, fromDay, toDay, _fromTime, _toTime),
            }).ToList();
            var (cards, filter) = ApplyFilter(all);
            return new FleetModel(cards, FleetPlacement.Availability)
            {
                Bilgi = _branding?.Bilgi,
                Filtre = filter,
                Tarih = _results.Count > 0 ? new StayDates(_start!.Value, _end!.Value, _results[0].Gun) : null,
                Ozet = cards.Count > 0
                    ? new FleetSummary($"{cards.Count} araç müsait",
                        $"{RangeText}, {_results[0].Gun} gün. Fiyatlar gün sayısına göre hesaplandı.", Canli: true)
                    : null,
                Uyari = _requestedTitle is not null && !_requestedAvailable
                    ? $"{_requestedTitle} bu tarihlerde müsait değil. Aşağıdaki araçlar seçtiğiniz tarihlerde boşta."
                    : null,
                // PR-20: sonuç yoksa bile üç çıkış yolu: tarihi değiştir (form yukarıda), tüm filoyu gör, ya da
                // doğrudan ulaş. Metin bir vaat içermez — yalnız durumu söyler.
                Bos = all.Count > 0 ? FilteredOut(filter, live: true) : new FleetEmptyState("Bu tarihlerde müsait araç yok",
                    "Tarihleri bir iki gün esnetmek çoğu zaman sonucu değiştirir; yukarıdaki formdan yeniden deneyebilirsiniz.",
                    [new("/musaitlik", "Tüm filoyu gör"), new("/iletisim", "Bize ulaşın")], Canli: true),
            };
        }

        if (_fleet is null) return null;

        // ---- (b) TARİH YOK: misafir filoyu serbestçe geziyor. BURADA "müsait" DENMEZ: tarih olmadan hangi aracın
        // boşta olduğu bilinemez. Kart adet etiketi de "9 araç" der, "9 araç müsait" demez (ListingCard, Card slotu).
        var allFleet = _fleet.Select((k, i) => ListingCard.From(k, QuoteLink.Build(k.Slug, Bas, Bit, Sube, k.GunlukFiyat),
            k.Slug == Ilan ? "Baktığınız araç" : null, i == 0) with { WaLinki = WhatsAppAsk.Link(_branding, k.Baslik) }).ToList();
        var (fleet, fleetFilter) = ApplyFilter(allFleet);
        return new FleetModel(fleet, FleetPlacement.Availability)
        {
            Bilgi = _branding?.Bilgi,
            Filtre = fleetFilter,
            Ozet = new FleetSummary($"Filoda {fleet.Count} araç",
                "Günlük fiyatlar aşağıda. Tarih girerseniz o aralıkta gerçekten boşta olanları ve toplam tutarı gösteririz."),
            Bos = allFleet.Count > 0 ? FilteredOut(fleetFilter, live: false) : new FleetEmptyState("Şu anda sitede yayınlanmış araç yok",
                "Filomuz hakkında bilgi almak için bize ulaşın.", [new("/iletisim", "İletişim bilgileri")]),
        };
    }

    /// <summary>
    /// Vites/yakıt/koltuk/sınıf süzgeci (FleetFilter; GET parametreleri). Kartlar burada süzülür (veri mantığı sayfada);
    /// tema yalnız formu basar. Arama alanları formda gizli taşınır. İlk ekrandaki ilk kart öncelikli kalır.
    /// </summary>
    private (List<ListingCard> Cards, FleetFilterModel Model) ApplyFilter(List<ListingCard> all)
    {
        var selected = FleetFilter.Parse(new Dictionary<string, string[]?>
        {
            ["sinif"] = Sinif, ["vites"] = Vites, ["yakit"] = Yakit, ["koltuk"] = Koltuk,
        });
        var effective = FleetFilter.Effective(all, selected);
        var keep = new List<KeyValuePair<string, string>>();
        foreach (var (key, value) in new[] { ("bas", Bas), ("bit", Bit), ("basSaat", BasSaat), ("bitSaat", BitSaat), ("sube", Sube), ("ilan", Ilan) })
            if (!string.IsNullOrWhiteSpace(value)) keep.Add(new(key, value.Trim()));
        var cards = all.Where(c => FleetFilter.Matches(c, effective))
            .Select((c, i) => c with { Oncelikli = i == 0 }).ToList();
        return (cards, new FleetFilterModel(FleetFilter.Facets(all, effective), keep, effective.Sum(e => e.Value.Length)));
    }

    /// <summary>Süzgece uyan ilan kalmadı (ilan VAR): süzgeci temizleme bağlantısı.</summary>
    private static FleetEmptyState FilteredOut(FleetFilterModel filter, bool live)
        => new("Seçtiğiniz özelliklerde araç yok",
            "Süzgeçteki seçimlerden birini kaldırın ya da süzgeci temizleyin.",
            [new(filter.ClearHref, "Süzgeci temizle"), new("/iletisim", "Bize ulaşın")], Canli: live);

    private async Task LoadAsync()
    {
        _branding = await Showcase.GetBrandingAsync();
        // Kök KANONİK host'tan (istek host'u DEĞİL — SEO H-3); og:url, breadcrumb ve canonical aynı kök.
        _canonicalRoot = await Showcase.GetCanonicalRootAsync();
        _crumbRoot = _canonicalRoot;
        _branches = (await Subeler.ListActiveAsync()).Select(s => s.Ad).ToList();

        _start = ParseDate(Bas);
        _end = ParseDate(Bit);
        if (_start is not null && _end is not null && SiteDate.ParseTime(BasSaat) is { } fromTime
            && SiteDate.ParseTime(BitSaat) is { } toTime)
        {
            _fromTime = fromTime;
            _toTime = toTime;
            _start = SiteDate.At(DateOnly.FromDateTime(_start.Value.Date), fromTime);
            _end = SiteDate.At(DateOnly.FromDateTime(_end.Value.Date), toTime);
        }

        // İKİ tarih de girilmemişse (ya da yalnız biri girilmişse) müsaitlik HESAPLANMAZ — tek
        // tarihten aralık uydurmak ziyaretçinin niyetini varsaymak olurdu. Bunun yerine filo
        // listelenir; ziyaretçi isterse ikinci tarihi girip daraltır.
        if (_start is null || _end is null)
        {
            _fleet = PinFirst(await Showcase.ListShowcaseGroupsAsync(), k => k.Slug);
            return;
        }

        _searched = true;
        try
        {
            // Saatli aralık İstanbul ofsetini taşır (ekranda doğru gün); veritabanı yalnız UTC kabul eder.
            var results = await Showcase.SearchAvailabilityAsync(_start.Value.ToUniversalTime(), _end.Value.ToUniversalTime(),
                string.IsNullOrWhiteSpace(Sube) ? null : Sube);
            _requestedAvailable = !string.IsNullOrWhiteSpace(Ilan) && results.Any(r => r.Slug == Ilan);
            if (!string.IsNullOrWhiteSpace(Ilan) && !_requestedAvailable)
                _requestedTitle = (await Showcase.GetListingDetailAsync(Ilan))?.Baslik;
            _results = PinFirst(results, r => r.Slug);
        }
        catch (ValidationException ex)
        {
            // Geçersiz aralık (ör. iade < alış): hata gösterilir AMA ziyaretçi boş sayfada
            // bırakılmaz — filo yine listelenir, düzeltip yeniden deneyebilir.
            _error = ex.Message;
            _searched = false;
            _fleet = PinFirst(await Showcase.ListShowcaseGroupsAsync(), k => k.Slug);
        }
    }

    /// <summary>İlan detayından gelinen aracı listenin başına alır (sıra aksi halde servisinki).</summary>
    private IReadOnlyList<T> PinFirst<T>(IReadOnlyList<T> items, Func<T, string> slug)
        => string.IsNullOrWhiteSpace(Ilan) ? items : [.. items.OrderBy(x => slug(x) == Ilan ? 0 : 1)];

    private static DateTimeOffset? ParseDate(string? s)
        => DateTimeOffset.TryParse(s, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? new DateTimeOffset(d.Date, TimeSpan.Zero) : null;
}
