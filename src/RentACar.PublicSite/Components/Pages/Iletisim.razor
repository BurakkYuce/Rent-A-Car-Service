@page "/iletisim"
@using RentACar.Application.Common
@using RentACar.Application.Fleet
@inject FleetShowcaseService Showcase

@* PR-16 — iletişim sayfası. İçeriği KOD ÜRETİR, düzenlenebilir bir sayfa DEĞİL: veriler
   `TenantSettings`te zaten var (adres/tel/mobil/e-posta/WhatsApp) ve ikinci bir yere elle
   yazılması, birinin bayatlaması demek. Bu yüzden `iletisim` rezerve bir slug.

   HARİTA GÖMÜLMEZ: PublicSite CSP'sinde `frame-src` tanımsız ve `frame-ancestors 'none'` —
   üçüncü-taraf iframe (Google Maps) sessizce boş kutu olarak görünürdü. Yerine adres metni +
   haritada aç bağlantısı (dış link, kullanıcının kendi uygulamasında açılır).

   Çalışma saatleri gibi ek bilgiler için firma "Site İçeriği"nden bir sayfa açar (ör.
   "Çalışma Saatleri") — TenantSettings'e yarım bağlanmış yeni bir alan EKLENMEDİ.

   Başlık hiyerarşisi: h1 → her kanal h2 (eskiden h2 atlanıp h3'e iniliyordu). Kanal yoksa kutusu yok (T2). *@

<PageTitle>İletişim — @(_b?.Marka ?? "RentPro")</PageTitle>

<Breadcrumbs Items="Crumbs" />

<div class="wrap sayfa-ust">
    <h1>İletişim</h1>
    <p class="giris">Aşağıdaki kanallardan bize ulaşabilir ya da doğrudan
        <a href="/musaitlik">müsaitlik ve fiyat sorgulayabilirsiniz</a>.</p>
</div>

<div class="wrap">
    <ul class="kanallar">
        @if (_telLink is not null || _mobileLink is not null)
        {
            <li>
                <h2>Telefon</h2>
                @if (_telLink is not null) { <p><a class="buyuk-baglanti" href="@_telLink">@_b!.Tel</a></p> }
                @if (_mobileLink is not null) { <p><a class="buyuk-baglanti" href="@_mobileLink">@_b!.MobilTel</a> <span class="muted small">mobil</span></p> }
            </li>
        }
        @if (_waLink is not null)
        {
            <li>
                <h2>WhatsApp</h2>
                <p class="muted small">Hazır bir mesajla konuşma açar.</p>
                <a class="btn btn-brand" href="@_waLink" target="_blank" rel="noopener noreferrer">WhatsApp'tan yazın</a>
            </li>
        }
        @if (!string.IsNullOrWhiteSpace(_b?.Email))
        {
            <li>
                <h2>E-posta</h2>
                <p><a class="buyuk-baglanti" href="@($"mailto:{_b!.Email}")">@_b!.Email</a></p>
            </li>
        }
        @if (!string.IsNullOrWhiteSpace(_b?.Adres))
        {
            <li>
                <h2>Adres</h2>
                <p>@_b!.Adres</p>
                @* Dış link: kullanıcının kendi harita uygulamasında açılır (gömme YOK, CSP). *@
                <a href="@($"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(_b!.Adres!)}")"
                   target="_blank" rel="noopener noreferrer">Haritada aç</a>
            </li>
        }
    </ul>

    @if (_telLink is null && _mobileLink is null && _waLink is null
         && string.IsNullOrWhiteSpace(_b?.Email) && string.IsNullOrWhiteSpace(_b?.Adres))
    {
        <p class="bos-durum">İletişim bilgileri henüz girilmemiş.</p>
    }
</div>

@code {
    private static readonly IReadOnlyList<Breadcrumbs.Item> Crumbs =
        [new("Ana sayfa", "/"), new("İletişim", "/iletisim")];

    private FleetBranding? _b;
    private string? _telLink, _mobileLink, _waLink;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _b = await Showcase.GetBrandingAsync();
            _telLink = PhoneLink.Tel(_b.Tel);
            _mobileLink = PhoneLink.Tel(_b.MobilTel);
            // WhatsApp numarası yoksa MOBİL numaraya düş (firmaların çoğu aynı numarayı kullanıyor).
            _waLink = PhoneLink.Wa(
                string.IsNullOrWhiteSpace(_b.WhatsApp) ? _b.MobilTel : _b.WhatsApp,
                $"Merhaba, {_b.Marka} araç kiralama hakkında bilgi almak istiyorum.");
        }
        catch
        {
            // Marka/iletişim çözülemedi → sayfa "bilgi girilmemiş" haliyle basılır.
        }
    }
}
