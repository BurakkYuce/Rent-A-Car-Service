@page "/"
@using RentACar.Application.Branches
@using RentACar.Application.Fleet
@using RentACar.Application.SiteIcerik
@using RentACar.PublicSite.Components.Shared
@inject FleetShowcaseService Showcase
@inject SiteIcerikService Icerik
@inject BranchService Subeler

@* PR-19 — ana sayfa artık bölümleri DİZEN ince bir sayfa. Her bölüm kendi bileşeninde
   (Components/Shared) ve "sabit anlatı / tenant verisi" ayrımı orada belgeli.

   SIRA bilinçli: önce arama (ziyaretçinin işi), sonra güven, sonra araçlar, sonra süreç/fiyat
   açıklaması, en sonda SSS + çağrı. Referans projedeki akışın bize uyarlanmış hâli — "yorumlar"
   ve "kiralama vs satın alma" bölümleri BİLİNÇLİ YOK (bkz. plan Non-Goals). *@

<PageTitle>@(_branding?.Marka ?? "RentPro") — Araç Kiralama</PageTitle>

@* DİKKAT: `KanonikUrl="_kanonik"` yazmak Razor'da DÜZ METİN geçirir (string tipli
   parametrede tırnak içi literaldir). İlk yazımda öyleydi ve JSON-LD'ye `"url":"_kanonik"`
   basılıyordu — arama motorlarına çöp adres yayınlanacaktı. İfade için `@@` ZORUNLU. *@
<YapisalVeri Marka="_branding" Sorular="_sss" KanonikUrl="@_kanonik" />
@* Açıklama tenant verisinden KURULUR, sabit metin yazılmaz: her firma için farklı olmalı
   (çok-kiracılı site). Filo sayısı varsa cümleye girer — "3 araçlık filo" somut bir bilgi. *@
<SayfaMeta Baslik="@($"{_branding?.Marka ?? "RentPro"} — Araç Kiralama")"
           Aciklama="@AnaAciklama" Yol="/" Marka="_branding"
           KanonikKok="@_kanonikKok" Gorsel="@KapakGorsel" />

<BolumHero Marka="@_branding?.Marka" Subeler="_subeler" />

<BolumGuvenSeridi />

@* Araçlar — VERİYE BAĞLI: ilan yoksa bölüm hiç basılmaz (T2). Yayınlanmamış bir sitede
   "Şu anda araç yok" yazmaktansa bölümü hiç göstermemek daha iyi; ziyaretçiye yine arama,
   süreç ve iletişim kalıyor. *@
@if (_cards is { Count: > 0 })
{
    <section class="bolum" id="filo">
        <div class="container">
            <h2 class="section-title">Filomuz</h2>
            <div class="grid">
                @foreach (var c in _cards)
                {
                    <a class="card" href="@($"/araclar/{c.Slug}")">
                        @if (c.CoverPhotoId is { } photoId)
                        {
                            <img class="card-img" src="@($"/foto/{photoId}/thumb")" alt="@c.Baslik" loading="lazy" />
                        }
                        else
                        {
                            <div class="card-img-placeholder" aria-hidden="true"></div>
                        }
                        <div class="card-body">
                            <h3>@c.Baslik</h3>
                            @if (!string.IsNullOrWhiteSpace(c.YilAralik))
                            {
                                <p class="muted small">@c.YilAralik model</p>
                            }
                            <div class="chips">
                                @* Teknik özellikler: personelin sihirbazda "sitede görünsün" dediği satırlar.
                                   İlk üçü kartta; tamamı detay sayfasında. *@
                                @foreach (var o in c.Ozellikler.Take(3))
                                {
                                    <span class="chip">@o.Deger</span>
                                }
                                @if (c.Adet > 1)
                                {
                                    <span class="chip">@c.Adet araç</span>
                                }
                            </div>
                            <p class="fiyat">
                                <strong>@c.GunlukFiyat.ToString("N0") ₺</strong>
                                <span class="muted small">/ gün · @(c.KdvDahil ? "KDV dahil" : "+ KDV")</span>
                            </p>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

<BolumNasilCalisir />

<BolumFiyatNasil KosulSayfasi="@_kosulSayfasi" />

<BolumSss Sorular="_sss" Adet="SssOzetAdet" />

<BolumCta Telefon="@_branding?.Tel" WhatsApp="@_branding?.WhatsApp" />

@code {
    /// <summary>Ana sayfada gösterilen SSS adedi — ERP yönetim ekranındaki nota karşılık gelir.</summary>
    public const int SssOzetAdet = 4;

    /// <summary>"Kiralama koşulları" için aranan slug'lar — firma bunlardan birini yazdıysa
    /// fiyat bölümünden oraya bağlantı verilir; yoksa bağlantı hiç basılmaz (T2).</summary>
    private static readonly string[] KosulSluglari = ["kiralama-kosullari", "kosullar", "sartlar"];

    private IReadOnlyList<FleetShowcaseCard>? _cards;
    private IReadOnlyList<SssSatiri> _sss = [];
    private FleetBranding? _branding;
    /// <summary>Ana sayfa açıklaması — tenant verisinden kurulur (marka, şehir, filo adedi).</summary>
    private string AnaAciklama
    {
        get
        {
            var marka = _branding?.Marka ?? "Firmamız";
            var adet = _cards?.Count ?? 0;
            var filo = adet > 0 ? $"{adet} araç seçeneğiyle " : "";
            var yer = string.IsNullOrWhiteSpace(_branding?.Adres) ? "" : $"{_branding!.Adres} ve çevresinde ";
            return $"{marka} {yer}{filo}günlük ve uzun dönem araç kiralama. "
                 + "Tarihlerinizi girin, müsait araçları ve net fiyatı görün.";
        }
    }

    /// <summary>Paylaşım görseli: ilk ilanın kapağı. Ayrı bir "site görseli" alanı YOK —
    /// olmayan bir alanı uydurmaktansa var olan gerçek görseli kullanmak doğru.</summary>
    private string? KapakGorsel => _cards?.FirstOrDefault(c => c.CoverPhotoId is not null) is { } k
        ? $"/foto/{k.CoverPhotoId}/thumb" : null;
    private IReadOnlyList<string> _subeler = [];
    private string? _kanonik;
    private string? _kanonikKok;
    private string? _kosulSayfasi;

    protected override async Task OnInitializedAsync()
    {
        _branding = await Showcase.GetBrandingAsync();
        _cards = await Showcase.ListShowcaseGroupsAsync();
        _sss = await Icerik.YayindakiSssAsync();

        // Şube listesi Hero'daki arama kutusu için; boşsa AramaFormu seçim kutusunu hiç basmaz.
        try { _subeler = [.. (await Subeler.ListAsync()).Select(b => b.Ad)]; }
        catch { _subeler = []; }

        var host = await Showcase.GetCanonicalHostAsync();
        _kanonik = host is null ? null : $"https://{host}/";
        // og:image mutlak adres ister; kanonik KÖK (sondaki eğik çizgisiz) ondan türer.
        _kanonikKok = host is null ? null : $"https://{host}";

        var sayfalar = await Icerik.YayindakiSayfalarAsync();
        _kosulSayfasi = sayfalar.FirstOrDefault(s => KosulSluglari.Contains(s.Slug)) is { } k
            ? $"/{k.Slug}" : null;
    }
}
