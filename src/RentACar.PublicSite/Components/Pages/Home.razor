@page "/"
@using RentACar.Application.Common
@using RentACar.Application.Fleet
@using RentACar.Application.SiteIcerik
@inject FleetShowcaseService Showcase
@inject SiteIcerikService Icerik

<PageTitle>@(_branding?.Marka ?? "RentPro")</PageTitle>

<div class="container">
    @* PR-15: marka + iletişim + gezinme artık KABUKTA (MainLayout). Burada yalnız sayfanın
       kendi başlığı kalır — aynı bilgiyi iki kez basmak eski halin en görünür kusuruydu. *@
    <header class="site-header">
        <h1>Kiralık Araçlar</h1>
        <p class="contact">Günlük, haftalık ve aylık fiyatlarımız aşağıda; tarih seçerek
            müsaitliği ve toplam tutarı hesaplayabilirsiniz.</p>
        <p class="ust-linkler"><a href="/musaitlik">Müsaitlik ve fiyat sorgula</a></p>
    </header>

    @* PR-14: kartlar artık SINIF değil İLAN bazlı — personelin sihirbazdan yayınladığı araçlar.
       Adres slug'dır (/araclar/fiat-egea-manuel-dizel), fiyat ilandan gelir (motor yok). *@
    @if (_cards is { Count: > 0 })
    {
        <div class="grid">
            @foreach (var c in _cards)
            {
                <a class="card" href="@($"/araclar/{c.Slug}")">
                    @if (c.CoverPhotoId is { } photoId)
                    {
                        <img class="card-img" src="@($"/foto/{photoId}/thumb")" alt="@c.Baslik" />
                    }
                    else
                    {
                        <div class="card-img-placeholder" aria-hidden="true"></div>
                    }
                    <div class="card-body">
                        <h3>@c.Baslik</h3>
                        @if (!string.IsNullOrWhiteSpace(c.YilAralik))
                        {
                            <p class="muted small">@c.YilAralik model</p>
                        }
                        <div class="chips">
                            @* Teknik özellikler: personelin sihirbazda "sitede görünsün" dediği satırlar.
                               İlk üçü kartta; tamamı detay sayfasında. *@
                            @foreach (var o in c.Ozellikler.Take(3))
                            {
                                <span class="chip">@o.Deger</span>
                            }
                            @if (c.Adet > 1)
                            {
                                <span class="chip">@c.Adet araç</span>
                            }
                        </div>
                        <p class="fiyat">
                            <strong>@c.GunlukFiyat.ToString("N0") ₺</strong>
                            <span class="muted small">/ gün · @(c.KdvDahil ? "KDV dahil" : "+ KDV")</span>
                        </p>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <p class="empty-state">Şu anda vitrine eklenmiş bir araç bulunmuyor.</p>
    }

    @* PR-16: SSS özeti — tamamı /sss'te. Adet SssOzetAdet ile sabit (yönetim ekranındaki notla aynı). *@
    @if (_sss.Count > 0)
    {
        <h2 class="section-title">Sık Sorulan Sorular</h2>
        <div class="sss-liste">
            @foreach (var k in _sss.Take(SssOzetAdet))
            {
                <details class="sss">
                    <summary>@k.Soru</summary>
                    @foreach (var p in IcerikMetni.Paragraflar(k.Cevap))
                    {
                        <p>@p</p>
                    }
                </details>
            }
        </div>
        @if (_sss.Count > SssOzetAdet)
        {
            <p class="ust-linkler"><a href="/sss">Tüm soruları gör (@_sss.Count)</a></p>
        }
    }
</div>

@code {
    /// <summary>Ana sayfada gösterilen SSS adedi — yönetim ekranındaki nota karşılık gelir.</summary>
    public const int SssOzetAdet = 4;

    private IReadOnlyList<FleetShowcaseCard>? _cards;
    private IReadOnlyList<SssSatiri> _sss = [];
    private FleetBranding? _branding;

    protected override async Task OnInitializedAsync()
    {
        _branding = await Showcase.GetBrandingAsync();
        _cards = await Showcase.ListShowcaseGroupsAsync();
        _sss = await Icerik.YayindakiSssAsync();
    }
}
