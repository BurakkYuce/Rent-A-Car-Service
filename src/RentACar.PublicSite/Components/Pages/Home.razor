@page "/"
@using RentACar.Application.Blog
@using RentACar.Application.Fleet
@inject FleetShowcaseService Showcase
@inject BlogService Blog

<PageTitle>@(_branding?.Marka ?? "RentPro")</PageTitle>

<div class="container">
    <header class="site-header">
        <h1>@(_branding?.Marka ?? "RentPro")</h1>
        @if (_branding is { } b && (b.Adres is not null || b.Tel is not null || b.Email is not null))
        {
            <p class="contact">
                @string.Join(" · ", new[] { b.Adres, b.Tel, b.Email }.Where(x => !string.IsNullOrWhiteSpace(x)))
            </p>
        }
        <p class="ust-linkler">
            <a href="/musaitlik">Müsaitlik ve fiyat sorgula →</a>
            @if (_blogVar)
            {
                <a href="/blog">Blog →</a>
            }
        </p>
    </header>

    <h2 class="section-title">Filomuz</h2>

    @* PR-14: kartlar artık SINIF değil İLAN bazlı — personelin sihirbazdan yayınladığı araçlar.
       Adres slug'dır (/araclar/fiat-egea-manuel-dizel), fiyat ilandan gelir (motor yok). *@
    @if (_cards is { Count: > 0 })
    {
        <div class="grid">
            @foreach (var c in _cards)
            {
                <a class="card" href="@($"/araclar/{c.Slug}")">
                    @if (c.CoverPhotoId is { } photoId)
                    {
                        <img class="card-img" src="@($"/foto/{photoId}/thumb")" alt="@c.Baslik" />
                    }
                    else
                    {
                        <div class="card-img-placeholder">🚗</div>
                    }
                    <div class="card-body">
                        <h3>@c.Baslik</h3>
                        @if (!string.IsNullOrWhiteSpace(c.YilAralik))
                        {
                            <p class="muted small">@c.YilAralik model</p>
                        }
                        <div class="chips">
                            @* Teknik özellikler: personelin sihirbazda "sitede görünsün" dediği satırlar.
                               İlk üçü kartta; tamamı detay sayfasında. *@
                            @foreach (var o in c.Ozellikler.Take(3))
                            {
                                <span class="chip">@o.Deger</span>
                            }
                            @if (c.Adet > 1)
                            {
                                <span class="chip">@c.Adet araç</span>
                            }
                        </div>
                        <p class="fiyat">
                            <strong>@c.GunlukFiyat.ToString("N0") ₺</strong>
                            <span class="muted small">/ gün · @(c.KdvDahil ? "KDV dahil" : "+ KDV")</span>
                        </p>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <p class="empty-state">Şu anda vitrine eklenmiş bir araç bulunmuyor.</p>
    }
</div>

@code {
    private IReadOnlyList<FleetShowcaseCard>? _cards;
    private FleetBranding? _branding;
    private bool _blogVar; // PR-6: yayınlanmış yazı yoksa link basılmaz (boş sayfaya götürmesin)

    protected override async Task OnInitializedAsync()
    {
        _branding = await Showcase.GetBrandingAsync();
        _cards = await Showcase.ListShowcaseGroupsAsync();
        _blogVar = (await Blog.ListPublishedAsync()).Count > 0;
    }
}
