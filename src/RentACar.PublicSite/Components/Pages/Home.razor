@page "/"
@using RentACar.Application.Branches
@using RentACar.Application.Fleet
@using RentACar.Application.SiteIcerik
@using RentACar.PublicSite.Components.Shared
@inject FleetShowcaseService Showcase
@inject SiteContentService Icerik
@inject BranchService Subeler

@* Ana sayfa: veriyi TOPLAYAN ve SEO'yu basan ince sayfa. Gövde (bölümlerin seçimi ve sırası) aktif temanın Home
   slotunda (Components/Themes/README.md); her ortak bölüm kendi bileşeninde (Components/Shared). *@

<PageTitle>@(_branding?.Marka ?? "RentPro") — Araç Kiralama</PageTitle>

@* DİKKAT: `KanonikKok="_kanonik"` yazmak Razor'da DÜZ METİN geçirir (string tipli
   parametrede tırnak içi literaldir). İlk yazımda öyleydi ve JSON-LD'ye `"url":"_kanonik"`
   basılıyordu — arama motorlarına çöp adres yayınlanacaktı. İfade için `@@` ZORUNLU.
   FAQPage yalnız sayfada GÖRÜNEN sorular (Home slotu BolumSss'e aynı adedi verir — SEO L-4). *@
<YapisalVeri Marka="_branding" Sorular="@(_faq.Take(FaqSummaryCount).ToList())" KanonikKok="@_canonicalRoot"
             Subeler="_activeBranches" Kartlar="@(_cards ?? [])" />
@* Açıklama tenant verisinden KURULUR, sabit metin yazılmaz: her firma için farklı olmalı
   (çok-kiracılı site). Filo sayısı varsa cümleye girer — "3 araçlık filo" somut bir bilgi. *@
<SayfaMeta Baslik="@($"{_branding?.Marka ?? "RentPro"} — Araç Kiralama")"
           Aciklama="@MainDescription" Yol="/" Marka="_branding"
           KanonikKok="@_canonicalRoot" Gorsel="@CoverImage" />

@if (_model is not null)
{
    <ThemedHome Model="_model" />
}

@code {
    /// <summary>Ana sayfada gösterilen SSS adedi — ERP yönetim ekranındaki nota karşılık gelir.</summary>
    public const int FaqSummaryCount = 4;

    /// <summary>"Kiralama koşulları" için aranan slug'lar — firma bunlardan birini yazdıysa
    /// fiyat bölümünden oraya bağlantı verilir; yoksa bağlantı hiç basılmaz (T2).</summary>
    private static readonly string[] ConditionSlugs = ["kiralama-kosullari", "kosullar", "sartlar"];

    private IReadOnlyList<FleetShowcaseCard>? _cards;
    private IReadOnlyList<SssSatiri> _faq = [];
    private FleetBranding? _branding;
    private HomeModel? _model;
    /// <summary>Ana sayfa açıklaması — tenant verisinden kurulur (marka, şehir, filo adedi).</summary>
    private string MainDescription
    {
        get
        {
            var brand = _branding?.Marka ?? "Firmamız";
            var count = _cards?.Count ?? 0;
            var fleet = count > 0 ? $"{count} araç seçeneğiyle " : "";
            var place = string.IsNullOrWhiteSpace(_branding?.Adres) ? "" : $"{_branding!.Adres} ve çevresinde ";
            return $"{brand} {place}{fleet}günlük ve uzun dönem araç kiralama. "
                 + "Tarihlerinizi girin, müsait araçları ve net fiyatı görün.";
        }
    }

    /// <summary>Paylaşım görseli: ilk ilanın kapağı. Ayrı bir "site görseli" alanı YOK —
    /// olmayan bir alanı uydurmaktansa var olan gerçek görseli kullanmak doğru.</summary>
    private string? CoverImage => _cards?.FirstOrDefault(c => c.CoverPhotoId is not null) is { } k
        ? $"/foto/{k.CoverPhotoId}/thumb" : null;
    private IReadOnlyList<string> _branches = [];
    private IReadOnlyList<RentACar.Domain.Entities.Branch> _activeBranches = [];
    private string? _area;
    private string? _canonicalRoot;

    protected override async Task OnInitializedAsync()
    {
        _branding = await Showcase.GetBrandingAsync();
        _cards = await Showcase.ListShowcaseGroupsAsync();
        _faq = await Icerik.PublishedFaqAsync();

        // Şube listesi Hero'daki arama kutusu için; boşsa AramaFormu seçim kutusunu hiç basmaz.
        // YALNIZ aktif şubeler (pasif şube ne aramada ne hizmet bölgesinde görünmeli — SEO L-1).
        // Hizmet bölgesi (il/ilçe) de buradan: yerel arama ifadesi tenant verisinden, sabit metin değil.
        try
        {
            var active = await Subeler.ListActiveAsync();
            _activeBranches = active;
            _branches = [.. active.Select(b => b.Ad)];
            _area = ServiceArea.Describe(active.Select(b => (b.Il, b.Ilce)));
        }
        catch { _branches = []; }

        // og:image/JSON-LD mutlak adres ister; kanonik KÖK (sondaki eğik çizgisiz) tek yardımcıdan.
        _canonicalRoot = await Showcase.GetCanonicalRootAsync();

        var pages = await Icerik.PublishedPagesAsync();
        var termsPage = pages.FirstOrDefault(s => ConditionSlugs.Contains(s.Slug)) is { } k
            ? $"/{k.Slug}" : null;

        // Filo bölümü /musaitlik ile AYNI kart verisi (tarihsiz mod); sunumu temanın Fleet slotu seçer.
        var fleet = new FleetModel(
            [.. _cards.Select(c => ListingCard.From(c, QuoteLink.Build(c.Slug, dailyPrice: c.GunlukFiyat)))],
            FleetPlacement.Home)
        {
            Baslik = "Filomuz",
            BaslikId = "filo-baslik",
        };

        _model = new HomeModel(_branding, _cards, fleet, _faq, FaqSummaryCount, _branches, _activeBranches,
            [.. pages.Where(s => !LegalPages.Legal(s)).Select(s => new SiteLink($"/{s.Slug}", s.Baslik))],
            _area, termsPage);
    }
}
