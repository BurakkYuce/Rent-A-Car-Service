@page "/blog"
@using RentACar.Application.Blog
@using RentACar.Application.Fleet
@inject BlogService Blog
@inject FleetShowcaseService Showcase

<PageTitle>Blog — @(_branding?.Marka ?? "RentPro")</PageTitle>

<Breadcrumbs Items="Crumbs" />

<div class="wrap sayfa-ust">
    <h1>Blog</h1>
</div>

<div class="wrap">
    @if (_posts is { Count: > 0 })
    {
        <ul class="yazilar">
            @foreach (var p in _posts)
            {
                <li>
                    <article class="yazi">
                        @if (p.KapakVar)
                        {
                            @* Liste kartı: tembel yükleme — ekrana sığmayan kartların görselleri ilk boyamayı
                               geciktirmesin. Blog/ilan DETAY kapakları LCP adayı olduğu için tembel DEĞİL. *@
                            <img src="@($"/blog-kapak/{p.Id}")" alt="" width="400" height="225" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <div class="foto-yok" aria-hidden="true"></div>
                        }
                        <div class="yazi-ic">
                            <h2><a href="@($"/blog/{p.Slug}")">@p.Baslik</a></h2>
                            @if (!string.IsNullOrWhiteSpace(p.Ozet)) { <p>@p.Ozet</p> }
                            @if (p.YayinTarihi is { } t)
                            {
                                <p class="muted small"><time datetime="@t.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">@PriceText.Date(t)</time></p>
                            }
                        </div>
                    </article>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="bos-durum">Henüz yazı yayınlanmamış.</p>
    }
</div>

@code {
    private static readonly IReadOnlyList<Breadcrumbs.Item> Crumbs = [new("Ana sayfa", "/"), new("Blog", "/blog")];

    private IReadOnlyList<BlogListItem>? _posts;
    private FleetBranding? _branding;

    protected override async Task OnInitializedAsync()
    {
        _branding = await Showcase.GetBrandingAsync();
        _posts = await Blog.ListPublishedAsync();
    }
}
