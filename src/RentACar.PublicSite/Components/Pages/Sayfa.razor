@page "/{Slug}"
@using RentACar.Application.Common
@using RentACar.Application.Fleet
@using RentACar.Application.SiteIcerik
@inject SiteContentService Icerik
@inject FleetShowcaseService Showcase

@* PR-16 — firmanın yazdığı içerik sayfası, KÖK adreste (/hakkimizda).

   DİKKAT: bu rota tek-segmentli BİLİNMEYEN her adresi yakalar, dolayısıyla `Routes.razor`'ın
   `NotFoundPage`'i artık devreye girmez. Bu yüzden 404'ü BU SAYFA kendisi yazmak zorunda — yoksa
   her yazım hatası HTTP 200 ile "bulunamadı" basar (soft-404) ve SEO sinyalleri çürür.
   `/blog`, `/musaitlik` gibi gerçek rotalar etkilenmez: ASP.NET yönlendirmesinde literal segment
   parametreli segmenti YENER. Buna ek kemer olarak rezerve slug'lar yazma anında reddedilir
   (`SiteIcerikService.RezerveSluglar`). *@

<PageTitle>@(_page?.Baslik ?? "Sayfa bulunamadı") — @(_brand ?? "RentPro")</PageTitle>

@if (_page is { } s)
{
    <HeadContent>
        @if (!string.IsNullOrWhiteSpace(s.MetaAciklama))
        {
            <meta name="description" content="@s.MetaAciklama" />
        }
    </HeadContent>
}

<div class="container">
    @if (_page is null)
    {
        <h1>Sayfa bulunamadı</h1>
        <p class="empty-state">Aradığınız sayfa yayından kaldırılmış ya da adres yanlış olabilir.</p>
        <p><a class="back-link" href="/">← Ana sayfaya dön</a></p>
    }
    else
    {
        <header class="site-header"><h1>@_page.Baslik</h1></header>
        <article class="blog-icerik">
            @* MarkupString KULLANILMAZ: @p normal bir Razor ifadesi olduğu için otomatik HTML-encode
               edilir. İçerik düz metin saklandığından personel gövdeye <script> yazsa ekranda METİN
               görünür — XSS risk sınıfı tasarım gereği yok (blog ile aynı kural, IcerikMetni ortak). *@
            @foreach (var p in ContentText.Paragraphs(_page.Govde))
            {
                <p>@p</p>
            }
        </article>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [CascadingParameter] public HttpContext? Http { get; set; }

    private SayfaGoster? _page;
    private string? _brand;

    /// <summary>
    /// NOKTALI yol asla bir içerik sayfası olamaz: <c>TurkishText.Slugify</c> yalnız harf/rakam
    /// bırakır, bir slug nokta İÇEREMEZ (PR-16'da testle kilitlenen değişmez). Dolayısıyla
    /// <c>/site.css</c> gibi bir istek buraya düşerse — ki statik dosya çözümlemesi bir sebeple
    /// kaçırırsa düşer — DB'ye hiç gitmeden 404 döneriz.
    ///
    /// <para>Bu sertleştirme canlıda yaşanan bir olaydan geldi: statik varlık API'si yanlış
    /// olduğu için <c>/site.css</c> buraya düştü, tenant çözümlenmemiş olduğundan (uzantılı yollar
    /// tenant middleware'ini atlar) sorgu <b>500</b> ile patladı. Asıl hata düzeltildi, ama bu yol
    /// bir daha 500 üretmemeli.</para>
    /// </summary>
    private bool DosyaGibi => Slug.Contains('.');

    protected override async Task OnInitializedAsync()
    {
        if (DosyaGibi)
        {
            if (Http is not null) Http.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        _page = await Icerik.PageAsync(Slug);
        if (_page is null && Http is not null)
            Http.Response.StatusCode = StatusCodes.Status404NotFound; // GERÇEK 404 (soft-404 değil)

        try { _brand = (await Showcase.GetBrandingAsync()).Marka; }
        catch { /* marka çözülemezse sayfa yine basılır */ }
    }
}
