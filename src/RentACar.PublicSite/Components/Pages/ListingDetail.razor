@page "/araclar/{Slug}"
@using RentACar.Application.Branches
@using RentACar.Application.Common
@using RentACar.Application.Fleet
@using RentACar.PublicSite.Components.Shared
@inject FleetShowcaseService Showcase
@inject BranchService BranchSvc

@* PR-20 — araç detayı: arama motorundan gelen ziyaretçinin İNDİĞİ sayfa; karar noktası.

   Üst bölüm (başlık, kapak, galeri, fiyat, tarife, eylemler, tarih formu) aktif temanın DetailHero slotunda
   (Components/Themes/README.md); veri burada kurulur. SEO (meta, JSON-LD, breadcrumb), teknik özellikler ve
   benzer araçlar sayfada kalır.

   TARİFE: günlük/haftalık/aylık ilandan (uydurulmaz); haftalık/aylık TOPLAMIN yanında gün başı karşılığı
   — ziyaretçi kademe farkını hesap yapmadan görsün. Yuvarlama burada (Rates), tema yalnız basar. *@

<PageTitle>@(_detail?.Baslik ?? "Araç") — @(_branding?.BrandName ?? "RentPro")</PageTitle>

@if (_detail is not null && _hero is not null)
{
    <VehicleStructuredData Detail="_detail" CanonicalRoot="@_canonicalRoot" />
    @* Araç detayı SEO iniş sayfasıdır: açıklama ilan verisinden kurulur (başlık + yıl + fiyat + adet). *@
    <PageMeta Title="@($"{_detail.Baslik} — {_branding?.BrandName ?? "RentPro"}")"
              Description="@VehicleDescription" Path="@($"/araclar/{_detail.Slug}")"
              Branding="_branding" CanonicalRoot="@_canonicalRoot"
              Image="@(_detail.PhotoIds.Count > 0 ? $"/foto/{_detail.PhotoIds[0]}/thumb" : null)" />

    <Breadcrumbs Items="@Crumbs(_detail)" CanonicalRoot="@_canonicalRoot" />

    <ThemedDetailHero Model="_hero" />

    @if (_detail.Features.Count > 0 || _similar.Count > 0)
    {
        <div class="wrap">
            @* Teknik özellikler: sihirbazda "sitede görünsün" işaretlenen satırlar. Boşsa bölüm YOK (T2). *@
            @if (_detail.Features.Count > 0)
            {
                <section class="bolum-ic" aria-labelledby="ozellik-baslik">
                    <h2 id="ozellik-baslik">Teknik özellikler</h2>
                    <table class="ozellik-tablo">
                        <tbody>
                            @foreach (var o in _detail.Features)
                            {
                                <tr><th scope="row">@o.Etiket</th><td>@o.Deger</td></tr>
                            }
                        </tbody>
                    </table>
                </section>
            }

            @if (_similar.Count > 0)
            {
                <section class="bolum-ic" aria-labelledby="benzer-baslik">
                    <h2 id="benzer-baslik">Filodaki diğer araçlar</h2>
                    <ThemedFleet Model="@SimilarFleet" />
                </section>
            }
        </div>
    }

    @* Ana sayfayla AYNI bileşenler — anlatı tek yerde, iki sayfada kopyalanmıyor. *@
    <TrustSection />
    <CtaSection Phone="@_branding?.Phone" WhatsApp="@_branding?.WhatsApp" />
}

@code {
    /// <summary>"Filodaki diğer araçlar" en fazla kaç kart.</summary>
    private const int SimilarCount = 3;

    [Parameter] public string Slug { get; set; } = string.Empty;
    /// <summary>Statik SSR'da doğrudan kullanılabilir (circuit yok) — durum kodunu yazmak için.</summary>
    [CascadingParameter] public HttpContext? Http { get; set; }

    // Seçili aralık (adreste geldiyse) "Rezervasyon talebi" bağlantılarına aynen geçer; biçimsiz saat QuoteLink'te düşer.
    [SupplyParameterFromQuery(Name = "bas")] public string? Start { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? End { get; set; }
    [SupplyParameterFromQuery(Name = "basSaat")] public string? StartTime { get; set; }
    [SupplyParameterFromQuery(Name = "bitSaat")] public string? EndTime { get; set; }

    private FleetShowcaseDetail? _detail;
    private FleetBranding? _branding;
    private string? _canonicalRoot;
    private DetailHeroModel? _hero;
    private IReadOnlyList<FleetShowcaseCard> _similar = [];

    private static IReadOnlyList<Breadcrumbs.Item> Crumbs(FleetShowcaseDetail d) =>
        [new("Ana sayfa", "/"), new("Araçlar ve fiyatlar", "/musaitlik"), new(d.Baslik, $"/araclar/{d.Slug}")];

    private FleetModel SimilarFleet => new(
        [.. _similar.Select(c => ListingCard.From(c, QuoteLink.Build(c.Slug, Start, End, null, c.GunlukFiyat, StartTime, EndTime)))],
        FleetPlacement.Similar);

    private static string? MetaLine(FleetShowcaseDetail d)
    {
        var parts = new List<string>(2);
        if (!string.IsNullOrWhiteSpace(d.YearRange)) parts.Add($"{d.YearRange} model");
        // "adet" bir MÜSAİTLİK vaadi değil, ilana bağlı araç sayısı.
        if (d.VehicleCount > 1) parts.Add($"filoda {d.VehicleCount} araç");
        return parts.Count == 0 ? null : string.Join(", ", parts);
    }

    /// <summary>Tarife satırları: günlük + (varsa) haftalık/aylık toplam ve gün başı karşılığı (tam TL'ye yuvarlı).</summary>
    private static IReadOnlyList<DetailRate> Rates(FleetShowcaseDetail d)
    {
        var rows = new List<DetailRate>(3) { new("Günlük", d.GunlukFiyat, null) };
        if (d.HaftalikToplam is { } week && week > 0) rows.Add(new("Haftalık, 7 gün", week, Math.Round(week / 7m, 0)));
        if (d.AylikToplam is { } month && month > 0) rows.Add(new("Aylık, 30 gün", month, Math.Round(month / 30m, 0)));
        return rows;
    }

    /// <summary>Araç açıklaması — ilan verisinden; sabit pazarlama cümlesi YAZILMAZ (her tenant farklı).</summary>
    private string VehicleDescription
    {
        get
        {
            if (_detail is null) return "";
            var year = string.IsNullOrWhiteSpace(_detail.YearRange) ? "" : $"{_detail.YearRange} model ";
            var vat = _detail.KdvDahil ? "KDV dahil" : "+ KDV";
            var count = _detail.VehicleCount > 1 ? $" Filoda {_detail.VehicleCount} adet." : "";
            return $"{_detail.Baslik} {year}kiralama — günlük {_detail.GunlukFiyat:N0} TL ({vat})."
                 + $"{count} Tarih seçerek müsaitliği ve toplam tutarı görün.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _branding = await Showcase.GetBrandingAsync();
        _detail = await Showcase.GetListingDetailAsync(Slug);

        // PR-11'den devralınan kural: yayında olmayan içerik GERÇEK 404 döner (soft-404 değil). Gövde
        // Program.cs'teki durum sayfası ara katmanından gelir: /not-found kabukla ve filoyla basılır.
        if (_detail is null)
        {
            if (Http is not null) Http.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        if (await Showcase.GetCanonicalHostAsync() is { } host) _canonicalRoot = $"https://{host}";
        var branches = (await BranchSvc.ListActiveAsync()).Select(s => s.Ad).ToList();
        var waLink = WhatsAppAsk.Link(_branding, _detail.Baslik);

        _hero = new DetailHeroModel(_detail, Rates(_detail),
            QuoteLink.Build(_detail.Slug, Start, End, null, _detail.GunlukFiyat, StartTime, EndTime), branches)
        {
            MetaLine = MetaLine(_detail),
            WhatsAppLink = waLink,
            Branding = _branding,
        };

        // Diğer araçlar: fiyatı bu araca en yakın olanlar (ziyaretçinin bütçesine yakın seçenek).
        var price = _detail.GunlukFiyat;
        _similar = [.. (await Showcase.ListShowcaseGroupsAsync())
            .Where(c => c.Slug != _detail.Slug)
            .OrderBy(c => Math.Abs(c.GunlukFiyat - price))
            .Take(SimilarCount)];
    }
}
