@page "/araclar/{GroupId:guid}"
@using RentACar.Application.Fleet
@inject FleetShowcaseService Showcase

<PageTitle>@(_detail?.Ad ?? "Araç Grubu") — @(_branding?.Marka ?? "RentPro")</PageTitle>

<div class="container">
    <a class="back-link" href="/">← Filo</a>

    @if (_detail is null)
    {
        <p class="empty-state">Bu araç grubu bulunamadı.</p>
    }
    else
    {
        <h1>@_detail.Ad</h1>
        @if (!string.IsNullOrWhiteSpace(_detail.Aciklama))
        {
            <p>@_detail.Aciklama</p>
        }
        <div class="chips">
            @if (!string.IsNullOrWhiteSpace(_detail.KasaTuru))
            {
                <span class="chip">@_detail.KasaTuru</span>
            }
            @if (_detail.KoltukSayisi is { } koltuk)
            {
                <span class="chip">@koltuk koltuk</span>
            }
            @if (_detail.KapiSayisi is { } kapi)
            {
                <span class="chip">@kapi kapı</span>
            }
            @if (_detail.BagajSayisi is { } bagaj)
            {
                <span class="chip">@bagaj bagaj</span>
            }
        </div>

        <h2 class="section-title">Fotoğraflar</h2>
        @if (_detail.PhotoIds.Count > 0)
        {
            <div class="photo-grid">
                @foreach (var photoId in _detail.PhotoIds)
                {
                    <a href="@($"/foto/{photoId}")" target="_blank" rel="noopener">
                        <img class="card-img" src="@($"/foto/{photoId}/thumb")" alt="@_detail.Ad" />
                    </a>
                }
            </div>
        }
        else
        {
            <p class="empty-state">Bu grup için henüz fotoğraf eklenmemiş.</p>
        }
    }
</div>

@code {
    [Parameter] public Guid GroupId { get; set; }

    private FleetShowcaseDetail? _detail;
    private FleetBranding? _branding;

    protected override async Task OnInitializedAsync()
    {
        _branding = await Showcase.GetBrandingAsync();
        _detail = await Showcase.GetGroupDetailAsync(GroupId);
    }
}
