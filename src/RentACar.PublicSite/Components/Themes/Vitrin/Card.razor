@using RentACar.Application.Fleet

@* Vitrin ilan kartı — görsel ağırlıklı: 4:3 fotoğraf, çerçevesiz, gölgesiz; ad ve fiyat görselin altında
   sade. Kart zemini YOK (--card-bg saydam): ızgara bir galeri duvarı gibi okunur, kart yığını gibi değil.

   Tarih seçilmişse hesap açık yazılır ("3 gün × ₺1.250" + toplam); seçilmemişse günlük fiyat. Adet
   etiketi moda göre: tarihsiz "3 araç", tarihli "3 araç müsait" (tarihsiz müsaitlik bilinemez).

   Etkileşim: ad bağlantısı ::after ile kartın tamamını kaplar; "Teklif iste" onun üstünde ayrı hedef.
   İç içe <a> yok. Fotoğraf yoksa grafit zemin üstünde modelin baş harfleri (boş gri kutu değil). *@

<article class="ilan v-kart">
    @if (!string.IsNullOrWhiteSpace(Isaret))
    {
        <p class="ilan-isaret">@Isaret</p>
    }
    <div class="v-kart-foto @(Kart.CoverPhotoId is null ? "v-foto-yok" : null)">
        @if (Kart.CoverPhotoId is { } photoId)
        {
            <img src="@($"/foto/{photoId}/thumb")" alt="@Kart.Baslik" width="400" height="300"
                 loading="@(Oncelikli ? "eager" : "lazy")" fetchpriority="@(Oncelikli ? "high" : null)" decoding="async" />
        }
        else
        {
            <span class="v-foto-yok-ad" aria-hidden="true">@Kart.Baslik</span>
        }
    </div>
    <div class="v-kart-govde">
        <h3><a href="@($"/araclar/{Kart.Slug}")">@Kart.Baslik</a></h3>
        @if (MetaLine is { Length: > 0 } meta)
        {
            <p class="v-kart-meta">@meta</p>
        }
        @{ var chips = Chips().Take(4).ToList(); }
        @if (chips.Count > 0)
        {
            <ul class="ozellikler v-kart-ozellik" aria-label="Özellikler">
                @foreach (var o in chips) { <li>@o.Deger</li> }
            </ul>
        }
        <div class="v-kart-fiyat">
            @if (Tarih is { } t)
            {
                <p class="fis-hesap">@t.Gun gün × @PriceText.Tl(Kart.GunlukFiyat)</p>
                <p class="fis-toplam">
                    <span class="tutar">@PriceText.Tl(t.Toplam)</span>
                    <span class="kdv">@(Kart.KdvDahil ? "KDV dahil" : "KDV hariç")</span>
                </p>
            }
            else
            {
                <p class="fis-toplam">
                    <span class="tutar">@PriceText.Tl(Kart.GunlukFiyat)</span><span class="birim">/ gün</span>
                    <span class="kdv">@(Kart.KdvDahil ? "KDV dahil" : "KDV hariç")</span>
                </p>
            }
            <a class="v-kart-teklif" href="@(TeklifLinki ?? QuoteLink.Build(Kart.Slug, dailyPrice: Kart.GunlukFiyat))">Teklif iste</a>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public FleetShowcaseCard Kart { get; set; } = default!;
    /// <summary>Tarih seçilmişse gün sayısı ve dönem toplamı; <c>null</c> = tarihsiz gezinme.</summary>
    [Parameter] public CardPeriod? Tarih { get; set; }
    [Parameter] public string? TeklifLinki { get; set; }
    [Parameter] public string? Isaret { get; set; }
    [Parameter] public bool Oncelikli { get; set; }

    private string? MetaLine
    {
        get
        {
            var parts = new List<string>(2);
            if (!string.IsNullOrWhiteSpace(Kart.YilAralik)) parts.Add($"{Kart.YilAralik} model");
            if (Kart.Adet > 1) parts.Add(Tarih is null ? $"{Kart.Adet} araç" : $"{Kart.Adet} araç müsait");
            return parts.Count == 0 ? null : string.Join(", ", parts);
        }
    }

    private IEnumerable<OzellikGoster> Chips()
        => string.IsNullOrWhiteSpace(Kart.YilAralik)
            ? Kart.Ozellikler
            : Kart.Ozellikler.Where(o => !string.Equals((o.Deger ?? "").Trim(), Kart.YilAralik.Trim(),
                StringComparison.OrdinalIgnoreCase));

    /// <summary>GEÇİCİ: temel PR'daki dönem tipi gelince onunla değiştirilir.</summary>
    public sealed record CardPeriod(int Gun, decimal Toplam);
}
