@using RentACar.Application.Fleet
@using RentACar.PublicSite.Components.Shared

@* Tema "vitrin" — Home slotu. İmza SABİT (Components/Themes/README.md): Model (HomeModel).

   AZ SÖZ, GÜÇLÜ GÖRSEL. Sıra: sahne + arama rayı (Hero) → filo ŞERİDİ (yana akan büyük fotoğraflar) → segmentler
   (lüks / SUV / elektrikli — ilan özelliklerinden; veri yoksa yok) → kurumsal kiralama ve iletişim → kısa SSS.
   Ortak "nasıl çalışır / fiyat nasıl / güven" bölümleri BİLİNÇLİ yok: üst segment ziyaretçisi aracı görmeye gelir;
   süreç metni detay sayfasının panelinde ve SSS'de.

   Sarmalayıcı öğe YOK: bölümler doğrudan <main>'in çocuğu. Filo bölümüne wrap verilmez (şerit tam genişlik;
   başlık satırını Fleet slotu kendi wrap'ında basar). *@

<ThemedHero Marka="@Model.Marka" Branding="Model.Branding" Subeler="Model.SubeAdlari" Kartlar="Model.Kartlar" Sehir="@Model.Sehir" />

@* Filo — VERİYE BAĞLI: ilan yoksa bölüm hiç basılmaz (T2). Koleksiyon Fleet slotunda (Yer=Home → şerit). *@
@if (Model.Filo.Kartlar.Count > 0)
{
    <section class="v-filo" id="filo" aria-labelledby="@Model.Filo.BaslikId">
        <ThemedFleet Model="Model.Filo" />
    </section>
}

@if (_segments.Count > 0)
{
    <section class="bolum v-segmentler" aria-labelledby="segment-baslik">
        <div class="wrap">
            <h2 id="segment-baslik" class="bolum-baslik">Sınıfa göre seçin</h2>
            <ul class="v-segment-liste">
                @foreach (var s in _segments)
                {
                    <li class="v-segment" data-segment="@s.Key">
                        <div class="v-segment-ust @(s.Kapak?.CoverPhotoId is null ? "v-foto-yok" : null)">
                            @if (s.Kapak?.CoverPhotoId is { } photo)
                            {
                                @* Süs değil ama adı ve araçları hemen altında yazılı: alt metin tekrar olurdu. *@
                                <img src="@($"/foto/{photo}/thumb")" srcset="@($"/foto/{photo}/thumb 400w, /foto/{photo} 1600w")"
                                     sizes="(min-width: 1100px) 400px, (min-width: 720px) 45vw, 100vw"
                                     alt="" width="400" height="300" loading="lazy" decoding="async" />
                            }
                            <h3 class="v-segment-ad">@s.Ad</h3>
                        </div>
                        <p class="v-segment-adet">@(s.Kartlar.Count == 1 ? "1 model" : $"{s.Kartlar.Count} model")</p>
                        <ul class="v-segment-araclar">
                            @foreach (var c in s.Kartlar)
                            {
                                <li><a href="@($"/araclar/{c.Slug}")">@c.Baslik</a></li>
                            }
                        </ul>
                    </li>
                }
            </ul>
        </div>
    </section>
}

@* Kurumsal kiralama + iletişim. Kanallar firma verisinden (T2: olmayan kanal basılmaz); hiç kanal yoksa iletişim
   sayfasına bağlantı. Metin bir davet, firma adına vaat DEĞİL (T1). *@
<section class="bolum v-kurumsal" aria-labelledby="kurumsal-baslik">
    <div class="wrap v-kurumsal-ic">
        <div class="v-kurumsal-metin">
            <h2 id="kurumsal-baslik">Şirketiniz için kiralama</h2>
            <p>Birden çok araç, uzun dönem ya da düzenli kiralama planlıyorsanız ihtiyacınızı doğrudan ekiple
                konuşun.</p>
            @if (Model.KosulSayfasi is { } terms)
            {
                <p><a href="@terms">Kiralama koşullarını okuyun</a></p>
            }
        </div>
        @if (_contact.TelLink is not null || _contact.Email is not null || _contact.WaLink is not null)
        {
            <dl class="v-kanallar">
                @if (_contact.TelLink is not null)
                {
                    <div class="v-kanal v-kanal-tel"><dt>Telefon</dt><dd><a href="@_contact.TelLink">@_contact.Phone</a></dd></div>
                }
                @if (_contact.Email is not null)
                {
                    <div class="v-kanal v-kanal-eposta"><dt>E-posta</dt><dd><a href="@($"mailto:{_contact.Email}")">@EmailLocal<wbr />@EmailDomain</a></dd></div>
                }
                @if (_contact.WaLink is not null)
                {
                    <div class="v-kanal"><dt>WhatsApp</dt><dd><a href="@_contact.WaLink" target="_blank" rel="noopener noreferrer">Mesaj yazın</a></dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Branding?.Adres))
                {
                    <div class="v-kanal v-kanal-adres"><dt>Adres</dt><dd>@Model.Branding!.Adres</dd></div>
                }
            </dl>
        }
        else
        {
            <p class="v-kurumsal-yedek"><a href="/iletisim">İletişim bilgileri</a></p>
        }
    </div>
</section>

@* Görünen soru adedi = FAQPage JSON-LD adedi (SEO L-4): Model.SssAdet değiştirilmez. *@
<BolumSss Sorular="Model.Sss" Adet="Model.SssAdet" />

@code {
    [Parameter, EditorRequired] public HomeModel Model { get; set; } = default!;

    private IReadOnlyList<VitrinSegment> _segments = [];
    private ContactLinks _contact = ContactLinks.From(null);

    /// <summary>E-posta iki parça basılır, arada &lt;wbr&gt;: dar sütunda satır @'den önce kırılır, ortadan değil.</summary>
    private string EmailLocal => _contact.Email is { } e && e.IndexOf('@') is > 0 and var at ? e[..at] : _contact.Email ?? "";
    private string EmailDomain => _contact.Email is { } e && e.IndexOf('@') is > 0 and var at ? e[at..] : "";

    protected override void OnParametersSet()
    {
        // Sahnede büyük basılan fotoğraf segment kutularında tekrar kullanılmamaya çalışılır.
        _segments = VitrinSegments.From(Model.Kartlar, VitrinHero.LeadOf(Model.Kartlar)?.CoverPhotoId);
        _contact = ContactLinks.From(Model.Branding);
    }
}
