@using RentACar.Application.Fleet
@using RentACar.PublicSite.Components.Shared

@* Tema "vitrin" — Hero slotu. İmza SABİT (Components/Themes/README.md): Marka, Branding, Subeler,
   Kartlar, Sehir. Temanın İMZASI (tema-vitrin.css "Sahne").

   SAHNE: ilk FOTOĞRAFLI ilanın kapağı tam genişlik, sinematik oranda. Model adı çok büyük Expanded harfle;
   taban çizgisi fotoğrafın alt kenarına oturur, kenarı yalnız inişli harfler geçer (kenarın altında zemin
   mürekkebi). İki renk tek metinle yapılamaz: ikinci kopya `aria-hidden`, iki kopya AYNI grid hücresinde (kayma
   yok) ve tek değerli clip-path ile kesilir (ekran okuyucu adı bir kez duyar). Telefonda ad tamamen fotoğrafın
   içinde. Ad bağlantıdır: ilanın detayına gider. Günlük fiyat sahnenin sağ alt köşesinde, sade.

   ARAMA: sahnenin alt kenarına yapışık kompakt RAY — başlık (h1) + tek satır form (geniş ekran). Telefonda ray
   sahnenin hemen altında: "Müsait araçları göster" ilk ekranda kalır.

   H1 rayın başlığıdır: sayfanın ne yaptığını söyler; büyük ad bir ilan, sayfanın konusu değil.

   FOTOĞRAF YOKSA sahne koyu zemin olur, aynı tipografi kalır (boş gri kutu yok). İlan hiç yoksa sahnede firma adı
   durur — T2: olmayan bir aracı uydurmayız. *@

<section class="v-hero @(Lead?.CoverPhotoId is null ? "v-hero-yalin" : null)" aria-labelledby="hero-baslik">
    <div class="v-sahne">
        @if (Lead?.CoverPhotoId is { } photoId)
        {
            @* Adı hemen altında yazılı; alt metni tekrarlamak ekran okuyucuda aynı adı iki kez okutur. LCP adayı:
               tembel değil, yüksek öncelikli. Çerçeve fotoğrafı kırpar: açılıştaki yavaş yakınlaşma sahneden
               taşmasın. Sahnenin kendisi kırpmaz — model adının inişli harfleri alt kenarı geçer. *@
            <div class="v-sahne-kare">
                <img class="v-sahne-foto" src="@($"/foto/{photoId}")"
                     srcset="@($"/foto/{photoId}/thumb 400w, /foto/{photoId} 1600w")" sizes="100vw"
                     width="1600" height="1067" alt="" fetchpriority="high" decoding="async" />
            </div>
        }
        <div class="wrap v-sahne-ic">
            @if (Lead is not null)
            {
                <a class="v-model @SizeClass(Lead.Baslik)" href="@($"/araclar/{Lead.Slug}")">
                    <span class="v-model-ad">@Lead.Baslik</span>
                    <span class="v-model-ad v-model-ust" aria-hidden="true">@Lead.Baslik</span>
                </a>
                <p class="v-sahne-fiyat">
                    <span class="tutar">@PriceText.Tl(Lead.GunlukFiyat)</span><span class="birim">/ gün</span>
                    <span class="kdv">@(Lead.KdvDahil ? "KDV dahil" : "KDV hariç")</span>
                </p>
            }
            else
            {
                <p class="v-model @SizeClass(BrandName)">
                    <span class="v-model-ad">@BrandName</span>
                    <span class="v-model-ad v-model-ust" aria-hidden="true">@BrandName</span>
                </p>
            }
        </div>
    </div>

    <div class="v-ray">
        <div class="wrap v-ray-ic">
            <div class="v-ray-bas">
                <h1 id="hero-baslik">Tarihinizi seçin, müsait araçları ve net fiyatı görün</h1>
                @if (!string.IsNullOrWhiteSpace(Sehir))
                {
                    @* Hizmet bölgesi firmanın kendi şube adreslerinden türer (ServiceArea) — taahhüt değil, bilgi. *@
                    <p class="v-ray-bolge">@Sehir bölgesinde araç kiralama</p>
                }
            </div>
            <AramaFormu Hedef="/musaitlik" Subeler="Subeler" Satir="true" />
        </div>
    </div>
</section>

@code {
    [Parameter] public string? Marka { get; set; }
    [Parameter] public FleetBranding? Branding { get; set; }
    [Parameter] public IReadOnlyList<string> Subeler { get; set; } = [];
    [Parameter] public IReadOnlyList<FleetShowcaseCard> Kartlar { get; set; } = [];
    [Parameter] public string? Sehir { get; set; }

    /// <summary>Sahnedeki ilan: kapak fotoğrafı olan İLK ilan (sıra firmanın vitrin sırası); hiçbirinde
    /// fotoğraf yoksa ilk ilan (sahne koyu zemine düşer). Home slotu segment kutularında bu fotoğrafı tekrar
    /// kullanmamak için aynı kuralı çağırır.</summary>
    private FleetShowcaseCard? Lead => LeadOf(Kartlar);

    internal static FleetShowcaseCard? LeadOf(IReadOnlyList<FleetShowcaseCard> cards)
        => cards.FirstOrDefault(c => c.CoverPhotoId is not null) ?? cards.FirstOrDefault();

    private string BrandName => !string.IsNullOrWhiteSpace(Marka) ? Marka!
        : !string.IsNullOrWhiteSpace(Branding?.Marka) ? Branding!.Marka! : "Araç kiralama";

    /// <summary>Uzun model adı EN ÇOK İKİ SATIRDA tamamen görünsün diye yazı boyu kademesi. Geniş ekranda boy
    /// sahnenin içinde fiyatın yanındaki alandan türer (tema-vitrin.css, cqi); eşikler oradaki bölenlerle birlikte
    /// ölçüldü — biri değişirse öteki de ölçülür. Telefonda clamp kuralı geçerli.</summary>
    private static string SizeClass(string name) => name.Length switch
    {
        <= 14 => "v-model-k",
        <= 22 => "v-model-o",
        _ => "v-model-u",
    };
}
