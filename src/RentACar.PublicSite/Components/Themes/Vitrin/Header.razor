@using RentACar.Application.Common
@using RentACar.Application.Fleet

@* Vitrin üst bar — sessiz: porselen zemin, altta tek krom çizgi. Sahne (hero) hemen altında başladığı
   için bar fotoğrafla yarışmaz; saydam bar BİLİNÇLİ YOK (her firmanın fotoğrafında okunurluk garanti
   edilemez).

   Mobil: tek satır, yapışkan değil; menü <details> (JS yok). Telefon/WhatsApp mobilde alttaki sabit
   çubukta (MainLayout) — burada yalnız geniş ekranda görünür. *@

<header class="v-bar">
    <div class="wrap v-bar-ic">
        <a class="v-marka" href="/" aria-label="@($"{BrandName} ana sayfa")">
            <BrandMark Name="@BrandName" LogoVersion="@Branding?.LogoSurum" />
        </a>
        <nav class="v-nav" aria-label="Ana menü">
            @foreach (var (href, label) in Nav) { <a href="@href">@label</a> }
        </nav>
        @if (TelLink is not null)
        {
            @* Numara METİN olarak da görünür: `tel:` açamayan masaüstünde de işe yarasın. *@
            <a class="btn btn-cizgi v-bar-tel" href="@TelLink">@Phone</a>
        }
        <details class="v-menu">
            <summary>Menü</summary>
            <ul class="v-menu-liste">
                <li><a href="/">Ana sayfa</a></li>
                @foreach (var (href, label) in Nav) { <li><a href="@href">@label</a></li> }
            </ul>
        </details>
    </div>
</header>

@code {
    [Parameter] public FleetBranding? Branding { get; set; }
    [Parameter] public IReadOnlyList<(string Href, string Label)> Nav { get; set; } = [];

    private string BrandName => string.IsNullOrWhiteSpace(Branding?.Marka) ? "RentPro" : Branding!.Marka!;
    private string? Phone => string.IsNullOrWhiteSpace(Branding?.Tel) ? Branding?.MobilTel : Branding!.Tel;
    private string? TelLink => PhoneLink.Tel(Phone);
}
