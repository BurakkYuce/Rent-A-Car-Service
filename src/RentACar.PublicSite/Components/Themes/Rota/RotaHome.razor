@using System.Globalization
@using RentACar.Application.Common

@* Tema "rota" — Home slotu. İmza SABİT (Components/Themes/README.md): Model (HomeModel).

   Ana sayfa GÖVDESİ, SEYREK ve editoryal: Hero (başlık + dikey foto + kompakt arama) → filo (numaralı fiyat
   listesi) → kiralamadan önce (üç sütun) → şubeler ve saatler → SSS → kapanış çağrısı. Güven şeridi, süreç ve
   örnek hesap bölümleri bilinçli YOK: aynı bilgi üç sütunda ve listede zaten var, sayfa sakin kalsın.

   Bölüm başlıkları burada (sol kolon); filo listesi Fleet slotunda (/musaitlik ile aynı) — başlığı bu bileşen
   bastığı için slota başlıksız model verilir (aynı id, aria-labelledby bağı korunur).

   T1: "kiralamadan önce" sütunları SİSTEMİN YAPISINI anlatır, firma adına şart/taahhüt yazmaz — sözleşmede
   sürücü kimlik/ehliyet bilgisi, depozito alanı, teslim/iade km ve yakıt kaydı gerçekten var (RentalContract).
   Firmanın kendi koşul sayfası varsa ona bağlantı verilir (T2: yoksa yok).

   Şubeler VERİYE BAĞLI (T2): adres, bölge, saat, telefon ya da konumu olan şube yoksa bölüm basılmaz.
   Harita GÖMÜLMEZ (CSP frame-src yok): koordinat varsa ona, yoksa adrese giden dış bağlantı.

   Sarmalayıcı öğe YOK: bölümler doğrudan <main>'in çocuğu (base.css `main > .cta-bant:last-child`). *@

<ThemedHero Marka="@Model.Marka" Branding="Model.Branding" Subeler="Model.SubeAdlari" Kartlar="Model.Kartlar" Sehir="@Model.Sehir" />

@if (Model.Filo.Kartlar.Count > 0)
{
    <section class="rt-bolum" id="filo" aria-labelledby="@Model.Filo.BaslikId">
        <div class="wrap">
            <div class="rt-bolum-bas">
                <h2 id="@Model.Filo.BaslikId">@(Model.Filo.Baslik ?? "Filomuz")</h2>
                <p>Günlük fiyatlar ilanda yazılı. Tarih seçerseniz o aralıkta müsait olanları ve toplam tutarı
                    gösteririz.</p>
            </div>
            <ThemedFleet Model="@(Model.Filo with { Baslik = null })" />
            <p class="rt-bolum-son"><a href="/musaitlik">Tarihlerinize göre müsait araçlar</a></p>
        </div>
    </section>
}

<section class="rt-bolum" id="kosullar" aria-labelledby="kosul-baslik">
    <div class="wrap">
        <div class="rt-bolum-bas">
            <h2 id="kosul-baslik">Kiralamadan önce bilmeniz gerekenler</h2>
        </div>
        <div class="rt-kosullar">
            @foreach (var (title, text) in Terms)
            {
                <div class="rt-kosul">
                    <h3>@title</h3>
                    <p>@text</p>
                </div>
            }
        </div>
        @if (Model.KosulSayfasi is { Length: > 0 } terms)
        {
            <p class="rt-bolum-son"><a href="@terms">Kiralama koşullarının tamamı</a></p>
        }
    </div>
</section>

@if (Branches.Count > 0)
{
    <section class="rt-bolum" id="subeler" aria-labelledby="sube-baslik">
        <div class="wrap rt-yan">
            <div class="rt-bolum-bas">
                <h2 id="sube-baslik">@BranchTitle</h2>
            </div>
            <ul class="rt-subeler">
                @foreach (var b in Branches)
                {
                    <li class="rt-sube">
                        <h3>@b.Ad</h3>
                        <div class="rt-sube-bilgi">
                            @if (b.Adres is not null || b.Bolge is not null)
                            {
                                <p class="rt-sube-adres">
                                    @if (b.Adres is not null) { @b.Adres }
                                    @if (b.Adres is not null && b.Bolge is not null) { <br /> }
                                    @if (b.Bolge is not null) { @b.Bolge }
                                </p>
                            }
                            @if (b.Saatler.Count > 0)
                            {
                                <ul class="rt-saatler" aria-label="@($"{b.Ad} çalışma saatleri")">
                                    @foreach (var line in b.Saatler) { <li>@line</li> }
                                </ul>
                            }
                        </div>
                        @if (b.TelLink is not null || b.Harita is not null)
                        {
                            <p class="rt-sube-eylem">
                                @if (b.TelLink is not null) { <a href="@b.TelLink">@b.Tel</a> }
                                @if (b.Harita is not null)
                                {
                                    <a href="@b.Harita" target="_blank" rel="noopener noreferrer">Haritada aç<span class="gorunmez">: @b.Ad</span></a>
                                }
                            </p>
                        }
                    </li>
                }
            </ul>
        </div>
    </section>
}

@* Görünen soru adedi = FAQPage JSON-LD adedi (SEO L-4): Model.SssAdet değiştirilmez. *@
<BolumSss Sorular="Model.Sss" Adet="Model.SssAdet" />

<BolumCta Telefon="@Model.Branding?.Tel" WhatsApp="@Model.Branding?.WhatsApp" />

@code {
    [Parameter, EditorRequired] public HomeModel Model { get; set; } = default!;

    /// <summary>Üç sütun. Hepsi sistemin yapısı gereği doğru (T1); firmaya özel şart yazılmaz.</summary>
    private static readonly (string Baslik, string Metin)[] Terms =
    [
        ("Sürücü ve ehliyet",
            "Kiralama sözleşmesine sürücünün kimlik ve ehliyet bilgileri yazılır. Yaş ve ehliyet süresi şartı araca göre değişebilir; talep bırakırken sorabilirsiniz."),
        ("Fiyat ve ödeme",
            "Günlük fiyat ve KDV durumu her ilanda yazılıdır; tarih seçtiğinizde toplam hesaplanır. Ödeme şekli ve varsa depozito sözleşmede yazılı olarak yer alır."),
        ("Teslim ve iade",
            "Alış ve iade tarihini, birden çok şube varsa şubeyi talep formunda seçersiniz. Aracın kilometresi ve yakıt seviyesi teslimde ve iadede kayda geçer."),
    ];

    /// <summary>Şube satırının sunuma hazır hâli (boş alanlar null; hiçbir alanı dolu olmayan şube basılmaz).</summary>
    private sealed record BranchView(string Ad, string? Adres, string? Bolge, IReadOnlyList<string> Saatler,
        string? Tel, string? TelLink, string? Harita)
    {
        public bool HasInfo => Adres is not null || Bolge is not null || Saatler.Count > 0 || TelLink is not null || Harita is not null;
    }

    private IReadOnlyList<BranchView> _branches = [];
    private IReadOnlyList<BranchView> Branches => _branches;

    private string BranchTitle
    {
        get
        {
            var hours = _branches.Any(b => b.Saatler.Count > 0);
            return (_branches.Count == 1, hours) switch
            {
                (true, true) => "Şube ve çalışma saatleri",
                (false, true) => "Şubeler ve çalışma saatleri",
                (true, false) => "Şube",
                _ => "Şubeler",
            };
        }
    }

    protected override void OnParametersSet()
        => _branches = [.. Model.Subeler.Select(View).Where(b => b.HasInfo)];

    private static BranchView View(Branch b)
    {
        var address = Text(b.Adres);
        var region = string.Join(", ", new[] { Text(b.Ilce), Text(b.Il) }.Where(x => x is not null));
        // Haftalık saat (gün başına satır) varsa o; yoksa tek satırlık çalışma saati.
        var hours = (Text(b.HaftalikCalismaSaatleri) ?? Text(b.CalismaSaatleri))?
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) ?? [];
        string? map = null;
        if (b.Enlem is { } lat && b.Boylam is { } lng)
            map = "https://www.google.com/maps/search/?api=1&query="
                + string.Create(CultureInfo.InvariantCulture, $"{lat},{lng}");
        else if (address is not null)
            map = "https://www.google.com/maps/search/?api=1&query="
                + Uri.EscapeDataString(string.Join(", ", new[] { address, region }.Where(x => !string.IsNullOrEmpty(x))));
        var phone = Text(b.Telefon);
        return new BranchView(b.Ad, address, region.Length > 0 ? region : null, hours, phone, PhoneLink.Tel(phone), map);
    }

    private static string? Text(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
}
