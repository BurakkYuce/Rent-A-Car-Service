@inject ThemeAccessor Themes

@* İlan kartı slotu — sayfalar kartı bununla basar; aktif temanın Card bileşeni çizilir.
   Parametre sözlüğü SABİT imza: Card, Dates (Components/Themes/README.md). *@
@if (_type is not null)
{
    <DynamicComponent Type="_type" Parameters="Params" />
}

@code {
    [Parameter, EditorRequired] public ListingCard Card { get; set; } = default!;
    [Parameter] public StayDates? Dates { get; set; }

    private Type? _type;

    private Dictionary<string, object?> Params => new()
    {
        [nameof(Card)] = Card,
        [nameof(Dates)] = Dates,
    };

    protected override async Task OnInitializedAsync() => _type = (await Themes.GetAsync()).Card;
}
