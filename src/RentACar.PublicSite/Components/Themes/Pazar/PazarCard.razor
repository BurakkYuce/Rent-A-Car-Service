@using RentACar.Application.Fleet

@* Tema "pazar" — Card slotu. İmza SABİT (Components/Themes/README.md): Kart, Tarih.

   Kalın çerçeveli kart + kaydırılmış düz gölge; fiyat görselin sağ üst köşesine ASILI etikette (PazarPriceTag).
   İKİ mod: (a) tarih SEÇİLMİŞ (Kart.Gun/Toplam dolu): etiket toplamı taşır ("3 gün, ₺3.750"), gövdede
   "3 gün × ₺1.250" hesabı; (b) tarih YOK: etiket günlük fiyatı taşır, "müsait" DENMEZ (T1).

   Kartın öğeleri doğrudan ızgaranın çocukları: etiket DOM'da başlıktan sonra (okuma sırası başlık → fiyat), css
   ile görselin üstüne yerleşir. Kartın tamamı detaya gider (başlık bağlantısı ::after ile kaplar), "Teklif iste"
   üstte ayrı hedef. İç içe <a> yok.

   FOTOĞRAFSIZ ilan: gri kutu yerine aracın adı büyük harflerle "tabela" olarak basılır (aria-hidden; ad zaten
   başlıkta). *@

<article class="ilan pz-kart">
    @if (!string.IsNullOrWhiteSpace(Kart.Isaret))
    {
        <p class="ilan-isaret">@Kart.Isaret</p>
    }
    <div class="ilan-foto">
        @if (Kart.CoverPhotoId is { } photoId)
        {
            @* Küçük görsel (400 px) — kart ekranda ~300-380 px. Tembel; yalnız ilk ekrandaki ilk kart (Oncelikli)
               hemen ve yüksek öncelikle iner (LCP adayı). *@
            <img src="@($"/foto/{photoId}/thumb")" alt="@Kart.Baslik" width="400" height="267"
                 loading="@(Kart.Oncelikli ? "eager" : "lazy")" fetchpriority="@(Kart.Oncelikli ? "high" : null)" decoding="async" />
        }
        else
        {
            <span class="pz-fotosuz" aria-hidden="true">@Kart.Baslik</span>
        }
    </div>
    <h3><a href="@Kart.DetayLinki">@Kart.Baslik</a></h3>
    @if (MetaLine is { Length: > 0 } meta)
    {
        <p class="ilan-yil">@meta</p>
    }
    @{ var chips = Chips().Take(4).ToList(); }
    @if (chips.Count > 0)
    {
        @* Yıl zaten üstte yazılı; aynı değeri taşıyan özellik ("2023") ikinci kez basılmaz. *@
        <ul class="ozellikler" aria-label="Özellikler">
            @foreach (var o in chips) { <li>@o.Deger</li> }
        </ul>
    }
    @if (Kart.Gun is { } days && Kart.Toplam is { } total)
    {
        <PazarPriceTag Lead="@($"{PriceText.Count(days)} gün")" Amount="@PriceText.Tl(total)" Note="@VatText" />
        <p class="pz-hesap">@PriceText.Count(days) gün × @PriceText.Tl(Kart.GunlukFiyat)</p>
    }
    else
    {
        <PazarPriceTag Amount="@PriceText.Tl(Kart.GunlukFiyat)" Unit="/ gün" Note="@VatText" />
    }
    <div class="ilan-eylem">
        <a class="btn btn-brand" href="@Kart.TeklifLinki">Teklif iste</a>
    </div>
</article>

@code {
    /// <summary>Kartın temadan bağımsız verisi (sayfa kurar).</summary>
    [Parameter, EditorRequired] public ListingCard Kart { get; set; } = default!;
    /// <summary>Ziyaretçinin seçtiği aralık; null → tarihsiz gezinti. Aralık sonuç özetinde yazılı; kart yalnız gün
    /// sayısını (Kart.Gun) basar. İmza gereği alınır.</summary>
    [Parameter] public StayDates? Tarih { get; set; }

    private string VatText => Kart.KdvDahil ? "KDV dahil" : "KDV hariç";

    /// <summary>"2023 model, 3 araç" — tarih seçiliyse "müsait" denebilir (kirada olanlar düşülmüş).</summary>
    private string? MetaLine
    {
        get
        {
            var parts = new List<string>(2);
            if (!string.IsNullOrWhiteSpace(Kart.YilAralik)) parts.Add($"{Kart.YilAralik} model");
            if (Kart.Adet > 1) parts.Add(Kart.Gun is null ? $"{Kart.Adet} araç" : $"{Kart.Adet} araç müsait");
            return parts.Count == 0 ? null : string.Join(", ", parts);
        }
    }

    private IEnumerable<OzellikGoster> Chips()
        => string.IsNullOrWhiteSpace(Kart.YilAralik)
            ? Kart.Ozellikler
            : Kart.Ozellikler.Where(o => !string.Equals((o.Deger ?? "").Trim(), Kart.YilAralik.Trim(),
                StringComparison.OrdinalIgnoreCase));
}
