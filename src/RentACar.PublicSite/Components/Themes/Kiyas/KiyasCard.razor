@using RentACar.Application.Fleet

@* Tema "kiyas" — Card slotu. İmza SABİT (Components/Themes/README.md): Card, Dates.

   Karşılaştırma kartı: tek tip açık gri kutuda görsel (`contain` — karışık fotoğraflar da düzenli durur; yoksa
   silüet), ad + fiyat aynı blokta, altında teknik satır (vites, yakıt, koltuk — ilanın görünür özelliklerinden), koşul rozetleri (firmanın
   beyanı; Fleet slotundan `KiyasBadges` basamaklı değeriyle — Card imzası sabit), fiyat dökümü eş genişlikli
   rakamla: tarih SEÇİLMİŞSE "₺1.650 × 3 gün" ve toplam; yoksa günlük fiyat, "müsait" DENMEZ (T1). Kartın tamamı
   detaya gider; "Rezervasyon talebi" ve (WhatsAppLink varsa) "WhatsApp" ayrı hedefler. İç içe <a> yok. *@

<article class="ky-kart">
    @if (!string.IsNullOrWhiteSpace(Card.Badge))
    {
        <p class="ky-isaret">@Card.Badge</p>
    }
    <div class="ky-kart-foto">
        @if (Card.CoverPhotoId is { } photoId)
        {
            <img src="@($"/foto/{photoId}/thumb")" alt="@Card.Baslik" width="400" height="300"
                 loading="@(Card.Priority ? "eager" : "lazy")" fetchpriority="@(Card.Priority ? "high" : null)" decoding="async" />
        }
        else
        {
            <VehicleSilhouette />
        }
    </div>
    @* Ad ve fiyat AYNI blokta, kartın üstünde (kullanıcı kararı): göz önce ada ve toplama gider; teknik satır ve
       rozetler fiyatın altında. *@
    <div class="ky-kart-bas">
        <h3><a href="@Card.DetailUrl">@Card.Baslik</a></h3>
        @if (MetaLine is { Length: > 0 } meta) { <p class="ky-kart-meta">@meta</p> }
        @if (Card.Days is { } days && Card.Total is { } total)
        {
            <p class="ky-fiyat"><span class="ky-tutar">@PriceText.Tl(total)</span> <span class="ky-kdv">@VatText</span></p>
            <p class="ky-dokum">@PriceText.Tl(Card.GunlukFiyat) × @PriceText.Count(days) gün</p>
        }
        else
        {
            <p class="ky-fiyat"><span class="ky-tutar">@PriceText.Tl(Card.GunlukFiyat)</span> <span class="ky-birim">/ gün</span> <span class="ky-kdv">@VatText</span></p>
        }
    </div>
    <div class="ky-kart-govde">
        @if (FleetFilter.SpecLine(Card) is { } spec) { <p class="ky-teknik">@spec</p> }
        @if (Badges.Count > 0)
        {
            <ul class="ky-rozetler" aria-label="Kiralama koşulları">
                @foreach (var (text, kind) in Badges) { <li class="ky-rozet-@kind">@text</li> }
            </ul>
        }
    </div>
    <div class="ky-kart-alt">
        <div class="ky-kart-eylem">
            <a class="btn btn-brand" href="@Card.QuoteUrl">Rezervasyon talebi</a>
            @if (Card.WhatsAppLink is not null)
            {
                <a class="btn btn-cizgi ky-kart-wa" href="@Card.WhatsAppLink" target="_blank" rel="noopener noreferrer">WhatsApp<span class="gorunmez">'tan sor: @Card.Baslik</span></a>
            }
        </div>
    </div>
</article>

@code {
    /// <summary>Kartın temadan bağımsız verisi (sayfa kurar).</summary>
    [Parameter, EditorRequired] public ListingCard Card { get; set; } = default!;
    /// <summary>Seçilen aralık; null → tarihsiz gezinti. Kart yalnız gün sayısını (Card.Days) basar.</summary>
    [Parameter] public StayDates? Dates { get; set; }

    /// <summary>Firmanın koşul rozetleri (KiyasFleet basamaklar); yoksa boş.</summary>
    [CascadingParameter(Name = "KiyasBadges")] public IReadOnlyList<(string Text, string Kind)>? CascadedBadges { get; set; }

    private IReadOnlyList<(string Text, string Kind)> Badges => CascadedBadges ?? [];
    private string VatText => Card.KdvDahil ? "KDV dahil" : "KDV hariç";

    /// <summary>"2023 model, 3 araç" — tarih seçiliyse "3 araç müsait".</summary>
    private string? MetaLine
    {
        get
        {
            var parts = new List<string>(2);
            if (!string.IsNullOrWhiteSpace(Card.YearRange)) parts.Add($"{Card.YearRange} model");
            if (Card.VehicleCount > 1) parts.Add(Card.Days is null ? $"{Card.VehicleCount} araç" : $"{Card.VehicleCount} araç müsait");
            return parts.Count == 0 ? null : string.Join(", ", parts);
        }
    }
}
