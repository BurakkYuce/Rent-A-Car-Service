@using RentACar.Application.Fleet

@* Tema "paket" — Hero slotu. İmza SABİT (Components/Themes/README.md): Marka, Branding, Subeler, Kartlar, Sehir.

   İlk ekranın işi "aylık paketi seç": geniş tipografik başlık, en düşük AYLIK fiyat (yalnız ilanlarda girilmiş 30 günlük
   toplamlardan; hiç yoksa en düşük günlük fiyat — aylık fiyat uydurulmaz), iki eylem (araçlar, teklif) ve yanda
   ortak arama formu (tarihle toplam). Firmanın koşulları ana sayfada ayrı bölümde. "Her şey dahil" gibi bir taahhüt
   YAZILMAZ (T1). Fotoğraf yok, animasyon yok. *@

<section class="pk-hero" aria-labelledby="hero-baslik">
    <div class="wrap pk-hero-ic">
        <div class="pk-hero-metin">
            <h1 id="hero-baslik">@(string.IsNullOrWhiteSpace(Sehir) ? "Aylık ve uzun dönem araç kiralama" : $"{Sehir} bölgesinde aylık ve uzun dönem araç kiralama")</h1>
            @if (!string.IsNullOrWhiteSpace(Marka) || _founded is not null)
            {
                <p class="pk-kunye">@(string.Join(", ", new[] { Marka, _founded }.Where(x => !string.IsNullOrWhiteSpace(x))))</p>
            }
            @if (_lead is { } lead)
            {
                <p class="pk-baslangic">
                    <span class="pk-baslangic-etiket">@lead.Label</span>
                    <span class="pk-buyuk-rakam">@PriceText.Tl(lead.Amount)</span><span class="pk-birim">@lead.Unit</span>
                    <span class="pk-kdv">@(lead.Vat ? "KDV dahil" : "KDV hariç")</span>
                </p>
            }
            <div class="pk-hero-eylem">
                <a class="btn btn-brand" href="/musaitlik">Araçları ve fiyatları gör</a>
                <a class="btn btn-cizgi" href="#kurumsal">Teklif alın</a>
            </div>
        </div>
        <div class="pk-hero-form">
            <h2 class="pk-hero-form-baslik">Tarihinize göre toplam</h2>
            <AramaFormu Hedef="/musaitlik" Subeler="Subeler" ButonMetni="Toplamı gör" AriaLabel="Tarihe göre araç ve fiyat ara" />
        </div>
    </div>
</section>

@code {
    /// <summary>Marka adı (künyede).</summary>
    [Parameter] public string? Marka { get; set; }
    /// <summary>Firma bilgisi (kuruluş yılı, koşullar).</summary>
    [Parameter] public FleetBranding? Branding { get; set; }
    /// <summary>Aktif şube adları (arama formunun seçim kutusu).</summary>
    [Parameter] public IReadOnlyList<string> Subeler { get; set; } = [];
    /// <summary>Yayındaki ilanlar (en düşük aylık/günlük fiyat).</summary>
    [Parameter] public IReadOnlyList<FleetShowcaseCard> Kartlar { get; set; } = [];
    /// <summary>Hizmet bölgesi; null → başlık bölgesiz.</summary>
    [Parameter] public string? Sehir { get; set; }

    private sealed record Lead(string Label, decimal Amount, string Unit, bool Vat);

    private string? _founded;
    private Lead? _lead;

    protected override void OnParametersSet()
    {
        _founded = SiteFactsText.Founded(Branding?.Bilgi);
        var monthly = Kartlar.Where(k => k.AylikToplam is > 0m).MinBy(k => k.AylikToplam);
        var daily = Kartlar.MinBy(k => k.GunlukFiyat);
        _lead = monthly is not null ? new Lead("En düşük aylık fiyat", monthly.AylikToplam!.Value, " / ay", monthly.KdvDahil)
            : daily is not null ? new Lead("En düşük günlük fiyat", daily.GunlukFiyat, " / gün", daily.KdvDahil)
            : null;
    }
}
