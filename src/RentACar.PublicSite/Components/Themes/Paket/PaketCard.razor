@using RentACar.Application.Fleet

@* Tema "paket" — Card slotu. İmza SABİT (Components/Themes/README.md): Card, Dates.

   Büyük, sakin kart: 16:10 görsel (yoksa tipografik "tabela": büyük model adı + silüet), ad, teknik satır, fiyat.
   Fiyat önceliği: tarih SEÇİLMİŞSE seçilen günlerin toplamı ("₺X × N gün"); değilse ilanda AYLIK toplam girilmişse
   "₺38.500 / ay" büyük, günlük küçük; o da yoksa günlük fiyat. Aylık fiyat UYDURULMAZ (günlük × 30 yazılmaz).
   "müsait" yalnız tarihliyken (T1). Kartın tamamı detaya gider; "Teklif alın" ve (WhatsAppLink varsa) WhatsApp ayrı. *@

<article class="pk-kart">
    @if (!string.IsNullOrWhiteSpace(Card.Badge))
    {
        <p class="pk-isaret">@Card.Badge</p>
    }
    <div class="pk-kart-foto">
        @if (Card.CoverPhotoId is { } photoId)
        {
            <img src="@($"/foto/{photoId}/thumb")" alt="@Card.Baslik" width="400" height="250"
                 loading="@(Card.Priority ? "eager" : "lazy")" fetchpriority="@(Card.Priority ? "high" : null)" decoding="async" />
        }
        else
        {
            <div class="pk-tabela" aria-hidden="true"><span>@Card.Baslik</span><VehicleSilhouette /></div>
        }
    </div>
    <div class="pk-kart-govde">
        <h3><a href="@Card.DetailUrl">@Card.Baslik</a></h3>
        @if (Spec is { Length: > 0 } spec) { <p class="pk-teknik">@spec</p> }
        <div class="pk-kart-fiyat">
            @if (Card.Days is { } days && Card.Total is { } total)
            {
                <p class="pk-fiyat"><span class="pk-tutar">@PriceText.Tl(total)</span> <span class="pk-birim">@PriceText.Count(days) gün</span></p>
                <p class="pk-fiyat-alt">@PriceText.Tl(Card.GunlukFiyat) × @PriceText.Count(days) gün, @VatText</p>
            }
            else if (Card.AylikToplam is { } month)
            {
                <p class="pk-fiyat"><span class="pk-tutar">@PriceText.Tl(month)</span> <span class="pk-birim">/ ay</span></p>
                <p class="pk-fiyat-alt">Günlük @PriceText.Tl(Card.GunlukFiyat), @VatText</p>
            }
            else
            {
                <p class="pk-fiyat"><span class="pk-tutar">@PriceText.Tl(Card.GunlukFiyat)</span> <span class="pk-birim">/ gün</span></p>
                <p class="pk-fiyat-alt">@VatText</p>
            }
        </div>
        <div class="pk-kart-eylem">
            <a class="btn btn-brand" href="@Card.QuoteUrl">Teklif alın</a>
            @if (Card.WhatsAppLink is not null)
            {
                <a class="btn btn-cizgi" href="@Card.WhatsAppLink" target="_blank" rel="noopener noreferrer">WhatsApp<span class="gorunmez">'tan sor: @Card.Baslik</span></a>
            }
        </div>
    </div>
</article>

@code {
    /// <summary>Kartın temadan bağımsız verisi (sayfa kurar).</summary>
    [Parameter, EditorRequired] public ListingCard Card { get; set; } = default!;
    /// <summary>Seçilen aralık; null → tarihsiz gezinti.</summary>
    [Parameter] public StayDates? Dates { get; set; }

    private string VatText => Card.KdvDahil ? "KDV dahil" : "KDV hariç";

    /// <summary>"2024 model, Otomatik, Hibrit, 5 kişilik" — yıl + teknik satır (en çok 3 özellik), adet ayrı.</summary>
    private string? Spec
    {
        get
        {
            var parts = new List<string>(3);
            if (!string.IsNullOrWhiteSpace(Card.YearRange)) parts.Add($"{Card.YearRange} model");
            if (FleetFilter.SpecLine(Card) is { } spec) parts.Add(spec);
            if (Card.VehicleCount > 1) parts.Add(Card.Days is null ? $"{Card.VehicleCount} araç" : $"{Card.VehicleCount} araç müsait");
            return parts.Count == 0 ? null : string.Join(", ", parts);
        }
    }
}
