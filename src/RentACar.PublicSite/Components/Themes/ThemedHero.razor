@using RentACar.Application.Fleet
@inject ThemeAccessor Themes

@* Hero slotu — ana sayfa bununla basar; aktif temanın Hero bileşeni çizilir.
   Parametre sözlüğü SABİT imza: BrandName, Branding, Branches, Cards, Area (Components/Themes/README.md). *@
@if (_type is not null)
{
    <DynamicComponent Type="_type" Parameters="Params" />
}

@code {
    [Parameter] public string? BrandName { get; set; }
    [Parameter] public FleetBranding? Branding { get; set; }
    [Parameter] public IReadOnlyList<string> Branches { get; set; } = [];
    [Parameter] public IReadOnlyList<FleetShowcaseCard> Cards { get; set; } = [];
    [Parameter] public string? Area { get; set; }

    private Type? _type;

    private Dictionary<string, object?> Params => new()
    {
        [nameof(BrandName)] = BrandName,
        [nameof(Branding)] = Branding,
        [nameof(Branches)] = Branches,
        [nameof(Cards)] = Cards,
        [nameof(Area)] = Area,
    };

    protected override async Task OnInitializedAsync() => _type = (await Themes.GetAsync()).Hero;
}
