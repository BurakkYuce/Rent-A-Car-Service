@using RentACar.Application.Fleet

@* Tema "anahtar" — Header slotu. İmza SABİT (Components/Themes/README.md): Branding, Nav.

   Yapışkan ince bar: marka solda, menü ortada; sağda telefon NUMARASI metin olarak (`tel:` açamayan masaüstünde de
   okunur) ve WhatsApp düğmesi (sabit koyu yeşil, beyaz yazı AA). Telefonda numara ve WhatsApp barda değil, alt eylem
   çubuğunda (MainLayout) — bar yalnız marka + menü. Kanal yoksa öğesi basılmaz (T2). Menü <details> (JS yok). *@

<header class="bar">
    <div class="wrap an-bar-ic">
        <a class="an-marka" href="/" aria-label="@($"{Name} ana sayfa")">
            <BrandMark Name="@Name" LogoVersion="@Branding?.LogoVersion" />
        </a>
        <nav class="an-nav" aria-label="Ana menü">
            @foreach (var n in Nav) { <a href="@n.Href">@n.Label</a> }
        </nav>
        @if (_contact.TelLink is not null)
        {
            <a class="an-bar-tel" href="@_contact.TelLink">@_contact.Phone</a>
        }
        @if (_contact.WaLink is not null)
        {
            <a class="btn btn-wa an-bar-wa" href="@_contact.WaLink" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        }
        <details class="an-menu">
            <summary>Menü</summary>
            <ul>
                <li><a href="/">Ana sayfa</a></li>
                @foreach (var n in Nav) { <li><a href="@n.Href">@n.Label</a></li> }
            </ul>
        </details>
    </div>
</header>

@code {
    /// <summary>Firma bilgisi (ad, logo sürümü, iletişim). Null → nötr kabuk.</summary>
    [Parameter] public FleetBranding? Branding { get; set; }
    /// <summary>Ana menü bağlantıları ("Ana sayfa" hariç).</summary>
    [Parameter] public IReadOnlyList<SiteLink> Nav { get; set; } = [];

    private ContactLinks _contact = ContactLinks.From(null);
    private string Name => string.IsNullOrWhiteSpace(Branding?.BrandName) ? "RentPro" : Branding!.BrandName!;

    protected override void OnParametersSet() => _contact = ContactLinks.From(Branding, Name);
}
