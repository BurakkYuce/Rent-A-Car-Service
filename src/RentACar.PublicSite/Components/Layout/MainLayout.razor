@inherits LayoutComponentBase
@using RentACar.Application.Blog
@using RentACar.Application.Common
@using RentACar.Application.Fleet
@using RentACar.Application.SiteIcerik
@inject FleetShowcaseService Showcase
@inject BlogService Blog
@inject SiteContentService Icerik

@* PR-15: site kabuğu (üst bar + alt bilgi) BURAYA taşındı. Önce her sayfa kendi
   başlığını/iletişim satırını basıyordu; marka ve gezinme tek yerde olmalı.
   Sayfaların kendi <h1>'i KALIR (sayfa başlığı) — üst bardaki marka ondan ayrıdır. *@
<div class="page">
    <header class="site-bar">
        <div class="site-bar-ic">
            <a class="site-marka" href="/">@Marka</a>
            <nav class="site-nav">
                <a href="/">Filomuz</a>
                <a href="/musaitlik">Müsaitlik ve Fiyat</a>
                @if (_sssVar) { <a href="/sss">S.S.S.</a> }
                @if (_blogVar) { <a href="/blog">Blog</a> }
                <a href="/iletisim">İletişim</a>
            </nav>
            @if (_telLink is not null)
            {
                @* Numara METİN olarak da görünür: `tel:` linkini açamayan masaüstünde de işe yarasın. *@
                <a class="btn-cta" href="@_telLink">@_branding!.Tel</a>
            }
        </div>
    </header>

    <main>
        @Body
    </main>

    <footer class="site-footer">
        <div class="site-footer-ic">
            <div>
                <h2>@Marka</h2>
                @if (!string.IsNullOrWhiteSpace(_branding?.Adres)) { <p>@_branding!.Adres</p> }
            </div>
            <div>
                <h2>İletişim</h2>
                <ul>
                    @if (_telLink is not null) { <li><a href="@_telLink">@_branding!.Tel</a></li> }
                    @if (!string.IsNullOrWhiteSpace(_branding?.Email))
                    {
                        <li><a href="@($"mailto:{_branding!.Email}")">@_branding!.Email</a></li>
                    }
                </ul>
            </div>
            <div>
                <h2>Sayfalar</h2>
                <ul>
                    <li><a href="/">Filomuz</a></li>
                    <li><a href="/musaitlik">Müsaitlik ve fiyat sorgula</a></li>
                    @if (_sssVar) { <li><a href="/sss">Sık sorulan sorular</a></li> }
                    @if (_blogVar) { <li><a href="/blog">Blog</a></li> }
                    <li><a href="/iletisim">İletişim</a></li>
                    @* PR-16: firmanın kendi yazdığı sayfalar (sıra alanına göre).
                       Yasal metinler bu listeden ÇIKARILDI — kendi sütunlarında yaşıyorlar,
                       aksi halde alt bilgide iki kez görünürlerdi. *@
                    @foreach (var sf in _digerSayfalar)
                    {
                        <li><a href="@($"/{sf.Slug}")">@sf.Baslik</a></li>
                    }
                </ul>
            </div>
            @* Yasal sütunu YALNIZ yayında yasal sayfa varsa basılır: yayında olmayan bir slug'a
               link vermek 404 üretir (Sayfa.razor bilinçli olarak gerçek 404 döner). Sabit
               "/gizlilik" linki basmak, sayfa hiç yazılmamışken kırık bağlantı demekti. *@
            @if (_yasalSayfalar.Count > 0)
            {
                <div>
                    <h2>Yasal</h2>
                    <ul>
                        @foreach (var sf in _yasalSayfalar)
                        {
                            <li><a href="@($"/{sf.Slug}")">@sf.Baslik</a></li>
                        }
                    </ul>
                </div>
            }
        </div>
        <div class="site-footer-alt">© @DateTime.Now.Year @Marka</div>
    </footer>

    @* ---- Çerez bilgilendirme şeridi ----
       `hidden` SUNUCUDAN gelir; yalnız `js/rc-cerez.js` açar (bkz. o dosyanın başlığı):
       JS yoksa şerit hiç görünmez ve sayfa tam çalışır.

       METİN DÜRÜSTLÜĞÜ: bu sitede analitik/izleme/reklam çerezi YOK (kod okunarak doğrulandı —
       Program.cs'te oturum/analitik yok, üçüncü taraf betik yok, tek çerez rezervasyon talep
       formundaki antiforgery/CSRF çerezi). Zorunlu çerez için izin alınmaz; bu yüzden burada
       "Kabul et / Reddet" ikilisi YOK — reddedilecek bir izleme olmadığı halde "Reddet"
       göstermek, kullanıcıya sahte bir seçim (ve sahte bir koruma hissi) sunardı. Şerit bir
       ONAY değil BİLGİLENDİRME'dir; tek eylem "Tamam"dır.
       İleride izin gerektiren bir çerez eklenirse: gerçek Kabul/Reddet düğmeleri buraya gelir ve
       rc-cerez.js'teki ANAHTAR v2'ye çıkarılır (eski kayıt yeni izni kapsamaz). *@
    <section id="cerez-serit" class="cerez-serit" hidden aria-label="Çerez bilgilendirmesi">
        @* MOBİL KISALTMA: metin tek parça 470 karakterdi ve şerit 375px'te 286px yer kaplıyordu
           (ekranın %43'ü) — telefonda şerit sayfayı yiyordu. Metin İKİYE bölündü:
             .cerez-ozet   → her yerde görünen ÇEKİRDEK bilgi (tek başına da doğru ve yeterli);
             .cerez-detay  → yalnız ≥641px'te görünen teknik ayrıntı (site.css mobil bloğu gizler).
           Masaüstünde ikisi peş peşe basılır ve eskisiyle aynı tam metin okunur; hiçbir bilgi
           silinmedi, mobilde yalnız SIRALANDI. Ayrıntı, çerez politikası sayfası yayındaysa
           "Ayrıntılı bilgi" bağlantısıyla mobilde de erişilebilir kalır; sayfa yayında değilse
           özet metnin kendisi tek başına doğru bilgiyi verdiği için eksik bilgi doğmaz. *@
        <p class="cerez-metin">
            <span class="cerez-ozet">Bu sitede <strong>yalnızca zorunlu çerezler</strong> kullanılır;
                ziyaretçi takibi, reklam ve analitik çerezi yoktur.</span>
            <span class="cerez-detay">Rezervasyon talep formunu açtığınızda, formu sahte isteklere
                karşı korumak için tarayıcınıza tek bir teknik çerez yazılır; üçüncü taraf hiçbir
                betik yüklenmez. Zorunlu çerezler için izin alınmadığından burada reddedilecek bir
                izleme yoktur.</span>
            @if (_cerezPolitikasiSlug is not null)
            {
                <a href="@($"/{_cerezPolitikasiSlug}")">Ayrıntılı bilgi</a>
            }
        </p>
        <button type="button" class="btn-cta" data-cerez-kapat>Tamam</button>
    </section>
</div>

@code {
    private FleetBranding? _branding;
    private string? _telLink;
    private bool _blogVar;
    private bool _sssVar;
    // Yayındaki içerik sayfaları alt bilgide İKİYE ayrılır: yasal metinler kendi sütununda
    // (görünürlük + KVKK/çerez şeridinin hedefi), gerisi "Sayfalar" sütununda.
    private IReadOnlyList<SayfaOzet> _digerSayfalar = [];
    private IReadOnlyList<SayfaOzet> _yasalSayfalar = [];
    private string? _cerezPolitikasiSlug;

    private string Marka => string.IsNullOrWhiteSpace(_branding?.Marka) ? "RentPro" : _branding!.Marka!;

    protected override async Task OnInitializedAsync()
    {
        // Kabuk, içerik servisleri patlasa DA basılmalı: alan adı henüz çözülmemiş ya da site
        // kapatılmış olabilir (App.razor'daki canonical ile aynı savunma).
        try
        {
            _branding = await Showcase.GetBrandingAsync();
            _telLink = PhoneLink.Tel(_branding.Tel);
            _blogVar = (await Blog.ListPublishedAsync()).Count > 0;
            var sayfalar = await Icerik.PublishedPagesAsync();
            _yasalSayfalar = sayfalar.Where(YasalSayfalar.Yasal).ToList();
            _digerSayfalar = sayfalar.Where(s => !YasalSayfalar.Yasal(s)).ToList();
            _cerezPolitikasiSlug = YasalSayfalar.CerezPolitikasiSlug(sayfalar);
            _sssVar = (await Icerik.PublishedFaqAsync()).Count > 0;
        }
        catch
        {
            // Marka çözülemedi → nötr kabuk. Sayfa içeriği kendi hatasını kendi gösterir.
        }
    }
}
