@inherits LayoutComponentBase
@using RentACar.Application.Blog
@using RentACar.Application.Fleet
@using RentACar.Application.SiteIcerik
@inject FleetShowcaseService Showcase
@inject BlogService Blog
@inject SiteContentService Icerik
@inject ThemeAccessor Themes

@* Site kabuğu. Veri (marka, menü, sayfalar) BURADA toplanır; üst bar ve alt bilgi aktif temanın
   Header/Footer SLOTLARIYLA çizilir (Components/Themes/README.md — imzalar sabit). Alt eylem çubuğu ve
   çerez şeridi TEMADAN BAĞIMSIZ (ortak davranış, base.css).

   MOBİL: iletişim (Ara / WhatsApp) ekranın altındaki sabit çubukta; kanal yoksa çubuk basılmaz (T2).
   `data-slot` sarmalayıcıları `display: contents` (base.css) — temanın yapışkan barı bozulmaz. *@
<div class="page @(_altbar ? "altbar-acik" : null)">
    <a class="gorunmez atla" href="#icerik">İçeriğe geç</a>
    <div data-slot="header">
        @if (_theme is not null)
        {
            <DynamicComponent Type="_theme.Header" Parameters="HeaderParams" />
        }
    </div>

    <main id="icerik" tabindex="-1">
        @Body
    </main>

    <div data-slot="footer">
        @if (_theme is not null)
        {
            <DynamicComponent Type="_theme.Footer" Parameters="FooterParams" />
        }
    </div>

    @if (_altbar)
    {
        <nav class="altbar" aria-label="Hızlı iletişim">
            @if (_contact.TelLink is not null) { <a class="btn btn-brand" href="@_contact.TelLink">Ara</a> }
            @if (_contact.WaLink is not null) { <a class="btn btn-cizgi" href="@_contact.WaLink" target="_blank" rel="noopener noreferrer">WhatsApp</a> }
        </nav>
    }

    <CookieNotice PolicySlug="@_cookiePolicySlug" />
</div>

@code {
    private SiteTheme? _theme;
    private FleetBranding? _branding;
    private ContactLinks _contact = ContactLinks.From(null);
    private bool _altbar;
    private IReadOnlyList<SiteLink> _nav = [new("/musaitlik", "Araçlar ve fiyatlar"), new("/iletisim", "İletişim")];
    private IReadOnlyList<SiteLink> _pages = [];
    private IReadOnlyList<SiteLink> _legal = [];
    private string? _cookiePolicySlug;

    private Dictionary<string, object?> HeaderParams => new()
    {
        ["Branding"] = _branding,
        ["Nav"] = _nav,
    };

    private Dictionary<string, object?> FooterParams => new()
    {
        ["Branding"] = _branding,
        ["Sayfalar"] = _pages,
        ["YasalSayfalar"] = _legal,
    };

    protected override async Task OnInitializedAsync()
    {
        _theme = await Themes.GetAsync();
        _pages = [new("/", "Ana sayfa"), .. _nav];
        // Kabuk, içerik servisleri patlasa DA basılmalı (alan adı çözülmemiş / site kapalı olabilir).
        try
        {
            _branding = await Showcase.GetBrandingAsync();
            _contact = ContactLinks.From(_branding, string.IsNullOrWhiteSpace(_branding.Marka) ? "RentPro" : _branding.Marka);
            _altbar = _contact.TelLink is not null || _contact.WaLink is not null;

            var nav = new List<SiteLink> { new("/musaitlik", "Araçlar ve fiyatlar") };
            if ((await Icerik.PublishedFaqAsync()).Count > 0) nav.Add(new("/sss", "Sık sorulanlar"));
            if ((await Blog.ListPublishedAsync()).Count > 0) nav.Add(new("/blog", "Blog"));
            nav.Add(new("/iletisim", "İletişim"));
            _nav = nav;

            // Yayındaki içerik sayfaları İKİYE ayrılır: yasal metinler kendi sütununda (görünürlük + çerez
            // şeridinin hedefi), gerisi "Sayfalar"da.
            var pages = await Icerik.PublishedPagesAsync();
            _legal = [.. pages.Where(LegalPages.Legal).Select(s => new SiteLink($"/{s.Slug}", s.Baslik))];
            _pages = [new("/", "Ana sayfa"), .. _nav,
                .. pages.Where(s => !LegalPages.Legal(s)).Select(s => new SiteLink($"/{s.Slug}", s.Baslik))];
            _cookiePolicySlug = LegalPages.CookiePolicySlug(pages);
        }
        catch
        {
            // Marka çözülemedi → nötr kabuk. Sayfa içeriği kendi hatasını kendi gösterir.
        }
    }
}
