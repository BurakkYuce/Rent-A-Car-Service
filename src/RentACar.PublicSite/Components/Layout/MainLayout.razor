@inherits LayoutComponentBase
@using RentACar.Application.Blog
@using RentACar.Application.Common
@using RentACar.Application.Fleet
@using RentACar.Application.SiteIcerik
@inject FleetShowcaseService Showcase
@inject BlogService Blog
@inject SiteContentService Icerik

@* PR-15: site kabuğu (üst bar + alt bilgi) tek yerde; sayfaların kendi <h1>'i KALIR.

   Firma kimliği: logo yüklüyse /marka/logo (sürümlü adres, uzun önbellek), yoksa marka adı levha
   yazısıyla. Vurgu rengi App.razor'daki <style> bloğundan gelir (BrandPalette).

   MOBİL: üst bar tek satır ve yapışkan değil; menü <details> ile (JS yok). İletişim (Ara / WhatsApp)
   ekranın altındaki sabit çubukta — SEO denetiminde 375px'te üst bar 182px'ti ve eylemler ilk ekranın
   dışında kalıyordu. Kanal yoksa çubuk hiç basılmaz (T2). *@
<div class="page @(_altbar ? "altbar-acik" : null)">
    <a class="gorunmez atla" href="#icerik">İçeriğe geç</a>
    <header class="bar">
        <div class="wrap bar-ic">
            <a class="marka" href="/" aria-label="@($"{BrandName} ana sayfa")">
                <BrandMark Name="@BrandName" LogoVersion="@_branding?.LogoSurum" />
            </a>
            <nav class="nav-genis" aria-label="Ana menü">
                @foreach (var (href, label) in _navItems) { <a href="@href">@label</a> }
            </nav>
            @if (_waLink is not null)
            {
                <a class="btn btn-cizgi bar-tel" href="@_waLink" target="_blank" rel="noopener noreferrer">WhatsApp</a>
            }
            @if (_telLink is not null)
            {
                @* Numara METİN olarak da görünür: `tel:` açamayan masaüstünde de işe yarasın. *@
                <a class="btn btn-brand bar-tel" href="@_telLink">@_phone</a>
            }
            <details class="menu">
                <summary>Menü</summary>
                <ul class="menu-liste">
                    <li><a href="/">Ana sayfa</a></li>
                    @foreach (var (href, label) in _navItems) { <li><a href="@href">@label</a></li> }
                </ul>
            </details>
        </div>
    </header>

    <main id="icerik" tabindex="-1">
        @Body
    </main>

    <footer class="alt">
        <div class="wrap alt-ic">
            <div>
                <a class="marka" href="/"><BrandMark Name="@BrandName" LogoVersion="@_branding?.LogoSurum" /></a>
                @if (!string.IsNullOrWhiteSpace(_branding?.Adres)) { <p class="small">@_branding!.Adres</p> }
            </div>
            @if (_telLink is not null || _waLink is not null || !string.IsNullOrWhiteSpace(_branding?.Email))
            {
                <div>
                    <p class="alt-baslik">İletişim</p>
                    <ul>
                        @if (_telLink is not null) { <li><a href="@_telLink">@_phone</a></li> }
                        @if (_waLink is not null) { <li><a href="@_waLink" target="_blank" rel="noopener noreferrer">WhatsApp'tan yazın</a></li> }
                        @if (!string.IsNullOrWhiteSpace(_branding?.Email))
                        {
                            <li><a href="@($"mailto:{_branding!.Email}")">@_branding!.Email</a></li>
                        }
                    </ul>
                </div>
            }
            <div>
                <p class="alt-baslik">Sayfalar</p>
                <ul>
                    <li><a href="/">Ana sayfa</a></li>
                    @foreach (var (href, label) in _navItems) { <li><a href="@href">@label</a></li> }
                    @* PR-16: firmanın kendi yazdığı sayfalar; yasal metinler kendi sütununda. *@
                    @foreach (var sf in _otherPages) { <li><a href="@($"/{sf.Slug}")">@sf.Baslik</a></li> }
                </ul>
            </div>
            @* Yasal sütunu YALNIZ yayında yasal sayfa varsa: yayında olmayan slug'a link 404 üretir. *@
            @if (_legalPages.Count > 0)
            {
                <div>
                    <p class="alt-baslik">Yasal</p>
                    <ul>
                        @foreach (var sf in _legalPages) { <li><a href="@($"/{sf.Slug}")">@sf.Baslik</a></li> }
                    </ul>
                </div>
            }
        </div>
        <div class="alt-son"><div class="wrap">© @DateTime.Now.Year @BrandName</div></div>
    </footer>

    @if (_altbar)
    {
        <nav class="altbar" aria-label="Hızlı iletişim">
            @if (_telLink is not null) { <a class="btn btn-brand" href="@_telLink">Ara</a> }
            @if (_waLink is not null) { <a class="btn btn-cizgi" href="@_waLink" target="_blank" rel="noopener noreferrer">WhatsApp</a> }
        </nav>
    }

    <CookieNotice PolicySlug="@_cookiePolicySlug" />
</div>

@code {
    private FleetBranding? _branding;
    private string? _telLink, _waLink, _phone;
    private bool _altbar;
    private IReadOnlyList<(string Href, string Label)> _navItems = [("/musaitlik", "Araçlar ve fiyatlar"), ("/iletisim", "İletişim")];
    private IReadOnlyList<SayfaOzet> _otherPages = [];
    private IReadOnlyList<SayfaOzet> _legalPages = [];
    private string? _cookiePolicySlug;

    private string BrandName => string.IsNullOrWhiteSpace(_branding?.Marka) ? "RentPro" : _branding!.Marka!;

    protected override async Task OnInitializedAsync()
    {
        // Kabuk, içerik servisleri patlasa DA basılmalı (alan adı çözülmemiş / site kapalı olabilir).
        try
        {
            _branding = await Showcase.GetBrandingAsync();
            // Ofis telefonu yoksa mobil; WhatsApp numarası yoksa mobil (firmaların çoğu aynı numarayı kullanıyor).
            _phone = string.IsNullOrWhiteSpace(_branding.Tel) ? _branding.MobilTel : _branding.Tel;
            _telLink = PhoneLink.Tel(_phone);
            _waLink = PhoneLink.Wa(string.IsNullOrWhiteSpace(_branding.WhatsApp) ? _branding.MobilTel : _branding.WhatsApp,
                $"Merhaba, {BrandName} araç kiralama hakkında bilgi almak istiyorum.");
            _altbar = _telLink is not null || _waLink is not null;

            var hasFaq = (await Icerik.PublishedFaqAsync()).Count > 0;
            var hasBlog = (await Blog.ListPublishedAsync()).Count > 0;
            var nav = new List<(string, string)> { ("/musaitlik", "Araçlar ve fiyatlar") };
            if (hasFaq) nav.Add(("/sss", "Sık sorulanlar"));
            if (hasBlog) nav.Add(("/blog", "Blog"));
            nav.Add(("/iletisim", "İletişim"));
            _navItems = nav;

            var pages = await Icerik.PublishedPagesAsync();
            _legalPages = pages.Where(LegalPages.Legal).ToList();
            _otherPages = pages.Where(s => !LegalPages.Legal(s)).ToList();
            _cookiePolicySlug = LegalPages.CookiePolicySlug(pages);
        }
        catch
        {
            // Marka çözülemedi → nötr kabuk. Sayfa içeriği kendi hatasını kendi gösterir.
        }
    }
}
