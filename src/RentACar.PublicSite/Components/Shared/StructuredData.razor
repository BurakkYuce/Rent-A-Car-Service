@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Text.RegularExpressions
@using RentACar.Application.Fleet
@using RentACar.Application.SiteContent
@using RentACar.Domain.Entities

@* PR-19 — arama motorları için yapısal veri (JSON-LD): AutoRental (LocalBusiness) + FAQPage.
   Şema tipleri sektörde DEĞİŞMEZ, içerik tenant'tan gelir. Eksik alan HİÇ basılmaz (T2) — uydurma yok:
   - `@id` = {kök}/#firma: BlogPosting.publisher ve Offer.seller aynı varlığa bağlanır.
   - `logo`: firma logosu yüklüyse /marka/logo (mutlak, sürümlü).
   - `priceRange`: yayındaki ilanların en düşük–en yüksek GÜNLÜK fiyatı (ilandan).
   - `geo`: yalnız aktif şubelerden BİRİNDE hem enlem hem boylam girilmişse (ilk bulunan).
   - `openingHours`: şubenin çalışma saati metni ZATEN schema.org biçimindeyse ("Mo-Fr 09:00-18:00");
     "09:00-18:00" gibi günsüz metin BASILMAZ — günleri varsaymak firma adına bilgi uydurmak olurdu.
   - `address.addressRegion/addressLocality`: tüm aktif şubeler aynı il (ve ilçe) ise.
   - `sameAs`: sosyal hesap verisi modelde YOK → basılmaz.

   `MarkupString` BURADA GÜVENLİ: çıktı System.Text.Json ile üretiliyor ve varsayılan kodlayıcı `<` `>` `&`
   karakterlerini kaçırıyor — tenant verisi ne içerirse içersin `</script>` üretilemez. *@

@if (_json is { Length: > 0 })
{
    @((MarkupString)$"<script type=\"application/ld+json\">{_json}</script>")
}

@code {
    [Parameter] public FleetBranding? Branding { get; set; }
    /// <summary>Basılacak SSS — sayfada GÖRÜNEN sorular (ana sayfada özet kadar; yönerge: işaretlenen içerik görünür olmalı).</summary>
    [Parameter] public IReadOnlyList<SssSatiri> Questions { get; set; } = [];
    /// <summary>Kanonik kök (https://host). Yoksa mutlak adres isteyen alanlar (url, @id, logo) atlanır.</summary>
    [Parameter] public string? CanonicalRoot { get; set; }
    /// <summary>Aktif şubeler (geo, çalışma saatleri, il/ilçe). Boşsa bu alanlar yok.</summary>
    [Parameter] public IReadOnlyList<Branch> Branches { get; set; } = [];
    /// <summary>Yayındaki ilanlar (priceRange). Boşsa alan yok.</summary>
    [Parameter] public IReadOnlyList<FleetShowcaseCard> Cards { get; set; } = [];

    private string? _json;

    private static readonly JsonSerializerOptions Opt = new()
    {
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
        WriteIndented = false,
    };

    /// <summary>schema.org openingHours biçimi: gün(-gün)[,gün…] SS:DD-SS:DD; birden çok kural virgülle.</summary>
    private static readonly Regex OpeningHours = new(
        @"^(Mo|Tu|We|Th|Fr|Sa|Su)(-(Mo|Tu|We|Th|Fr|Sa|Su))?(,(Mo|Tu|We|Th|Fr|Sa|Su)(-(Mo|Tu|We|Th|Fr|Sa|Su))?)* ([01]\d|2[0-3]):[0-5]\d-([01]\d|2[0-4]):[0-5]\d$",
        RegexOptions.CultureInvariant);

    protected override void OnParametersSet()
    {
        var nodes = new List<object>();
        var root = string.IsNullOrWhiteSpace(CanonicalRoot) ? null : CanonicalRoot.TrimEnd('/');

        if (!string.IsNullOrWhiteSpace(Branding?.BrandName))
            nodes.Add(Business(Branding!, root));

        if (Questions.Count > 0)
        {
            nodes.Add(new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "FAQPage",
                ["mainEntity"] = Questions.Select(s => new Dictionary<string, object?>
                {
                    ["@type"] = "Question",
                    ["name"] = s.Soru,
                    ["acceptedAnswer"] = new Dictionary<string, object?>
                    {
                        ["@type"] = "Answer",
                        ["text"] = s.Cevap,
                    },
                }).ToArray(),
            });
        }

        _json = nodes.Count switch
        {
            0 => null,
            1 => JsonLd.Serialize(nodes[0]),
            _ => JsonLd.Serialize(nodes),   // birden fazla düğüm → dizi
        };
    }

    private Dictionary<string, object?> Business(FleetBranding b, string? root)
    {
        var cities = Branches.Select(s => Empty(s.Il)).Where(x => x is not null).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        var districts = Branches.Select(s => Empty(s.Ilce)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        var oneCity = cities.Count == 1 && Branches.All(s => Empty(s.Il) is not null);
        var geoBranch = Branches.FirstOrDefault(s => s.Enlem is not null && s.Boylam is not null);
        var hours = Branches.Select(s => Empty(s.CalismaSaatleri)).FirstOrDefault(h => h is not null && OpeningHours.IsMatch(h));

        object? address = null;
        if (Empty(b.Address) is not null || oneCity)
        {
            address = new Dictionary<string, object?>
            {
                ["@type"] = "PostalAddress",
                ["streetAddress"] = Empty(b.Address),
                ["addressLocality"] = oneCity && districts.Count == 1 ? districts[0] : null,
                ["addressRegion"] = oneCity ? cities[0] : null,
                ["addressCountry"] = "TR",
            };
        }

        return new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "AutoRental",   // LocalBusiness'ın araç kiralamaya özel alt tipi
            ["@id"] = root is null ? null : root + "/#firma",
            ["name"] = b.BrandName,
            ["url"] = root is null ? null : root + "/",
            ["logo"] = root is not null && !string.IsNullOrEmpty(b.LogoVersion)
                ? $"{root}/marka/logo?v={Uri.EscapeDataString(b.LogoVersion)}" : null,
            ["telephone"] = Empty(b.Phone) ?? Empty(b.MobilePhone),
            ["email"] = Empty(b.Email),
            ["address"] = address,
            ["geo"] = geoBranch is null ? null : new Dictionary<string, object?>
            {
                ["@type"] = "GeoCoordinates",
                ["latitude"] = geoBranch.Enlem,
                ["longitude"] = geoBranch.Boylam,
            },
            ["openingHours"] = hours,
            ["priceRange"] = Cards.Count == 0 ? null
                : Cards.Min(c => c.GunlukFiyat) == Cards.Max(c => c.GunlukFiyat)
                    ? PriceText.Tl(Cards.Min(c => c.GunlukFiyat))
                    : $"{PriceText.Tl(Cards.Min(c => c.GunlukFiyat))}–{PriceText.Tl(Cards.Max(c => c.GunlukFiyat))}",
        };
    }

    private static string? Empty(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
}
