@using RentACar.Application.Common
@using RentACar.Application.SiteIcerik
@* PR-19 — SSS özeti. VERİYE BAĞLI: firma soru girmediyse bölüm HİÇ basılmaz (T2 — boş başlık,
   siteyi bakımsız gösterir). `<details>` ile JS'siz açılır kapanır. *@

@if (Questions.Count > 0)
{
    <section class="bolum bolum-kontrast" id="sss" aria-labelledby="sss-baslik">
        <div class="wrap">
            <h2 id="sss-baslik" class="bolum-baslik">Sık sorulan sorular</h2>
            <div class="sss-liste">
                @foreach (var k in Questions.Take(Count))
                {
                    <details class="sss">
                        <summary>@k.Soru</summary>
                        @foreach (var p in ContentText.Paragraphs(k.Cevap))
                        {
                            <p>@p</p>
                        }
                    </details>
                }
            </div>
            @if (Questions.Count > Count)
            {
                <p class="linkler"><a href="/sss">Tüm sorular (@Questions.Count)</a></p>
            }
        </div>
    </section>
}

@code {
    [Parameter] public IReadOnlyList<SssSatiri> Questions { get; set; } = [];
    /// <summary>Ana sayfada gösterilen soru adedi (ERP yönetim ekranındaki notla aynı sayı).</summary>
    [Parameter] public int Count { get; set; } = 4;
}
