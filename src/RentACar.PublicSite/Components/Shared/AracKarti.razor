@using RentACar.Application.Fleet

@* İlan kartı — ana sayfa, /musaitlik ve "benzer araçlar" AYNI bileşeni kullanır (eskiden ana sayfanın
   ayrı bir kartı vardı; çip sırası ve fiyat biçimi zamanla ayrışıyordu). İKİ mod:
   (a) tarih SEÇİLMİŞ: "3 gün × ₺1.250" hesabı + toplam + müsait adet;
   (b) tarih YOK: günlük fiyat + toplam araç adedi ("müsait" DENMEZ — tarihsiz bilinemez).

   Etkileşim: kartın tamamı detaya gider (başlık bağlantısı ::after ile kartı kaplar), "Teklif iste"
   üstte ayrı bir hedef. İç içe <a> yok; klavyede iki ayrı durak. *@

<article class="ilan">
    @if (!string.IsNullOrWhiteSpace(Isaret))
    {
        <p class="ilan-isaret">@Isaret</p>
    }
    <div class="ilan-foto @(CoverPhotoId is null ? "foto-yok" : null)">
        @if (CoverPhotoId is { } photoId)
        {
            @* Küçük görsel (400 px) — kart ekranda ~300-380 px. Liste kartı tembel yüklenir; yalnız ilk
               ekrandaki ilk kart (Oncelikli) hemen ve yüksek öncelikle iner (LCP adayı). *@
            <img src="@($"/foto/{photoId}/thumb")" alt="@Baslik" width="400" height="267"
                 loading="@(Oncelikli ? "eager" : "lazy")" fetchpriority="@(Oncelikli ? "high" : null)" decoding="async" />
        }
    </div>
    <div class="ilan-govde">
        <h3><a href="@($"/araclar/{Slug}")">@Baslik</a></h3>
        @if (MetaLine is { Length: > 0 } meta)
        {
            <p class="ilan-yil">@meta</p>
        }
        @{ var chips = Chips().Take(4).ToList(); }
        @if (chips.Count > 0)
        {
            @* Yıl zaten üstte yazılı; aynı değeri taşıyan özellik satırı ("2023") ikinci kez basılmaz. *@
            <ul class="ozellikler" aria-label="Özellikler">
                @foreach (var o in chips) { <li>@o.Deger</li> }
            </ul>
        }
        <div class="fis">
            @if (Gun is { } g && Toplam is { } t)
            {
                <p class="fis-hesap">@g gün × @PriceText.Tl(GunlukFiyat)</p>
                <p class="fis-toplam">
                    <span class="tutar">@PriceText.Tl(t)</span>
                    <span class="kdv">@(KdvDahil ? "KDV dahil" : "KDV hariç")</span>
                </p>
            }
            else
            {
                <p class="fis-toplam">
                    <span class="tutar">@PriceText.Tl(GunlukFiyat)</span><span class="birim">/ gün</span>
                    <span class="kdv">@(KdvDahil ? "KDV dahil" : "KDV hariç")</span>
                </p>
            }
        </div>
        <div class="ilan-eylem">
            <a class="btn btn-brand" href="@TeklifLinki">Teklif iste</a>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    [Parameter, EditorRequired] public string Baslik { get; set; } = "";
    [Parameter] public Guid? CoverPhotoId { get; set; }
    [Parameter] public string? YilAralik { get; set; }
    /// <summary>Günlük fiyat (tarih seçiliyse o gün sayısının kademesine düşen günlük karşılık).</summary>
    [Parameter] public decimal GunlukFiyat { get; set; }
    [Parameter] public bool KdvDahil { get; set; }
    [Parameter] public IReadOnlyList<OzellikGoster> Ozellikler { get; set; } = [];

    /// <summary>Tarih seçilmişse kiralama gün sayısı; <c>null</c> = misafir filoyu tarihsiz geziyor.</summary>
    [Parameter] public int? Gun { get; set; }
    /// <summary>Tarih seçilmişse dönem toplamı (<see cref="Gun"/> ile birlikte anlamlı).</summary>
    [Parameter] public decimal? Toplam { get; set; }

    [Parameter] public int Adet { get; set; }
    [Parameter, EditorRequired] public string TeklifLinki { get; set; } = "";
    /// <summary>Kartın köşesindeki kısa etiket (ör. "Baktığınız araç"); boşsa basılmaz.</summary>
    [Parameter] public string? Isaret { get; set; }
    /// <summary>İlk ekrandaki ilk kart: görsel tembel değil, yüksek öncelik.</summary>
    [Parameter] public bool Oncelikli { get; set; }

    /// <summary>
    /// "2023 model, 3 araç" satırı. Adet etiketi MODA göre: tarih seçiliyse "müsait" denebilir (kirada
    /// olanlar düşülmüştür), tarihsizken denemez — o an kaçının boşta olduğu BİLİNMİYOR.
    /// </summary>
    private string? MetaLine
    {
        get
        {
            var parts = new List<string>(2);
            if (!string.IsNullOrWhiteSpace(YilAralik)) parts.Add($"{YilAralik} model");
            if (Adet > 1) parts.Add(Gun is null ? $"{Adet} araç" : $"{Adet} araç müsait");
            return parts.Count == 0 ? null : string.Join(", ", parts);
        }
    }

    /// <summary>Yıl bilgisiyle çakışan özellik satırını eleyen çip kaynağı.</summary>
    private IEnumerable<OzellikGoster> Chips()
        => string.IsNullOrWhiteSpace(YilAralik)
            ? Ozellikler
            : Ozellikler.Where(o => !string.Equals((o.Deger ?? "").Trim(), YilAralik.Trim(),
                StringComparison.OrdinalIgnoreCase));
}
