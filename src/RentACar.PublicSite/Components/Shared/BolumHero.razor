@using RentACar.Application.Fleet

@* PR-19 — Hero. Başlık ve alt metin SABİT (T1: firmanın vaadini değil, sitenin ne yaptığını
   anlatır); marka adı, arama formu ve tarife TENANT'tan. Arama `/musaitlik` ile AYNI bileşen (T4).

   TARİFE TAHTASI: filonun gerçek günlük fiyatları, ucuzdan pahalıya, nokta dolgulu satırlarla — ziyaretçi
   ilk ekranda "ne kadar?" sorusunun cevabını görür. VERİYE BAĞLI: yayında ilan yoksa hiç basılmaz (T2).
   KDV etiketi ilanın kendi işaretinden; hepsi aynıysa tek not, karışıksa satır başına. *@

<section class="hero" aria-labelledby="hero-baslik">
    <div class="wrap hero-grid">
        <div>
            <h1 id="hero-baslik">Tarihinizi seçin, müsait araçları ve net fiyatı görün</h1>
            <p class="hero-alt">
                @(string.IsNullOrWhiteSpace(Marka) ? "Filomuzdaki" : $"{Marka} filosundaki")
                her aracın günlük, haftalık ve aylık fiyatı ilanında yazılı. Tarih seçtiğinizde gün sayısına
                göre toplamı hesaplarız; beğendiğiniz araç için talep bırakırsınız, ekip sizi arar.
            </p>

            <AramaFormu Hedef="/musaitlik" Subeler="Subeler" />

            @* Bu üç ifade de sistemin davranışı — firma taahhüdü DEĞİL (T1). *@
            <ul class="hero-bilgi">
                <li>Kayıt gerekmez</li>
                <li>Talep bırakmak ücretsiz</li>
                <li>İlandaki fiyat sözleşmeye aynen geçer</li>
            </ul>
        </div>

        @if (Rows.Count > 0)
        {
            <aside class="tarife" aria-labelledby="tarife-baslik">
                <h2 id="tarife-baslik">Günlük fiyatlar</h2>
                <p class="tarife-not">@VatNote</p>
                <ol>
                    @foreach (var c in Rows)
                    {
                        <li>
                            <a href="@($"/araclar/{c.Slug}")">
                                <span class="t-ad">
                                    @c.Baslik
                                    @if (!string.IsNullOrWhiteSpace(c.YilAralik))
                                    {
                                        <small>@c.YilAralik</small>
                                    }
                                </span>
                                <span class="t-dolgu" aria-hidden="true"></span>
                                <span class="t-fiyat">@PriceText.Tl(c.GunlukFiyat)<small>/gün@(MixedVat && !c.KdvDahil ? " + KDV" : null)</small></span>
                            </a>
                        </li>
                    }
                </ol>
                @if (Kartlar.Count > Rows.Count)
                {
                    <p class="tarife-son"><a href="/musaitlik">Tüm filo (@Kartlar.Count araç)</a></p>
                }
            </aside>
        }
    </div>
</section>

@code {
    /// <summary>Tarife tahtasında en fazla kaç satır (fazlası "Tüm filo" bağlantısıyla).</summary>
    private const int MaxRows = 6;

    [Parameter] public string? Marka { get; set; }
    [Parameter] public IReadOnlyList<string> Subeler { get; set; } = [];
    [Parameter] public IReadOnlyList<FleetShowcaseCard> Kartlar { get; set; } = [];

    private IReadOnlyList<FleetShowcaseCard> Rows => [.. Kartlar.OrderBy(c => c.GunlukFiyat).Take(MaxRows)];
    private bool MixedVat => Kartlar.Any(c => c.KdvDahil) && Kartlar.Any(c => !c.KdvDahil);

    private string VatNote => MixedVat
        ? "Günlük fiyat, KDV dahil; “+ KDV” yazan satırlara KDV eklenir."
        : Kartlar.All(c => c.KdvDahil) ? "Günlük fiyat, KDV dahil." : "Günlük fiyat, KDV hariç.";
}
