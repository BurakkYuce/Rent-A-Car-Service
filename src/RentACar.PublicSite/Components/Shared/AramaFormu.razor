@* PR-19 — müsaitlik arama formu. TEK KAYNAK: ana sayfa (Hero), `/musaitlik` ve ilan detayı bunu
   kullanır. İkinci bir kopya yazmak, alan adlarının (`bas`/`bit`/`sube`) ve doğrulama
   kurallarının zamanla ayrışmasına yol açardı.

   GET + querystring: JS YOK, sonuç adresi paylaşılabilir ve geri tuşuna dost.

   TARİH ZORUNLU DEĞİL: boş bırakılırsa `/musaitlik` tüm filoyu listeler; tarih girilirse gerçek
   müsaitliğe ve dönem toplamına daralır ("önce aracı göreyim" diyen ziyaretçi çıkmaza girmesin).
   `min` bugünün (İstanbul) tarihi: geçmiş bir tarihe rezervasyon zaten alınmıyor, tarayıcı daha
   gönderimde uyarır. JS'siz de çalışır; eski tarayıcı `min`'i yok sayarsa sunucu yine karar verir. *@
<form method="get" action="@Hedef" class="arama @(Satir ? "arama-satir" : null)" role="search" aria-label="@AriaLabel">
    <div class="arama-tarihler">
        <label class="alan">Alış tarihi<input name="bas" type="date" value="@Bas" min="@Today" /></label>
        <label class="alan">İade tarihi<input name="bit" type="date" value="@Bit" min="@Today" /></label>
    </div>
    @if (Subeler.Count > 1)
    {
        @* Tek şubeli firmada seçim kutusu gürültü: hiç basılmaz. *@
        <label class="alan">Şube
            <select name="sube">
                <option value="">Tüm şubeler</option>
                @foreach (var s in Subeler)
                {
                    <option value="@s" selected="@(s == Sube)">@s</option>
                }
            </select>
        </label>
    }
    @if (!string.IsNullOrWhiteSpace(Ilan))
    {
        @* İlan detayından gelindiyse sonuçta o ilan öne alınır (bkz. Musaitlik.razor). *@
        <input type="hidden" name="ilan" value="@Ilan" />
    }
    <button type="submit" class="btn btn-brand">@(ButonMetni ?? "Müsait araçları göster")</button>
</form>

@code {
    /// <summary>Formun gönderileceği adres. Boş = bulunulan sayfa (`/musaitlik` kendi içinde).</summary>
    [Parameter] public string? Hedef { get; set; }

    [Parameter] public string? Bas { get; set; }
    [Parameter] public string? Bit { get; set; }
    [Parameter] public string? Sube { get; set; }
    /// <summary>Öne alınacak ilanın slug'ı (ilan detayından gelen arama).</summary>
    [Parameter] public string? Ilan { get; set; }

    /// <summary>Şube listesi; tek şube (ya da hiç) varsa seçim kutusu basılmaz.</summary>
    [Parameter] public IReadOnlyList<string> Subeler { get; set; } = [];

    [Parameter] public string? ButonMetni { get; set; }
    /// <summary>true: geniş ekranda tek satır (sonuç sayfasının üstü). false: dikey (hero, panel).</summary>
    [Parameter] public bool Satir { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Müsait araç ara";

    private static string Today => SiteDate.TodayIso;
}
