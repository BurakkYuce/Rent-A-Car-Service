@using System.Text.Json
@using System.Text.Json.Serialization
@using RentACar.Application.Blog
@using RentACar.Application.Fleet

@* Blog yazısı için JSON-LD (schema.org BlogPosting) — arama motorları ve AI arama yüzeyleri
   yazının başlığını, tarihini ve yayıncısını böyle okur.

   `MarkupString` BURADA GÜVENLİ, gerekçesi StructuredData.razor'daki ile AYNI: çıktı
   System.Text.Json ile ÜRETİLİYOR ve varsayılan JavaScriptEncoder `<` `>` `&` karakterlerini
   kaçırdığı için tenant verisi ne içerirse içersin `</script>` dizisi üretilemez. *@

@if (_json is { Length: > 0 })
{
    <script type="application/ld+json">@((MarkupString)_json)</script>
}

@code {
    [Parameter, EditorRequired] public BlogDetail? Post { get; set; }
    [Parameter] public FleetBranding? Branding { get; set; }
    /// <summary>Kanonik kök (https://host) — göreli adresleri mutlak yapmak için. Yoksa url/image atlanır.</summary>
    [Parameter] public string? CanonicalRoot { get; set; }

    private string? _json;

    private static readonly JsonSerializerOptions Opt = new()
    {
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
        WriteIndented = false,
    };

    protected override void OnParametersSet()
    {
        if (Post is not { } y) { _json = null; return; }

        var root = string.IsNullOrWhiteSpace(CanonicalRoot) ? null : CanonicalRoot.TrimEnd('/');
        var model = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BlogPosting",
            ["headline"] = y.Baslik,
            // alternativeHeadline = alt başlık; AI arama yüzeyleri yazının kapsamını buradan da okur.
            ["alternativeHeadline"] = string.IsNullOrWhiteSpace(y.AltBaslik) ? null : y.AltBaslik,
            // Özet YOKSA gövdeden türetilir — boş description basmaktansa anlamlı bir cümle.
            // Sayfadaki meta description ile AYNI öncelik sırası — ikisi ayrışırsa arama motoru
            // çelişen iki açıklama görür.
            ["description"] = !string.IsNullOrWhiteSpace(y.MetaAciklama) ? y.MetaAciklama
                : !string.IsNullOrWhiteSpace(y.Ozet) ? y.Ozet
                : RentACar.Application.Common.ContentText.Summary(y.Icerik),
            ["keywords"] = y.Kelimeler.Count > 0 ? string.Join(", ", y.Kelimeler) : null,
            ["author"] = string.IsNullOrWhiteSpace(y.Yazar) ? null : new Dictionary<string, object?>
            {
                ["@type"] = "Person",
                ["name"] = y.Yazar,
            },
            // Kelime sayısı: AI arama yüzeyleri içeriğin derinliğini bununla ölçüyor.
            ["wordCount"] = RentACar.Application.Common.ContentText.WordCount(y.Icerik),
            ["datePublished"] = y.YayinTarihi?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture),
            // Son güncelleme (kayıt damgası); yayın tarihinden ÖNCE görünemez (taslakken yapılan düzenleme).
            ["dateModified"] = y.GuncellemeUtc is { } m
                ? (y.YayinTarihi is { } p && m < p ? p : m).UtcDateTime.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)
                : null,
            ["mainEntityOfPage"] = root is null ? null : $"{root}/blog/{y.Slug}",
            ["image"] = root is not null && y.KapakVar ? $"{root}/blog-kapak/{y.Id}" : null,
            ["publisher"] = string.IsNullOrWhiteSpace(Branding?.BrandName) ? null : new Dictionary<string, object?>
            {
                ["@type"] = "Organization",
                // Ana sayfadaki AutoRental düğümüyle AYNI varlık.
                ["@id"] = root is null ? null : root + "/#firma",
                ["name"] = Branding!.BrandName,
                ["logo"] = root is not null && !string.IsNullOrEmpty(Branding.LogoVersion)
                    ? new Dictionary<string, object?>
                    {
                        ["@type"] = "ImageObject",
                        ["url"] = $"{root}/marka/logo?v={Uri.EscapeDataString(Branding.LogoVersion)}",
                    }
                    : null,
            },
        };

        _json = JsonLd.Serialize(model); // null alanlar budanır (T2)
    }
}
