@using System.Text.Json
@using System.Text.Json.Serialization
@using RentACar.Application.Fleet

@* PR-20 — araç detay sayfası için JSON-LD (`Car` + `Offer`). Şema tipi sektörde DEĞİŞMEZ,
   içerik ilandan gelir.

   DÜRÜSTLÜK NOTU (T1): `availability` alanı BİLİNÇLİ OLARAK YAZILMIYOR. İlanın yayında olması
   "her tarihte müsait" demek değil; müsaitlik tarihe göre hesaplanıyor. `InStock` yazmak arama
   motoruna doğrulanmamış bir taahhüt vermek olurdu. Fiyatın KDV durumu ise
   `valueAddedTaxIncluded` ile AÇIKÇA belirtiliyor — ilanda ne yazıyorsa o.

   `MarkupString` güvenli: çıktı `System.Text.Json` ile üretiliyor ve varsayılan encoder `<`/`>`/`&`
   karakterlerini kaçırıyor → tenant verisinden `</script>` üretilemez (StructuredData.razor ile aynı
   gerekçe). *@

@if (_json is { Length: > 0 })
{
    <script type="application/ld+json">@((MarkupString)_json)</script>
}

@code {
    [Parameter] public FleetShowcaseDetail? Detail { get; set; }
    /// <summary>Kanonik site kökü (https://host). Yoksa mutlak adresler atlanır.</summary>
    [Parameter] public string? CanonicalRoot { get; set; }

    private string? _json;

    private static readonly JsonSerializerOptions Opt = new()
    {
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
        WriteIndented = false,
    };

    protected override void OnParametersSet()
    {
        if (Detail is null) { _json = null; return; }

        var root = string.IsNullOrWhiteSpace(CanonicalRoot) ? null : CanonicalRoot.TrimEnd('/');

        // Araç özellikleri ilanın "sitede görünsün" satırlarından (etiket eşleşmesi; yoksa alan YOK — T2).
        string? Feature(params string[] labels) => Detail.Features
            .FirstOrDefault(o => labels.Any(l => string.Equals(o.Etiket?.Trim(), l, StringComparison.OrdinalIgnoreCase))
                                 && !string.IsNullOrWhiteSpace(o.Deger))?.Deger?.Trim();
        // Model yılı yalnız TEK yıl ise (ilan birden çok yılı kapsıyorsa "2021-2023" bir tarih değil).
        var year = Detail.YearRange is { Length: 4 } y && y.All(char.IsAsciiDigit) ? y : null;

        var node = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Car",
            ["name"] = Detail.Baslik,
            ["url"] = root is null ? null : $"{root}/araclar/{Detail.Slug}",
            ["brand"] = Feature("Marka") is { } brand ? new Dictionary<string, object?> { ["@type"] = "Brand", ["name"] = brand } : null,
            ["model"] = Feature("Model"),
            ["vehicleModelDate"] = year,
            ["vehicleTransmission"] = Feature("Vites", "Şanzıman"),
            ["fuelType"] = Feature("Yakıt", "Yakıt Tipi"),
            // Görseller MUTLAK adres olmalı (arama motoru göreli yolu çözemez); sayfadaki TÜM fotoğraflar.
            ["image"] = root is null || Detail.PhotoIds.Count == 0
                ? null
                : Detail.PhotoIds.Select(id => $"{root}/foto/{id}").ToArray(),
            ["offers"] = new Dictionary<string, object?>
            {
                ["@type"] = "Offer",
                ["url"] = root is null ? null : $"{root}/araclar/{Detail.Slug}",
                // Üst düzey fiyat: ürün snippet'i fiyatı buradan okur (günlük fiyat; birim aşağıda).
                ["price"] = Detail.GunlukFiyat,
                ["priceCurrency"] = "TRY",
                ["seller"] = root is null ? null : new Dictionary<string, object?> { ["@id"] = root + "/#firma" },
                // `availability` BİLİNÇLİ OLARAK YOK (başlıktaki dürüstlük notu): müsaitlik tarihe bağlı.
                ["priceSpecification"] = new Dictionary<string, object?>
                {
                    ["@type"] = "UnitPriceSpecification",
                    ["price"] = Detail.GunlukFiyat,
                    ["priceCurrency"] = "TRY",
                    ["unitCode"] = "DAY",                       // UN/CEFACT: günlük birim fiyat
                    ["valueAddedTaxIncluded"] = Detail.KdvDahil,  // ilanda ne yazıyorsa o
                },
            },
        };

        _json = JsonLd.Serialize(node); // null alanlar budanır (T2)
    }
}
