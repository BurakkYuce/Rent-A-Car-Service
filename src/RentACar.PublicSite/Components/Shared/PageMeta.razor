@using RentACar.Application.Fleet

@* Sayfa meta etiketleri — açıklama + paylaşım (og/twitter) TEK yerde.

   Neden gerekli: bu etiketler yalnız blog yazısında ve serbest içerik sayfasında vardı. Ana sayfa,
   /musaitlik, araç detay ve /sss'te HİÇ description ve HİÇ og: yoktu — yani arama sonucundaki
   açıklamayı Google sayfadan rastgele seçiyor, WhatsApp/Facebook'ta paylaşılan bağlantı başlıksız
   ve görselsiz çıkıyordu. Rent-a-car'da bağlantı paylaşımı asıl kanal olduğu için bu ciddi bir kayıp.

   Neden ORTAK bileşen: her sayfaya elle <meta> yazmak, dördünde yazıp beşincisini unutmak demek.
   Tek giriş noktası olunca yeni sayfa eklendiğinde tek satır yeter. *@

<HeadContent>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <meta name="description" content="@Description" />
        <meta property="og:description" content="@Description" />
        <meta name="twitter:description" content="@Description" />
    }
    <meta property="og:type" content="@(Type ?? "website")" />
    <meta property="og:title" content="@Title" />
    <meta name="twitter:title" content="@Title" />
    @if (!string.IsNullOrWhiteSpace(Branding?.BrandName))
    {
        <meta property="og:site_name" content="@Branding!.BrandName" />
    }
    @* Görsel varsa büyük kart, yoksa küçük — görselsiz "summary_large_image" boş bir kutu bastırır. *@
    <meta name="twitter:card" content="@(Image is { Length: > 0 } ? "summary_large_image" : "summary")" />
    @if (CanonicalRoot is { Length: > 0 })
    {
        <meta property="og:url" content="@($"{CanonicalRoot}{Path}")" />
        @if (Image is { Length: > 0 })
        {
            <meta property="og:image" content="@($"{CanonicalRoot}{Image}")" />
            <meta name="twitter:image" content="@($"{CanonicalRoot}{Image}")" />
        }
    }
</HeadContent>

@code {
    /// <summary>Paylaşım başlığı (sekme başlığından AYRI olabilir; sayfa ne verirse).</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Arama sonucu açıklaması. Boşsa hiçbir açıklama etiketi BASILMAZ —
    /// boş bir description, olmayandan daha kötüdür (arama motoru onu da gösterebilir).</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>og:type — varsayılan "website"; blog yazısı "article" verir.</summary>
    [Parameter] public string? Type { get; set; }

    /// <summary>Bu sayfanın yolu ("/", "/musaitlik", "/araclar/x"). og:url için.</summary>
    [Parameter] public string Path { get; set; } = "/";

    /// <summary>Paylaşım görselinin GÖRECELİ yolu ("/foto/{id}/thumb"). Yoksa görsel etiketi yok.</summary>
    [Parameter] public string? Image { get; set; }

    [Parameter] public FleetBranding? Branding { get; set; }

    /// <summary>Kanonik kök (https://host). Yoksa mutlak adres isteyen etiketler atlanır —
    /// og:image GÖRECELİ yolu kabul etmez, yarım etiket basmaktansa hiç basmamak doğrusu.</summary>
    [Parameter] public string? CanonicalRoot { get; set; }
}
