@using RentACar.Application.Fleet
@inject FleetShowcaseService Showcase
@inject NavigationManager Nav
<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* PR-9: canonical — aynı içerik hem subdomain hem özel domain'den servis edilebildiği için
       duplicate-content sinyali oluşur. Host `req.Host`'tan DEĞİL, kanonik kaynaktan okunur; query
       string ATILIR (parametreli arama sayfaları ayrı ayrı indekslenmesin). *@
    @if (_canonical is not null)
    {
        <link rel="canonical" href="@_canonical" />
    }
    @* PR-15: `app.css` KALDIRILDI — Blazor şablonundan kalan `body{padding:2rem}` kuralı
       `.container`ın kendi boşluğuyla çakışıyordu ve kabuk barının kenara yapışmasını engelliyordu. *@
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="site.css" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    @* PR-19: `blazor.web.js` KALDIRILDI (200.538 bayt, HER sayfada iniyordu).
       Site %100 statik SSR: `AddRazorComponents()` var ama `AddInteractiveServerComponents` YOK,
       hiçbir bileşende `@@rendermode` YOK, enhanced form/streaming kullanılmıyor. Dosyanın tek
       katkısı "enhanced navigation" idi; karşılığında her ziyaretçiye 200 KB indiriliyordu.
       Sayfa ağırlığı ~210 KB → ~10 KB. Formlar zaten saf GET/POST, `<details>` tarayıcıdan. *@

    @* Çerez bilgilendirme şeridi — sitedeki TEK betik (~1 KB). Harici dosya ŞART: CSP
       `script-src 'self'` inline betiği bloklar. `defer` ile ayrıştırma engellenmez; şerit
       zaten sunucudan `hidden` geldiği için geç açılması düzen kaymasına yol açmaz (sabit
       konumlu, akış dışı). *@
    <script src="js/rc-cerez.js" defer></script>
</body>

</html>

@code {
    private string? _canonical;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var host = await Showcase.GetCanonicalHostAsync();
            if (host is null) return;
            var path = new Uri(Nav.Uri).AbsolutePath; // query BİLİNÇLİ olarak atılır
            _canonical = $"https://{host}{path}";
        }
        catch
        {
            // Canonical yalnız bir SEO ipucudur — üretilemezse sayfa YİNE de servis edilmeli.
        }
    }
}
