@using RentACar.Application.Fleet
@inject FleetShowcaseService Showcase
@inject NavigationManager Nav
@inject ThemeAccessor Themes
<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* PR-9: canonical — aynı içerik hem subdomain hem özel domain'den servis edilebildiği için
       duplicate-content sinyali oluşur. Host `req.Host`'tan DEĞİL, kanonik kaynaktan okunur; query
       string ATILIR (parametreli arama ve ?tema= önizlemesi ayrı indekslenmesin). *@
    @if (_canonical is not null)
    {
        <link rel="canonical" href="@_canonical" />
    }
    @* Tarayıcı çubuğu rengi paletin zemininden (Rgb'den yazılmış hex; ham ayar değil). *@
    <meta name="theme-color" content="@_palette.Light.Bg.Hex" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="@_palette.Dark.Bg.Hex" media="(prefers-color-scheme: dark)" />

    @* YAZI TİPLERİ aktif temadan (SiteTheme.Fonts). @font-face bu <style> içinde, CSS dosyasında DEĞİL:
       adresler `@Assets[...]` ile PARMAK İZLİ basılır (bir yıl `immutable`) ve önyükleme adresiyle BİREBİR
       aynı olur — CSS'teki düz `url()` parmak izi alamazdı ve önyüklenen dosya iki kez inerdi. Yalnız aktif
       temanın dosyaları önyüklenir. CSP: `style-src` zaten 'unsafe-inline' (Program.cs). *@
    @foreach (var file in _theme.FontPreloads)
    {
        <link rel="preload" as="font" type="font/woff2" crossorigin href="@Assets[file]" />
    }
    @if (_theme.Fonts.Count > 0)
    {
        <style>@((MarkupString)FontFaceCss())</style>
    }
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    @* CSS üç katman: base.css (ortak yapı, yalnız semantik token) + aktif temanın css'i (primitive →
       semantic → component + slot stilleri). Sözleşme: Components/Themes/README.md. *@
    <link rel="stylesheet" href="@Assets["css/base.css"]" />
    <link rel="stylesheet" href="@Assets[_theme.CssPath]" />
    @* Palet — tema css'inden SONRA (aynı özgüllükte sonraki kazanır): semantik renk token'larının TAMAMI
       (zemin, yüzey, mürekkep, çizgi, firma rengi, vurgu; açık + koyu) ve şemadan bağımsız --day-*/--night-*
       paletten gelir. YALNIZ SitePaletteCss çıktısı basılır; ham ayar/sorgu değeri (SitePaleti, VurguRengi,
       ?palet=, ?renk=) ASLA doğrudan stile yazılmaz — CSP style-src 'unsafe-inline' olduğundan tek savunma bu. *@
    <style>@((MarkupString)_paletteCss)</style>
    <HeadOutlet />
</head>

<body>
    <Routes />
    @* PR-19: `blazor.web.js` KALDIRILDI (200.538 bayt, HER sayfada iniyordu). Site %100 statik SSR. *@

    @* Çerez bilgilendirme şeridi — sitedeki TEK betik (~1 KB). Harici dosya ŞART: CSP `script-src 'self'`
       inline betiği bloklar. Şerit sunucudan `hidden` gelir; JS yoksa hiç görünmez. Parmak izli adres. *@
    <script src="@Assets["js/rc-cerez.js"]" defer></script>
</body>

</html>

@code {
    private string? _canonical;
    private SiteTheme _theme = SiteThemes.Tarife;
    private PaletteTokens _palette = SitePaletteCss.Tokens(SiteThemes.Tarife, null, null);
    private string _paletteCss = "";

    /// <summary>@font-face kuralları — değerler yalnız tema KAYDINDAN (sabit kod), kullanıcı verisi yok.</summary>
    private string FontFaceCss() => string.Concat(_theme.Fonts.Select(f =>
        $"@font-face{{font-family:\"{f.Family}\";font-style:normal;font-weight:{f.Weight};font-display:swap;"
        + $"src:url(\"{Assets[f.File]}\") format(\"woff2\");unicode-range:{f.UnicodeRange}}}"));

    protected override async Task OnInitializedAsync()
    {
        // Görünüm (tema + palet + özel ana renk) ThemeAccessor'da çözülür; marka çözülemezse (alan adı çözülmemiş /
        // site kapalı) temanın varsayılan seti. Sayfa YİNE basılır.
        var appearance = await Themes.GetAppearanceAsync();
        _theme = appearance.Theme;
        _palette = SitePaletteCss.Tokens(appearance.Palette, appearance.CustomPrimary);
        _paletteCss = SitePaletteCss.Css(_palette);

        try
        {
            var host = await Showcase.GetCanonicalHostAsync();
            if (host is null) return;
            var path = new Uri(Nav.Uri).AbsolutePath; // query BİLİNÇLİ olarak atılır
            _canonical = $"https://{host}{path}";
        }
        catch
        {
            // Canonical yalnız bir SEO ipucudur — üretilemezse sayfa YİNE de servis edilmeli.
        }
    }
}
