{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "rentacar-frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "rc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "outputPath": "dist/rentacar-frontend",
            "baseHref": "/app/",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["node_modules/@angular/cdk/overlay-prebuilt.css", "src/styles.scss"],
            // Bileşen SCSS'i paylaşılan kısmileri yolsuz okur: `@use 'kirilim';` (src/styles/_kirilim.scss).
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles"]
            }
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": {
                  "inline": false
                }
              },
              "budgets": [
                // İlk paket (AGENTS.md "Paket bütçesi"). Çekirdek eki "rota bazlı tembel çeviri" (2026-09-22) sonrası
                // 372,5 kB: Angular çatısı ~302 kB (core 138 + router 73 + common/http 42 + rxjs 22 + transloco 14 +
                // platform-browser 13), uygulama çekirdeği (oturum, tema, toast, bant, sekme stratejisi, ÇEKİRDEK
                // tr.json ~8 kB) + CSS. Özellik metinleri `src/i18n/bloklar/` → rota parçası. Uyarı ≈ ölçüm + 20 kB:
                // ilk pakete giren her yeni kod görünür olur. Hata 430 kB (önceki 450). Sayfa/özellik kodu ve
                // metni tembel parçaya girer, buraya değil.
                {
                  "type": "initial",
                  "maximumWarning": "410kB",
                  "maximumError": "430kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "rentacar-frontend:build:production"
            },
            "development": {
              "buildTarget": "rentacar-frontend:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            // Üretilir (npm run i18n:tipler): tüm özellik çeviri blokları testlerde önyüklü.
            "providersFile": "src/test-saglayicilari.ts"
          }
        }
      }
    }
  }
}
