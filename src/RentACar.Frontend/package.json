{
  "name": "rentacar-frontend",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "tipler": "openapi-typescript ../../docs/api/ui-v1.json -o src/app/core/api/uretilen/ui-v1.ts && prettier --write --log-level warn src/app/core/api/uretilen/ui-v1.ts",
    "tipler:kontrol": "npm run tipler && git ls-files --error-unmatch src/app/core/api/uretilen/ui-v1.ts >/dev/null && git diff --exit-code -- src/app/core/api/uretilen/",
    "prebuild": "npm run tipler",
    "build": "ng build",
    "prewatch": "npm run tipler",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint --max-warnings 0 . && npm run --silent uretim:kontrol && npm run --silent kontrast",
    "kontrast": "node scripts/kontrast-denetimi.mjs",
    "ikonlar": "node scripts/ikon-kaydi.mjs",
    "i18n:tipler": "node scripts/i18n-tipleri.mjs",
    "uretim:kontrol": "node scripts/ikon-kaydi.mjs --kontrol && node scripts/i18n-tipleri.mjs --kontrol",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "ng test --watch=false",
    "e2e": "ng build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/forms": "21.2.23",
    "@angular/platform-browser": "21.2.23",
    "@angular/router": "21.2.23",
    "@jsverse/transloco": "8.4.0",
    "@tanstack/table-core": "8.21.3",
    "@tanstack/virtual-core": "3.17.11",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.23",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tabler/icons": "3.46.0",
    "angular-eslint": "21.4.0",
    "eslint": "9.39.5",
    "jsdom": "28.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
