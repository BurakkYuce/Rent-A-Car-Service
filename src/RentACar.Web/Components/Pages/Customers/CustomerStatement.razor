@page "/cariler/{Id:guid}/ekstre"
@attribute [Authorize]
@inject CustomerService Customers
@inject CashService Cash

<PageTitle>Cari Ekstre — RentPro</PageTitle>

@if (_customer is null)
{
    <p class="error">Cari bulunamadı.</p>
    <a href="/cariler">← Cariler</a>
}
else
{
    <div class="page-head"><h1>Ekstre — @_customer.DisplayName</h1><div class="actions"><a href="/listeler/export/cari-ekstre?@Qs("excel")">Excel</a> · <a href="/listeler/export/cari-ekstre?@Qs("csv")">CSV</a> · <a href="/listeler/export/cari-ekstre?@Qs("pdf")">PDF</a></div></div>
    <p>Bakiye: <strong class="@(_balance > 0 ? "neg" : "pos")">@_balance.ToString("N2") ₺</strong>
        <span class="muted">(pozitif = müşteri borçlu)</span></p>

    @if (!string.IsNullOrEmpty(Hata))
    {
        <p class="error">@Hata</p>
    }

    <details class="new-vehicle">
        <summary>+ Tahsilat (cari bakiye ↓)</summary>
        <form method="post" action="/finans/tahsilat" class="grid-form"><AntiforgeryToken /><input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />@* M5: çift-submit idempotency *@
            <input type="hidden" name="cariId" value="@_customer.Id" />
            <label>Tutar<input name="tutar" type="number" step="0.01" required /></label>
            <label>Hesap
                <select name="hesap"><option>Kasa</option><option>Banka</option></select>
            </label>
            <HesapSecici Etiket="" />
            <label>Döviz
                <select name="doviz"><option>TRY</option><option>USD</option><option>EUR</option></select>
            </label>
            <label>Kur<input name="kur" type="number" step="0.0001" placeholder="boş = otomatik" title="Boş: TRY=1, dövizde sabit kur/TCMB otomatik" /></label>
            @* FAZ-84: kanal SAF BİLGİ (Masaüstü/Mobil/Tablet) — defteri/bakiyeyi etkilemez. *@
            <label>Kanal
                <select name="kanal"><option>Masaüstü</option><option>Mobil</option><option>Tablet</option></select>
            </label>
            <label>Açıklama<input name="aciklama" /></label>
            <button type="submit">Tahsil Et</button>
        </form>
    </details>

    <details class="new-vehicle">
        <summary>+ Ödeme / Tediye (cari bakiye ↑)</summary>
        <form method="post" action="/finans/odeme" class="grid-form"><AntiforgeryToken /><input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />@* M5 *@
            <input type="hidden" name="cariId" value="@_customer.Id" />
            <label>Tutar<input name="tutar" type="number" step="0.01" required /></label>
            <label>Hesap
                <select name="hesap"><option>Kasa</option><option>Banka</option></select>
            </label>
            <HesapSecici Etiket="" />
            <label>Döviz
                <select name="doviz"><option>TRY</option><option>USD</option><option>EUR</option></select>
            </label>
            <label>Kur<input name="kur" type="number" step="0.0001" placeholder="boş = otomatik" title="Boş: TRY=1, dövizde sabit kur/TCMB otomatik" /></label>
            <label>Kanal
                <select name="kanal"><option>Masaüstü</option><option>Mobil</option><option>Tablet</option></select>
            </label>
            <label>Açıklama<input name="aciklama" /></label>
            <button type="submit">Öde</button>
        </form>
    </details>

    @* Filtre/görünüm paneli (canlı hesap_extresi.aspx karşılığı). GET formu: JS yok,
       URL paylaşılabilir. Cari arama kutusu YOK — cari zaten rota parametresiyle seçili. *@
    <form method="get" class="filter-bar">
        <label>Tarih Baş<input name="bas" type="date" value="@Bas" /></label>
        <label>Tarih Bit<input name="bit" type="date" value="@Bit" /></label>
        <label>Döviz
            <select name="doviz">
                <option value="">— tümü —</option>
                @foreach (var d in _dovizler) { <option value="@d" selected="@(d == Doviz)">@d</option> }
            </select>
        </label>
        <label>Kaynak
            <select name="kaynak">
                <option value="">— tümü —</option>
                @foreach (var k in _kaynaklar) { <option value="@k" selected="@(k == Kaynak)">@k</option> }
            </select>
        </label>
        <label>Sözleşme Durumu
            <select name="kiraDurum">
                <option value="" selected="@(string.IsNullOrEmpty(KiraDurum))">— tümü —</option>
                @foreach (var s in Enum.GetValues<RentalStatus>())
                { <option value="@s" selected="@(s.ToString() == KiraDurum)">@s</option> }
            </select>
        </label>
        <label>Görünüm
            <select name="mod">
                <option value="" selected="@(Mod != "ozet")">Detaylı (satır)</option>
                <option value="ozet" selected="@(Mod == "ozet")">Özet (ay × kaynak)</option>
            </select>
        </label>
        <button type="submit">Uygula</button>
        @if (FiltreVar)
        {
            <a class="link" href="/cariler/@Id/ekstre">Temizle</a>
        }
    </form>

    @if (!string.IsNullOrWhiteSpace(KiraDurum))
    {
        <p class="muted small">Sözleşme durumu filtresi YALNIZ kiraya bağlı tahsilat/ödeme satırlarına
            uygulanır — fatura, ceza, araç satışı gibi satırların kira bağı yoktur ve bu filtre açıkken
            listede görünmezler.</p>
    }

    @if (Mod == "ozet")
    {
        <div class="table-scroll">
        <table class="grid tr-grid">
            <thead><tr><th>Ay</th><th>Kaynak</th><th class="num">Adet</th><th class="num">Borç</th><th class="num">Alacak</th><th class="num">Net</th></tr></thead>
            <tbody>
                @if (_ozet.Count == 0)
                {
                    <tr><td colspan="6" class="muted">Hareket yok.</td></tr>
                }
                @foreach (var o in _ozet)
                {
                    <tr>
                        <td>@o.Ay</td>
                        <td>@o.Kaynak</td>
                        <td class="num">@o.Adet</td>
                        <td class="num">@Bos(o.Borc)</td>
                        <td class="num">@Bos(o.Alacak)</td>
                        <td class="num @(o.Net > 0 ? "neg" : "pos")">@o.Net.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <p class="muted small">Özet görünümde ters kayıt alınamaz — satır bazlı işlem için Detaylı görünüme geçin.</p>
    }
    else
    {
    <div class="table-scroll">
    <table class="grid tr-grid">
        <thead>
            <tr><th>Tarih</th><th>Açıklama</th><th>Kaynak</th><th>Döviz</th><th class="num">Borç</th><th class="num">Alacak</th><th class="num">@YuruyenBaslik</th><th></th></tr>
        </thead>
        <tbody>
            @if (_lines.Count == 0 && _devir == 0m)
            {
                <tr><td colspan="8" class="muted">@(FiltreVar ? "Filtreye uyan hareket yok." : "Hareket yok.")</td></tr>
            }
            @{ decimal running = _devir; }
            @* Devir satırı: tarih filtresi kapsam dışında bıraktığı önceki hareketlerin neti.
               Olmasaydı yürüyen bakiye sıfırdan başlar ve EKRANDA YANLIŞ BAKİYE gösterirdi. *@
            @if (_devir != 0m)
            {
                <tr class="muted">
                    <td>—</td><td><em>Önceki dönemden devir</em></td><td>Devir</td><td>—</td>
                    <td class="num">@Bos(_devir > 0 ? _devir : 0m)</td>
                    <td class="num">@Bos(_devir < 0 ? -_devir : 0m)</td>
                    <td class="num">@_devir.ToString("N2")</td><td></td>
                </tr>
            }
            @foreach (var e in _lines)
            {
                running += e.SignedBase;
                <tr>
                    <td>@e.EntryDateUtc.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@e.Description</td>
                    <td>@e.SourceType</td>
                    <td>@e.Amount.Currency</td>
                    <td class="num">@(e.Direction == LedgerDirection.Debit ? e.Amount.AmountInBase.ToString("N2") : "")</td>
                    <td class="num">@(e.Direction == LedgerDirection.Credit ? e.Amount.AmountInBase.ToString("N2") : "")</td>
                    <td class="num">@running.ToString("N2")</td>
                    <td>
                        @if (e.SourceType is "Tahsilat" or "Odeme")
                        {
                            <form method="post" action="/finans/tahsilat/ters" data-confirm="Ters kayıt alınsın mı?"><AntiforgeryToken />
                                <input type="hidden" name="id" value="@e.SourceId" />
                                <input type="hidden" name="cariId" value="@_customer.Id" />
                                <button type="submit" class="link danger">Ters Kayıt</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (_filtre.TarihDisiDaraltmaVar)
    {
        <p class="muted small">Döviz/kaynak/sözleşme filtresi açıkken son kolon carinin BAKİYESİ değil,
            yalnız görünen hareketlerin birikimidir. Gerçek bakiye yukarıda yazılıdır.</p>
    }
    }
    <p><a href="/cariler">← Cariler</a></p>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }
    [SupplyParameterFromQuery(Name = "doviz")] public string? Doviz { get; set; }
    [SupplyParameterFromQuery(Name = "kaynak")] public string? Kaynak { get; set; }
    [SupplyParameterFromQuery(Name = "kiraDurum")] public string? KiraDurum { get; set; }
    [SupplyParameterFromQuery(Name = "mod")] public string? Mod { get; set; }

    private sealed record OzetSatir(string Ay, string Kaynak, int Adet, decimal Borc, decimal Alacak, decimal Net);

    private Customer? _customer;
    private decimal _balance;
    private decimal _devir;
    private IReadOnlyList<AccountLedgerEntry> _lines = [];
    private IReadOnlyList<OzetSatir> _ozet = [];
    private string[] _dovizler = [];
    private string[] _kaynaklar = [];
    private CariEkstreFilter _filtre = new();

    private bool FiltreVar => !_filtre.BosMu || Mod == "ozet";

    /// <summary>Tarih-dışı daraltma varken son kolon bakiye DEĞİL, görünenlerin birikimidir.</summary>
    private string YuruyenBaslik => _filtre.TarihDisiDaraltmaVar ? "Birikim" : "Bakiye";

    protected override async Task OnInitializedAsync()
    {
        _customer = await Customers.GetAsync(Id);
        if (_customer is null) return;

        // Üstteki bakiye HER ZAMAN filtresizdir: carinin gerçek bakiyesi filtreye göre değişmez.
        _balance = await Cash.GetCariBalanceAsync(Id);

        // Açılır liste seçenekleri TÜM hareketlerden (filtreliden türetilseydi bir seçim
        // yapıldıktan sonra diğer seçenekler kaybolurdu).
        var tumu = (await Cash.GetStatementAsync(Id)).Satirlar;
        _dovizler = tumu.Select(e => e.Amount.Currency).Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(c => c).ToArray();
        _kaynaklar = tumu.Select(e => e.SourceType).Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.Ordinal).OrderBy(s => s).ToArray();

        _filtre = new CariEkstreFilter
        {
            Bas = Tarih(Bas),
            // Üst sınır GÜN SONUNA genişletilir (tarih girişi 00:00'a düşer).
            Bit = Tarih(Bit)?.AddDays(1).AddTicks(-1),
            Doviz = Doviz,
            SourceType = Kaynak,
            KiraDurum = Enum.TryParse<RentalStatus>(KiraDurum, out var kd) ? kd : null
        };

        var sonuc = await Cash.GetStatementAsync(Id, _filtre);
        _devir = sonuc.Devir;
        _lines = sonuc.Satirlar;

        if (Mod == "ozet") _ozet = Ozetle(_lines);
    }

    /// <summary>
    /// Özet görünüm: ay × kaynak türü kırılımı. VERİ KAYNAĞI AYNI — yalnız sunum gruplaması,
    /// bu yüzden detay ile özetin Borç/Alacak toplamları birebir eşit olmalıdır (test bunu kilitler).
    /// Devir özete GİRMEZ: o bir hareket değil, önceki dönemin bakiyesidir.
    /// </summary>
    private static IReadOnlyList<OzetSatir> Ozetle(IEnumerable<AccountLedgerEntry> satirlar)
        => satirlar
            .GroupBy(e => (Ay: e.EntryDateUtc.LocalDateTime.ToString("yyyy-MM"), e.SourceType))
            .Select(g =>
            {
                var borc = g.Where(e => e.Direction == LedgerDirection.Debit).Sum(e => e.Amount.AmountInBase);
                var alacak = g.Where(e => e.Direction == LedgerDirection.Credit).Sum(e => e.Amount.AmountInBase);
                return new OzetSatir(g.Key.Ay, g.Key.SourceType, g.Count(), borc, alacak, borc - alacak);
            })
            .OrderBy(o => o.Ay).ThenBy(o => o.Kaynak)
            .ToList();

    private static DateTimeOffset? Tarih(string? s)
        => DateTimeOffset.TryParse(s, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? d.ToUniversalTime() : null;

    private static string Bos(decimal v) => v == 0m ? "" : v.ToString("N2");

    /// <summary>Filtreyi export bağlantılarına aynen taşır (ekranda gördüğün = indirdiğin).</summary>
    private string Qs(string format)
    {
        var p = new List<string> { "cariId=" + Id, "format=" + format };
        void Ekle(string ad, string? deger)
        {
            if (!string.IsNullOrWhiteSpace(deger)) p.Add($"{ad}={Uri.EscapeDataString(deger)}");
        }
        Ekle("bas", Bas); Ekle("bit", Bit); Ekle("doviz", Doviz);
        Ekle("kaynak", Kaynak); Ekle("kiraDurum", KiraDurum);
        return string.Join("&", p);
    }
}
