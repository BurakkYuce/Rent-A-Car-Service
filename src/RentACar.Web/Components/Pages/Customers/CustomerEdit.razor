@page "/cariler/{Id:guid}"
@attribute [Authorize]
@inject CustomerService Customers
@inject ReservationSourceService Kaynaklar

<PageTitle>Cari Düzenle — RentPro</PageTitle>

<div class="page-head"><h1>Cari Düzenle</h1><div class="actions"></div></div>

@if (_c is null)
{
    <p class="error">Cari bulunamadı.</p>
    <a href="/cariler">← Listeye dön</a>
}
else
{
    @if (!string.IsNullOrEmpty(Hata))
    {
        <p class="error">@Hata</p>
    }

    <form method="post" action="/cariler/update" class="grid-form"><AntiforgeryToken />
        <input type="hidden" name="id" value="@_c.Id" />
        <label>Tür
            <select name="tip">
                @foreach (var t in Enum.GetValues<CustomerType>())
                {
                    <option value="@t" selected="@(t == _c.Tip)">@t</option>
                }
            </select>
        </label>
        <label>Ad<input name="ad" value="@_c.Ad" /></label>
        <label>Soyad<input name="soyad" value="@_c.Soyad" /></label>
        <label>TC Kimlik<input name="tcKimlik" maxlength="11" value="@_c.TcKimlik" /></label>
        <label>Ünvan<input name="unvan" value="@_c.Unvan" /></label>
        <label>Vergi Dairesi<input name="vergiDairesi" value="@_c.VergiDairesi" /></label>
        <label>Vergi No<input name="vergiNo" maxlength="10" value="@_c.VergiNo" /></label>
        <label>Cep Tel<input name="cepTel" value="@_c.CepTel" /></label>
        <label>GSM 2<input name="gsm2" value="@_c.Gsm2" /></label>
        <label>E-posta<input name="email" type="email" value="@_c.Email" /></label>
        <ComboBox Name="il" Label="İl" Options="_ilOpts" Value="@_c.Il" />
        <ComboBox Name="ilce" Label="İlçe" Options="_ilceOpts" Value="@_c.Ilce" />
        <ComboBox Name="kaynak" Label="Kaynak" Options="_kaynakOpts" Value="@_c.Kaynak" Placeholder="Web/Telefon/Bayi…" />
        <label>Müşteri Temsilcisi<input name="musteriTemsilcisi" value="@_c.MusteriTemsilcisi" /></label>
        <label>İYS İzinli
            <select name="iysIzinli">
                <option value="false" selected="@(!_c.IysIzinli)">Hayır</option>
                <option value="true" selected="@_c.IysIzinli">Evet</option>
            </select>
        </label>
        <label>Uyarı
            <select name="uyari">
                <option value="false" selected="@(!_c.Uyari)">Hayır</option>
                <option value="true" selected="@_c.Uyari">Evet</option>
            </select>
        </label>
        <label>Uyarı Nedeni<input name="uyariNedeni" value="@_c.UyariNedeni" /></label>
        <label>Ehliyet No<input name="ehliyetNo" value="@_c.EhliyetNo" /></label>
        <label>Ehliyet Sınıfı<input name="ehliyetSinifi" value="@_c.EhliyetSinifi" placeholder="B" /></label>
        <label>Ehliyet Tarihi<input name="ehliyetTarihi" type="date" value="@_c.EhliyetTarihi?.ToString("yyyy-MM-dd")" /></label>
        <label>Ehliyet Yeri<input name="ehliyetYeri" value="@_c.EhliyetYeri" /></label>
        <label>HGS Yansıtma Türü<input name="hgsYansitmaTuru" value="@_c.HgsYansitmaTuru" placeholder="Faturalı/Faturasız…" /></label>
        <label>Tarife<input name="tarife" value="@_c.Tarife" /></label>
        <label>Vade (gün)<input name="vadeGun" type="number" value="@_c.VadeGun" /></label>
        <label>Risk Limiti<input name="riskLimiti" type="number" step="0.01" value="@_c.RiskLimiti" /></label>
        <label>Risk Mesajı<input name="riskMesaji" value="@_c.RiskMesaji" /></label>
        <label>Risk Tarihi<input name="riskTarihi" type="date" value="@_c.RiskTarihi?.ToString("yyyy-MM-dd")" /></label>
        <label>Kara Liste
            <select name="karaListe">
                <option value="false" selected="@(!_c.KaraListe)">Hayır</option>
                <option value="true" selected="@_c.KaraListe">Evet</option>
            </select>
        </label>
        <label>Pasif
            <select name="pasif">
                <option value="false" selected="@(!_c.Pasif)">Hayır</option>
                <option value="true" selected="@_c.Pasif">Evet</option>
            </select>
        </label>
        <label>Sınıf<input name="sinif" list="dl-cus-sinif" autocomplete="off" value="@_c.Sinif" placeholder="Seç veya yaz" /></label>
        <datalist id="dl-cus-sinif">
            <option value="Düşük" /><option value="Orta" /><option value="Yüksek" />
            <option value="VIP" /><option value="Personel" /><option value="Problemli" />
        </datalist>
        <label>Mail İzin
            <select name="mailIzin">
                <option value="" selected="@(_c.MailIzin == null)">—</option>
                <option value="true" selected="@(_c.MailIzin == true)">Evet</option>
                <option value="false" selected="@(_c.MailIzin == false)">Hayır</option>
            </select>
        </label>
        <label>SMS İzin
            <select name="smsIzin">
                <option value="" selected="@(_c.SmsIzin == null)">—</option>
                <option value="true" selected="@(_c.SmsIzin == true)">Evet</option>
                <option value="false" selected="@(_c.SmsIzin == false)">Hayır</option>
            </select>
        </label>
        <label>Telefon İzin
            <select name="telefonIzin">
                <option value="" selected="@(_c.TelefonIzin == null)">—</option>
                <option value="true" selected="@(_c.TelefonIzin == true)">Evet</option>
                <option value="false" selected="@(_c.TelefonIzin == false)">Hayır</option>
            </select>
        </label>
        <label>Doğum Tarihi<input name="dogumTarihi" type="date" value="@_c.DogumTarihi?.ToString("yyyy-MM-dd")" max="@DateTimeOffset.Now.ToString("yyyy-MM-dd")" /></label>
        <label>Baba Adı<input name="babaAdi" value="@_c.BabaAdi" /></label>
        <label>Ana Adı<input name="anaAdi" value="@_c.AnaAdi" /></label>
        <label>Pasaport No<input name="pasaportNo" value="@_c.PasaportNo" /></label>
        <label>Fatura Dönemi<input name="faturaDonemi" value="@_c.FaturaDonemi" placeholder="Aylık/15 günlük/Peşin" /></label>
        <label>Tevkifat Oranı %<input name="tevkifatOrani" type="number" step="0.01" min="0" max="100" value="@_c.TevkifatOrani" /></label>
        <label>Özel Cari Tip
            <select name="ozelCariTip">
                <option value="">—</option>
                @foreach (var o in new[] { "Standart", "Yurtiçi", "Yurtdışı", "2.El", "Grup İçi" })
                { <option value="@o" selected="@(_c.OzelCariTip == o)">@o</option> }
            </select>
        </label>
        <label>Müşteri Tipi
            <select name="musteriTipi">
                <option value="">—</option>
                @foreach (var o in new[] { "Türk Ehliyetli", "Yabancı Ehliyetli", "Türk-Yabancı Ehliyetli" })
                { <option value="@o" selected="@(_c.MusteriTipi == o)">@o</option> }
            </select>
        </label>
        <label>Ehliyet Ülke<input name="ehliyetUlke" value="@_c.EhliyetUlke" placeholder="TÜRKİYE" /></label>
        <label>Dil
            <select name="dil">
                <option value="">—</option>
                @foreach (var o in new[] { "TR", "EN", "Diğer" })
                { <option value="@o" selected="@(_c.Dil == o)">@o</option> }
            </select>
        </label>
        <label>Döviz
            <select name="doviz">
                <option value="">—</option>
                @foreach (var o in new[] { "TL", "EURO", "USD" })
                { <option value="@o" selected="@(_c.Doviz == o)">@o</option> }
            </select>
        </label>
        <label>Tevkifat Durumu
            <select name="tevkifatDurum">
                <option value="">—</option>
                @foreach (var o in new[] { "Serbest", "Sadece Tevkifatsız", "Sadece Tevkifatlı" })
                { <option value="@o" selected="@(_c.TevkifatDurum == o)">@o</option> }
            </select>
        </label>
        <div class="full">
            <p class="muted small">Yetkili Kişiler (kurumsal) — değişken sayıda. Boş satırlar atlanır; daha fazlası için kaydedip tekrar düzenleyin.</p>
            @{ var kisiSayisi = Math.Max(_c.Kisiler.Count + 3, 3); }
            @for (var i = 0; i < kisiSayisi; i++)
            {
                var k = i < _c.Kisiler.Count ? _c.Kisiler[i] : null;
                <div class="grid-form">
                    <label>Ad Soyad<input name="kisi[@i].adSoyad" value="@k?.AdSoyad" /></label>
                    <label>Görev<input name="kisi[@i].gorev" value="@k?.Gorev" /></label>
                    <label>Telefon<input name="kisi[@i].telefon" value="@k?.Telefon" /></label>
                    <label>E-posta<input name="kisi[@i].mail" type="email" value="@k?.Mail" /></label>
                </div>
            }
        </div>
        <label>KVKK Onay
            <select name="kvkkOnay">
                <option value="" selected="@(_c.KvkkOnay is null)">—</option>
                <option value="true" selected="@(_c.KvkkOnay == true)">Onaylı</option>
                <option value="false" selected="@(_c.KvkkOnay == false)">Onaysız</option>
            </select>
        </label>
        <label>KVKK Onay Tarihi<input name="kvkkOnayTarih" type="date" value="@_c.KvkkOnayTarih?.ToString("yyyy-MM-dd")" /></label>
        <label>Ek Adres<input name="ekAdres" value="@_c.EkAdres" /></label>
        <label>Banka IBAN<input name="bankaIban" maxlength="34" value="@_c.BankaIban" /></label>
        <label>Banka Adı<input name="bankaAdi" value="@_c.BankaAdi" /></label>
        <label>Fatura Adresi<input name="faturaAdresi" value="@_c.FaturaAdresi" /></label>
        <label>Fatura Ünvanı<input name="faturaUnvan" value="@_c.FaturaUnvan" /></label>
        @* FAZ-40: Adres alanı entity'de VARDI ama forma hiç bağlanmamıştı — kullanıcı giremiyordu. *@
        <label class="u-col-full">Adres<input name="adres" value="@_c.Adres" maxlength="512" /></label>
        <label class="u-col-full">İş Adresi<input name="isAdresi" value="@_c.IsAdresi" maxlength="512" /></label>
        <label class="u-col-full">Açıklama<input name="aciklama" value="@_c.Aciklama" maxlength="1024" /></label>
        <label class="u-col-full">Uyarı Notu<input name="uyariSerbest" value="@_c.UyariSerbest" maxlength="512" /></label>
        <label>Ülke<input name="ulke" value="@_c.Ulke" maxlength="64" /></label>
        <label>Telefon 2<input name="tel2" value="@_c.Tel2" maxlength="32" /></label>
        <label>Özel Kod<input name="ozelKod" value="@_c.OzelKod" maxlength="64" /></label>
        <label>Entegrasyon Kodu<input name="entegrasyonKodu" value="@_c.EntegrasyonKodu" maxlength="64" /></label>
        <label>Risk İzni<input name="riskIzin" value="@_c.RiskIzin" maxlength="64" /></label>
        <label>Doğum Yeri<input name="dogumYeri" value="@_c.DogumYeri" maxlength="128" /></label>
        <label>Pasaport Veriliş Yeri<input name="pasaportYeri" value="@_c.PasaportYeri" maxlength="128" /></label>
        <label>Kurumsal No<input name="kurumsalNo" value="@_c.KurumsalNo" maxlength="64" /></label>
        <label>Tevkifat Kodu<input name="tevkifatKodu" value="@_c.TevkifatKodu" maxlength="32" /></label>
        <label>Faturada Kiralayan İsmi<input name="faturaKiralayanIsim" value="@_c.FaturaKiralayanIsim" maxlength="256" /></label>
        <label>İş Telefonu<input name="isTelefonu" value="@_c.IsTelefonu" maxlength="32" /></label>
        <label>Kayıtlı İl<input name="kayitliIl" value="@_c.KayitliIl" maxlength="64" /></label>
        <label>Kayıtlı İlçe<input name="kayitliIlce" value="@_c.KayitliIlce" maxlength="64" /></label>
        <label>Mahalle / Köy<input name="mahalleKoy" value="@_c.MahalleKoy" maxlength="128" /></label>
        <label>Seri No<input name="seriNo" value="@_c.SeriNo" maxlength="32" /></label>
        <label>Cilt No<input name="ciltNo" value="@_c.CiltNo" maxlength="32" /></label>
        <label>Aile Sıra No<input name="aileSira" value="@_c.AileSira" maxlength="32" /></label>
        <label>Sıra No<input name="siraNo" value="@_c.SiraNo" maxlength="32" /></label>
        <label>Pasaport Veriliş Tarihi<input name="pasaportTarihi" type="date" value="@_c.PasaportTarihi?.ToString("yyyy-MM-dd")" /></label>
        <label>Kara Liste Zamanı<input name="karaZamani" type="date" value="@_c.KaraZamani?.ToString("yyyy-MM-dd")" /></label>
        @* Ondalıklar InvariantCulture ile basılır: tr-TR "0,1500" üretir ve tarayıcı type=number
           alanını BOŞALTIR → kullanıcı başka alanı düzeltip kaydedince değer null'a düşerdi. *@
        <label>Bayi Komisyonu<input name="bayiKomisyon" type="number" step="0.0001" min="0" value="@Inv(_c.BayiKomisyon)" /></label>
        <label>Web İndirimi<input name="webIndirim" type="number" step="0.0001" min="0" value="@Inv(_c.WebIndirim)" /></label>
        @* PORTAL ŞİFRESİ: düz metin SAKLANMAZ, tek yönlü özetlenir. Boş = değiştirme. *@
        <label>Portal Şifresi<input name="sifre" type="password" autocomplete="new-password"
            placeholder="@(_c.Id == Guid.Empty ? "" : "(boş = değişmez)")" /></label>
        <label class="kf-inline"><input type="checkbox" name="tcDogrulama" value="true" checked="@_c.TcDogrulama" /> TC Doğrulandı</label>
        <label class="kf-inline"><input type="checkbox" name="faturaAdresFarkli" value="true" checked="@_c.FaturaAdresFarkli" /> Fatura Adresi Farklı</label>
        <label class="kf-inline"><input type="checkbox" name="faturaTekSatir" value="true" checked="@_c.FaturaTekSatir" /> Fatura Tek Satır</label>
        <label class="kf-inline"><input type="checkbox" name="dogumGunuTakip" value="true" checked="@_c.DogumGunuTakip" /> Doğum Günü Takibi</label>
        <label class="kf-inline"><input type="checkbox" name="bakiyeGor" value="true" checked="@_c.BakiyeGor" /> Bakiye Görebilir</label>
        <label class="kf-inline"><input type="checkbox" name="aracVerilmez" value="true" checked="@_c.AracVerilmez" /> ARAÇ VERİLMEZ</label>
        <label class="kf-inline"><input type="checkbox" name="yasEhliyetSerbest" value="true" checked="@_c.YasEhliyetSerbest" /> Yaş/Ehliyet Kuralından Muaf</label>
        <label class="kf-inline"><input type="checkbox" name="merkezKurumsal" value="true" checked="@_c.MerkezKurumsal" /> Merkez Kurumsal</label>
        <label class="kf-inline"><input type="checkbox" name="broker" value="true" checked="@_c.Broker" /> Broker</label>
        <label class="kf-inline"><input type="checkbox" name="findexZorunlu" value="true" checked="@_c.FindexZorunlu" /> Findex Zorunlu</label>
        <div class="u-col-full muted small">KVKK anonimleştirme talebi (kayıt SİLİNMEZ, alan bazında maskeleme işaretlenir):</div>
        <label class="kf-inline"><input type="checkbox" name="anonimAd" value="true" checked="@_c.AnonimAd" /> Ad</label>
        <label class="kf-inline"><input type="checkbox" name="anonimTc" value="true" checked="@_c.AnonimTc" /> TC</label>
        <label class="kf-inline"><input type="checkbox" name="anonimTelefon" value="true" checked="@_c.AnonimTelefon" /> Telefon</label>
        <label class="kf-inline"><input type="checkbox" name="anonimMail" value="true" checked="@_c.AnonimMail" /> Mail</label>
        <label class="kf-inline"><input type="checkbox" name="anonimAdres" value="true" checked="@_c.AnonimAdres" /> Adres</label>
        <label class="kf-inline"><input type="checkbox" name="anonimBelge" value="true" checked="@_c.AnonimBelge" /> Belge</label>

        <button type="submit">Güncelle</button>
        <a href="/cariler" class="link">İptal</a>
    </form>
}

@code {
    /// <summary>type=number değeri INVARIANT — tr-TR "0,1500" basar, tarayıcı alanı boşaltır
    /// ve kaydetmede değer sessizce null'a düşerdi (FAZ-22 H1 dersi).</summary>
    private static string? Inv(decimal? v) => v?.ToString(System.Globalization.CultureInfo.InvariantCulture);

    [Parameter] public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "hata")]
    public string? Hata { get; set; }

    private Customer? _c;
    private List<string> _ilOpts = [], _ilceOpts = [], _kaynakOpts = [];

    protected override async Task OnInitializedAsync()
    {
        _c = await Customers.GetAsync(Id);

        // Seç-veya-yaz önerileri: İl/İlçe mevcut kayıtlardan distinct; Kaynak master tanımdan.
        var all = await Customers.ListAsync();
        _ilOpts = all.Select(c => c.Il).Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.CurrentCulture).ToList();
        _ilceOpts = all.Select(c => c.Ilce).Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.CurrentCulture).ToList();
        _kaynakOpts = (await Kaynaklar.ListActiveAsync()).Select(k => k.Ad).ToList();
    }
}
