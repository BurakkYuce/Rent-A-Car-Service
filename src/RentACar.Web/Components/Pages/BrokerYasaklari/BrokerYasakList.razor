@page "/broker-yasaklari"
@attribute [Authorize(Roles = "Admin,Yonetici,Operator")]
@inject BrokerYasakService BrokerYasaklari

<PageTitle>Broker Yasakları — RentPro</PageTitle>

<div class="page-head"><h1>Broker / Kaynak Satış Yasakları</h1><div class="actions"></div></div>
<p class="muted small">Belirli kaynak (broker/kanal) × araç grubu × bölge × tarih kapsamında kiralama/satış
    KISITI: min gün altı yasak ve/veya kapsamda tüm satış kapalı. Boş kapsam alanı → o boyutta "tümü".
    Saf kural-tanım — deftere kayıt postlamaz.</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_list.Count == 0)">
    <summary>+ Yeni Yasak</summary>
    <form method="post" action="/broker-yasaklari/create" class="grid-form"><AntiforgeryToken />
        <label>Kod<input name="kod" required placeholder="BROKER-X-MIN3" /></label>
        <label>Ad<input name="ad" required placeholder="Broker X — min 3 gün" /></label>
        <label>Açıklama<input name="aciklama" /></label>
        <label>Kaynak (broker/kanal)<input name="kaynak" placeholder="Boş → tümü" /></label>
        <label>Araç Grubu Kodu<input name="aracGrupKod" placeholder="Boş → tümü" /></label>
        <label>Bölge<input name="bolge" placeholder="Boş → tümü" /></label>
        <label>Min Gün<input name="minGun" type="number" min="0" placeholder="altı yasak" /></label>
        <label>Tüm satış kapalı
            <select name="tumSatisKapali"><option value="false">Hayır</option><option value="true">Evet</option></select>
        </label>
        <label>Geçerlilik Baş<input name="gecerlilikBas" type="date" /></label>
        <label>Geçerlilik Bit<input name="gecerlilikBit" type="date" /></label>
        <button type="submit">Oluştur</button>
    </form>
</details>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Kod</th><th>Ad</th><th>Kaynak</th><th>Grup</th><th>Bölge</th><th>Min Gün</th><th>Tüm Kapalı</th><th>Durum</th><th>İşlem</th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="9" class="muted">Broker yasağı tanımlı değil.</td></tr>
        }
        @foreach (var r in _list)
        {
            <tr>
                <td class="mono">@r.Kod</td>
                <td>@r.Ad</td>
                <td>@(r.Kaynak ?? "—")</td>
                <td>@(r.AracGrupKod ?? "—")</td>
                <td>@(r.Bolge ?? "—")</td>
                <td class="num">@(r.MinGun?.ToString() ?? "—")</td>
                <td>@(r.TumSatisKapali ? "Evet" : "Hayır")</td>
                <td>@(r.Aktif ? "Aktif" : "Pasif")</td>
                <td>
                    <details>
                        <summary class="link">Düzenle</summary>
                        <form method="post" action="/broker-yasaklari/update" class="grid-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@r.Id" />
                            <label>Kod<input name="kod" value="@r.Kod" required /></label>
                            <label>Ad<input name="ad" value="@r.Ad" required /></label>
                            <label>Açıklama<input name="aciklama" value="@r.Aciklama" /></label>
                            <label>Kaynak<input name="kaynak" value="@r.Kaynak" /></label>
                            <label>Araç Grubu Kodu<input name="aracGrupKod" value="@r.AracGrupKod" /></label>
                            <label>Bölge<input name="bolge" value="@r.Bolge" /></label>
                            <label>Min Gün<input name="minGun" type="number" min="0" value="@r.MinGun" /></label>
                            <label>Tüm satış kapalı
                                <select name="tumSatisKapali">
                                    <option value="false" selected="@(!r.TumSatisKapali)">Hayır</option>
                                    <option value="true" selected="@r.TumSatisKapali">Evet</option>
                                </select>
                            </label>
                            <label>Geçerlilik Baş<input name="gecerlilikBas" type="date" value="@r.GecerlilikBas?.ToString("yyyy-MM-dd")" /></label>
                            <label>Geçerlilik Bit<input name="gecerlilikBit" type="date" value="@r.GecerlilikBit?.ToString("yyyy-MM-dd")" /></label>
                            <label>Durum
                                <select name="aktif">
                                    <option value="true" selected="@r.Aktif">Aktif</option>
                                    <option value="false" selected="@(!r.Aktif)">Pasif</option>
                                </select>
                            </label>
                            <button type="submit">Kaydet</button>
                        </form>
                    </details>
                    <form method="post" action="/broker-yasaklari/delete" data-confirm="Yasak silinsin mi?"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@r.Id" />
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private IReadOnlyList<BrokerYasak> _list = [];

    protected override async Task OnInitializedAsync()
        => _list = await BrokerYasaklari.ListAsync();
}
