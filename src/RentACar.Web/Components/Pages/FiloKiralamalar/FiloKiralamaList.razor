@page "/filo-kiralama"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@using RentACar.Application.FiloKiralamalar
@inject FiloKiralamaService Kiralamalar
@inject CustomerService Customers
@inject VehicleService Vehicles

<PageTitle>Filo / Uzun Dönem Kiralama — RentPro</PageTitle>

<div class="page-head"><h1>Filo / Uzun Dönem Kiralama</h1><div class="actions"><a href="/listeler/export/filo-kiralama">Excel</a> · <a href="/listeler/export/filo-kiralama?format=csv">CSV</a> · <a href="/listeler/export/filo-kiralama?format=pdf">PDF</a></div></div>
<p class="muted small">Aylık ücretli, çok-aylık operasyonel kiralama sözleşmeleri. Sözleşme + taksit planı kaydı;
    gelir aylık faturalama (Manuel Fatura) ile tanınır — bu ekran deftere/bakiyeye yazmaz.</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details>
    <summary>Yeni Sözleşme</summary>
    <form method="post" action="/filo-kiralama/create" class="grid-form"><AntiforgeryToken />
        <label>Müşteri
            <select name="musteriId" required>
                <option value="">—</option>
                @foreach (var c in _custMap) { <option value="@c.Key">@c.Value</option> }
            </select>
        </label>
        <label>Araç
            <select name="vehicleId" required>
                <option value="">—</option>
                @foreach (var v in _vehMap) { <option value="@v.Key">@v.Value</option> }
            </select>
        </label>
        <label>Başlangıç<input name="basTar" type="date" /></label>
        <label>Süre (Ay)<input name="sureAy" type="number" min="1" max="120" required /></label>
        <label>Aylık Ücret<input name="aylikUcret" type="number" step="0.01" min="0" required /></label>
        <label>KDV Oranı<input name="kdvOrani" type="number" step="0.01" min="0" max="1" value="0.20" /></label>
        <label>Toplam KM Limiti<input name="toplamKmLimiti" type="number" min="0" /></label>
        <label>Damga Vergisi<input name="damgaVergisi" type="number" step="0.01" min="0" /></label>
        <label>Açıklama<input name="aciklama" /></label>
        <label>Sözleşme No (firma)<input name="sozlesmeNo" maxlength="32" title="Firmanızın kendi numarası — sistemin ürettiği No'dan ayrı" /></label>
        <label>Makbuz No<input name="makbuzNo" maxlength="32" /></label>
        <label>Dosya No<input name="dosyaNo" maxlength="32" /></label>
        <label>Sözleşme Tarihi<input name="sozlesmeTarihi" type="date" /></label>
        <label>İmza Tarihi<input name="imzaTarih" type="date" /></label>
        <label>Satış Temsilcisi<input name="satisTemsilcisi" maxlength="128" /></label>
        <label>Fatura Türü<input name="faturaTuru" maxlength="32" list="dl-fk-faturaturu" />
            <datalist id="dl-fk-faturaturu"><option value="Dönem"></option><option value="Kırık"></option></datalist>
        </label>
        <label>Fiyat Türü<input name="fiyatTuru" maxlength="32" list="dl-fk-fiyatturu" title="Bilgi amaçlı etiket — taksit planını DEĞİŞTİRMEZ" />
            <datalist id="dl-fk-fiyatturu"><option value="Aylık"></option><option value="30 Gün Aylık"></option><option value="KDV Dahil"></option><option value="30 Gün Dahil"></option></datalist>
        </label>
        <label>Kaynak<input name="kaynak" maxlength="64" /></label>
        <label>Vade Gün<input name="vadeGun" type="number" min="0" /></label>
        <label>Çıkış KM<input name="cikisKm" type="number" min="0" /></label>
        <label>Toplam KM (fiili)<input name="toplamKm" type="number" min="0" title="Dönüşte okunan gerçek km — KM limiti ile karıştırmayın" /></label>
        <button type="submit">Kaydet</button>
    </form>
</details>

@* FAZ-21 arama paneli. GET formu: JS yok, URL paylaşılabilir; filtreleme SQL'de. *@
<form method="get" class="filter-bar">
    <label>Müşteri
        <select name="musteriId">
            <option value="">— tümü —</option>
            @foreach (var c in _custMap) { <option value="@c.Key" selected="@(c.Key.ToString() == MusteriId)">@c.Value</option> }
        </select>
    </label>
    <label>Plaka<input name="plaka" value="@Plaka" placeholder="34 AB" /></label>
    <label>Ara<input name="ara" value="@Ara" placeholder="sözleşme / makbuz / dosya no" /></label>
    <label>Durum
        <select name="durum">
            <option value="">— tümü —</option>
            @foreach (var d in Enum.GetValues<RentACar.Domain.Enums.FiloKiraDurum>())
            { <option value="@d" selected="@(d.ToString() == Durum)">@d</option> }
        </select>
    </label>
    <label>Başlangıç ≥<input name="bas" type="date" value="@Bas" /></label>
    <label>Başlangıç ≤<input name="bit" type="date" value="@Bit" /></label>
    <button type="submit">Ara</button>
    @if (FiltreVar) { <a class="link" href="/filo-kiralama">Temizle</a> }
</form>

<p class="muted small">@_list.Count sözleşme</p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>No</th><th>Sözleşme No</th><th>Müşteri</th><th>Araç</th><th>Başlangıç</th><th class="num">Süre Ay</th><th class="num">Aylık</th><th class="num">Genel Toplam</th><th>Satış Tems.</th><th>Kaynak</th><th class="num">Vade Gün</th><th>Durum</th><th></th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="13" class="muted">@(FiltreVar ? "Aramaya uyan sözleşme yok." : "Sözleşme yok.")</td></tr>
        }
        @foreach (var k in _list)
        {
            var ozet = FiloKiralamaService.TaksitPlani(k);
            <tr>
                <td>@k.No</td>
                <td>@(k.SozlesmeNo ?? "—")</td>
                <td>@CustName(k.MusteriId)</td>
                <td>@VehName(k.VehicleId)</td>
                <td>@k.BasTar.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td class="num">@k.SureAy</td>
                <td class="num">@k.AylikUcret.ToString("N2")</td>
                <td class="num">@ozet.GenelToplam.ToString("N2") @k.Currency</td>
                <td>@(k.SatisTemsilcisi ?? "—")</td>
                <td>@(k.Kaynak ?? "—")</td>
                <td class="num">@(k.VadeGun?.ToString() ?? "—")</td>
                <td>@k.Durum</td>
                <td>
                    @if (k.Durum == RentACar.Domain.Enums.FiloKiraDurum.Aktif)
                    {
                        <form method="post" action="/filo-kiralama/tamamla" style="display:inline"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@k.Id" /><button type="submit">Tamamla</button>
                        </form>
                        @* Yetki çiti: uç grup kapısından DAHA DAR izin istiyor (UcIzinKapsamaTests) — kapılanmazsa 403 → /yetkisiz. *@
                        <AuthorizeView Policy="izin:OperationsDelete" Context="iptalCtx">
                            <form method="post" action="/filo-kiralama/iptal" style="display:inline"><AntiforgeryToken />
                                <input type="hidden" name="id" value="@k.Id" /><button type="submit" class="btn-secondary">İptal</button>
                            </form>
                        </AuthorizeView>
                        <details>
                            <summary class="link">Künye</summary>
                            @* Para/süre alanları burada YOK: taksit planı bu yoldan değiştirilemez
                               (giriş tipi onları taşımıyor). Plan değişmeliyse sözleşme iptal edilip
                               yenisi açılır. *@
                            <form method="post" action="/filo-kiralama/guncelle" class="grid-form"><AntiforgeryToken />
                                <input type="hidden" name="id" value="@k.Id" />
                                <label>Sözleşme No (firma)<input name="sozlesmeNo" maxlength="32" value="@k.SozlesmeNo" /></label>
                                <label>Makbuz No<input name="makbuzNo" maxlength="32" value="@k.MakbuzNo" /></label>
                                <label>Dosya No<input name="dosyaNo" maxlength="32" value="@k.DosyaNo" /></label>
                                <label>Sözleşme Tarihi<input name="sozlesmeTarihi" type="date" value="@k.SozlesmeTarihi?.LocalDateTime.ToString("yyyy-MM-dd")" /></label>
                                <label>İmza Tarihi<input name="imzaTarih" type="date" value="@k.ImzaTarih?.LocalDateTime.ToString("yyyy-MM-dd")" /></label>
                                <label>Satış Temsilcisi<input name="satisTemsilcisi" maxlength="128" value="@k.SatisTemsilcisi" /></label>
                                <label>Fatura Türü<input name="faturaTuru" maxlength="32" value="@k.FaturaTuru" list="dl-fk-faturaturu" /></label>
                                <label>Fiyat Türü<input name="fiyatTuru" maxlength="32" value="@k.FiyatTuru" list="dl-fk-fiyatturu" /></label>
                                <label>Kaynak<input name="kaynak" maxlength="64" value="@k.Kaynak" /></label>
                                <label>Vade Gün<input name="vadeGun" type="number" min="0" value="@k.VadeGun" /></label>
                                <label>KM Limiti<input name="toplamKmLimiti" type="number" min="0" value="@k.ToplamKmLimiti" /></label>
                                <label>Çıkış KM<input name="cikisKm" type="number" min="0" value="@k.CikisKm" /></label>
                                <label>Toplam KM (fiili)<input name="toplamKm" type="number" min="0" value="@k.ToplamKm" /></label>
                                <label>Açıklama<input name="aciklama" value="@k.Aciklama" /></label>
                                <button type="submit">Künyeyi Kaydet</button>
                            </form>
                        </details>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "musteriId")] public string? MusteriId { get; set; }
    [SupplyParameterFromQuery(Name = "plaka")] public string? Plaka { get; set; }
    [SupplyParameterFromQuery(Name = "ara")] public string? Ara { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }

    private bool FiltreVar => !string.IsNullOrWhiteSpace(MusteriId) || !string.IsNullOrWhiteSpace(Plaka)
        || !string.IsNullOrWhiteSpace(Ara) || !string.IsNullOrWhiteSpace(Durum)
        || !string.IsNullOrWhiteSpace(Bas) || !string.IsNullOrWhiteSpace(Bit);

    private IReadOnlyList<FiloKiralama> _list = [];
    private Dictionary<Guid, string> _custMap = new();
    private Dictionary<Guid, string> _vehMap = new();

    protected override async Task OnInitializedAsync()
    {
        _custMap = (await Customers.ListAsync()).ToDictionary(c => c.Id, c => c.DisplayName);
        _vehMap = (await Vehicles.ListAsync()).ToDictionary(v => v.Id, v => v.Plaka);
        _list = await Kiralamalar.ListAsync(new FiloKiralamaFilter
        {
            MusteriId = Guid.TryParse(MusteriId, out var m) ? m : null,
            Plaka = Plaka,
            Ara = Ara,
            Durum = Enum.TryParse<RentACar.Domain.Enums.FiloKiraDurum>(Durum, out var d) ? d : null,
            Bas = Tarih(Bas),
            // Üst sınır GÜN SONUNA genişletilir (tarih girişi 00:00'a düşer).
            Bit = Tarih(Bit)?.AddDays(1).AddTicks(-1)
        });
    }

    private static DateTimeOffset? Tarih(string? s)
        => DateTimeOffset.TryParse(s, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? d.ToUniversalTime() : null;

    private string CustName(Guid id) => _custMap.TryGetValue(id, out var n) ? n : "—";
    private string VehName(Guid id) => _vehMap.TryGetValue(id, out var n) ? n : "—";
}
