@page "/musteri-taksit"
@attribute [Authorize(Policy = "izin:FinanceWrite")]
@using RentACar.Domain.Enums
@inject MusteriTaksitService Taksitler
@inject CustomerService Cariler
@inject VehicleService Araclar

<PageTitle>Müşteri Taksitleri — RentPro</PageTitle>

<div class="page-head"><h1>Müşteri Taksit Takibi</h1></div>
@* İKİ AKIŞI AYIRAN NOT: /arac-kredi şirketin BANKAYA borcudur; burası MÜŞTERİNİN ŞİRKETE
   borcudur. Aynı tabloda birleştirmek kavramsal karıştırma olurdu. *@
<p class="muted small">Müşteriye <strong>taksitli satış/kredi ile araç verme</strong> takibi.
    Şirketin banka kredisiyle araç <em>alımı</em> için <a href="/arac-kredi">Araç Kredisi</a>
    ekranını kullanın — farklı taraf, farklı yön.</p>
<p class="muted small"><strong>Bu ekran deftere yazmaz.</strong> "Ödendi" işareti takip amaçlıdır;
    cari bakiyeyi Kasa/Banka tahsilat akışı değiştirir. İkisini bağlamak çift kayıt üretirdi.
    <strong>Gecikme</strong> kolona yazılmaz, vade ve bugünden <em>hesaplanır</em> — bayat veri olmaz.</p>

@if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }

<form method="get" class="filter-bar">
    <label>Müşteri
        <select name="cariF">
            <option value="">— tümü —</option>
            @foreach (var c in _cariler) { <option value="@c.Id" selected="@(c.Id.ToString() == CariF)">@c.DisplayName</option> }
        </select>
    </label>
    <label>Araç
        <select name="aracF">
            <option value="">— tümü —</option>
            @foreach (var a in _araclar) { <option value="@a.Id" selected="@(a.Id.ToString() == AracF)">@a.Plaka</option> }
        </select>
    </label>
    <label>Durum
        <select name="durumF">
            <option value="">— tümü —</option>
            @foreach (var d in Enum.GetValues<TaksitDurum>()) { <option value="@d" selected="@(d.ToString() == DurumF)">@d</option> }
        </select>
    </label>
    <label>Vade Baş.<input name="min" type="date" value="@Min" /></label>
    <label>Vade Bit.<input name="max" type="date" value="@Max" /></label>
    <label class="kf-inline"><input type="checkbox" name="gecikmis" value="true" checked="@(Gecikmis == "true")" /> Yalnız gecikenler</label>
    <button type="submit">Filtrele</button>
    @if (FiltreVar) { <a class="link" href="/musteri-taksit">Temizle</a> }
</form>

@* Tutarlar BAZ para (Tutar × Kur) toplanır — karışık dövizli plan tek sayıda anlamlı olsun. *@
<div class="cards">
    <div class="card"><div class="card-num">@_ozet.Adet</div><div class="card-label">Taksit</div></div>
    <div class="card"><div class="card-num pos">@_ozet.OdenenAdet</div><div class="card-label">Ödenen</div></div>
    <div class="card"><div class="card-num @(_ozet.GecikenAdet > 0 ? "neg" : "")">@_ozet.GecikenAdet</div><div class="card-label">Geciken</div></div>
    <div class="card"><div class="card-num">@_ozet.ToplamBaz.ToString("N2")</div><div class="card-label">Toplam ₺</div></div>
    <div class="card"><div class="card-num">@_ozet.KalanBaz.ToString("N2")</div><div class="card-label">Kalan ₺</div></div>
</div>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th class="num">#</th><th>Müşteri</th><th>Araç</th><th>Vade</th>
        <th class="num">Tutar</th><th>Döviz</th><th class="num">Kur</th><th class="num">Baz ₺</th>
        <th>Durum</th><th>Ödeme Tarihi</th><th>Açıklama</th><th></th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="12" class="muted">@(FiltreVar ? "Filtreye uyan taksit yok." : "Kayıt yok.")</td></tr>
        }
        @foreach (var t in _list)
        {
            <tr>
                <td class="num">@t.Sira</td>
                <td>@(_cariAd.GetValueOrDefault(t.CariId) ?? "—")</td>
                <td class="mono">@(t.VehicleId is Guid v ? _plaka.GetValueOrDefault(v) ?? "—" : "—")</td>
                <td class="@(t.Gecikti ? "neg" : null)">@t.Vade.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td class="num">@t.TaksitTutari.ToString("N2")</td>
                <td>@t.Currency</td>
                <td class="num muted">@t.Kur.ToString("N4")</td>
                <td class="num">@t.TutarBaz.ToString("N2")</td>
                <td>
                    @if (t.Durum == TaksitDurum.Odendi)
                    {
                        <span class="status-pill sp-success">Ödendi</span>
                    }
                    else if (t.Gecikti)
                    {
                        <span class="status-pill sp-warn">Gecikti</span>
                    }
                    else
                    {
                        <span class="status-pill">Bekliyor</span>
                    }
                </td>
                <td>@(t.OdemeTarihi?.LocalDateTime.ToString("dd.MM.yyyy") ?? "—")</td>
                <td>@(t.Aciklama ?? "—")</td>
                <td>
                    <form method="post" action="/musteri-taksit/odeme" class="inline"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@t.Id" />
                        <input type="hidden" name="geriAl" value="@(t.Durum == TaksitDurum.Odendi ? "true" : "false")" />
                        @Gizli
                        <button type="submit" class="btn-secondary">@(t.Durum == TaksitDurum.Odendi ? "Geri Al" : "Ödendi")</button>
                    </form>
                    <a href="@Geri(t.Id)" class="link">Düzenle</a>
                    <form method="post" action="/musteri-taksit/delete" class="inline" data-confirm="Taksit silinsin mi?"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@t.Id" />@Gizli
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<h2 class="dash-h2">@(_edit is null ? "Tek Taksit Ekle" : "Taksiti Düzenle")</h2>
<form method="post" action="@(_edit is null ? "/musteri-taksit/create" : "/musteri-taksit/update")" class="grid-form"><AntiforgeryToken />
    @if (_edit is not null) { <input type="hidden" name="id" value="@_edit.Id" /> }
    @Gizli
    <label>Müşteri
        <select name="cariId" required>
            <option value="">—</option>
            @foreach (var c in _cariler) { <option value="@c.Id" selected="@(c.Id == _edit?.CariId)">@c.DisplayName</option> }
        </select>
    </label>
    <label>Araç (ops.)
        <select name="vehicleId">
            <option value="">—</option>
            @foreach (var a in _araclar) { <option value="@a.Id" selected="@(a.Id == _edit?.VehicleId)">@a.Plaka</option> }
        </select>
    </label>
    <label>Vade<input name="vade" type="date" required value="@(_edit?.Vade.UtcDateTime.ToString("yyyy-MM-dd"))" /></label>
    <label>Tutar<input name="taksitTutari" type="number" step="0.01" min="0.01" required value="@Inv(_edit?.TaksitTutari)" /></label>
    <label>Döviz<input name="currency" maxlength="3" value="@(_edit?.Currency ?? "TRY")" /></label>
    <label>Kur<input name="kur" type="number" step="0.0001" min="0.0001" value="@Inv(_edit?.Kur ?? 1m)" /></label>
    <label>Durum
        <select name="durum">
            @foreach (var d in Enum.GetValues<TaksitDurum>()) { <option value="@d" selected="@(_edit?.Durum == d)">@d</option> }
        </select>
    </label>
    <label>Ödeme Tarihi<input name="odemeTarihi" type="date" value="@(_edit?.OdemeTarihi?.UtcDateTime.ToString("yyyy-MM-dd"))" /></label>
    <label class="u-col-full">Açıklama<input name="aciklama" value="@_edit?.Aciklama" maxlength="512" /></label>
    <button type="submit">@(_edit is null ? "Ekle" : "Kaydet")</button>
    @if (_edit is not null) { <a href="@Geri()" class="btn-secondary">İptal</a> }
</form>

<h2 class="dash-h2">Taksit Planı Üret</h2>
@* Kalan-yöntemi: son taksit = toplam − (n−1)×aylık → Σ taksit kuruş-birebir toplama eşit. *@
<p class="muted small">N eşit aylık taksit üretir. Son taksit <strong>kalan-yöntemiyle</strong>
    hesaplanır: taksitlerin toplamı girilen toplam tutara kuruşu kuruşuna eşittir (yuvarlama
    kayması birikmez). Plan tek işlemde yazılır — yarım plan kalmaz.</p>
<form method="post" action="/musteri-taksit/plan" class="grid-form"><AntiforgeryToken />
    @Gizli
    <label>Müşteri
        <select name="cariId" required>
            <option value="">—</option>
            @foreach (var c in _cariler) { <option value="@c.Id">@c.DisplayName</option> }
        </select>
    </label>
    <label>Araç (ops.)
        <select name="vehicleId">
            <option value="">—</option>
            @foreach (var a in _araclar) { <option value="@a.Id">@a.Plaka</option> }
        </select>
    </label>
    <label>Toplam Tutar<input name="toplamTutar" type="number" step="0.01" min="0.01" required /></label>
    <label>Taksit Sayısı<input name="taksitSayisi" type="number" min="1" max="@MusteriTaksitService.MaxTaksit" required value="12" /></label>
    <label>İlk Vade<input name="ilkVade" type="date" required /></label>
    <label>Döviz<input name="currency" maxlength="3" value="TRY" /></label>
    <label>Kur<input name="kur" type="number" step="0.0001" min="0.0001" value="1" /></label>
    <label class="u-col-full">Açıklama<input name="aciklama" maxlength="512" /></label>
    <button type="submit">Plan Üret</button>
</form>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "duzenle")] public Guid? Duzenle { get; set; }
    [SupplyParameterFromQuery(Name = "cariF")] public string? CariF { get; set; }
    [SupplyParameterFromQuery(Name = "aracF")] public string? AracF { get; set; }
    [SupplyParameterFromQuery(Name = "durumF")] public string? DurumF { get; set; }
    [SupplyParameterFromQuery(Name = "min")] public string? Min { get; set; }
    [SupplyParameterFromQuery(Name = "max")] public string? Max { get; set; }
    [SupplyParameterFromQuery(Name = "gecikmis")] public string? Gecikmis { get; set; }

    private IReadOnlyList<MusteriTaksit> _list = [];
    private TaksitOzet _ozet = new(0, 0, 0, 0m, 0m, 0m);
    private MusteriTaksit? _edit;
    private IReadOnlyList<Customer> _cariler = [];
    private IReadOnlyList<Vehicle> _araclar = [];
    private Dictionary<Guid, string> _cariAd = new();
    private Dictionary<Guid, string> _plaka = new();

    private bool FiltreVar => !string.IsNullOrWhiteSpace(CariF) || !string.IsNullOrWhiteSpace(AracF)
        || !string.IsNullOrWhiteSpace(DurumF) || !string.IsNullOrWhiteSpace(Min)
        || !string.IsNullOrWhiteSpace(Max) || !string.IsNullOrWhiteSpace(Gecikmis);

    /// <summary>type=number değeri INVARIANT — tr-TR "1,0000" basar, tarayıcı alanı boşaltır
    /// ve kaydetmede değer sessizce kaybolurdu (FAZ-22 H1 dersi).</summary>
    private static string? Inv(decimal? v) => v?.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private RenderFragment Gizli => @<text>
        <input type="hidden" name="cariF" value="@CariF" />
        <input type="hidden" name="aracF" value="@AracF" />
        <input type="hidden" name="durumF" value="@DurumF" />
        <input type="hidden" name="min" value="@Min" />
        <input type="hidden" name="max" value="@Max" />
        <input type="hidden" name="gecikmis" value="@Gecikmis" />
    </text>;

    private string Geri(Guid? duzenle = null)
    {
        var q = new List<string>();
        void Ekle(string ad, string? v) { if (!string.IsNullOrWhiteSpace(v)) q.Add($"{ad}={Uri.EscapeDataString(v)}"); }
        Ekle("cariF", CariF); Ekle("aracF", AracF); Ekle("durumF", DurumF);
        Ekle("min", Min); Ekle("max", Max); Ekle("gecikmis", Gecikmis);
        if (duzenle is Guid id) q.Add($"duzenle={id}");
        return "/musteri-taksit" + (q.Count > 0 ? "?" + string.Join("&", q) : "");
    }

    protected override async Task OnInitializedAsync()
    {
        _list = await Taksitler.SearchAsync(new MusteriTaksitFilter
        {
            CariId = Guid.TryParse(CariF, out var c) ? c : null,
            VehicleId = Guid.TryParse(AracF, out var v) ? v : null,
            Durum = Enum.TryParse<TaksitDurum>(DurumF, out var d) ? d : null,
            VadeMin = DateTimeOffset.TryParse(Min, out var a) ? new DateTimeOffset(a.Date, TimeSpan.Zero) : null,
            // Bitiş günü DAHİL.
            VadeMax = DateTimeOffset.TryParse(Max, out var b) ? new DateTimeOffset(b.Date, TimeSpan.Zero).AddDays(1).AddTicks(-1) : null,
            SadeceGecikmis = Gecikmis == "true" ? true : null
        });
        _ozet = MusteriTaksitService.Ozet(_list);

        _cariler = await Cariler.ListAsync();
        _araclar = await Araclar.ListAsync();
        _cariAd = _cariler.ToDictionary(x => x.Id, x => x.DisplayName);
        _plaka = _araclar.ToDictionary(x => x.Id, x => x.Plaka);

        if (Duzenle is { } id) _edit = await Taksitler.GetAsync(id);
    }
}
