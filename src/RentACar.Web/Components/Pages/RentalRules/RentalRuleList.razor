@page "/kira-kurallari"
@attribute [Authorize(Roles = "Admin,Yonetici,Operator")]
@inject RentalRuleService KiralamaKurallari
@inject BranchService Subeler

<PageTitle>Kiralama Kuralları — RentPro</PageTitle>

<div class="page-head"><h1>Kiralama Kuralları (Promosyon / Şart)</h1><div class="actions"></div></div>
<p class="muted small">Tarih/gün/min-max gün bazlı promosyon-kampanya-indirim kuralı + kira/rezervasyon
    şart metni. Şube + kanal (rez kaynağı) + araç grubu kapsamına uygulanır. Saf kural-tanım — deftere
    kayıt postlamaz; fiyat motorunda indirim/min-gün girdisidir.</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_list.Count == 0)">
    <summary>+ Yeni Kural</summary>
    <form method="post" action="/kira-kurallari/create" class="grid-form"><AntiforgeryToken />
        <label>Kod<input name="kod" required placeholder="YAZ-KAMP" /></label>
        <label>Ad<input name="ad" required placeholder="Yaz Kampanyası" /></label>
        <label>Açıklama<input name="aciklama" /></label>
        <label>Kanal<input name="kanal" placeholder="WEB/ACENTA" /></label>
        <ComboBox Name="sube" Label="Şube" Options="_subeOpts" />
        <label>Araç Grubu Kodu<input name="aracGrupKod" placeholder="EKO" /></label>
        <label>Min Gün<input name="minGun" type="number" min="0" /></label>
        <label>Max Gün<input name="maxGun" type="number" min="0" /></label>
        <label>İskonto %<input name="iskonto" type="number" step="0.01" min="0" max="100" /></label>
        <label>Hafta Sonu Fark %<input name="haftaSonuFarkOran" type="number" step="0.01" min="0" max="200" /></label>
        <label>Sonra Öde %<input name="sonraOdeOran" type="number" step="0.01" min="0" max="100" /></label>
        <label>Hediye Gün<input name="hediyeGun" type="number" min="0" /></label>
        <label>Kampanya mı
            <select name="kampanyaMi"><option value="false">Hayır</option><option value="true">Evet</option></select>
        </label>
        <label>Kampanya Kodu<input name="kampanyaKodu" maxlength="64" /></label>
        <label>Müşteri Segmenti<input name="musteriSegment" list="dl-rr-segment" autocomplete="off" placeholder="Seç veya yaz (boş = herkes)" maxlength="64" /></label>
        <label>Geçerlilik Baş<input name="gecerlilikBas" type="date" /></label>
        <label>Geçerlilik Bit<input name="gecerlilikBit" type="date" /></label>
        <label>Şart Metni<input name="sartMetni" placeholder="Rez/sözleşme şartları" /></label>
        @* FAZ-46 — TALEP aralığı, GEÇERLİLİK aralığından farklıdır: geçerlilik kiralama tarihine,
           talep rezervasyonun YAPILDIĞI tarihe bakar (erken rezervasyon kampanyası). *@
        <label>Talep Baş<input name="talepBas" type="date" title="Rezervasyonun yapıldığı tarih ≥" /></label>
        <label>Talep Bit<input name="talepBit" type="date" title="Rezervasyonun yapıldığı tarih ≤" /></label>
        <label>Promosyon Türü
            <select name="promosyonTuru"><option value="">—</option><option value="Coklu">Çoklu</option><option value="Tek">Tek</option></select>
        </label>
        <label>Kupon Geçerliliği
            <select name="kuponGecerlilik"><option value="">—</option><option value="Hepsi">Hepsi</option><option value="SadeceIlkBedel">Sadece ilk bedel</option></select>
        </label>
        <label>Hesaplama Tipi
            <select name="hesaplamaTipi"><option value="">—</option><option value="Oran">Oran</option><option value="Serbest">Serbest</option></select>
        </label>
        <label class="check"><input type="checkbox" name="hizliIslem" value="true" /> Hızlı işlemde göster</label>
        <fieldset class="u-col-full">
            <legend>Geçerli günler (boş = tüm günler)</legend>
            @foreach (var g in Gunler)
            {
                <label class="check"><input type="checkbox" name="haftaGun" value="@g.No" /> @g.Ad</label>
            }
        </fieldset>
        <button type="submit">Oluştur</button>
    </form>
</details>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Kod</th><th>Ad</th><th>Kanal</th><th>Şube</th><th>Araç Grubu</th><th>Min/Max</th><th>İskonto</th><th>Kampanya</th><th>Durum</th><th>İşlem</th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="8" class="muted">Kiralama kuralı tanımlı değil.</td></tr>
        }
        @foreach (var r in _list)
        {
            <tr>
                <td class="mono">@r.Kod</td>
                <td>@r.Ad</td>
                <td>@r.Kanal</td>
                @* FAZ-46 — form alanları zaten vardı, grid'de görünmüyordu. *@
                <td>@(r.Sube ?? "—")</td>
                <td>@(r.AracGrupKod ?? "—")</td>
                <td class="num">@(r.MinGun?.ToString() ?? "—") / @(r.MaxGun?.ToString() ?? "—")</td>
                <td class="num">@(r.Iskonto?.ToString("N2") ?? "—")</td>
                <td>@(r.KampanyaMi ? "Evet" : "Hayır")</td>
                <td>@(r.Aktif ? "Aktif" : "Pasif")</td>
                <td>
                    <details>
                        <summary class="link">Düzenle</summary>
                        <form method="post" action="/kira-kurallari/update" class="grid-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@r.Id" />
                            <label>Kod<input name="kod" value="@r.Kod" required /></label>
                            <label>Ad<input name="ad" value="@r.Ad" required /></label>
                            <label>Açıklama<input name="aciklama" value="@r.Aciklama" /></label>
                            <label>Kanal<input name="kanal" value="@r.Kanal" /></label>
                            <ComboBox Name="sube" Label="Şube" Value="@r.Sube" Options="_subeOpts" ListId="dl-sube-edit" />
                            <label>Araç Grubu Kodu<input name="aracGrupKod" value="@r.AracGrupKod" /></label>
                            <label>Min Gün<input name="minGun" type="number" min="0" value="@r.MinGun" /></label>
                            <label>Max Gün<input name="maxGun" type="number" min="0" value="@r.MaxGun" /></label>
                            <label>İskonto %<input name="iskonto" type="number" step="0.01" min="0" max="100" value="@Inv(r.Iskonto)" /></label>
                            <label>Hafta Sonu Fark %<input name="haftaSonuFarkOran" type="number" step="0.01" min="0" max="200" value="@Inv(r.HaftaSonuFarkOran)" /></label>
                            <label>Sonra Öde %<input name="sonraOdeOran" type="number" step="0.01" min="0" max="100" value="@Inv(r.SonraOdeOran)" /></label>
                            <label>Hediye Gün<input name="hediyeGun" type="number" min="0" value="@r.HediyeGun" /></label>
                            <label>Kampanya mı
                                <select name="kampanyaMi">
                                    <option value="false" selected="@(!r.KampanyaMi)">Hayır</option>
                                    <option value="true" selected="@r.KampanyaMi">Evet</option>
                                </select>
                            </label>
                            <label>Kampanya Kodu<input name="kampanyaKodu" maxlength="64" value="@r.KampanyaKodu" /></label>
                            <label>Müşteri Segmenti<input name="musteriSegment" list="dl-rr-segment" autocomplete="off" placeholder="Boş = herkes" maxlength="64" value="@r.MusteriSegment" /></label>
                            <label>Geçerlilik Baş<input name="gecerlilikBas" type="date" value="@Gun(r.GecerlilikBas)" /></label>
                            <label>Geçerlilik Bit<input name="gecerlilikBit" type="date" value="@Gun(r.GecerlilikBit)" /></label>
                            <label>Şart Metni<input name="sartMetni" value="@r.SartMetni" /></label>
                            <label>Talep Baş<input name="talepBas" type="date" value="@Gun(r.TalepBas)" /></label>
                            <label>Talep Bit<input name="talepBit" type="date" value="@Gun(r.TalepBit)" /></label>
                            <label>Promosyon Türü
                                <select name="promosyonTuru">
                                    <option value="" selected="@(r.PromosyonTuru is null)">—</option>
                                    <option value="Coklu" selected="@(r.PromosyonTuru == PromosyonTuru.Coklu)">Çoklu</option>
                                    <option value="Tek" selected="@(r.PromosyonTuru == PromosyonTuru.Tek)">Tek</option>
                                </select>
                            </label>
                            <label>Kupon Geçerliliği
                                <select name="kuponGecerlilik">
                                    <option value="" selected="@(r.KuponGecerlilik is null)">—</option>
                                    <option value="Hepsi" selected="@(r.KuponGecerlilik == KuponGecerlilik.Hepsi)">Hepsi</option>
                                    <option value="SadeceIlkBedel" selected="@(r.KuponGecerlilik == KuponGecerlilik.SadeceIlkBedel)">Sadece ilk bedel</option>
                                </select>
                            </label>
                            <label>Hesaplama Tipi
                                <select name="hesaplamaTipi">
                                    <option value="" selected="@(r.HesaplamaTipi is null)">—</option>
                                    <option value="Oran" selected="@(r.HesaplamaTipi == HesaplamaTipi.Oran)">Oran</option>
                                    <option value="Serbest" selected="@(r.HesaplamaTipi == HesaplamaTipi.Serbest)">Serbest</option>
                                </select>
                            </label>
                            <label class="check"><input type="checkbox" name="hizliIslem" value="true" checked="@r.HizliIslem" /> Hızlı işlemde göster</label>
                            <fieldset class="u-col-full">
                                <legend>Geçerli günler (boş = tüm günler)</legend>
                                @foreach (var g in Gunler)
                                {
                                    <label class="check"><input type="checkbox" name="haftaGun" value="@g.No" checked="@GunSecili(r.HaftaGunKisiti, g.No)" /> @g.Ad</label>
                                }
                            </fieldset>
                            <label>Durum
                                <select name="aktif">
                                    <option value="true" selected="@r.Aktif">Aktif</option>
                                    <option value="false" selected="@(!r.Aktif)">Pasif</option>
                                </select>
                            </label>
                            <button type="submit">Kaydet</button>
                        </form>
                    </details>
                    <form method="post" action="/kira-kurallari/delete" data-confirm="Kural silinsin mi?"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@r.Id" />
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>


@* FAZ 3.A2: segment ComboBox önerileri (seç-veya-yaz; canlı TürevRent sınıf seti) *@
<datalist id="dl-rr-segment">
    <option value="Düşük" /><option value="Orta" /><option value="Yüksek" />
    <option value="VIP" /><option value="Personel" /><option value="Problemli" />
</datalist>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private IReadOnlyList<RentalRule> _list = [];
    private List<string> _subeOpts = [];

    /// <summary>Haftanın günleri — numaralandırma <see cref="DayOfWeek"/> ile AYNI (0=Pazar).</summary>
    private static readonly (int No, string Ad)[] Gunler =
    [
        (1, "Pzt"), (2, "Sal"), (3, "Çar"), (4, "Per"), (5, "Cum"), (6, "Cmt"), (0, "Paz")
    ];

    private static bool GunSecili(string? kisit, int gun)
        => !string.IsNullOrWhiteSpace(kisit)
           && kisit.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                   .Contains(gun.ToString(System.Globalization.CultureInfo.InvariantCulture));

    // Ondalık prefill'i InvariantCulture ile: tr-TR "12,50" basınca tarayıcı type=number alanını
    // BOŞALTIR ve kullanıcı dokunmadan kaydettiğinde değer NULL'lanır (repoda bilinen tuzak).
    private static string? Inv(decimal? d) => d?.ToString(System.Globalization.CultureInfo.InvariantCulture);

    // Tarih prefill'i YEREL gün ile: FormParse.Date sunucu-yerel parse edip UTC'ye çevirdiğinden
    // UTC günü basmak her kayıtta bir gün geri kaydırırdı.
    private static string? Gun(DateTimeOffset? d) => d?.LocalDateTime.ToString("yyyy-MM-dd");

    protected override async Task OnInitializedAsync()
    {
        _list = await KiralamaKurallari.ListAsync();
        _subeOpts = (await Subeler.ListActiveAsync()).Select(s => s.Ad).ToList();
    }
}
