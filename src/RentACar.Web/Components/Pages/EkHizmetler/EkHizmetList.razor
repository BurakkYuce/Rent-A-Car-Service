@page "/ek-hizmetler"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@inject AddOnDefinitionService EkHizmetler

<PageTitle>Ek Hizmetler — RentPro</PageTitle>

<div class="page-head"><h1>Ek Hizmet Tanımları</h1><div class="actions"></div></div>
<p class="muted small">Kiraya eklenebilen fiyatlı opsiyonlar (bebek koltuğu, GPS, ek sürücü, kasko
    muafiyeti…). Kira ek hizmet kalemleri varsayılan birim ücret + KDV oranını buradan alır; kira
    formunda serbest fiyat da girilebilir. KDV oranı 0..1 (ör. 0.20 = %20).</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_list.Count == 0)">
    <summary>+ Yeni Ek Hizmet</summary>
    <form method="post" action="/ek-hizmetler/create" class="grid-form"><AntiforgeryToken />
        <label>Kod<input name="kod" required placeholder="GPS" /></label>
        <label>Ad<input name="ad" required placeholder="Navigasyon" /></label>
        <label>Birim Ücret (NET)<input name="birimUcret" type="number" step="0.01" min="0" value="0" /></label>
        <label>KDV Oranı<input name="kdvOrani" type="number" step="0.01" min="0" max="1" value="0.20" placeholder="0.20 = %20" /></label>
        <label>Max Gün<input name="maxGun" type="number" min="1" placeholder="boş = sınırsız" title="Bilgi amaçlı üst sınır; miktar girişini engellemez" /></label>
        <label>Açıklama<textarea name="aciklama" rows="2" maxlength="512" placeholder="Kira formunda ipucu olarak gösterilir"></textarea></label>
        <button type="submit">Oluştur</button>
    </form>
</details>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Kod</th><th>Ad</th><th class="num">Birim Ücret</th><th class="num">KDV</th><th class="num">Max Gün</th><th>Açıklama</th><th>Durum</th><th>İşlem</th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="8" class="muted">Ek hizmet tanımlı değil.</td></tr>
        }
        @foreach (var e in _list)
        {
            <tr>
                <td class="mono">@e.Kod</td>
                <td>@e.Ad</td>
                <td class="num">@e.BirimUcret.ToString("N2")</td>
                <td class="num">@($"%{e.KdvOrani * 100:0.##}")</td>
                <td class="num">@(e.MaxGun?.ToString() ?? "—")</td>
                <td>@(string.IsNullOrWhiteSpace(e.Aciklama) ? "—" : e.Aciklama)</td>
                <td>@(e.Aktif ? "Aktif" : "Pasif")</td>
                <td>
                    <details>
                        <summary class="link">Düzenle</summary>
                        <form method="post" action="/ek-hizmetler/update" class="grid-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@e.Id" />
                            <label>Kod<input name="kod" value="@e.Kod" required /></label>
                            <label>Ad<input name="ad" value="@e.Ad" required /></label>
                            <label>Birim Ücret (NET)<input name="birimUcret" type="number" step="0.01" min="0" value="@e.BirimUcret" /></label>
                            <label>KDV Oranı<input name="kdvOrani" type="number" step="0.01" min="0" max="1" value="@e.KdvOrani" /></label>
                            <label>Max Gün<input name="maxGun" type="number" min="1" value="@e.MaxGun" placeholder="boş = sınırsız" /></label>
                            <label>Açıklama<textarea name="aciklama" rows="2" maxlength="512">@e.Aciklama</textarea></label>
                            <label>Durum
                                <select name="aktif">
                                    <option value="true" selected="@e.Aktif">Aktif</option>
                                    <option value="false" selected="@(!e.Aktif)">Pasif</option>
                                </select>
                            </label>
                            <button type="submit">Kaydet</button>
                        </form>
                    </details>
                    <form method="post" action="/ek-hizmetler/delete" data-confirm="Ek hizmet silinsin mi?"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@e.Id" />
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private IReadOnlyList<EkHizmetTanim> _list = [];

    protected override async Task OnInitializedAsync()
        => _list = await EkHizmetler.ListAsync();
}
