@page "/tarife-gruplari"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@inject TariffGroupService TarifeGruplari

<PageTitle>Tarife Grupları — RentPro</PageTitle>

<div class="page-head"><h1>Tarife (Fiyat) Grupları</h1></div>
<p class="muted small">Broker/kanal başına ad + oran + (varsa) giriş kimliği.
    <strong>Bu sürümde yalnız kayıttır:</strong> kimlik alanları saklanır ama hiçbir doğrulama
    akışına bağlı değildir — broker'ın bu kimlikle feed üzerinden sisteme girmesi ayrı bir iştir.
    Oran bilgi amaçlıdır; fiyat motoru bu tabloyu okumaz.</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_list.Count == 0)">
    <summary>+ Yeni Tarife Grubu</summary>
    <form method="post" action="/tarife-gruplari/create" class="grid-form"><AntiforgeryToken />
        <label>Kod<input name="kod" maxlength="32" required placeholder="BRK-X" /></label>
        <label>Ad<input name="ad" maxlength="128" required /></label>
        <label>Oran<input name="oran" type="number" step="0.0001" min="0" value="0" /></label>
        <label>Kullanıcı Adı<input name="kullaniciAdi" maxlength="128" autocomplete="off" /></label>
        <label>Şifre<input name="sifre" type="password" minlength="6" autocomplete="new-password" /></label>
        <button type="submit">Oluştur</button>
    </form>
</details>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Kod</th><th>Ad</th><th class="num">Oran</th><th>Kullanıcı</th><th>Şifre</th><th>Durum</th><th>İşlem</th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="7" class="muted">Tarife grubu tanımlı değil.</td></tr>
        }
        @foreach (var g in _list)
        {
            <tr>
                <td class="mono">@g.Kod</td>
                <td>@g.Ad</td>
                <td class="num">@g.Oran.ToString("N4")</td>
                <td>@(g.KullaniciAdi ?? "—")</td>
                @* Şifre GERİ OKUNAMAZ (tek yönlü özet) — yalnız tanımlı olup olmadığı gösterilir. *@
                <td>@(string.IsNullOrEmpty(g.SifreHash) ? "—" : "tanımlı")</td>
                <td>@(g.Aktif ? "Aktif" : "Pasif")</td>
                <td>
                    <details>
                        <summary class="link">Düzenle</summary>
                        <form method="post" action="/tarife-gruplari/update" class="grid-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@g.Id" />
                            <label>Kod<input name="kod" maxlength="32" value="@g.Kod" required /></label>
                            <label>Ad<input name="ad" maxlength="128" value="@g.Ad" required /></label>
                            <label>Oran<input name="oran" type="number" step="0.0001" min="0" value="@g.Oran" /></label>
                            <label>Kullanıcı Adı<input name="kullaniciAdi" maxlength="128" value="@g.KullaniciAdi" autocomplete="off" /></label>
                            <label>Yeni Şifre<input name="sifre" type="password" minlength="6" autocomplete="new-password" placeholder="boş = değiştirme" /></label>
                            <label>Durum
                                <select name="aktif">
                                    <option value="true" selected="@g.Aktif">Aktif</option>
                                    <option value="false" selected="@(!g.Aktif)">Pasif</option>
                                </select>
                            </label>
                            <button type="submit">Kaydet</button>
                        </form>
                    </details>
                    <form method="post" action="/tarife-gruplari/delete" data-confirm="Tarife grubu silinsin mi? Bağlı tarife satırlarının bağı kopar (satırlar silinmez)."><AntiforgeryToken />
                        <input type="hidden" name="id" value="@g.Id" />
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private IReadOnlyList<TarifeGrubu> _list = [];

    protected override async Task OnInitializedAsync() => _list = await TarifeGruplari.ListAsync();
}
