@page "/bildirimler"
@attribute [Authorize]
@using RentACar.Application.Notifications
@using RentACar.Domain.Entities
@using RentACar.Domain.Enums
@inject InAppNotificationService Bildirimler

<PageTitle>Bildirim Merkezi — RentPro</PageTitle>

<div class="page-head"><h1>Bildirim Merkezi</h1><div class="actions"></div></div>
@if (Ok == "1") { <p class="ok">İşaretlendi.</p> }

<h2>Bildirimler @if (_okunmamisSayi > 0) {<span class="badge-unread">@_okunmamisSayi</span>}</h2>
<p class="muted small">Yaklaşan/geçmiş vade uyarıları (scheduler otomatik üretir). Okundu işaretleyebilirsiniz.</p>
@if (_bildirimler.Count == 0)
{
    <p class="muted">Bildirim yok.</p>
}
else
{
    @if (_okunmamisSayi > 0)
    {
        <form method="post" action="/bildirim/hepsini-oku" style="margin-bottom:.5rem"><AntiforgeryToken />
            <button type="submit" class="btn-primary">Tümünü okundu işaretle</button>
        </form>
    }
    <div class="table-scroll">
    <table class="grid tr-grid">
        <thead><tr><th>Tür</th><th>Mesaj</th><th>Oluşturma</th><th>Durum</th><th></th></tr></thead>
        <tbody>
            @foreach (var b in _bildirimler)
            {
                <tr class="@(b.Okundu ? "" : "row-unread")">
                    <td>@b.Tur</td>
                    <td>@b.Mesaj</td>
                    <td>@b.OlusturmaTarihi.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@(b.Okundu ? "Okundu" : "Yeni")</td>
                    <td>
                        @if (!b.Okundu)
                        {
                            <form method="post" action="/bildirim/oku" style="display:inline"><AntiforgeryToken />
                                <input type="hidden" name="id" value="@b.Id" />
                                <button type="submit">Okundu</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

<div class="cards">
    <div class="card">
        <div class="card-num">@_d.VadeGecmis</div>
        <div class="card-label">Geçmiş Vade</div>
    </div>
    <div class="card">
        <div class="card-num">@_d.VadeYakin</div>
        <div class="card-label">Yaklaşan Vade (≤30 gün)</div>
    </div>
    <div class="card">
        <div class="card-num">@_d.AcikSikayet</div>
        <div class="card-label">Açık Şikayet</div>
    </div>
    <div class="card">
        <div class="card-num">@(_d.DonemKapanis is null ? "Açık" : _d.DonemKapanis.Value.ToString("yyyy-MM-dd"))</div>
        <div class="card-label">Dönem Kapanış</div>
    </div>
</div>

<h2>Vade Uyarıları</h2>
@if (_d.Vadeler.Count == 0)
{
    <p class="muted">Yaklaşan/geçmiş vade yok.</p>
}
else
{
    <div class="table-scroll">
    <table class="grid tr-grid">
        <thead><tr><th>Tür</th><th>Bitiş</th><th class="num">Kalan Gün</th><th>Durum</th></tr></thead>
        <tbody>
            @foreach (var v in _d.Vadeler)
            {
                <tr>
                    <td>@v.Tur</td>
                    <td>@v.Bitis.ToString("yyyy-MM-dd")</td>
                    <td class="num">@v.KalanGun</td>
                    <td>@(v.Bucket == DueBucket.Gecmis ? "Geçmiş" : "Yaklaşan")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

<h2>Açık Şikayetler</h2>
@if (_d.Sikayetler.Count == 0)
{
    <p class="muted">Açık şikayet yok.</p>
}
else
{
    <div class="table-scroll">
    <table class="grid tr-grid">
        <thead><tr><th>Konu</th><th>Tarih</th></tr></thead>
        <tbody>
            @foreach (var s in _d.Sikayetler)
            {
                <tr><td>@s.Konu</td><td>@s.Tarih.ToString("yyyy-MM-dd")</td></tr>
            }
        </tbody>
    </table>
    </div>
    <p><a href="/sikayetler">Şikayetler →</a></p>
}

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }

    private BildirimDto _d = new(0, 0, [], 0, [], null);
    private IReadOnlyList<Bildirim> _bildirimler = [];
    private int _okunmamisSayi;

    protected override async Task OnInitializedAsync()
    {
        _d = await Bildirimler.GetAsync();
        _bildirimler = await Bildirimler.ListPersistedAsync();
        _okunmamisSayi = _bildirimler.Count(b => !b.Okundu);
    }
}
