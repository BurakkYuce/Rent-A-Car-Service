@page "/mesaj-sablonlari"
@attribute [Authorize(Policy = "izin:ManageUsers")]
@using RentACar.Application.Notifications
@using RentACar.Domain.Enums
@inject CustomerNotificationService Bildirim

<PageTitle>Mesaj Şablonları — RentPro</PageTitle>

<div class="page-head"><h1>Müşteri Mesaj Şablonları</h1><div class="actions"></div></div>
<p class="muted small">
    Müşteriye giden e-posta ve SMS metinleri. <strong>Şablon yazılmadan mesaj gönderilmez</strong> —
    firmanız adına giden bir metni siz görmeden yollamayız. Şablonu sonradan yazarsanız, o ana kadar
    kuyrukta bekleyen mesajlar ilk taramada doğru içerikle gönderilir.
</p>
<p class="muted small">
    Kullanabileceğiniz yer tutucular:
    @foreach (var a in TemplateFiller.Keys)
    {
        <code class="chip-kod">@("{" + a + "}")</code>
    }
    <br />Tanımadığımız bir yer tutucu metinde <em>olduğu gibi</em> kalır — yazım hatasını görebilirsiniz.
    E-posta gövdesine HTML yazabilirsiniz; müşteri adı gibi <em>değerler</em> otomatik kaçırılır.
</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}
@if (Ok)
{
    <p class="ok">Kaydedildi.</p>
}

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Olay</th><th>Kanal</th><th>Konu</th><th>Durum</th><th>İşlem</th></tr></thead>
    <tbody>
        @foreach (var tur in Turler)
        {
            @foreach (var kanal in Kanallar)
            {
                var mevcut = _sablonlar.FirstOrDefault(x => x.Tur == tur && x.Kanal == kanal);
                <tr>
                    <td>@Aciklama(tur)</td>
                    <td>@(kanal == MessageChannel.Eposta ? "E-posta" : "SMS")</td>
                    <td>@(mevcut?.Konu ?? "—")</td>
                    <td>
                        @if (mevcut is null)
                        {
                            <span class="muted">tanımlı değil</span>
                        }
                        else
                        {
                            <span>@(mevcut.Aktif ? "Aktif" : "Kapalı")</span>
                        }
                    </td>
                    <td>
                        <details>
                            <summary class="link">@(mevcut is null ? "Tanımla" : "Düzenle")</summary>
                            <form method="post" action="/mesaj-sablonlari/kaydet" class="grid-form"><AntiforgeryToken />
                                <input type="hidden" name="tur" value="@tur" />
                                <input type="hidden" name="kanal" value="@kanal" />
                                @if (kanal == MessageChannel.Eposta)
                                {
                                    <label class="u-col-full">Konu
                                        <input name="konu" value="@mevcut?.Konu" required
                                               placeholder="@KonuOnerisi(tur)" />
                                    </label>
                                }
                                <label class="u-col-full">Gövde
                                    <textarea name="govde" rows="@(kanal == MessageChannel.Eposta ? 8 : 4)" required
                                              placeholder="@GovdeOnerisi(tur, kanal)">@mevcut?.Govde</textarea>
                                </label>
                                <label class="kf-inline">
                                    <input type="checkbox" name="aktif" value="true"
                                           checked="@(mevcut is null || mevcut.Aktif)" /> Aktif
                                </label>
                                <button type="submit">Kaydet</button>
                            </form>
                        </details>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public bool Ok { get; set; }

    private IReadOnlyList<MesajSablonRow> _sablonlar = [];

    private static readonly MessageType[] Turler = Enum.GetValues<MessageType>();
    private static readonly MessageChannel[] Kanallar = Enum.GetValues<MessageChannel>();

    protected override async Task OnInitializedAsync() => _sablonlar = await Bildirim.ListTemplatesAsync();

    private static string Aciklama(MessageType t) => t switch
    {
        MessageType.TalepAlindi => "Web sitesinden talep alındı",
        MessageType.RezervasyonOnay => "Rezervasyon oluşturuldu",
        MessageType.RezervasyonIptal => "Rezervasyon iptal edildi",
        MessageType.TeslimHatirlatma => "Yarın araç teslim edilecek",
        MessageType.IadeHatirlatma => "Bugün araç iade edilecek",
        MessageType.OdemeHatirlatma => "Ödeme vadesi hatırlatması",
        _ => t.ToString(),
    };

    private static string KonuOnerisi(MessageType t) => t switch
    {
        MessageType.TalepAlindi => "Talebiniz alındı — {Firma}",
        MessageType.RezervasyonOnay => "Rezervasyonunuz onaylandı ({No})",
        MessageType.RezervasyonIptal => "Rezervasyonunuz iptal edildi ({No})",
        MessageType.TeslimHatirlatma => "Yarın aracınızı teslim alıyorsunuz",
        MessageType.IadeHatirlatma => "Aracınızın iade günü bugün",
        MessageType.OdemeHatirlatma => "Ödeme hatırlatması",
        _ => "",
    };

    private static string GovdeOnerisi(MessageType t, MessageChannel k)
    {
        if (k == MessageChannel.Sms)
            return t switch
            {
                MessageType.TeslimHatirlatma => "Sayin {MusteriAd}, {CikisTarih} tarihinde {Plaka} plakali aracinizi teslim alacaksiniz.",
                MessageType.IadeHatirlatma => "Sayin {MusteriAd}, {Plaka} plakali aracin iade saati {DonusTarih}.",
                _ => "Sayin {MusteriAd}, ...",
            };

        return t switch
        {
            MessageType.TalepAlindi =>
                "<p>Sayın {MusteriAd},</p><p>{CikisTarih} — {DonusTarih} tarihleri için talebinizi aldık. "
                + "En kısa sürede size dönüş yapacağız.</p><p>Talep no: {No}</p>",
            MessageType.TeslimHatirlatma =>
                "<p>Sayın {MusteriAd},</p><p>{CikisTarih} tarihinde {Arac} ({Plaka}) aracınızı teslim alacaksınız.</p>",
            MessageType.IadeHatirlatma =>
                "<p>Sayın {MusteriAd},</p><p>{Plaka} plakalı aracınızın iade saati {DonusTarih}.</p>",
            _ => "<p>Sayın {MusteriAd},</p><p>...</p>",
        };
    }
}
