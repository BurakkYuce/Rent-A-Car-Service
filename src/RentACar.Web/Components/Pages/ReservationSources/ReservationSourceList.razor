@page "/rezervasyon-kaynaklari"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@inject ReservationSourceService RezKaynaklari

<PageTitle>Rezervasyon Kaynakları — RentPro</PageTitle>

<div class="page-head"><h1>Rezervasyon Kaynağı Tanımları</h1><div class="actions"></div></div>
<p class="muted small">Rezervasyon/müşteri kaynaklarının sözlüğü (ör. "Web", "Telefon", "Bayi",
    "Tavsiye"). Rezervasyon ve cari formlarındaki Kaynak açılır listesini besler.</p>
@* Kapsam çiti KULLANICIYA da yazılı: alan "not" sanılıp doldurulduğunda faturanın değişmediğini
   burada söylemek, sonradan "neden komisyon çıkmadı" sorusunu baştan cevaplar. *@
<p class="muted small"><strong>Tedarikçi oranları (Kira / Hizmet / Drop) yüzdedir</strong>
    (12,5 = %12,5) ve şu an <strong>yalnız bilgi olarak saklanır</strong> — hiçbir fiyat, komisyon
    veya karlılık hesabı bu alanları okumaz. Hesaba nasıl gireceği ayrı bir çalışmadır.</p>
@* FAZ-49: kullanıcı hangi alanın DAVRANIŞ değiştirdiğini, hangisinin yalnız not olduğunu
   ekranda görmeli — "komisyonu %10 yazdım ama faturada çıkmadı" sorusunun cevabı burada. *@
<p class="muted small"><strong>Kural matrisi:</strong> yalnız <em>Uzatma yasak</em>,
    <em>Rez. tarihleri değişemez</em>, <em>Provizyon alınmaz</em>, <em>KM sınırsız</em>,
    <em>Drop kapalı</em> ve <em>En fazla gün</em> alanları rezervasyon/kira akışında
    <strong>gerçekten uygulanır</strong>. Diğer tüm işaret, tutar ve oran alanları
    (komisyon / ön ödeme / indirim / puan / ek hizmet tutarları) <strong>bilgi amaçlıdır</strong>:
    fiyat motoruna, faturaya ve muhasebe defterine girmez.</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_list.Count == 0)">
    <summary>+ Yeni Kaynak</summary>
    <form method="post" action="/rezervasyon-kaynaklari/create" class="grid-form"><AntiforgeryToken />
        <label>Kod<input name="kod" required placeholder="WEB" /></label>
        <label>Ad<input name="ad" required placeholder="Web Sitesi" /></label>
        <label>Tedarikçi<input name="tedarikci" placeholder="Rentalcars" maxlength="128" /></label>
        <label>Kira Oranı %<input name="kiraOrani" type="number" step="0.01" min="0" max="100" /></label>
        <label>Hizmet Oranı %<input name="hizmetOrani" type="number" step="0.01" min="0" max="100" /></label>
        <label>Drop Oranı %<input name="dropOrani" type="number" step="0.01" min="0" max="100" /></label>
        @KuralAlanlari(null)
        <button type="submit">Oluştur</button>
    </form>
</details>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Kod</th><th>Ad</th><th>Grup</th><th>Tedarikçi</th><th class="num">Kira %</th>
        <th class="num">Hizmet %</th><th class="num">Drop %</th><th class="num">Komisyon %</th>
        <th>Uygulanan Kurallar</th><th>Durum</th><th>İşlem</th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="11" class="muted">Rezervasyon kaynağı tanımlı değil.</td></tr>
        }
        @foreach (var s in _list)
        {
            <tr>
                <td class="mono">@s.Kod</td>
                <td>@s.Ad</td>
                <td>@(s.KaynakGrubu?.ToString() ?? "—")</td>
                <td>@(s.Tedarikci ?? "—")</td>
                <td class="num">@Yuzde(s.KiraOrani)</td>
                <td class="num">@Yuzde(s.HizmetOrani)</td>
                <td class="num">@Yuzde(s.DropOrani)</td>
                <td class="num">@Yuzde(s.KomisyonOrani)</td>
                @* Yalnız GERÇEKTEN uygulanan kurallar listelenir — bilgi işaretleri buraya girmez,
                   yoksa kolon "bu kaynak şunu yapar" diye yanlış vaat ederdi. *@
                <td class="small">@Kurallar(s)</td>
                <td>@(s.Aktif ? "Aktif" : "Pasif")</td>
                <td>
                    <details>
                        <summary class="link">Düzenle</summary>
                        <form method="post" action="/rezervasyon-kaynaklari/update" class="grid-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@s.Id" />
                            <label>Kod<input name="kod" value="@s.Kod" required /></label>
                            <label>Ad<input name="ad" value="@s.Ad" required /></label>
                            <label>Tedarikçi<input name="tedarikci" value="@s.Tedarikci" maxlength="128" /></label>
                            @* Değerler InvariantCulture: tr-TR "12,50" basıldığında type=number alanı
                               boşaltıp kaydetmede oranı SİLERDİ (FAZ-22 H1 dersi). *@
                            <label>Kira Oranı %<input name="kiraOrani" type="number" step="0.01" min="0" max="100" value="@Inv(s.KiraOrani)" /></label>
                            <label>Hizmet Oranı %<input name="hizmetOrani" type="number" step="0.01" min="0" max="100" value="@Inv(s.HizmetOrani)" /></label>
                            <label>Drop Oranı %<input name="dropOrani" type="number" step="0.01" min="0" max="100" value="@Inv(s.DropOrani)" /></label>
                            <label>Durum
                                <select name="aktif">
                                    <option value="true" selected="@s.Aktif">Aktif</option>
                                    <option value="false" selected="@(!s.Aktif)">Pasif</option>
                                </select>
                            </label>
                            @KuralAlanlari(s)
                            <button type="submit">Kaydet</button>
                        </form>
                    </details>
                    @* Aşağıya Yansıt: bu kaynağın 3 oranını diğer AKTİF kaynaklara kopyalar.
                       Pasifler bilinçli dışarıda (tarihsel tanım diriltilmemeli), kayıtlı
                       belgeler DEĞİŞMEZ. *@
                    <form method="post" action="/rezervasyon-kaynaklari/yansit"
                          data-confirm="Bu kaynağın oranları diğer AKTİF kaynaklara kopyalansın mı? (Kayıtlı rezervasyon/fatura değişmez)"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@s.Id" />
                        <button type="submit" class="link" title="Oranları diğer aktif kaynaklara kopyalar — başka hiçbir tabloya yazmaz">Aşağıya Yansıt</button>
                    </form>
                    <form method="post" action="/rezervasyon-kaynaklari/delete" data-confirm="Kaynak silinsin mi?"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@s.Id" />
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private IReadOnlyList<ReservationSource> _list = [];

    private static string Yuzde(decimal? o) => o is { } v ? v.ToString("N2") : "—";

    /// <summary>type=number değeri INVARIANT olmalı (tr-TR virgüllü değer alanı boşaltır).</summary>
    private static string? Inv(decimal? v) => v?.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private static string? Inv(int? v) => v?.ToString(System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>Listede yalnız DAVRANIŞ değiştiren bayraklar özetlenir (FAZ-49).</summary>
    private static string Kurallar(ReservationSource s)
    {
        var k = new List<string>();
        if (s.Uzatamaz) k.Add("Uzatma yasak");
        if (s.RezTarihleriDegisemez) k.Add("Tarih kilitli");
        if (s.ProvizyonYok) k.Add("Provizyon yok");
        if (s.KmSinirsiz) k.Add("KM sınırsız");
        if (s.AyniYonDrop) k.Add("Drop kapalı");
        if (s.MaxGun is > 0) k.Add($"En fazla {s.MaxGun} gün");
        return k.Count == 0 ? "—" : string.Join(" · ", k);
    }

    /// <summary>
    /// FAZ-49 alanları — create ve edit formunda AYNI şablon (iki kopya tutmak, birine eklenen
    /// alanın diğerinde sessizce düşmesi demekti). <c>s == null</c> → yeni kayıt (boş değerler).
    /// Sayısal değerler InvariantCulture ile basılır: tr-TR "12,50" type=number alanını boşaltıp
    /// kaydetmede değeri SİLERDİ (FAZ-22 H1 dersi).
    /// </summary>
    private RenderFragment<ReservationSource?> KuralAlanlari => s => @<text>
        <fieldset class="rc-kural">
            <legend>Uygulanan kurallar — bu alanlar davranışı DEĞİŞTİRİR</legend>
            <label class="chk"><input type="checkbox" name="uzatamaz" value="true" checked="@(s?.Uzatamaz == true)" /> Uzatma yasak (sözleşme uzatılamaz)</label>
            <label class="chk"><input type="checkbox" name="rezTarihleriDegisemez" value="true" checked="@(s?.RezTarihleriDegisemez == true)" /> Rez. tarihleri değişemez</label>
            <label class="chk"><input type="checkbox" name="provizyonYok" value="true" checked="@(s?.ProvizyonYok == true)" /> Provizyon alınmaz</label>
            <label class="chk"><input type="checkbox" name="kmSinirsiz" value="true" checked="@(s?.KmSinirsiz == true)" /> KM sınırsız (KM limiti 0'a sabitlenir)</label>
            <label class="chk"><input type="checkbox" name="ayniYonDrop" value="true" checked="@(s?.AyniYonDrop == true)" /> Drop kapalı (dönüş ofisi = çıkış ofisi)</label>
            <label>En fazla gün (boş = sınırsız)<input name="maxGun" type="number" step="1" min="1" max="3650" value="@Inv(s?.MaxGun)" /></label>
        </fieldset>

        <fieldset class="rc-bilgi">
            <legend>Bilgi alanları — hiçbir fiyat/fatura/defter hesabına girmez</legend>
            <label>Kaynak grubu
                <select name="kaynakGrubu">
                    <option value="" selected="@(s?.KaynakGrubu is null)">— belirtilmemiş —</option>
                    @foreach (var g in Enum.GetValues<ReservationSourceGroup>())
                    {
                        <option value="@g" selected="@(s?.KaynakGrubu == g)">@g</option>
                    }
                </select>
            </label>
            <label>Komisyon Oranı %<input name="komisyonOrani" type="number" step="0.01" min="0" max="100" value="@Inv(s?.KomisyonOrani)" /></label>
            <label>Ön Ödeme Oranı %<input name="onOdemeOrani" type="number" step="0.01" min="0" max="100" value="@Inv(s?.OnOdemeOrani)" /></label>
            <label>İndirim Oranı %<input name="indirimOrani" type="number" step="0.01" min="0" max="100" value="@Inv(s?.IndirimOrani)" /></label>
            <label>Puan Oranı %<input name="puanOrani" type="number" step="0.01" min="0" max="100" value="@Inv(s?.PuanOrani)" /></label>

            <label>Bebek Koltuğu<input name="bebekKoltugu" type="number" step="0.01" min="0" value="@Inv(s?.BebekKoltugu)" /></label>
            <label>Navigasyon<input name="navigasyon" type="number" step="0.01" min="0" value="@Inv(s?.Navigasyon)" /></label>
            <label>Ek Sürücü<input name="ekSurucu" type="number" step="0.01" min="0" value="@Inv(s?.EkSurucu)" /></label>
            <label>Wifi<input name="wifi" type="number" step="0.01" min="0" value="@Inv(s?.Wifi)" /></label>

            <label>Sigorta Kaynak No<input name="sigortaKaynakNo" maxlength="64" value="@s?.SigortaKaynakNo" /></label>
            <label>Drop Kaynak No<input name="dropKaynakNo" maxlength="64" value="@s?.DropKaynakNo" /></label>
            <label>Provizyon Seçeneği<input name="provizyonSecenek" maxlength="64" value="@s?.ProvizyonSecenek" /></label>
            <label>Muafiyet Seçeneği<input name="muafiyatSecenek" maxlength="64" value="@s?.MuafiyatSecenek" /></label>
            <label>Mail Adresi<input name="mailAdres" type="email" maxlength="256" value="@s?.MailAdres" /></label>

            <label class="chk"><input type="checkbox" name="scdwDahil" value="true" checked="@(s?.ScdwDahil == true)" /> SCDW dahil</label>
            <label class="chk"><input type="checkbox" name="cdwDahil" value="true" checked="@(s?.CdwDahil == true)" /> CDW dahil</label>
            <label class="chk"><input type="checkbox" name="lcfDahil" value="true" checked="@(s?.LcfDahil == true)" /> LCF dahil</label>
            <label class="chk"><input type="checkbox" name="paiDahil" value="true" checked="@(s?.PaiDahil == true)" /> PAI dahil</label>
            <label class="chk"><input type="checkbox" name="maliyetYansitma" value="true" checked="@(s?.MaliyetYansitma == true)" /> Maliyet yansıtma</label>
            <label class="chk"><input type="checkbox" name="matrisErken" value="true" checked="@(s?.MatrisErken == true)" /> Matris: erken dönüş</label>
            <label class="chk"><input type="checkbox" name="matrisGecikme" value="true" checked="@(s?.MatrisGecikme == true)" /> Matris: gecikme</label>
            <label class="chk"><input type="checkbox" name="matrisIptal" value="true" checked="@(s?.MatrisIptal == true)" /> Matris: iptal</label>
            <label class="chk"><input type="checkbox" name="matrisNoShow" value="true" checked="@(s?.MatrisNoShow == true)" /> Matris: no-show</label>
            <label class="chk"><input type="checkbox" name="matrisUzatma" value="true" checked="@(s?.MatrisUzatma == true)" /> Matris: uzatma</label>
            <label class="chk"><input type="checkbox" name="otomatikMailGitme" value="true" checked="@(s?.OtomatikMailGitme == true)" /> Otomatik mail gitsin (gönderim entegrasyonu yok)</label>
            <label class="chk"><input type="checkbox" name="riskAnalizYapma" value="true" checked="@(s?.RiskAnalizYapma == true)" /> Risk analizi yapılmasın (mevcut risk kontrolünü GEVŞETMEZ)</label>
            <label class="chk"><input type="checkbox" name="subeGor" value="true" checked="@(s?.SubeGor == true)" /> Şube görsün (şube kapsamını DEĞİŞTİRMEZ)</label>
            <label class="chk"><input type="checkbox" name="acenteFiyatDegistir" value="true" checked="@(s?.AcenteFiyatDegistir == true)" /> Acente fiyat değiştirebilir</label>
            <label class="chk"><input type="checkbox" name="gizle" value="true" checked="@(s?.Gizle == true)" /> Listelerde gizle</label>
            <label class="chk"><input type="checkbox" name="sadeceMusteriOdeme" value="true" checked="@(s?.SadeceMusteriOdeme == true)" /> Yalnız müşteri ödemesi</label>
        </fieldset>
    </text>;

    protected override async Task OnInitializedAsync()
        => _list = await RezKaynaklari.ListAsync();
}
