@page "/personel"
@attribute [Authorize(Policy = "izin:ManageUsers")]
@inject PersonelService Personel
@inject BranchService Subeler
@inject NavigationManager Nav

<PageTitle>Personel — RentPro</PageTitle>

<div class="page-head"><h1>Personel</h1><div class="actions"><a href="/listeler/export-personel">Excel</a> · <a href="/listeler/export-personel?format=csv">CSV</a> · <a href="/listeler/export-personel?format=pdf">PDF</a></div></div>
<p class="muted small">TC Kimlik ve Maaş <strong>şifreli</strong> saklanır (yalnız Admin görür). Düzenlemede
    bu alanları boş bırakırsanız mevcut değer korunur.</p>
@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<form method="get" class="filter-bar">
    <label>Ara<input name="ara" value="@Ara" placeholder="sicil / ad / soyad / cep / mail" /></label>
    <label>Şube
        <select name="subeF">
            <option value="">— tümü —</option>
            @foreach (var o in _subeOpts) { <option value="@o" selected="@(o == SubeF)">@o</option> }
        </select>
    </label>
    <label>Görev
        <select name="gorev">
            <option value="">— tümü —</option>
            @foreach (var o in _gorevOpts) { <option value="@o" selected="@(o == Gorev)">@o</option> }
        </select>
    </label>
    <label>Durum
        <select name="durum">
            <option value="">— tümü —</option>
            <option value="true" selected="@(Durum == "true")">Aktif</option>
            <option value="false" selected="@(Durum == "false")">Pasif</option>
        </select>
    </label>
    <button type="submit">Filtrele</button>
    @if (FiltreVar) { <a class="link" href="/personel">Temizle</a> }
</form>

<p class="muted small">@_list.Count personel@(FiltreVar ? " (filtreli)" : "")</p>

<div class="table-scroll">
@* kart-mobil: 640px altında satırlar karta döner. Kartta kimliği taşıyan alanlar kaldı
   (sicil + ad soyad + görev + şube + cep + durum); mail, sürücü belgesi, tablet no ve işe
   giriş masaüstünde kalıyor — telefonda listeden doğru kişiyi seçmek için gerekmiyorlar. *@
<table class="grid tr-grid kart-mobil">
    <thead><tr><th>Sicil</th><th>Ad Soyad</th><th>Görev</th><th>Şube</th><th>Cep Tel</th><th>Mail</th><th>Sür. Belge</th><th>Rac Tablet</th><th>İşe Giriş</th><th>Durum</th><th></th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="11" class="muted">@(FiltreVar ? "Filtreye uyan personel yok." : "Kayıt yok.")</td></tr>
        }
        @foreach (var p in _list)
        {
            <tr>
                <td class="mono" data-etiket="Sicil">@p.Kod</td>
                <td class="kart-baslik">@p.Ad @p.Soyad</td>
                <td data-etiket="Görev">@(p.GorevTanimi ?? "—")</td>
                <td data-etiket="Şube">@p.Sube</td>
                <td data-etiket="Cep Tel">@(p.CepTel ?? "—")</td>
                <td>@(p.MailAdresi ?? "—")</td>
                <td>@(p.SurucuBelgeNo ?? "—")</td>
                <td>@(p.RacTabletNo ?? "—")</td>
                <td>@(p.IseGiris?.ToString("yyyy-MM-dd"))</td>
                <td data-etiket="Durum">@(p.Aktif ? "Aktif" : "Pasif")</td>
                <td class="kart-aksiyon"><a href="/personel?duzenle=@p.Id">Düzenle</a></td>
            </tr>
        }
    </tbody>
</table>
</div>

<h2>@(_edit is null ? "Yeni Personel" : $"Düzenle: {_edit.Kod}")</h2>
<form method="post" action="@(_edit is null ? "/personel/create" : "/personel/update")" class="grid-form"><AntiforgeryToken />
    @if (_edit is not null)
    {
        <input type="hidden" name="id" value="@_edit.Id" />
    }
    <label>Sicil<input name="kod" value="@_edit?.Kod" required /></label>
    <label>Ad<input name="ad" value="@_edit?.Ad" required /></label>
    <label>Soyad<input name="soyad" value="@_edit?.Soyad" required /></label>
    <label>TC Kimlik<input name="tcKimlik" value="@_edit?.TcKimlik" placeholder="@(_edit is not null ? "(boş = değişmez)" : "")" /></label>
    <label>Sürücü Belge No<input name="surucuBelgeNo" value="@_edit?.SurucuBelgeNo" /></label>
    <label>Maaş<input name="maas" type="number" step="0.01" min="0" value="@_edit?.Maas" /></label>
    <label>İşe Giriş<input name="iseGiris" type="date" value="@(_edit?.IseGiris?.ToString("yyyy-MM-dd"))" /></label>
    <label>İşten Çıkış<input name="iseCikis" type="date" value="@(_edit?.IseCikis?.ToString("yyyy-MM-dd"))" /></label>
    <ComboBox Name="sube" Label="Şube" Options="_subeOpts" Value="@_edit?.Sube" />
    @* GÖREV TANIMI serbest metindir ve YETKİ VERMEZ — sistem rolü kullanıcı hesabından gelir.
       İkisini karıştırmak sessiz bir yetki yükseltme beklentisi yaratırdı. *@
    <ComboBox Name="gorevTanimi" Label="Görev Tanımı" Options="GorevOnerileri" Value="@H?.GorevTanimi" ListId="dl-gorev" />
    <label>Cep Tel<input name="cepTel" value="@H?.CepTel" maxlength="32" /></label>
    <label>Mail<input name="mailAdresi" type="email" value="@H?.MailAdresi" maxlength="128" /></label>
    <label>Ev Telefonu<input name="evTelefonu" value="@H?.EvTelefonu" maxlength="32" /></label>
    <label>İş Telefonu<input name="isTelefonu" value="@H?.IsTelefonu" maxlength="32" /></label>
    <label>Rac Tablet No<input name="racTabletNo" value="@H?.RacTabletNo" maxlength="32" /></label>
    <label>Kan Grubu<input name="kanGrubu" value="@H?.KanGrubu" maxlength="8" /></label>
    <label>Sür. Belge Sınıfı<input name="sSinifi" value="@H?.SSinifi" maxlength="16" placeholder="B" /></label>
    <label>Belge Veriliş Tarihi<input name="sVerilisTarihi" type="date" value="@(H?.SVerilisTarihi?.ToString("yyyy-MM-dd"))" /></label>
    <label>Belge Veriliş Yeri<input name="sVerilisYeri" value="@H?.SVerilisYeri" maxlength="128" /></label>
    <label>Doğum Tarihi<input name="dogumTarihi" type="date" value="@(H?.DogumTarihi?.ToString("yyyy-MM-dd"))" /></label>
    <label>Doğum Yeri<input name="dogumYeri" value="@H?.DogumYeri" maxlength="128" /></label>
    <label>Baba Adı<input name="babaAdi" value="@H?.BabaAdi" maxlength="128" /></label>
    <label>Ana Adı<input name="anaAdi" value="@H?.AnaAdi" maxlength="128" /></label>
    <label>İl<input name="il" value="@H?.Il" maxlength="64" /></label>
    <label>İlçe<input name="ilce" value="@H?.Ilce" maxlength="64" /></label>
    <label>Mahalle<input name="mahalle" value="@H?.Mahalle" maxlength="128" /></label>
    <label>Cilt No<input name="ciltNo" value="@H?.CiltNo" maxlength="32" /></label>
    <label>Aile Sıra No<input name="aileSiraNo" value="@H?.AileSiraNo" maxlength="32" /></label>
    <label>Sıra No<input name="siraNo" value="@H?.SiraNo" maxlength="32" /></label>
    <label>Referans<input name="referans" value="@H?.Referans" maxlength="256" /></label>
    <label class="u-col-full">Adres<input name="adres" value="@H?.Adres" maxlength="512" /></label>
    <label class="u-col-full">Açıklama<input name="aciklama" value="@H?.Aciklama" maxlength="1024" /></label>
    <label>Aktif<input name="aktif" type="checkbox" value="true" checked="@(_edit?.Aktif ?? true)" /></label>
    <button type="submit">@(_edit is null ? "Ekle" : "Kaydet")</button>
    @if (_edit is not null)
    {
        <a href="/personel" class="btn-secondary">İptal</a>
    }
</form>

@if (_edit is not null)
{
    <form method="post" action="/personel/delete" data-confirm="Personel silinsin mi?"><AntiforgeryToken />
        <input type="hidden" name="id" value="@_edit.Id" />
        <button type="submit" class="btn-danger">Sil</button>
    </form>
}

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "duzenle")] public Guid? Duzenle { get; set; }
    [SupplyParameterFromQuery(Name = "ara")] public string? Ara { get; set; }
    [SupplyParameterFromQuery(Name = "subeF")] public string? SubeF { get; set; }
    [SupplyParameterFromQuery(Name = "gorev")] public string? Gorev { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }

    private IReadOnlyList<RentACar.Domain.Entities.Personel> _list = [];
    private PersonelDetail? _edit;
    private List<string> _subeOpts = [];
    private List<string> _gorevOpts = [];

    /// <summary>Düzenlenen kaydın ham entity'si — 23 derinlik alanı buradan okunur.</summary>
    private RentACar.Domain.Entities.Personel? H => _edit?.Ham;

    private static readonly List<string> GorevOnerileri =
        ["İç Ekip", "Yönetici", "Operasyon", "Şoför", "Muhasebe", "Satış"];

    private bool FiltreVar => !string.IsNullOrWhiteSpace(Ara) || !string.IsNullOrWhiteSpace(SubeF)
        || !string.IsNullOrWhiteSpace(Gorev) || !string.IsNullOrWhiteSpace(Durum);

    protected override async Task OnInitializedAsync()
    {
        _list = await Personel.SearchAsync(new PersonelFilter
        {
            Ara = Ara, Sube = SubeF, GorevTanimi = Gorev,
            Aktif = bool.TryParse(Durum, out var d) ? d : null
        });
        if (Duzenle is { } id) _edit = await Personel.GetDetailAsync(id);
        _subeOpts = (await Subeler.ListActiveAsync()).Select(s => s.Ad).ToList();

        // Görev seçenekleri FİLTRESİZ listeden (öneri listesi ∪ mevcut değerler) — filtrelenmişten
        // türetilseydi bir seçim sonrası diğer görevler kaybolur, filtre kendini kilitlerdi.
        _gorevOpts = GorevOnerileri
            .Concat((await Personel.ListAsync()).Select(p => p.GorevTanimi ?? ""))
            .Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x.Trim())
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .OrderBy(x => x, StringComparer.CurrentCulture).ToList();
    }
}
