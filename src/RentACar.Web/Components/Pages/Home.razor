@page "/"
@attribute [Authorize]
@inject VehicleService Vehicles
@inject CustomerService Customers
@inject RentalService Rentals
@inject ReservationService Reservations
@inject VadeService Vade
@inject DashboardService Dashboard
@inject RentACar.Application.Crm.SikayetService Sikayet

<PageTitle>Panel — TürevRent</PageTitle>

<div class="page-head">
    <h1>🏠 Panel</h1>
    <div class="actions">
        <a href="/vehicles">Araçlar</a>
        <a href="/rezervasyonlar">Rezervasyonlar</a>
        <a href="/kiralar">Kiralar</a>
    </div>
</div>

<div class="kpi-row">
    <div class="kpi k-purple">
        <div class="k-top"><span class="k-label">Kiradaki Araçlar</span><span class="k-ic">🤝</span></div>
        <div class="k-num">@_aktifKira</div>
        <div class="k-foot">Toplam @_counts.Total araçtan</div>
    </div>
    <div class="kpi k-green">
        <div class="k-top"><span class="k-label">Boştaki Araçlar</span><span class="k-ic">🚙</span></div>
        <div class="k-num">@_counts.Musait</div>
        <div class="k-foot">Kiraya hazır</div>
    </div>
    <div class="kpi k-red">
        <div class="k-top"><span class="k-label">Servisteki Araçlar</span><span class="k-ic">🔧</span></div>
        <div class="k-num">@_counts.Serviste</div>
        <div class="k-foot">Bakım / onarım</div>
    </div>
    <div class="kpi k-orange">
        <div class="k-top"><span class="k-label">Bugün Çıkış</span><span class="k-ic">⏱️</span></div>
        <div class="k-num">@_bugunCikis</div>
        <div class="k-foot">Planlı teslim</div>
    </div>
</div>

<div class="stat-row">
    <div class="stat"><span class="s-ic">🚗</span><div><div class="s-num">@_counts.Total</div><div class="s-label">Toplam Araç</div></div></div>
    <div class="stat"><span class="s-ic">👥</span><div><div class="s-num">@_cariCount</div><div class="s-label"><a href="/cariler">Cari</a></div></div></div>
    <div class="stat"><span class="s-ic">↩️</span><div><div class="s-num">@_bugunDonus</div><div class="s-label">Bugün Dönüş</div></div></div>
    <div class="stat"><span class="s-ic">📣</span><div><div class="s-num">@_acikSikayet</div><div class="s-label"><a href="/sikayetler">Açık Şikayet</a></div></div></div>
</div>

@if (_gecmis + _yakin > 0)
{
    <div class="vade-alert">
        ⚠️ <strong>Vade uyarısı:</strong>
        @if (_gecmis > 0) { <span class="badge danger">@_gecmis geçmiş</span> }
        @if (_yakin > 0) { <span class="badge warn">@_yakin yaklaşan (≤30 gün)</span> }
        <a href="/vade">Vade panosu →</a>
    </div>
}

@* Finans özeti (roadmap D3) — yalnız mali yetkili roller (kasa/banka/açık bakiye hassas). *@
<AuthorizeView Roles="Admin,Yonetici,Muhasebe" Context="finCtx">
    <h2>Finans Özeti</h2>
    <div class="stat-row">
        <div class="stat"><span class="s-ic">💵</span><div><div class="s-num">@_dash.KasaBakiye.ToString("N0")</div><div class="s-label">Kasa Bakiye</div></div></div>
        <div class="stat"><span class="s-ic">🏦</span><div><div class="s-num">@_dash.BankaBakiye.ToString("N0")</div><div class="s-label">Banka Bakiye</div></div></div>
        <div class="stat"><span class="s-ic">📄</span><div><div class="s-num">@_dash.AcikBakiye.ToString("N0")</div><div class="s-label">Açık Bakiye</div></div></div>
        <div class="stat"><span class="s-ic">💰</span><div><div class="s-num">@_dash.BugunTahsilatTutar.ToString("N0")</div><div class="s-label">Bugün Tahsilat (@_dash.BugunTahsilatAdet)</div></div></div>
    </div>
</AuthorizeView>

@code {
    private (int Total, int Musait, int Serviste) _counts;
    private int _cariCount;
    private int _aktifKira;
    private int _bugunCikis;
    private int _bugunDonus;
    private int _gecmis;
    private int _yakin;
    private int _acikSikayet;
    private DashboardDto _dash = new(0, 0, 0, 0, 0, 0, 0, 0m, 0m, 0m, 0m);

    protected override async Task OnInitializedAsync()
    {
        _dash = await Dashboard.GetAsync(DateTimeOffset.UtcNow);
        var list = await Vehicles.ListAsync();
        _counts = (
            list.Count,
            list.Count(v => v.Durum == VehicleStatus.Musait),
            list.Count(v => v.Durum == VehicleStatus.Serviste));
        _cariCount = (await Customers.ListAsync()).Count;

        var rentals = await Rentals.ListAsync();
        _aktifKira = rentals.Count(r => r.Durum == RentalStatus.Kirada);

        var bugun = DateTimeOffset.Now.Date;
        // Bugün dönüşü planlanan aktif kiralar (bitiş tarihi bugün).
        _bugunDonus = rentals.Count(r => r.Durum == RentalStatus.Kirada && r.BitTar.LocalDateTime.Date == bugun);
        // Bugün çıkışı planlanan rezervasyonlar (henüz iptal/kiraya çevrilmemiş, başlangıç bugün).
        var rezervler = await Reservations.ListAsync();
        _bugunCikis = rezervler.Count(r =>
            (r.Durum == ReservationStatus.Rezerv || r.Durum == ReservationStatus.Onayli)
            && r.BasTar.LocalDateTime.Date == bugun);

        var warnings = await Vade.GetWarningsAsync();
        _gecmis = warnings.Count(w => w.Bucket == VadeBucket.Gecmis);
        _yakin = warnings.Count(w => w.Bucket != VadeBucket.Gecmis);

        _acikSikayet = (await Sikayet.ListAsync()).Count(s => s.Durum == RentACar.Domain.Enums.SikayetDurum.Acik);
    }
}
