@page "/"
@attribute [Authorize]
@inject VehicleService Vehicles
@inject CustomerService Customers
@inject RentalService Rentals
@inject ReservationService Reservations
@inject VadeService Vade
@inject DashboardService Dashboard
@inject RentACar.Application.Reporting.ReportService Reports
@inject RentACar.Application.Crm.SikayetService Sikayet

<PageTitle>Panel — RentPro</PageTitle>
@* Statik SSR panosu: sayfa 120 sn'de bir otomatik yenilenir → boştaki araç/rezervasyon sayaçları güncel kalır. *@
<HeadContent><meta http-equiv="refresh" content="120" /></HeadContent>

<div class="page-head">
    <h1>Panel</h1>
    <div class="actions">
        <a href="/rezervasyonlar">+ Rezervasyon</a>
        <a href="/kiralar">+ Kira</a>
        <a href="/musaitlik">Müsaitlik</a>
    </div>
</div>

@* 4 KPI kartı + her birinin altında vade kademesi (TürevRent parite) *@
<div class="kpi-grid">
    <div class="kpi-cell">
        <div class="kpi k-purple">
            <div class="k-top"><span class="k-label">Kiradaki Araçlar</span><span class="k-ic"></span></div>
            <div class="k-num">@_fleet.Kirada</div>
            <div class="k-bar"><span style="width:@Yuzde(_fleet.Kirada)%"></span></div>
            <div class="k-foot">Toplamdan %@Yuzde(_fleet.Kirada)</div>
        </div>
        <VadeTier Label="Trafik Sigortaları" Tier="_trafik" Href="/vade" />
    </div>
    <div class="kpi-cell">
        <div class="kpi k-green">
            <div class="k-top"><span class="k-label">Boştaki Araçlar</span><span class="k-ic"></span></div>
            <div class="k-num">@_fleet.Musait</div>
            <div class="k-bar"><span style="width:@Yuzde(_fleet.Musait)%"></span></div>
            <div class="k-foot">Toplamdan %@Yuzde(_fleet.Musait)</div>
        </div>
        <VadeTier Label="Kaskolar" Tier="_kasko" Href="/vade" />
    </div>
    <div class="kpi-cell">
        <div class="kpi k-red">
            <div class="k-top"><span class="k-label">Servisteki Araçlar</span><span class="k-ic"></span></div>
            <div class="k-num">@_fleet.Serviste</div>
            <div class="k-bar"><span style="width:@Yuzde(_fleet.Serviste)%"></span></div>
            <div class="k-foot">Toplamdan %@Yuzde(_fleet.Serviste)</div>
        </div>
        <VadeTier Label="Muayeneler" Tier="_muayene" Href="/vade" />
    </div>
    <div class="kpi-cell">
        <div class="kpi k-orange">
            <div class="k-top"><span class="k-label">Açık Rezervasyonlar</span><span class="k-ic"></span></div>
            <div class="k-num">@_acikRezSayi</div>
            <div class="k-bar"><span style="width:@Yuzde(_acikRezSayi)%"></span></div>
            <div class="k-foot">Bekleyen rezervasyon</div>
        </div>
        <div class="vade-tier">
            <div class="vt-boxes">
                <a class="vt-box @(_kmGecenBakim > 0 ? "danger" : "")" href="/raporlar/periyodik-servis">
                    <span class="vt-n">@_kmGecenBakim</span>KM Geçen Bakım</a>
                <a class="vt-box @(_gorulmeyenRez > 0 ? "warn" : "")" href="/rezervasyonlar">
                    <span class="vt-n">@_gorulmeyenRez</span>Görülmeyen Rez.</a>
            </div>
        </div>
    </div>
</div>

@* Dönüşler / Çıkışlar — gün-filtreli (TürevRent parite) *@
<div class="donus-cikis">
    <div class="dc-panel">
        <div class="dc-head">
            <span class="dc-title">Dönüşler</span>
            <span class="dc-tabs">
                <a class="@(Df == "gec" ? "on" : "")" href="/?df=gec&cf=@Cf">Gecikmiş <b>@_donusGec.Count</b></a>
                <a class="@(Df is null or "bugun" ? "on" : "")" href="/?df=bugun&cf=@Cf">Bugün <b>@_donusBugun.Count</b></a>
                <a class="@(Df == "yarin" ? "on" : "")" href="/?df=yarin&cf=@Cf">Yarın <b>@_donusYarin.Count</b></a>
            </span>
        </div>
        <DcTable Rows="DonusList" Empty="Kayıt yok." />
    </div>
    <div class="dc-panel">
        <div class="dc-head">
            <span class="dc-title">Çıkışlar</span>
            <span class="dc-tabs">
                <a class="@(Cf == "gec" ? "on" : "")" href="/?cf=gec&df=@Df">Gecikmiş <b>@_cikisGec.Count</b></a>
                <a class="@(Cf is null or "bugun" ? "on" : "")" href="/?cf=bugun&df=@Df">Bugün <b>@_cikisBugun.Count</b></a>
                <a class="@(Cf == "yarin" ? "on" : "")" href="/?cf=yarin&df=@Df">Yarın <b>@_cikisYarin.Count</b></a>
            </span>
        </div>
        <DcTable Rows="CikisList" Empty="Kayıt yok." />
    </div>
</div>

@if (_gecmis + _yakin > 0)
{
    <div class="vade-alert">
        <strong>Vade uyarısı:</strong>
        @if (_gecmis > 0) { <span class="badge danger">@_gecmis geçmiş</span> }
        @if (_yakin > 0) { <span class="badge warn">@_yakin yaklaşan (≤30 gün)</span> }
        @if (_acikSikayet > 0) { <span class="badge warn">@_acikSikayet açık şikayet</span> }
        <a href="/vade">Vade panosu →</a>
    </div>
}

@* Finans özeti — yalnız mali yetkili roller. *@
<AuthorizeView Roles="Admin,Yonetici,Muhasebe" Context="finCtx">
    <h2 class="dash-h2">Finans Özeti</h2>
    <div class="stat-row">
        <div class="stat"><span class="s-ic"></span><div><div class="s-num">@_dash.KasaBakiye.ToString("N0")</div><div class="s-label">Kasa Bakiye</div></div></div>
        <div class="stat"><span class="s-ic"></span><div><div class="s-num">@_dash.BankaBakiye.ToString("N0")</div><div class="s-label">Banka Bakiye</div></div></div>
        <div class="stat"><span class="s-ic"></span><div><div class="s-num">@_dash.AcikBakiye.ToString("N0")</div><div class="s-label">Açık Bakiye</div></div></div>
        <div class="stat"><span class="s-ic"></span><div><div class="s-num">@_dash.BugunTahsilatTutar.ToString("N0")</div><div class="s-label">Bugün Tahsilat (@_dash.BugunTahsilatAdet)</div></div></div>
    </div>

    @* FAZ 6.2 — filo KPI şeridi (2.3 HAVUZ metrikleri: araç-bazlıların ortalaması değil, Σ havuz oranı;
       ömür-boyu semantik) + son 6 ay gelir mini-trendi (ay-pencereli defter geliri, iade netli). *@
    <h2 class="dash-h2">Filo KPI (ömür-boyu) <a class="muted small" href="/raporlar/filo-analiz">filo analiz →</a></h2>
    <div class="stat-row">
        <div class="stat"><span class="s-ic"></span><div><div class="s-num">@(_havuz?.DolulukYuzde is { } d ? $"%{d:N1}" : "—")</div><div class="s-label">Filo Doluluk</div></div></div>
        <div class="stat"><span class="s-ic"></span><div><div class="s-num">@(_havuz?.RevPacd is { } rp ? rp.ToString("N0") : "—")</div><div class="s-label">RevPACD (gelir/sahiplik-gün)</div></div></div>
        <div class="stat"><span class="s-ic"></span><div><div class="s-num">@(_havuz?.Adr is { } adr ? adr.ToString("N0") : "—")</div><div class="s-label">ADR (gelir/kiralanan gün)</div></div></div>
    </div>
    @if (_trend.Count > 0)
    {
        var maxGelir = _trend.Max(t => t.Gelir);
        <div class="dash-trend" style="display:flex;gap:.6rem;align-items:flex-end;height:72px;max-width:560px;margin:.5rem 0 1rem;">
            @foreach (var t in _trend)
            {
                var h = maxGelir > 0 ? (int)Math.Round(t.Gelir / maxGelir * 100) : 0;
                <div style="flex:1;text-align:center;display:flex;flex-direction:column;justify-content:flex-end;height:100%;">
                    <div title="@t.Gelir.ToString("N0")" style="height:@(Math.Max(h, 2))%;background:#f59e0b;border-radius:3px 3px 0 0;"></div>
                    <div class="muted small">@t.AyBas.ToString("MM.yy")</div>
                </div>
            }
        </div>
    }
</AuthorizeView>

@code {
    [SupplyParameterFromQuery(Name = "df")] public string? Df { get; set; } // dönüşler filtresi
    [SupplyParameterFromQuery(Name = "cf")] public string? Cf { get; set; } // çıkışlar filtresi
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private RentACar.Application.Reporting.FiloHavuzKpiDto? _havuz;
    private IReadOnlyList<RentACar.Application.Reporting.AylikGelirNokta> _trend = [];

    private RentACar.Application.Reporting.FleetUtilizationDto _fleet = new(0, 0, 0, 0, 0, 0, 0);
    private (int Yedi, int Otuz, int Gec) _trafik, _kasko, _muayene;
    private int _acikRezSayi, _kmGecenBakim, _gorulmeyenRez, _gecmis, _yakin, _acikSikayet;
    private DashboardDto _dash = new(0, 0, 0, 0, 0, 0, 0, 0m, 0m, 0m, 0m);

    private List<DcRow> _donusGec = [], _donusBugun = [], _donusYarin = [];
    private List<DcRow> _cikisGec = [], _cikisBugun = [], _cikisYarin = [];

    private List<DcRow> DonusList => Df switch { "gec" => _donusGec, "yarin" => _donusYarin, _ => _donusBugun };
    private List<DcRow> CikisList => Cf switch { "gec" => _cikisGec, "yarin" => _cikisYarin, _ => _cikisBugun };

    private int Yuzde(int n) => _fleet.Toplam == 0 ? 0 : (int)Math.Round(100.0 * n / _fleet.Toplam);

    protected override async Task OnInitializedAsync()
    {
        _dash = await Dashboard.GetAsync(DateTimeOffset.UtcNow);
        _fleet = await Reports.GetFleetUtilizationAsync();

        var customers = await Customers.ListAsync();
        var vehicles = await Vehicles.ListAsync();
        var rentals = await Rentals.ListAsync();
        var rezervler = await Reservations.ListAsync();
        var ad = customers.ToDictionary(c => c.Id, c => c.DisplayName ?? "");
        var plaka = vehicles.ToDictionary(v => v.Id, v => v.Plaka);
        string Ad(Guid id) => ad.GetValueOrDefault(id, "—");
        string Plaka(Guid id) => plaka.GetValueOrDefault(id, "—");

        var bugun = DateTimeOffset.Now.Date;

        // Dönüşler: aktif kiralar (dönmemiş), planlanan dönüş tarihine göre.
        var acikKira = rentals.Where(r => r.Durum == RentalStatus.Kirada && r.GercekDonusTar is null).ToList();
        List<DcRow> DonusRows(Func<DateTime, bool> pred) => acikKira
            .Where(r => pred(r.BitTar.LocalDateTime.Date))
            .OrderBy(r => r.BitTar)
            .Select(r => new DcRow(r.BitTar, Ad(r.MusteriId), Plaka(r.VehicleId), r.DonusOfisi ?? ""))
            .ToList();
        _donusGec = DonusRows(d => d < bugun);
        _donusBugun = DonusRows(d => d == bugun);
        _donusYarin = DonusRows(d => d == bugun.AddDays(1));

        // Çıkışlar: açık rezervasyonlar (Rezerv/Onayli), planlanan başlangıç (çıkış) tarihine göre.
        var acikRez = rezervler.Where(r => r.Durum is ReservationStatus.Rezerv or ReservationStatus.Onayli).ToList();
        _acikRezSayi = acikRez.Count;
        List<DcRow> CikisRows(Func<DateTime, bool> pred) => acikRez
            .Where(r => pred(r.BasTar.LocalDateTime.Date))
            .OrderBy(r => r.BasTar)
            .Select(r => new DcRow(r.BasTar, Ad(r.MusteriId), Plaka(r.VehicleId), r.CikisOfisi ?? ""))
            .ToList();
        _cikisGec = CikisRows(d => d < bugun);
        _cikisBugun = CikisRows(d => d == bugun);
        _cikisYarin = CikisRows(d => d == bugun.AddDays(1));
        _gorulmeyenRez = _cikisGec.Count; // çıkışı gecikmiş açık rezervasyon = görülmeyen

        // Vade kademeleri (tür × bucket).
        var vade = await Vade.GetAllAsync();
        (int, int, int) Tier(string tur) => (
            vade.Count(v => v.Tur == tur && v.Bucket == VadeBucket.YediGun),
            vade.Count(v => v.Tur == tur && v.Bucket == VadeBucket.OtuzGun),
            vade.Count(v => v.Tur == tur && v.Bucket == VadeBucket.Gecmis));
        _trafik = Tier("Trafik");
        _kasko = Tier("Kasko");
        _muayene = Tier("Muayene");

        var servis = await Reports.GetPeriyodikServisAsync();
        _kmGecenBakim = servis.Count(s => s.KalanKm < 0);

        var warnings = await Vade.GetWarningsAsync();
        _gecmis = warnings.Count(w => w.Bucket == VadeBucket.Gecmis);
        _yakin = warnings.Count(w => w.Bucket != VadeBucket.Gecmis);
        _acikSikayet = (await Sikayet.ListAsync()).Count(s => s.Durum == RentACar.Domain.Enums.SikayetDurum.Acik);

        // FAZ 6.2 — filo KPI + gelir trendi yalnız mali yetkili rollere YÜKLENİR (görünürlük zaten
        // AuthorizeView'da; operatörde ağır filo-analiz sorgusu hiç koşmasın).
        var user = AuthState is null ? null : (await AuthState).User;
        if (user is not null && (user.IsInRole("Admin") || user.IsInRole("Yonetici") || user.IsInRole("Muhasebe")))
        {
            _havuz = (await Reports.GetFiloAnalizAsync()).HavuzKpi;
            _trend = await Reports.GetAylikGelirTrendAsync(6);
        }
    }
}
