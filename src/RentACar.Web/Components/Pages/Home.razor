@page "/"
@attribute [Authorize]
@inject VehicleService Vehicles
@inject CustomerService Customers
@inject RentalService Rentals
@inject ReservationService Reservations
@inject DueService Vade
@inject DashboardService Dashboard
@inject RentACar.Application.Reporting.ReportService Reports
@inject RentACar.Application.Crm.ComplaintService Sikayet
@inject RentACar.Application.Finance.CashService Cash
@inject RentACar.Application.PublicSite.PublicBookingRequestService SiteTalepleri
@inject RentACar.Infrastructure.Persistence.TenantStatusCache TenantDurum
@inject RentACar.Domain.Common.ITenantContext TenantCtx

<PageTitle>Panel — RentPro</PageTitle>
@* Statik SSR panosu: sayfa 120 sn'de bir otomatik yenilenir → boştaki araç/rezervasyon sayaçları
   güncel kalır. meta-refresh KULLANILMAZ: enhanced navigation ile başka sayfaya
   geçilince tarayıcının bekleyen refresh'i iptal olmuyor ve kullanıcıyı formun ortasında buraya
   fırlatıyordu (veri kaybı). rc-tazele.js zamanlayıcıyı sayfadan çıkışta iptal eder. *@
<div class="page-head" data-rc-tazele="120">
    <h1>Panel</h1>
    <div class="actions">
        <a href="/rezervasyonlar">+ Rezervasyon</a>
        <a href="/kiralar">+ Kira</a>
        <a href="/musaitlik">Müsaitlik</a>
    </div>
</div>

@* 4 KPI kartı + her birinin altında vade kademesi (referans sistem parite) *@
<div class="kpi-grid">
    <div class="kpi-cell">
        <div class="kpi k-purple">
            <div class="k-top"><span class="k-label">Kiradaki Araçlar</span><span class="k-ic"></span></div>
            <div class="k-num">@_fleet.Kirada</div>
            <div class="k-bar"><span style="width:@Percent(_fleet.Kirada)%"></span></div>
            <div class="k-foot">Toplamdan %@Percent(_fleet.Kirada)</div>
        </div>
        <VadeTier Label="Trafik Sigortaları" Tier="_trafficInsurance" Href="/vade" />
    </div>
    <div class="kpi-cell">
        <div class="kpi k-green">
            <div class="k-top"><span class="k-label">Boştaki Araçlar</span><span class="k-ic"></span></div>
            <div class="k-num">@_fleet.Musait</div>
            <div class="k-bar"><span style="width:@Percent(_fleet.Musait)%"></span></div>
            <div class="k-foot">Toplamdan %@Percent(_fleet.Musait)</div>
        </div>
        <VadeTier Label="Kaskolar" Tier="_casco" Href="/vade" />
    </div>
    <div class="kpi-cell">
        <div class="kpi k-red">
            <div class="k-top"><span class="k-label">Servisteki Araçlar</span><span class="k-ic"></span></div>
            <div class="k-num">@_fleet.Serviste</div>
            <div class="k-bar"><span style="width:@Percent(_fleet.Serviste)%"></span></div>
            <div class="k-foot">Toplamdan %@Percent(_fleet.Serviste)</div>
        </div>
        <VadeTier Label="Muayeneler" Tier="_inspection" Href="/vade" />
    </div>
    <div class="kpi-cell">
        <div class="kpi k-orange">
            <div class="k-top"><span class="k-label">Açık Rezervasyonlar</span><span class="k-ic"></span></div>
            <div class="k-num">@_openReservationCount</div>
            <div class="k-bar"><span style="width:@Percent(_openReservationCount)%"></span></div>
            <div class="k-foot">Bekleyen rezervasyon</div>
        </div>
        <div class="vade-tier">
            <div class="vt-boxes">
                <a class="vt-box @(_kmOverdueMaintenance > 0 ? "danger" : "")" href="/raporlar/periyodik-servis">
                    <span class="vt-n">@_kmOverdueMaintenance</span>KM Geçen Bakım</a>
                <a class="vt-box @(_unseenReservations > 0 ? "warn" : "")" href="/rezervasyonlar">
                    <span class="vt-n">@_unseenReservations</span>Görülmeyen Rez.</a>
                @* PR-17: siteden gelen cevaplanmamış talep — en eskisinin bekleme süresi başlıkta.
                   Yalnız "Web Sitesi" modülü açıkken gösterilir (kapalıysa hep 0 olurdu). *@
                @if (_siteRequest is { } st)
                {
                    <a class="vt-box @(st.Yeni > 0 ? (st.EnEskiGun >= 3 ? "danger" : "warn") : "")"
                       href="/gelen-talepler?durum=0"
                       title="@(st.EnEskiGun is { } g ? $"En eskisi {g} gündür bekliyor" : "Bekleyen talep yok")">
                        <span class="vt-n">@st.Yeni</span>Site Talebi</a>
                }
            </div>
        </div>
    </div>
</div>

@* Dönüşler / Çıkışlar — gün-filtreli (referans sistem parite) *@
@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p> @* hızlı tahsilat hatası (ör. çift gönderim) — endpoint ?hata= ile döner *@
}
<div class="donus-cikis">
    <div class="dc-panel">
        <div class="dc-head">
            <span class="dc-title">Dönüşler</span>
            <span class="dc-tabs">
                @* Sekme kararı PanelSekme'de (saf, test-kilitli): seçim yoksa gecikmiş varken "gec" açılır
                   (YALNIZ Dönüşler; Çıkışlar'ın varsayılanı daima Bugün — PanelSekme.CikisEtkin).
                   Linkler DİĞER kartın ham seçimini taşır (etkinini değil) — o kart seçimsizse seçimsiz
                   kalsın, varsayılan kural her yüklemede (120 sn tazeleme dahil) yeniden işlesin. *@
                <a class="@PanelTab.ChipClass(PanelTab.Overdue, DfEtkin, _returnOverdue.Count)" href="/?df=gec&cf=@CfSecilen">Gecikmiş <b>@_returnOverdue.Count</b></a>
                <a class="@PanelTab.ChipClass(PanelTab.Today, DfEtkin, _returnOverdue.Count)" href="/?df=bugun&cf=@CfSecilen">Bugün <b>@_returnToday.Count</b></a>
                <a class="@PanelTab.ChipClass(PanelTab.Tomorrow, DfEtkin, _returnOverdue.Count)" href="/?df=yarin&cf=@CfSecilen">Yarın <b>@_returnTomorrow.Count</b></a>
            </span>
        </div>
        @if (_financeAuthorized)
        {
            <DcTable Rows="DonusList" Empty="Kayıt yok." RowStyle="@ReturnStyle">
                <Islem>
                    @if (context is { RentalId: not null, CariId: not null, Bakiye: > 0m })
                    {
                        @* Hızlı tahsilat — mevcut /finans/tahsilat ucu (FinanceWrite). Tutar=Bakiye ön-dolu
                           (düzenlenebilir; aşan tutar cari alacak olarak kabul edilir). Döviz kira dövizi
                           (K2: repo uyuşmazlığı reddeder); kur GÖNDERİLMEZ → KurCozucu günü çözer.
                           islemAnahtari deterministik (rentalId+bakiye+işlem-sayısı) → çift-submit/stale-tab
                           DB kısmi-unique-index'te zarif bloklanır, sonraki ay sayaç artar → yeni anahtar. *@
                        <form method="post" action="/finans/tahsilat" class="tahsil-mini"><AntiforgeryToken />
                            <input type="hidden" name="cariId" value="@context.CariId" />
                            <input type="hidden" name="rentalId" value="@context.RentalId" />
                            <input type="hidden" name="doviz" value="@RentACar.Application.Kur.ExchangeRateService.NormalizeCode(context.Doviz)" />
                            <input type="hidden" name="islemAnahtari" value="@RentACar.Web.Finance.CollectionKey.Generate(context.RentalId.Value, context.Bakiye, context.IslemSayisi)" />
                            @* HAM seçim (etkin değil): varsayılanla "gec"te açılmış pano seçimsiz kalır ve
                               aynı kuralla yine "gec"te açılır (tahsilat kira durumunu değiştirmez). Etkin
                               "gec" yazılsaydı açık seçime dönüşür, gecikmişler kapanınca 120 sn tazeleme
                               kartı "Gecikmiş 0 — Kayıt yok."ta tutardı (adversarial bulgu). *@
                            <input type="hidden" name="donus" value="/?df=@DfSecilen&cf=@CfSecilen" />
                            <input type="hidden" name="aciklama" value="Hızlı tahsilat (pano) — @context.Plaka" />
                            @* FAZ-84: tek-tık hızlı tahsilat — seçici yok, masaüstü panosundan yapılan işlem. *@
                            <input type="hidden" name="kanal" value="Masaüstü" />
                            <input name="tutar" type="number" step="0.01" min="0.01" value="@context.Bakiye.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                   required class="u-w-auto dc-tutar" title="Dönüş öncesi planlanan bakiye — geç dönüş/yakıt/km farkı Dönüş'te kapanır" />
                            <select name="hesap" title="Tahsilat hesabı"><option>Kasa</option><option>Banka</option></select>
                                <HesapSecici CssClass="kf-inline" Etiket="" />
                            <button type="submit" class="kf-btn">Tahsil Et</button>
                        </form>
                    }
                </Islem>
            </DcTable>
        }
        else
        {
            <DcTable Rows="DonusList" Empty="Kayıt yok." RowStyle="@ReturnStyle" />
        }
    </div>
    <div class="dc-panel">
        <div class="dc-head">
            <span class="dc-title">Çıkışlar</span>
            <span class="dc-tabs">
                <a class="@PanelTab.ChipClass(PanelTab.Overdue, CfEtkin, _pickupOverdue.Count)" href="/?cf=gec&df=@DfSecilen">Gecikmiş <b>@_pickupOverdue.Count</b></a>
                <a class="@PanelTab.ChipClass(PanelTab.Today, CfEtkin, _pickupOverdue.Count)" href="/?cf=bugun&df=@DfSecilen">Bugün <b>@_pickupToday.Count</b></a>
                <a class="@PanelTab.ChipClass(PanelTab.Tomorrow, CfEtkin, _pickupOverdue.Count)" href="/?cf=yarin&df=@DfSecilen">Yarın <b>@_pickupTomorrow.Count</b></a>
            </span>
        </div>
        <DcTable Rows="CikisList" Empty="Kayıt yok." RowStyle="@PickupStyle" />
    </div>
</div>

@if (_history + _yakin > 0)
{
    <div class="vade-alert">
        <strong>Vade uyarısı:</strong>
        @if (_history > 0) { <span class="badge danger">@_history geçmiş</span> }
        @if (_yakin > 0) { <span class="badge warn">@_yakin yaklaşan (≤30 gün)</span> }
        @if (_openComplaints > 0) { <span class="badge warn">@_openComplaints açık şikayet</span> }
        <a href="/vade">Vade panosu →</a>
    </div>
}

@* Finans özeti — yalnız mali yetkili roller. *@
<AuthorizeView Roles="Admin,Yonetici,Muhasebe" Context="finCtx">
    <h2 class="dash-h2">Finans Özeti</h2>
    <div class="stat-row">
        <div class="stat"><span class="s-ic"></span><div><div class="s-num">@_dash.KasaBakiye.ToString("N0")</div><div class="s-label">Kasa Bakiye</div></div></div>
        <div class="stat"><span class="s-ic"></span><div><div class="s-num">@_dash.BankaBakiye.ToString("N0")</div><div class="s-label">Banka Bakiye</div></div></div>
        <div class="stat"><span class="s-ic"></span><div><div class="s-num">@_dash.AcikBakiye.ToString("N0")</div><div class="s-label">Açık Bakiye</div></div></div>
        <div class="stat"><span class="s-ic"></span><div><div class="s-num">@_dash.BugunTahsilatTutar.ToString("N0")</div><div class="s-label">Bugün Tahsilat (@_dash.BugunTahsilatAdet)</div></div></div>
    </div>

    @* FAZ 6.2 — filo KPI şeridi (2.3 HAVUZ metrikleri: araç-bazlıların ortalaması değil, Σ havuz oranı;
       ömür-boyu semantik) + son 6 ay gelir mini-trendi (ay-pencereli defter geliri, iade netli). *@
    <h2 class="dash-h2">Filo KPI (ömür-boyu) <a class="muted small" href="/raporlar/filo-analiz">filo analiz →</a></h2>
    <div class="stat-row">
        <div class="stat"><span class="s-ic"></span><div><div class="s-num">@(_pool?.DolulukYuzde is { } d ? $"%{d:N1}" : "—")</div><div class="s-label">Filo Doluluk</div></div></div>
        <div class="stat"><span class="s-ic"></span><div><div class="s-num">@(_pool?.RevPacd is { } rp ? rp.ToString("N0") : "—")</div><div class="s-label">RevPACD (gelir/sahiplik-gün)</div></div></div>
        <div class="stat"><span class="s-ic"></span><div><div class="s-num">@(_pool?.Adr is { } adr ? adr.ToString("N0") : "—")</div><div class="s-label">ADR (gelir/kiralanan gün)</div></div></div>
    </div>
    @if (_trend.Count > 0)
    {
        @* FAZ Finans-Analiz: elle div-bar yerine paylaşılan SVG grafik bileşeni (tam sürüm /raporlar/finans-analiz). *@
        <div class="dash-trend" style="max-width:560px;margin:.5rem 0 1rem;">
            <SvgBarChart Baslik="Son 6 Ay Gelir (₺)"
                         Etiketler="@_trend.Select(t => t.AyBas.ToString("MM.yy")).ToList()"
                         Seriler="@(new List<SvgSeri> { new("Gelir", _trend.Select(t => t.Gelir).ToList(), 1) })"
                         Format="@(v => v.ToString("N0"))" />
            <a class="muted small" href="/raporlar/finans-analiz">finans analiz →</a>
        </div>
    }
</AuthorizeView>

@code {
    [SupplyParameterFromQuery(Name = "df")] public string? Df { get; set; } // dönüşler filtresi
    [SupplyParameterFromQuery(Name = "cf")] public string? Cf { get; set; } // çıkışlar filtresi
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; } // hızlı tahsilat hata mesajı
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private RentACar.Application.Reporting.FiloHavuzKpiDto? _pool;
    private IReadOnlyList<RentACar.Application.Reporting.AylikGelirNokta> _trend = [];

    private RentACar.Application.Reporting.FleetUtilizationDto _fleet = new(0, 0, 0, 0, 0, 0, 0);
    private (int Yedi, int Otuz, int Gec) _trafficInsurance, _casco, _inspection;
    private int _openReservationCount, _kmOverdueMaintenance, _unseenReservations, _history, _yakin, _openComplaints;

    // FAZ-81: renk MainLayout'un bastığı CSS değişkeninden gelir — burada AYRI bir ayar okuması
    // YAPILMAZ (iki okuma iki farklı değer riski taşırdı). Tenant renk seçmediyse değişken tanımsız
    // kalır ve fallback "transparent" olur → vurgu görünmez, eski görünüm korunur.
    private const string ReturnStyle = "border-left:3px solid var(--tr-renk-bugun-donecekler, transparent)";
    private const string PickupStyle = "border-left:3px solid var(--tr-renk-bugun-cikacaklar, transparent)";
    /// <summary>PR-17: siteden gelen cevaplanmamış talep özeti. Modül kapalıysa null → kutu basılmaz.</summary>
    private RentACar.Application.PublicSite.TalepOzet? _siteRequest;
    private DashboardDto _dash = new(0, 0, 0, 0, 0, 0, 0, 0m, 0m, 0m, 0m);

    private List<DcRow> _returnOverdue = [], _returnToday = [], _returnTomorrow = [];
    private List<DcRow> _pickupOverdue = [], _pickupToday = [], _pickupTomorrow = [];
    private bool _financeAuthorized; // Dönüşler satırında hızlı-tahsilat formu görünürlüğü (FinanceWrite rolleri)

    // Ham df/cf DOĞRUDAN kullanılmaz: çip vurgusu, liste ve Tahsil Et dönüş adresi aynı ETKİN değeri
    // okur. Eskiden null üçünde ayrı yorumlanıyor ve 9 gecikmiş dönüş varken pano "Bugün 0 — Kayıt
    // yok." ile açılıyordu (canlı kanıt). Gecikmiş sayıları OnInitializedAsync'te dolar; bu özellikler
    // render sırasında okunduğu için daima dolu listeye göre karar verir.
    private string DfEtkin => PanelTab.Active(Df, _returnOverdue.Count);
    // Çıkışlar varsayılanı gecikmişe BAKMAZ: gecikmiş çıkış = kapanmayan bayat no-show (bkz. CikisEtkin).
    private string CfEtkin => PanelTab.IsPickupActive(Cf);
    private string? DfSecilen => PanelTab.Selected(Df);
    private string? CfSecilen => PanelTab.Selected(Cf);

    private List<DcRow> DonusList => DfEtkin switch { PanelTab.Overdue => _returnOverdue, PanelTab.Tomorrow => _returnTomorrow, _ => _returnToday };
    private List<DcRow> CikisList => CfEtkin switch { PanelTab.Overdue => _pickupOverdue, PanelTab.Tomorrow => _pickupTomorrow, _ => _pickupToday };

    private int Percent(int n) => _fleet.Toplam == 0 ? 0 : (int)Math.Round(100.0 * n / _fleet.Toplam);

    protected override async Task OnInitializedAsync()
    {
        _dash = await Dashboard.GetAsync(DateTimeOffset.UtcNow);
        _fleet = await Reports.GetFleetUtilizationAsync();

        var customers = await Customers.ListAsync();
        var vehicles = await Vehicles.ListAsync();
        var rentals = await Rentals.ListAsync();
        var reserved = await Reservations.ListAsync();
        var name = customers.ToDictionary(c => c.Id, c => c.DisplayName ?? "");
        var plate = vehicles.ToDictionary(v => v.Id, v => v.Plaka);
        string Name(Guid id) => name.GetValueOrDefault(id, "—");
        string Plate(Guid id) => plate.GetValueOrDefault(id, "—");

        var today = DateTimeOffset.Now.Date;

        // Dönüşler: aktif kiralar (dönmemiş), planlanan dönüş tarihine göre. Satırlar kira formuna
        // (#sekme=donus — rc-kira-tabs.js hash'ten açar) linklenir; finans-yetkili rollere hızlı
        // tahsilat formu için kimlik/bakiye/döviz + işlem SAYISI (deterministik anahtar bileşeni,
        // TahsilatAnahtar açıklaması) taşınır.
        var openRental = rentals.Where(r => r.Durum == RentalStatus.Kirada && r.GercekDonusTar is null).ToList();
        var transactionCounts = await Cash.GetRentalTransactionCountsAsync(openRental.Select(r => r.Id).ToList());
        List<DcRow> ReturnRows(Func<DateTime, bool> pred) => openRental
            .Where(r => pred(r.BitTar.LocalDateTime.Date))
            .OrderBy(r => r.BitTar)
            .Select(r => new DcRow(r.BitTar, Name(r.MusteriId), Plate(r.VehicleId), r.DonusOfisi ?? "",
                Href: $"/kiralar/{r.Id}#sekme=donus", RentalId: r.Id, CariId: r.MusteriId,
                Bakiye: r.Bakiye, Doviz: r.Doviz,
                IslemSayisi: transactionCounts.TryGetValue(r.Id, out var s) ? s : 0)) // kayıtsız kira dict'te yok → 0
            .ToList();
        _returnOverdue = ReturnRows(d => d < today);
        _returnToday = ReturnRows(d => d == today);
        _returnTomorrow = ReturnRows(d => d == today.AddDays(1));

        // Çıkışlar: açık rezervasyonlar (Rezerv/Onayli), planlanan başlangıç (çıkış) tarihine göre.
        var openReservation = reserved.Where(r => r.Durum is ReservationStatus.Rezerv or ReservationStatus.Onayli).ToList();
        _openReservationCount = openReservation.Count;
        List<DcRow> PickupRows(Func<DateTime, bool> pred) => openReservation
            .Where(r => pred(r.BasTar.LocalDateTime.Date))
            .OrderBy(r => r.BasTar)
            .Select(r => new DcRow(r.BasTar, Name(r.MusteriId), Plate(r.VehicleId), r.CikisOfisi ?? ""))
            .ToList();
        _pickupOverdue = PickupRows(d => d < today);
        _pickupToday = PickupRows(d => d == today);
        _pickupTomorrow = PickupRows(d => d == today.AddDays(1));
        _unseenReservations = _pickupOverdue.Count; // çıkışı gecikmiş açık rezervasyon = görülmeyen

        // PR-17: site talebi kutusu — YALNIZ modül açıkken (kapalıysa sayı hep 0 olur, kutu gürültü).
        // Yetkisiz rol guard'a takılırsa pano DÜŞMEMELİ (menüdeki sayaçla aynı savunma).
        try
        {
            if (TenantCtx.TenantId is { } tid && await TenantDurum.WebsiteModuleAsync(tid))
                _siteRequest = await SiteTalepleri.SummaryAsync();
        }
        catch { _siteRequest = null; }

        // Vade kademeleri (tür × bucket).
        var due = await Vade.GetAllAsync();
        (int, int, int) Tier(string type) => (
            due.Count(v => v.Tur == type && v.Bucket == DueBucket.YediGun),
            due.Count(v => v.Tur == type && v.Bucket == DueBucket.OtuzGun),
            due.Count(v => v.Tur == type && v.Bucket == DueBucket.Gecmis));
        _trafficInsurance = Tier("Trafik");
        _casco = Tier("Kasko");
        _inspection = Tier("Muayene");

        var service = await Reports.GetPeriodicServiceAsync();
        _kmOverdueMaintenance = service.Count(s => s.KalanKm < 0);

        var warnings = await Vade.GetWarningsAsync();
        _history = warnings.Count(w => w.Bucket == DueBucket.Gecmis);
        _yakin = warnings.Count(w => w.Bucket != DueBucket.Gecmis);
        _openComplaints = (await Sikayet.ListAsync()).Count(s => s.Durum == RentACar.Domain.Enums.ComplaintStatus.Acik);

        // FAZ 6.2 — filo KPI + gelir trendi yalnız mali yetkili rollere YÜKLENİR (görünürlük zaten
        // AuthorizeView'da; operatörde ağır filo-analiz sorgusu hiç koşmasın).
        var user = AuthState is null ? null : (await AuthState).User;
        _financeAuthorized = user is not null && (user.IsInRole("Admin") || user.IsInRole("Yonetici") || user.IsInRole("Muhasebe"));
        if (_financeAuthorized)
        {
            _pool = (await Reports.GetFleetAnalysisAsync()).HavuzKpi;
            _trend = await Reports.GetMonthlyRevenueTrendAsync(6);
        }
    }
}
