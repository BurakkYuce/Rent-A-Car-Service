@page "/kullanicilar"
@attribute [Authorize(Policy = "izin:ManageUsers")]
@using RentACar.Domain.Enums
@inject UserService Users
@inject RentACar.Application.Branches.BranchService Subeler
@inject RentACar.Application.Users.UserPermissionService Istisnalar

<PageTitle>Kullanıcılar — RentPro</PageTitle>

<div class="page-head"><h1>Kullanıcı Yönetimi</h1><div class="actions"></div></div>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_list.Count == 0)">
    <summary>+ Yeni Kullanıcı</summary>
    <form method="post" action="/kullanicilar/create" class="grid-form"><AntiforgeryToken />
        <label>Kullanıcı Adı<input name="userName" required /></label>
        <label>Görünen Ad<input name="displayName" /></label>
        <label>Rol
            <select name="rol">
                @foreach (var r in Enum.GetValues<UserRole>())
                {
                    <option value="@r">@r</option>
                }
            </select>
        </label>
        <ComboBox Name="atanmisSube" Label="Şube (operatör kapsamı)" Options="_subeOpts" Placeholder="boş = tüm şubeler" />
        <label>Parola<input name="password" type="password" required /></label>
        <button type="submit">Oluştur</button>
    </form>
</details>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Kullanıcı</th><th>Görünen Ad</th><th>Rol</th><th>Şube</th><th>Durum</th><th>İşlem</th></tr></thead>
    <tbody>
        @foreach (var u in _list)
        {
            <tr>
                <td>@u.UserName</td>
                <td>@u.DisplayName</td>
                <td>@u.Rol</td>
                <td>@(string.IsNullOrEmpty(u.AtanmisSube) ? "— (tümü)" : u.AtanmisSube)</td>
                <td>@(u.IsActive ? "Aktif" : "Pasif")</td>
                <td>
                    <form method="post" action="/kullanicilar/aktif" class="inline"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@u.Id" />
                        <input type="hidden" name="active" value="@((!u.IsActive).ToString().ToLower())" />
                        <button type="submit">@(u.IsActive ? "Pasifleştir" : "Aktifleştir")</button>
                    </form>
                    <form method="post" action="/kullanicilar/sifre" class="inline"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@u.Id" />
                        <input name="password" type="password" placeholder="Yeni parola" required style="width:8rem" />
                        <button type="submit">Parola</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<h2>İzin İstisnaları</h2>
<p class="muted small">Rol matrisinin üstüne tek kullanıcıya <strong>ek izin</strong> verme ya da matristen gelen bir izni
    <strong>geri alma</strong>. Yasak her zaman kazanır. Değişiklik, kullanıcının <strong>bir sonraki girişinde</strong>
    etkinleşir (izinler oturum açarken yüklenir). Kendi istisnanızı değiştiremezsiniz.</p>

<div class="table-scroll">
<table class="grid tr-grid kart-mobil">
    <thead><tr><th>Kullanıcı</th><th>İzin</th><th>Tür</th><th>Tanımlayan</th><th></th></tr></thead>
    <tbody>
        @if (_istisnalar.Count == 0)
        {
            <tr><td colspan="5" class="muted">İstisna yok (herkes rol matrisine göre).</td></tr>
        }
        @foreach (var i in _istisnalar)
        {
            <tr>
                <td class="kart-baslik" data-etiket="Kullanıcı">@KullaniciAdi(i.UserId)</td>
                <td data-etiket="İzin">@i.Izin</td>
                <td data-etiket="Tür">@(i.Ver ? "Ek izin" : "Yasak")</td>
                <td data-etiket="Tanımlayan">@i.Tanimlayan</td>
                <td class="kart-aksiyon">
                    <form method="post" action="/kullanicilar/istisna/sil" class="inline"
                          data-confirm="İstisna kaldırılsın mı? (sonraki girişte etkin)"><AntiforgeryToken />
                        <input type="hidden" name="userId" value="@i.UserId" />
                        <input type="hidden" name="izin" value="@i.Izin" />
                        <button type="submit" class="btn-danger">Kaldır</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<form method="post" action="/kullanicilar/istisna/set" class="grid-form"><AntiforgeryToken />
    <label>Kullanıcı
        <select name="userId" required>
            @foreach (var u in _list)
            {
                <option value="@u.Id">@u.UserName (@u.Rol)</option>
            }
        </select>
    </label>
    <label>İzin
        <select name="izin" required>
            @foreach (var p in Enum.GetValues<RentACar.Application.Authorization.Permission>())
            {
                <option value="@p">@p</option>
            }
        </select>
    </label>
    <label>Tür
        <select name="tur">
            <option value="ver">Ek izin (rolüne ekle)</option>
            <option value="yasak">Yasak (rolünden geri al)</option>
        </select>
    </label>
    <button type="submit">Kaydet</button>
</form>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private IReadOnlyList<UserListItem> _list = [];
    private IReadOnlyList<string> _subeOpts = [];
    private IReadOnlyList<RentACar.Application.Users.KullaniciIzinSatiri> _istisnalar = [];

    protected override async Task OnInitializedAsync()
    {
        _list = await Users.ListAsync();
        _subeOpts = (await Subeler.ListActiveAsync()).Select(s => s.Ad).ToList();
        _istisnalar = await Istisnalar.ListAsync();
    }

    private string KullaniciAdi(Guid id)
        => _list.FirstOrDefault(u => u.Id == id)?.UserName ?? id.ToString()[..8];
}
