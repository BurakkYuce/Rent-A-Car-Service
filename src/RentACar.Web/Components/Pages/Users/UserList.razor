@page "/kullanicilar"
@attribute [Authorize(Roles = "Admin")]
@using RentACar.Domain.Enums
@inject UserService Users
@inject RentACar.Application.Branches.BranchService Subeler

<PageTitle>Kullanıcılar — RentPro</PageTitle>

<div class="page-head"><h1>Kullanıcı Yönetimi</h1><div class="actions"></div></div>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_list.Count == 0)">
    <summary>+ Yeni Kullanıcı</summary>
    <form method="post" action="/kullanicilar/create" class="grid-form"><AntiforgeryToken />
        <label>Kullanıcı Adı<input name="userName" required /></label>
        <label>Görünen Ad<input name="displayName" /></label>
        <label>Rol
            <select name="rol">
                @foreach (var r in Enum.GetValues<UserRole>())
                {
                    <option value="@r">@r</option>
                }
            </select>
        </label>
        <ComboBox Name="atanmisSube" Label="Şube (operatör kapsamı)" Options="_subeOpts" Placeholder="boş = tüm şubeler" />
        <label>Parola<input name="password" type="password" required /></label>
        <button type="submit">Oluştur</button>
    </form>
</details>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Kullanıcı</th><th>Görünen Ad</th><th>Rol</th><th>Şube</th><th>Durum</th><th>İşlem</th></tr></thead>
    <tbody>
        @foreach (var u in _list)
        {
            <tr>
                <td>@u.UserName</td>
                <td>@u.DisplayName</td>
                <td>@u.Rol</td>
                <td>@(string.IsNullOrEmpty(u.AtanmisSube) ? "— (tümü)" : u.AtanmisSube)</td>
                <td>@(u.IsActive ? "Aktif" : "Pasif")</td>
                <td>
                    <form method="post" action="/kullanicilar/aktif" class="inline"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@u.Id" />
                        <input type="hidden" name="active" value="@((!u.IsActive).ToString().ToLower())" />
                        <button type="submit">@(u.IsActive ? "Pasifleştir" : "Aktifleştir")</button>
                    </form>
                    <form method="post" action="/kullanicilar/sifre" class="inline"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@u.Id" />
                        <input name="password" type="password" placeholder="Yeni parola" required style="width:8rem" />
                        <button type="submit">Parola</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private IReadOnlyList<UserListItem> _list = [];
    private IReadOnlyList<string> _subeOpts = [];

    protected override async Task OnInitializedAsync()
    {
        _list = await Users.ListAsync();
        _subeOpts = (await Subeler.ListActiveAsync()).Select(s => s.Ad).ToList();
    }
}
