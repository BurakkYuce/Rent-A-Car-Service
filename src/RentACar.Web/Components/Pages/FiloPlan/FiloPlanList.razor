@page "/filo-plan"
@attribute [Authorize(Roles = "Admin,Yonetici,Operator,Muhasebe")]
@using RentACar.Application.FiloPlan
@inject FiloPlanService Planlar
@inject VehicleGroupService Gruplar

<PageTitle>Filo Plan Hedefi — RentPro</PageTitle>

<div class="page-head"><h1>Filo Plan Yönetimi</h1></div>
@* Kapasite planı ekranıdır — gerçek satın alma /arac-siparis'te. Hedef değiştirmek sipariş
   oluşturmaz; iki iş bilinçli olarak ayrı. *@
<p class="muted small">Araç grubu ve/veya SIPP koduna <strong>hedef filo adedi</strong> tanımlayıp
    gerçekleşenle karşılaştırın. <strong>Gerçekleşen</strong> yalnız <em>kiralanabilir</em> araçları
    sayar (satılmış ve pasif hariç); <strong>Kayıtlı</strong> ise aynı boyuttaki tüm araçları —
    fark buradan görünür. Bu ekran <strong>sipariş oluşturmaz</strong>; satın alma
    <a href="/arac-siparis">Araç Sipariş</a> ekranındadır.</p>

@if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }

<form method="post" action="/filo-plan/create" class="grid-form"><AntiforgeryToken />
    <ComboBox Name="aracGrupAdi" Label="Araç Grubu" Options="_grupOpts" Placeholder="(ops.)" />
    <label>SIPP<input name="sipp" maxlength="16" placeholder="(ops.) ör. EDMR" /></label>
    <label>Dönem<input name="donem" maxlength="32" placeholder="(ops.) 2026-Q1" /></label>
    <label>Hedef Adet<input name="hedefAdet" type="number" min="0" required value="0" /></label>
    <label class="u-col-full">Açıklama<input name="aciklama" maxlength="512" /></label>
    <button type="submit">Ekle</button>
</form>
<p class="muted small">Grup ve SIPP'in <strong>en az biri</strong> zorunlu — ikisi de boş bir hedef
    tüm filoyu sayardı. İkisi de doluysa kural daralır (grup <em>ve</em> SIPP birlikte eşleşmeli).</p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Araç Grubu</th><th>SIPP</th><th>Dönem</th><th class="num">Hedef</th>
        <th class="num">Gerçekleşen</th><th class="num">Kayıtlı</th><th class="num">Fark</th>
        <th>Durum</th><th>Açıklama</th><th>İşlem</th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="10" class="muted">Hedef tanımlı değil.</td></tr>
        }
        @foreach (var s in _list)
        {
            <tr>
                <td>@(s.Hedef.AracGrupAdi ?? "— tümü —")</td>
                <td class="mono">@(s.Hedef.Sipp ?? "— tümü —")</td>
                <td>@(s.Hedef.Donem ?? "—")</td>
                <td class="num">@s.Hedef.HedefAdet</td>
                <td class="num">@s.Gerceklesen</td>
                <td class="num muted">@s.ToplamKayitli</td>
                <td class="num">@(s.Fark > 0 ? "+" + s.Fark : s.Fark.ToString())</td>
                <td>
                    <span class="status-pill @(s.Fark == 0 ? "sp-success" : s.Fark > 0 ? "sp-warn" : "sp-info")">@s.Durum</span>
                </td>
                <td>@(s.Hedef.Aciklama ?? "—")</td>
                <td>
                    @* Artır/Azalt ayrı mini-formlar; delta SUNUCUDA ±1'e sabit (form değeri değil). *@
                    <form method="post" action="/filo-plan/delta" class="inline"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@s.Hedef.Id" />
                        <input type="hidden" name="yon" value="artir" />
                        <button type="submit" class="btn-secondary" title="Hedefi 1 artır">+</button>
                    </form>
                    <form method="post" action="/filo-plan/delta" class="inline"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@s.Hedef.Id" />
                        <input type="hidden" name="yon" value="azalt" />
                        <button type="submit" class="btn-secondary" title="Hedefi 1 azalt (0'ın altına inmez)">−</button>
                    </form>
                    <details>
                        <summary class="link">Düzenle</summary>
                        <form method="post" action="/filo-plan/update" class="grid-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@s.Hedef.Id" />
                            <ComboBox Name="aracGrupAdi" Label="Araç Grubu" Value="@s.Hedef.AracGrupAdi" Options="_grupOpts" ListId="dl-grup-edit" />
                            <label>SIPP<input name="sipp" value="@s.Hedef.Sipp" maxlength="16" /></label>
                            <label>Dönem<input name="donem" value="@s.Hedef.Donem" maxlength="32" /></label>
                            <label>Hedef Adet<input name="hedefAdet" type="number" min="0" value="@s.Hedef.HedefAdet" required /></label>
                            <label class="u-col-full">Açıklama<input name="aciklama" value="@s.Hedef.Aciklama" maxlength="512" /></label>
                            <button type="submit">Kaydet</button>
                        </form>
                    </details>
                    <form method="post" action="/filo-plan/delete" class="inline" data-confirm="Hedef silinsin mi?"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@s.Hedef.Id" />
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
        @if (_list.Count > 0)
        {
            @* Toplam satırı: hedef ve gerçekleşen AYRI toplanır. Fark kolonunun toplamı da bu iki
               toplamın farkıdır — satır farklarının ortalaması/sayısı değil. *@
            <tr class="total-row">
                <td colspan="3"><strong>Toplam</strong></td>
                <td class="num"><strong>@_list.Sum(x => x.Hedef.HedefAdet)</strong></td>
                <td class="num"><strong>@_list.Sum(x => x.Gerceklesen)</strong></td>
                <td class="num muted">@_list.Sum(x => x.ToplamKayitli)</td>
                <td class="num"><strong>@(_list.Sum(x => x.Hedef.HedefAdet) - _list.Sum(x => x.Gerceklesen))</strong></td>
                <td colspan="3"></td>
            </tr>
        }
    </tbody>
</table>
</div>
@if (_list.Count > 0)
{
    <p class="muted small">Toplam satırı hedefleri ve gerçekleşenleri AYRI toplar. Aynı araç birden
        çok hedefe uyabilir (ör. hem "EKO" hem "EDMR"), bu yüzden toplam gerçekleşen filo adedinden
        büyük olabilir — satırlar bağımsız kurallardır, birbirini dışlamaz.</p>
}

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private IReadOnlyList<FiloPlanSatir> _list = [];
    private List<string> _grupOpts = [];

    protected override async Task OnInitializedAsync()
    {
        _list = await Planlar.ListWithSayimAsync();
        _grupOpts = (await Gruplar.ListActiveAsync()).Select(g => g.Kod)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .OrderBy(x => x, StringComparer.CurrentCulture).ToList();
    }
}
