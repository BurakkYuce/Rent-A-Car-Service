@page "/rezervasyonlar"
@attribute [Authorize]
@inject ReservationService Reservations
@inject CustomerService Customers
@inject VehicleService Vehicles
@inject LocationService Locations
@inject ReservationSourceService Kaynaklar
@inject RentACar.Application.TenantSettings.FormDefaultResolver Varsayilanlar

<PageTitle>Rezervasyonlar — RentPro</PageTitle>

@* FAZ-48: export ekrandaki süzgeci AYNEN taşır (gördüğün = indirdiğin) — süzgeç query'si linke eklenir. *@
<div class="page-head"><h1>Rezervasyonlar</h1><div class="actions"><a href="@ExportLink("excel")">Excel</a> · <a href="@ExportLink("csv")">CSV</a> · <a href="@ExportLink("pdf")">PDF</a></div></div>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_rows.Count == 0)">
    <summary>+ Yeni Rezervasyon</summary>
    <form method="post" action="/rezervasyonlar/create" class="grid-form"><AntiforgeryToken />
        <label>Müşteri
            <select name="musteriId" required>
                <option value="">— seç —</option>
                @foreach (var c in _customers)
                {
                    <option value="@c.Id">@c.Ad</option>
                }
            </select>
        </label>
        <label>Araç
            <select name="vehicleId" required>
                <option value="">— seç —</option>
                @foreach (var v in _vehicles)
                {
                    <option value="@v.Id">@v.Plaka</option>
                }
            </select>
        </label>
        <label>Başlangıç<input name="basTar" type="datetime-local" value="@_defaultStart" min="@DateTimeOffset.Now.ToString("yyyy-MM-ddTHH:mm")" max="@DateTimeOffset.Now.AddYears(1).ToString("yyyy-MM-ddTHH:mm")" required /></label>
        <label>Bitiş<input name="bitTar" type="datetime-local" value="@_defBit" max="@DateTimeOffset.Now.AddYears(1).ToString("yyyy-MM-ddTHH:mm")" required /></label>
        <label>Günlük Ücret<input name="gunlukUcret" type="number" step="0.01" placeholder="Otomatik için boş bırakın" /></label>
        @* FAZ-82: tenant "Varsayılan Fiyat Türü" ayarı YALNIZ bu ön-seçimi belirler (ayar boşsa "—",
           yani bugünkü davranış). Operatör dropdown'da görüp değiştirebilir; sunucu bu ayarı okuyup
           kaydın FiyatTuru'sunu türetmez. DÜZENLEME formunda uygulanmaz (aşağıdaki select) — orada
           kaydın kendi değeri seçilidir, ayarın onu değiştirmesi sessiz veri kaybı olurdu. *@
        <label>Fiyat Türü
            <select name="fiyatTuru">
                <option value="" selected="@(_defaultPriceType is null)">—</option>
                @foreach (var o in RentACar.Application.Pricing.PriceTypeOption.All)
                { <option value="@o" selected="@(o == _defaultPriceType)">@o</option> }
            </select>
        </label>
        <details>
            <summary class="link">Ödeme/komisyon (bilgi amaçlı — deftere/bakiyeye yansımaz)</summary>
            <div class="grid-form">
                <label>Provizyon<input name="provizyon" type="number" step="0.01" min="0" /></label>
                <label>Depozito<input name="depozito" type="number" step="0.01" min="0" /></label>
                <label>Komisyon %<input name="komisyonOran" type="number" step="0.01" min="0" /></label>
                <label>Komisyon Tutar<input name="komisyonTutar" type="number" step="0.01" min="0" /></label>
                <label>Drop Ücreti<input name="dropUcreti" type="number" step="0.01" min="0" /></label>
                <label>Sonra Öde %<input name="sonraOdeOran" type="number" step="0.01" min="0" /></label>
            </div>
        </details>
        <label>Çıkış Ofisi
            <select name="cikisOfisi">
                <option value="">—</option>
                @foreach (var o in _locations) { <option>@o.Ad</option> }
            </select>
        </label>
        <label>Dönüş Ofisi
            <select name="donusOfisi">
                <option value="">—</option>
                @foreach (var o in _locations) { <option>@o.Ad</option> }
            </select>
        </label>
        <label>Kaynak
            <select name="kaynak">
                <option value="">—</option>
                @foreach (var k in _sources) { <option>@k.Ad</option> }
            </select>
        </label>
        <label>Kampanya Kodu<input name="kampanyaKodu" maxlength="64" autocomplete="off" placeholder="Yalnız Otomatik'te" /></label>
        @* FAZ-48 — talep/organizasyon bilgisi. Kiraya Çevir'de sözleşmeye AYNEN taşınır. *@
        <label>Talep Türü<input name="talepTuru" maxlength="64" list="rez-talep-turu" autocomplete="off" /></label>
        <label>Geldiği Birim<input name="geldigiBirim" maxlength="64" autocomplete="off" /></label>
        <label>Onay Kodu<input name="onayKodu" maxlength="64" autocomplete="off" /></label>
        <label>Proje Adı<input name="projeAdi" maxlength="128" autocomplete="off" /></label>
        <BrokerBilgisiPanel />
        <button type="submit">Kaydet</button>
    </form>
</details>

@* Talep türü serbest metindir; datalist yalnız yazım kolaylığı (ComboBox konvansiyonu). *@
<datalist id="rez-talep-turu">
    <option value="Bireysel" />
    <option value="Kurumsal" />
    <option value="Sigorta İkame" />
    <option value="Filo" />
</datalist>

@* FAZ-85 kanal filtresi → FAZ-48'de tam arama/filtre barına genişledi. GET formu: JS yok, URL
   paylaşılabilir (?ara=&durum=&bas=&bit=&kaynak=). Süzme SUNUCUDA (SearchAsync) — şube kapsamı
   servis içinde zorlanır, filtre onu GENİŞLETEMEZ. *@
<form method="get" class="filter-bar">
    <label>Ara<input name="ara" value="@Ara" placeholder="Rez No / Müşteri / Plaka" /></label>
    <label>Durum
        <select name="durum">
            <option value="">— tümü —</option>
            @foreach (var d in Enum.GetValues<ReservationStatus>())
            {
                <option value="@d" selected="@(d.ToString() == Durum)">@d</option>
            }
        </select>
    </label>
    <label>Başlangıç (min)<input name="bas" type="date" value="@Bas" /></label>
    <label>Başlangıç (max)<input name="bit" type="date" value="@Bit" /></label>
    <label>Kaynak
        <select name="kaynak">
            <option value="">— tümü —</option>
            @foreach (var k in _sources)
            {
                <option value="@k.Ad" selected="@(string.Equals(k.Ad, Kaynak, StringComparison.OrdinalIgnoreCase))">@k.Ad</option>
            }
        </select>
    </label>
    <button type="submit">Filtrele</button>
    @if (SuzgecVar)
    {
        <a class="link" href="/rezervasyonlar">Temizle</a>
    }
</form>

<div class="table-scroll">
@* kart-mobil: 640px altında satır karta döner. Kartta YALNIZ data-etiket taşıyan hücreler görünür —
   16 kolonun tamamı kartta 16 satır olurdu. Seçilenler: kimi/neyi (müşteri, araç), ne zaman
   (başlangıç + teslim), ne kadar ve hangi durumda. *@
<table class="grid tr-grid kart-mobil">
    <thead>
        <tr><th>No</th><th>Müşteri</th><th>Cep Tel</th><th>Araç</th><th>Başlangıç</th><th>Teslim</th><th>Alış Şube</th><th>Kaynak</th>
            <th>Talep Türü</th><th>Geldiği Birim</th><th>Proje</th><th>Onay Kodu</th>
            <th>Gün</th><th>Tutar</th><th>Durum</th><th></th></tr>
    </thead>
    <tbody>
        @if (_rows.Count == 0)
        {
            <tr><td colspan="16" class="muted">Rezervasyon yok.</td></tr>
        }
        @foreach (var row in _rows)
        {
            var r = row.Rez;
            <tr>
                <td class="kart-baslik">@r.ReservationNo</td>
                <td data-etiket="Müşteri">@row.MusteriAd</td>
                <td>@(row.CepTel ?? "—")</td>
                <td data-etiket="Araç">@row.Plaka</td>
                @* Birleşik "Tarih" hücresi ayrıştırıldı: başlangıç ve teslim ayrı kolonlarda —
                   bilgi kaybı yok, teslim tarihine göre bakmak kolaylaştı. *@
                <td data-etiket="Başlangıç">@r.BasTar.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                <td data-etiket="Teslim">@r.BitTar.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@(r.CikisOfisi ?? "—")</td>
                <td>@(r.Kaynak ?? "—")</td>
                @* FAZ-48 — talep/organizasyon bilgisi (bilgi alanları; hesaba girmez). *@
                <td>@(r.TalepTuru ?? "—")</td>
                <td>@(r.GeldigiBirim ?? "—")</td>
                <td>@(r.ProjeAdi ?? "—")</td>
                <td>@(r.OnayKodu ?? "—")</td>
                <td>@r.Gun</td>
                <td data-etiket="Tutar">@r.Tutar.ToString("N2")</td>
                @* FAZ-81: "Opsiyonlu" (henüz onaylanmamış tutma) tenant rengiyle ayrışır.
                   Renk seçilmemişse değişken tanımsız → nötr rozete düşer, eski görünüm korunur. *@
                <td data-etiket="Durum">
                    @if (r.Durum == ReservationStatus.Rezerv)
                    {
                        <span class="status-pill" style="color:var(--tr-renk-opsiyonlu, var(--text-muted));background:var(--tr-renk-opsiyonlu-soft, var(--surface-2));border-color:var(--tr-renk-opsiyonlu, var(--border))">@r.Durum</span>
                    }
                    else
                    {
                        @r.Durum
                    }
                </td>
                <td class="row-actions kart-aksiyon">
                    @if (r.Durum == ReservationStatus.Rezerv)
                    {
                        <form method="post" action="/rezervasyonlar/confirm"><AntiforgeryToken /><input type="hidden" name="id" value="@r.Id" /><button class="link">Onayla</button></form>
                    }
                    @if (r.Durum is ReservationStatus.Rezerv or ReservationStatus.Onayli)
                    {
                        <form method="post" action="/rezervasyonlar/convert"><AntiforgeryToken /><input type="hidden" name="id" value="@r.Id" /><button class="link">Kiraya Çevir</button></form>
                        @* Yetki çiti: bu uç grup kapısından DAHA DAR bir izin istiyor (UcIzinKapsamaTests). Kapılanmazsa kullanıcı düğmeyi açık görür, basar, 403 alır ve /yetkisiz'e düşer. *@
                        <AuthorizeView Policy="izin:OperationsDelete" Context="iptalCtx">
                            <form method="post" action="/rezervasyonlar/cancel" data-confirm="@r.ReservationNo numaralı rezervasyon iptal edilsin mi? Rezervasyon İptal durumuna geçer; bir daha onaylanamaz ve kiraya çevrilemez."><AntiforgeryToken /><input type="hidden" name="id" value="@r.Id" /><button class="link danger">İptal</button></form>
                        </AuthorizeView>
                        <details>
                            <summary>Düzenle</summary>
                            <form method="post" action="/rezervasyonlar/update" class="grid-form"><AntiforgeryToken />
                                <input type="hidden" name="id" value="@r.Id" />
                                <label>Müşteri
                                    <select name="musteriId" required>
                                        @foreach (var c in _customers) { <option value="@c.Id" selected="@(c.Id == r.MusteriId)">@c.Ad</option> }
                                    </select>
                                </label>
                                <label>Araç
                                    <select name="vehicleId" required>
                                        @foreach (var v in _vehicles) { <option value="@v.Id" selected="@(v.Id == r.VehicleId)">@v.Plaka</option> }
                                    </select>
                                </label>
                                <label>Başlangıç<input name="basTar" type="datetime-local" value="@r.BasTar.LocalDateTime.ToString("yyyy-MM-ddTHH:mm")" min="@DateTimeOffset.Now.ToString("yyyy-MM-ddTHH:mm")" max="@DateTimeOffset.Now.AddYears(1).ToString("yyyy-MM-ddTHH:mm")" required /></label>
                                <label>Bitiş<input name="bitTar" type="datetime-local" value="@r.BitTar.LocalDateTime.ToString("yyyy-MM-ddTHH:mm")" max="@DateTimeOffset.Now.AddYears(1).ToString("yyyy-MM-ddTHH:mm")" required /></label>
                                <label>Günlük Ücret<input name="gunlukUcret" type="number" step="0.01" min="0" value="@r.GunlukUcret" required /></label>
                                @* Adversarial A5-B2: fiyatTuru edit formunda YOKTU → kodlu rezervasyon
                                   düzenlenemiyordu (kod+manuel red kilidi); kod doluysa Otomatik önseçili. *@
                                <label>Fiyat Türü
                                    <select name="fiyatTuru">
                                        <option value="">—</option>
                                        @foreach (var o in new[] { "Otomatik", "KDV Dahil Günlük", "Günlük", "KDV Dahil Toplam", "Toplam" })
                                        { <option value="@o" selected="@(o == r.FiyatTuru || (r.FiyatTuru == null && o == "Otomatik" && !string.IsNullOrEmpty(r.KampanyaKodu)))">@o</option> }
                                    </select>
                                </label>
                                <label>Kaynak
                                    <select name="kaynak">
                                        <option value="">—</option>
                                        @foreach (var k in _sources) { <option selected="@(k.Ad == r.Kaynak)">@k.Ad</option> }
                                    </select>
                                </label>
                                <label>Kampanya Kodu<input name="kampanyaKodu" maxlength="64" autocomplete="off" value="@r.KampanyaKodu" /></label>
                                @* FAZ-48 — talep/organizasyon bilgisi (create formuyla AYNI alan adları;
                                   düzenlemede prefill edilmezse kayıt her güncellemede silinirdi). *@
                                <label>Talep Türü<input name="talepTuru" maxlength="64" list="rez-talep-turu" autocomplete="off" value="@r.TalepTuru" /></label>
                                <label>Geldiği Birim<input name="geldigiBirim" maxlength="64" autocomplete="off" value="@r.GeldigiBirim" /></label>
                                <label>Onay Kodu<input name="onayKodu" maxlength="64" autocomplete="off" value="@r.OnayKodu" /></label>
                                <label>Proje Adı<input name="projeAdi" maxlength="128" autocomplete="off" value="@r.ProjeAdi" /></label>
                                <BrokerBilgisiPanel KiraBedeli="r.OtaKiraBedeli" DropBedeli="r.OtaDropBedeli"
                                    BebekKoltugu="r.OtaBebekKoltugu" Navigasyon="r.OtaNavigasyon" Lcf="r.OtaLcf"
                                    Cdw="r.OtaCdw" Scdw="r.OtaScdw" EkSurucu="r.OtaEkSurucu" />
                                <button type="submit">Kaydet</button>
                            </form>
                        </details>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    /// <summary>FAZ-85 — kanal filtresi (?kaynak=Web). Boş = tümü. FAZ-48'de barın parçası oldu; ad
    /// KORUNDU (paylaşılmış URL'ler bozulmasın).</summary>
    [SupplyParameterFromQuery(Name = "kaynak")] public string? Kaynak { get; set; }
    /// <summary>FAZ-48 — serbest arama: Rez No / müşteri adı / plaka (içeren, case-insensitive).</summary>
    [SupplyParameterFromQuery(Name = "ara")] public string? Ara { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }
    /// <summary>Başlangıç tarihi alt/üst sınırı (takvim günü; üst sınır GÜN DAHİL).</summary>
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }

    private IReadOnlyList<ReservationRow> _rows = [];
    private IReadOnlyList<CariSecim> _customers = [];
    private IReadOnlyList<Vehicle> _vehicles = [];
    private IReadOnlyList<Location> _locations = [];
    private IReadOnlyList<ReservationSource> _sources = [];
    // FAZ-85'in ad/plaka/telefon sözlükleri KALDIRILDI: FAZ-48 ile satırın kendisi bu alanları
    // taşıyor (SearchAsync projeksiyonu), sözlükler ölü koda dönüştü.
    private string? _defaultPriceType;                     // FAZ-82: yalnız YENİ rezervasyon formunun ön-seçimi
    private readonly string _defaultStart = DateTime.Now.ToString("yyyy-MM-ddT09:00");
    private readonly string _defBit = DateTime.Now.AddDays(3).ToString("yyyy-MM-ddT09:00");

    private bool SuzgecVar => !string.IsNullOrWhiteSpace(Kaynak) || !string.IsNullOrWhiteSpace(Ara)
        || !string.IsNullOrWhiteSpace(Durum) || !string.IsNullOrWhiteSpace(Bas) || !string.IsNullOrWhiteSpace(Bit);

    protected override async Task OnInitializedAsync()
    {
        // FAZ-48: süzme SUNUCUDA. Şube kapsamı SearchAsync içinde zorlanır (ekran genişletemez).
        _rows = await Reservations.SearchAsync(Filter());
        // Müşteri dropdown'ı PII'siz seçim listesinden (ListAsync PII çözer — liste ekranında gereksiz
        // şifre çözme + açılışta uyarı fırtınası üretir). Ad/telefon kolonları artık satırdan geliyor.
        _customers = await Customers.ListForSelectAsync();
        _vehicles = await Vehicles.ListAsync();
        _locations = await Locations.ListActiveAsync();
        _sources = await Kaynaklar.ListActiveAsync();
        _defaultPriceType = await Varsayilanlar.PriceTypeAsync(); // FAZ-82 (ayar yoksa null = "—")
    }

    private ReservationFilter Filter() => new()
    {
        Query = string.IsNullOrWhiteSpace(Ara) ? null : Ara,
        Durum = Enum.TryParse<ReservationStatus>(Durum, out var d) ? d : null,
        TarihMin = FormParse.Date(Bas),
        // "Bitiş günü DAHİL" konvansiyonu: seçilen günün 23:59:59.9999999'una taşınır.
        TarihMax = FormParse.Date(Bit)?.AddDays(1).AddTicks(-1),
        Kaynak = string.IsNullOrWhiteSpace(Kaynak) ? null : Kaynak
    };

    /// <summary>Export linki ekrandaki süzgeci AYNEN taşır (gördüğün = indirdiğin).</summary>
    private string ExportLink(string format)
    {
        var q = new List<string>();
        if (format != "excel") q.Add($"format={format}");
        if (!string.IsNullOrWhiteSpace(Ara)) q.Add($"ara={Uri.EscapeDataString(Ara)}");
        if (!string.IsNullOrWhiteSpace(Durum)) q.Add($"durum={Uri.EscapeDataString(Durum)}");
        if (!string.IsNullOrWhiteSpace(Bas)) q.Add($"bas={Uri.EscapeDataString(Bas)}");
        if (!string.IsNullOrWhiteSpace(Bit)) q.Add($"bit={Uri.EscapeDataString(Bit)}");
        if (!string.IsNullOrWhiteSpace(Kaynak)) q.Add($"kaynak={Uri.EscapeDataString(Kaynak)}");
        return "/listeler/export/rezervasyonlar" + (q.Count == 0 ? "" : "?" + string.Join("&", q));
    }
}
