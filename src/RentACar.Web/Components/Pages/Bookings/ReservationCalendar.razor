@page "/takvim"
@attribute [Authorize(Roles = "Admin,Yonetici,Operator")]
@inject CalendarService Calendar
@inject VehicleService Vehicles
@inject BranchService Subeler

<PageTitle>Rezervasyon Takvimi — RentPro</PageTitle>

<div class="page-head"><h1>Rezervasyon Takvimi</h1><div class="actions"></div></div>

<div class="filter-bar">
    <a href="@AyUrl(_prev)">← @_prevLabel</a>
    <strong>@_monthStart.ToString("MMMM yyyy")</strong>
    <a href="@AyUrl(_next)">@_nextLabel →</a>
</div>

@* FAZ-11: canlı arac_rac_takvim'in AracGrubu/Bölge/arama filtreleri. Doluluk sorgusu
   (CalendarService.GetOccupancyAsync) DEĞİŞMEZ — yalnız gösterilecek ARAÇ kümesi daraltılır;
   böylece takvimin doğruluğu tek bir kaynaktan gelmeye devam eder. *@
<div class="filter-panel">
    <form method="get" class="filter-bar">
        <input type="hidden" name="ay" value="@Ay" />
        <input name="plaka" value="@Plaka" placeholder="Plaka / marka ara" />
        <input name="grup" value="@Grup" list="takvim-grup-list" placeholder="Grup" />
        <select name="sube">
            <option value="">Şube / bölge (tümü)</option>
            @foreach (var b in _subeAdlari)
            {
                <option value="@b" selected="@(Sube == b)">@b</option>
            }
        </select>
        <button type="submit">Filtrele</button>
        <span class="count-badge">Araç: @_vehicles.Count</span>
        @if (!string.IsNullOrEmpty(Plaka) || !string.IsNullOrEmpty(Grup) || !string.IsNullOrEmpty(Sube))
        {
            <a href="@("/takvim?ay=" + Uri.EscapeDataString(_monthStart.ToString("yyyy-MM")))" class="link">Temizle</a>
        }
    </form>
</div>

<datalist id="takvim-grup-list">
    @foreach (var g in _grupAdlari)
    {
        <option value="@g"></option>
    }
</datalist>

<div class="cal-legend">
    <span><i class="cal rez" style="border:1px solid #e2e5ea;background:#fde68a"></i> Rezervasyon</span>
    <span><i class="cal kira" style="border:1px solid #e2e5ea;background:#93c5fd"></i> Kira</span>
</div>

<div class="cal-wrap">
    <table class="cal">
        <thead>
            <tr>
                <th class="veh">Araç</th>
                @for (var d = 1; d <= _days; d++)
                {
                    var date = new DateTime(_monthStart.Year, _monthStart.Month, d);
                    <th class="@(IsWeekend(date) ? "we" : null)">@d</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (_vehicles.Count == 0)
            {
                <tr><td class="veh">—</td><td colspan="@_days" class="muted">Araç yok.</td></tr>
            }
            @foreach (var v in _vehicles)
            {
                <tr>
                    <td class="veh">@v.Plaka</td>
                    @for (var d = 1; d <= _days; d++)
                    {
                        var date = new DateTime(_monthStart.Year, _monthStart.Month, d);
                        var kind = Occupancy(v.Id, date);
                        var cls = kind switch { "Kira" => "kira", "Rezervasyon" => "rez", _ => IsWeekend(date) ? "we" : null };
                        var title = kind is null ? null : $"{v.Plaka} — {kind}";
                        <td class="@cls" title="@title">@(kind == "Kira" ? "K" : kind == "Rezervasyon" ? "R" : "")</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="muted small">Sarı = rezervasyon (Rezerv/Onaylı), mavi = aktif kira. Kira önceliklidir.
    Operatör yalnız atanmış şubesini görür.</p>

@code {
    [SupplyParameterFromQuery(Name = "ay")] public string? Ay { get; set; }
    // FAZ-11 araç kümesi filtreleri
    [SupplyParameterFromQuery(Name = "plaka")] public string? Plaka { get; set; }
    [SupplyParameterFromQuery(Name = "grup")] public string? Grup { get; set; }
    [SupplyParameterFromQuery(Name = "sube")] public string? Sube { get; set; }

    private DateTime _monthStart;
    private int _days;
    private string _prev = "", _next = "", _prevLabel = "", _nextLabel = "";
    private IReadOnlyList<Vehicle> _vehicles = [];
    private IReadOnlyList<string> _subeAdlari = [];
    private IReadOnlyList<string> _grupAdlari = [];
    // (VehicleId, gün) → tip; çakışmada Kira önceliklidir.
    private readonly Dictionary<(Guid, int), string> _grid = new();

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.Now;
        var anchor = DateTime.TryParse($"{Ay}-01", out var p) ? p : new DateTime(now.Year, now.Month, 1);
        _monthStart = new DateTime(anchor.Year, anchor.Month, 1);
        _days = DateTime.DaysInMonth(_monthStart.Year, _monthStart.Month);

        var prev = _monthStart.AddMonths(-1);
        var next = _monthStart.AddMonths(1);
        _prev = prev.ToString("yyyy-MM"); _prevLabel = prev.ToString("MMM");
        _next = next.ToString("yyyy-MM"); _nextLabel = next.ToString("MMM");

        var from = new DateTimeOffset(_monthStart, TimeSpan.Zero);
        var to = new DateTimeOffset(_monthStart.AddMonths(1), TimeSpan.Zero);

        // FAZ-11: araç kümesi filtreli çekilir. PageSize 500 — takvim satır satır çizilen bir
        // ızgara; daha fazlası zaten okunamaz, sessizce kırpmak yerine kullanıcı filtreye yönlendirilir.
        var filtre = new VehicleFilter
        {
            Query = string.IsNullOrWhiteSpace(Plaka) ? null : Plaka,
            Grup = string.IsNullOrWhiteSpace(Grup) ? null : Grup,
            Sube = string.IsNullOrWhiteSpace(Sube) ? null : Sube,
            Page = 1, PageSize = 200
        };
        _vehicles = (await Vehicles.SearchAsync(filtre)).Items;

        // Filtre kutularının önerileri: şube master + araçlarda geçen grup adları.
        _subeAdlari = (await Subeler.ListActiveAsync()).Select(s => s.Ad).ToList();
        _grupAdlari = (await Vehicles.ListAsync()).Select(v => v.Grup)
            .Where(g => !string.IsNullOrWhiteSpace(g)).Select(g => g!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(g => g, StringComparer.CurrentCulture).ToList();

        var spans = await Calendar.GetOccupancyAsync(from, to);

        foreach (var s in spans)
        {
            for (var d = 1; d <= _days; d++)
            {
                var dayStart = new DateTimeOffset(new DateTime(_monthStart.Year, _monthStart.Month, d), TimeSpan.Zero);
                var dayEnd = dayStart.AddDays(1);
                // Gün ile span yarı-açık kesişimi.
                if (s.Bas < dayEnd && dayStart < s.Bit)
                {
                    var key = (s.VehicleId, d);
                    // Kira, rezervasyonu ezer (öncelik).
                    if (s.Tip == "Kira" || !_grid.ContainsKey(key))
                        _grid[key] = s.Tip;
                }
            }
        }
    }

    /// <summary>Ay gezinme bağlantısı — aktif araç filtrelerini KORUR (ay değiştirince filtre
    /// sıfırlansaydı kullanıcı her ayda filtreyi yeniden kurardı).</summary>
    private string AyUrl(string ay)
    {
        var qs = new List<string> { $"ay={Uri.EscapeDataString(ay)}" };
        if (!string.IsNullOrEmpty(Plaka)) qs.Add($"plaka={Uri.EscapeDataString(Plaka)}");
        if (!string.IsNullOrEmpty(Grup)) qs.Add($"grup={Uri.EscapeDataString(Grup)}");
        if (!string.IsNullOrEmpty(Sube)) qs.Add($"sube={Uri.EscapeDataString(Sube)}");
        return "/takvim?" + string.Join("&", qs);
    }

    private string? Occupancy(Guid vehicleId, DateTime date)
        => _grid.GetValueOrDefault((vehicleId, date.Day));

    private static bool IsWeekend(DateTime d)
        => d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
}
