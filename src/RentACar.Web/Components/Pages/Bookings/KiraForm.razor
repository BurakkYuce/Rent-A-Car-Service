@page "/kiralar/yeni"
@page "/kiralar/{Id:guid}"
@attribute [Authorize]
@using RentACar.Application.Availability
@using RentACar.Web.Components.Pages.Bookings.KiraFormPaneller
@inject RentalService Rentals
@inject CustomerService Customers
@inject VehicleService Vehicles
@inject LocationService Locations
@inject AvailabilityService Availability
@inject EkHizmetTanimService EkHizmetler
@inject CoverageProductService Sigortalar
@inject ReservationSourceService Kaynaklar
@inject CustomCodeService OzelKodlar
@inject RentACar.Application.Kur.KurService Kurlar
@inject RentACar.Application.RentalAddOns.RentalAddOnService AddOns
@inject InvoiceService Faturalar
@inject PenaltyService Cezalar
@inject PersonelService Personeller

<PageTitle>@(_vm.Edit ? $"Kira {_vm.Rental!.SozlesmeNo}" : "Yeni Kira") — RentPro</PageTitle>

@* Kira mega-formu (referans sistem Kiralama.Aspx paritesi): 8 ana sekme + Ayrıntılar'da 8 alt-sekme + sticky alt
   panel. TEK EKRAN: /kiralar/yeni (create) + /kiralar/{id} (edit/operasyon — RentalDetail'in yerine geçti).
   STATİK SSR — ana form panelleri sarar; ikincil işlem formları (teslim/dönüş/uzat/ek hizmet) ana formun
   DIŞINDA tanımlı, kontrolleri panellerde form= attribute'üyle bağlı (iç içe form YOK). Canlı hesap
   SUNUCU motorundan (create: /kiralar/hesapla; dönüş: /kiralar/donus-hesapla). *@

@if (_bulunamadi)
{
    <p class="error">Kira sözleşmesi bulunamadı.</p>
    <a href="/kiralar">← Listeye dön</a>
}
else
{
<div class="page-head">
    <h1>@(_vm.Edit ? $"Kira {_vm.Rental!.SozlesmeNo}" : "Yeni Kira") @(_vm.Edit ? "" : "")@if (_vm.Edit) { <span class="badge">@_vm.Rental!.Durum</span> }</h1>
    <div class="actions">
        @if (_vm.Edit)
        {
            @* PDF: varsayılan GÖRÜNTÜLE (indirme klasörü dolmaz); Yazdır gizli-iframe print; İndir isteğe bağlı *@
            <a href="/kiralar/@Id/pdf" target="_blank">Sözleşme: Görüntüle</a><span> · </span>
            <a href="#" data-pdf-yazdir="/kiralar/@Id/pdf">Yazdır</a><span> · </span>
            <a href="/kiralar/@Id/pdf?indir=1">İndir</a><span> · </span>
            <a href="/cariler/@_vm.Rental!.MusteriId/ekstre">Cari Ekstre</a><span> · </span>
            <a href="/kiralar/yeni"><strong>+ Yeni Kira</strong></a><span> · </span>
        }
        <a href="/kiralar">Kira Listesi</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }
@if (Ok == "1") { <p class="ok">Kaydedildi.</p> }
@if (_vm.Edit && !string.IsNullOrEmpty(_vm.DovizNot)) { <p class="muted small">@_vm.DovizNot</p> }
@if (_vm.Edit && !string.IsNullOrWhiteSpace(_vm.Rental!.UyariAciklama)) { <p class="error"><strong>UYARI:</strong> @_vm.Rental!.UyariAciklama</p> }

@if (_vm.Edit)
{
    @* Paylaşım barı: numara/e-posta DÜZENLENEBİLİR (kayıtlı değer prefill; farklı numaraya/adrese de
       gönderilebilir). WhatsApp → wa.me, E-posta → GMAIL compose yönlendirmesi (mailto değil). Hazır
       özet metin data-attr'da; PDF eki elle (medya/ek göndermek Twilio/SMTP kimliği ister — stub). *@
    <div class="card kf-paylas" data-paylas data-mesaj="@_paylasMesaj" data-konu="@_paylasKonu">
        <strong>Paylaş</strong>
        <label>Numara (GSM)
            <input data-paylas-tel value="@_musteriTel" placeholder="05xx xxx xx xx" style="min-width:11rem;" />
        </label>
        <button type="button" class="kf-btn-ghost" data-paylas-wa title="Girilen numaraya hazır özet mesajla WhatsApp açar; PDF'i konuşmada eklersiniz">WhatsApp'ta Aç</button>
        <label>E-posta
            <input data-paylas-mail type="email" value="@_musteriEmail" placeholder="ornek@mail.com" style="min-width:13rem;" />
        </label>
        <button type="button" class="kf-btn-ghost" data-paylas-gmail title="Gmail taslağını hazır konu/metinle açar; PDF'i taslağa eklersiniz">Gmail'de Aç</button>
        <span data-paylas-hata class="small" style="align-self:center;"></span>
    </div>
}

<div class="kf-tabs" role="tablist" data-tabs="sekme">
    <button type="button" role="tab" data-tab="hizli" aria-selected="true">Hızlı Giriş</button>
    <button type="button" role="tab" data-tab="kira" aria-selected="false">Kira Bilgisi/Teslimat</button>
    <button type="button" role="tab" data-tab="musteri" aria-selected="false">Müşteri</button>
    <button type="button" role="tab" data-tab="arac" aria-selected="false">Araç</button>
    <button type="button" role="tab" data-tab="fiyat" aria-selected="false">Fiyat/Toplam</button>
    <button type="button" role="tab" data-tab="ekhizmet" aria-selected="false">Ek Hizmetler</button>
    <button type="button" role="tab" data-tab="ayrintilar" aria-selected="false">Ayrıntılar</button>
    <button type="button" role="tab" data-tab="donus" aria-selected="false">Dönüş</button>
</div>

<form id="kira-form" method="post" action="@(_vm.Edit ? "/kiralar/update" : "/kiralar/create")"
      data-mode="@(_vm.Edit ? "edit" : "create")" data-rental-id="@(Id?.ToString() ?? "")">
    <AntiforgeryToken />
    @if (_vm.Edit)
    {
        <input type="hidden" name="id" value="@Id" />
        <input type="hidden" name="sekme" value="hizli" data-kf-sekme />
    }
    <SekmeHizliGiris Vm="_vm" />
    <SekmeKiraBilgisi Vm="_vm" />
    <SekmeMusteri Vm="_vm" />
    <SekmeArac Vm="_vm" />
    <SekmeFiyat Vm="_vm" />
    <SekmeEkHizmet Vm="_vm" />
    <SekmeAyrintilar Vm="_vm" />
    <SekmeDonus Vm="_vm" />
</form>

@* Müsaitlik GET alt-formu — ana formun DIŞINDA (iç içe form yasak); Araç sekmesindeki inputlar form= ile bağlı. *@
<form id="musait-form" method="get" action="/kiralar/yeni">
    @* Yenilemede müşteri seçimi KORUNUR: JS submit'te seçili musteriId'yi buraya kopyalar → query → preselect *@
    <input type="hidden" name="musteriId" value="" />
</form>

@* İkincil işlem formları (edit) — ana formun DIŞINDA; görünür kontrolleri sekme panellerinde form= ile. *@
@if (_vm.Edit)
{
    <form id="kira-teslim" method="post" action="/kiralar/teslim"><AntiforgeryToken /><input type="hidden" name="id" value="@Id" /></form>
    <form id="kira-donus" method="post" action="/kiralar/donus"><AntiforgeryToken /><input type="hidden" name="id" value="@Id" /></form>
    <form id="kira-uzat" method="post" action="/kiralar/uzat"><AntiforgeryToken /><input type="hidden" name="id" value="@Id" /></form>
    <form id="kira-ekhizmet" method="post" action="/kiralar/ekhizmet-ekle"><AntiforgeryToken /><input type="hidden" name="rentalId" value="@Id" /></form>
    @foreach (var a in _vm.Kalemler)
    {
        <form id="ekhizmet-sil-@a.Id" method="post" action="/kiralar/ekhizmet-sil" onsubmit="return confirm('Ek hizmet silinsin mi?')">
            <AntiforgeryToken /><input type="hidden" name="addOnId" value="@a.Id" /><input type="hidden" name="rentalId" value="@Id" />
        </form>
    }
    @if (_vm.Kirada)
    {
        <form id="kira-iptal" method="post" action="/kiralar/cancel" onsubmit="return confirm('Kira iptal edilsin mi?')">
            <AntiforgeryToken /><input type="hidden" name="id" value="@Id" />
        </form>
    }
}

<StickyPanel Vm="_vm" />

@* Arama datalist'leri (JS id-çözümü: option value birebir eşleşince data-id hedefe yazılır) *@
<datalist id="dl-kf-musteri">
    @foreach (var c in _vm.Customers)
    {
        <option value="@KiraFormVm.MusteriGoruntu(c)" data-id="@c.Id"></option>
    }
</datalist>
<datalist id="dl-kf-arac">
    @foreach (var v in _vm.Vehicles)
    {
        <option value="@KiraFormVm.AracGoruntu(v)" data-id="@v.Id"
                data-marka="@v.Marka" data-tip="@v.Tip" data-yil="@(v.ModelYili?.ToString() ?? "")"
                data-vites="@(v.Vites?.ToString() ?? "")" data-yakit="@v.Yakit" data-grup="@v.Grup"
                data-segment="@v.Segment" data-km="@v.Km" data-sube="@v.Sube"></option>
    }
</datalist>
<datalist id="dl-kf-kaynak">
    @foreach (var k in _vm.Kaynaklar) { <option value="@k"></option> }
</datalist>
<datalist id="dl-kf-ozelkod">
    @foreach (var k in _vm.OzelKodlar) { <option value="@k"></option> }
</datalist>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "vfrom")] public string? Vfrom { get; set; }
    [SupplyParameterFromQuery(Name = "vto")] public string? Vto { get; set; }
    [SupplyParameterFromQuery(Name = "vgrup")] public string? Vgrup { get; set; }
    [SupplyParameterFromQuery(Name = "musteriId")] public string? MusteriIdQ { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private readonly KiraFormVm _vm = new();
    private bool _bulunamadi;
    // Paylaşım barı prefill'leri (kutular düzenlenebilir — kayıtlı değer yalnız başlangıç değeri)
    private string _musteriTel = "";
    private string _musteriEmail = "";
    private string _paylasMesaj = "";
    private string _paylasKonu = "";

    protected override async Task OnInitializedAsync()
    {
        // Edit modu: ÖNCE şube-kapsamlı GetAsync (adversarial kapı) — başarısızsa hiçbir liste yüklenmez.
        if (Id is Guid rid)
        {
            _vm.Rental = await Rentals.GetAsync(rid);
            if (_vm.Rental is null) { _bulunamadi = true; return; }
        }

        // Rol yetkileri: butonlar 403 sürprizi yerine disabled + not (sunucu guard'ları asıl savunma).
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _vm.FinansYetkisi = RolePermissions.RolesWith(Permission.FinanceWrite).Any(user.IsInRole);
            _vm.OperasyonYetkisi = RolePermissions.RolesWith(Permission.OperationsWrite).Any(user.IsInRole);
        }

        _vm.Customers = await Customers.ListAsync();
        _vm.Locations = await Locations.ListActiveAsync();
        _vm.EkHizmetler = await EkHizmetler.ListActiveAsync();
        _vm.Sigortalar = await Sigortalar.ListActiveAsync();
        _vm.Kaynaklar = (await Kaynaklar.ListActiveAsync()).Select(k => k.Ad).ToList();
        _vm.OzelKodlar = (await OzelKodlar.ListActiveAsync()).Select(k => k.Ad).ToList();
        _vm.Kurlar = await Kurlar.BugunKurlarAsync();
        _vm.Vfrom = Vfrom; _vm.Vto = Vto; _vm.Vgrup = Vgrup;
        _vm.QMusteriId = Guid.TryParse(MusteriIdQ, out var qm) ? qm : null; // müsaitlik yenilemesinde seçim korunur

        if (_vm.Edit)
        {
            var c = _vm.Rental!;
            _vm.Kalemler = await AddOns.ListAsync(c.Id);
            _vm.Faturalar = await Faturalar.ListByRentalAsync(c.Id); // GetAsync kapısından SONRA (kapsam)
            _vm.Cezalar = await Cezalar.ListByRentalAsync(c.Id);
            // Personel seçim listesi (dönüş formu + teslim-alan adı) — PII'sız projeksiyon; OperationsWrite'ı
            // olmayan rol (Muhasebe) sayfayı YİNE açabilsin diye nazikçe boş bırakılır (eski RentalDetail
            // ManageUsers'lı ListAsync ile Operatör'de bile patlıyordu — kök çözüm PR-A ListForSelectAsync).
            try { _vm.Personeller = await Personeller.ListForSelectAsync(); }
            catch (RentACar.Application.Common.ValidationException) { /* yetkisiz rol → ad çözülmez, form gizli */ }
            if (c.TeslimAlanPersonelId is Guid tp)
                _vm.TeslimAlanAd = _vm.Personeller.FirstOrDefault(p => p.Id == tp) is { } ps ? $"{ps.Ad} {ps.Soyad}" : null;

            // Paylaşım barı: kayıtlı GSM/e-posta prefill (kutular düzenlenebilir) + hazır özet metin.
            var musteri = _vm.Customers.FirstOrDefault(x => x.Id == c.MusteriId);
            _musteriTel = musteri?.CepTel ?? "";
            _musteriEmail = musteri?.Email ?? "";
            _paylasKonu = $"Kira Sözleşmesi {c.SozlesmeNo}";
            _paylasMesaj = $"Sayın {musteri?.DisplayName}, {c.SozlesmeNo} nolu kira sözleşmeniz: " +
                           $"{c.BasTar.LocalDateTime:dd.MM.yyyy} - {c.BitTar.LocalDateTime:dd.MM.yyyy}, " +
                           $"genel toplam {c.GenelToplam:N2} {c.Doviz ?? "TL"}.";

            // Döviz kira → güncel kurla TL karşılığı (bilgi; fatura kuru kesim anında sabitlenir).
            var doviz = RentACar.Application.Kur.KurService.NormalizeKod(c.Doviz);
            if (doviz != "TRY")
            {
                try { _vm.DovizNot = $"{doviz} · güncel ≈ {(c.GenelToplam * await Kurlar.GetRateAsync(doviz)).ToString("N2")} TL"; }
                catch { _vm.DovizNot = $"{doviz} · güncel kur yok"; }
            }


            _vm.Vehicles = await Vehicles.ListAsync(); // araç kartı prefill (değişmez — whitelist dışı)
            return;
        }

        // Create: müsaitlik penceresi (vfrom<vto) → araç listesi yalnız müsait araçlar (PR#26 deseni:
        // UTC gün-başı — Npgsql timestamptz offset-0 ister; guard: FindAvailableAsync to<=from'da fırlatır).
        var vf = DateTimeOffset.TryParse(Vfrom, out var a) ? new DateTimeOffset(a.Date, TimeSpan.Zero) : (DateTimeOffset?)null;
        var vt = DateTimeOffset.TryParse(Vto, out var b) ? new DateTimeOffset(b.Date, TimeSpan.Zero) : (DateTimeOffset?)null;
        if (vf is { } vff && vt is { } vtt && vtt > vff)
        {
            _vm.Vehicles = await Availability.FindAvailableAsync(vff, vtt, string.IsNullOrWhiteSpace(Vgrup) ? null : Vgrup);
            _vm.MusaitMod = true;
        }
        else
        {
            _vm.Vehicles = await Vehicles.ListAsync();
        }
    }
}
