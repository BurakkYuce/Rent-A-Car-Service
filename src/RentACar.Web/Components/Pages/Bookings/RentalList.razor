@page "/kiralar"
@attribute [Authorize]
@inject RentalService Rentals
@inject LocationService Locations
@inject RentACar.Application.Finance.CashService Cash
@inject ReservationSourceService Kaynaklar
@inject PersonnelService Personeller
@inject VehicleService Vehicles

<PageTitle>Kira Sözleşmeleri — RentPro</PageTitle>

<div class="page-head"><h1>Kira Sözleşmeleri</h1><div class="actions"><a href="/kiralar/yeni"><strong>+ Yeni Kira</strong></a> · <a href="/listeler/export/kiralar">Excel</a> · <a href="/listeler/export/kiralar?format=csv">CSV</a> · <a href="/listeler/export/kiralar?format=pdf">PDF</a> · <a href="/kiralar/ornek-sozlesme/pdf" target="_blank">Örnek Sözleşme (PDF)</a></div></div>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

@* Yeni kira: /kiralar/yeni mega-formu (8 sekme + sticky panel). Inline form oraya taşındı. *@

<div class="filter-panel">
<form method="get" class="filter-bar">
    <input name="q" value="@Q" placeholder="Sözleşme / müşteri / plaka ara" />
    <select name="durum">
        <option value="">Durum (tümü)</option>
        @foreach (var s in Enum.GetValues<RentalStatus>())
        {
            <option value="@s" selected="@(Durum == s.ToString())">@s</option>
        }
    </select>
    <select name="fatura">
        <option value="">Fatura (tümü)</option>
        <option value="true" selected="@(Fatura == "true")">Faturalı</option>
        <option value="false" selected="@(Fatura == "false")">Faturasız</option>
    </select>
    @* FAZ-46 — tarih aralığı hangi alana uygulanacak. Varsayılan Başlangıç = eski davranış. *@
    <select name="tarihTuru" title="Tarih aralığı hangi alana uygulansın">
        <option value="">Tarih: Başlangıç</option>
        <option value="Bitis" selected="@(TarihTuru == "Bitis")">Tarih: Bitiş</option>
        <option value="Islem" selected="@(TarihTuru == "Islem")">Tarih: İşlem</option>
        <option value="Vade" selected="@(TarihTuru == "Vade")">Tarih: Vade</option>
    </select>
    <input name="basMin" type="date" value="@BasMin" title="Seçili tarih ≥" />
    <input name="basMax" type="date" value="@BasMax" title="Seçili tarih ≤" />
    <select name="ofis">
        <option value="">Ofis (tümü)</option>
        @foreach (var o in _locations) { <option value="@o.Ad" selected="@(Ofis == o.Ad)">@o.Ad</option> }
    </select>
    <select name="ofisDurum" title="Ofis filtresi çıkış mı dönüş mü">
        <option value="">Ofis: çıkış veya dönüş</option>
        <option value="Cikis" selected="@(OfisDurum == "Cikis")">Ofis: yalnız çıkış</option>
        <option value="Donus" selected="@(OfisDurum == "Donus")">Ofis: yalnız dönüş</option>
    </select>
    <input name="sahip" value="@Sahip" placeholder="Araç sahibi" list="dl-sahip" />
    <datalist id="dl-sahip">@foreach (var x in _sahipler) { <option value="@x" /> }</datalist>
    <input name="grup" value="@Grup" placeholder="Araç grubu" list="dl-grup" />
    <datalist id="dl-grup">@foreach (var x in _gruplar) { <option value="@x" /> }</datalist>
    <select name="kaynak">
        <option value="">Rez. kaynağı (tümü)</option>
        @foreach (var k in _kaynaklar) { <option value="@k.Ad" selected="@(Kaynak == k.Ad)">@k.Ad</option> }
    </select>
    <select name="personel">
        <option value="">Teslim alan personel (tümü)</option>
        @foreach (var pr in _personeller) { <option value="@pr.Id" selected="@(Personel == pr.Id.ToString())">@pr.Ad @pr.Soyad</option> }
    </select>
    <button type="submit">Filtrele</button>
    @if (SuzgecVar)
    {
        <a href="/kiralar" class="link">Temizle</a>
    }
</form>
</div>

<p class="muted small">@_rows.Count sözleşme • @_rows.Count(r => r.Durum == RentalStatus.Kirada) kirada • @_rows.Count(r => !r.Faturali) faturasız</p>

<div class="table-scroll">
@* kart-mobil: 640px altında satır karta döner. Kartta YALNIZ data-etiket taşıyan hücreler görünür —
   23 kolonu telefona dökmek tabloyu okumaktan kötü olurdu. Kartta kalanlar: sözleşmeyi tanımlayan
   müşteri/araç, dönem, para (tutar + BAKİYE) ve durum. *@
<table class="grid tr-grid kart-mobil">
    <thead>
        @* FAZ-46 — canlı kira_listesi.aspx kolonları. Provizyon/Depozito/Komisyon BİLGİDİR:
           bakiyeye ve deftere girmez, bu yüzden sayfa altındaki özet satırında da TOPLANMAZ. *@
        <tr><th>Sözleşme No</th><th>Müşteri</th><th>Araç</th><th>Tarih</th><th>Vade</th><th>Gün</th>
            <th>Hediye/Fat. Gün</th><th class="num">Tutar</th><th class="num">Bakiye</th><th>Kaynak</th><th>Çıkış Ofisi</th>
            <th>Dönüş Ofisi</th><th class="num">Provizyon</th><th class="num">Depozito</th>
            <th class="num">Kom. %</th><th class="num">Kom. Tutar</th><th>Onay Kodu</th><th>Proje</th>
            <th>Assist</th><th>Özel Şoför</th><th>Durum</th><th>Fatura</th><th></th></tr>
    </thead>
    <tbody>
        @if (_rows.Count == 0)
        {
            <tr><td colspan="23" class="muted">Kayıt yok.</td></tr>
        }
        @foreach (var r in _rows)
        {
            <tr>
                <td class="kart-baslik"><a href="/kiralar/@r.Id">@r.SozlesmeNo</a></td>
                <td data-etiket="Müşteri">@r.MusteriAd</td>
                <td data-etiket="Araç">@r.Plaka</td>
                <td data-etiket="Tarih">@r.BasTar.LocalDateTime.ToString("dd.MM.yyyy HH:mm") – @r.BitTar.LocalDateTime.ToString("dd.MM HH:mm")</td>
                <td>@(r.VadeTar is { } v ? v.LocalDateTime.ToString("dd.MM.yyyy") : "—")</td>
                <td>@r.Gun</td>
                <td>@(r.HediyeGun is { } hg ? hg.ToString() : "—") / @(r.FaturalananGun is { } fg ? fg.ToString() : "—")</td>
                <td class="num" data-etiket="Tutar">@r.Tutar.ToString("N2")</td>
                <td class="num" data-etiket="Bakiye">@r.Bakiye.ToString("N2")</td>
                <td>@(r.Kaynak ?? "—")</td>
                <td>@(r.CikisOfisi ?? "—")</td>
                <td>@(r.DonusOfisi ?? "—")</td>
                <td class="num">@(r.Provizyon?.ToString("N2") ?? "—")</td>
                <td class="num">@(r.Depozito?.ToString("N2") ?? "—")</td>
                <td class="num">@(r.KomisyonOran?.ToString("N2") ?? "—")</td>
                <td class="num">@(r.KomisyonTutar?.ToString("N2") ?? "—")</td>
                <td>@(r.OnayKodu ?? "—")</td>
                <td>@(r.ProjeAdi ?? "—")</td>
                <td>@(r.AssistFirma ?? "—")</td>
                <td>@(r.OzelSoforBilgisi ?? "—")</td>
                <td data-etiket="Durum">@r.Durum</td>
                <td>@(r.Faturali ? "Faturalı" : "—")</td>
                <td class="row-actions kart-aksiyon">
                    <a href="/kiralar/@r.Id/pdf" class="link" target="_blank" rel="noopener" title="Tarayıcıda görüntüler (indirmez)">Sözleşme (PDF)</a>
                    @if (r.Durum == RentalStatus.Kirada)
                    {
                        @* Yetki çiti: bu uç grup kapısından DAHA DAR bir izin istiyor (UcIzinKapsamaTests). Kapılanmazsa kullanıcı düğmeyi açık görür, basar, 403 alır ve /yetkisiz'e düşer. *@
                        <AuthorizeView Policy="izin:OperationsDelete" Context="iptalCtx">
                            <form method="post" action="/kiralar/cancel" data-confirm="@r.SozlesmeNo numaralı kira sözleşmesi iptal edilsin mi? Sözleşme İptal durumuna geçer ve araç Müsait olur; fatura ve tahsilat kayıtlarına dokunulmaz."><AntiforgeryToken /><input type="hidden" name="id" value="@r.Id" /><button class="link danger">İptal</button></form>
                        </AuthorizeView>
                    }
                    @if (r.Bakiye > 0m && r.Durum != RentalStatus.Iptal)
                    {
                        @* Hızlı tahsilat — pano Dönüşler ile AYNI desen (TahsilatAnahtar deterministik,
                           döviz=kira dövizi, kur KurCozucu'ya bırakılır). Yalnız finans-yetkili roller. *@
                        <AuthorizeView Roles="Admin,Yonetici,Muhasebe">
                            <form method="post" action="/finans/tahsilat" class="tahsil-mini"><AntiforgeryToken />
                                <input type="hidden" name="cariId" value="@r.MusteriId" />
                                <input type="hidden" name="rentalId" value="@r.Id" />
                                <input type="hidden" name="doviz" value="@RentACar.Application.Kur.ExchangeRateService.NormalizeCode(r.Doviz)" />
                                <input type="hidden" name="islemAnahtari" value="@RentACar.Web.Finance.TahsilatAnahtar.Uret(r.Id, r.Bakiye, IslemSayisi(r.Id))" />
                                <input type="hidden" name="donus" value="/kiralar" />
                                <input type="hidden" name="aciklama" value="Hızlı tahsilat (liste) — @r.SozlesmeNo" />
                                @* FAZ-84: tek-tık hızlı tahsilat — seçici yok, masaüstü listesinden yapılan işlem. *@
                                <input type="hidden" name="kanal" value="Masaüstü" />
                                <input name="tutar" type="number" step="0.01" min="0.01" value="@r.Bakiye.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                       required class="dc-tutar" title="Kalan bakiye — aşan tutar cari alacak olur" />
                                <select name="hesap" title="Tahsilat hesabı"><option>Kasa</option><option>Banka</option></select>
                                <HesapSecici CssClass="kf-inline" Etiket="" />
                                <button type="submit" class="kf-btn">Tahsil Et</button>
                            </form>
                        </AuthorizeView>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }
    [SupplyParameterFromQuery(Name = "fatura")] public string? Fatura { get; set; }
    [SupplyParameterFromQuery(Name = "basMin")] public string? BasMin { get; set; }
    [SupplyParameterFromQuery(Name = "basMax")] public string? BasMax { get; set; }
    [SupplyParameterFromQuery(Name = "ofis")] public string? Ofis { get; set; }
    // ---- FAZ-46 süzgeçleri ----
    [SupplyParameterFromQuery(Name = "tarihTuru")] public string? TarihTuru { get; set; }
    [SupplyParameterFromQuery(Name = "ofisDurum")] public string? OfisDurum { get; set; }
    [SupplyParameterFromQuery(Name = "sahip")] public string? Sahip { get; set; }
    [SupplyParameterFromQuery(Name = "grup")] public string? Grup { get; set; }
    [SupplyParameterFromQuery(Name = "kaynak")] public string? Kaynak { get; set; }
    [SupplyParameterFromQuery(Name = "personel")] public string? Personel { get; set; }

    private bool SuzgecVar =>
        !string.IsNullOrEmpty(Q) || !string.IsNullOrEmpty(Durum) || !string.IsNullOrEmpty(Fatura)
        || !string.IsNullOrEmpty(Ofis) || !string.IsNullOrEmpty(BasMin) || !string.IsNullOrEmpty(BasMax)
        || !string.IsNullOrEmpty(TarihTuru) || !string.IsNullOrEmpty(OfisDurum)
        || !string.IsNullOrEmpty(Sahip) || !string.IsNullOrEmpty(Grup)
        || !string.IsNullOrEmpty(Kaynak) || !string.IsNullOrEmpty(Personel);

    private IReadOnlyList<RentalRow> _rows = [];
    private IReadOnlyList<Location> _locations = [];
    private IReadOnlyList<ReservationSource> _kaynaklar = [];
    private IReadOnlyList<PersonelSecim> _personeller = [];
    private IReadOnlyList<string> _sahipler = [];
    private IReadOnlyList<string> _gruplar = [];
    private Dictionary<Guid, int> _islemSayilari = []; // deterministik tahsilat anahtarı bileşeni (TryGetValue→0)

    private int IslemSayisi(Guid rentalId) => _islemSayilari.TryGetValue(rentalId, out var s) ? s : 0;

    protected override async Task OnInitializedAsync()
    {
        _locations = await Locations.ListActiveAsync();
        _kaynaklar = await Kaynaklar.ListActiveAsync();
        // PII'siz personel seçimi (ListAsync ManageUsers ister ve operatörde patlar — bilinen tuzak).
        _personeller = await Personeller.ListForSelectAsync();
        // Sahip/grup listeleri araç kartlarından TÜRETİLİR: ayrı bir master tanımı yok.
        var araclar = await Vehicles.ListAsync();
        _sahipler = [.. araclar.Select(v => v.AracSahibi).Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.CurrentCulture)];
        _gruplar = [.. araclar.Select(v => v.Grup).Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.CurrentCulture)];

        var filter = new RentalFilter
        {
            Query = string.IsNullOrWhiteSpace(Q) ? null : Q,
            Durum = Enum.TryParse<RentalStatus>(Durum, out var d) ? d : null,
            Faturali = Fatura switch { "true" => true, "false" => false, _ => null },
            BaslangicMin = DateTimeOffset.TryParse(BasMin, out var mn) ? mn : null,
            BaslangicMax = DateTimeOffset.TryParse(BasMax, out var mx) ? mx.AddDays(1).AddSeconds(-1) : null,
            Ofis = string.IsNullOrWhiteSpace(Ofis) ? null : Ofis,
            // FAZ-46 — hepsi opsiyonel; boş bırakılırsa sorgu eskisiyle BİREBİR aynı kalır.
            TarihTuru = Enum.TryParse<DateListType>(TarihTuru, out var tt) ? tt : null,
            OfisDurum = Enum.TryParse<OfficeStatus>(OfisDurum, out var od) ? od : null,
            SahipGrup = string.IsNullOrWhiteSpace(Sahip) ? null : Sahip,
            AracGrubu = string.IsNullOrWhiteSpace(Grup) ? null : Grup,
            RezKaynak = string.IsNullOrWhiteSpace(Kaynak) ? null : Kaynak,
            PersonelId = FormParse.Id(Personel)
        };
        _rows = await Rentals.SearchAsync(filter);

        var tahsilEdilebilir = _rows.Where(r => r.Bakiye > 0m && r.Durum != RentalStatus.Iptal)
            .Select(r => r.Id).ToList();
        if (tahsilEdilebilir.Count > 0)
            _islemSayilari = await Cash.GetRentalTransactionCountsAsync(tahsilEdilebilir);
    }
}
