@* STICKY ALT PANEL — her sekmede sabit. Kaydet ana formu (form= — VehicleEdit emsali) gönderir.
   EDIT: gerçek finans formları (sticky ana formun DIŞINDA olduğundan doğrudan <form> kullanılabilir):
   Nakit → /finans/tahsilat hesap=Kasa + depozito al/iade/mahsup; Kredi Kart/Havale → aynı uç hesap=Banka
   + Giden Havale (/finans/odeme); Faturalar → ListByRental listesi + /finans/fatura; Ceza → ListByRental.
   FinanceWrite olmayan rolde butonlar disabled + not (403 sürprizi yok). Tahsilat formlarında render-başına
   islemAnahtari (idempotency — çift tıklama çift kayıt üretmez). *@
<div class="kf-sticky">
    <div class="kf-sticky-main">
        <button type="submit" form="kira-form" class="kf-kaydet" disabled="@(!Vm.OperasyonYetkisi || (Vm.Edit && Vm.Rental!.Durum == RentACar.Domain.Enums.RentalStatus.Iptal))" title="@(Vm.OperasyonYetkisi ? "" : "Operasyon (OperationsWrite) yetkisi gerekir")">Kaydet</button>
        @if (Vm.Kirada)
        {
            <button type="submit" form="kira-iptal" class="kf-btn-danger" disabled="@(!Vm.SilmeYetkisi)"
                    title="@(Vm.SilmeYetkisi ? "" : "Kira iptali için Operasyon Silme (OperationsDelete) yetkisi gerekir")">Kira İptal</button>
        }
        <button type="button" class="kf-btn-ghost" disabled title="TODO: tablet imza/araç değişim akışı">Tablet Araç Değişim</button>
        @if (Vm.Edit && Vm.FaturaDonemleri.Count > 0)
        {
            @* FAZ 4.2-B3: dönem planı + satır-başı kesim (ana form DIŞI formlar). *@
            <details>
                <summary class="link">Fatura Dönemleri (@Vm.FaturaDonemleri.Count(d => d.Durum == RentACar.Domain.Enums.FaturaDonemDurum.Kesildi)/@Vm.FaturaDonemleri.Count kesildi)</summary>
                <div class="table-scroll">
                    <table class="grid tr-grid">
                        <thead><tr><th>#</th><th>Aralık</th><th class="num">Tahakkuk</th><th>Durum</th><th class="num">Kesilen</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var d in Vm.FaturaDonemleri)
                            {
                                <tr>
                                    <td>@d.DonemSira</td>
                                    <td>@d.DonemBas.LocalDateTime.ToString("dd.MM.yy") – @d.DonemBit.LocalDateTime.ToString("dd.MM.yy")</td>
                                    <td class="num">@d.Tahakkuk.ToString("N2")</td>
                                    <td>@d.Durum</td>
                                    <td class="num">@(d.KesilenTutar?.ToString("N2") ?? "—")</td>
                                    <td>
                                        @if (d.Durum == RentACar.Domain.Enums.FaturaDonemDurum.Planlandi)
                                        {
                                            <form method="post" action="/finans/donem-fatura" style="display:flex;gap:.35rem;align-items:center;"><AntiforgeryToken />
                                                <input type="hidden" name="rentalId" value="@Vm.Rental!.Id" />
                                                <input type="hidden" name="donemSira" value="@d.DonemSira" />
                                                <input type="hidden" name="donus" value="/kiralar/@Vm.Rental!.Id" />
                                                <label class="muted small"><input type="checkbox" name="tahsilat" value="true" /> tahsilat</label>
                                                <select name="hesap"><option>Kasa</option><option>Banka</option></select>
                                                <HesapSecici Etiket="" />
                                                <button type="submit" disabled="@(!Vm.FinansYetkisi)">Kes</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="muted small">Tahsilat kaydı fatura döviz/kuruyla yazılır (çift-submit güvenli). Tahsilat
                    sonrası fatura iadesi tahsilatı GERİ ALMAZ — geri ödeme manuel "Ödeme" akışıyla yapılır.</p>
            </details>
        }
        else
        {
            <button type="button" class="kf-btn-ghost" disabled title="Uzun/aylık kirada dönem planı otomatik oluşur">Fatura Dönemleri</button>
        }
        @if (Vm.Edit)
        {
            @* FAZ 4.3: B2B dış hizmet alımı grid'i — tam defterli (gider araçta + komisyon geliri). *@
            <details>
                <summary class="link">Dış Hizmet Alımları (@Vm.DisHizmetler.Count(d => d.Durum == RentACar.Domain.Entities.DisHizmetDurum.Kayitli))</summary>
                <div class="table-scroll">
                    <table class="grid tr-grid">
                        <thead><tr><th>No</th><th>Hizmet</th><th class="num">Bedel</th><th class="num">Kom.%</th><th>Durum</th><th></th></tr></thead>
                        <tbody>
                            @if (Vm.DisHizmetler.Count == 0) { <tr><td colspan="6" class="muted">Kayıt yok.</td></tr> }
                            @foreach (var d in Vm.DisHizmetler)
                            {
                                <tr>
                                    <td>@d.No</td><td>@d.AlinanHizmet</td>
                                    <td class="num">@d.HizmetBedeli.ToString("N2") @d.Currency</td>
                                    <td class="num">@d.TedarikciKomisyonOran.ToString("N2")</td>
                                    <td>@d.Durum</td>
                                    <td>
                                        @if (d.Durum == RentACar.Domain.Entities.DisHizmetDurum.Kayitli)
                                        {
                                            @* Yetki çiti: uç grup kapısından DAHA DAR izin istiyor (UcIzinKapsamaTests) — kapılanmazsa 403 → /yetkisiz. *@
                                            <AuthorizeView Policy="izin:FinanceReverse" Context="dhIptalCtx">
                                                <form method="post" action="/finans/dis-hizmet-iptal" style="display:inline"><AntiforgeryToken />
                                                    <input type="hidden" name="id" value="@d.Id" />
                                                    <input type="hidden" name="donus" value="/kiralar/@Vm.Rental!.Id" />
                                                    <button type="submit" class="link danger" disabled="@(!Vm.FinansYetkisi)">İptal (ters kayıt)</button>
                                                </form>
                                            </AuthorizeView>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <form method="post" action="/finans/dis-hizmet" class="grid-form"><AntiforgeryToken />
                    <input type="hidden" name="rentalId" value="@Vm.Rental!.Id" />
                    <input type="hidden" name="donus" value="/kiralar/@Vm.Rental!.Id" />
                    <input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />
                    <label>Tedarikçi Cari
                        <select name="cariId" required>
                            @foreach (var c in Vm.Customers) { <option value="@c.Id">@c.DisplayName</option> }
                        </select>
                    </label>
                    <label>Alınan Hizmet<input name="alinanHizmet" maxlength="256" required /></label>
                    <label>Firma<input name="hizmetAlinanFirma" maxlength="256" /></label>
                    <label>Bedel<input name="hizmetBedeli" type="number" step="0.01" min="0.01" required /></label>
                    <label>Tedarikçi Kom. %<input name="komisyonOran" type="number" step="0.01" min="0" max="100" /></label>
                    <label>Döviz<input name="doviz" maxlength="8" placeholder="TRY" /></label>
                    <label>Kur (boş = otomatik)<input name="kur" type="number" step="0.000001" min="0" /></label>
                    <label>Komisyon Fatura No<input name="komisyonFaturaNo" maxlength="64" /></label>
                    <label>Açıklama<input name="aciklama" maxlength="512" /></label>
                    <label class="u-self-end"><button type="submit" disabled="@(!Vm.FinansYetkisi)">Dış Hizmet Kaydet</button></label>
                </form>
            </details>
        }
        <span class="muted small">Durum: <strong>@(Vm.Edit ? Vm.Rental!.Durum.ToString() : "Hazır")</strong></span>
        @if (Vm.Edit)
        {
            <span class="muted small">@Vm.Rental!.SozlesmeNo</span>
        }
        <span class="kf-kalan-badge">Kalan: <span data-fp="kalan">@(Vm.Edit ? Vm.Rental!.Bakiye.ToString("N2") : "—")</span></span>
    </div>
    <div class="kf-subtabs" role="tablist" data-tabs="fin" data-tabs-collapsed>
        <button type="button" role="tab" data-tab="kredikart" aria-selected="false">Kredi Kart/Havale İşlemleri</button>
        <button type="button" role="tab" data-tab="nakit" aria-selected="false">Nakit İşlemler</button>
        <button type="button" role="tab" data-tab="faturalar" aria-selected="false">Faturalar</button>
        <button type="button" role="tab" data-tab="kurlar" aria-selected="false">Kur Bilgileri</button>
        <button type="button" role="tab" data-tab="ceza" aria-selected="false">Ceza/Geçişler</button>
    </div>

    @* ---- Kredi Kart / Havale (Banka hesabına tahsilat + giden havale) ---- *@
    <div class="kf-fin-panel" data-panel-group="fin" data-panel="kredikart" hidden>
        @if (TahsilatOlur)
        {
            <div class="report-cols">
                <form method="post" action="/finans/tahsilat" class="grid-form"><AntiforgeryToken />
                    <input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />
                    <input type="hidden" name="cariId" value="@Vm.Rental!.MusteriId" />
                    <input type="hidden" name="rentalId" value="@Vm.Rental!.Id" />
                    <input type="hidden" name="donus" value="/kiralar/@Vm.Rental!.Id" />
                    <input type="hidden" name="hesap" value="Banka" />
                    <HesapSecici Etiket="Hesap" />
                    <label>Tutar<input name="tutar" type="number" step="0.01" value="@Vm.Rental!.Bakiye.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
                    <label>Döviz<select name="doviz"><option>TRY</option><option>USD</option><option>EUR</option></select></label>
                    <label>Kur<input name="kur" type="number" step="0.0001" placeholder="boş = otomatik" title="Boş: TRY=1, dövizde sabit kur/TCMB otomatik" /></label>
                    @* FAZ-84: kanal SAF BİLGİ — defteri/bakiyeyi etkilemez. *@
                    <label>Kanal<select name="kanal"><option>Masaüstü</option><option>Mobil</option><option>Tablet</option></select></label>
                    <label>Ödemeyi Yapan / Not<input name="aciklama" placeholder="Kart/havale — ödeyen" /></label>
                    <label class="u-self-end"><button type="submit" disabled="@(!Vm.FinansYetkisi)">Kart/Havale Tahsilatı (Banka)</button></label>
                </form>
                <form method="post" action="/finans/odeme" class="grid-form"><AntiforgeryToken />
                    <input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />
                    <input type="hidden" name="cariId" value="@Vm.Rental!.MusteriId" />
                    <input type="hidden" name="donus" value="/kiralar/@Vm.Rental!.Id" />
                    <input type="hidden" name="hesap" value="Banka" />
                    <HesapSecici Etiket="Hesap" />
                    <label>Giden Havale Tutarı<input name="tutar" type="number" step="0.01" min="0.01" /></label>
                    <label>Kanal<select name="kanal"><option>Masaüstü</option><option>Mobil</option><option>Tablet</option></select></label>
                    <label>Açıklama<input name="aciklama" placeholder="İade/giden havale" /></label>
                    <label class="u-self-end"><button type="submit" disabled="@(!Vm.FinansYetkisi)">Giden Havale</button></label>
                </form>
            </div>
            @* FAZ 4.1: manuel provizyon yaşam döngüsü — POS'suz kayıt (deftere yazmaz). Bu formlar ana
               formun DIŞINDA; SekmeAyrintilar'daki butonlar form= attribute'üyle bunlara bağlanır. *@
            <form id="kf-prov-al" method="post" action="/kiralar/provizyon-al" style="display:none;"><AntiforgeryToken />
                <input type="hidden" name="id" value="@Vm.Rental!.Id" />
            </form>
            <details>
                <summary class="link">Manuel Provizyon Kapama (durum: @Vm.Rental!.ProvizyonDurum)</summary>
                <form id="kf-prov-kapat" method="post" action="/kiralar/provizyon-kapat" class="grid-form"><AntiforgeryToken />
                    <input type="hidden" name="id" value="@Vm.Rental!.Id" />
                    <label>Kapama Tutarı<input name="kapamaTutar" type="number" step="0.01" min="0"
                        placeholder="Boş = bloke tutarın tamamı" value="@Vm.Rental!.Provizyon" /></label>
                    <label><input type="checkbox" name="iade" value="true" /> Çekim yok — serbest bırak (iade)</label>
                    <label class="u-self-end"><button type="submit"
                        disabled="@(Vm.Rental!.ProvizyonDurum != RentACar.Domain.Enums.ProvizyonDurum.Alindi)">Provizyonu Kapat</button></label>
                    <p class="muted small">Bilgi kaydıdır — deftere/bakiyeye yazmaz; gerçek tahsilat yukarıdaki akışlardan.</p>
                </form>
            </details>
            @if (!Vm.FinansYetkisi) { <p class="muted small">Muhasebe (FinanceWrite) yetkisi gerekir.</p> }
        }
        else { <p class="muted small">@KapaliNot</p> }
    </div>

    @* ---- Nakit (Kasa) + Depozito ---- *@
    <div class="kf-fin-panel" data-panel-group="fin" data-panel="nakit" hidden>
        @if (TahsilatOlur)
        {
            <div class="report-cols">
                <form method="post" action="/finans/tahsilat" class="grid-form"><AntiforgeryToken />
                    <input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />
                    <input type="hidden" name="cariId" value="@Vm.Rental!.MusteriId" />
                    <input type="hidden" name="rentalId" value="@Vm.Rental!.Id" />
                    <input type="hidden" name="donus" value="/kiralar/@Vm.Rental!.Id" />
                    <input type="hidden" name="hesap" value="Kasa" />
                    <HesapSecici Etiket="Hesap" />
                    <label>Tutar<input name="tutar" type="number" step="0.01" value="@Vm.Rental!.Bakiye.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
                    <label>Döviz<select name="doviz"><option>TRY</option><option>USD</option><option>EUR</option></select></label>
                    <label>Kur<input name="kur" type="number" step="0.0001" placeholder="boş = otomatik" title="Boş: TRY=1, dövizde sabit kur/TCMB otomatik" /></label>
                    <label>Kanal<select name="kanal"><option>Masaüstü</option><option>Mobil</option><option>Tablet</option></select></label>
                    <label class="u-self-end"><button type="submit" disabled="@(!Vm.FinansYetkisi)">Nakit Tahsilat (Kasa)</button></label>
                </form>
                <form method="post" action="/depozito/al" class="grid-form"><AntiforgeryToken />
                    <input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />
                    <input type="hidden" name="cariId" value="@Vm.Rental!.MusteriId" />
                    <input type="hidden" name="donus" value="/kiralar/@Vm.Rental!.Id" />
                    <label>Depozito Tutarı<input name="tutar" type="number" step="0.01" min="0.01" value="@(Vm.Rental!.Depozito is { } dep ? dep.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" /></label>
                    <label>Hesap<select name="hesap"><option>Kasa</option><option>Banka</option></select>
                                            <HesapSecici Etiket="" /></label>
                    <label class="u-self-end"><button type="submit" disabled="@(!Vm.FinansYetkisi)">Depozito Al</button></label>
                </form>
                <form method="post" action="/depozito/irat" class="grid-form"><AntiforgeryToken />
                    <input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />
                    <input type="hidden" name="cariId" value="@Vm.Rental!.MusteriId" />
                    <input type="hidden" name="rentalId" value="@Vm.Rental!.Id" />
                    <input type="hidden" name="donus" value="/kiralar/@Vm.Rental!.Id" />
                    <label>İrat Tutarı<input name="tutar" type="number" step="0.01" min="0.01"
                        title="İade edilmeyen depozito GELİR yazılır; bu kiranın aracına atfedilir" /></label>
                    <label>Açıklama<input name="aciklama" placeholder="ör. hasar kesintisi" /></label>
                    <label class="u-self-end"><button type="submit" disabled="@(!Vm.FinansYetkisi)"
                        title="Borç Depozito / Alacak Gelir — tutulan depozitoyu aşamaz">Depozito İrat</button></label>
                </form>
            </div>
            <p class="muted small">Depozito iade/mahsup: <a class="link" href="/depozito">Depozito ekranı</a> (cari bazında emanet bakiyesi). Tahsilat çift-taraflı defter kaydıyla işlenir; Bakiye otomatik düşer.</p>
            @if (!Vm.FinansYetkisi) { <p class="muted small">Muhasebe (FinanceWrite) yetkisi gerekir.</p> }
        }
        else { <p class="muted small">@KapaliNot</p> }
    </div>

    @* ---- Faturalar (base + fark + iade listesi + fatura kes) ---- *@
    <div class="kf-fin-panel" data-panel-group="fin" data-panel="faturalar" hidden>
        @if (Vm.Edit)
        {
            <table class="grid">
                <thead><tr><th>Fatura No</th><th>Tarih</th><th class="num">Genel Toplam</th><th>Tür</th><th>Durum</th></tr></thead>
                <tbody>
                    @if (Vm.Faturalar.Count == 0)
                    {
                        <tr><td colspan="5" class="muted">Fatura kesilmemiş.</td></tr>
                    }
                    @foreach (var f in Vm.Faturalar)
                    {
                        <tr>
                            <td><a class="link" href="/faturalar">@f.No</a></td>
                            <td>@f.Tarih.LocalDateTime.ToString("dd.MM.yyyy")</td>
                            <td class="num">@f.GenelToplam.ToString("N2")</td>
                            <td>@(f.IadeMi ? "İade" : f.KaynakKiraId is not null ? "Fark" : "Kira")</td>
                            <td>@f.Durum</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Vm.Rental!.GenelToplam > 0 && Vm.Rental!.Durum != RentACar.Domain.Enums.RentalStatus.Iptal)
            {
                <form method="post" action="/finans/fatura"><AntiforgeryToken />
                    <input type="hidden" name="rentalId" value="@Vm.Rental!.Id" />
                    <details>
                        <summary class="link">Vergi/belge alanları (opsiyonel)</summary>
                        <div class="grid-form">
                            <label>ÖTV<input name="otv" type="number" step="0.01" min="0" /></label>
                            <label>Tevkifat Oran %<input name="tevkifatOran" type="number" step="0.01" min="0" max="100" /></label>
                            <label>Tevkifat Tutar<input name="tevkifatTutar" type="number" step="0.01" min="0" /></label>
                            <label>Damga Vergisi<input name="damgaVergisi" value="@Vm.D(c => c.DamgaVergisi)" title="Boş = kiradaki damga; 0 = bu faturada damgasız" type="number" step="0.01" min="0" /></label>
                            <label>İade Faturası<select name="iadeMi"><option value="false">Hayır</option><option value="true">Evet</option></select></label>
                            <label>Manuel Fatura<select name="manuelMi"><option value="false">Hayır</option><option value="true">Evet</option></select></label>
                        </div>
                    </details>
                    <button type="submit" disabled="@(!Vm.FinansYetkisi)">Fatura Kes (KDV %20 — fark otomatiği)</button>
                </form>
                @if (!Vm.FinansYetkisi) { <p class="muted small">Muhasebe (FinanceWrite) yetkisi gerekir.</p> }
            }
        }
        else
        {
            <table class="grid"><thead><tr><th>Fatura No</th><th>Tarih</th><th>Tutar</th><th>Durum</th></tr></thead>
            <tbody><tr><td colspan="4" class="muted">Önce kaydedin — fatura kayıtlı sözleşmeden kesilir (fark faturası otomatik).</td></tr></tbody></table>
        }
    </div>

    @* ---- Kur Bilgileri (her modda canlı — TCMB/SabitKur) ---- *@
    <div class="kf-fin-panel" data-panel-group="fin" data-panel="kurlar" hidden>
        @if (Vm.Kurlar.Count == 0)
        {
            <p class="muted small">Kur kaydı yok (TCMB güncellemesi bekleniyor ya da sabit kur tanımlı değil).</p>
        }
        else
        {
            <table class="grid">
                <thead><tr><th>Kod</th><th>Ad</th><th class="num">Döviz Alış</th><th class="num">Döviz Satış</th><th>Tarih</th></tr></thead>
                <tbody>
                    @foreach (var k in Vm.Kurlar.Take(8))
                    {
                        <tr>
                            <td>@k.Kod</td><td>@k.Ad</td>
                            <td class="num">@(k.ForexAlis?.ToString("N4") ?? "—")</td>
                            <td class="num">@(k.ForexSatis?.ToString("N4") ?? "—")</td>
                            <td>@k.Tarih.LocalDateTime.ToString("dd.MM.yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @* ---- Ceza / Geçişler ---- *@
    <div class="kf-fin-panel" data-panel-group="fin" data-panel="ceza" hidden>
        @if (Vm.Edit)
        {
            <table class="grid">
                <thead><tr><th>Ceza No</th><th>Türü</th><th class="num">Tutar</th><th>Durum</th></tr></thead>
                <tbody>
                    @if (Vm.Cezalar.Count == 0)
                    {
                        <tr><td colspan="4" class="muted">Bu kiraya bağlı ceza yok.</td></tr>
                    }
                    @foreach (var cz in Vm.Cezalar)
                    {
                        <tr><td>@cz.No</td><td>@cz.CezaTuru</td><td class="num">@cz.Tutar.ToString("N2")</td><td>@cz.Durum</td></tr>
                    }
                </tbody>
            </table>
            @* FAZ 4.4: kira dönemi HGS geçiş listesi (salt-okunur; stub boş → not). *@
            <div class="table-scroll">
                <table class="grid tr-grid">
                    <thead><tr><th>Geçiş Zamanı</th><th>Gişe</th><th class="num">Tutar</th></tr></thead>
                    <tbody>
                        @if (Vm.HgsGecisleri.Count == 0)
                        { <tr><td colspan="3" class="muted">Kira döneminde HGS geçişi yok (entegrasyon stub — gerçek adaptör bağlanınca dolar).</td></tr> }
                        @foreach (var g in Vm.HgsGecisleri)
                        {
                            <tr><td>@g.Zaman.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td><td>@g.Gecis</td>
                                <td class="num">@g.Tutar.ToString("N2")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="small"><a class="link" href="/cezalar">Ceza ekle / yansıt (Cezalar ekranı)</a> — HGS yansıtması plaka+cari bazında /cezalar ekranından yapılır.</p>
        }
        else
        {
            <p class="muted small">Önce kaydedin — ceza/HGS geçişleri kayıtlı sözleşmeye bağlanır (<a class="link" href="/cezalar">Cezalar</a>).</p>
        }
    </div>
</div>
@code {
    [Parameter, EditorRequired] public KiraFormVm Vm { get; set; } = default!;

    private bool TahsilatOlur => Vm.Edit && Vm.Rental!.Durum != RentACar.Domain.Enums.RentalStatus.Iptal;
    private string KapaliNot => Vm.Edit
        ? "İptal edilmiş kirada tahsilat yapılmaz."
