@* MÜŞTERİ — kanonik musteriId + inline yeni müşteri (tek adımda kira+cari) + 2. sürücü + risk alanları. *@
<section class="kf-panel" data-panel-group="sekme" data-panel="musteri" hidden>
    <div class="card">
        <strong>Müşteri Seçimi</strong>
        <div class="grid-form">
            @if (Vm.Edit)
            {
                <label>Müşteri (değiştirilemez — sözleşme tarafı)
                    <select disabled>
                        @foreach (var c in Vm.Customers) { <option value="@c.Id" selected="@(c.Id == Vm.Rental!.MusteriId)">@c.DisplayName</option> }
                    </select>
                </label>
            }
            else
            {
                <label>Müşteri (mevcut cari)
                    <select name="musteriId">
                        <option value="">— yeni müşteri gireceğim —</option>
                        @foreach (var c in Vm.Customers) { <option value="@c.Id" selected="@(Vm.QMusteriId == c.Id)">@c.DisplayName</option> }
                    </select>
                </label>
            }
            <label>2. Sürücü (kayıtlı cari — opsiyonel)
                <select name="ikinciSurucuId">
                    <option value="">— yok / misafir —</option>
                    @foreach (var c in Vm.Customers) { <option value="@c.Id" selected="@(Vm.Edit && Vm.Rental!.IkinciSurucuId == c.Id)">@c.DisplayName</option> }
                </select>
            </label>
            <label>Analiz<input readonly value="@(Vm.Edit ? "cari ekstre bağlantısı aşağıda" : "kayıttan sonra cari ekstre")" /></label>
        </div>
        @if (Vm.Edit)
        {
            <p class="small"><a class="link" href="/cariler/@Vm.Rental!.MusteriId/ekstre">Cari Ekstre (Analiz)</a></p>
        }
    </div>
    @* FAZ-47 — MİSAFİR (kayıtlı olmayan) 2. sürücü. Yukarıdaki cari seçimiyle BİRLİKTE kullanılamaz:
       ikisi de doluysa kayıt SUNUCUDA reddedilir (RentalService.IkinciSurucuTekYolGuard) — güvence
       bu nottan değil, koddaki guard'dan gelir.
       TC kimlik / ehliyet NUMARASI alanı BİLİNÇLİ YOKTUR: o iki bilgi at-rest şifreli saklanır
       (CLAUDE.md §4-F2) ve sözleşme tablosunda düz-metin kolon açmak o kararı delerdi. Kimlik kaydı
       gerekiyorsa 2. sürücüyü cari olarak açın (Hızlı Giriş sekmesi) ve yukarıdan seçin. *@
    <div class="card">
        <strong>2. Sürücü — Kayıtlı Değil (Misafir)</strong>
        <div class="grid-form">
            <label>Ad<input name="ikinciSurucuSerbestAd" maxlength="64" value="@Vm.S(c => c.IkinciSurucuSerbestAd)" /></label>
            <label>Soyad<input name="ikinciSurucuSerbestSoyad" maxlength="64" value="@Vm.S(c => c.IkinciSurucuSerbestSoyad)" /></label>
            <label>Telefon<input name="ikinciSurucuSerbestTel" maxlength="32" value="@Vm.S(c => c.IkinciSurucuSerbestTel)" /></label>
            <label>Ehliyet Sınıfı<input name="ikinciSurucuSerbestEhliyetSinifi" maxlength="16"
                value="@Vm.S(c => c.IkinciSurucuSerbestEhliyetSinifi)" placeholder="B" /></label>
        </div>
        <p class="muted small">Bu blok yalnız 2. sürücü <strong>kayıtlı cari değilken</strong> doldurulur;
            yukarıdan cari seçildiyse burası boş kalmalıdır (aksi hâlde kayıt reddedilir).
            Kimlik/ehliyet numarası burada tutulmaz — gerekiyorsa 2. sürücüyü cari olarak açın.
            Misafir sürücü ek-sürücü <strong>ücreti üretmez</strong> (ücretli ek sürücü için cari seçimi kullanılır).</p>
    </div>
    @if (!Vm.Edit)
    {
        @* Yeni müşteri bloğu Hızlı Giriş sekmesinde (name="yeni*" alanları formda TEK olmalı); buradan atla. *@
        <p class="muted small">Kayıtlı değilse:
            <button type="button" class="link" data-jump-yeni-musteri>Hızlı Giriş sekmesinden tek adımda yeni müşteri ekle →</button>
        </p>
    }
    <div class="card">
        <strong>İletişim / Kimlik (müşteriden)</strong>
        <div class="grid-form">
            <label>Cep Tel<input readonly value="@CustomerField(c => c.CepTel)" /></label>
            <label>Mail<input readonly value="@CustomerField(c => c.Email)" /></label>
            <label>TC Kimlik<input readonly value="@(Vm.Edit ? "***şifreli — cari kartında" : "kayıt sonrası dolar")" /></label>
            <label>Ehliyet Sınıfı<input readonly value="@CustomerField(c => c.EhliyetSinifi)" /></label>
            <label>Ehliyet Yeri<input readonly value="@CustomerField(c => c.EhliyetYeri)" /></label>
        </div>
        @if (Vm.Edit && KayitliMusteri is { } m && (m.KaraListe || m.Uyari))
        {
            <p class="error"><strong>DİKKAT:</strong> @(m.KaraListe ? "KARA LİSTE. " : "") @(m.Uyari ? $"Uyarı: {m.UyariNedeni}" : "")</p>
        }
    </div>
    @* FAZ-47 — müşteri adres / ehliyet / pasaport SALT-OKUR paneli. Düzenleme BURADA YAPILMAZ
       (kira formu RentalContract yazar; cari alanları cari kartının otoritesindedir) → "Cari kartını aç".
       KVKK: ehliyet ve pasaport NUMARASI at-rest şifrelidir; CustomerRepository okuma yolunda bellekte
       çözer. Ekranda yine de MASKELİ gösterilir (son 4 hane) — sözleşme ekranı kimlik numarası dökmek
       için değil, doğru sürücüyle çalışıldığını teyit etmek içindir. Tam değer cari kartında. *@
    <div class="card">
        <strong>Adres / Sürücü Belgesi (cari karttan — salt-okunur)</strong>
        <div class="grid-form">
            <label class="u-col-full">Adres<input readonly value="@CustomerField(c => c.Adres)" /></label>
            <label>İl<input readonly value="@CustomerField(c => c.Il)" /></label>
            <label>İlçe<input readonly value="@CustomerField(c => c.Ilce)" /></label>
            <label>Müşteri Tipi<input readonly value="@CustomerField(c => c.MusteriTipi)" /></label>
            <label>Ehliyet No (maskeli)<input readonly value="@CustomerField(c => Mask(c.EhliyetNo))"
                title="Tam değer cari kartında — şifreli saklanır (KVKK)" /></label>
            <label>Ehliyet Tarihi<input readonly value="@CustomerField(c => c.EhliyetTarihi is { } t ? t.LocalDateTime.ToString("dd.MM.yyyy") : null)" /></label>
            <label>Ehliyet Ülke<input readonly value="@CustomerField(c => c.EhliyetUlke)" /></label>
            <label>Pasaport No (maskeli)<input readonly value="@CustomerField(c => Mask(c.PasaportNo))"
                title="Tam değer cari kartında — şifreli saklanır (KVKK)" /></label>
            <label>Pasaport Yeri<input readonly value="@CustomerField(c => c.PasaportYeri)" /></label>
        </div>
        @if (Vm.Edit)
        {
            <p class="small"><a class="link" href="/cariler/@Vm.Rental!.MusteriId">Cari kartını aç (düzenle) →</a></p>
        }
    </div>
    <div class="card">
        <strong>Risk / Kefil</strong>
        <div class="grid-form">
            <label>Manuel Findeks Puanı<input name="manuelFindexPuan" type="number" min="0" step="1" value="@Vm.I(c => c.ManuelFindexPuan)" /></label>
            <label>Risk Limiti (cariden)<input readonly value="@CustomerField(c => c.RiskLimiti.ToString("N2"))"
                title="Limit tanımlıysa (>0) ve cari borç bakiyesi limiti aşıyorsa kira açılışı Yönetici onayı ister (FAZ 4.4)." /></label>
            <AuthorizeView Roles="Admin,Yonetici" Context="riskCtx">
                <label title="Risk limiti aşımında kira açılış onayı — yalnız Yönetici/Admin (servis rolü ayrıca doğrular)">
                    Risk Onayı (limit aşımı)
                    <span><input type="hidden" name="riskOnay" value="false" />
                    <input type="checkbox" name="riskOnay" value="true" checked="@(Vm.Edit && Vm.Rental!.RiskOnay)" /></span>
                </label>
            </AuthorizeView>
            <label class="u-col-full">Kefil Bilgisi<input name="kefilBilgisi" maxlength="512" value="@Vm.S(c => c.KefilBilgisi)" /></label>
        </div>
        <p class="muted small">Findeks entegrasyonu yok — puan manuel girilir ve sözleşmede saklanır.</p>
    </div>
</section>
@code {
    [Parameter, EditorRequired] public RentalFormVm Vm { get; set; } = default!;

    private Customer? KayitliMusteri => Vm.Edit
        ? Vm.Customers.FirstOrDefault(c => c.Id == Vm.Rental!.MusteriId)
        : null;

    private string CustomerField(Func<Customer, string?> f)
        => KayitliMusteri is { } m ? (string.IsNullOrWhiteSpace(f(m)) ? "—" : f(m)!) : "kayıt sonrası dolar";

    /// <summary>Kimlik/belge numarası maskesi: yalnız son 4 hane görünür (tam değer cari kartında).</summary>
    private static string? Mask(string? v)
        => string.IsNullOrWhiteSpace(v)
            ? null
            : v!.Length <= 4 ? new string('*', v.Length) : new string('*', v.Length - 4) + v[^4..];
}
