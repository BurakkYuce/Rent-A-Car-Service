@* MÜŞTERİ — kanonik musteriId + inline yeni müşteri (tek adımda kira+cari) + 2. sürücü + risk alanları. *@
<section class="kf-panel" data-panel-group="sekme" data-panel="musteri" hidden>
    <div class="card">
        <strong>Müşteri Seçimi</strong>
        <div class="grid-form">
            <label>Müşteri (mevcut cari)
                <select name="musteriId">
                    <option value="">— yeni müşteri gireceğim —</option>
                    @foreach (var c in Vm.Customers) { <option value="@c.Id">@c.DisplayName</option> }
                </select>
            </label>
            <label>2. Sürücü (opsiyonel)
                <select name="ikinciSurucuId">
                    <option value="">—</option>
                    @foreach (var c in Vm.Customers) { <option value="@c.Id">@c.DisplayName</option> }
                </select>
            </label>
            <label>Analiz<input readonly value="@(Vm.Edit ? "cari ekstre bağlantısı aşağıda" : "kayıttan sonra cari ekstre")" /></label>
        </div>
        @if (Vm.Edit)
        {
            <p class="small"><a class="link" href="/cariler/@Vm.Rental!.MusteriId/ekstre">Cari Ekstre (Analiz)</a></p>
        }
    </div>
    <details class="new-vehicle">
        <summary class="link">Yeni Müşteri oluştur (kayıtlı değilse — kirayla tek adımda)</summary>
        <div class="grid-form">
            <label>Ad<input name="yeniAd" /></label>
            <label>Soyad<input name="yeniSoyad" /></label>
            <label>Ünvan (kurumsal ise)<input name="yeniUnvan" /></label>
            <label>TC Kimlik<input name="yeniTc" maxlength="11" /></label>
            <label>Gsm<input name="yeniGsm" /></label>
            <label>Mail<input name="yeniMail" type="email" /></label>
            <label>Doğum Tarihi<input name="yeniDogum" type="date" max="@KiraFormVm.BugunStr" /></label>
            <label>Ehliyet No<input name="yeniEhliyetNo" /></label>
            <label>Ehliyet Sınıfı<input name="yeniEhliyetSinifi" maxlength="8" /></label>
            <label>Ehliyet Veriliş Tarihi<input name="yeniEhliyetTarihi" type="date" max="@KiraFormVm.BugunStr" /></label>
            <label>Ehliyet Veren Yer<input name="yeniEhliyetYeri" /></label>
            <label>İl<input name="yeniIl" /></label>
            <label>İlçe<input name="yeniIlce" /></label>
        </div>
        <p class="muted small">Mevcut müşteri seçiliyse boş bırak. En az Ad (bireysel) ya da Ünvan (kurumsal) yeter; TC/ehliyet PII şifreli saklanır (blind-index arama).</p>
    </details>
    <div class="card">
        <strong>İletişim / Kimlik (müşteriden)</strong>
        <div class="grid-form">
            <label>Cep Tel<input readonly value="@MusteriAlan(c => c.CepTel)" /></label>
            <label>Mail<input readonly value="@MusteriAlan(c => c.Email)" /></label>
            <label>TC Kimlik<input readonly value="@(Vm.Edit ? "***şifreli — cari kartında" : "kayıt sonrası dolar")" /></label>
            <label>Ehliyet Sınıfı<input readonly value="@MusteriAlan(c => c.EhliyetSinifi)" /></label>
            <label>Ehliyet Yeri<input readonly value="@MusteriAlan(c => c.EhliyetYeri)" /></label>
        </div>
        @if (Vm.Edit && KayitliMusteri is { } m && (m.KaraListe || m.Uyari))
        {
            <p class="error"><strong>DİKKAT:</strong> @(m.KaraListe ? "KARA LİSTE. " : "") @(m.Uyari ? $"Uyarı: {m.UyariNedeni}" : "")</p>
        }
    </div>
    <div class="card">
        <strong>Risk / Kefil</strong>
        <div class="grid-form">
            <label>Manuel Findeks Puanı<input name="manuelFindexPuan" type="number" min="0" step="1" /></label>
            <label>Risk İzinli<input readonly value="Normal" title="TODO: Risk_Izin akışı (Customer.RiskLimiti/KaraListe bugün cari kartında)" /></label>
            <label>Risk Limiti (cariden)<input readonly value="@MusteriAlan(c => c.RiskLimiti.ToString("N2"))" /></label>
            <label style="grid-column:1/-1;">Kefil Bilgisi<input name="kefilBilgisi" maxlength="512" /></label>
        </div>
        <p class="muted small">Findeks entegrasyonu yok — puan manuel girilir ve sözleşmede saklanır.</p>
    </div>
</section>
@code {
    [Parameter, EditorRequired] public KiraFormVm Vm { get; set; } = default!;

    private Customer? KayitliMusteri => Vm.Edit
        ? Vm.Customers.FirstOrDefault(c => c.Id == Vm.Rental!.MusteriId)
        : null;

    private string MusteriAlan(Func<Customer, string?> f)
        => KayitliMusteri is { } m ? (f(m) ?? "—") : "kayıt sonrası dolar";
}
