@* FİYAT/TOPLAM — finansal çekirdek. Kanonik: gunlukUcret / fiyatTuru / doviz. Gri kutular canlı motor
   hesabı (data-fp — rc-kira-fiyat.js /kiralar/hesapla'dan doldurur). Ödeme-derinlik bilgi amaçlı. *@
<section class="kf-panel" data-panel-group="sekme" data-panel="fiyat" hidden>
    <div class="report-cols">
        <div>
            <div class="card">
                <strong>Fiyat Girişi</strong>
                <div class="grid-form">
                    @if (Vm.Edit)
                    {
                        <label>Hesaplama Tipi<input value="@(Vm.Rental!.FiyatTuru ?? "KDV Dahil Günlük")" readonly title="Fiyat değişikliği: fark faturası akışı; tarih: Uzat" /></label>
                        <label>Günlük Ücret (brüt)<input value="@Vm.Rental!.GunlukUcret.ToString("N2")" readonly title="Fiyat sözleşmede sabit — güncelleme fark faturasıyla" /></label>
                        <label>Döviz<input value="@(Vm.Rental!.Doviz ?? "TL")" readonly /></label>
                    }
                    else
                    {
                    @* FAZ-82: ön-seçim tenant ayarından (ayar boşsa "—" = bugünkü davranış). Yalnız
                       YENİ kira dalında; düzenlemede alan zaten salt-okunur (yukarıdaki Edit dalı). *@
                    <label>Hesaplama Tipi
                        <select name="fiyatTuru">
                            <option value="" selected="@(Vm.TenantVarsayilanFiyatTuru is null)">—</option>
                            @foreach (var o in RentalFormVm.PriceTypes)
                            { <option value="@o" selected="@(o == Vm.TenantVarsayilanFiyatTuru)">@o</option> }
                        </select>
                    </label>
                    <label>Günlük Ücret / Toplam
                        <input name="gunlukUcret" type="number" step="0.01" min="0" placeholder="Otomatik için boş bırakın" />
                    </label>
                    <label>Kampanya Kodu
                        <input name="kampanyaKodu" maxlength="64" autocomplete="off"
                               placeholder="Yalnız Otomatik'te" title="Kod, kural kapsamına uymazsa kayıt gürültülü reddedilir (FAZ 3.A5)" />
                    </label>
                    <label>Döviz
                        <select name="doviz">
                            <option value="">—</option>
                            @foreach (var o in RentalFormVm.Currencies) { <option>@o</option> }
                        </select>
                    </label>
                    }
                    <label>Kira Gün<span class="kf-ro num kf-robox" data-fp="gun">—</span></label>
                    <label>Efektif Günlük (brüt)<span class="kf-ro num kf-robox" data-fp="gunluk">—</span></label>
                    <label>Tarife<input readonly value="Otomatik seçilirse tarife matrisi (RateMatrix) çözer" /></label>
                    <label>Özel KDV Oranı<input name="ozelKdvOran" type="number" step="0.01" min="0" max="1"
                        value="@Vm.D(c => c.OzelKdvOran)" placeholder="boş = %20"
                        title="Kesir girin (ör. 0.10 = %10) — fatura kesiminde varsayılan oran; NET fiyat modlarında fatura reddedilir; sözleşme tutarını DEĞİŞTİRMEZ" /></label>
                    <label>Damga Vergisi<input name="damgaVergisi" type="number" step="0.01" min="0"
                        value="@Vm.D(c => c.DamgaVergisi)"
                        title="Bilgi — fatura kesiminde InvoiceTaxInfo.DamgaVergisi varsayılanı; deftere yansımaz" /></label>
                    <label>Promosyon Kodu / İndirim<input readonly value="kural motoru (RentalRule) otomatik uygular" title="TODO: elle promosyon kodu girişi" /></label>
                    <label>Saat Farkını Alma<input readonly value="gün hesabı: 24s blok + ~3s tolerans" title="BookingMath.ComputeGun — sabit kural" /></label>
                </div>
                <p class="muted small">"KDV Dahil Toplam" / "Toplam" modlarında girilen değer TOPLAM'dır (gün-bağımsız). Motor dökümü: <span data-fp="dokum">—</span></p>
            </div>
            <div class="card">
                <strong>Ödeme / Komisyon (bilgi amaçlı — deftere/bakiyeye yansımaz)</strong>
                <div class="grid-form">
                    @* FAZ-47 — Ödeme Şekli (seç-veya-yaz ComboBox konvansiyonu: input list + datalist).
                       BİLGİ alanı: gerçek tahsilat Kasa/Banka akışından geçer; buradaki seçim deftere,
                       Genel Toplam'a ve Bakiye'ye YANSIMAZ (kırılgan regresyon testiyle kilitli). *@
                    <label>Ödeme Şekli
                        <input name="odemeSekli" list="dl-kf-odemesekli" autocomplete="off" maxlength="64"
                               placeholder="Seç veya yaz" value="@Vm.S(c => c.OdemeSekli)"
                               title="Bilgi alanı — tahsilatın kendisi Kasa/Banka ekranından yapılır; bu seçim deftere yazmaz" />
                    </label>
                    <label>Provizyon<input name="provizyon" type="number" step="0.01" min="0" value="@Vm.D(c => c.Provizyon)" /></label>
                    <label>Depozito<input name="depozito" type="number" step="0.01" min="0" value="@Vm.D(c => c.Depozito)" /></label>
                    <label>Komisyon %<input name="komisyonOran" type="number" step="0.01" min="0" value="@Vm.D(c => c.KomisyonOran)" /></label>
                    <label>Komisyon Tutar<input name="komisyonTutar" type="number" step="0.01" min="0" value="@Vm.D(c => c.KomisyonTutar)" /></label>
                    <label>Drop Ücreti<input name="dropUcreti" type="number" step="0.01" min="0" value="@Vm.D(c => c.DropUcreti)" /></label>
                    <label>Sonra Öde %<input name="sonraOdeOran" type="number" step="0.01" min="0" value="@Vm.D(c => c.SonraOdeOran)" /></label>
                </div>
            </div>
        </div>
        <div>
            <div class="kf-hesap">
                @if (Vm.Edit)
                {
                    <strong>Vergi + Toplam (sözleşme değerleri)</strong>
                    <div class="row"><span>Baz Tutar (brüt)</span><span class="num">@Vm.Rental!.Tutar.ToString("N2")</span></div>
                    <div class="row"><span>Ek Hizmet Tutarı</span><span class="num">@Vm.Kalemler.Sum(a => a.Toplam).ToString("N2")</span></div>
                    <div class="row"><span>Fazla KM / Yakıt / Uzatma</span><span class="num">@((Vm.Rental!.FazlaKmBedeli + Vm.Rental!.YakitBedeli + Vm.Rental!.UzatmaBedeli).ToString("N2"))</span></div>
                    <div class="row top"><span>Genel Toplam</span><span class="num">@Vm.Rental!.GenelToplam.ToString("N2")</span></div>
                    <div class="row"><span>Tahsilat</span><span class="num">@Vm.Rental!.Tahsilat.ToString("N2")</span></div>
                    <div class="row top"><span>Kalan (Bakiye)</span><span class="num">@Vm.Rental!.Bakiye.ToString("N2")</span></div>
                    <p class="muted small" style="margin:.3rem 0 0;">Fiyat güncellemesi fark faturası akışıyla; KDV ayrışımı fatura kesiminde.</p>
                }
                else
                {
                    <strong>Vergi + Toplam (canlı — sunucu motoru)</strong>
                    <div class="row"><span>Kira Tutarı (KDV hariç)</span><span class="num" data-fp="net">—</span></div>
                    <div class="row"><span>KDV (%20)</span><span class="num" data-fp="kdv">—</span></div>
                    <div class="row"><span>Ek Hizmet Tutarı</span><span class="num" data-fp="ektoplam">—</span></div>
                    <div class="row"><span>Damga Vergisi</span><span class="num" title="Kira-seviyesi alan (bilgi) — fatura kesiminde varsayılan">@(Vm.Rental?.DamgaVergisi?.ToString("N2") ?? "—")</span></div>
                    <div class="row top"><span>Genel Toplam</span><span class="num" data-fp="toplam">—</span></div>
                    <div class="row"><span>Kur</span><span class="num" data-fp="kur">—</span></div>
                    <div class="row"><span>Genel Toplam (TL)</span><span class="num" data-fp="tl">—</span></div>
                    <div class="row"><span>Tahsilat</span><span class="num">0,00</span></div>
                    <div class="row top"><span>Kalan</span><span class="num" data-fp="kalan">—</span></div>
                    <p class="muted small" data-fp="not" style="margin:.3rem 0 0;">Ücret ve tarih girin.</p>
                }
            </div>
            <div class="card">
                <strong>Bakiye / Fatura Durumu</strong>
                @if (Vm.Edit)
                {
                    <table class="kv">
                        <tbody>
                            <tr><th>Genel Toplam</th><td class="num">@Vm.Rental!.GenelToplam.ToString("N2")</td></tr>
                            <tr><th>Tahsilat</th><td class="num">@Vm.Rental!.Tahsilat.ToString("N2")</td></tr>
                            <tr><th>Bakiye</th><td class="num">@Vm.Rental!.Bakiye.ToString("N2")</td></tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="muted small">Kayıt sonrası: müşteri bakiyesi, tahsilat ve fatura durumu burada (ledger'dan) görünür.</p>
                }
            </div>
        </div>
    </div>
</section>
@code {
    [Parameter, EditorRequired] public RentalFormVm Vm { get; set; } = default!;
}
