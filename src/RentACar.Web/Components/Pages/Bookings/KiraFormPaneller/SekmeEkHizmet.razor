@* EK HİZMETLER — satır-bazlı matris. Tanım satırları (EkHizmetTanim master) S1: checkbox (ekSecim) +
   miktar (ekMiktar_{id}) create POST'unda RentalAddOnService.AddAsync döngüsüne gider (tanım-snapshot
   fiyatı — serbest-fiyat override BİLİNÇLİ yok: önizleme==kayıt sapmasın). Satır toplamı canlı hesap
   yanıtından dolar (data-ekrow). Sigorta katalogu (CoverageProduct) görünür-pasif (S2: teminatlar
   booking matrahına girmez — KURAL A; RentalAddOn eşlemesi ileride). *@
<section class="kf-panel" data-panel-group="sekme" data-panel="ekhizmet" hidden>
    <div class="card" style="display:flex;gap:1rem;flex-wrap:wrap;align-items:center;">
        <span class="muted small">Hizmet Döviz:</span><span class="kf-ro" style="padding:.2rem .5rem;border-radius:4px;" title="Ek hizmetler kira dövizinde hesaplanır">kira dövizi</span>
        <span class="muted small">Hizmet Satan:</span><select disabled title="TODO: personel/dış-tedarik ataması (B2B)"><option>Bizim</option></select>
        <label class="muted small" style="display:flex;gap:.3rem;align-items:center;"><input type="checkbox" disabled title="TODO: FULL CREDIT — Faturalama Tipi alanında mevcut" class="u-w-auto" /> FULL CREDIT</label>
        <span class="kf-kalan-badge">Ek Hizmet Toplamı: <span data-fp="ektoplam">—</span></span>
    </div>

    @if (Vm.EkHizmetler.Count == 0 && Vm.Sigortalar.Count == 0)
    {
        <p class="muted">Tanımlı ek hizmet yok. Önce <a class="link" href="/ek-hizmetler">Ek Hizmet Tanımları</a> master'ından satırları oluşturun (Bebek Koltuğu, Navigasyon, Ek Sürücü, Drop Bedeli...).</p>
    }
    @if (!Vm.Edit)
    {
    <table class="grid kf-matris">
        <thead>
            <tr><th></th><th>Hizmet</th><th>Miktar/Gün</th><th>Birim (net)</th><th>KDV</th><th>Hizmet Satan</th><th>Fiyat Tipi</th><th class="num">Satır Toplamı</th></tr>
        </thead>
        <tbody>
            @foreach (var t in Vm.EkHizmetler)
            {
                <tr>
                    <td><input type="checkbox" name="ekSecim" value="@t.Id" class="u-w-auto" /></td>
                    @* FAZ-80: açıklama ipucu + maks gün rozeti. İkisi de BİLGİ amaçlı —
                       miktar alanı serbest kalır (sınırı kurala çevirmek fiyat motoru kararı). *@
                    <td title="@t.Aciklama">@t.Ad <span class="muted small">(@t.Kod)</span></td>
                    <td>
                        <input name="ekMiktar_@t.Id" type="number" value="1" min="0.01" step="0.01" />
                        @if (t.MaxGun is { } mg) { <span class="muted small">maks @mg gün</span> }
                    </td>
                    <td class="num kf-ro" style="border-radius:4px;">@t.BirimUcret.ToString("N2")</td>
                    <td class="num kf-ro" style="border-radius:4px;">%@((t.KdvOrani * 100).ToString("0"))</td>
                    <td><select disabled title="TODO: dış tedarik ledger ataması"><option>Bizim</option><option>Dış Tedarik</option></select></td>
                    <td><select disabled title="TODO: NRM/Özel/Ücretsiz fiyat tipi — tanım fiyatı kullanılır (önizleme==kayıt)"><option>NRM</option></select></td>
                    <td class="num" data-ekrow="@t.Id">—</td>
                </tr>
            }
            @foreach (var s in Vm.Sigortalar)
            {
                <tr class="pasif" title="Sigorta/teminat paketleri sözleşme matrahına girmez (KURAL A) — RentalAddOn eşlemesi TODO">
                    <td><input type="checkbox" disabled class="u-w-auto" /></td>
                    <td>@s.Ad <span class="muted small">(@s.Kod — sigorta katalogu)</span></td>
                    <td>—</td>
                    <td class="num">@(s.GunlukUcret?.ToString("N2") ?? "—")</td>
                    <td class="num">@(s.KdvOrani is { } o ? $"%{o * 100:0}" : "—")</td>
                    <td>@(s.Zorunlu ? "Zorunlu" : "Opsiyonel")</td>
                    <td>@(s.MaxGun is { } mg ? $"maks {mg} gün" : "—")</td>
                    <td class="num">—</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="muted small">İşaretlenen satırlar kira KAYDIYLA birlikte eklenir (tanım fiyat snapshot'ı; kayıt sonrası bu sekmeden ekle/çıkar — faturalanmış kirada değişmez). Satır toplamları sunucu motorundan canlı gelir.</p>
    }
    else
    {
        <table class="grid tr-grid">
            <thead><tr><th>Hizmet</th><th class="num">Miktar</th><th class="num">Birim NET</th><th class="num">KDV</th><th class="num">Net</th><th class="num">KDV Tutar</th><th class="num">Toplam</th><th></th></tr></thead>
            <tbody>
                @if (Vm.Kalemler.Count == 0)
                {
                    <tr><td colspan="8" class="muted">Ek hizmet eklenmemiş.</td></tr>
                }
                @foreach (var a in Vm.Kalemler)
                {
                    <tr>
                        <td>@a.Ad</td>
                        <td class="num">@a.Miktar</td>
                        <td class="num">@a.BirimNetFiyat.ToString("N2")</td>
                        <td class="num">@($"%{a.KdvOrani * 100:0.##}")</td>
                        <td class="num">@a.NetTutar.ToString("N2")</td>
                        <td class="num">@a.KdvTutar.ToString("N2")</td>
                        <td class="num">@a.Toplam.ToString("N2")</td>
                        <td>@if (Vm.Rental!.Durum != RentACar.Domain.Enums.RentalStatus.Iptal)
                            {
                                <button type="submit" form="ekhizmet-sil-@a.Id" class="link danger" disabled="@(!Vm.OperasyonYetkisi)">Sil</button>
                            }</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Vm.Rental!.Durum != RentACar.Domain.Enums.RentalStatus.Iptal)
        {
            @* Ekle mini-formu — ikincil form (form="kira-ekhizmet", ana formun dışında) *@
            <div class="grid-form">
                <label>Hizmet
                    <select form="kira-ekhizmet" name="ekHizmetTanimId" required>
                        <option value="">— seç —</option>
                        @foreach (var t in Vm.EkHizmetler) { <option value="@t.Id">@t.Ad (@t.BirimUcret.ToString("N2") net)</option> }
                    </select>
                </label>
                <label>Miktar<input form="kira-ekhizmet" name="miktar" type="number" step="0.01" min="0.01" value="1" required /></label>
                <label class="u-self-end"><button type="submit" form="kira-ekhizmet" disabled="@(!Vm.OperasyonYetkisi)">Ekle</button></label>
            </div>
            <p class="muted small">Kalem tanım fiyat snapshot'ıyla eklenir; toplamlar aynı işlemde yeniden hesaplanır. Faturalanmış kirada değişiklik engellenir.</p>
        }
    }
</section>
@code {
    [Parameter, EditorRequired] public KiraFormVm Vm { get; set; } = default!;
}
