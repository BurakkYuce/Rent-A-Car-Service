@* KİRA BİLGİSİ / TESLİMAT — tarih/ofis/tür KANONİK alanları burada (name taşır; Hızlı Giriş aynalar).
   EDIT: tarih alanları DONUK (gri — değişiklik yalnız Uzat; whitelist'te de yok), ofis/tür/km-parametreleri
   düzenlenebilir (Kirada), teslim mini-formu (form="kira-teslim") teslim edilmemiş kirada görünür. *@
<section class="kf-panel" data-panel-group="sekme" data-panel="kira" hidden>
    <div class="card">
        <strong>Kira Bilgisi</strong>
        <div class="grid-form">
            @if (Vm.Edit)
            {
                <label>Başlangıç Tarihi<input value="@Vm.Rental!.BasTar.LocalDateTime.ToString("dd.MM.yyyy HH:mm")" readonly title="Tarih değişikliği: Dönüş sekmesi > Kira Uzat" /></label>
                <label>Bitiş (Beklenen)<input value="@Vm.Rental!.BitTar.LocalDateTime.ToString("dd.MM.yyyy HH:mm")" readonly title="Tarih değişikliği: Dönüş sekmesi > Kira Uzat" /></label>
            }
            else
            {
                <label>Başlangıç Tarihi
                    <input name="basTar" type="datetime-local" max="@KiraFormVm.MaxBasTarStr" value="@Vm.BasTarPrefill" required />
                </label>
                <label>Bitiş (Beklenen) Tarih
                    <input name="bitTar" type="datetime-local" value="@Vm.BitTarPrefill" required />
                </label>
            }
            <label>Çıkış Ofisi
                <select name="cikisOfisi">
                    <option value="">—</option>
                    @foreach (var o in Vm.Locations) { <option selected="@Vm.Sel(c => c.CikisOfisi, o.Ad)">@o.Ad</option> }
                </select>
            </label>
            <label>Dönüş Ofisi
                <select name="donusOfisi">
                    <option value="">—</option>
                    @foreach (var o in Vm.Locations) { <option selected="@Vm.Sel(c => c.DonusOfisi, o.Ad)">@o.Ad</option> }
                </select>
            </label>
            <label>Kiralama Türü
                <select name="kiralamaTuru">
                    <option value="">—</option>
                    @foreach (var o in KiraFormVm.KiralamaTurleri) { <option selected="@Vm.Sel(c => c.KiralamaTuru, o)">@o</option> }
                </select>
            </label>
            @* FAZ 4.2-B4: job kapısı — kira-başına opt-in (tenant ayarındaki job açıksa vadesi gelen
               dönemleri otomatik keser; manuel kesim bu bayraktan bağımsız). *@
            <label class="check u-self-end">
                <input type="checkbox" name="donemselFaturalama" value="true"
                       checked="@(Vm.Edit && Vm.Rental!.DonemselFaturalama)" /> Dönemsel faturalama (job)
            </label>
            <label>Faturalama Tipi
                <select name="faturalamaTipi">
                    <option value="">—</option>
                    @foreach (var o in KiraFormVm.FaturalamaTipleri) { <option selected="@Vm.Sel(c => c.FaturalamaTipi, o)">@o</option> }
                </select>
            </label>
            <label>Rezervasyon Kaynağı
                <input name="kaynak" list="dl-kf-kaynak" autocomplete="off" placeholder="Seç veya yaz" maxlength="64" value="@Vm.S(c => c.Kaynak)" />
            </label>
            <label>Talep Türü<input name="talepTuru" maxlength="64" value="@Vm.S(c => c.TalepTuru)" /></label>
            <label>Geldiği Birim<input name="geldigiBirim" maxlength="64" value="@Vm.S(c => c.GeldigiBirim)" /></label>
            @* FAZ-47 — İŞLEM ŞUBE artık GERÇEK değeri gösterir (eski "TODO: şube FK yetki katmanı" notu
               bayattı: FAZ 5-C1..C5 ile şube-FK katmanı tamamlandı). Alan SALT-OKUNUR ve bu bilinçlidir:
               CikisSubeId, CikisOfisi'nden OfficeBranchInterceptor tarafından HER KAYITTA yeniden türetilir —
               forma ayrı bir "şube override" select'i koymak (a) interceptor tarafından anında ezilir,
               (b) sözleşmeyi operatörün kendi şube kapsamı dışına taşıyıp listelerinden düşürebilirdi.
               Şube değiştirmek için yukarıdaki Çıkış Ofisi değiştirilir. *@
            <label>İşlem Şube
                <input readonly value="@(Vm.Edit ? (Vm.IslemSubeAdi ?? "— (ofis şubeye eşlenmemiş)") : "çıkış ofisinden türetilir")"
                       title="Çıkış ofisinden türetilir (Ofis → Lokasyon → Şube). Değiştirmek için Çıkış Ofisi'ni değiştirin." /></label>
        </div>
    </div>
    <div class="card">
        <strong>Km / Aşım Parametreleri</strong>
        <div class="grid-form">
            @if (Vm.Edit && !Vm.Kirada)
            {
                <label>KM Limit<input value="@Vm.Rental!.KmLimit" readonly title="Tamamlanmış kirada donuk (dönüş hesabı yapıldı)" /></label>
                <label>Fazla KM Ücreti<input value="@Vm.Rental!.FazlaKmUcret.ToString("N2")" readonly /></label>
                <label>Eksik Yakıt Birim Ücreti<input value="@Vm.Rental!.YakitBirimUcret.ToString("N2")" readonly /></label>
                @* Donuk değerler yine POST edilir (update whitelist'i değişiklik olmadığını doğrular) *@
                <input type="hidden" name="kmLimit" value="@Vm.Rental!.KmLimit" />
                <input type="hidden" name="fazlaKmUcret" value="@Vm.D(c => c.FazlaKmUcret)" />
                <input type="hidden" name="yakitBirimUcret" value="@Vm.D(c => c.YakitBirimUcret)" />
            }
            else
            {
                <label>KM Limit (0 = sınırsız)<input name="kmLimit" type="number" min="0" step="1" value="@Vm.I(c => c.KmLimit)" /></label>
                <label>Fazla KM Ücreti<input name="fazlaKmUcret" type="number" min="0" step="0.01" value="@Vm.D(c => c.FazlaKmUcret)" /></label>
                <label>Eksik Yakıt Birim Ücreti<input name="yakitBirimUcret" type="number" min="0" step="0.01" value="@Vm.D(c => c.YakitBirimUcret)" /></label>
            }
        </div>
        <p class="muted small">Dönüş hesabında (fazla km × ücret, eksik yakıt × ücret) kullanılır — para otoritesi dönüş anı; her değişiklik denetim izinde.</p>
    </div>
    <div class="card">
        <strong>Vade / Opsiyon / Takip</strong>
        <div class="grid-form">
            <label>Opsiyon Net<input name="opsiyonNet" type="number" step="0.01" min="0"
                value="@Vm.D(c => c.OpsiyonNet)" title="Kira-seviyesi opsiyon tutarı (bilgi — deftere yansımaz)" /></label>
            <label>Opsiyon Gün<input name="opsiyonGun" type="number" min="0"
                value="@Vm.I(c => c.OpsiyonGun)" title="Opsiyon gün sayısı (bilgi)" /></label>
            <label>Vade / Fatura Dönemi<input value="cari karttan okunur" readonly title="Customer.VadeGun / FaturaDonemi" /></label>
            <label>Fatura Profili<input value="—" readonly title="TODO: e-Fatura profili (entegrasyon stub)" /></label>
            @if (Vm.Edit)
            {
                <label>Hediye Gün<span class="kf-ro kf-robox">@(Vm.Rental!.HediyeGun?.ToString() ?? "—")</span></label>
            }
            else
            {
                <label>Hediye Gün / Motor Dökümü<span class="kf-ro kf-robox" data-fp="dokum">—</span></label>
            }
            <label class="kf-inline">
                <input type="hidden" name="otomatikUzat" value="false" />
                <input type="checkbox" name="otomatikUzat" value="true" class="u-w-auto" checked="@Vm.B(c => c.OtomatikUzat)" /> Otomatik Uzat
            </label>
        </div>
    </div>
    <div class="card">
        <strong>KABİS</strong>
        <div class="grid-form">
            <label class="kf-inline">
                <input type="hidden" name="kabisCikis" value="false" />
                <input type="checkbox" name="kabisCikis" value="true" class="u-w-auto" checked="@Vm.B(c => c.KabisCikis)" /> Kabis Çıkış Yapıldı
            </label>
            <label class="kf-inline">
                <input type="hidden" name="kabisDonus" value="false" />
                <input type="checkbox" name="kabisDonus" value="true" class="u-w-auto" checked="@Vm.B(c => c.KabisDonus)" /> Kabis Dönüş Yapıldı
            </label>
        </div>
        <p class="muted small">KABİS bildirimi entegrasyonu stub — işaretler operatör takibi için saklanır.</p>
    </div>
    <div class="card">
        <strong>Teslimat (Çıkış)</strong>
        @if (Vm.Kirada && !Vm.TeslimEdildi)
        {
            @* Teslim mini-formu — ikincil form (form="kira-teslim", ana formun dışında tanımlı) *@
            <div class="grid-form">
                <label>Çıkış Km<input form="kira-teslim" name="cikisKm" type="number" min="0" value="0" required /></label>
                @* FAZ-82: ön-değer artık tenant ayarından (Ayarlar → Varsayılan Çıkış Yakıt Seviyesi);
                   ayar yoksa eski sabit 8. Teslim eden operatör değeri görür ve değiştirebilir. *@
                <label>Çıkış Yakıt (0-12)<input form="kira-teslim" name="cikisYakit" type="number" min="0" max="12" value="@Vm.TenantVarsayilanYakit" required /></label>
                <label class="u-self-end"><button type="submit" form="kira-teslim" disabled="@(!Vm.OperasyonYetkisi)">Teslim Et</button></label>
            </div>
            <p class="muted small">Araç odometresi aynı işlemde güncellenir; araç durumu Kirada olur.</p>
        }
        else
        {
            <div class="grid-form">
                <label>Çıkış Km<input readonly value="@(Vm.TeslimEdildi ? Vm.Rental!.CikisKm.ToString() : "kayıttan sonra teslimde girilir")" /></label>
                <label>Çıkış Yakıt (0-12)<input readonly value="@(Vm.TeslimEdildi ? Vm.Rental!.CikisYakit?.ToString() : "kayıttan sonra teslimde girilir")" /></label>
            </div>
        }
        @* FAZ-47 — TESLİM EDEN (çıkış) personeli. Dönüşteki "Teslim Alan"ın (SekmeDonus) çıkış karşılığı.
           BİLİNÇLİ olarak ANA formda (form= attribute YOK): teslim mini-formu bir kez çalışır, oysa bu
           bilgi sonradan da düzeltilebilmelidir (RentalUpdateInput whitelist'i — personel ataması, para/tarih
           değil). Liste PersonelService.ListForSelectAsync'ten gelir (PII'siz; ListAsync ManageUsers ister
           ve Operatör'de patlar — CLAUDE.md §6 tuzağı). Yetkisiz rolde liste boş → yalnız "—". *@
        @if (Vm.Edit)
        {
            <div class="grid-form">
                <label>Teslim Eden (çıkış)
                    <select name="teslimEdenPersonelId">
                        <option value="">—</option>
                        @foreach (var p in Vm.Personeller)
                        {
                            <option value="@p.Id" selected="@(Vm.Rental!.TeslimEdenPersonelId == p.Id)">@p.Ad @p.Soyad</option>
                        }
                    </select>
                </label>
            </div>
        }
    </div>
</section>
@code {
    [Parameter, EditorRequired] public KiraFormVm Vm { get; set; } = default!;
}
