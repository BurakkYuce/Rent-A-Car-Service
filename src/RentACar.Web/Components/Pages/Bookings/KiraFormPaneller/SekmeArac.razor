@* ARAÇ — kanonik vehicleId + müsaitlik penceresi (GET alt-formu; inputlar form= attribute ile ana formun
   DIŞINDAKİ #musait-form'a bağlı — iç içe form OLUŞMAZ) + araçtan dolan gri bilgi kartı. *@
<section class="kf-panel" data-panel-group="sekme" data-panel="arac" hidden>
    @if (!Vm.Edit)
    {
    <div class="card">
        <strong>Müsaitlik Penceresi</strong>
        <div class="filter-bar" style="margin:.3rem 0;">
            <input form="musait-form" name="vfrom" type="date" value="@Vm.Vfrom" title="Müsaitlik başlangıç" />
            <input form="musait-form" name="vto" type="date" value="@Vm.Vto" title="Müsaitlik bitiş" />
            <input form="musait-form" name="vgrup" value="@Vm.Vgrup" placeholder="Grup (ops.)" />
            @* type=submit + form= → No-JS fallback (GET reload); JS bunu yakalar (preventDefault) ve
               AJAX ile araç listesini yerinde günceller → girilen veri KAYBOLMAZ. *@
            <button form="musait-form" type="submit" data-musait-getir>Müsait Araçları Getir</button>
            <a href="/kiralar/yeni" class="link" data-musait-temizle style="@(Vm.MusaitMod ? "" : "display:none;")">Tümünü göster</a>
        </div>
        @* JS yolunda buraya "N araç müsait" mesajı yazılır (sayfa yenilenmediği için server MusaitMod'a
           güvenmeyiz); no-JS fallback yenilemesinde server mesajı gösterir. *@
        <p class="muted small" data-musait-not>
            @if (Vm.MusaitMod) { <text>Seçili aralıkta <strong>@Vm.Vehicles.Count</strong> araç müsait — araç listesi filtrelendi, tarihler kira alanlarına geçti.</text> }
        </p>
    </div>
    }
    <div class="card">
        <strong>Araç Seçimi</strong>
        <div class="grid-form">
            @if (Vm.Edit)
            {
                <label>Araç (değiştirilemez — sözleşme konusu)
                    <select disabled>
                        @foreach (var v in Vm.Vehicles) { <option value="@v.Id" selected="@(v.Id == Vm.Rental!.VehicleId)">@v.Plaka — @v.Marka @v.Tip</option> }
                    </select>
                </label>
            }
            else
            {
                <label>Araç
                    @* FAZ-19: müsaitlik listesinden "Kirala" ile gelindiyse (?varac=) araç ön-seçili.
                       Ön-seçim yalnız GÖRÜNÜMdür — kayıt yine formdan gelen vehicleId ile yapılır. *@
                    <select name="vehicleId" required>
                        <option value="">—</option>
                        @foreach (var v in Vm.Vehicles) { <option value="@v.Id" selected="@(v.Id == Vm.Varac)">@v.Plaka — @v.Marka @v.Tip</option> }
                    </select>
                </label>
            }
        </div>
    </div>
    <div class="card">
        <strong>Araç Bilgisi (seçimden dolar)</strong>
        <div class="grid-form">
            <label>Tipi<span class="kf-ro kf-robox" data-veh="tip">@(Vm.Edit ? (SeciliArac?.Tip ?? "—") : "—")</span></label>
            <label>Marka<span class="kf-ro kf-robox" data-veh="marka">@(Vm.Edit ? (SeciliArac?.Marka ?? "—") : "—")</span></label>
            <label>Yılı<span class="kf-ro kf-robox" data-veh="yil">@(Vm.Edit ? (SeciliArac?.ModelYili?.ToString() ?? "—") : "—")</span></label>
            <label>Vites<span class="kf-ro kf-robox" data-veh="vites">@(Vm.Edit ? (SeciliArac?.Vites?.ToString() ?? "—") : "—")</span></label>
            <label>Yakıt Türü<span class="kf-ro kf-robox" data-veh="yakit">@(Vm.Edit ? (SeciliArac?.Yakit?.ToString() ?? "—") : "—")</span></label>
            <label>Araç Grubu<span class="kf-ro kf-robox" data-veh="grup">@(Vm.Edit ? (SeciliArac?.Grup ?? "—") : "—")</span></label>
            <label>Segment<span class="kf-ro kf-robox" data-veh="segment">@(Vm.Edit ? (SeciliArac?.Segment ?? "—") : "—")</span></label>
            <label>Güncel Km<span class="kf-ro num kf-robox" data-veh="km">@(Vm.Edit ? (SeciliArac?.Km.ToString() ?? "—") : "—")</span></label>
            <label>Şube<span class="kf-ro kf-robox" data-veh="sube">@(Vm.Edit ? (SeciliArac?.Sube ?? "—") : "—")</span></label>
            <label>Rez. Grubu<span class="kf-ro kf-robox" title="TODO: araçta ayrı rezervasyon grubu alanı yok — Grup kullanılıyor">—</span></label>
            @* FAZ-47 — "fiziksel araç-yeri alanı yok" notu BAYATTI: Vehicle.Konum FAZ-10'da eklenmişti,
               yalnız bu ekrana bağlanmamıştı (wire-in). Salt-okunur: araç kartı alanı bu formdan
               düzenlenmez (kira formu RentalContract yazar) — düzenleme aracın kendi kartında. *@
            <label>Araç Yeri (park/konum)<span class="kf-ro kf-robox" data-veh="konum"
                title="Aracın fiziksel konumu (araç kartındaki Konum alanı) — düzenleme araç kartında">@(Vm.Edit ? (SeciliArac?.Konum ?? "—") : "—")</span></label>
            <label>Doluluk Hesap<span class="kf-ro" title="Aracın ömür-boyu doluluk yüzdesi (karneden; dinamik fiyat çarpanı tarife kuralıyla — FAZ 3.A7)">@(Vm.AracDolulukYuzde is { } dol ? dol.ToString("N2") + "%" : "—")</span></label>
        </div>
    </div>
    <div class="card">
        <strong>Çıkış Km / Yakıt</strong>
        <div class="grid-form">
            <label>Çıkış Km<input readonly value="@(Vm.TeslimEdildi ? Vm.Rental!.CikisKm.ToString() : "teslim anında girilir (Kira Bilgisi > Teslimat)")" /></label>
            <label>Çıkış Yakıt (0-12)<input readonly value="@(Vm.TeslimEdildi ? Vm.Rental!.CikisYakit?.ToString() : "teslim anında girilir")" /></label>
        </div>
    </div>
</section>
@code {
    [Parameter, EditorRequired] public KiraFormVm Vm { get; set; } = default!;
    private Vehicle? SeciliArac => Vm.Edit ? Vm.Vehicles.FirstOrDefault(v => v.Id == Vm.Rental!.VehicleId) : null;
}
