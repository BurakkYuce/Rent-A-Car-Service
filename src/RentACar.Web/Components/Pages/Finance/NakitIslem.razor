@page "/finans/nakit-islem"
@attribute [Authorize(Policy = "izin:FinanceWrite")]
@using RentACar.Domain.Entities
@inject CustomerService Customers
@inject CashService Cash

<PageTitle>Nakit İşlem — RentPro</PageTitle>

<div class="page-head"><h1>Nakit İşlem (Tahsilat / Ödeme)</h1></div>

@if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }

@* FAZ-67 — canlı nakit_islem.aspx karşılığı: cariye gitmeden, bağımsız ekrandan tahsilat/ödeme.
   PARA MANTIĞI BURADA YENİDEN YAZILMAZ: form mevcut /finans/tahsilat ve /finans/odeme uçlarına
   gider, onlar da CashService.CollectAsync/PayAsync'i çağırır. İki giriş yüzeyi, TEK mantık —
   bunu varsayım olarak bırakmamak için regresyon testi iki yüzeyin defter etkisini karşılaştırır. *@
<form method="get" class="filter-bar">
    <label>Cari Ara<input name="q" value="@Q" placeholder="Ad / unvan / özel kod" /></label>
    <button type="submit">Ara</button>
    @if (!string.IsNullOrWhiteSpace(Q)) { <a href="/finans/nakit-islem" class="link">Temizle</a> }
</form>

@if (!string.IsNullOrWhiteSpace(Q))
{
    <div class="table-scroll">
    <table class="grid tr-grid">
        <thead><tr><th>Cari</th><th>Özel Kod</th><th class="num">Bakiye ₺</th><th>İşlem</th></tr></thead>
        <tbody>
            @if (_found.Count == 0)
            {
                <tr><td colspan="4" class="muted">Eşleşen cari yok.</td></tr>
            }
            @foreach (var c in _found)
            {
                <tr>
                    <td><a href="/cariler/@c.Id/ekstre">@c.DisplayName</a></td>
                    <td>@(c.OzelKod ?? "—")</td>
                    <td class="num @(_balances.GetValueOrDefault(c.Id) > 0 ? "neg" : null)">
                        @_balances.GetValueOrDefault(c.Id).ToString("N2")</td>
                    <td>
                        <a class="link" href="/finans/nakit-islem?q=@Uri.EscapeDataString(Q!)&amp;cariId=@c.Id">Seç</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@if (_selected is not null)
{
    <h2>@_selected.DisplayName</h2>
    <p class="muted small">Güncel bakiye <strong>@_selectedBalance.ToString("N2") ₺</strong>
        @(_selectedBalance > 0 ? "(müşteri borçlu)" : _selectedBalance < 0 ? "(alacaklı)" : "")</p>

    <div class="pair-forms">
        <details class="new-vehicle" open>
            <summary>Tahsilat</summary>
            <form method="post" action="/finans/tahsilat" class="grid-form"><AntiforgeryToken />
                <input type="hidden" name="cariId" value="@_selected.Id" />
                <input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />
                <input type="hidden" name="donus" value="/finans/nakit-islem?q=@Uri.EscapeDataString(Q ?? "")&amp;cariId=@_selected.Id" />
                @* Önerilen tutar: borç varsa bakiye kadar (UI kolaylığı — kullanıcı değiştirebilir,
                   sunucu hiçbir şeyi bu değerden türetmez). *@
                <label>Tutar<input name="tutar" type="number" step="0.01" min="0.01" required
                                   value="@Onerilen" /></label>
                <label>Tarih<input name="tarih" type="date" title="Boş = bugün" /></label>
                <label>Hesap
                    <select name="hesap"><option>Kasa</option><option>Banka</option></select>
                </label>
                <HesapSecici />
                <label>Kanal
                    <select name="kanal"><option value="">—</option><option>Masaüstü</option><option>Mobil</option><option>Tablet</option></select>
                </label>
                <label>Döviz
                    <select name="doviz"><option>TRY</option><option>USD</option><option>EUR</option></select>
                </label>
                <label>Kur<input name="kur" type="number" step="0.0001" placeholder="boş = otomatik" /></label>
                <label class="u-col-full">Açıklama<input name="aciklama" /></label>
                <button type="submit">Tahsilat Yap</button>
            </form>
        </details>

        <details class="new-vehicle">
            <summary>Ödeme (tediye)</summary>
            <form method="post" action="/finans/odeme" class="grid-form"><AntiforgeryToken />
                <input type="hidden" name="cariId" value="@_selected.Id" />
                <input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />
                <input type="hidden" name="donus" value="/finans/nakit-islem?q=@Uri.EscapeDataString(Q ?? "")&amp;cariId=@_selected.Id" />
                <label>Tutar<input name="tutar" type="number" step="0.01" min="0.01" required /></label>
                <label>Tarih<input name="tarih" type="date" title="Boş = bugün" /></label>
                <label>Hesap
                    <select name="hesap"><option>Kasa</option><option>Banka</option></select>
                </label>
                <HesapSecici />
                <label>Kanal
                    <select name="kanal"><option value="">—</option><option>Masaüstü</option><option>Mobil</option><option>Tablet</option></select>
                </label>
                <label>Döviz
                    <select name="doviz"><option>TRY</option><option>USD</option><option>EUR</option></select>
                </label>
                <label>Kur<input name="kur" type="number" step="0.0001" placeholder="boş = otomatik" /></label>
                <label class="u-col-full">Açıklama<input name="aciklama" /></label>
                <button type="submit">Ödeme Yap</button>
            </form>
        </details>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "cariId")] public string? CariId { get; set; }

    private IReadOnlyList<Customer> _found = [];
    private Dictionary<Guid, decimal> _balances = new();
    private Customer? _selected;
    private decimal _selectedBalance;

    /// <summary>Borç varsa önerilen tahsilat tutarı; alacaklıda öneri yok (boş bırakılır).</summary>
    private string? Onerilen => _selectedBalance > 0m
        ? _selectedBalance.ToString(System.Globalization.CultureInfo.InvariantCulture)
        : null;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Q))
        {
            var result = await Customers.SearchAsync(new CustomerFilter { Query = Q, PageSize = 25 });
            _found = result.Items;
            foreach (var c in _found)
                _balances[c.Id] = await Cash.GetAccountBalanceAsync(c.Id);
        }

        if (Guid.TryParse(CariId, out var id))
        {
            _selected = _found.FirstOrDefault(c => c.Id == id) ?? await Customers.GetAsync(id);
            if (_selected is not null) _selectedBalance = await Cash.GetAccountBalanceAsync(_selected.Id);
        }
    }
}
