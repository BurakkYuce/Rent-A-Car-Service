@page "/toplu-gider"
@attribute [Authorize(Roles = "Admin,Yonetici,Muhasebe")]
@using RentACar.Domain.Enums
@inject CustomerService Cariler
@inject FinancialAccountService Hesaplar
@inject VehicleService Araclar

<PageTitle>Toplu Gider — RentPro</PageTitle>

<div class="page-head"><h1>Toplu Gider</h1><div class="actions"></div></div>
<p class="muted small">Tek seferde çok gider kalemi. ATOMİK (hep-ya-hiç) + dengeli defter. Her satır:
    <code>netTutar;açıklama;plaka</code> — açıklama ve plaka opsiyonel. Tip/ödeme/KDV/cari/vade/hesap
    tüm kalemler için ortaktır; <strong>plaka satır bazlıdır</strong>, böylece aynı toplu girişte
    farklı araçlara gider yazılabilir.</p>
@* Plaka satır bazlı ve HER SATIR AYRI GİDERDİR — tek bir gideri araçlara "paylaştırma" DEĞİL.
   Paylaştırma tutarı bölmeyi gerektirir ve yuvarlama artığının nereye gideceği ayrı bir karardır. *@
<p class="muted small">Plaka yazılan satır o aracın karnesine düşer (defterde <code>AccountRef</code>
    = araç). Plaka satır bazlıdır: her satır ayrı bir giderdir, tek gider araçlara bölünmez.</p>

@if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }
@if (Ok is not null) { <p class="muted">@Ok kalem işlendi.</p> }

<div class="filter-panel"><form method="post" action="/finans/toplu-gider" class="grid-form"><AntiforgeryToken />
    <input type="hidden" name="islemAnahtari" value="@_token" />
    <label>Gider Tipi
        <select name="tip">
            @foreach (var t in Enum.GetValues<ExpenseType>()) { <option>@t</option> }
        </select>
    </label>
    <label>Ödeme Yöntemi
        <select name="odemeYontemi">
            @foreach (var o in Enum.GetValues<OdemeYontemi>()) { <option>@o</option> }
        </select>
    </label>
    <label>KDV Oranı<input name="kdvOrani" type="number" step="0.01" min="0" value="0.20" /></label>
    @* Cari: Açık Hesap ödemede ZORUNLU (tedarikçiye borçlanılır) — servis zaten reddediyor,
       burada açıklaması var ki kullanıcı hatayı sonradan almasın. *@
    <label>Cari (tedarikçi)
        <select name="cariId">
            <option value="">— yok —</option>
            @foreach (var c in _cariler) { <option value="@c.Id">@c.DisplayName</option> }
        </select>
    </label>
    <label>Vade<input name="vade" type="date" title="Bilgi alanı — deftere girmez" /></label>
    <label>Hesap No
        <select name="finansalHesapId" title="Belge bilgisi — defter karşı hesabı ödeme yöntemine göre Kasa/Banka'dır">
            <option value="">— seçilmedi —</option>
            @foreach (var h in _hesaplar)
            {
                <option value="@h.Id">@h.Ad @(string.IsNullOrWhiteSpace(h.Iban) ? "" : $"({h.Iban})")</option>
            }
        </select>
    </label>
    <label class="u-col-full">Satırlar (netTutar;açıklama;plaka)
        <textarea name="satirlar" rows="8" placeholder="1000;Yakıt;34 ABC 34&#10;500;Bakım&#10;250;Lastik;06 XYZ 06" required></textarea>
    </label>
    <button type="submit">Toplu Kaydet</button>
</form></div>

<p class="muted small"><strong>Vade</strong> ve <strong>Hesap No</strong> belge bilgisidir; defter
    kaydı bunlardan etkilenmez (karşı hesap ödeme yöntemine göre Kasa/Banka/Cari olarak yazılır).</p>

@if (_plakalar.Count > 0)
{
    <details>
        <summary class="link">Plakalar (kopyala)</summary>
        <p class="muted small mono">@string.Join(" · ", _plakalar)</p>
    </details>
}

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    private readonly Guid _token = Guid.NewGuid(); // çift-submit idempotency

    private IReadOnlyList<Customer> _cariler = [];
    private IReadOnlyList<FinancialAccount> _hesaplar = [];
    private List<string> _plakalar = [];

    protected override async Task OnInitializedAsync()
    {
        _cariler = await Cariler.ListAsync();
        _hesaplar = await Hesaplar.ListActiveAsync();
        _plakalar = (await Araclar.ListAsync()).Select(v => v.Plaka).OrderBy(x => x, StringComparer.Ordinal).ToList();
    }
}
