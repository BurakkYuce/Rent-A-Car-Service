@page "/cari-virman"
@attribute [Authorize(Roles = "Admin,Yonetici,Muhasebe")]
@inject CustomerService Cariler
@inject CashService Kasa
@inject RentACar.Application.Branches.BranchService Subeler

<PageTitle>Cari Virman — RentPro</PageTitle>

<div class="page-head"><h1>Cari ↔ Cari Virman</h1><div class="actions"></div></div>
<p class="muted small">İki cari arası bakiye aktarımı. Dengeli çift kayıt: kaynak cari alacaklandırılır
    (bakiye azalır), hedef cari borçlandırılır (bakiye artar). Her iki carinin ekstresinde görünür.</p>

@if (Ok == "1")
{
    <p class="ok">Virman kaydedildi.</p>
}
@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<div class="filter-panel"><form method="post" action="/finans/cari-virman" class="grid-form"><AntiforgeryToken />
    <input type="hidden" name="islemAnahtari" value="@_token" />
    <label>Kaynak Cari (alacak)
        <select name="kaynakCariId" required>
            <option value="">— Seçin —</option>
            @foreach (var c in _cariler) { <option value="@c.Id">@c.DisplayName</option> }
        </select>
    </label>
    <label>Hedef Cari (borç)
        <select name="hedefCariId" required>
            <option value="">— Seçin —</option>
            @foreach (var c in _cariler) { <option value="@c.Id">@c.DisplayName</option> }
        </select>
    </label>
    <label>Tutar<input name="tutar" type="number" step="0.01" min="0.01" required /></label>
    <label>Döviz<input name="doviz" value="TRY" maxlength="3" /></label>
    <label>Kur<input name="kur" type="number" step="0.000001" min="0.000001" placeholder="boş = otomatik" title="Boş: TRY=1, dövizde sabit kur/TCMB otomatik" /></label>
    <label>Tarih<input name="tarih" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" title="Boş bırakılırsa bugün. Kapalı muhasebe dönemine virman atılamaz." /></label>
    <label>Vade<input name="vade" type="date" placeholder="(opsiyonel)" /></label>
    <label>Makbuz No<input name="makbuzNo" maxlength="32" /></label>
    <ComboBox Name="sube" Label="İşlem Şube" Options="_subeOpts" Placeholder="(opsiyonel)" />
    <label>Açıklama<input name="aciklama" placeholder="(opsiyonel)" /></label>
    <button type="submit">Virman Yap</button>
</form></div>
<p class="muted small">İşlemi yapan kullanıcı oturumdan yazılır — formda alanı yoktur.</p>

<h2 class="dash-h2">Virman Geçmişi</h2>

<form method="get" class="filter-bar">
    <label>Cari (kaynak ya da hedef)
        <select name="cariId">
            <option value="">— tümü —</option>
            @foreach (var c in _cariler) { <option value="@c.Id" selected="@(c.Id.ToString() == CariId)">@c.DisplayName</option> }
        </select>
    </label>
    <label>Ara<input name="ara" value="@Ara" placeholder="makbuz no / açıklama / şube" /></label>
    <label>Tarih Baş<input name="bas" type="date" value="@Bas" /></label>
    <label>Tarih Bit<input name="bit" type="date" value="@Bit" /></label>
    <button type="submit">Filtrele</button>
    @if (FiltreVar) { <a class="link" href="/cari-virman">Temizle</a> }
</form>

<p class="muted small">@_gecmis.Count virman · Toplam @_gecmis.Sum(v => v.TutarTl).ToString("N2") ₺
    <span class="muted">(TL-baz)</span></p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Tarih</th><th>Vade</th><th>Kaynak (alacak)</th><th>Hedef (borç)</th>
        <th class="num">Tutar</th><th>Döviz</th><th>Makbuz No</th><th>Şube</th><th>İşlem Yapan</th><th>Açıklama</th></tr></thead>
    <tbody>
        @if (_gecmis.Count == 0)
        {
            <tr><td colspan="10" class="muted">@(FiltreVar ? "Filtreye uyan virman yok." : "Virman kaydı yok.")</td></tr>
        }
        @foreach (var v in _gecmis)
        {
            <tr>
                <td>@v.Tarih.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td>@(v.Vade?.LocalDateTime.ToString("dd.MM.yyyy") ?? "—")</td>
                <td>@v.KaynakCariAd</td>
                <td>@v.HedefCariAd</td>
                @* Tutar DEFTERDEN okunur (künye tablosu para taşımaz) → ekstre ile ayrışamaz. *@
                <td class="num">@v.Tutar.ToString("N2")</td>
                <td>@v.Doviz</td>
                <td>@(v.MakbuzNo ?? "—")</td>
                <td>@(v.Sube ?? "—")</td>
                <td>@(v.IslemYapan ?? "—")</td>
                <td>@(v.Aciklama ?? "—")</td>
            </tr>
        }
    </tbody>
</table>
</div>
<p class="muted small">Bu liste künye kaydı olan virmanları gösterir. Künye alanları bu sürümde
    eklendiği için daha ÖNCE yapılmış virmanlar burada görünmez — onlar ilgili carinin ekstresinde
    durmaya devam eder (defter kayıtları olduğu gibi yerinde).</p>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }

    [SupplyParameterFromQuery(Name = "cariId")] public string? CariId { get; set; }
    [SupplyParameterFromQuery(Name = "ara")] public string? Ara { get; set; }
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }

    private IReadOnlyList<Customer> _cariler = [];
    private IReadOnlyList<CariVirmanSatirDto> _gecmis = [];
    private IReadOnlyList<string> _subeOpts = [];

    private bool FiltreVar => !string.IsNullOrWhiteSpace(CariId) || !string.IsNullOrWhiteSpace(Ara)
        || !string.IsNullOrWhiteSpace(Bas) || !string.IsNullOrWhiteSpace(Bit);
    // Her form açılışında sabit token → aynı formun çift-submit'i (çift tıklama/geri-gönder) tek virman.
    private readonly Guid _token = Guid.NewGuid();

    protected override async Task OnInitializedAsync()
    {
        _cariler = await Cariler.ListAsync();
        _subeOpts = (await Subeler.ListActiveAsync()).Select(x => x.Ad).ToList();
        _gecmis = await Kasa.ListCariVirmanlarAsync(new CariVirmanFilter
        {
            CariId = Guid.TryParse(CariId, out var c) ? c : null,
            Ara = Ara,
            Bas = Tarih(Bas),
            // Üst sınır GÜN SONUNA genişletilir (tarih girişi 00:00'a düşer).
            Bit = Tarih(Bit)?.AddDays(1).AddTicks(-1)
        });
    }

    private static DateTimeOffset? Tarih(string? s)
        => DateTimeOffset.TryParse(s, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? d.ToUniversalTime() : null;
}
