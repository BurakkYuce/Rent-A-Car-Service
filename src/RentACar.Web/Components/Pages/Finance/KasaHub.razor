@page "/kasa"
@attribute [Authorize(Policy = "izin:FinanceWrite")]
@inject ReportService Reports
@inject CashService Cash
@inject CustomerService Customers
@inject FinancialAccountService Hesaplar

<PageTitle>Kasa / Banka — RentPro</PageTitle>

<div class="page-head"><h1>Kasa / Banka</h1><div class="actions"><a href="/listeler/export/nakit-islemler">Nakit İşlem Excel</a> · <a href="/listeler/export/nakit-islemler?format=csv">CSV</a> · <a href="/listeler/export/nakit-islemler?format=pdf">PDF</a></div></div>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<div class="cards">
    <div class="card">
        <div class="card-num @(_summary.KasaBakiye < 0 ? "neg" : "pos")">@_summary.KasaBakiye.ToString("N2")</div>
        <div class="card-label">Kasa Bakiye ₺</div>
    </div>
    <div class="card">
        <div class="card-num @(_summary.BankaBakiye < 0 ? "neg" : "pos")">@_summary.BankaBakiye.ToString("N2")</div>
        <div class="card-label">Banka Bakiye ₺</div>
    </div>
    <div class="card">
        <div class="card-num pos">@_summary.KasaGiris.ToString("N2")</div>
        <div class="card-label">Kasa Giriş ₺</div>
    </div>
    <div class="card">
        <div class="card-num pos">@_summary.BankaGiris.ToString("N2")</div>
        <div class="card-label">Banka Giriş ₺</div>
    </div>
</div>

<details class="new-vehicle">
    <summary>↔ Virman (Kasa ↔ Banka, hesaplar arası)</summary>
    <form method="post" action="/finans/virman" class="grid-form"><AntiforgeryToken /><input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />@* M5-takip: çift-submit idempotency *@
        <label>Kaynak
            <select name="kaynak"><option>Kasa</option><option>Banka</option></select>
        </label>
        <HesapSecici Ad="kaynakHesapId" Etiket="Kaynak hesap" />
        <label>Hedef
            <select name="hedef"><option>Banka</option><option>Kasa</option></select>
        </label>
        <HesapSecici Ad="hedefHesapId" Etiket="Hedef hesap" />
        <label>Tutar<input name="tutar" type="number" step="0.01" required /></label>
        <label>Döviz
            <select name="doviz"><option>TRY</option><option>USD</option><option>EUR</option></select>
        </label>
        <label>Kur<input name="kur" type="number" step="0.0001" placeholder="boş = otomatik"
                        title="Boş: TRY=1, dövizde sabit kur/TCMB otomatik" /></label>
        @* kasa_virman.aspx künye alanları — DEFTERE GİRMEZ, ayrı künye tablosunda tutulur.
           "İşlemi Yapan" alanı YOK: oturumdan gelir, formdan alınması sahtelenebilir olurdu. *@
        <label>Makbuz No<input name="makbuzNo" maxlength="32" /></label>
        <label>İşlem Şubesi<input name="sube" maxlength="128" /></label>
        <label class="u-col-full">Açıklama<input name="aciklama" /></label>
        <button type="submit">Aktar</button>
    </form>
    <p class="muted small">Aynı türde iki hesap arasında da (ör. Banka A → Banka B) virman yapılabilir;
        bunun için kaynak ve hedef hesabı ayrı ayrı seçmeniz gerekir. Hesap seçilmezse işlem
        "hesap belirtilmemiş" olarak kaydedilir.</p>
</details>

@* FAZ-50 adversarial M7 — künye salt-yazılır kalmasın: formda girilen Makbuz No / İşlem Şubesi
   burada okunur. Tutar DEFTERDEN gelir (künye para taşımaz). *@
<h2>Son Virmanlar</h2>
<div class="table-scroll">
@* kart-mobil: 640px altında satır karta döner. Kartta virmanı tanımlayan çekirdek kalır
   (tarih başlık; kaynak/hedef/tutar/döviz/makbuz); künyenin geri kalanı masaüstünde. *@
<table class="grid tr-grid kart-mobil">
    <thead><tr><th>Tarih</th><th>Kaynak</th><th>Hedef</th><th class="num">Tutar</th><th>Döviz</th>
        <th>Makbuz No</th><th>İşlem Şubesi</th><th>İşlemi Yapan</th><th>Açıklama</th></tr></thead>
    <tbody>
        @if (_virmanlar.Count == 0)
        {
            <tr><td colspan="9" class="muted">Virman yok.</td></tr>
        }
        @foreach (var v in _virmanlar)
        {
            <tr>
                <td class="kart-baslik">@v.Tarih.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                <td data-etiket="Kaynak">@v.KaynakTur@(v.KaynakHesapId is { } kh && _hesapAdlari.TryGetValue(kh, out var kad) ? $" · {kad}" : "")</td>
                <td data-etiket="Hedef">@v.HedefTur@(v.HedefHesapId is { } hh && _hesapAdlari.TryGetValue(hh, out var had) ? $" · {had}" : "")</td>
                <td class="num" data-etiket="Tutar">@v.Tutar.ToString("N2")</td>
                <td data-etiket="Döviz">@v.Doviz</td>
                <td data-etiket="Makbuz No">@(v.MakbuzNo ?? "—")</td>
                <td>@(v.Sube ?? "—")</td>
                <td>@(v.IslemYapan ?? "—")</td>
                <td>@(v.Aciklama ?? "—")</td>
            </tr>
        }
    </tbody>
</table>
</div>

@* FAZ-84: kanal filtresi — canlı mobil_odeme.aspx eşdeğeri (ayrı ekran yerine bu listeye süzgeç).
   Kanal SAF BİLGİDİR: yalnız CashTransaction belgesinde durur, defteri/bakiyeyi/özeti ETKİLEMEZ. *@
@* FAZ-67 — canlı nakit_islem_ara.aspx süzgeci; FAZ-84'ün kanal seçimi korunarak genişletildi. *@
<form method="get" class="filter-bar">
    <input name="q" value="@Q" placeholder="İşlem no / cari / özel kod / açıklama" />
    <select name="tip">
        <option value="">Tip (tümü)</option>
        <option value="Tahsilat" selected="@(Tip == "Tahsilat")">Tahsilat</option>
        <option value="Odeme" selected="@(Tip == "Odeme")">Ödeme</option>
    </select>
    <select name="hesap">
        <option value="">Hesap (tümü)</option>
        <option value="Kasa" selected="@(HesapTur == "Kasa")">Kasa</option>
        <option value="Banka" selected="@(HesapTur == "Banka")">Banka</option>
    </select>
    <select name="kanal">
        <option value="">Kanal (tümü)</option>
        @foreach (var k in CashKanal.Hepsi)
        {
            <option value="@k" selected="@(KanalFiltre == k)">@k</option>
        }
    </select>
    <input name="bas" type="date" value="@Bas" title="İşlem tarihi ≥" />
    <input name="bit" type="date" value="@Bit" title="İşlem tarihi ≤ (gün dahil)" />
    <button type="submit">Süz</button>
    @if (SuzgecVar) { <a href="/kasa" class="link">Temizle</a> }
    <a class="link" href="/finans/nakit-islem"><strong>+ Yeni Nakit İşlem</strong></a>
</form>

<h2>Son İşlemler</h2>
<div class="table-scroll">
@* kart-mobil: 640px altında satır karta döner. Kartta işlem no başlık; tarih/tip/hesap/cari/tutar
   kalır. Kanal, cari kod, spesifik hesap ve açıklama masaüstünde kalır (kart 11 satır olmasın). *@
<table class="grid tr-grid kart-mobil">
    <thead>
        <tr><th>Tarih</th><th>No</th><th>Tip</th><th>Hesap</th><th>Kasa/Banka Hesabı</th><th>Kanal</th><th>Cari</th><th>Cari Kod</th><th>Tutar</th><th>Açıklama</th><th>Makbuz</th></tr>
    </thead>
    <tbody>
        @if (_txns.Count == 0)
        {
            <tr><td colspan="11" class="muted">İşlem yok.</td></tr>
        }
        @foreach (var satir in _txns)
        {
            var t = satir.Islem;
            <tr>
                @* Başlık ilk hücre: kart başlığının ortada değil ÜSTTE olması için. İşlem no hemen
                   altında ilk etiketli alan olarak duruyor. *@
                <td class="kart-baslik">@t.Tarih.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                <td class="mono" data-etiket="No">@t.No</td>
                <td data-etiket="Tip">
                    @if (t.TersKayitMi) { <span class="badge warn">Ters</span> }
                    @(t.Tip == CashTransactionType.Odeme ? "Ödeme" : "Tahsilat")
                </td>
                <td data-etiket="Hesap">@t.KarsiHesap</td>
                @* FAZ-50: hangi spesifik hesap. Boş = bu fazdan önceki kayıt (hesap belirtilmemiş). *@
                <td>@(t.HesapId is { } hid && _hesapAdlari.TryGetValue(hid, out var hAd) ? hAd : "—")</td>
                @* FAZ-84: Null → bu alan eklenmeden ÖNCE yazılmış geçmiş kayıt; o dönemde tek kanal
                   masaüstüydü, ekranda bu yüzden "Masaüstü" gösterilir (DB'de gerçek NULL kalır).
                   HesapId'den AYRI kavram: biri "hangi spesifik kasa/banka hesabı", diğeri
                   "hangi kanaldan girildi" (Masaüstü/Mobil/Tablet). *@
                <td>@(t.Kanal ?? CashKanal.Masaustu)</td>
                <td data-etiket="Cari"><a href="/cariler/@t.CariId/ekstre">@satir.CariAd</a></td>
                <td>@(satir.CariKod ?? "—")</td>
                <td data-etiket="Tutar">@t.Amount.Amount.ToString("N2") @t.Amount.Currency</td>
                <td>@t.Aciklama</td>
                <td class="kart-aksiyon"><a href="/kasa/makbuz/@t.Id/pdf" target="_blank" rel="noopener">PDF</a></td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "kanal")] public string? KanalFiltre { get; set; }
    // ---- FAZ-67 süzgeçleri ----
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "tip")] public string? Tip { get; set; }
    [SupplyParameterFromQuery(Name = "hesap")] public string? HesapTur { get; set; }
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }

    private bool SuzgecVar => !string.IsNullOrEmpty(KanalFiltre) || !string.IsNullOrWhiteSpace(Q)
        || !string.IsNullOrWhiteSpace(Tip) || !string.IsNullOrWhiteSpace(HesapTur)
        || !string.IsNullOrWhiteSpace(Bas) || !string.IsNullOrWhiteSpace(Bit);

    private CashboxSummaryDto _summary = new(0, 0, 0, 0, 0, 0);
    private IReadOnlyList<NakitIslemSatirDto> _txns = [];
    private Dictionary<Guid, string> _hesapAdlari = new();
    private IReadOnlyList<KasaVirmanSatirDto> _virmanlar = [];

    protected override async Task OnInitializedAsync()
    {
        _summary = await Reports.GetKasaBankaSummaryAsync();
        // FAZ-67: süzme SUNUCUDA (SearchIslemlerAsync) ve LİMİTTEN ÖNCE — FAZ-84'ün "önce süz,
        // sonra kes" dersi korunuyor: tersi olsaydı eşleşen satırlar ilk 50'nin dışında kalıp
        // görünmezdi. Cari adı/kodu da orada çözülür (PII çözülmez: düz-metin kolonlar).
        var tumu = await Cash.SearchIslemlerAsync(new CashFilter
        {
            Ara = string.IsNullOrWhiteSpace(Q) ? null : Q,
            Tip = Enum.TryParse<CashTransactionType>(Tip, out var tp) ? tp : null,
            Hesap = Enum.TryParse<LedgerAccountType>(HesapTur, out var hs) ? hs : null,
            Bas = ParseGun(Bas),
            Bit = ParseGun(Bit)?.AddDays(1).AddTicks(-1),   // bitiş günü DAHİL
            EnFazla = 2000
        });
        // Kanal süzgeci FAZ-84 semantiğini korur: NULL geçmiş kayıt "Masaüstü" sayılır.
        _txns = [.. (string.IsNullOrEmpty(KanalFiltre)
                ? tumu
                : tumu.Where(x => (x.Islem.Kanal ?? CashKanal.Masaustu) == KanalFiltre))
            .Take(50)];
        _hesapAdlari = (await Hesaplar.ListAsync()).ToDictionary(h => h.Id, h => h.Ad);
        _virmanlar = await Cash.ListKasaVirmanlarAsync(new KasaVirmanFilter { EnFazla = 50 });
    }

    private static DateTimeOffset? ParseGun(string? s)
        => DateTimeOffset.TryParse(s, out var d) ? new DateTimeOffset(d.Date, TimeSpan.Zero) : null;
}
