@page "/faturalar"
@attribute [Authorize(Roles = "Admin,Yonetici,Muhasebe")]
@inject InvoiceService Invoices
@inject CustomerService Customers

<PageTitle>Faturalar — RentPro</PageTitle>

<div class="page-head"><h1>Faturalar</h1><div class="actions"><a href="/listeler/export/faturalar">Excel</a> · <a href="/listeler/export/faturalar?format=csv">CSV</a> · <a href="/listeler/export/faturalar?format=pdf">PDF</a></div></div>
@if (Ok == "1") { <p class="ok">İşlem tamam.</p> }
@if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>No</th><th>Tarih</th><th>Müşteri</th><th>Net</th><th>KDV</th><th>Toplam</th><th>Döviz</th><th>Tür</th><th>Durum</th><th></th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="9" class="muted">Fatura yok.</td></tr>
        }
        @foreach (var i in _list)
        {
            <tr>
                <td>@i.No</td>
                <td>@i.Tarih.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td>@CustName(i.CariId)</td>
                <td>@i.NetTutar.ToString("N2")</td>
                <td>@i.KdvTutar.ToString("N2")</td>
                <td>@i.GenelToplam.ToString("N2")</td>
                <td>@(i.Currency == "TRY" ? "TL" : $"{i.Currency} @ {i.Kur.ToString("N4")} → {(i.GenelToplam * i.Kur).ToString("N2")} TL")</td>
                <td>@(i.IadeMi ? "İade" : (_iadeEdilmis.Contains(i.Id) ? "İade edilmiş" : "Normal"))</td>
                <td>@i.Durum</td>
                <td>
                    <a href="/faturalar/@i.Id/pdf" class="link" target="_blank" rel="noopener">Yazdır (PDF)</a>
                    @if (!i.IadeMi && i.Durum != InvoiceStatus.Iptal && !_iadeEdilmis.Contains(i.Id))
                    {
                        <form method="post" action="/finans/fatura-iade" style="display:inline"
                              data-confirm="@i.No faturası iade edilsin mi? (ters kayıt: gelir/KDV/cari geri alınır)">
                            <AntiforgeryToken />
                            <input type="hidden" name="kaynakFaturaId" value="@i.Id" />
                            <button type="submit" class="btn-danger">İade</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<h2>Manuel Fatura</h2>
<p class="muted small">Kiradan bağımsız serbest fatura (Borç Cari / Alacak Gelir+KDV, dengeli; dönem kilidine tabi).</p>
<form method="post" class="grid-form">
    <AntiforgeryToken />
    <input type="hidden" name="islemAnahtari" value="@_token" />@* çift-submit idempotency *@
    <label>Cari
        <select name="cariId" required>
            <option value="">—</option>
            @foreach (var c in _custMap)
            {
                <option value="@c.Key">@c.Value</option>
            }
        </select>
    </label>
    <label>Net Tutar<input name="netTutar" type="number" step="0.01" min="0" required /></label>
    <label>KDV Oranı<input name="kdvOrani" type="number" step="0.01" min="0" value="0.20" /></label>
    <label>Tarih<input name="tarih" type="date" /></label>
    <label>Vade<input name="vadeTarihi" type="date" /></label>
    <label>Açıklama<input name="aciklama" /></label>
    <button type="submit" formaction="/finans/fatura-manuel">Manuel Fatura Kes</button>
</form>

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private IReadOnlyList<Invoice> _list = [];
    private Dictionary<Guid, string> _custMap = new();
    private HashSet<Guid> _iadeEdilmis = new(); // kaynak faturaId'leri: zaten iade edilmiş → buton gizli
    private readonly Guid _token = Guid.NewGuid(); // manuel fatura çift-submit idempotency token

    protected override async Task OnInitializedAsync()
    {
        _list = await Invoices.ListAsync();
        _custMap = (await Customers.ListAsync()).ToDictionary(c => c.Id, c => c.DisplayName);
        _iadeEdilmis = _list.Where(x => x.KaynakFaturaId is not null)
            .Select(x => x.KaynakFaturaId!.Value).ToHashSet();
    }

    private string CustName(Guid id) => _custMap.TryGetValue(id, out var n) ? n : "—";
}
