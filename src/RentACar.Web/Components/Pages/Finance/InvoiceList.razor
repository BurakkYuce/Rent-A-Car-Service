@page "/faturalar"
@attribute [Authorize(Policy = "izin:FinanceWrite")]
@inject InvoiceService Invoices
@inject CustomerService Customers
@inject RentalService Rentals

<PageTitle>Faturalar — RentPro</PageTitle>

<div class="page-head"><h1>Faturalar</h1><div class="actions"><a href="/listeler/export/faturalar">Excel</a> · <a href="/listeler/export/faturalar?format=csv">CSV</a> · <a href="/listeler/export/faturalar?format=pdf">PDF</a></div></div>
@if (Ok == "1") { <p class="ok">İşlem tamam.</p> }
@if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }
@if (!string.IsNullOrEmpty(Atlanan))
{
    <div class="vt-box warn" style="margin:0 0 1rem;padding:.6rem .9rem;">
        <strong>Atlananlar:</strong>
        <ul style="margin:.25rem 0 0 1rem;">
            @foreach (var a in Atlanan.Split('|')) { <li class="small">@a</li> }
        </ul>
    </div>
}

@* FAZ-54 — canlı fatura_islem_listesi.aspx süzgeci. *@
<form method="get" class="filter-bar">
    <input name="ara" value="@Ara" placeholder="Fatura no / cari / özel kod / plaka / vergi no" />
    <select name="cariId">
        <option value="">Cari (tümü)</option>
        @foreach (var c in _cariler) { <option value="@c.Id" selected="@(CariId == c.Id.ToString())">@c.Ad</option> }
    </select>
    @* No aralığı süzgeci KALDIRILDI: metin karşılaştırmasıydı ve "no'lar sabit genişlikte"
       varsayımına dayanıyordu. Yeni fatura no'su GİB formatında (RNT2026000000001) ve eski
       FT-000042'lerle bir arada yaşıyor — karışık kümede "aralık" tanımsız, sessizce yanlış
       sonuç verirdi. Yerini aşağıdaki TARİH aralığı ile serbest metin araması alıyor. *@
    <select name="durum">
        <option value="">Durum (tümü)</option>
        <option value="iptalharic" selected="@(Durum == "iptalharic")">İptal hariç</option>
        <option value="iptal" selected="@(Durum == "iptal")">Yalnız iptal</option>
    </select>
    <select name="doviz">
        <option value="">Döviz (tümü)</option>
        @foreach (var d in _dovizler) { <option value="@d" selected="@(Doviz == d)">@d</option> }
    </select>
    <select name="ofis">
        <option value="">Ofis (tümü)</option>
        @foreach (var o in _ofisler) { <option value="@o" selected="@(Ofis == o)">@o</option> }
    </select>
    <input name="bas" type="date" value="@Bas" title="Tarih ≥" />
    <input name="bit" type="date" value="@Bit" title="Tarih ≤ (gün dahil)" />
    <button type="submit">Filtrele</button>
    @if (SuzgecVar) { <a href="/faturalar" class="link">Temizle</a> }
</form>

<p class="muted small">@_list.Count fatura
    @foreach (var (doviz, toplam) in Toplamlar) { <text>· @toplam.ToString("N2") @doviz </text> }
</p>

<div class="table-scroll">
@* kart-mobil: 640px altında satır karta döner. Kartta YALNIZ data-etiket taşıyan hücreler görünür —
   16 kolonluk fatura satırını telefona dökmek okumayı zorlaştırırdı. Kartta kalanlar faturayı
   ayırt eden alanlar: tarih, cari, GENEL TOPLAM (net/KDV ayrıntısı masaüstünde), döviz ve durum. *@
<table class="grid tr-grid kart-mobil">
    <thead><tr><th>No</th><th>Tarih</th><th>Müşteri</th><th>Cari Kod</th><th>Vergi D./No</th><th>Ülke</th>
        <th>Sözleşme</th><th>Plaka</th><th>Ofis</th><th>Net</th><th>KDV</th><th>Toplam</th><th>Döviz</th>
        <th>Tür</th><th>Durum</th><th></th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="16" class="muted">@(SuzgecVar ? "Aramaya uyan fatura yok." : "Fatura yok.")</td></tr>
        }
        @foreach (var satir in _list)
        {
            var i = satir.Fatura;
            <tr>
                <td class="kart-baslik">@i.No</td>
                <td data-etiket="Tarih">@i.Tarih.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td data-etiket="Müşteri">@satir.CariAd</td>
                <td>@(satir.CariOzelKod ?? "—")</td>
                <td>@(string.IsNullOrWhiteSpace(satir.VergiDairesi) && string.IsNullOrWhiteSpace(satir.VergiNo)
                        ? "—" : $"{satir.VergiDairesi} / {satir.VergiNo}")</td>
                <td>@(satir.Ulke ?? "—")</td>
                <td>@(satir.SozlesmeNo ?? "—")</td>
                <td>@(satir.Plaka ?? "—")</td>
                <td>@(satir.Ofis ?? "—")</td>
                <td>@i.NetTutar.ToString("N2")</td>
                <td>@i.KdvTutar.ToString("N2")</td>
                <td data-etiket="Toplam">@i.GenelToplam.ToString("N2")</td>
                <td data-etiket="Döviz">@(i.Currency == "TRY" ? "TL" : $"{i.Currency} @ {i.Kur.ToString("N4")} → {(i.GenelToplam * i.Kur).ToString("N2")} TL")</td>
                <td>@(i.IadeMi ? "İade" : (_iadeEdilmis.Contains(i.Id) ? "İade edilmiş" : "Normal"))</td>
                <td data-etiket="Durum">@i.Durum</td>
                <td class="kart-aksiyon">
                    <a href="/faturalar/@i.Id/pdf" class="link" target="_blank" rel="noopener">Yazdır (PDF)</a>
                    @if (!i.IadeMi && i.Durum != InvoiceStatus.Iptal && !_iadeEdilmis.Contains(i.Id))
                    {
                        @* Yetki çiti: uç grup kapısından DAHA DAR izin istiyor (UcIzinKapsamaTests) — kapılanmazsa 403 → /yetkisiz. *@
                        <AuthorizeView Policy="izin:FinanceReverse" Context="iadeCtx">
                            <form method="post" action="/finans/fatura-iade" style="display:inline"
                                  data-confirm="@i.No faturası iade edilsin mi? (ters kayıt: gelir/KDV/cari geri alınır)">
                                <AntiforgeryToken />
                                <input type="hidden" name="kaynakFaturaId" value="@i.Id" />
                                <button type="submit" class="btn-danger">İade</button>
                            </form>
                        </AuthorizeView>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<h2>Manuel Fatura</h2>
<p class="muted small">Kiradan bağımsız serbest fatura (Borç Cari / Alacak Gelir+KDV, dengeli; dönem kilidine tabi).</p>
<form method="post" class="grid-form">
    <AntiforgeryToken />
    <input type="hidden" name="islemAnahtari" value="@_token" />@* çift-submit idempotency *@
    <label>Cari
        <select name="cariId" required>
            <option value="">—</option>
            @foreach (var c in _cariler)
            {
                <option value="@c.Id">@c.Ad</option>
            }
        </select>
    </label>
    <label>Net Tutar<input name="netTutar" type="number" step="0.01" min="0" required /></label>
    <label>KDV Oranı<input name="kdvOrani" type="number" step="0.01" min="0" value="0.20" /></label>
    <label>Tarih/Saat<input name="tarih" type="datetime-local" title="Boş = şimdi (UTC). Saat de bu alandan girilir — ayrı sütun yok." /></label>
    <label>Vade<input name="vadeTarihi" type="date" /></label>
    <label>Açıklama<input name="aciklama" /></label>
    <label>İşlem Şube<input name="islemSube" /></label>
    <label>Evrak No<input name="evrakNo" /></label>
    <label>Fatura Özel Kod<input name="faturaOzelKod" /></label>
    <label>Ödeme Türü
        <input name="odemeTuru" list="dl-fatura-odeme" autocomplete="off" placeholder="Seç veya yaz" />
        <datalist id="dl-fatura-odeme"><option value="Kart" /><option value="Havale" /><option value="Nakit" /></datalist>
    </label>
    <label>Gönderim Şekli
        <input name="gonderimSekli" list="dl-fatura-gonderim" autocomplete="off" placeholder="Seç veya yaz" />
        <datalist id="dl-fatura-gonderim"><option value="Mail" /><option value="Kargo" /><option value="Posta" /></datalist>
    </label>
    <label>KDV Sıfır Sebep
        <select name="kdvSifirSebep">
            <option value="">—</option>
            <option value="İstisna Olmayan Diğer">İstisna Olmayan Diğer</option>
            <option value="15/b Uluslararası Kuruluşlara">15/b Uluslararası Kuruluşlara</option>
            <option value="11/1-A Hizmet İhracatı">11/1-A Hizmet İhracatı</option>
            <option value="350-Diğerleri">350-Diğerleri</option>
        </select>
    </label>
    <label>ÖTV<input name="otv" type="number" step="0.01" min="0" title="Bilgi amaçlı — deftere yansımaz" /></label>
    <label>Tevkifat Oran %<input name="tevkifatOran" type="number" step="0.01" min="0" max="100" title="Bilgi amaçlı — deftere yansımaz" /></label>
    <label>Tevkifat Tutar<input name="tevkifatTutar" type="number" step="0.01" min="0" title="Bilgi amaçlı — deftere yansımaz" /></label>
    <label>Damga Vergisi<input name="damgaVergisi" type="number" step="0.01" min="0" title="Bilgi amaçlı — deftere yansımaz" /></label>
    <button type="submit" formaction="/finans/fatura-manuel">Manuel Fatura Kes</button>
</form>

@* FAZ-54 — "Seçili Olanları Faturala". Para mantığı BURADA YENİDEN YAZILMAZ: her kira mevcut
   tekil kesim yolundan geçer (aynı guard'lar, aynı KDV/kur zinciri). Parti ATOMİK DEĞİL —
   biri hata verirse diğerleri kesilir ve atlananlar listelenir (FAZ-30 ile aynı gerekçe:
   tek bozuk sözleşme 19 geçerli faturayı geri almamalı). *@
<details class="new-vehicle">
    <summary>Toplu Faturala (faturasız kiralar)</summary>
    @if (_faturalanabilir.Count == 0)
    {
        <p class="muted">Faturalanacak kira yok.</p>
    }
    else
    {
        <form method="post" action="/finans/fatura-toplu"><AntiforgeryToken />
            <div class="table-scroll">
                @* Seçim kutusuna data-etiket VERİLDİ: etiketsiz hücre kartta gizlenir ve toplu
                   faturalama telefonda kullanılamaz hâle gelirdi. *@
                <table class="grid tr-grid kart-mobil">
                    <thead><tr><th></th><th>Sözleşme</th><th>Müşteri</th><th>Plaka</th><th>Durum</th>
                        <th class="num">Tutar</th><th>Döviz</th></tr></thead>
                    <tbody>
                        @foreach (var r in _faturalanabilir)
                        {
                            <tr>
                                <td data-etiket="Seç"><input type="checkbox" name="secili" value="@r.Id" /></td>
                                <td class="mono kart-baslik">@r.SozlesmeNo</td>
                                <td data-etiket="Müşteri">@r.MusteriAd</td>
                                <td data-etiket="Plaka">@r.Plaka</td>
                                <td>@r.Durum</td>
                                <td class="num" data-etiket="Tutar">@r.Tutar.ToString("N2")</td>
                                <td data-etiket="Döviz">@(r.Doviz ?? "TRY")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="grid-form">
                <label>KDV Oranı<input name="kdvOrani" type="number" step="0.01" min="0" max="1"
                                       placeholder="boş = her kiranın kendi oranı" 
                                       title="Boş bırakın: net fiyat modlu kiralarda oran zaten değiştirilemez" /></label>
                <button type="submit" data-confirm="Seçili kiralar için fatura kesilecek. Fatura silinemez (düzeltme iade faturasıyla yapılır). Devam?">
                    Seçilenleri Faturala
                </button>
            </div>
            <p class="muted small">Her kira <strong>tek tek</strong> kesilir — birinin hatası
                diğerlerini durdurmaz. Zaten faturalanmış kira yeniden kesilmez (fark varsa fark
                faturası oluşur).</p>
        </form>
    }
</details>

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    [SupplyParameterFromQuery(Name = "atlanan")] public string? Atlanan { get; set; }
    // ---- FAZ-54 süzgeçleri ----
    [SupplyParameterFromQuery(Name = "ara")] public string? Ara { get; set; }
    [SupplyParameterFromQuery(Name = "cariId")] public string? CariId { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }
    [SupplyParameterFromQuery(Name = "doviz")] public string? Doviz { get; set; }
    [SupplyParameterFromQuery(Name = "ofis")] public string? Ofis { get; set; }
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }

    private bool SuzgecVar => !string.IsNullOrWhiteSpace(Ara) || !string.IsNullOrWhiteSpace(CariId)
        || !string.IsNullOrWhiteSpace(Durum) || !string.IsNullOrWhiteSpace(Doviz)
        || !string.IsNullOrWhiteSpace(Ofis) || !string.IsNullOrWhiteSpace(Bas) || !string.IsNullOrWhiteSpace(Bit);

    /// <summary>Döviz kırılımlı toplam: farklı dövizleri tek sayıda toplamak anlamsız rakam üretir.</summary>
    private IEnumerable<(string Doviz, decimal Toplam)> Toplamlar
        => _list.GroupBy(x => x.Fatura.Currency)
            .Select(g => (Doviz: g.Key, Toplam: g.Sum(x => x.Fatura.GenelToplam)))
            .OrderBy(x => x.Doviz, StringComparer.Ordinal);

    private IReadOnlyList<InvoiceRow> _list = [];
    private IReadOnlyList<CariSecim> _cariler = [];
    private IReadOnlyList<string> _dovizler = [];
    private IReadOnlyList<string> _ofisler = [];
    private IReadOnlyList<RentalRow> _faturalanabilir = [];
    private HashSet<Guid> _iadeEdilmis = new(); // kaynak faturaId'leri: zaten iade edilmiş → buton gizli
    private readonly Guid _token = Guid.NewGuid(); // manuel fatura çift-submit idempotency token

    protected override async Task OnInitializedAsync()
    {
        _list = await Invoices.SearchAsync(new InvoiceFilter
        {
            Ara = string.IsNullOrWhiteSpace(Ara) ? null : Ara,
            CariId = Guid.TryParse(CariId, out var cid) ? cid : null,
            Iptal = Durum switch { "iptal" => true, "iptalharic" => false, _ => null },
            Doviz = string.IsNullOrWhiteSpace(Doviz) ? null : Doviz,
            Ofis = string.IsNullOrWhiteSpace(Ofis) ? null : Ofis,
            Bas = ParseGun(Bas),
            Bit = ParseGun(Bit)?.AddDays(1).AddTicks(-1)   // bitiş günü DAHİL
        });
        // PII'siz seçim listesi (ListAsync tüm müşterilerin TC/ehliyetini çözerdi).
        _cariler = await Customers.ListSecimAsync();

        // Süzgeç seçenekleri VERİDEN türetilir (sabit liste bakımı unutulur).
        var tumu = await Invoices.SearchAsync();
        _dovizler = [.. tumu.Select(x => x.Fatura.Currency).Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.Ordinal).OrderBy(x => x, StringComparer.Ordinal)];
        _ofisler = [.. tumu.Select(x => x.Ofis).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.CurrentCulture)];

        _iadeEdilmis = _list.Where(x => x.Fatura.KaynakFaturaId is not null)
            .Select(x => x.Fatura.KaynakFaturaId!.Value).ToHashSet();

        // FAZ-54 toplu faturalama: faturasız, iptal olmayan ve tutarı olan kiralar.
        _faturalanabilir = [.. (await Rentals.SearchAsync(new RentalFilter { Faturali = false }))
            .Where(r => r.Durum != RentalStatus.Iptal && r.Tutar > 0m).Take(200)];
    }

    private static DateTimeOffset? ParseGun(string? s)
        => DateTimeOffset.TryParse(s, out var d) ? new DateTimeOffset(d.Date, TimeSpan.Zero) : null;
}
