@page "/faturalar/detay-listesi"
@attribute [Authorize(Roles = "Admin,Yonetici,Muhasebe")]
@inject InvoiceService Faturalar
@inject CustomerService Customers
@inject LocationService Ofisler

<PageTitle>Fatura Detay Listesi — RentPro</PageTitle>

<div class="page-head">
    <h1>Fatura Detay Listesi</h1>
    <div class="actions">
        <a href="/listeler/export/fatura-detaylari?@Qs("excel")">Excel</a> ·
        <a href="/listeler/export/fatura-detaylari?@Qs("csv")">CSV</a> ·
        <a href="/listeler/export/fatura-detaylari?@Qs("pdf")">PDF</a>
    </div>
</div>
<p class="muted small">Her satır bir <strong>fatura kalemi</strong>dir (fatura başlığı değil): cari,
    kira sözleşmesi, araç ve rezervasyon bilgisi yanına çözümlenir. Tutarlar faturanın kesildiği
    andaki değerlerdir — burada yeniden hesaplanmaz.</p>

<form method="get" class="filter-bar">
    <label>Cari
        <select name="cariId">
            <option value="">— tümü —</option>
            @foreach (var c in _customers)
            {
                <option value="@c.Id" selected="@(c.Id.ToString() == CariId)">@c.DisplayName</option>
            }
        </select>
    </label>
    <label>Ara<input name="ara" value="@Ara" placeholder="fatura no / açıklama / sözleşme no" /></label>
    <label>Plaka<input name="plaka" value="@Plaka" placeholder="34 AB" /></label>
    <label>Çıkış Ofisi
        <select name="ofis">
            <option value="">— tümü —</option>
            @foreach (var o in _ofisler) { <option value="@o" selected="@(o == Ofis)">@o</option> }
        </select>
    </label>
    <label>Tarih Baş<input name="bas" type="date" value="@Bas" /></label>
    <label>Tarih Bit<input name="bit" type="date" value="@Bit" /></label>
    <label>İptaller
        <select name="iptal">
            <option value="" selected="@(Iptal != "gizle")">Göster</option>
            <option value="gizle" selected="@(Iptal == "gizle")">Gizle</option>
        </select>
    </label>
    <button type="submit">Ara</button>
    @if (FiltreVar) { <a class="link" href="/faturalar/detay-listesi">Temizle</a> }
</form>

@* Toplam iki kuralla hesaplanır:
   1) İPTAL satırları hiç girmez (iptal edilmiş kalem ciro değildir).
   2) İADE satırları NEGATİF girer. İade faturaları DB'de POZİTİF tutarla saklanıyor (satırlar
      kaynak faturadan aynalanır, ters yön yalnız defterde) — işaret verilmezse bir iade ciroyu
      düşürmek yerine ARTIRIRDI. DTO'daki Isaretli* alanları bu kuralı taşıyor.
   Çok-dövizli olabildiği için toplamlar TL-baz (× kur). *@
<p class="muted small">
    @_rows.Count kalem (@_rows.Count(r => r.Iptal) iptal · @_rows.Count(r => r.IadeMi) iade) ·
    Net @Gecerli.Sum(r => r.IsaretliNetTl).ToString("N2") ₺ ·
    KDV @Gecerli.Sum(r => r.IsaretliKdvTl).ToString("N2") ₺ ·
    <strong>Toplam @Gecerli.Sum(r => r.IsaretliToplamTl).ToString("N2") ₺</strong>
    <span class="muted">(iptaller hariç, iadeler negatif, TL-baz)</span>
</p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead>
        <tr>
            <th>Fatura No</th><th>Tarih</th><th>Vade</th><th>Durum</th>
            <th>Cari</th><th>Şehir</th><th>Mail</th>
            <th>Açıklama</th><th class="num">Miktar</th><th class="num">Birim Net</th><th class="num">KDV %</th>
            <th class="num">Satır Net</th><th class="num">Satır KDV</th><th class="num">Satır Toplam</th><th>Döviz</th>
            <th>Plaka</th><th>Sözleşme No</th><th>Çıkış Ofisi</th><th>Rez. Kaynağı</th>
        </tr>
    </thead>
    <tbody>
        @if (_rows.Count == 0)
        {
            <tr><td colspan="19" class="muted">@(FiltreVar ? "Aramaya uyan fatura kalemi yok." : "Fatura kalemi yok.")</td></tr>
        }
        @foreach (var r in _rows)
        {
            <tr class="@(r.Iptal ? "pasif" : null)">
                <td class="mono">@r.FaturaNo</td>
                <td>@r.Tarih.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td>@(r.VadeTarihi?.LocalDateTime.ToString("dd.MM.yyyy") ?? "—")</td>
                <td>
                    <span class="status-pill @(r.Iptal ? "sp-danger" : r.IadeMi ? "sp-warn" : "sp-success")">
                        @(r.Iptal ? "İptal" : r.IadeMi ? "İade" : "Geçerli")
                    </span>
                </td>
                <td>@r.CariAd</td>
                <td>@(r.CariSehir ?? "—")</td>
                <td>@(r.CariEmail ?? "—")</td>
                <td>@r.Aciklama</td>
                <td class="num">@r.Miktar.ToString("N2")</td>
                <td class="num">@r.BirimNetFiyat.ToString("N2")</td>
                <td class="num">@((r.KdvOrani * 100).ToString("0.##"))</td>
                <td class="num">@r.SatirNet.ToString("N2")</td>
                <td class="num">@r.SatirKdv.ToString("N2")</td>
                <td class="num">@r.SatirToplam.ToString("N2")</td>
                <td>@r.Doviz</td>
                <td>@(r.Plaka ?? "—")</td>
                <td>@(r.SozlesmeNo ?? "—")</td>
                <td>@(r.CikisOfisi ?? "—")</td>
                <td>@(r.RezervasyonKaynagi ?? "—")</td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "cariId")] public string? CariId { get; set; }
    [SupplyParameterFromQuery(Name = "ara")] public string? Ara { get; set; }
    [SupplyParameterFromQuery(Name = "plaka")] public string? Plaka { get; set; }
    [SupplyParameterFromQuery(Name = "ofis")] public string? Ofis { get; set; }
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }
    [SupplyParameterFromQuery(Name = "iptal")] public string? Iptal { get; set; }

    private IReadOnlyList<FaturaSatirDto> _rows = [];
    private IReadOnlyList<Customer> _customers = [];
    private string[] _ofisler = [];

    private IEnumerable<FaturaSatirDto> Gecerli => _rows.Where(r => !r.Iptal);

    private bool FiltreVar => !string.IsNullOrWhiteSpace(CariId) || !string.IsNullOrWhiteSpace(Ara)
        || !string.IsNullOrWhiteSpace(Plaka) || !string.IsNullOrWhiteSpace(Ofis)
        || !string.IsNullOrWhiteSpace(Bas) || !string.IsNullOrWhiteSpace(Bit)
        || !string.IsNullOrWhiteSpace(Iptal);

    protected override async Task OnInitializedAsync()
    {
        _customers = await Customers.ListAsync();
        _ofisler = (await Ofisler.ListActiveAsync()).Select(o => o.Ad).OrderBy(a => a).ToArray();

        _rows = await Faturalar.ListLinesAsync(new FaturaSatirFilter
        {
            CariId = Guid.TryParse(CariId, out var cid) ? cid : null,
            Ara = Ara,
            Plaka = Plaka,
            Ofis = Ofis,
            Bas = Tarih(Bas),
            // Üst sınır GÜN SONUNA genişletilir (tarih girişi 00:00'a düşer).
            Bit = Tarih(Bit)?.AddDays(1).AddTicks(-1),
            IptalleriGizle = Iptal == "gizle"
        });
    }

    private static DateTimeOffset? Tarih(string? s)
        => DateTimeOffset.TryParse(s, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? d.ToUniversalTime() : null;

    /// <summary>Filtreyi export bağlantılarına aynen taşır (ekranda gördüğün = indirdiğin).</summary>
    private string Qs(string format)
    {
        var p = new List<string> { "format=" + format };
        void Ekle(string ad, string? deger)
        {
            if (!string.IsNullOrWhiteSpace(deger)) p.Add($"{ad}={Uri.EscapeDataString(deger)}");
        }
        Ekle("cariId", CariId); Ekle("ara", Ara); Ekle("plaka", Plaka); Ekle("ofis", Ofis);
        Ekle("bas", Bas); Ekle("bit", Bit); Ekle("iptal", Iptal);
        return string.Join("&", p);
    }
}
