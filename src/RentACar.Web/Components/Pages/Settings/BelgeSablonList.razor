@page "/belge-sablonlari"
@attribute [Authorize(Roles = "Admin,Yonetici")]
@using RentACar.Application.BelgeSablon
@using RentACar.Domain.Enums
@inject BelgeSablonService Sablonlar

<PageTitle>Belge Şablonları — RentPro</PageTitle>

<div class="page-head"><h1>Belge Şablonları</h1></div>
<p class="muted small">Kira sözleşmesi / fatura / makbuz PDF'lerinde marka-özel metin bölümleri (başlık, hukuki metin,
    ek koşullar, alt bilgi). Boş bırakılan bölüm koddaki VARSAYILAN metni basar. Her belge türü için birden çok
    isimli şablon tanımlanabilir; "Varsayılan" işaretli şablon, kira formunda seçim yapılmadığında basılır.
    Firma adı/vergi/logo buradan DEĞİL, <a href="/ayarlar">Ayarlar</a>'dan gelir.<br />
    Alt bilgi ve başlıkta yer-tutucu: <code>{FirmaUnvan}</code> <code>{FirmaMarka}</code> <code>{FirmaVergiNo}</code>
    <code>{BelgeNo}</code> <code>{Tarih}</code>.</p>

@if (Ok) { <p class="ok">Kaydedildi.</p> }
@if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }

<details class="card">
    <summary class="link">＋ Yeni şablon ekle</summary>
    <form method="post" action="/belge-sablonlari/create" class="grid-form"><AntiforgeryToken />
        <label>Belge Türü
            <select name="belgeTuru">
                @foreach (var t in Turler) { <option value="@t">@Ad(t)</option> }
            </select>
        </label>
        <label>Şablon Adı<input name="ad" maxlength="128" placeholder="ör. Kurumsal" required /></label>
        <label class="chk"><input type="checkbox" name="varsayilanMi" value="true" /> Bu türde varsayılan</label>
        <label>Aktif
            <select name="aktif"><option value="true">Evet</option><option value="false">Hayır</option></select>
        </label>
        <label class="u-col-full">Belge Başlığı (boş = varsayılan)
            <input name="belgeBasligi" maxlength="256" placeholder="ör. ARAÇ TESLİM BELGESİ / RENTAL AGREEMENT" />
        </label>
        <label class="u-col-full">Hukuki Metin — Sol (yalnız kira sözleşmesi)
            <textarea name="hukukiMetinSol" rows="3" maxlength="4000"></textarea>
        </label>
        <label class="u-col-full">Hukuki Metin — Sağ (yalnız kira sözleşmesi)
            <textarea name="hukukiMetinSag" rows="3" maxlength="4000"></textarea>
        </label>
        <label class="u-col-full">Ek Koşullar Varsayılanı (kira-özel ek koşul boşsa basılır)
            <textarea name="ekKosullarVarsayilan" rows="3" maxlength="4000"></textarea>
        </label>
        <label class="u-col-full">Alt Bilgi / Footer
            <input name="altBilgi" maxlength="512" placeholder="ör. {FirmaMarka} — {BelgeNo}" />
        </label>
        @* Checkbox işaretsizken tarayıcı alanı GÖNDERMEZ → önüne gizli "false" konur (son değer kazanır). *@
        <input type="hidden" name="imzaAlaniGoster" value="false" />
        <label class="chk"><input type="checkbox" name="imzaAlaniGoster" value="true" checked /> Sözleşmede fiziksel imza alanı bassın</label>
        <button type="submit">Ekle</button>
    </form>
</details>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Belge Türü</th><th>Ad</th><th>Varsayılan</th><th>Aktif</th><th>Bölümler</th><th></th></tr></thead>
    <tbody>
        @if (_list.Count == 0) { <tr><td colspan="6" class="muted">Kayıt yok.</td></tr> }
        @foreach (var s in _list)
        {
            <tr>
                <td>@Ad(s.BelgeTuru)</td>
                <td>@s.Ad</td>
                <td>@(s.VarsayilanMi ? "Evet" : "—")</td>
                <td>@(s.Aktif ? "Evet" : "Hayır")</td>
                <td class="muted small">@Dolu(s)</td>
                <td>
                    <details><summary class="link">Düzenle</summary>
                        <form method="post" action="/belge-sablonlari/update" class="grid-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@s.Id" />
                            <label>Belge Türü
                                <select name="belgeTuru">
                                    @foreach (var t in Turler) { <option value="@t" selected="@(t == s.BelgeTuru)">@Ad(t)</option> }
                                </select>
                            </label>
                            <label>Şablon Adı<input name="ad" maxlength="128" value="@s.Ad" required /></label>
                            <label class="chk"><input type="checkbox" name="varsayilanMi" value="true" checked="@s.VarsayilanMi" /> Bu türde varsayılan</label>
                            <label>Aktif
                                <select name="aktif">
                                    <option value="true" selected="@s.Aktif">Evet</option>
                                    <option value="false" selected="@(!s.Aktif)">Hayır</option>
                                </select>
                            </label>
                            <label class="u-col-full">Belge Başlığı
                                <input name="belgeBasligi" maxlength="256" value="@s.BelgeBasligi" />
                            </label>
                            <label class="u-col-full">Hukuki Metin — Sol
                                <textarea name="hukukiMetinSol" rows="3" maxlength="4000">@s.HukukiMetinSol</textarea>
                            </label>
                            <label class="u-col-full">Hukuki Metin — Sağ
                                <textarea name="hukukiMetinSag" rows="3" maxlength="4000">@s.HukukiMetinSag</textarea>
                            </label>
                            <label class="u-col-full">Ek Koşullar Varsayılanı
                                <textarea name="ekKosullarVarsayilan" rows="3" maxlength="4000">@s.EkKosullarVarsayilan</textarea>
                            </label>
                            <label class="u-col-full">Alt Bilgi / Footer
                                <input name="altBilgi" maxlength="512" value="@s.AltBilgi" />
                            </label>
                            <input type="hidden" name="imzaAlaniGoster" value="false" />
                            <label class="chk"><input type="checkbox" name="imzaAlaniGoster" value="true" checked="@s.ImzaAlaniGoster" /> Sözleşmede fiziksel imza alanı bassın</label>
                            <button type="submit">Kaydet</button>
                        </form>
                        <form method="post" action="/belge-sablonlari/delete" style="display:inline"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@s.Id" /><button type="submit" class="link danger">Sil</button>
                        </form>
                    </details>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok_ { get; set; }
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    private bool Ok => Ok_ == "1";

    private static readonly BelgeTuru[] Turler = [BelgeTuru.KiraSozlesmesi, BelgeTuru.Fatura, BelgeTuru.Makbuz];
    private IReadOnlyList<RentACar.Domain.Entities.BelgeSablon> _list = [];

    protected override async Task OnInitializedAsync() => _list = await Sablonlar.ListAsync();

    private static string Ad(BelgeTuru t) => t switch
    {
        BelgeTuru.KiraSozlesmesi => "Kira Sözleşmesi",
        BelgeTuru.Fatura => "Fatura",
        BelgeTuru.Makbuz => "Makbuz",
        _ => t.ToString()
    };

    private static string Dolu(RentACar.Domain.Entities.BelgeSablon s)
    {
        var v = new List<string>();
        if (!string.IsNullOrWhiteSpace(s.BelgeBasligi)) v.Add("Başlık");
        if (!string.IsNullOrWhiteSpace(s.HukukiMetinSol)) v.Add("Hukuki-Sol");
        if (!string.IsNullOrWhiteSpace(s.HukukiMetinSag)) v.Add("Hukuki-Sağ");
        if (!string.IsNullOrWhiteSpace(s.EkKosullarVarsayilan)) v.Add("Ek Koşullar");
        if (!string.IsNullOrWhiteSpace(s.AltBilgi)) v.Add("Alt Bilgi");
        return v.Count == 0 ? "(hepsi varsayılan)" : string.Join(", ", v);
    }
}
