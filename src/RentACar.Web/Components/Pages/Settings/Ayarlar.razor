@page "/ayarlar"
@attribute [Authorize(Roles = "Admin,Yonetici")]
@inject TenantSettingsService Settings
@inject VehicleGroupService AracGruplari

<PageTitle>Ayarlar — RentPro</PageTitle>

<div class="page-head"><h1>Ayarlar</h1><div class="actions"></div></div>
@if (Ok == "1")
{
    <p class="ok">Ayarlar kaydedildi.</p>
}
@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<form method="post" action="/ayarlar/kaydet" class="grid-form"><AntiforgeryToken />
    <fieldset>
        <legend>Firma</legend>
        <label>Ünvan (hukuki)<input name="firmaUnvan" value="@_m.FirmaUnvan" /></label>
        <label>Marka (ticari — sözleşme sağ üst)<input name="firmaMarka" value="@_m.FirmaMarka" placeholder="ör. YÜCE RENT A CAR" /></label>
        <label>Vergi Dairesi<input name="firmaVergiDairesi" value="@_m.FirmaVergiDairesi" /></label>
        <label>Vergi No<input name="firmaVergiNo" value="@_m.FirmaVergiNo" /></label>
        <label>Adres<input name="firmaAdres" value="@_m.FirmaAdres" /></label>
        <label>Telefon (ofis)<input name="firmaTel" value="@_m.FirmaTel" /></label>
        <label>Mobil Telefon<input name="firmaMobilTel" value="@_m.FirmaMobilTel" /></label>
        <label>E-posta<input name="firmaEmail" type="email" value="@_m.FirmaEmail" /></label>
    </fieldset>

    <fieldset>
        <legend>Entegrasyon kimlikleri</legend>
        <p class="muted small">Sır alanları (şifre/anahtar) <strong>şifreli</strong> saklanır. Değiştirmek için
            doldurun; <strong>boş bırakırsanız mevcut değer korunur</strong>.</p>
        <label>e-Fatura Kullanıcı<input name="eFaturaKullanici" value="@_m.EFaturaKullanici" /></label>
        <label>e-Fatura Şifre<input name="eFaturaSifre" type="password" placeholder="@Placeholder(_m.EFaturaSifre)" /></label>
        <label>SMS Başlık<input name="smsBaslik" value="@_m.SmsBaslik" /></label>
        <label>SMS API Key<input name="smsApiKey" type="password" placeholder="@Placeholder(_m.SmsApiKey)" /></label>
        <label>POS Merchant ID<input name="posMerchantId" value="@_m.PosMerchantId" /></label>
        <label>POS API Key<input name="posApiKey" type="password" placeholder="@Placeholder(_m.PosApiKey)" /></label>
    </fieldset>

    <fieldset>
        <legend>Görünüm + Operasyon Kuralları</legend>
        <label>Logo URL<input name="logoUrl" value="@_m.LogoUrl" /></label>
        <label>Varsayılan Döviz<input name="varsayilanDoviz" maxlength="3" value="@_m.VarsayilanDoviz" placeholder="TRY" /></label>
        @* FAZ-82 DÜZELTME: ondalık prefill InvariantCulture ile basılmalı. Sayfa tr-TR kültüründe
           render ediliyordu → 0.20 değeri value="0,2000" olarak basılıyor, tarayıcı type="number"
           alanını GEÇERSİZ sayıp BOŞ gösteriyor ve formun bir sonraki kaydı tenant'ın varsayılan KDV
           oranını sessizce NULL'lıyordu (kullanıcı o alana hiç dokunmasa bile). *@
        <label>Varsayılan KDV Oranı<input name="varsayilanKdvOrani" type="number" step="0.0001" min="0" max="1" value="@Ondalik(_m.VarsayilanKdvOrani)" /></label>
        @* PR-10: grubu belirtilmeden açılan araçlar (REST API / Excel import) buraya düşer. Boş
           bırakılırsa "Ekonomi" adlı aktif grup aranır; o da yoksa araç grupsuz kalır — bilinçli
           olarak "ilk aktif grup"a düşürülmez (o grup "Lüks" olabilirdi). *@
        <label>Varsayılan Araç Grubu
            <select name="varsayilanGrupId">
                <option value="">(Ekonomi'yi ara, yoksa grupsuz)</option>
                @foreach (var g in _gruplar)
                {
                    <option value="@g.Id" selected="@(g.Id == _m.VarsayilanGrupId)">@g.Ad</option>
                }
            </select>
        </label>
        <label>Min Kira Gün<input name="minKiraGun" type="number" min="0" value="@_m.MinKiraGun" /></label>
        <label>Max Kira Gün<input name="maxKiraGun" type="number" min="0" value="@_m.MaxKiraGun" /></label>
        <label class="check"><input type="checkbox" name="rezOnayZorunlu" value="true" checked="@(_m.RezOnayZorunlu == true)" /> Rezervasyon onayı zorunlu</label>
        <label class="check"><input type="checkbox" name="donemselFaturalamaJob" value="true" checked="@_m.DonemselFaturalamaJob" /> Dönemsel faturalama job'ı (uzun/aylık kirada vadesi gelen dönemleri otomatik keser)</label>
        <label class="check"><input type="checkbox" name="donemselOtomatikTahsilat" value="true" checked="@_m.DonemselOtomatikTahsilat" /> Job kesiminde otomatik Kasa tahsilatı (yalnız gerçek oto-ödeme akışında açın — kasa gerçekliği)</label>
    </fieldset>

    <fieldset>
        <legend>Fiyatlandırma / Muhasebe Varsayılanları</legend>
        <p class="muted small">Bu bölümdeki hiçbir alan <strong>muhasebe defterine yazmaz</strong>;
            en fazla bir formun ön-seçili değerini belirler ya da bir girişi reddeder.
            Alanları boş bırakırsanız sistem bugünkü davranışını birebir korur.</p>

        @* Fiyat türü SADECE formun ön-seçili değerini değiştirir; operatör dropdown'da görür ve
           değiştirebilir. Sunucu tarafında hiçbir kayda sessizce uygulanmaz — çünkü bu etiket
           masum değil: "Otomatik" manuel ücreti yok saydırır, "Günlük"/"Toplam" faturayı NET moda
           çevirir (KDV tutarın üstüne eklenir). *@
        <label>Varsayılan Fiyat Türü
            <select name="varsayilanFiyatTuru">
                <option value="">(Seçilmemiş — bugünkü davranış)</option>
                @foreach (var o in RentACar.Application.Pricing.FiyatTuruSecenek.Hepsi)
                {
                    <option value="@o" selected="@(o == _m.VarsayilanFiyatTuru)">@o</option>
                }
            </select>
        </label>
        <label>Varsayılan Çıkış Yakıt Seviyesi (0-12)
            <input name="varsayilanYakitSeviyesi" type="number" min="0" max="12" value="@_m.VarsayilanYakitSeviyesi"
                   placeholder="@RentACar.Application.TenantSettings.FormVarsayilanCozucu.YakitVarsayilan" />
        </label>
        <label class="check"><input type="checkbox" name="kurElleGirisKilitli" value="true" checked="@_m.KurElleGirisKilitli" /> Kur elle girilemesin (daima tanımlı/TCMB kuru)</label>
        <p class="muted small">Kur kilidi açıkken tahsilat, ödeme, virman, gider, depozito, ceza, MTV,
            muayene, sigorta, araç satışı ve dış hizmet kayıtlarında <strong>elle kur girişi reddedilir</strong>.
            Kayıtların üzerindeki bilgi amaçlı kur alanları (servis ödeme kuru, araç alım kuru gibi)
            deftere girmedikleri için kilit dışındadır. <strong>Bedeli:</strong> kilit açıkken eski
            tarihli bir kaydı <em>orijinal kuruyla</em> ters çevirmek mümkün olmaz; düzeltme günün
            kuruyla yazılır ve baz parada küçük bir kalıntı bırakabilir.</p>

        <p class="muted small"><strong>Beklemede</strong> — aşağıdakiler kaydedilir ama hiçbir hesaba
            bağlı DEĞİLDİR. Bir hesaplamaya bağlanmaları tutarları değiştireceği için ayrı bir para
            fazına ve zorunlu adversarial incelemeye bırakıldı.</p>
        <label>Drop mesafesi tanımlı değilse ücret sıfır sayılsın mı (beklemede)
            <select name="dropMesafeYokIseSifir">
                <option value="" selected="@(_m.DropMesafeYokIseSifir is null)">(Yapılandırılmadı)</option>
                <option value="true" selected="@(_m.DropMesafeYokIseSifir == true)">Evet</option>
                <option value="false" selected="@(_m.DropMesafeYokIseSifir == false)">Hayır</option>
            </select>
        </label>
        <label>Geç dönüş saat farkı toleransı — dakika (beklemede)
            <input name="saatFarkiToleransDk" type="number" min="0" value="@_m.SaatFarkiToleransDk" />
        </label>
        <label>İade işlem saat sınırı (beklemede)
            <input name="iadeIslemSaatSiniri" type="number" min="0" value="@_m.IadeIslemSaatSiniri" />
        </label>
    </fieldset>

    <fieldset>
        <legend>Görünüm Renk Kodları</legend>
        <p class="muted small">Panoda ve listelerde tekrar eden durumların rengi. <strong>Varsayılan</strong>
            işaretliyken koddaki renk kullanılır ve görünüm bugünküyle birebir aynı kalır; rengi
            değiştirmek için kutunun işaretini kaldırın. Son dördü şu an yalnız TANIMLIDIR — hangi
            eşikte uygulanacakları netleşmeden bir ekrana bağlanmadı.</p>
        <div class="renk-satir">
            <label>Gecikmiş / vadesi geçmiş<input name="renkGecikenler" type="color" value="@(_m.RenkGecikenler ?? "#dc2626")" /></label>
            @* type="color" BOŞ gönderemez (dokunulmasa da bir değer yazar) → "varsayılana dön"
               seçeneği ancak açık bir kutuyla ifade edilebilir. Gizli alan, kutu işaretsizken
               de bir değer gitmesini sağlar (son değer kazanır). *@
            <input type="hidden" name="renkGecikenlerVars" value="false" />
            <label class="check"><input type="checkbox" name="renkGecikenlerVars" value="true" checked="@(_m.RenkGecikenler is null)" /> Varsayılan</label>
        </div>
        <div class="renk-satir">
            <label>Bugün dönecek araç<input name="renkBugunDonecekler" type="color" value="@(_m.RenkBugunDonecekler ?? "#0ea5e9")" /></label>
            @* type="color" BOŞ gönderemez (dokunulmasa da bir değer yazar) → "varsayılana dön"
               seçeneği ancak açık bir kutuyla ifade edilebilir. Gizli alan, kutu işaretsizken
               de bir değer gitmesini sağlar (son değer kazanır). *@
            <input type="hidden" name="renkBugunDoneceklerVars" value="false" />
            <label class="check"><input type="checkbox" name="renkBugunDoneceklerVars" value="true" checked="@(_m.RenkBugunDonecekler is null)" /> Varsayılan</label>
        </div>
        <div class="renk-satir">
            <label>Bugün çıkacak araç<input name="renkBugunCikacaklar" type="color" value="@(_m.RenkBugunCikacaklar ?? "#16a34a")" /></label>
            @* type="color" BOŞ gönderemez (dokunulmasa da bir değer yazar) → "varsayılana dön"
               seçeneği ancak açık bir kutuyla ifade edilebilir. Gizli alan, kutu işaretsizken
               de bir değer gitmesini sağlar (son değer kazanır). *@
            <input type="hidden" name="renkBugunCikacaklarVars" value="false" />
            <label class="check"><input type="checkbox" name="renkBugunCikacaklarVars" value="true" checked="@(_m.RenkBugunCikacaklar is null)" /> Varsayılan</label>
        </div>
        <div class="renk-satir">
            <label>Opsiyonlu (onaysız) rezervasyon<input name="renkOpsiyonlu" type="color" value="@(_m.RenkOpsiyonlu ?? "#f59e0b")" /></label>
            @* type="color" BOŞ gönderemez (dokunulmasa da bir değer yazar) → "varsayılana dön"
               seçeneği ancak açık bir kutuyla ifade edilebilir. Gizli alan, kutu işaretsizken
               de bir değer gitmesini sağlar (son değer kazanır). *@
            <input type="hidden" name="renkOpsiyonluVars" value="false" />
            <label class="check"><input type="checkbox" name="renkOpsiyonluVars" value="true" checked="@(_m.RenkOpsiyonlu is null)" /> Varsayılan</label>
        </div>
        <p class="muted small">Aşağıdakiler kaydedilir ama henüz bir ekranda kullanılmaz:</p>
        <div class="renk-satir">
            <label>Risk limitini aşan bakiye<input name="renkLimitBakiye" type="color" value="@(_m.RenkLimitBakiye ?? "#b91c1c")" /></label>
            @* type="color" BOŞ gönderemez (dokunulmasa da bir değer yazar) → "varsayılana dön"
               seçeneği ancak açık bir kutuyla ifade edilebilir. Gizli alan, kutu işaretsizken
               de bir değer gitmesini sağlar (son değer kazanır). *@
            <input type="hidden" name="renkLimitBakiyeVars" value="false" />
            <label class="check"><input type="checkbox" name="renkLimitBakiyeVars" value="true" checked="@(_m.RenkLimitBakiye is null)" /> Varsayılan</label>
        </div>
        <div class="renk-satir">
            <label>Alacaklı cari<input name="renkAlacakli" type="color" value="@(_m.RenkAlacakli ?? "#7c3aed")" /></label>
            @* type="color" BOŞ gönderemez (dokunulmasa da bir değer yazar) → "varsayılana dön"
               seçeneği ancak açık bir kutuyla ifade edilebilir. Gizli alan, kutu işaretsizken
               de bir değer gitmesini sağlar (son değer kazanır). *@
            <input type="hidden" name="renkAlacakliVars" value="false" />
            <label class="check"><input type="checkbox" name="renkAlacakliVars" value="true" checked="@(_m.RenkAlacakli is null)" /> Varsayılan</label>
        </div>
        <div class="renk-satir">
            <label>Plakası atanmış rezervasyon<input name="renkRezAtananPlaka" type="color" value="@(_m.RenkRezAtananPlaka ?? "#0d9488")" /></label>
            @* type="color" BOŞ gönderemez (dokunulmasa da bir değer yazar) → "varsayılana dön"
               seçeneği ancak açık bir kutuyla ifade edilebilir. Gizli alan, kutu işaretsizken
               de bir değer gitmesini sağlar (son değer kazanır). *@
            <input type="hidden" name="renkRezAtananPlakaVars" value="false" />
            <label class="check"><input type="checkbox" name="renkRezAtananPlakaVars" value="true" checked="@(_m.RenkRezAtananPlaka is null)" /> Varsayılan</label>
        </div>
        <div class="renk-satir">
            <label>Kiralanmayan / boştaki araç<input name="renkKiralanmayan" type="color" value="@(_m.RenkKiralanmayan ?? "#64748b")" /></label>
            @* type="color" BOŞ gönderemez (dokunulmasa da bir değer yazar) → "varsayılana dön"
               seçeneği ancak açık bir kutuyla ifade edilebilir. Gizli alan, kutu işaretsizken
               de bir değer gitmesini sağlar (son değer kazanır). *@
            <input type="hidden" name="renkKiralanmayanVars" value="false" />
            <label class="check"><input type="checkbox" name="renkKiralanmayanVars" value="true" checked="@(_m.RenkKiralanmayan is null)" /> Varsayılan</label>
        </div>
    </fieldset>

    <fieldset>
        <legend>SMTP (E-posta Gönderimi)</legend>
        <p class="muted small">Müşteriye giden e-postalar (rezervasyon onayı, hatırlatma, belge) bu
            sunucudan gönderilir. SMTP şifresi şifreli saklanır; boş bırakırsanız mevcut korunur.</p>
        <label>SMTP Host<input name="smtpHost" value="@_m.SmtpHost" placeholder="mail.firmaniz.com" /></label>
        <label>SMTP Port<input name="smtpPort" type="number" min="0" value="@_m.SmtpPort" placeholder="587" /></label>
        <label>SMTP Kullanıcı<input name="smtpKullanici" value="@_m.SmtpKullanici" /></label>
        <label>SMTP Şifre<input name="smtpSifre" type="password" placeholder="@Placeholder(_m.SmtpSifre)" /></label>
        <label>Gönderen Adres<input name="smtpGonderenAdres" type="email" value="@_m.SmtpGonderenAdres" placeholder="rezervasyon@@firmaniz.com" /></label>
        <label>Gönderen Ad<input name="smtpGonderenAd" value="@_m.SmtpGonderenAd" placeholder="@_m.FirmaUnvan" /></label>
        <label class="check"><input type="checkbox" name="smtpSsl" value="true" checked="@(_m.SmtpSsl == true)" /> SSL/TLS</label>
        <p class="muted small u-col-full">Port 465 örtük SSL, 587 STARTTLS olarak bağlanır — kutu yalnız
            STARTTLS'in zorunlu tutulup tutulmayacağını belirler. Gönderen adres boşsa, SMTP kullanıcı adı
            e-posta biçimindeyse o kullanılır. Alan adınızın SPF/DKIM kaydı gönderen adrese göre
            değerlendirilir; uyumsuz adres mesajları spam'e düşürür.</p>
    </fieldset>

    <fieldset>
        <legend>Fatura Numaralandırma</legend>
        <label>Fatura Seri Kodu<input name="faturaSeriKodu" value="@_m.FaturaSeriKodu" maxlength="3"
                                      pattern="[A-Z0-9]{3}" placeholder="RNT" style="text-transform:uppercase" /></label>
        <p class="muted small u-col-full">e-Fatura/e-Arşiv fatura numarası <strong>16 hanedir</strong>:
            seri (3) + yıl (4) + sıra (9) — örnek <code>RNT2026000000001</code>. Seri kodu yalnız büyük
            harf (A-Z) veya rakam olabilir; Türkçe karakter kabul edilmez. Sıra numarası her yıl 1'den
            başlar. Boş bırakılırsa <code>RNT</code> kullanılır. Kendi kodunuzu girerseniz sıra o seri için
            1'den başlar — mevzuata uygundur, çünkü her seri kendi içinde boşluksuz ilerler ve
            eski seriyle kesilmiş faturalar etkilenmez. Diğer belgeler
            (kira sözleşmesi, rezervasyon, tahsilat…) bu alandan etkilenmez.</p>
    </fieldset>

    <fieldset>
        <legend>WhatsApp Günlük Özet</legend>
        <p class="muted small">Firma sahibine her sabah (yerel 08:00 sonrası) günlük operasyon özeti gönderilir: beklenen çıkış/dönüş, açık rezervasyon, tahsilat, filo. Twilio yapılandırması yoksa gönderim yapılmaz (test modu).</p>
        <label>WhatsApp No (E.164)<input name="whatsAppNumarasi" value="@_m.WhatsAppNumarasi" placeholder="+90 5xx xxx xx xx" /></label>
        <label class="check"><input type="checkbox" name="whatsAppGunlukOzet" value="true" checked="@(_m.WhatsAppGunlukOzet == true)" /> Günlük özet gönderilsin</label>

        <p class="muted small">Yapılandırmanın gerçekten çalışıp çalışmadığını aşağıdaki
            <strong>WhatsApp Testi</strong> bölümünden tek mesajla deneyebilirsiniz.</p>

        @if (_gonderimler.Count > 0)
        {
            <p class="muted small">Son gönderimler:</p>
            <div class="table-scroll">
            <table class="grid tr-grid kart-mobil">
                <thead><tr><th>Gün</th><th>Durum</th><th>Not</th></tr></thead>
                <tbody>
                    @foreach (var g in _gonderimler)
                    {
                        <tr>
                            <td class="kart-baslik">@g.Gun.ToString("dd.MM.yyyy")</td>
                            <td data-etiket="Durum">@(g.Basarili ? "Gönderildi" : "Başarısız")</td>
                            <td class="muted small" data-etiket="Not">@(g.Basarili ? "" : g.HataMesaji)</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </fieldset>

    <button type="submit">Kaydet</button>
</form>

@* Test gönderimi ANA FORMUN DIŞINDA: iç içe <form> geçersiz HTML'dir ve tarayıcı içteki formu
   sessizce yok sayar (kaydet butonu test mesajı atardı). Logo / Sitemi Aç / Domain blokları da
   aynı sebeple dışarıda. *@
<fieldset>
    <legend>WhatsApp Testi</legend>
    <p class="muted small">Yapılandırmayı doğrulamak için <strong>tek</strong> bir mesaj gönderir —
        günlük özetin kullandığı kod yolunun aynısını kullanır. Twilio yapılandırması yoksa gönderim
        yapılmaz ve size hata döner (sessiz başarı yoktur).
        <br />WhatsApp <strong>sandbox</strong> kullanıyorsanız hedef numara önce sandbox'a katılmış
        olmalı ve son 24 saat içinde size yazmış olmalıdır; aksi halde Twilio mesajı reddeder.</p>
    <form method="post" action="/ayarlar/whatsapp-test" class="grid-form"><AntiforgeryToken />
        <label>Test numarası (E.164)
            <input name="testNo" placeholder="+905321112233" value="@_m.WhatsAppNumarasi" required />
        </label>
        <button type="submit" data-confirm="Bu numaraya gerçek bir WhatsApp mesajı gönderilecek. Devam?">
            Test Mesajı Gönder
        </button>
    </form>
</fieldset>

<fieldset>
    <legend>E-posta Testi</legend>
    <p class="muted small">Yapılandırmayı doğrulamak için <strong>tek</strong> bir e-posta gönderir —
        müşteri bildirimlerinin kullandığı kod yolunun aynısını kullanır. SMTP ayarları eksikse
        gönderim yapılmaz ve size hangi alanın eksik olduğu söylenir (sessiz başarı yoktur).</p>
    <form method="post" action="/ayarlar/smtp-test" class="grid-form"><AntiforgeryToken />
        <label>Test e-posta adresi
            <input name="testMail" type="email" placeholder="siz@@firmaniz.com" value="@_m.FirmaEmail" required />
        </label>
        <button type="submit" data-confirm="Bu adrese gerçek bir e-posta gönderilecek. Devam?">
            Test E-postası Gönder
        </button>
    </form>
</fieldset>

<fieldset>
    <legend>SMS Testi</legend>
    <p class="muted small">Yapılandırmayı doğrulamak için <strong>tek</strong> bir SMS gönderir ve
        teslim durumunu Twilio'dan okur — "iletildi" ile "teslim edildi" ayrı şeylerdir.
        SMS, WhatsApp ile <strong>aynı Twilio hesabını</strong> kullanır; ayrıca
        <code>Twilio:SmsFrom</code> (numara) ya da <code>Twilio:MessagingServiceSid</code> gerekir.
        Yukarıdaki <strong>SMS Başlığı</strong> doluysa gönderen olarak o kullanılır — alfanümerik
        başlık Türkiye'de operatör kaydı ister, kayıtsız başlıkla mesaj teslim edilmez.</p>
    <form method="post" action="/ayarlar/sms-test" class="grid-form"><AntiforgeryToken />
        <label>Test numarası (E.164)
            <input name="testSmsNo" placeholder="+905321112233" value="@_m.WhatsAppNumarasi" required />
        </label>
        <button type="submit" data-confirm="Bu numaraya gerçek bir SMS gönderilecek (ücretlendirilir). Devam?">
            Test SMS'i Gönder
        </button>
    </form>
</fieldset>

<fieldset>
    <legend>PDF Logo (sözleşme / fatura / makbuz başlığı)</legend>
    @if (_m.LogoBytes is { Length: > 0 } logo)
    {
        @* PR-A: BASKI BOYUTUNDA önizleme — PDF'te logo 38 pt yüksekliğe sığdırılıyor. Ekranda aynı
           yükseklikte göstermek bulanıklığı PDF üretmeden, müşteriye gitmeden görünür kılar. *@
        <p class="muted small">Sözleşme/fatura başlığında görünen boyut:</p>
        <div style="border:1px solid var(--tr-line);padding:.5rem;display:inline-block;background:#fff">
            <img src="data:image/png;base64,@Convert.ToBase64String(logo)" alt="Logo önizleme" style="height:38px;width:auto" />
        </div>
        @* Renk kodu: basılamıyorsa error, basılıyor ama uyarı varsa nötr, temizse ok.
           Uyarıyı yeşil basmak "her şey yolunda" mesajı verirdi. *@
        <p class="@(_logo is null ? "muted" : !_logo.BaskiyaUygun ? "error" : _logo.Uyari is not null ? "muted" : "ok")">
            @if (_logo is { } d)
            {
                <text>@(d.Genislik is { } g && d.Yukseklik is { } y ? $"{g}×{y} px · " : "")@(d.Bayt / 1024) KB</text>
                @if (d.Uyari is { } u)
                {
                    <text> — </text><span class="badge warn">@u</span>
                }
                else { <text> — PDF başlığında görünüyor.</text> }
            }
        </p>
    }
    else
    {
        <p class="muted">Logo yüklü değil — PDF başlıklarında firma adı basılıyor.</p>
    }
    <form method="post" action="/ayarlar/logo" enctype="multipart/form-data" class="grid-form"><AntiforgeryToken />
        <label>Logo dosyası (PNG, ≤1 MB)<input name="logo" type="file" accept="image/png" required /></label>
        <button type="submit">Logoyu Yükle</button>
    </form>
    <p class="muted small">Yalnız <strong>PNG</strong> (şeffaf zemin gerekiyor). En az
        <strong>@LogoKurallari.OnerilenGenislik px</strong> genişlik önerilir;
        <strong>@LogoKurallari.YokSayilanGenislik px altı yok sayılır</strong> ve yerine firma adı basılır.</p>
    <form method="post" action="/ayarlar/logo-sil"><AntiforgeryToken />
        <button type="submit" class="btn-secondary">Logoyu Kaldır</button>
    </form>
</fieldset>

<fieldset>
    <legend>Halka Açık Site</legend>
    @if (_m.PublicSiteEnabled)
    {
        <p class="ok">Site açık — <a href="https://@_m.PublicSiteHost" target="_blank">@_m.PublicSiteHost</a></p>
    }
    else
    {
        <p class="muted">Site henüz açık değil. Açtığınızda araç filonuz + iletişim bilgileriniz
            <code>{firma-kodu}.rentpro.com</code> adresinde yayına alınır — ekstra kurulum/deploy gerekmez.
            Siteniz en geç 1 dakika içinde yayında olur (kısa bir önbellek gecikmesi nedeniyle).</p>
        <form method="post" action="/ayarlar/site-ac"><AntiforgeryToken />
            <button type="submit">Sitemi Aç</button>
        </form>
    }

    @if (_m.CustomDomains.Count > 0)
    {
        <div class="table-scroll">
        <table class="grid tr-grid kart-mobil">
            <thead><tr><th>Host</th><th>Tür</th><th>Durum</th></tr></thead>
            <tbody>
                @foreach (var d in _m.CustomDomains)
                {
                    <tr>
                        <td class="mono kart-baslik">@d.Host</td>
                        <td data-etiket="Tür">@(d.Kind == "Custom" ? "Özel Domain" : "Alt Domain")</td>
                        <td data-etiket="Durum">@d.Durum</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }

    <details class="ozel-domain-ekle">
        <summary class="link">+ Özel Alan Adı Ekle</summary>
        <p class="muted small">Kendi alan adınızı (ör. <code>kirala.firmaniz.com</code>) sitenize bağlayabilirsiniz.
            Eklemeden önce DNS'te bu alan adının A kaydını sunucumuzun IP adresine yönlendirin — doğrulama
            otomatiktir, ilk ziyaretle birlikte tamamlanır (ayrı bir kod/TXT kaydı girmenize gerek yoktur).</p>
        <form method="post" action="/ayarlar/domain-ekle" class="grid-form"><AntiforgeryToken />
            <label>Alan Adı<input name="host" required placeholder="kirala.firmaniz.com" /></label>
            <button type="submit">Ekle</button>
        </form>
    </details>
</fieldset>

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private TenantSettingsModel _m = new();
    private IReadOnlyList<RentACar.Domain.Entities.VehicleGroup> _gruplar = []; // PR-10 varsayılan grup seçimi
    private LogoDegerlendirme? _logo; // PR-A
    private IReadOnlyList<RentACar.Domain.Entities.WhatsAppGonderim> _gonderimler = [];

    private static string Placeholder(string? secret) => string.IsNullOrEmpty(secret) ? "(boş)" : "•••••• (kayıtlı)";

    /// <summary>FAZ-82: type="number" prefill'i DAİMA InvariantCulture. Sayfa tr-TR kültüründe render
    /// ediliyor; "0,2000" tarayıcıda geçersiz sayı → alan boş görünür → dokunulmayan alan bir sonraki
    /// kayıtta NULL'lanır. Tek kaydın tüm tenant ayarını sıfırlayabildiği bu formda kritik.</summary>
    private static string Ondalik(decimal? d)
        => d?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";

    protected override async Task OnInitializedAsync()
    {
        _m = await Settings.GetAsync();
        // PR-A: yüklü logonun baskıya uygunluğu (aynı kural platform panelinde de kullanılıyor).
        _logo = _m.LogoBytes is { Length: > 0 } b ? LogoKurallari.Degerlendir(b) : null;
        _gruplar = await AracGruplari.ListActiveAsync();
        _gonderimler = await Settings.ListWhatsAppGonderimAsync();
    }
}
