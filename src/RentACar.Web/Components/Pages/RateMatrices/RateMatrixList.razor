@page "/tarife-matris"
@attribute [Authorize(Roles = "Admin,Yonetici,Operator")]
@inject RateMatrixService TarifeMatris
@inject BranchService Subeler
@inject LocationService Locations

<PageTitle>Tarife Matrisi — RentPro</PageTitle>

<h1>Tarife Matrisi (XML Tarife)</h1>
<p class="muted small">Asıl günlük kira fiyat listesi: kanal (rez kaynağı) + şube + lokasyon + araç grubu
    bazında, geçerlilik tarihli, onay iş akışlı, gün-kademesi (1..7) başına günlük fiyat + dinamik indirim
    oranı. Fiyat motorunun birincil girdisidir. Saf fiyat-tanım — deftere kayıt postlamaz.</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle">
    <summary>Fiyat Sorgula (çözümleme)</summary>
    <p class="muted small">Verilen kanal/şube/araç grubu/tarih/gün sayısı için matristen en spesifik onaylı
        tarifenin günlük+toplam fiyatını çözer (en dar geçerlilik penceresi → en yeni → kod ile deterministik).</p>
    <form method="get" class="grid-form">
        <label>Kanal<input name="qkanal" value="@QKanal" placeholder="WEB" /></label>
        <ComboBox Name="qsube" Label="Şube" Value="@QSube" Options="_subeOpts" />
        <label>Araç Grubu Kodu<input name="qgrup" value="@QGrup" placeholder="EKO" /></label>
        <label>Para Birimi<input name="qpara" value="@QPara" placeholder="(varsayılan)" maxlength="8" /></label>
        <label>Tarih<input name="qtarih" type="date" value="@QTarih" required /></label>
        <label>Gün Sayısı<input name="qgun" type="number" min="1" value="@(QGun > 0 ? QGun : 1)" required /></label>
        <button type="submit">Sorgula</button>
    </form>
    @if (_sorgulandi)
    {
        @if (_sonuc is null)
        {
            <p class="muted">Eşleşen onaylı tarife bulunamadı.</p>
        }
        else
        {
            <p class="ok">
                <strong>@_sonuc.Kod</strong> (@_sonuc.Ad) → günlük <strong>@_sonuc.GunlukFiyat.ToString("N2") @_sonuc.ParaBirimi</strong>,
                @QGun gün toplam <strong>@_sonuc.ToplamFiyat.ToString("N2") @_sonuc.ParaBirimi</strong>.
            </p>
        }
    }
</details>

<details class="new-vehicle" open="@(_list.Count == 0)">
    <summary>+ Yeni Tarife Satırı</summary>
    <form method="post" action="/tarife-matris/create" class="grid-form"><AntiforgeryToken />
        <label>Kod<input name="kod" required placeholder="WEB-EKO-2026" /></label>
        <label>Ad<input name="ad" required placeholder="Web Ekonomik 2026" /></label>
        <label>Açıklama<input name="aciklama" /></label>
        <label>Kanal<input name="kanal" placeholder="WEB/ACENTA/ÇAĞRI" /></label>
        <ComboBox Name="sube" Label="Şube" Options="_subeOpts" />
        <label>Lokasyon (birden çok)
            <CokluSecim Name="lokasyon" Secenekler="_lokasyonOpts" Placeholder="ek lokasyon" />
        </label>
        <label>Kayıt Türü
            <select name="turu"><option value="">—</option><option>Fiyat</option><option>Kampanya</option></select>
        </label>
        <label>Max Kira Kapsamı (gün)<input name="kiraSuresi" type="number" min="1" placeholder="boş = sınırsız" title="Süresi bunu AŞAN kiralarda bu satır adaylıktan elenir" /></label>
        <label>Araç Grubu Kodu<input name="aracGrupKod" placeholder="EKO" /></label>
        <label>Para Birimi<input name="paraBirimi" placeholder="TRY" maxlength="8" /></label>
        <label>Başlangıç<input name="basTar" type="date" /></label>
        <label>Bitiş<input name="bitTar" type="date" /></label>
        <label>Gün 1 Fiyat<input name="gun1" type="number" step="0.01" min="0" /></label>
        <label>Gün 2 Fiyat<input name="gun2" type="number" step="0.01" min="0" /></label>
        <label>Gün 3 Fiyat<input name="gun3" type="number" step="0.01" min="0" /></label>
        <label>Gün 4 Fiyat<input name="gun4" type="number" step="0.01" min="0" /></label>
        <label>Gün 5 Fiyat<input name="gun5" type="number" step="0.01" min="0" /></label>
        <label>Gün 6 Fiyat<input name="gun6" type="number" step="0.01" min="0" /></label>
        <label>Gün 7 Fiyat<input name="gun7" type="number" step="0.01" min="0" /></label>
        <label>Haftalık (8-29g)<input name="gunHaftalik" type="number" step="0.01" min="0" /></label>
        <label>Aylık (30+g)<input name="gunAylik" type="number" step="0.01" min="0" /></label>
        @* FAZ-71 — kademe bazlı KM. Limit GÜNLÜKTÜR: 200 girilirse 5 günlük kirada 1000 km dahil.
           Boş bırakılan kademe, aracın grubundaki global limite düşer (geriye uyum). *@
        <div class="u-col-full"><p class="muted small" style="margin:.4rem 0 0;">
            <strong>KM limitleri GÜNLÜKTÜR</strong> (200 → 5 günlük kirada 1000 km dahil). Boş
            bırakılan kademe araç grubundaki genel limite düşer. Bu değerler <strong>yalnız
            ön-izleme tahminini</strong> besler; faturaya giren KM aşımı dönüşte hesaplanır.</p></div>
        <label>Km 1 (gün/km)<input name="km1" type="number" min="1" step="1" /></label>
        <label>Km 1 Aşım ₺<input name="km1Ucret" type="number" step="0.01" min="0" /></label>
        <label>Km 2 (gün/km)<input name="km2" type="number" min="1" step="1" /></label>
        <label>Km 2 Aşım ₺<input name="km2Ucret" type="number" step="0.01" min="0" /></label>
        <label>Km 3 (gün/km)<input name="km3" type="number" min="1" step="1" /></label>
        <label>Km 3 Aşım ₺<input name="km3Ucret" type="number" step="0.01" min="0" /></label>
        <label>Km 4 (gün/km)<input name="km4" type="number" min="1" step="1" /></label>
        <label>Km 4 Aşım ₺<input name="km4Ucret" type="number" step="0.01" min="0" /></label>
        <label>Km 5 (gün/km)<input name="km5" type="number" min="1" step="1" /></label>
        <label>Km 5 Aşım ₺<input name="km5Ucret" type="number" step="0.01" min="0" /></label>
        <label>Km 6 (gün/km)<input name="km6" type="number" min="1" step="1" /></label>
        <label>Km 6 Aşım ₺<input name="km6Ucret" type="number" step="0.01" min="0" /></label>
        <label>Km Haftalık (8-29g)<input name="kmHaftalik" type="number" min="1" step="1" /></label>
        <label>Km Haftalık Aşım ₺<input name="kmHaftalikUcret" type="number" step="0.01" min="0" /></label>
        <label>Km Aylık (30+g)<input name="kmAylik" type="number" min="1" step="1" /></label>
        <label>Km Aylık Aşım ₺<input name="kmAylikUcret" type="number" step="0.01" min="0" /></label>
        <label>Esneklik %<input name="maxEsneklik" type="number" step="0.01" min="0" max="100" /></label>
        <label>Onay Durumu
            <select name="onayDurumu">
                @foreach (var o in Enum.GetValues<TarifeOnayDurumu>())
                {
                    <option value="@o">@o</option>
                }
            </select>
        </label>
        <button type="submit">Oluştur</button>
    </form>
</details>

<div class="table-scroll">
<table class="grid">
    <thead><tr><th>Kod</th><th>Ad</th><th>Kanal</th><th>Grup</th><th>Gün1</th><th>Onay</th><th>Durum</th><th>İşlem</th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="8" class="muted">Tarife matrisi tanımlı değil.</td></tr>
        }
        @foreach (var r in _list)
        {
            <tr>
                <td class="mono">@r.Kod</td>
                <td>@r.Ad</td>
                <td>@r.Kanal</td>
                <td class="mono">@r.AracGrupKod</td>
                <td class="num">@(r.Gun1?.ToString("N2") ?? "—")</td>
                <td>@r.OnayDurumu</td>
                <td>@(r.Aktif ? "Aktif" : "Pasif")</td>
                <td>
                    <details>
                        <summary class="link">Düzenle</summary>
                        <form method="post" action="/tarife-matris/update" class="grid-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@r.Id" />
                            <label>Kod<input name="kod" value="@r.Kod" required /></label>
                            <label>Ad<input name="ad" value="@r.Ad" required /></label>
                            <label>Açıklama<input name="aciklama" value="@r.Aciklama" /></label>
                            <label>Kanal<input name="kanal" value="@r.Kanal" /></label>
                            <ComboBox Name="sube" Label="Şube" Value="@r.Sube" Options="_subeOpts" ListId="dl-sube-edit" />
                            <label>Lokasyon (birden çok)
                                <CokluSecim Name="lokasyon" Secenekler="_lokasyonOpts" Deger="@r.Lokasyon" />
                            </label>
                            <label>Kayıt Türü
                                <select name="turu">
                                    <option value="">—</option>
                                    <option selected="@(r.Turu == "Fiyat")">Fiyat</option>
                                    <option selected="@(r.Turu == "Kampanya")">Kampanya</option>
                                </select>
                            </label>
                            <label>Max Kira Kapsamı (gün)<input name="kiraSuresi" type="number" min="1" value="@r.KiraSuresi" placeholder="boş = sınırsız" /></label>
                            <label>Araç Grubu Kodu<input name="aracGrupKod" value="@r.AracGrupKod" /></label>
                            <label>Para Birimi<input name="paraBirimi" value="@r.ParaBirimi" maxlength="8" /></label>
                            <label>Başlangıç<input name="basTar" type="date" value="@r.BasTar?.ToString("yyyy-MM-dd")" /></label>
                            <label>Bitiş<input name="bitTar" type="date" value="@r.BitTar?.ToString("yyyy-MM-dd")" /></label>
                            <label>Gün 1<input name="gun1" type="number" step="0.01" min="0" value="@r.Gun1" /></label>
                            <label>Gün 2<input name="gun2" type="number" step="0.01" min="0" value="@r.Gun2" /></label>
                            <label>Gün 3<input name="gun3" type="number" step="0.01" min="0" value="@r.Gun3" /></label>
                            <label>Gün 4<input name="gun4" type="number" step="0.01" min="0" value="@r.Gun4" /></label>
                            <label>Gün 5<input name="gun5" type="number" step="0.01" min="0" value="@r.Gun5" /></label>
                            <label>Gün 6<input name="gun6" type="number" step="0.01" min="0" value="@r.Gun6" /></label>
                            <label>Gün 7<input name="gun7" type="number" step="0.01" min="0" value="@r.Gun7" /></label>
                            <label>Haftalık (8-29g)<input name="gunHaftalik" type="number" step="0.01" min="0" value="@r.GunHaftalik" /></label>
                            <label>Aylık (30+g)<input name="gunAylik" type="number" step="0.01" min="0" value="@r.GunAylik" /></label>
                            @* Ondalık değerler INVARIANT basılır: tr-TR virgülü type=number alanını
                               boşaltıp kaydetmede değeri siler (bilinen tuzak). *@
                            <label>Km 1<input name="km1" type="number" min="1" step="1" value="@r.Km1" /></label>
                            <label>Km 1 Aşım<input name="km1Ucret" type="number" step="0.01" min="0" value="@Inv(r.Km1Ucret)" /></label>
                            <label>Km 2<input name="km2" type="number" min="1" step="1" value="@r.Km2" /></label>
                            <label>Km 2 Aşım<input name="km2Ucret" type="number" step="0.01" min="0" value="@Inv(r.Km2Ucret)" /></label>
                            <label>Km 3<input name="km3" type="number" min="1" step="1" value="@r.Km3" /></label>
                            <label>Km 3 Aşım<input name="km3Ucret" type="number" step="0.01" min="0" value="@Inv(r.Km3Ucret)" /></label>
                            <label>Km 4<input name="km4" type="number" min="1" step="1" value="@r.Km4" /></label>
                            <label>Km 4 Aşım<input name="km4Ucret" type="number" step="0.01" min="0" value="@Inv(r.Km4Ucret)" /></label>
                            <label>Km 5<input name="km5" type="number" min="1" step="1" value="@r.Km5" /></label>
                            <label>Km 5 Aşım<input name="km5Ucret" type="number" step="0.01" min="0" value="@Inv(r.Km5Ucret)" /></label>
                            <label>Km 6<input name="km6" type="number" min="1" step="1" value="@r.Km6" /></label>
                            <label>Km 6 Aşım<input name="km6Ucret" type="number" step="0.01" min="0" value="@Inv(r.Km6Ucret)" /></label>
                            <label>Km Haftalık<input name="kmHaftalik" type="number" min="1" step="1" value="@r.KmHaftalik" /></label>
                            <label>Km Haft. Aşım<input name="kmHaftalikUcret" type="number" step="0.01" min="0" value="@Inv(r.KmHaftalikUcret)" /></label>
                            <label>Km Aylık<input name="kmAylik" type="number" min="1" step="1" value="@r.KmAylik" /></label>
                            <label>Km Aylık Aşım<input name="kmAylikUcret" type="number" step="0.01" min="0" value="@Inv(r.KmAylikUcret)" /></label>
                            <label>Esneklik %<input name="maxEsneklik" type="number" step="0.01" min="0" max="100" value="@r.MaxEsneklik" /></label>
                            <label>Onay Durumu
                                <select name="onayDurumu">
                                    @foreach (var o in Enum.GetValues<TarifeOnayDurumu>())
                                    {
                                        <option value="@o" selected="@(r.OnayDurumu == o)">@o</option>
                                    }
                                </select>
                            </label>
                            <label>Onaylayan<input name="onaylayan" value="@r.Onaylayan" /></label>
                            <label>Onay Zamanı<input name="onayZaman" type="date" value="@r.OnayZaman?.ToString("yyyy-MM-dd")" /></label>
                            <label>Durum
                                <select name="aktif">
                                    <option value="true" selected="@r.Aktif">Aktif</option>
                                    <option value="false" selected="@(!r.Aktif)">Pasif</option>
                                </select>
                            </label>
                            <button type="submit">Kaydet</button>
                        </form>
                    </details>
                    <form method="post" action="/tarife-matris/delete" data-confirm="Tarife satırı silinsin mi?"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@r.Id" />
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    /// <summary>type=number değeri INVARIANT — tr-TR "12,5000" tarayıcıda alanı boşaltır ve
    /// kaydetmede değer sessizce silinir (bilinen tuzak).</summary>
    private static string? Inv(decimal? v) => v?.ToString(System.Globalization.CultureInfo.InvariantCulture);

    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "qkanal")] public string? QKanal { get; set; }
    [SupplyParameterFromQuery(Name = "qsube")] public string? QSube { get; set; }
    [SupplyParameterFromQuery(Name = "qgrup")] public string? QGrup { get; set; }
    [SupplyParameterFromQuery(Name = "qpara")] public string? QPara { get; set; }
    [SupplyParameterFromQuery(Name = "qtarih")] public string? QTarih { get; set; }
    [SupplyParameterFromQuery(Name = "qgun")] public int QGun { get; set; }

    private IReadOnlyList<RateMatrix> _list = [];
    private bool _sorgulandi;
    private RateMatrisSonuc? _sonuc;
    private List<string> _subeOpts = [];
    private List<string> _lokasyonOpts = [];

    protected override async Task OnInitializedAsync()
    {
        _list = await TarifeMatris.ListAsync();
        _subeOpts = (await Subeler.ListActiveAsync()).Select(s => s.Ad).ToList();
        _lokasyonOpts = (await Locations.ListActiveAsync()).Select(l => l.Ad).ToList();

        // Fiyat sorgusu: tarih + gün verildiyse çöz.
        if (!string.IsNullOrWhiteSpace(QTarih) && QGun >= 1
            && DateTimeOffset.TryParse(QTarih, out var tarih))
        {
            _sorgulandi = true;
            _sonuc = await TarifeMatris.CozumleAsync(new RateMatrisSorgu(
                Kanal: string.IsNullOrWhiteSpace(QKanal) ? null : QKanal,
                Sube: string.IsNullOrWhiteSpace(QSube) ? null : QSube,
                AracGrupKod: string.IsNullOrWhiteSpace(QGrup) ? null : QGrup,
                Tarih: tarih, GunSayisi: QGun,
                ParaBirimi: string.IsNullOrWhiteSpace(QPara) ? null : QPara));
        }
    }
}
