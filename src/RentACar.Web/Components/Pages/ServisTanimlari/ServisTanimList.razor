@page "/servis-tanimlari"
@attribute [Authorize(Roles = "Admin,Yonetici,Operator,Muhasebe")]
@using RentACar.Application.ServisTanimlari
@inject ServiceDefinitionService Tanimlar

<PageTitle>Servis Tanımları — RentPro</PageTitle>

<div class="page-head"><h1>Periyodik Bakım Tanım Tablosu</h1><div class="actions"></div></div>
<p class="muted small">Araç tipi → periyodik bakım KM aralığı (periyodik servis raporunun zemini).
    Tanım ayrıca <strong>Marka / Tip / Yakıt / Vites</strong> kombinasyonuna bağlanabilir; aşağıdaki
    öneri listesi filoda olup tanımı olmayan kombinasyonları gösterir.</p>
@if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }

<form method="post" action="/servis-tanimlari/create" class="grid-form"><AntiforgeryToken />
    <label>Kod<input name="kod" required placeholder="EKO-PER" /></label>
    <label>Araç Tipi<input name="aracTipi" required placeholder="Ekonomik" /></label>
    <label>Bakım KM<input name="bakimKm" type="number" min="0" required placeholder="15000" /></label>
    <label>Açıklama<input name="aciklama" /></label>
    <label>Marka<input name="marka" maxlength="100" /></label>
    <label>Tip<input name="tip" maxlength="100" /></label>
    <label>Yakıt<input name="yakit" maxlength="32" /></label>
    <label>Vites<input name="vites" maxlength="32" /></label>
    <button type="submit">Ekle</button>
</form>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Kod</th><th>Araç Tipi</th><th>Marka</th><th>Tip</th><th>Yakıt</th><th>Vites</th>
        <th class="num">Bakım KM</th><th>Açıklama</th><th>Aktif</th><th></th></tr></thead>
    <tbody>
        @if (_list.Count == 0) { <tr><td colspan="10" class="muted">Kayıt yok.</td></tr> }
        @foreach (var s in _list)
        {
            <tr>
                <td>@s.Kod</td><td>@s.AracTipi</td>
                <td>@(s.Marka ?? "—")</td><td>@(s.Tip ?? "—")</td>
                <td>@(s.Yakit ?? "—")</td><td>@(s.Vites ?? "—")</td>
                <td class="num">
                    @* KM satır içinde düzenlenebilir; diğer alanlar aynı formda hidden gider ki
                       kaydetmek onları SIFIRLAMASIN (Normalize kopya-kurucu değil dersi). *@
                    <form method="post" action="/servis-tanimlari/update" class="inline-form"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@s.Id" />
                        <input type="hidden" name="kod" value="@s.Kod" />
                        <input type="hidden" name="aracTipi" value="@s.AracTipi" />
                        <input type="hidden" name="aciklama" value="@s.Aciklama" />
                        <input type="hidden" name="marka" value="@s.Marka" />
                        <input type="hidden" name="tip" value="@s.Tip" />
                        <input type="hidden" name="yakit" value="@s.Yakit" />
                        <input type="hidden" name="vites" value="@s.Vites" />
                        <input type="hidden" name="aktif" value="@(s.Aktif ? "true" : "false")" />
                        <input name="bakimKm" type="number" min="0" value="@s.BakimKm" />
                        <button type="submit">Kaydet</button>
                    </form>
                </td>
                <td>@s.Aciklama</td><td>@(s.Aktif ? "Evet" : "Hayır")</td>
                <td><form method="post" action="/servis-tanimlari/delete" class="inline"
                          data-confirm="'@s.Kod' servis tanımı KALICI olarak silinsin mi? Geri alınamaz; bu tanımın bakım-km aralığı periyodik bakım takibinde ve Bakım-Km bildiriminde artık kullanılmaz."><AntiforgeryToken /><input type="hidden" name="id" value="@s.Id" /><button type="submit" class="btn-secondary">Sil</button></form></td>
            </tr>
        }
    </tbody>
</table>
</div>

<h2 class="dash-h2">Filodan Öneriler</h2>
@* ÖNERİ HİÇBİR ŞEY YAZMAZ: filoda olup tanımı olmayan kombinasyonlar listelenir, kabul ayrı bir
   POST'tur. Kod ve KM düzenlenebilir — kullanıcı ne gördüyse o kaydedilir. *@
<p class="muted small">Kiralanabilir filodaki (satılmış/pasif hariç) <strong>Marka · Tip · Yakıt · Vites</strong>
    kombinasyonlarından, kombinasyona bağlı bir tanımı OLMAYANLAR. Öneri kaydetmez; "Ekle" ile kabul edilir.
    Kombinasyonu boş olan eski tanımlar hiçbir kombinasyonu kapsamış sayılmaz.</p>

<div class="table-scroll">
<table class="grid tr-grid">
    @* "Bakım KM" başlığı BİLEREK num DEĞİL: altındaki alan colspan=3'lük SOLA yaslı satır içi formun
       içinde; başlık sağa yaslanınca alanla hizası kopuyordu (adversarial bulgu). *@
    <thead><tr><th>Kombinasyon</th><th class="num">Araç</th><th>Kod</th><th>Bakım KM</th><th></th></tr></thead>
    <tbody>
        @if (_suggestion.Count == 0)
        {
            <tr><td colspan="5" class="muted">Filodaki tüm kombinasyonların tanımı var.</td></tr>
        }
        @foreach (var o in _suggestion)
        {
            <tr>
                <td>@o.Kombinasyon.Etiket</td>
                <td class="num">@o.Kombinasyon.AracSayisi</td>
                <td colspan="3">
                    <form method="post" action="/servis-tanimlari/oneri-kabul" class="inline-form"><AntiforgeryToken />
                        <input type="hidden" name="marka" value="@o.Kombinasyon.Marka" />
                        <input type="hidden" name="tip" value="@o.Kombinasyon.Tip" />
                        <input type="hidden" name="yakit" value="@o.Kombinasyon.Yakit" />
                        <input type="hidden" name="vites" value="@o.Kombinasyon.Vites" />
                        <input name="kod" value="@o.OnerilenKod" required maxlength="32" />
                        <input type="hidden" name="aracTipi" value="@o.Kombinasyon.Etiket" />
                        <input name="bakimKm" type="number" min="0" value="15000" required />
                        <button type="submit">Ekle</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    private IReadOnlyList<ServisTanim> _list = [];
    private IReadOnlyList<ServisTanimOneri> _suggestion = [];

    protected override async Task OnInitializedAsync()
    {
        _list = await Tanimlar.ListAsync();
        _suggestion = await Tanimlar.SuggestionAsync();
    }
}
