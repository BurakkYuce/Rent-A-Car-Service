@page "/kiralar/{Id:guid}/yazdir"
@attribute [Authorize]
@inject NavigationManager Nav

@* Eski HTML print emekliye ayrıldı — kira sözleşmesi çıktısı TEK KAYNAK: QuestPDF (/pdf, birebir parite düzen).
   Eski /yazdir bağlantıları/yer imleri bozulmasın diye otomatik olarak PDF'e yönlendirilir. *@
<PageTitle>Sözleşme PDF'ine yönlendiriliyor…</PageTitle>
<p>Sözleşme PDF'i açılıyor… <a href="/kiralar/@Id/pdf">Açılmadıysa buraya tıklayın</a>.</p>

@code {
    [Parameter] public Guid Id { get; set; }

    protected override void OnInitialized()
        => Nav.NavigateTo($"/kiralar/{Id}/pdf", forceLoad: true);
}
