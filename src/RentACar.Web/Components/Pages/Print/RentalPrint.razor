@page "/kiralar/{Id:guid}/yazdir"
@layout PrintLayout
@attribute [Authorize]
@inject SozlesmeService Sozlesme

<PageTitle>Kira Sözleşmesi @(_s?.SozlesmeNo)</PageTitle>

<p class="no-print"><a href="/kiralar/@Id/pdf">PDF indir</a></p>

@if (_s is null)
{
    <p class="error">Kira sözleşmesi bulunamadı.</p>
}
else
{
    <div class="print-actions no-print">
        <button onclick="window.print()">Yazdır</button>
        <a href="/kiralar">← Kiralar</a>
    </div>

    <div class="print-doc">
        <header class="print-head">
            <div>
                <h1>ARAÇ TESLİM BELGESİ / RENTAL AGREEMENT</h1>
                <p class="firma">
                    <strong>@(_s.FirmaUnvan ?? "")</strong>
                    @if (_s.FirmaTel is not null) { <span> · Tel: @_s.FirmaTel</span> }
                    @if (_s.FirmaAdres is not null) { <br /> @_s.FirmaAdres }
                    @if (_s.FirmaVergiDairesi is not null || _s.FirmaVergiNo is not null)
                    { <br /><span>@_s.FirmaVergiDairesi VD. @_s.FirmaVergiNo</span> }
                </p>
            </div>
            <div class="doc-no">No: <strong>@_s.SozlesmeNo</strong></div>
        </header>

        <section class="print-cols">
            <div>
                <h3>Müşteri / Sürücü</h3>
                <p><strong>@_s.MusteriAd</strong></p>
                @if (_s.TcKimlik is not null) { <p>T.C. Kimlik / Pasaport: @_s.TcKimlik</p> }
                @if (_s.EhliyetNo is not null)
                {
                    <p>Ehliyet No: @_s.EhliyetNo @(_s.EhliyetSinifi is null ? "" : $"({_s.EhliyetSinifi})")
                       @(_s.EhliyetYeri is null ? "" : $"— {_s.EhliyetYeri}")
                       @(_s.EhliyetTarihi is null ? "" : $"· {_s.EhliyetTarihi:dd.MM.yyyy}")</p>
                }
                @if (_s.DogumTarihi is not null) { <p>Doğum Tarihi: @_s.DogumTarihi?.ToString("dd.MM.yyyy")</p> }
                <p>@_s.MusteriTel</p>
                <p>@_s.MusteriAdres</p>
                @if (_s.IkinciSurucuAd is not null)
                {
                    <p class="ikinci-surucu"><strong>2. Sürücü:</strong> @_s.IkinciSurucuAd
                    @if (_s.IkinciTcKimlik is not null) { <br /><span>TC: @_s.IkinciTcKimlik</span> }
                    @if (_s.IkinciEhliyetNo is not null)
                    { <br /><span>Ehliyet: @_s.IkinciEhliyetNo @(_s.IkinciEhliyetSinifi is null ? "" : $"({_s.IkinciEhliyetSinifi})") @(_s.IkinciEhliyetYeri is null ? "" : $"— {_s.IkinciEhliyetYeri}") @(_s.IkinciEhliyetTarihi is null ? "" : $"· {_s.IkinciEhliyetTarihi:dd.MM.yyyy}")</span> }
                    @if (_s.IkinciDogumTarihi is not null) { <br /><span>Doğum: @_s.IkinciDogumTarihi?.ToString("dd.MM.yyyy")</span> }
                    </p>
                }
            </div>
            <div>
                <h3>Araç</h3>
                <p><strong>@_s.Plaka</strong> @_s.Marka @_s.Tip @(_s.ModelYili is null ? "" : $"({_s.ModelYili})")</p>
                <p>Grup: @(_s.Grup ?? "—") · Yakıt: @_s.Yakit</p>
                <p>Kiralandığı Yer: @(_s.CikisOfisi ?? "—") @(_s.DonusOfisi is null ? "" : $"→ {_s.DonusOfisi}")</p>
            </div>
        </section>

        <table class="print-table">
            <tbody>
                <tr><th>Başlangıç</th><td>@_s.BasTar.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <th>Bitiş</th><td>@_s.BitTar.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td></tr>
                <tr><th>Gün</th><td>@_s.Gun</td><th>Günlük Ücret</th><td>@_s.GunlukUcret.ToString("N2") @Pb</td></tr>
                <tr><th>Çıkış KM / Yakıt</th><td>@(_s.CikisKm?.ToString() ?? "—") / @(_s.CikisYakit?.ToString() ?? "—")</td>
                    <th>Dönüş KM / Yakıt</th><td>@(_s.DonusKm?.ToString() ?? "—") / @(_s.DonusYakit?.ToString() ?? "—")</td></tr>
                <tr><th>Kullanılan KM</th><td>@(_s.KullanilanKm?.ToString() ?? "—")</td>
                    <th>KM Limit / Aşım Ücreti</th><td>@(_s.KmLimit == 0 ? "sınırsız" : _s.KmLimit.ToString()) / @_s.FazlaKmUcret.ToString("N2") @Pb</td></tr>
                @if (_s.KmHediye is not null || _s.BitisSebebi is not null || _s.TeslimAlanAd is not null)
                {
                    <tr><th>KM Hediye</th><td>@(_s.KmHediye?.ToString() ?? "—")</td>
                        <th>Bitiş Sebebi / Teslim Alan</th><td>@(_s.BitisSebebi ?? "—") / @(_s.TeslimAlanAd ?? "—")</td></tr>
                }
                <tr><th>Kira Tutarı</th><td>@_s.Tutar.ToString("N2") @Pb</td>
                    <th>Fazla KM Bedeli</th><td>@_s.FazlaKmBedeli.ToString("N2") @Pb</td></tr>
                <tr><th>Yakıt Bedeli</th><td>@_s.YakitBedeli.ToString("N2") @Pb</td>
                    <th>Uzatma Bedeli</th><td>@_s.UzatmaBedeli.ToString("N2") @Pb</td></tr>
                @if (_s.EkHizmetler.Count > 0)
                {
                    <tr><th>Ek Hizmetler</th>
                        <td colspan="3">@string.Join(" · ", _s.EkHizmetler.Select(e => $"{e.Ad}: {e.Toplam:N2}")) (toplam @_s.EkHizmetToplam.ToString("N2") @Pb)</td></tr>
                }
            </tbody>
        </table>

        <div class="print-totals">
            <div>Genel Toplam: <strong>@_s.GenelToplam.ToString("N2") @Pb</strong></div>
            <div>Tahsilat: @_s.Tahsilat.ToString("N2") @Pb</div>
            <div>Bakiye: <strong>@_s.Bakiye.ToString("N2") @Pb</strong></div>
        </div>

        @* ---- Araç ekspertizi: çıkış + dönüş (SVG şema + yakıt göstergesi + ekipman) ---- *@
        <section class="print-expertiz">
            <div class="exp-col">
                <h3>ARAÇ ÇIKIŞ EKSPERTİZİ</h3>
                @AracSema(_s.CikisYakit)
            </div>
            <div class="exp-col">
                <h3>ARAÇ DÖNÜŞ EKSPERTİZİ</h3>
                @AracSema(_s.DonusYakit)
            </div>
        </section>

        <section class="print-terms">
            <p>Kiracı, aracı ve mevcut hasarları kontrol etmiş olup yeni oluşacak hasarlardan sorumludur. İmza ile kiracı,
            Kiralayanın Standart Kiralama Koşullarını kabul ettiğini ve kira sözleşmesinde belirtilen hususları tam
            anlamıyla kabul ettiğini beyan eder.</p>
            <p class="en">By signing, the renter confirms having inspected the vehicle and its existing damages and accepts
            responsibility for new damages. The renter accepts the Lessor's Standard Rental Terms.</p>
        </section>

        <section class="print-signs @(_s.IkinciSurucuAd is null ? "" : "three")">
            <div>ARACI TESLİM EDEN / DELIVERED BY@(_s.TeslimAlanAd is null ? "" : $" — {_s.TeslimAlanAd}")<br /><span class="sign-line"></span></div>
            <div>1. SÜRÜCÜ / RENTER — @_s.MusteriAd<br /><span class="sign-line"></span></div>
            @if (_s.IkinciSurucuAd is not null)
            {
                <div>2. SÜRÜCÜ / 2ND DRIVER — @_s.IkinciSurucuAd<br /><span class="sign-line"></span></div>
            }
        </section>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private SozlesmeView? _s;
    private string Pb => RentACar.Application.Kur.KurService.NormalizeKod(_s?.Doviz) == "TRY" ? "₺" : (_s?.Doviz ?? "₺");

    protected override async Task OnInitializedAsync()
        => _s = await Sozlesme.GetAsync(Id);

    /// <summary>Basit araç şeması (üstten görünüm) + yakıt göstergesi + ekipman kutuları (inline SVG — emoji yok).</summary>
    private static RenderFragment AracSema(int? yakit) => __builder =>
    {
        <svg viewBox="0 0 300 190" class="exp-svg" xmlns="http://www.w3.org/2000/svg">
            @* Yakıt göstergesi: E ---- F, 0-12 ölçek *@
            <text x="10" y="16" font-size="11">E</text>
            <rect x="22" y="8" width="120" height="10" fill="none" stroke="#334155" />
            @if (yakit is int y)
            {
                <rect x="22" y="8" width="@(120 * Math.Clamp(y, 0, 12) / 12)" height="10" fill="#94a3b8" />
            }
            <text x="148" y="16" font-size="11">F</text>
            <text x="170" y="16" font-size="10">Yakıt: @(yakit?.ToString() ?? "—")/12</text>
            @* Araç üstten şema *@
            <rect x="70" y="34" width="160" height="86" rx="26" fill="none" stroke="#334155" stroke-width="1.5" />
            <rect x="96" y="48" width="108" height="58" rx="10" fill="none" stroke="#94a3b8" />
            <line x1="96" y1="77" x2="204" y2="77" stroke="#cbd5e1" />
            @* Tekerlekler *@
            <rect x="58" y="44" width="12" height="26" rx="4" fill="#334155" />
            <rect x="58" y="84" width="12" height="26" rx="4" fill="#334155" />
            <rect x="230" y="44" width="12" height="26" rx="4" fill="#334155" />
            <rect x="230" y="84" width="12" height="26" rx="4" fill="#334155" />
            @* Ekipman kutuları *@
            <g font-size="9" fill="#1e293b">
                <rect x="10" y="140" width="10" height="10" fill="none" stroke="#334155" /><text x="24" y="149">Avadanlık</text>
                <rect x="84" y="140" width="10" height="10" fill="none" stroke="#334155" /><text x="98" y="149">Trafik Seti</text>
                <rect x="162" y="140" width="10" height="10" fill="none" stroke="#334155" /><text x="176" y="149">Stepne</text>
                <rect x="226" y="140" width="10" height="10" fill="none" stroke="#334155" /><text x="240" y="149">Zincir</text>
            </g>
            <text x="10" y="176" font-size="8" fill="#64748b">Hasarları şema üzerinde işaretleyiniz.</text>
        </svg>
    };
}
