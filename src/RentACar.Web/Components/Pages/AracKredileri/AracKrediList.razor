@page "/arac-kredi"
@attribute [Authorize(Roles = "Admin,Yonetici,Operator,Muhasebe")]
@using RentACar.Application.AracKredileri
@using RentACar.Application.Customers
@using RentACar.Application.Vehicles
@using RentACar.Domain.Enums
@inject AracKrediService Krediler
@inject VehicleService Vehicles
@inject CustomerService Cariler

<PageTitle>Araç Kredisi — RentPro</PageTitle>

<div class="page-head"><h1>Araç Kredisi Takip</h1><div class="actions"><a href="@ExportYolu("excel")">Excel</a> · <a href="@ExportYolu("csv")">CSV</a> · <a href="@ExportYolu("pdf")">PDF</a></div></div>
@* Bu açıklama eskiden "defter postlamaz (salt takip)" diyordu; taksit ödeme artık GERÇEK gider
   postluyor (ExpenseType.Finansman) — formun kendi tooltip'i de öyle diyordu. Metin düzeltildi. *@
<p class="muted small">Banka kredisi + taksit planı + kalan bakiye. Banka entegrasyonu yok.
    Taksit ödemesi <strong>gerçek gider yazar</strong> (Finansman); krediye araç bağlarsanız bu gider
    o aracın karnesine işlenir.</p>
@* KARARLAR.md genel politikası — kullanıcıya YAZILI uyarı: özet kartlar ve cari bağı bilgidir. *@
<p class="muted small">Aşağıdaki <strong>özet kartlar hesaplanan göstergelerdir</strong> ve
    <strong>muhasebe defterine yazmaz</strong>; krediye bağlanan <strong>cari de yalnız
    ilişkilendirmedir</strong> — cari bakiyesini değiştirmez. Gerçek para hareketi yalnız
    "Taksit Öde" (Kasa/Banka) akışından geçer.</p>

@if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }
@if (Ok == "1" && string.IsNullOrEmpty(Hata)) { <p class="muted small">İşlem tamamlandı.</p> }

<form method="get" class="filter-bar">
    <label>Cari
        <select name="cariF">
            <option value="">— tümü —</option>
            @foreach (var c in _cariler)
            {
                <option value="@c.Id" selected="@(c.Id.ToString() == CariF)">@c.Ad</option>
            }
        </select>
    </label>
    <label>Plaka<input name="plakaF" value="@PlakaF" placeholder="34 ABC" /></label>
    <label>Dosya No<input name="dosyaF" value="@DosyaF" /></label>
    <label>Durum
        <select name="durumF">
            <option value="">— tümü —</option>
            @foreach (var d in Enum.GetValues<KrediDurum>())
            {
                <option value="@d" selected="@(d.ToString() == DurumF)">@d</option>
            }
        </select>
    </label>
    <label>Başlangıç ≥<input name="bas" type="date" value="@Bas" /></label>
    <label>Başlangıç ≤<input name="bit" type="date" value="@Bit" /></label>
    <button type="submit">Filtrele</button>
    @if (_filtreVar) { <a class="link" href="/arac-kredi">Temizle</a> }
</form>

@* 5 özet kart — canlı arac_kredi.aspx özet kutularının karşılığı. FİLTRELİ küme üzerinden
   hesaplanır: cariye göre süzünce kartlar o carinin toplamını verir. İptal krediler hariç. *@
<div class="cards">
    <div class="card"><div class="card-num">@_pano.ToplamFaiz.ToString("N2")</div><div class="card-label">Toplam Faiz ₺</div></div>
    <div class="card"><div class="card-num">@(_pano.SonVadeGunu?.LocalDateTime.ToString("dd.MM.yyyy") ?? "—")</div><div class="card-label">Son Vade Günü</div></div>
    <div class="card"><div class="card-num">@_pano.SonTaksitTutari.ToString("N2")</div><div class="card-label">Son Taksit Tutarı</div></div>
    <div class="card"><div class="card-num">@_pano.BuAyToplamTaksit.ToString("N2")</div><div class="card-label">Bu Ayki Toplam Taksit</div></div>
    <div class="card"><div class="card-num">@_pano.ToplamKrediBorcu.ToString("N2")</div><div class="card-label">Toplam Kredi Borcu ₺</div></div>
</div>

<details>
    <summary>Yeni Kredi</summary>
    @* Yetki çiti: uç grup kapısından DAHA DAR izin istiyor (UcIzinKapsamaTests) — kapılanmazsa 403 → /yetkisiz. *@
    <AuthorizeView Policy="izin:FinanceWrite" Context="krediCtx">
        <form method="post" action="/arac-kredi/create" class="grid-form"><AntiforgeryToken />
            @Gizli
            <label>Banka<input name="bankaAdi" required /></label>
            @* Cari OPSİYONEL ve BİLGİ: kredi veren kurum / ilgili müşteri ilişkisi. Cari bakiyesine
               ya da deftere HİÇBİR kayıt yazmaz (KARARLAR.md genel politikası). *@
            <label>Cari (opsiyonel — yalnız ilişki, cari bakiyesini değiştirmez)
                <select name="cariId">
                    <option value="">— bağlı cari yok —</option>
                    @foreach (var c in _cariler)
                    {
                        <option value="@c.Id">@c.Ad</option>
                    }
                </select>
            </label>
            <label>Dosya No<input name="dosyaNo" maxlength="64" /></label>
            @* Araç OPSİYONEL: filo geneli krediler araçsız kalır. Seçilirse taksit gideri o araca
               atfedilir (AracKrediService → AccountLedgerEntry.AccountRef = VehicleId) ve araç
               karnesinde görünür. Uç bu alanı ZATEN okuyordu; eksik olan yalnız formdu. *@
            <label>Araç (opsiyonel — taksit gideri bu araca yazılır)
                <select name="vehicleId">
                    <option value="">— filo geneli —</option>
                    @foreach (var v in _vehicles)
                    {
                        <option value="@v.Id">@v.Plaka</option>
                    }
                </select>
            </label>
            <label>Kredi Tutarı<input name="krediTutari" type="number" step="0.01" min="0" required /></label>
            <label>Yıllık Faiz<input name="faizOran" type="number" step="0.0001" min="0" value="0" /></label>
            <label>Taksit Sayısı<input name="taksitSayisi" type="number" min="1" max="360" required /></label>
            <label>Başlangıç<input name="baslangicTarihi" type="date" /></label>
            <label>Açıklama<input name="aciklama" /></label>
            <button type="submit">Kaydet</button>
        </form>
    </AuthorizeView>
</details>

@* Toplu iptal formu tablonun DIŞINDA: satırlarda zaten form var, iç içe form HTML'de yasak.
   Satırlardaki checkbox'lar form="topluIptal" ile bu forma bağlanır. *@
@* Yetki çiti: uç grup kapısından DAHA DAR izin istiyor (UcIzinKapsamaTests) — kapılanmazsa 403 → /yetkisiz. *@
<AuthorizeView Policy="izin:OperationsDelete" Context="toplu2Ctx">
    <form id="topluIptal" method="post" action="/arac-kredi/taksit-iptal" class="filter-bar"
          data-confirm="Seçili kredilerin KALAN taksitleri iptal edilsin mi? Ödenmiş taksitlerin gider/defter kayıtları AYNEN kalır."><AntiforgeryToken />
        @Gizli
        <button type="submit" class="btn-secondary">Taksitleri İptal Et (seçili)</button>
        <span class="muted small">Yalnız <strong>aktif</strong> krediler etkilenir; ödenmiş taksitler geri alınmaz.</span>
    </form>
</AuthorizeView>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th></th><th>No</th><th>Dosya No</th><th>Banka</th><th>Cari</th><th>Araç</th><th class="num">Kredi</th><th class="num">Aylık Taksit</th><th class="num">Ödenen/Toplam</th><th class="num">Kalan Bakiye</th><th>Son Vade</th><th>Durum</th><th></th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="13" class="muted">@(_filtreVar ? "Filtreye uyan kredi yok." : "Kredi yok.")</td></tr>
        }
        @foreach (var k in _list)
        {
            var o = AracKrediService.Hesapla(k, _simdi);
            <tr>
                <td>
                    @if (k.Durum == KrediDurum.Aktif)
                    {
                        <input type="checkbox" name="id" value="@k.Id" form="topluIptal" aria-label="Kredi seç" />
                    }
                </td>
                <td>@k.No</td>
                <td>@(k.DosyaNo ?? "—")</td>
                <td>@k.BankaAdi</td>
                <td>@Cari(k.CariId)</td>
                <td>@Arac(k.VehicleId)</td>
                <td class="num">@k.KrediTutari.ToString("N2")</td>
                <td class="num">@o.AylikTaksit.ToString("N2")</td>
                <td class="num">@k.OdenenTaksit / @k.TaksitSayisi</td>
                <td class="num">@o.KalanBakiye.ToString("N2") @k.Currency</td>
                <td>@(o.SonVadeGunu?.LocalDateTime.ToString("dd.MM.yyyy") ?? "—")</td>
                <td>@k.Durum</td>
                <td>
                    @if (k.Durum == KrediDurum.Aktif)
                    {
                        <AuthorizeView Roles="Admin,Yonetici,Muhasebe" Context="finCtx">
                            <form method="post" action="/arac-kredi/taksit-ode" style="display:inline"><AntiforgeryToken />
                                <input type="hidden" name="id" value="@k.Id" />
                                <input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />
                                @Gizli
                                <select name="hesap" title="Taksit artık GERÇEK GİDER yazar (Finansman)"><option>Kasa</option><option>Banka</option></select>
                                <HesapSecici CssClass="kf-inline" Etiket="" />
                                <button type="submit" title="Gider(Finansman) + defter kaydı — araç karnesine düşer">Taksit Öde</button>
                            </form>
                        </AuthorizeView>
                        @* Yetki çiti: uç grup kapısından DAHA DAR izin istiyor (UcIzinKapsamaTests) — kapılanmazsa 403 → /yetkisiz. *@
                        <AuthorizeView Policy="izin:OperationsDelete" Context="iptalCtx">
                            <form method="post" action="/arac-kredi/iptal" style="display:inline"
                                  data-confirm="@k.No numaralı kredi iptal edilsin mi? Kalan taksitler bir daha ödenemez ve iptal geri alınamaz (ödenmiş taksitlerin gider/defter kayıtları değişmez)."><AntiforgeryToken /><input type="hidden" name="id" value="@k.Id" />@Gizli<button type="submit" class="btn-secondary">İptal</button></form>
                        </AuthorizeView>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "cariF")] public string? CariF { get; set; }
    [SupplyParameterFromQuery(Name = "plakaF")] public string? PlakaF { get; set; }
    [SupplyParameterFromQuery(Name = "dosyaF")] public string? DosyaF { get; set; }
    [SupplyParameterFromQuery(Name = "durumF")] public string? DurumF { get; set; }
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }

    private IReadOnlyList<AracKredi> _list = [];
    private AracKrediPano _pano = new(0m, null, 0m, 0m, 0m);
    private IReadOnlyList<Vehicle> _vehicles = [];
    /// <summary>PII'sız seçim listesi — ListAsync her carinin TC/ehliyet cipher'ını çözerdi
    /// (dropdown için gereksiz; bayat anahtar-halkasında sayfa başına yüzlerce uyarı üretiyordu).</summary>
    private IReadOnlyList<CariSecim> _cariler = [];
    private Dictionary<Guid, string> _vehMap = [];
    private Dictionary<Guid, string> _cariMap = [];
    private bool _filtreVar;
    /// <summary>"Bu ayki taksit" kutusunun referans anı — tabloyla AYNI değer kullanılsın diye
    /// bir kez alınır (render sırasında ay dönerse kart ile satırlar çelişmesin).</summary>
    private DateTimeOffset _simdi = DateTimeOffset.Now;

    /// <summary>Ekrandaki filtre export'a AYNEN taşınır (giderler/fatura-detay deseni) — kullanıcı
    /// gördüğü listeyi indirir, tüm tabloyu değil.</summary>
    private string ExportYolu(string format)
    {
        var q = new List<string> { $"format={format}" };
        void Ekle(string ad, string? v) { if (!string.IsNullOrWhiteSpace(v)) q.Add($"{ad}={Uri.EscapeDataString(v)}"); }
        Ekle("cariF", CariF); Ekle("plakaF", PlakaF); Ekle("dosyaF", DosyaF);
        Ekle("durumF", DurumF); Ekle("bas", Bas); Ekle("bit", Bit);
        return "/listeler/export/arac-kredileri?" + string.Join("&", q);
    }

    /// <summary>POST uçlarına filtreyi taşıyan gizli alanlar — işlemden sonra kullanıcı aynı
    /// süzgeçte kalır (uç yalnız bu bilinen anahtarları geri yazar, açık yönlendirme yok).</summary>
    private RenderFragment Gizli => @<text>
        <input type="hidden" name="cariF" value="@CariF" />
        <input type="hidden" name="plakaF" value="@PlakaF" />
        <input type="hidden" name="dosyaF" value="@DosyaF" />
        <input type="hidden" name="durumF" value="@DurumF" />
        <input type="hidden" name="bas" value="@Bas" />
        <input type="hidden" name="bit" value="@Bit" />
    </text>;

    protected override async Task OnInitializedAsync()
    {
        var filtre = new AracKrediFilter
        {
            CariId = Guid.TryParse(CariF, out var c) ? c : null,
            Plaka = string.IsNullOrWhiteSpace(PlakaF) ? null : PlakaF,
            DosyaNo = string.IsNullOrWhiteSpace(DosyaF) ? null : DosyaF,
            Durum = Enum.TryParse<KrediDurum>(DurumF, out var d) ? d : null,
            Bas = DateTimeOffset.TryParse(Bas, System.Globalization.CultureInfo.InvariantCulture, out var b1)
                ? b1.ToUniversalTime() : null,
            // Bitiş günü DAHİL: gün sonuna taşınır, yoksa o günün kredileri düşerdi.
            Bit = DateTimeOffset.TryParse(Bit, System.Globalization.CultureInfo.InvariantCulture, out var b2)
                ? b2.ToUniversalTime().AddDays(1).AddTicks(-1) : null
        };
        _filtreVar = !filtre.Bos;
        _list = await Krediler.SearchAsync(filtre);
        _pano = AracKrediService.Pano(_list, _simdi);

        _vehicles = await Vehicles.ListAsync();
        _vehMap = _vehicles.ToDictionary(v => v.Id, v => v.Plaka);
        _cariler = await Cariler.ListSecimAsync();
        _cariMap = _cariler.ToDictionary(x => x.Id, x => x.Ad);
    }

    /// <summary>Kredinin bağlı olduğu araç plakası; filo geneli kredide "—".</summary>
    private string Arac(Guid? id) => id is { } g && _vehMap.TryGetValue(g, out var p) ? p : "—";

    /// <summary>Kredinin ilişkili carisi; bağlanmamışsa "—".</summary>
    private string Cari(Guid? id) => id is { } g && _cariMap.TryGetValue(g, out var n) ? n : "—";
}
