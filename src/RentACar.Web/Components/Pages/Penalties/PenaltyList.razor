@page "/cezalar"
@attribute [Authorize]
@using System.Globalization
@using RentACar.Domain.Enums
@inject PenaltyService Penalties
@inject PenaltyTypeService CezaTurleri
@inject VehicleService Vehicles
@inject CustomerService Customers

<PageTitle>Cezalar — RentPro</PageTitle>

<div class="page-head"><h1>Trafik Cezaları</h1><div class="actions"><a href="/listeler/export/cezalar">Excel</a> · <a href="/listeler/export/cezalar?format=csv">CSV</a> · <a href="/listeler/export/cezalar?format=pdf">PDF</a></div></div>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_rows.Count == 0)">
    <summary>+ Yeni Ceza</summary>
    <form method="post" action="/cezalar/create" class="grid-form"><AntiforgeryToken />
        <ComboBox Name="cezaTuru" Label="Ceza Türü" Options="_penaltyTypeOpts" required="true" />
        <label>Tebliğ Tarihi<input name="tebligTarihi" type="date" /></label>
        <label>Ceza Saati<input name="saat" type="time" /></label>
        <label>Vade (gün)<input name="vadeGun" type="number" value="15" /></label>
        <label>Ceza Yeri<input name="yer" maxlength="256" /></label>
        <label>Cep Tel<input name="cepTel" maxlength="32" /></label>
        <label>Makbuz No<input name="makbuzNo" maxlength="64" /></label>
        <label>İşlem Şube<input name="islemSube" maxlength="128" /></label>
        <label>Araç
            <select name="vehicleId">
                <option value="">—</option>
                @foreach (var v in _vehicles)
                {
                    <option value="@v.Id">@v.Plaka</option>
                }
            </select>
        </label>
        <label>Müşteri (Cari)
            <select name="cariId">
                <option value="">—</option>
                @foreach (var c in _customers)
                {
                    <option value="@c.Id">@c.DisplayName</option>
                }
            </select>
        </label>

        @* FAZ-60 — çok kalemli ceza (canlı Ceza_Tutari1-3 paritesi + 2 ek slot). Boş kalem atlanır. *@
        <label>1. Kalem Tutar<input name="tutar" type="number" step="0.01" min="0.01" required /></label>
        <label>1. Kalem Sebep<input name="sebep" maxlength="512" /></label>
        <label>2. Kalem Tutar<input name="satirTutar2" type="number" step="0.01" min="0" /></label>
        <label>2. Kalem Sebep<input name="satirSebep2" maxlength="512" /></label>
        <label>3. Kalem Tutar<input name="satirTutar3" type="number" step="0.01" min="0" /></label>
        <label>3. Kalem Sebep<input name="satirSebep3" maxlength="512" /></label>
        <label>4. Kalem Tutar<input name="satirTutar4" type="number" step="0.01" min="0" /></label>
        <label>4. Kalem Sebep<input name="satirSebep4" maxlength="512" /></label>
        <label>5. Kalem Tutar<input name="satirTutar5" type="number" step="0.01" min="0" /></label>
        <label>5. Kalem Sebep<input name="satirSebep5" maxlength="512" /></label>

        <button type="submit">Kaydet</button>
    </form>
</details>

<form method="get" class="filter-bar">
    <label>Müşteri<input name="musteri" value="@Musteri" placeholder="Ad / e-posta / no" /></label>
    <label>Makbuz No<input name="makbuz" value="@Makbuz" /></label>
    <label>Plaka<input name="plaka" value="@Plaka" /></label>
    <label>Tebliğ (min)<input name="bas" type="date" value="@Bas" /></label>
    <label>Tebliğ (max)<input name="bit" type="date" value="@Bit" /></label>
    <label>Ceza Durumu
        <select name="durum">
            <option value="">— tümü —</option>
            @foreach (var d in Enum.GetValues<PenaltyStatus>())
            {
                <option value="@d" selected="@(d.ToString() == Durum)">@d</option>
            }
        </select>
    </label>
    <label>Ödeme Durumu
        <select name="odeme">
            <option value="">— tümü —</option>
            @foreach (var o in Enum.GetValues<PenaltyPaymentStatus>())
            {
                <option value="@o" selected="@(o.ToString() == Odeme)">@o</option>
            }
        </select>
    </label>
    <label>İşlem Şube<input name="sube" value="@Sube" /></label>
    <button type="submit">Filtrele</button>
    @if (SuzgecVar)
    {
        <a class="link" href="/cezalar">Temizle</a>
    }
</form>

<div class="table-scroll">
@* kart-mobil: 640px altında satır karta döner. 19 kolonun tamamı kartta anlamsız olurdu; kartta
   cezayı tanıtan çekirdek var (no başlık; tebliğ, araç, müşteri, tutar, kalan, durum). Kalem/kısmi
   ödeme satırı (colspan) kartın altında açılır kalır. *@
<table class="grid tr-grid kart-mobil">
    <thead>
        <tr>
            <th>No</th><th>Tür</th><th>Tebliğ</th><th>Saat</th><th>Vade</th><th>Araç</th>
            <th>Müşteri</th><th>Mail Adresi</th><th>Sözleşme No</th><th>Fatura Tar./No</th>
            <th>İşlem Şube</th><th>Rez. Kaynağı</th><th>Makbuz No</th>
            <th>Tutar</th><th>Ödenen</th><th>Kalan</th><th>Ödeme Tarihi</th><th>Ödeme Şekli</th>
            <th>Durum</th><th></th>
        </tr>
    </thead>
    <tbody>
        @if (_rows.Count == 0)
        {
            <tr><td colspan="20" class="muted">Ceza yok.</td></tr>
        }
        @foreach (var row in _rows)
        {
            var p = row.Ceza;
            <tr>
                <td class="kart-baslik">@p.No</td>
                <td>@p.CezaTuru</td>
                <td data-etiket="Tebliğ">@p.TebligTarihi.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td>@(p.Saat ?? "—")</td>
                <td>@p.VadeTarihi.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td data-etiket="Araç">@(row.Plaka ?? "—")</td>
                <td data-etiket="Müşteri">@(row.MusteriAd ?? "—")</td>
                <td>@(row.MusteriEposta ?? "—")</td>
                <td>@(row.SozlesmeNo ?? "—")</td>
                <td>@InvoiceLabel(row)</td>
                <td>@(p.IslemSube ?? "—")</td>
                <td>@(row.RezKaynak ?? "—")</td>
                <td>@(p.MakbuzNo ?? "—")</td>
                <td data-etiket="Tutar">@p.Tutar.ToString("N2")</td>
                <td>@p.OdenenTutar.ToString("N2")</td>
                <td data-etiket="Kalan">@p.Kalan.ToString("N2")</td>
                <td>@(p.OdenmeTarihi?.LocalDateTime.ToString("dd.MM.yyyy") ?? "—")</td>
                <td>@Method(row)</td>
                <td data-etiket="Durum">@p.Durum</td>
                <td class="kart-aksiyon">
                    @if (p.Durum == PenaltyStatus.Yeni && p.CariId is not null)
                    {
                        <form method="post" action="/cezalar/yansit" class="inline"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@p.Id" />
                            <button type="submit">Yansıt</button>
                        </form>
                    }
                    @if (p.Durum == PenaltyStatus.Yeni && p.OdenenTutar == 0m)
                    {
                        @* Yetki çiti: uç grup kapısından DAHA DAR izin istiyor (UcIzinKapsamaTests) — kapılanmazsa 403 → /yetkisiz. *@
                        <AuthorizeView Policy="izin:OperationsDelete" Context="iptalCtx">
                            @* Bu dalda ceza henüz yansıtılmamış ve ödenmemiş (servis de bunu şart koşar) →
                               iptal ters kayıt DEĞİL, yalnız durum değişikliği; mesaj bunu doğru söyler. *@
                            <form method="post" action="/cezalar/iptal" class="inline"
                                  data-confirm="@p.No numaralı ceza iptal edilsin mi? Ceza İptal durumuna geçer ve müşteriye bir daha yansıtılamaz; iptal geri alınamaz. (Henüz yansıtılmadığı ve ödenmediği için defter kaydı oluşmaz.)"><AntiforgeryToken />
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit">İptal</button>
                            </form>
                        </AuthorizeView>
                    }
                </td>
            </tr>
            @if (p.Durum != PenaltyStatus.Iptal && row.Satirlar.Count > 0)
            {
                <tr class="detail-row">
                    <td colspan="20">
                        <details open="@(row.Satirlar.Count > 1 && p.Kalan > 0m)">
                            <summary>Kalemler ve Kısmi Ödeme (@row.Satirlar.Count kalem · kalan @p.Kalan.ToString("N2"))</summary>
                            @* İÇ TABLO da işaretlenmeli: "etiketsiz hücre gizlenir" kuralı torun
                               hücrelere de iner — işaretlenmeseydi kalemler ve kısmi ödeme formu
                               telefonda tamamen kaybolurdu. *@
                            <table class="grid kart-mobil">
                                <thead><tr><th>#</th><th>Sebep</th><th>Tutar</th><th>Ödenen</th><th>Kalan</th><th>Ödeme</th></tr></thead>
                                <tbody>
                                @foreach (var s in row.Satirlar)
                                {
                                    <tr>
                                        <td>@s.Sira</td>
                                        <td class="kart-baslik">@(s.Sebep ?? "—")</td>
                                        <td data-etiket="Tutar">@s.Tutar.ToString("N2")</td>
                                        <td data-etiket="Ödenen">@s.Odenen.ToString("N2")</td>
                                        <td data-etiket="Kalan">@s.Kalan.ToString("N2")</td>
                                        <td class="kart-aksiyon">
                                            @if (s.Kalan > 0m)
                                            {
                                                <form method="post" action="/cezalar/kismi-ode" class="inline"><AntiforgeryToken />
                                                    <input type="hidden" name="id" value="@p.Id" />
                                                    <input type="hidden" name="satirId" value="@s.Id" />
                                                    @* Çift-submit koruması: her render'da taze anahtar. *@
                                                    <input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />
                                                    <input name="tutar" type="number" step="0.01" min="0.01"
                                                           max="@s.Kalan.ToString(CultureInfo.InvariantCulture)"
                                                           value="@s.Kalan.ToString(CultureInfo.InvariantCulture)" required />
                                                    <select name="hesap">
                                                        <option value="Kasa">Kasa</option>
                                                        <option value="Banka">Banka</option>
                                                    </select>
                                                    <input name="tarih" type="date" />
                                                    <input name="makbuzNo" placeholder="Makbuz No" maxlength="64" />
                                                    <input name="islemYapan" placeholder="İşlem Yapan" maxlength="128" />
                                                    <button type="submit">Öde</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="muted">kapandı</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                            @if (row.Odemeler.Count > 0)
                            {
                                <p class="muted">
                                    Ödeme geçmişi:
                                    @string.Join(" · ", row.Odemeler.Select(o =>
                                        $"{o.Tarih.LocalDateTime:dd.MM.yyyy} {o.Tutar.ToString("N2")} {o.Hesap}"
                                        + (string.IsNullOrWhiteSpace(o.MakbuzNo) ? "" : $" ({o.MakbuzNo})")))
                                </p>
                            }
                        </details>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "musteri")] public string? Musteri { get; set; }
    [SupplyParameterFromQuery(Name = "makbuz")] public string? Makbuz { get; set; }
    [SupplyParameterFromQuery(Name = "plaka")] public string? Plaka { get; set; }
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }
    [SupplyParameterFromQuery(Name = "odeme")] public string? Odeme { get; set; }
    [SupplyParameterFromQuery(Name = "sube")] public string? Sube { get; set; }

    private IReadOnlyList<PenaltyRow> _rows = [];
    private IReadOnlyList<Vehicle> _vehicles = [];
    private IReadOnlyList<Customer> _customers = [];
    private IReadOnlyList<PenaltyType> _penaltyTypes = [];
    private List<string> _penaltyTypeOpts = [];

    private bool SuzgecVar =>
        !string.IsNullOrWhiteSpace(Musteri) || !string.IsNullOrWhiteSpace(Makbuz)
        || !string.IsNullOrWhiteSpace(Plaka) || !string.IsNullOrWhiteSpace(Bas)
        || !string.IsNullOrWhiteSpace(Bit) || !string.IsNullOrWhiteSpace(Durum)
        || !string.IsNullOrWhiteSpace(Odeme) || !string.IsNullOrWhiteSpace(Sube);

    protected override async Task OnInitializedAsync()
    {
        var filter = new PenaltyFilter
        {
            Musteri = Musteri,
            MakbuzNo = Makbuz,
            Plaka = Plaka,
            // Takvim günü: alt sınır günün başı, üst sınır repository'de GÜN DAHİL genişletilir.
            Bas = Day(Bas),
            Bit = Day(Bit),
            Durum = Enum.TryParse<PenaltyStatus>(Durum, out var d) ? d : null,
            OdemeDurum = Enum.TryParse<PenaltyPaymentStatus>(Odeme, out var o) ? o : null,
            IslemSube = Sube
        };
        _rows = await Penalties.ListRowsAsync(filter);
        _penaltyTypes = await CezaTurleri.ListActiveAsync();
        _vehicles = await Vehicles.ListAsync();
        _customers = await Customers.ListAsync();

        // Seç-veya-yaz önerileri: master tanım (Ad) ∪ mevcut kayıtların distinct'i.
        _penaltyTypeOpts = _penaltyTypes.Select(t => t.Ad)
            .Concat(_rows.Select(r => r.Ceza.CezaTuru))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.CurrentCulture)
            .ToList();
    }

    private static DateTimeOffset? Day(string? s)
        => DateTimeOffset.TryParse((s ?? "").Trim(), CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? d.ToUniversalTime() : null;

    private static string InvoiceLabel(PenaltyRow r)
        => r.FaturaNo is null ? "—" : $"{r.FaturaTarihi?.LocalDateTime.ToString("dd.MM.yyyy")} / {r.FaturaNo}";

    /// <summary>Ödeme şekli = ödemelerin kullandığı hesap türleri (Kasa/Banka) — defterden gelir.</summary>
    private static string Method(PenaltyRow r)
        => r.Odemeler.Count == 0 ? "—"
            : string.Join(", ", r.Odemeler.Select(o => o.Hesap.ToString()).Distinct());
}
