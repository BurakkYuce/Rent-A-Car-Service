@page "/gelen-efatura"
@attribute [Authorize(Policy = "izin:FinanceWrite")]
@inject GelenEFaturaService GelenFaturalar
@inject VehicleService Vehicles
@inject CustomerService Customers
@inject RentACar.Application.ExpenseCategories.ExpenseCategoryService Kategoriler
@inject RentACar.Application.Branches.BranchService Subeler

<PageTitle>Gelen e-Fatura — RentPro</PageTitle>

<div class="page-head"><h1>Gelen e-Fatura</h1><div class="actions"></div></div>
<p class="muted small">Gelen (satın-alma) e-faturaların triage kutusu: GİB'den çek (entegrasyon kimliği
    gerekir — yoksa boş döner) veya elle gir, sonra Onayla / Reddet. Onaylı faturaya KDV oran kırılımı
    (%20/%10/%1/%0) ve araç / gider kategorisi / tedarikçi bağlanır; <b>Giderleştir</b> aksiyonu
    faturayı deftere yansıtır (her oran kademesi ayrı bir gider satırı: Borç Gider + Borç indirilecek
    KDV / Alacak Cari·Kasa·Banka). Bu tablonun tutarları hiçbir rapora GİRMEZ — para yalnız oluşan
    <a href="/giderler">gider belgelerinden</a> okunur, çift sayım olmaz.</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<form method="get" class="filter-bar">
    <label>Firma / VKN<input name="firma" value="@Firma" placeholder="ünvan veya VKN" /></label>
    <label>Fatura No (ETTN) ≥<input name="ettnBas" value="@EttnBas" /></label>
    <label>Fatura No (ETTN) ≤<input name="ettnBit" value="@EttnBit" /></label>
    <label>Plaka<input name="plaka" value="@Plaka" /></label>
    <label>İşlem Türü
        <select name="durum">
            <option value="">(hepsi)</option>
            @foreach (var d in Enum.GetValues<GelenEFaturaDurum>())
            {
                <option value="@d" selected="@(Durum == d.ToString())">@DurumEtiket(d)</option>
            }
        </select>
    </label>
    <label>Başlangıç<input name="bas" type="date" value="@Bas" /></label>
    <label>Bitiş<input name="bit" type="date" value="@Bit" /></label>
    <label>Defter
        <select name="gider">
            <option value="">(hepsi)</option>
            <option value="1" selected="@(Gider == "1")">Giderleştirilmiş</option>
            <option value="0" selected="@(Gider == "0")">Giderleştirilmemiş</option>
        </select>
    </label>
    <button type="submit">Filtrele</button>
    <a href="/gelen-efatura" class="link">Temizle</a>
</form>

<div class="report-cols">
    <details class="new-vehicle" open="@(_list.Count == 0)">
        <summary>+ Elle Gelen Fatura Gir</summary>
        <form method="post" action="/gelen-efatura/create" class="grid-form"><AntiforgeryToken />
            <label>ETTN<input name="ettn" required placeholder="e-fatura tekil no" /></label>
            <label>Gönderen VKN<input name="gonderenVkn" required /></label>
            <label>Gönderen Ünvan<input name="gonderenUnvan" required /></label>
            <label>Tarih<input name="tarih" type="date" /></label>
            <label>Net<input name="netTutar" type="number" step="0.01" min="0" /></label>
            <label>KDV<input name="kdvTutar" type="number" step="0.01" min="0" /></label>
            <label>Genel Toplam<input name="genelToplam" type="number" step="0.01" min="0" /></label>
            <label>Döviz<input name="currency" maxlength="3" placeholder="TRY" /></label>
            <label>Açıklama<input name="aciklama" /></label>
            <button type="submit">Ekle</button>
        </form>
        <p class="muted small">Net + KDV = Genel Toplam olmalıdır (belge kendi içinde tutarlı değilse kabul edilmez).</p>
    </details>

    <details class="new-vehicle">
        <summary>GİB'den Çek (sync)</summary>
        <form method="post" action="/gelen-efatura/sync" class="grid-form"><AntiforgeryToken />
            <label>Başlangıç<input name="from" type="date" /></label>
            <label>Bitiş<input name="to" type="date" /></label>
            <button type="submit">Çek</button>
        </form>
        <p class="muted small">Entegrasyon kimliği yoksa boş döner (stub); mevcut ETTN'ler atlanır (idempotent).</p>
    </details>
</div>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr>
        <th>ETTN</th><th>Gönderen</th><th>VKN</th><th>Tarih</th>
        <th class="num">Net</th><th class="num">KDV</th><th class="num">Genel</th><th>Döviz</th>
        <th class="num">%20 Matrah</th><th class="num">%20 KDV</th>
        <th class="num">%10 Matrah</th><th class="num">%10 KDV</th>
        <th class="num">%1 Matrah</th><th class="num">%1 KDV</th><th class="num">%0 Matrah</th>
        <th>Araç</th><th>Kategori</th><th>Tedarikçi</th>
        <th>Durum</th><th>Defter</th><th>İşlem</th>
    </tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="21" class="muted">Gelen e-fatura yok.</td></tr>
        }
        @foreach (var r in _list)
        {
            <tr>
                <td class="mono">@r.Ettn</td>
                <td>@r.GonderenUnvan</td>
                <td class="mono">@r.GonderenVkn</td>
                <td>@r.Tarih.ToLocalTime().ToString("yyyy-MM-dd")</td>
                <td class="num">@r.NetTutar.ToString("N2")</td>
                <td class="num">@r.KdvTutar.ToString("N2")</td>
                <td class="num">@r.GenelToplam.ToString("N2")</td>
                <td class="mono">@r.Currency</td>
                <td class="num">@Say(r.Kdv20Matrah)</td>
                <td class="num">@Say(r.Kdv20)</td>
                <td class="num">@Say(r.Kdv10Matrah)</td>
                <td class="num">@Say(r.Kdv10)</td>
                <td class="num">@Say(r.Kdv1Matrah)</td>
                <td class="num">@Say(r.Kdv1)</td>
                <td class="num">@Say(r.Kdv0Matrah)</td>
                <td>@(r.VehicleId is { } vid && _vehMap.TryGetValue(vid, out var pl) ? pl : "—")</td>
                <td>@(r.ExpenseCategoryId is { } kid && _katMap.TryGetValue(kid, out var ka) ? ka : "—")</td>
                <td>@(r.CariId is { } cid && _custMap.TryGetValue(cid, out var cn) ? cn : "—")</td>
                <td>@DurumEtiket(r.Durum)@(r.Durum == GelenEFaturaDurum.Reddedildi && !string.IsNullOrEmpty(r.RedNedeni) ? $" ({r.RedNedeni})" : "")</td>
                <td>
                    @if (r.GiderlestirilmeUtc is { } g)
                    {
                        <span class="badge ok" title="Deftere yansıdı">@g.ToLocalTime().ToString("yyyy-MM-dd")</span>
                    }
                    else
                    {
                        <span class="muted">—</span>
                    }
                </td>
                <td>
                    @if (r.Durum == GelenEFaturaDurum.Beklemede)
                    {
                        <form method="post" action="/gelen-efatura/onayla" style="display:inline"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="link">Onayla</button>
                        </form>
                        <details style="display:inline">
                            <summary class="link danger">Reddet</summary>
                            <form method="post" action="/gelen-efatura/reddet" class="grid-form"><AntiforgeryToken />
                                <input type="hidden" name="id" value="@r.Id" />
                                <label>Red Nedeni<input name="neden" /></label>
                                <button type="submit">Reddet</button>
                            </form>
                        </details>
                    }
                    @if (r.GiderlestirilmeUtc is null && r.Durum != GelenEFaturaDurum.Reddedildi)
                    {
                        <details style="display:inline">
                            <summary class="link">KDV Kırılımı / Bağla</summary>
                            <form method="post" action="/gelen-efatura/bagla" class="grid-form"><AntiforgeryToken />
                                <input type="hidden" name="id" value="@r.Id" />
                                <label>%20 Matrah<input name="kdv20Matrah" type="number" step="0.01" min="0" value="@Val(r.Kdv20Matrah)" /></label>
                                <label>%20 KDV<input name="kdv20" type="number" step="0.01" min="0" value="@Val(r.Kdv20)" /></label>
                                <label>%10 Matrah<input name="kdv10Matrah" type="number" step="0.01" min="0" value="@Val(r.Kdv10Matrah)" /></label>
                                <label>%10 KDV<input name="kdv10" type="number" step="0.01" min="0" value="@Val(r.Kdv10)" /></label>
                                <label>%1 Matrah<input name="kdv1Matrah" type="number" step="0.01" min="0" value="@Val(r.Kdv1Matrah)" /></label>
                                <label>%1 KDV<input name="kdv1" type="number" step="0.01" min="0" value="@Val(r.Kdv1)" /></label>
                                <label>%0 Matrah<input name="kdv0Matrah" type="number" step="0.01" min="0" value="@Val(r.Kdv0Matrah)" /></label>
                                <label>Araç
                                    <select name="vehicleId">
                                        <option value="">—</option>
                                        @foreach (var v in _vehicles)
                                        {
                                            <option value="@v.Id" selected="@(r.VehicleId == v.Id)">@v.Plaka</option>
                                        }
                                    </select>
                                </label>
                                <label>Gider Kategorisi
                                    <select name="expenseCategoryId">
                                        <option value="">—</option>
                                        @foreach (var k in _kategoriler)
                                        {
                                            <option value="@k.Id" selected="@(r.ExpenseCategoryId == k.Id)">@k.Ad</option>
                                        }
                                    </select>
                                </label>
                                <label>Tedarikçi
                                    <select name="cariId">
                                        <option value="">—</option>
                                        @foreach (var c in _customers)
                                        {
                                            <option value="@c.Id" selected="@(r.CariId == c.Id)">@c.DisplayName</option>
                                        }
                                    </select>
                                </label>
                                <label>Gider Türü
                                    <select name="giderTipi">
                                        <option value="">(otomatik: araç varsa Araç)</option>
                                        @foreach (var t in Enum.GetValues<ExpenseType>())
                                        {
                                            <option value="@t" selected="@(r.GiderTipi == t)">@t</option>
                                        }
                                    </select>
                                </label>
                                <button type="submit">Kaydet</button>
                            </form>
                            <p class="muted small">Σ matrah = Net, Σ KDV = KDV olmalı; her kademenin KDV'si
                                matrah × oran (kuruşa yuvarlı) olmalıdır. Tutmazsa kaydedilmez.</p>
                        </details>
                    }
                    @if (r.Durum == GelenEFaturaDurum.Onaylandi && r.GiderlestirilmeUtc is null)
                    {
                        <details style="display:inline">
                            <summary class="link">Giderleştir</summary>
                            <form method="post" action="/gelen-efatura/giderlestir" class="grid-form"
                                  data-confirm="Fatura deftere gider olarak yazılacak. Devam edilsin mi?"><AntiforgeryToken />
                                <input type="hidden" name="id" value="@r.Id" />
                                <label>Ödeme
                                    <select name="odemeYontemi">
                                        @foreach (var o in Enum.GetValues<OdemeYontemi>())
                                        {
                                            <option value="@o" selected="@(o == OdemeYontemi.AcikHesap)">@o</option>
                                        }
                                    </select>
                                </label>
                                <label>Tedarikçi (açık hesap)
                                    <select name="cariId">
                                        <option value="">(faturaya bağlı olan)</option>
                                        @foreach (var c in _customers)
                                        {
                                            <option value="@c.Id" selected="@(r.CariId == c.Id)">@c.DisplayName</option>
                                        }
                                    </select>
                                </label>
                                <ComboBox Name="sube" Label="Şube" Options="_subeOpts" Placeholder="(opsiyonel)" />
                                <button type="submit">Deftere Yaz</button>
                            </form>
                            <p class="muted small">Her KDV kademesi ayrı gider satırı olur; tümü tek
                                transaction'da yazılır. Aynı fatura ikinci kez giderleştirilemez.</p>
                        </details>
                    }
                    @if (r.Durum == GelenEFaturaDurum.Onaylandi && r.GiderlestirilmeUtc is null)
                    {
                        <form method="post" action="/gelen-efatura/isle" data-confirm="Fatura defter kaydı OLMADAN 'işlendi' işaretlensin mi?" style="display:inline"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="link">Defter Dışı İşle</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "firma")] public string? Firma { get; set; }
    [SupplyParameterFromQuery(Name = "ettnBas")] public string? EttnBas { get; set; }
    [SupplyParameterFromQuery(Name = "ettnBit")] public string? EttnBit { get; set; }
    [SupplyParameterFromQuery(Name = "plaka")] public string? Plaka { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }
    [SupplyParameterFromQuery(Name = "gider")] public string? Gider { get; set; }

    private IReadOnlyList<GelenEFatura> _list = [];
    private IReadOnlyList<Vehicle> _vehicles = [];
    private IReadOnlyList<Customer> _customers = [];
    private IReadOnlyList<ExpenseCategory> _kategoriler = [];
    private List<string> _subeOpts = [];
    private Dictionary<Guid, string> _vehMap = [];
    private Dictionary<Guid, string> _custMap = [];
    private Dictionary<Guid, string> _katMap = [];

    protected override async Task OnInitializedAsync()
    {
        _vehicles = await Vehicles.ListAsync();
        _customers = await Customers.ListAsync();
        _kategoriler = await Kategoriler.ListActiveAsync();
        _subeOpts = (await Subeler.ListActiveAsync()).Select(s => s.Ad).ToList();
        _vehMap = _vehicles.ToDictionary(v => v.Id, v => v.Plaka);
        _custMap = _customers.ToDictionary(c => c.Id, c => c.DisplayName);
        _katMap = _kategoriler.ToDictionary(k => k.Id, k => k.Ad);

        _list = await GelenFaturalar.ListAsync(new GelenEFaturaFilter
        {
            Firma = Firma,
            EttnBas = EttnBas,
            EttnBit = EttnBit,
            Plaka = Plaka,
            Durum = Enum.TryParse<GelenEFaturaDurum>(Durum, out var d) ? d : null,
            Bas = Tarih(Bas),
            // Üst sınır GÜN SONUNA genişletilir: date girişi 00:00'a düşer, aksi hâlde "bit"
            // günündeki faturalar dışarıda kalırdı (giderler ekranıyla aynı desen).
            Bit = Tarih(Bit)?.AddDays(1).AddTicks(-1),
            Giderlestirildi = Gider == "1" ? true : (Gider == "0" ? false : null)
        });
    }

    private static DateTimeOffset? Tarih(string? s)
        => DateTimeOffset.TryParse(s, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? d.ToUniversalTime() : null;

    private static string Say(decimal? v) => v is { } d ? d.ToString("N2") : "—";

    /// <summary>Form prefill: ondalık DAİMA InvariantCulture (tr-TR virgülü number input'a boş gelir
    /// ve kayıtta alan silinirdi — round-trip tuzağı).</summary>
    private static string Val(decimal? v)
        => v is { } d ? d.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "";

    private static string DurumEtiket(GelenEFaturaDurum d) => d switch
    {
        GelenEFaturaDurum.Beklemede => "Beklemede",
        GelenEFaturaDurum.Onaylandi => "Onaylandı",
        GelenEFaturaDurum.Reddedildi => "Reddedildi",
        GelenEFaturaDurum.Islendi => "İşlendi",
        _ => d.ToString()
    };
}
