@page "/tarife-aktar"
@attribute [Authorize(Roles = "Admin")]
@using RentACar.Application.RateMatrices
@using RentACar.Domain.Enums
@inject RateMatrixService Tarifeler

<PageTitle>Tarife İçe Aktar — RentPro</PageTitle>

<div class="page-head"><h1>Tarife İçe Aktar (Toplu Fiyat)</h1></div>

<p class="muted small">CSV/Excel dosyasından <strong>tarife matrisi</strong> satırlarını toplu yükler
    (referans sistem "xml_fiyat_aktar" karşılığı). Tüm satırlar <strong>Beklemede</strong> girer — fiyat motoru
    onaylanmamış tarifeyi <strong>kullanmaz</strong>; onay <a href="/tarife-matris">Tarife Matrisi</a>
    ekranından verilir. Kod tekrarı (mevcut ya da dosya içi) atlanır; bozuk satırlar rapor edilir,
    diğerleri girer. Yalnız Admin.</p>

@if (Eklenen is not null || Mesaj is not null)
{
    <div class="summary-strip" style="margin:1rem 0;">
        @if (Mesaj is not null)
        {
            <div class="cell"><div class="s-v">@Mesaj</div></div>
        }
        else
        {
            <div class="cell"><div class="s-k">Tarife</div><div class="s-v">içe-aktarım</div></div>
            <div class="cell"><div class="s-k">Eklenen (Beklemede)</div><div class="s-v">@Eklenen</div></div>
            <div class="cell"><div class="s-k">Atlanan (tekrar)</div><div class="s-v">@Atlanan</div></div>
            <div class="cell"><div class="s-k">Hatalı</div><div class="s-v">@(Hatali ?? 0)</div></div>
        }
    </div>
    @if (!string.IsNullOrEmpty(Hatalar))
    {
        <div class="vt-box warn" style="margin:0 0 1rem;padding:.6rem .9rem;">
            <strong>Satır hataları (ilk 5):</strong>
            <ul style="margin:.25rem 0 0 1rem;">
                @foreach (var h in Hatalar.Split('|'))
                {
                    <li class="small">@h</li>
                }
            </ul>
        </div>
    }
}

<section class="import-card" style="max-width:560px;">
    <form method="post" action="/tarife-aktar/yukle" enctype="multipart/form-data"><AntiforgeryToken />
        <input type="file" name="dosya" accept=".xlsx,.xls,.csv" required />
        <button type="submit" class="btn-primary">Tarifeleri Aktar</button>
    </form>
    <p class="muted small" style="margin-top:.75rem;">Tanınan sütunlar (esnek eşleme): <strong>Kod</strong> (zorunlu),
        Ad, Kanal, Grup/Araç Grubu, Şube, Lokasyon, Başlangıç, Bitiş (2026-01-15 veya 15.01.2026),
        Gün 1..Gün 7, Haftalık (8-29 gün), Aylık (30+), Para Birimi, Açıklama.
        Sayılar "1.250,50" veya "1250.50" biçiminde olabilir. Dosyadaki onay kolonları yok sayılır.</p>
</section>

<h2 class="dash-h2">Aktarılan Tarifeler (canlı)</h2>
<p class="muted small">İçe aktarılan satırlar burada <strong>anında</strong> görünür — onay hâlâ
    <a href="/tarife-matris">Tarife Matrisi</a> ekranından verilir. Filtre satırları daraltır;
    toplu silme <strong>yalnız filtrelenen kanalın BEKLEYEN satırlarını</strong> siler.</p>

<form method="get" class="filter-bar">
    <label>Rez. Kaynağı (Kanal)
        <select name="kanal">
            <option value="">— tümü —</option>
            @foreach (var k in _kanallar) { <option value="@k" selected="@(k == Kanal)">@k</option> }
        </select>
    </label>
    <label>Şube
        <select name="sube">
            <option value="">— tümü —</option>
            @foreach (var s in _subeler) { <option value="@s" selected="@(s == Sube)">@s</option> }
        </select>
    </label>
    <label>Onay
        <select name="durum">
            <option value="">— tümü —</option>
            @foreach (var d in Enum.GetValues<TariffApprovalStatus>()) { <option value="@d" selected="@(d.ToString() == Durum)">@d</option> }
        </select>
    </label>
    <button type="submit">Filtrele</button>
    @if (FiltreVar) { <a class="link" href="/tarife-aktar">Temizle</a> }
</form>

<p class="muted small">@_rows.Count satır@(FiltreVar ? " (filtreli)" : "") ·
    @_rows.Count(r => r.OnayDurumu == TariffApprovalStatus.Bekliyor) bekleyen ·
    @_rows.Count(r => r.OnayDurumu == TariffApprovalStatus.Onayli) onaylı</p>

@if (!string.IsNullOrWhiteSpace(Kanal))
{
    @* ADVERSARIAL M1: silme ŞUBE kırılımı tanımaz — kanalın TÜM şubelerini siler. Şube (veya
       "Bekliyor" dışı onay) filtresi açıkken buton GİZLENİR; aksi hâlde kullanıcı "ekranda
       gördüğümü siliyorum" sanırken hiç görmediği satırlar da giderdi. *@
    @if (SilmeKutusuGorunur)
    {
        <div class="vt-box warn" style="margin:0 0 1rem;padding:.6rem .9rem;">
            <form method="post" action="/tarife-aktar/kanal-sil"
                  data-confirm="@($"'{Kanal}' kaynağının TÜM ŞUBELERİNDEKİ {_silinecek} BEKLEYEN tarife satırı silinecek. Onaylı satırlar SİLİNMEZ. Devam edilsin mi?")">
                <AntiforgeryToken />
                <input type="hidden" name="kanal" value="@Kanal" />
                <button type="submit" class="link danger" disabled="@(_silinecek == 0)">
                    Sadece Seçili Rezervasyon Kaynağını Sil (@_silinecek bekleyen satır)
                </button>
            </form>
            <p class="muted small" style="margin:.4rem 0 0;">Bu işlem <strong>yalnız Bekliyor</strong>
                durumundaki satırları ve <strong>bu kanalın tüm şubelerini</strong> kapsar — ekrandaki
                şube filtresine bakmaz. Fiyat motoru yalnız <strong>onaylı</strong> tarifeleri
                kullandığı için o an bir kirada/rezervasyonda kullanılan tarife bu yolla kaybolamaz.</p>
        </div>
    }
    else
    {
        <p class="muted small"><strong>Toplu silme gizlendi:</strong> silme kanalın
            <em>tüm şubelerindeki bekleyen</em> satırlarını kapsar, ekrandaki şube/onay filtresine
            uymaz. Yanlışlıkla görünmeyen satırları silmemek için önce
            <a href="@($"/tarife-aktar?kanal={Uri.EscapeDataString(Kanal!)}")">yalnız kanal filtresine</a> dönün.</p>
    }
}

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Kod</th><th>Ad</th><th>Kanal</th><th>Şube</th><th>Araç Grubu</th>
        <th>Başlangıç</th><th>Bitiş</th><th class="num">Gün 1</th><th class="num">Gün 7</th>
        <th>Para</th><th>Onay</th><th>Durum</th></tr></thead>
    <tbody>
        @if (_rows.Count == 0)
        {
            <tr><td colspan="12" class="muted">@(FiltreVar ? "Filtreye uyan tarife satırı yok." : "Henüz tarife satırı yok.")</td></tr>
        }
        @foreach (var r in _rows)
        {
            <tr>
                <td class="mono">@r.Kod</td>
                <td>@r.Ad</td>
                <td>@(r.Kanal ?? "—")</td>
                <td>@(r.Sube ?? "—")</td>
                <td>@(r.AracGrupKod ?? "—")</td>
                <td>@Tarih(r.BasTar)</td>
                <td>@Tarih(r.BitTar)</td>
                <td class="num">@Para(r.Gun1)</td>
                <td class="num">@Para(r.Gun7)</td>
                <td>@(r.ParaBirimi ?? "—")</td>
                <td>
                    <span class="status-pill @(r.OnayDurumu == TariffApprovalStatus.Onayli ? "sp-success" : "sp-warn")">@r.OnayDurumu</span>
                </td>
                <td>@(r.Aktif ? "Aktif" : "Pasif")</td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "eklenen")] public int? Eklenen { get; set; }
    [SupplyParameterFromQuery(Name = "atlanan")] public int? Atlanan { get; set; }
    [SupplyParameterFromQuery(Name = "hatali")] public int? Hatali { get; set; }
    [SupplyParameterFromQuery(Name = "hatalar")] public string? Hatalar { get; set; }
    [SupplyParameterFromQuery(Name = "mesaj")] public string? Mesaj { get; set; }
    [SupplyParameterFromQuery(Name = "kanal")] public string? Kanal { get; set; }
    [SupplyParameterFromQuery(Name = "sube")] public string? Sube { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }

    private IReadOnlyList<RateMatrix> _rows = [];
    private string[] _kanallar = [];
    private string[] _subeler = [];
    private int _silinecek;

    private bool FiltreVar => !string.IsNullOrWhiteSpace(Kanal) || !string.IsNullOrWhiteSpace(Sube)
        || !string.IsNullOrWhiteSpace(Durum);

    /// <summary>Silme kutusu YALNIZ "kanal seçili, başka daraltma yok" hâlinde görünür — silme
    /// şube/onay filtresini tanımadığı için aksi hâlde ekran ile eylem ayrışırdı (adversarial M1).
    /// Onay filtresi "Bekliyor" ise ekran zaten tam olarak silinecek kümeyi gösterir → serbest.</summary>
    private bool SilmeKutusuGorunur => string.IsNullOrWhiteSpace(Sube)
        && (string.IsNullOrWhiteSpace(Durum) || Durum == nameof(TariffApprovalStatus.Bekliyor));

    private static string Tarih(DateTimeOffset? d) => d?.LocalDateTime.ToString("dd.MM.yyyy") ?? "—";
    private static string Para(decimal? v) => v is { } x ? x.ToString("N2") : "—";

    protected override async Task OnInitializedAsync()
    {
        var hepsi = await Tarifeler.ListAsync();

        // Seçenekler FİLTRESİZ listeden: filtrelenmişten türetilseydi bir seçimden sonra diğer
        // kanallar kaybolur ve filtre kendini kilitlerdi.
        _kanallar = hepsi.Select(r => r.Kanal).Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.CurrentCulture).ToArray();
        _subeler = hepsi.Select(r => r.Sube).Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.CurrentCulture).ToArray();

        // Eşleşme comparer'ı motorunkiyle (RowMatches) AYNI: OrdinalIgnoreCase.
        var q = hepsi.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(Kanal))
            q = q.Where(r => string.Equals(r.Kanal?.Trim(), Kanal.Trim(), StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(Sube))
            q = q.Where(r => string.Equals(r.Sube?.Trim(), Sube.Trim(), StringComparison.OrdinalIgnoreCase));
        if (Enum.TryParse<TariffApprovalStatus>(Durum, out var d))
            q = q.Where(r => r.OnayDurumu == d);
        _rows = q.OrderBy(r => r.Kod).ToList();

        // Silinecek sayı SERVİSİN yüklemiyle hesaplanır (RateMatrixService.SilmeAdayi) — ekran
        // ayrı bir sayım yazsaydı, kural değiştiğinde iki sayı sessizce ayrışır ve kullanıcı
        // yanlış sayıyı onaylardı. Yüklem SAF olduğu için ikinci bir DB okuması gerekmez:
        // filtresiz liste zaten elimizde (adversarial L4 — sayfa tek okuma yapar).
        _silinecek = hepsi.Count(r => RateMatrixService.DeletionCandidate(r, Kanal));
    }
}
