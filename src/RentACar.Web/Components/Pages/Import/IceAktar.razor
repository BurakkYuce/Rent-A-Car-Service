@page "/ice-aktar"
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Veri İçe Aktar — RentPro</PageTitle>

<div class="page-head"><h1>Veri İçe Aktar (Göç)</h1></div>

<p class="muted small">Mevcut sistemin (referans sistem) <strong>kendi Excel/CSV export'undan</strong> araç ve müşteri listesini bu
    sisteme aktarır. Kaynak: referans sistem'te ilgili liste ekranında "Excel'e Aktar" → dosyayı buraya yükle.
    Müşteri PII'sı (TC / ehliyet / pasaport) <strong>şifreli</strong> saklanır (düz metin veritabanına girmez);
    aynı plaka veya TC tekrarı <strong>atlanır</strong>. Yalnız Admin.</p>

@if (Tur is not null && (Eklenen is not null || Mesaj is not null))
{
    <div class="summary-strip" style="margin:1rem 0;">
        @if (Mesaj is not null)
        {
            <div class="cell"><div class="s-v">@Mesaj</div></div>
        }
        else
        {
            <div class="cell"><div class="s-k">@(Tur == "arac" ? "Araç" : "Müşteri")</div><div class="s-v">içe-aktarım</div></div>
            <div class="cell"><div class="s-k">Eklenen</div><div class="s-v">@Eklenen</div></div>
            <div class="cell"><div class="s-k">Atlanan (tekrar)</div><div class="s-v">@Atlanan</div></div>
            <div class="cell"><div class="s-k">Hatalı</div><div class="s-v">@(Hatali ?? 0)</div></div>
        }
    </div>
}

<div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;">
    <section>
        <h2>Araç Listesi</h2>
        <form method="post" action="/ice-aktar/arac" enctype="multipart/form-data"><AntiforgeryToken />
            <input type="file" name="dosya" accept=".xlsx,.xls,.csv" required />
            <button type="submit">Araçları Aktar</button>
        </form>
        <p class="muted small">Tanınan sütunlar (esnek eşleme): Plaka, Marka, Tip/Model, Grup, Segment, Renk,
            Model Yılı, Yakıt, Vites, KM, Şasi No, Motor No, Şube, SIPP, HGS, Araç Sahibi.</p>
    </section>
    <section>
        <h2>Müşteri Listesi</h2>
        <form method="post" action="/ice-aktar/cari" enctype="multipart/form-data"><AntiforgeryToken />
            <input type="file" name="dosya" accept=".xlsx,.xls,.csv" required />
            <button type="submit">Müşterileri Aktar</button>
        </form>
        <p class="muted small">Tanınan sütunlar: Ünvan / Ad Soyad, TC Kimlik, Vergi No / Dairesi, Telefon, E-posta,
            İl, İlçe, Adres, Ehliyet No, Pasaport. Bireysel/Kurumsal ayrımı Tip sütunundan ya da Ünvan/TC'den çıkarılır.</p>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tur")] public string? Tur { get; set; }
    [SupplyParameterFromQuery(Name = "eklenen")] public int? Eklenen { get; set; }
    [SupplyParameterFromQuery(Name = "atlanan")] public int? Atlanan { get; set; }
    [SupplyParameterFromQuery(Name = "hatali")] public int? Hatali { get; set; }
    [SupplyParameterFromQuery(Name = "mesaj")] public string? Mesaj { get; set; }
}
