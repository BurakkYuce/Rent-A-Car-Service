@page "/blog-yonetim/{Id:guid}/onizleme"
@attribute [Authorize(Roles = "Admin,Yonetici,Operator")]
@using RentACar.Application.Blog
@using RentACar.Application.Common
@inject BlogService Blog

@* TASLAK ÖNİZLEME — yazının siteye çıkınca nasıl görüneceğini, YAYINLAMADAN gösterir.

   Neden ERP içinde: taslak yazı halka açık sitede yok (ve olmamalı). Önizleme için siteye
   "gizli anahtarla erişim" açmak, yayın kapısına ikinci bir kapı eklemek olurdu.

   Neden ayrı bir ayrıştırıcı YAZILMADI: gövde burada da `IcerikMetni.Bloklar` ile çözülüyor —
   yani sitedeki KURALIN AYNISI. Önizlemeyi JS ile canlı yapmak ayrıştırma kuralını JavaScript'e
   KOPYALAMAK demekti; kural bir gün değişince biri düzelir diğeri kalırdı ve önizleme yalan
   söylemeye başlardı. Sunucuda tek kural, tek doğruluk. *@

<PageTitle>Önizleme — @(_post?.Baslik ?? "Yazı")</PageTitle>

<div class="page-head">
    <h1>Önizleme</h1>
    <div class="actions">
        <a href="/blog-yonetim">← Blog yazıları</a>
    </div>
</div>

@if (_post is null)
{
    <p class="muted">Yazı bulunamadı.</p>
}
else
{
    <p class="muted small">
        Bu, yazının halka açık sitede görüneceği hâlidir.
        Durum: <strong>@(_post.Durum == Domain.Entities.BlogPostDurum.Yayinda ? "Yayında" : "Taslak")</strong>.
        @if (_post.Durum != Domain.Entities.BlogPostDurum.Yayinda)
        {
            <text>Taslak yazılar sitede görünmez; yayına almadan kimse erişemez.</text>
        }
    </p>

    @* Arama sonucu künyesi — yazarın "SEO alanlarını doldurdum mu" sorusuna tek bakışta cevap. *@
    <div class="onizleme-kunye">
        <div><span class="muted small">Adres</span><div><code>/blog/@_post.Slug</code></div></div>
        <div><span class="muted small">Arama başlığı</span><div>@_post.AramaBasligi</div></div>
        <div>
            <span class="muted small">Arama açıklaması</span>
            <div>@(Aciklama ?? "(girilmedi — gövdeden türetilecek)")</div>
        </div>
        @if (_post.Kelimeler.Count > 0)
        {
            <div><span class="muted small">Anahtar kelimeler</span><div>@string.Join(" · ", _post.Kelimeler)</div></div>
        }
        @if (_post.AramaDisi)
        {
            <div><span class="badge warn">Aramaya kapalı</span> — yayında olsa bile arama motorlarına kapalı.</div>
        }
    </div>

    @* Sitedeki gövde düzeninin aynısı. CSS sınıfları ERP'nin kendi temasından; amaç birebir
       piksel kopya değil, YAPIYI (başlık hiyerarşisi, paragraf bölünmesi) doğru göstermek. *@
    <article class="onizleme-govde">
        <h2>@_post.Baslik</h2>
        @if (!string.IsNullOrWhiteSpace(_post.AltBaslik))
        {
            <p class="onizleme-alt">@_post.AltBaslik</p>
        }
        @foreach (var b in IcerikMetni.Bloklar(_post.Icerik))
        {
            @switch (b.Tur)
            {
                case IcerikMetni.BlokTuru.Baslik2: <h3>@b.Metin</h3> break;
                case IcerikMetni.BlokTuru.Baslik3: <h4>@b.Metin</h4> break;
                default: <p>@b.Metin</p> break;
            }
        }
    </article>

    @if (_post.Durum == Domain.Entities.BlogPostDurum.Yayinda)
    {
        <p class="muted small">Yazı yayında — sitedeki adresi: <code>/blog/@_post.Slug</code></p>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private BlogDetail? _post;

    /// <summary>Sitedeki meta açıklama önceliğinin AYNISI (MetaAciklama > Ozet > gövdeden).</summary>
    private string? Aciklama => _post is null ? null
        : !string.IsNullOrWhiteSpace(_post.MetaAciklama) ? _post.MetaAciklama
        : !string.IsNullOrWhiteSpace(_post.Ozet) ? _post.Ozet
        : IcerikMetni.Ozet(_post.Icerik);

    protected override async Task OnInitializedAsync()
    {
        // Yönetim tarafı: TASLAK dahil okur (public GetPublishedBySlugAsync taslağı gizler).
        var p = await Blog.GetAsync(Id);
        if (p is null) return;
        _post = new BlogDetail(p.Id, p.Baslik, p.Slug, p.Ozet, p.Icerik, p.Durum, p.YayinTarihi,
            p.KapakBytes is not null, p.AltBaslik, p.SeoBaslik, p.MetaAciklama, p.AnahtarKelimeler,
            p.Yazar, p.KapakAlt, p.AramaDisi);
    }
}
