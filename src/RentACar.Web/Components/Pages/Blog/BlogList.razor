@page "/blog-yonetim"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@inject BlogService Blog

<PageTitle>Blog — RentPro</PageTitle>

<div class="page-head"><h1>Blog Yazıları</h1><div class="actions"></div></div>
<p class="muted small">Halka açık sitenizde (<code>/blog</code>) yayınlanan yazılar. <strong>Taslak</strong>
    yazılar sitede GÖRÜNMEZ. İçerik düz metin olarak saklanır — boş satırla ayırdığınız her blok ayrı bir
    paragraf olarak basılır (HTML/script yazılamaz, güvenlik gereği kaçışlanır). Yazı bir kez yayınlandıktan
    sonra <strong>adresi (slug) değiştirilemez</strong> — mevcut linkler ve arama motoru kayıtları kırılmasın.</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_list.Count == 0)">
    <summary>+ Yeni Yazı</summary>
    <form method="post" action="/blog-yonetim/create" class="grid-form"><AntiforgeryToken />
        <label>Başlık<input name="baslik" required maxlength="200" /></label>
        <label>Adres (boş bırakılırsa başlıktan üretilir)<input name="slug" maxlength="200" placeholder="ornek-yazi-adresi" data-seo-slug /></label>
        <label>Özet (liste kartında görünür)<input name="ozet" maxlength="500" /></label>
        <label>Durum
            <select name="durum">
                <option value="Taslak" selected>Taslak</option>
                <option value="Yayinda">Yayında</option>
            </select>
        </label>
        <label class="full">İçerik<textarea name="icerik" required rows="10" maxlength="20000"></textarea></label>
        <div class="full"><IcerikYardimi /></div>
        <SeoAlanlari />
        <button type="submit">Oluştur</button>
    </form>
</details>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Başlık</th><th>Adres</th><th>Durum</th><th>SEO</th><th>Yayın</th><th>Kapak</th><th>İşlem</th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="7" class="muted">Henüz yazı yok.</td></tr>
        }
        @foreach (var p in _list)
        {
            <tr>
                <td>@p.Baslik</td>
                <td class="mono">@p.Slug</td>
                <td>@(p.Durum == BlogPostDurum.Yayinda ? "Yayında" : "Taslak")</td>
                @* SEO tamlık göstergesi: yazı yayına çıkmadan ÖNCE eksik alanı görmek, sonradan
                   "neden aramada çıkmıyor" diye aramaktan iyidir. Eksik alan yazıyı ENGELLEMEZ —
                   yalnız görünür kılar (hepsi opsiyonel, boşsa makul varsayılana düşüyor). *@
                <td>
                    @{ var eksik = SeoEksikler(_tam.GetValueOrDefault(p.Id)); }
                    @if (eksik.Count == 0)
                    {
                        <span class="badge ok">Tam</span>
                    }
                    else
                    {
                        <span class="badge warn" title="@string.Join(", ", eksik)">@eksik.Count eksik</span>
                    }
                </td>
                <td>@(p.YayinTarihi?.ToString("dd.MM.yyyy") ?? "—")</td>
                <td>@(p.KapakVar ? "Var" : "—")</td>
                <td>
                    <a class="link" href="/blog-yonetim/@p.Id/onizleme">Önizle</a>
                    <details>
                        <summary class="link">Düzenle</summary>
                        <form method="post" action="/blog-yonetim/update" class="grid-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@p.Id" />
                            <label>Başlık<input name="baslik" value="@p.Baslik" required maxlength="200" /></label>
                            @if (p.YayinTarihi is null)
                            {
                                <label>Adres<input name="slug" value="@p.Slug" maxlength="200" data-seo-slug /></label>
                            }
                            else
                            {
                                <label>Adres (yayınlandı — sabit)<input value="@p.Slug" readonly disabled data-seo-slug /></label>
                            }
                            <label>Özet<input name="ozet" value="@p.Ozet" maxlength="500" /></label>
                            <label>Durum
                                <select name="durum">
                                    <option value="Taslak" selected="@(p.Durum == BlogPostDurum.Taslak)">Taslak</option>
                                    <option value="Yayinda" selected="@(p.Durum == BlogPostDurum.Yayinda)">Yayında</option>
                                </select>
                            </label>
                            <label class="full">İçerik<textarea name="icerik" required rows="10" maxlength="20000">@_tam.GetValueOrDefault(p.Id)?.Icerik</textarea></label>
                            <div class="full"><IcerikYardimi /></div>
                            @* SEO alanları ANA formun İÇİNDE (ayrı <form> açılmaz — iç içe form geçersizdir
                               ve tarayıcı içteki alanları hiç göndermez). *@
                            <SeoAlanlari Post="_tam.GetValueOrDefault(p.Id)" />
                            <button type="submit">Kaydet</button>
                        </form>
                        <form method="post" action="/blog-yonetim/@p.Id/kapak" enctype="multipart/form-data" class="grid-form"><AntiforgeryToken />
                            <label>Kapak görseli (PNG/JPEG/WebP, ≤2 MB)<input name="kapak" type="file" accept="image/png,image/jpeg,image/webp" required /></label>
                            <button type="submit">Kapağı Yükle</button>
                        </form>
                        @if (p.KapakVar)
                        {
                            <img src="/blog-yonetim/@p.Id/kapak" alt="Kapak" style="max-width:200px" />
                            <form method="post" action="/blog-yonetim/@p.Id/kapak-sil"><AntiforgeryToken />
                                <button type="submit" class="link">Kapağı Kaldır</button>
                            </form>
                        }
                    </details>
                    <form method="post" action="/blog-yonetim/delete" data-confirm="Yazı silinsin mi?"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@p.Id" />
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private IReadOnlyList<BlogListItem> _list = [];
    // Liste projeksiyonu İçerik ve SEO alanlarını taşımaz (blob/uzun metin listeye girmesin) —
    // düzenleme formu için tam kayıt ayrı çekilir. Önceden yalnız İçerik saklanıyordu; SEO alanları
    // da forma prefill edileceği için kaydın TAMAMI tutuluyor (ek sorgu YOK, aynı GetAsync çağrısı).
    private Dictionary<Guid, BlogPost> _tam = [];

    /// <summary>
    /// Arama sonucunu doğrudan etkileyen, DOLDURULMAMIŞ alanlar. Yalnız GÖSTERGE — hiçbiri zorunlu
    /// değil ve eksiklik kaydı/yayını engellemez; amaç yazıyı yayına almadan önce "neyi atladım"
    /// sorusunu tek bakışta cevaplamak.
    ///
    /// Kapak yalnız yazıda görsel VARSA alt metni sorulur (olmayan görselin alt metni anlamsız).
    /// </summary>
    private static List<string> SeoEksikler(BlogPost? p)
    {
        if (p is null) return [];
        var eksik = new List<string>();
        if (string.IsNullOrWhiteSpace(p.SeoBaslik)) eksik.Add("Arama başlığı");
        if (string.IsNullOrWhiteSpace(p.MetaAciklama) && string.IsNullOrWhiteSpace(p.Ozet))
            eksik.Add("Arama açıklaması");
        if (string.IsNullOrWhiteSpace(p.AnahtarKelimeler)) eksik.Add("Anahtar kelimeler");
        if (p.KapakBytes is null) eksik.Add("Kapak görseli");
        else if (string.IsNullOrWhiteSpace(p.KapakAlt)) eksik.Add("Kapak alt metni");
        return eksik;
    }

    protected override async Task OnInitializedAsync()
    {
        _list = await Blog.ListAllAsync();
        _tam = [];
        foreach (var p in _list)
        {
            var full = await Blog.GetAsync(p.Id);
            if (full is not null) _tam[p.Id] = full;
        }
    }
}
