@* ============================================================================
   Blog SEO alanları + arama sonucu önizlemesi.

   NEDEN AYRI BİLEŞEN: aynı alan kümesi hem "Yeni Yazı" hem her satırın "Düzenle"
   formunda geçiyor. İki yere kopyalansaydı alan adları zamanla birbirinden
   kayardı (uca giden isim tek harf bile sapsa alan sessizce kaydedilmez).
   Burada TEK tanım var; POST ucu (BlogEndpoints.Build) bu adları okur.

   Bileşen KENDİ <form>'unu AÇMAZ — çağıran formun içine gömülür. İç içe <form>
   geçersiz HTML'dir (tarayıcı içtekini yok sayar, alanlar hiç gönderilmez).

   Alanların hepsi OPSİYONEL: boş bırakılan alan için sayfa mevcut davranışına
   düşer (servis Trim + boşsa null yapar).
   ============================================================================ *@

@* Post null = "Yeni Yazı" formu (henüz kaydedilmiş değer yok). *@
@{
    var seoBaslikUz = (Post?.SeoBaslik ?? string.Empty).Length;
    var metaUz = (Post?.MetaAciklama ?? string.Empty).Length;

    // Önizlemenin SUNUCUDAN basılan ilk hâli. JS yüklenmese de (ya da kapalıysa) kutu
    // DOLU gelir — kaydedilmiş değerlerle. JS varsa yazdıkça aynı kurallarla tazelenir.
    // Fallback zinciri PublicSite/BlogYaziDetay.razor ile BİREBİR aynı sırada tutulur:
    // yazarın meta açıklaması > kart özeti > gövdeden türetilen özet.
    var onizBaslik = Bos(Post?.SeoBaslik) ?? Bos(Post?.Baslik) ?? "(başlık yok)";
    var onizAciklama = Bos(Post?.MetaAciklama) ?? Bos(Post?.Ozet) ?? ContentText.Summary(Post?.Icerik)
        ?? "(açıklama yok — arama motoru sayfadan rastgele bir cümle seçer)";
    var onizAdres = "siteniz.com/blog/" + (Bos(Post?.Slug) ?? "yazi-adresi");
}

<fieldset class="seo-alanlar u-col-full" data-seo>
    <legend>SEO — arama motorunda görünüm</legend>
    <p class="muted small u-col-full">Bu alanların <strong>hepsi opsiyoneldir</strong>. Boş bıraktığınız her alan için
        sayfa mevcut davranışını sürdürür; hiçbirini doldurmasanız da yazı yayınlanır.</p>

    <label class="u-col-full">Alt başlık
        <input name="altBaslik" value="@Post?.AltBaslik" maxlength="300" placeholder="Başlığı tamamlayan tek cümle" />
        <span class="seo-yardim">Yazının başlığının hemen altında görünür. Arama açıklaması <em>değildir</em>.
            Boşsa hiç basılmaz.</span>
    </label>

    <label class="u-col-full">SEO başlığı
        @* maxlength BİLEREK tavsiye sınırından (70) BÜYÜK: sınır aşılabilmeli ki uyarı bir anlam
           taşısın. Buradaki 300 veritabanı kolon sınırıdır (gerçek sınır), 70 ise tavsiyedir. *@
        <input name="seoBaslik" value="@Post?.SeoBaslik" maxlength="300"
               data-seo-alan="seoBaslik" placeholder="Aramada görünecek başlık" />
        <span class="seo-yardim">Arama sonucunda görünen başlık. Boşsa yazının başlığı kullanılır.
            <span data-seo-sayac="seoBaslik" data-seo-limit="@BlogService.MaxSeoTitle"
                  class="@(seoBaslikUz > BlogService.MaxSeoTitle ? "seo-sayac uyari" : "seo-sayac")">@seoBaslikUz / @BlogService.MaxSeoTitle</span>
        </span>
    </label>

    <label class="u-col-full">Meta açıklama
        <textarea name="metaAciklama" rows="2" maxlength="500"
                  data-seo-alan="metaAciklama" placeholder="Aramada başlığın altında görünecek açıklama">@Post?.MetaAciklama</textarea>
        <span class="seo-yardim">Arama sonucunda başlığın altındaki açıklama. Boşsa özet, o da yoksa yazının
            ilk cümleleri kullanılır.
            <span data-seo-sayac="metaAciklama" data-seo-limit="@BlogService.MaxMetaDescription"
                  class="@(metaUz > BlogService.MaxMetaDescription ? "seo-sayac uyari" : "seo-sayac")">@metaUz / @BlogService.MaxMetaDescription</span>
        </span>
    </label>

    <label class="u-col-full">Anahtar kelimeler
        <input name="anahtarKelimeler" value="@Post?.AnahtarKelimeler" maxlength="500"
               placeholder="antalya, uzun dönem, kiralama" />
        <span class="seo-yardim">Virgülle ayırın. Tekrarlar ve boşluklar temizlenir. Sıralama vaadi yoktur —
            konu etiketi olarak sayfada ve yapısal veride kullanılır. Boşsa hiç basılmaz.</span>
    </label>

    <label>Yazar
        <input name="yazar" value="@Post?.Yazar" maxlength="160" placeholder="Ad Soyad" />
        <span class="seo-yardim">Yazının künyesinde görünür. Boşsa künye satırı basılmaz.</span>
    </label>

    <label>Kapak görseli alternatif metni
        <input name="kapakAlt" value="@Post?.KapakAlt" maxlength="300" placeholder="Görselde ne var?" />
        <span class="seo-yardim">Görsel yüklenemediğinde ve ekran okuyucuda okunur. Boşsa yazının başlığı kullanılır.</span>
    </label>

    @* Checkbox işaretsizken TARAYICI HİÇ GÖNDERMEZ → uçta ContainsKey ile okunur (değer değil varlık). *@
    <label class="check u-col-full">
        <input type="checkbox" name="aramaDisi" value="true" checked="@(Post?.AramaDisi == true)" />
        Aramaya kapat
    </label>
    <span class="seo-yardim u-col-full">İşaretlenirse yazı yayında kalır ama arama motorlarına "noindex" der ve
        site haritasına girmez. Kampanya/iç duyuru yazıları için.</span>

    @* ---- Arama sonucu önizlemesi ----
       Sunucudan dolu basılır; rc-blog-seo.js varsa yazdıkça tazelenir (ilerici zenginleştirme). *@
    <div class="seo-onizleme u-col-full">
        <span class="muted small">Arama sonucunda böyle görünür (yaklaşık):</span>
        <div class="serp">
            <div class="serp-adres" data-seo-oniz="adres">@onizAdres</div>
            <div class="serp-baslik" data-seo-oniz="baslik">@onizBaslik</div>
            <div class="serp-aciklama" data-seo-oniz="aciklama">@onizAciklama</div>
        </div>
        <span class="muted small">Adres örnektir; gerçek alan adınız halka açık site ayarlarınızdan gelir.
            Yazı adresi (slug) yayınlandıktan sonra değişmez.</span>
    </div>
</fieldset>

@code {
    /// <summary>Düzenlenen yazı; "Yeni Yazı" formunda <c>null</c>.</summary>
    [Parameter] public BlogPost? Post { get; set; }

    private static string? Bos(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
}
