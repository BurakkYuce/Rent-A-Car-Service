@page "/login"
@attribute [AllowAnonymous]
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject NavigationManager Nav

<PageTitle>Giriş — RentPro</PageTitle>

<div class="login-card">
    <h1>RentPro</h1>
    <p class="muted">Firma ve kullanıcı bilgilerinizle giriş yapın.</p>

    @if (HasError)
    {
        <p class="error">Firma, kullanıcı veya şifre hatalı.</p>
    }
    @if (RateLimited)
    {
        <p class="error">Çok fazla giriş denemesi yapıldı. Lütfen bir dakika bekleyip yeniden deneyin.</p>
    }
    @if (Kapali)
    {
        <p class="error">Firmanızın erişimi kapatıldı. Lütfen yöneticinizle iletişime geçin.</p>
    }

    @* Seed firma/kullanıcı ön-doldurma YALNIZ Development'ta. Parola ASLA ön-doldurulmaz (repoda sabit parola yok). *@
    <form method="post" action="/auth/login"><AntiforgeryToken />
        @* Oturum düşmüşken açılan derin bağlantı (?ReturnUrl=) girişten sonra geri açılsın diye forma
           taşınır. Yalnız GuvenliDonus'tan geçmiş değer basılır; uç yine de kendisi doğrular. *@
        @if (Donus != RentACar.Web.Identity.YetkiYonlendirme.Varsayilan)
        {
            <input type="hidden" name="@RentACar.Web.Identity.YetkiYonlendirme.DonusParametresi" value="@Donus" />
        }
        <label>Firma
            <input name="firma" value="@(Env.IsDevelopment() ? "yucerent" : "")" autocomplete="off" />
        </label>
        <label>Kullanıcı
            <input name="kullanici" value="@(Env.IsDevelopment() ? "umit" : "")" autocomplete="off" />
        </label>
        <label>Şifre
            <input name="sifre" type="password" />
        </label>
        <button type="submit">Giriş</button>
    </form>
    @if (Env.IsDevelopment())
    {
        <p class="muted small">Seed: firma <code>yucerent</code> / <code>demo</code>, kullanıcı <code>umit</code> / <code>operator</code>.
            Parola: <code>Seed:Parola</code> (user-secret) ya da ilk kurulumun açılış logundaki
            <code>Seed kullanıcı parolası</code> WARNING satırı.</p>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")]
    public string? Hata { get; set; }

    // Çerez şemasının 401 yönlendirmesinin yazdığı dönüş adresi (YetkiYonlendirme.GirisYonlendirmesi).
    [SupplyParameterFromQuery(Name = RentACar.Web.Identity.YetkiYonlendirme.DonusParametresi)]
    public string? ReturnUrl { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool HasError => Hata == "1";
    private bool RateLimited => Hata == "limit";
    private bool Kapali => Hata == "kapali";

    // Güvenli değilse (başka alan adı, /login döngüsü, platform alanı…) "/" — gizli alan hiç basılmaz.
    private string Donus => RentACar.Web.Identity.YetkiYonlendirme.GuvenliDonus(ReturnUrl);

    protected override async Task OnInitializedAsync()
    {
        // Zaten giriş yapmış kullanıcı login sayfasını GÖRMEZ (aksi halde tenant kabuğu + login formu
        // üst üste biner). Uygulamaya yönlendir: platform operatörü → konsol, tenant kullanıcısı →
        // güvenli dönüş adresi varsa oraya (ör. başka sekmede giriş yapıp bu sekmeyi yenileyen
        // kullanıcı), yoksa Panel. Döngü yok: GuvenliDonus /login'i reddeder; girişli kullanıcıya 401
        // (dolayısıyla yeniden /login) üretilmez, yetkisiz hedef /yetkisiz'e gider.
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            if (user.Identity?.IsAuthenticated == true)
                Nav.NavigateTo(user.HasClaim("platform_admin", "true") ? "/platform/tenants" : Donus);
        }
    }
}
