@page "/hesaplar"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@inject FinancialAccountService Hesaplar
@inject BranchService Subeler

<PageTitle>Hesaplar — RentPro</PageTitle>

<div class="page-head"><h1>Kasa/Banka Hesap Tanımları</h1><div class="actions"></div></div>
<p class="muted small">Nakit kasaları ve banka hesapları (ör. "Merkez Kasa", "Ziraat TL").
    Tahsilat/ödeme/virman formlarındaki Hesap açılır listesini besler. Tür (Kasa/Banka) ve Döviz opsiyonel.</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_list.Count == 0)">
    <summary>+ Yeni Hesap</summary>
    <form method="post" action="/hesaplar/create" class="grid-form"><AntiforgeryToken />
        <label>Kod<input name="kod" required placeholder="KASA-MERKEZ" /></label>
        <label>Ad<input name="ad" required placeholder="Merkez Kasa" /></label>
        @* FAZ-50 adversarial H1 — tür ZORUNLU: serbest metin bırakıldığında aynı hesap hem Kasa
           hem Banka bacağında kullanılabiliyor ve bakiyesi ikiye bölünüyordu. *@
        <label>Tür<select name="tur" required>
            <option value="">Seçiniz</option><option value="Kasa">Kasa</option><option value="Banka">Banka</option>
        </select></label>
        <label>Döviz<input name="doviz" maxlength="3" placeholder="TRY" /></label>
        <label>IBAN<input name="iban" maxlength="34" placeholder="TR.. (banka için)" /></label>
        <label>Hesap No<input name="hesapNo" placeholder="(opsiyonel)" /></label>
        <label>Banka<input name="banka" placeholder="(opsiyonel)" /></label>
        <ComboBox Name="sube" Label="Şube" Options="_branchOpts" Placeholder="(opsiyonel)" />
        <label>Özel Kod<input name="ozelKod" maxlength="32" /></label>
        <label>Uyarı Mail Listesi<input name="uyariMailListesi" maxlength="512" placeholder="a@firma.com, b@firma.com" title="Yalnız kayıt alanı — bu sürümde otomatik gönderim yok" /></label>
        @* Varsayılan false olduğu için gizli "false" alanı GEREKMEZ: işaretsiz checkbox hiç
           gönderilmez → parametre null → false. (Gizli alan eklenseydi iki değer tek [FromForm]
           string parametresine bağlanır ve "true" hiç okunamazdı.) *@
        <label class="chk"><input type="checkbox" name="hediyeCek" value="true" /> Hediye çeki hesabı</label>
        <button type="submit">Oluştur</button>
    </form>
</details>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Kod</th><th>Ad</th><th>Tür</th><th>Döviz</th><th>IBAN</th><th>Banka</th><th>Şube</th><th>Özel Kod</th><th>Hediye Çeki</th><th>Uyarı Mail</th><th>Durum</th><th>İşlem</th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="12" class="muted">Hesap tanımlı değil.</td></tr>
        }
        @foreach (var a in _list)
        {
            <tr>
                <td class="mono">@a.Kod</td>
                <td>@a.Ad</td>
                <td>@a.Tur</td>
                <td class="mono">@a.Doviz</td>
                <td class="mono">@a.Iban</td>
                <td>@a.Banka</td>
                <td>@a.Sube</td>
                <td class="mono">@(a.OzelKod ?? "—")</td>
                <td>@(a.HediyeCek ? "Evet" : "—")</td>
                <td>@(a.UyariMailListesi ?? "—")</td>
                <td>@(a.Aktif ? "Aktif" : "Pasif")</td>
                <td>
                    <details>
                        <summary class="link">Düzenle</summary>
                        <form method="post" action="/hesaplar/update" class="grid-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@a.Id" />
                            <label>Kod<input name="kod" value="@a.Kod" required /></label>
                            <label>Ad<input name="ad" value="@a.Ad" required /></label>
                            @* FAZ-50 adversarial H1 — tür ZORUNLU. Mevcut kayıtta serbest metin
                               ("POS" gibi) varsa çözülemez ve "Seçiniz" görünür: kullanıcı
                               kaydetmeden önce Kasa/Banka seçmek zorunda kalır. *@
                            <label>Tür<select name="tur" required>
                                <option value="" selected="@(TypeLabel(a.Tur) is null)">Seçiniz</option>
                                <option value="Kasa" selected="@(TypeLabel(a.Tur) == LedgerAccountType.Kasa)">Kasa</option>
                                <option value="Banka" selected="@(TypeLabel(a.Tur) == LedgerAccountType.Banka)">Banka</option>
                            </select></label>
                            <label>Döviz<input name="doviz" value="@a.Doviz" maxlength="3" /></label>
                            <label>IBAN<input name="iban" value="@a.Iban" maxlength="34" /></label>
                            <label>Hesap No<input name="hesapNo" value="@a.HesapNo" /></label>
                            <label>Banka<input name="banka" value="@a.Banka" /></label>
                            <ComboBox Name="sube" Label="Şube" Value="@a.Sube" Options="_branchOpts" ListId="dl-sube-edit" />
                            <label>Özel Kod<input name="ozelKod" maxlength="32" value="@a.OzelKod" /></label>
                            <label>Uyarı Mail Listesi<input name="uyariMailListesi" maxlength="512" value="@a.UyariMailListesi" /></label>
                            <label class="chk"><input type="checkbox" name="hediyeCek" value="true" checked="@a.HediyeCek" /> Hediye çeki hesabı</label>
                            <label>Durum
                                <select name="aktif">
                                    <option value="true" selected="@a.Aktif">Aktif</option>
                                    <option value="false" selected="@(!a.Aktif)">Pasif</option>
                                </select>
                            </label>
                            <button type="submit">Kaydet</button>
                        </form>
                    </details>
                    <form method="post" action="/hesaplar/delete" data-confirm="Hesap silinsin mi?"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@a.Id" />
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    /// <summary>Serbest metin türü Kasa/Banka'ya çözer (servisle AYNI kural — HesapCozucu.TuruCoz).</summary>
    private static LedgerAccountType? TypeLabel(string? t) => AccountResolver.ResolveType(t);

    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private IReadOnlyList<FinancialAccount> _list = [];
    private List<string> _branchOpts = [];

    protected override async Task OnInitializedAsync()
    {
        _list = await Hesaplar.ListAsync();
        _branchOpts = (await Subeler.ListActiveAsync()).Select(s => s.Ad).ToList();
    }
}
