@page "/giderler"
@attribute [Authorize]
@inject RentalService Rentals
@inject AuthenticationStateProvider AuthState
@inject ExpenseService Expenses
@inject VehicleService Vehicles
@inject CustomerService Customers
@inject RentACar.Application.Branches.BranchService Subeler

<PageTitle>Giderler — RentPro</PageTitle>

<div class="page-head"><h1>Giderler</h1><div class="actions"><a href="/listeler/export/giderler?@Qs("excel")">Excel</a> · <a href="/listeler/export/giderler?@Qs("csv")">CSV</a> · <a href="/listeler/export/giderler?@Qs("pdf")">PDF</a></div></div>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_list.Count == 0)">
    <summary>+ Yeni Gider</summary>
    <form method="post" action="/giderler/create" class="grid-form"><AntiforgeryToken />
        <label>Tür
            <select name="tip">
                @foreach (var t in Enum.GetValues<ExpenseType>())
                {
                    <option value="@t">@t</option>
                }
            </select>
        </label>
        <label>Araç
            <select name="vehicleId">
                <option value="">—</option>
                @foreach (var v in _vehicles)
                {
                    <option value="@v.Id">@v.Plaka</option>
                }
            </select>
        </label>
        <label>Tedarikçi
            <select name="cariId">
                <option value="">—</option>
                @foreach (var c in _customers)
                {
                    <option value="@c.Id">@c.DisplayName</option>
                }
            </select>
        </label>
        <label>Net Tutar<input name="netTutar" type="number" step="0.01" required /></label>
        <label>KDV Oranı<input name="kdvOrani" type="number" step="0.01" value="0.20" /></label>
        <label>Ödeme
            <select name="odemeYontemi">
                @foreach (var o in Enum.GetValues<PaymentMethod>())
                {
                    <option value="@o">@o</option>
                }
            </select>
        </label>
        <label>Döviz<select name="doviz"><option>TRY</option><option>USD</option><option>EUR</option></select></label>
        <label>Kur<input name="kur" type="number" step="0.0001" placeholder="boş = otomatik" title="Boş: TRY=1, dövizde sabit kur/TCMB otomatik" /></label>
        @* FAZ-50 adversarial H2 — uç `hesapId`'yi zaten okuyordu ama form ALANI YOKTU: her gider
           "hesap belirtilmemiş" kovasına düşüyordu. Açık hesapta nakit bacağı olmadığı için
           seçim yalnız belge notu olarak kalır. *@
        <HesapSecici />
        @* FAZ-64 bilgi alanları — deftere GİRMEZ. Gider belgesi DB-DEĞİŞMEZ olduğu için bu
           alanlar yalnız kayıt anında yazılır; düzeltme ters kayıtla yapılır. *@
        <label>Ödeme Tarihi<input name="odemeTarihi" type="date" title="Belge tarihinden ayrı ödeme tarihi (bilgi)" /></label>
        <label>Hazır Açıklama
            <input name="hazirAciklama" list="dl-gider-sablon" autocomplete="off" placeholder="Seç veya yaz" />
        </label>
        <datalist id="dl-gider-sablon">
            @foreach (var t in PresetDescriptions) { <option value="@t" /> }
        </datalist>
        <label>Sözleşme
            <select name="rentalId">
                <option value="">— yok —</option>
                @foreach (var r in _rentals) { <option value="@r.Id">@r.SozlesmeNo — @r.Plaka</option> }
            </select>
        </label>
        <ComboBox Name="sube" Label="Şube" Options="_branchOpts" Placeholder="(opsiyonel)" />
        <label>Evrak No<input name="evrakNo" /></label>
        <label>Açıklama<input name="aciklama" /></label>
        <button type="submit">Kaydet</button>
    </form>
</details>

@* Arama paneli (canlı gider_ara.aspx karşılığı). GET formu: JS yok, URL paylaşılabilir.
   Filtreleme SUNUCUDA/SQL'de — liste büyüdükçe bellek-içi süzmek pahalıya gelirdi. *@
<form method="get" class="filter-bar">
    <label>Ara<input name="ara" value="@Ara" placeholder="gider no / evrak no / açıklama" /></label>
    <label>Plaka<input name="plaka" value="@Plaka" placeholder="34 AB" /></label>
    <label>Tedarikçi
        <select name="cariId">
            <option value="">— tümü —</option>
            @foreach (var c in _customers)
            {
                <option value="@c.Id" selected="@(c.Id.ToString() == CariId)">@c.DisplayName</option>
            }
        </select>
    </label>
    <label>Gider Türü
        <select name="tip">
            <option value="">— tümü —</option>
            @foreach (var t in Enum.GetValues<ExpenseType>())
            {
                <option value="@t" selected="@(t.ToString() == Tip)">@t</option>
            }
        </select>
    </label>
    <label>Ofis / Şube
        <select name="sube">
            <option value="">— tümü —</option>
            @foreach (var s in _branchOpts)
            {
                <option value="@s" selected="@(s == Sube)">@s</option>
            }
        </select>
    </label>
    <label>Tarih Baş<input name="bas" type="date" value="@Bas" /></label>
    <label>Tarih Bit<input name="bit" type="date" value="@Bit" /></label>
    <button type="submit">Ara</button>
    @if (FiltreVar)
    {
        <a class="link" href="/giderler">Temizle</a>
    }
</form>

<p class="muted small">@_list.Count gider · Net @_list.Sum(e => e.NetTutar).ToString("N2")
    · KDV @_list.Sum(e => e.KdvTutar).ToString("N2") · Toplam @_list.Sum(e => e.GenelToplam).ToString("N2")</p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead>
        <tr><th>No</th><th>Tür</th><th>Tarih</th><th>Ödeme Tar.</th><th>Araç/Tedarikçi</th><th>Sözleşme</th><th>Şube</th><th>Evrak No</th><th>Açıklama</th><th class="num">Net</th><th class="num">KDV</th><th class="num">Toplam</th><th>Ödeme</th><th class="num">Ödenen</th><th class="num">Kalan</th><th></th></tr>
    </thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="16" class="muted">@(FiltreVar ? "Aramaya uyan gider yok." : "Gider yok.")</td></tr>
        }
        @foreach (var e in _list)
        {
            <tr>
                <td>@e.No</td>
                <td>@e.Tip</td>
                <td>@e.Tarih.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td>@(e.OdemeTarihi is { } ot ? ot.LocalDateTime.ToString("dd.MM.yyyy") : "—")</td>
                <td>@RefLabel(e)</td>
                <td>@(e.RentalId is { } rid && _rentalMap.TryGetValue(rid, out var sno) ? sno : "—")</td>
                <td>@(e.Sube ?? "—")</td>
                <td>@(e.EvrakNo ?? "—")</td>
                <td>@(e.Aciklama ?? e.HazirAciklama ?? "—")</td>
                <td class="num">@e.NetTutar.ToString("N2")</td>
                <td class="num">@e.KdvTutar.ToString("N2")</td>
                <td class="num">@e.GenelToplam.ToString("N2")</td>
                <td>@e.OdemeYontemi</td>
                @* FAZ-64 — Ödenen/Kalan YALNIZ açık hesap giderinde anlamlı: nakit/banka giderinde
                   para kayıt anında çıktı (defter öyle yazıldı), borç yok. *@
                @{ var d = _statuses.GetValueOrDefault(e.Id); }
                <td class="num">@(d is null ? "—" : d.Odenen.ToString("N2"))</td>
                <td class="num @(d is { TakipEdilir: true, Kalan: > 0 } ? "neg" : null)">
                    @(d is null ? "—" : d.TakipEdilir ? d.Kalan.ToString("N2") : "—")</td>
                <td class="row-actions">
                    @if (d is { TakipEdilir: true, Kalan: > 0 } && FinansYetkili)
                    {
                        <form method="post" action="/giderler/odeme" class="kf-inline"><AntiforgeryToken />
                            <input type="hidden" name="expenseId" value="@e.Id" />
                            <input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />
                            <input name="tutar" type="number" step="0.01" min="0.01"
                                   max="@d.Kalan.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   placeholder="@d.Kalan.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                   title="Boş = kalanın tamamı" class="u-w-auto" />
                            <input name="makbuzNo" placeholder="Makbuz" maxlength="32" class="u-w-auto" />
                            <button class="link" type="submit"
                                    data-confirm="Bu gider için ödeme kaydedilecek (TAKİP — deftere yazılmaz). Devam?">Öde</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "ara")] public string? Ara { get; set; }
    [SupplyParameterFromQuery(Name = "plaka")] public string? Plaka { get; set; }
    [SupplyParameterFromQuery(Name = "cariId")] public string? CariId { get; set; }
    [SupplyParameterFromQuery(Name = "tip")] public string? Tip { get; set; }
    [SupplyParameterFromQuery(Name = "sube")] public string? Sube { get; set; }
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }

    private IReadOnlyList<Expense> _list = [];
    private IReadOnlyList<Vehicle> _vehicles = [];
    private IReadOnlyList<Customer> _customers = [];
    private IReadOnlyList<string> _branchOpts = [];
    private Dictionary<Guid, string> _vehMap = new();
    private Dictionary<Guid, string> _custMap = new();
    private IReadOnlyList<RentalRow> _rentals = [];
    private Dictionary<Guid, string> _rentalMap = new();
    private Dictionary<Guid, GiderOdemeDurumu> _statuses = new();

    /// <summary>Ödeme kaydı FinanceWrite ister; operatöre buton gösterilmez (sunucu ayrıca zorlar).</summary>
    private bool FinansYetkili { get; set; }

    /// <summary>Sık kullanılan gider açıklamaları (canlı "Hazır Açıklama" listesi karşılığı).</summary>
    private static readonly string[] PresetDescriptions =
    [
        "Yakıt", "Otopark", "Köprü/Otoyol", "Temizlik", "Lastik", "Periyodik bakım",
        "Sigorta", "Vergi/Harç", "Kira", "Personel", "Kırtasiye", "Diğer"
    ];

    private bool FiltreVar => !string.IsNullOrWhiteSpace(Ara) || !string.IsNullOrWhiteSpace(Plaka)
        || !string.IsNullOrWhiteSpace(CariId) || !string.IsNullOrWhiteSpace(Tip)
        || !string.IsNullOrWhiteSpace(Sube) || !string.IsNullOrWhiteSpace(Bas) || !string.IsNullOrWhiteSpace(Bit);

    protected override async Task OnInitializedAsync()
    {
        _vehicles = await Vehicles.ListAsync();
        _customers = await Customers.ListAsync();
        _branchOpts = (await Subeler.ListActiveAsync()).Select(s => s.Ad).ToList();
        _vehMap = _vehicles.ToDictionary(v => v.Id, v => v.Plaka);
        _custMap = _customers.ToDictionary(c => c.Id, c => c.DisplayName);

        _list = await Expenses.ListAsync(new ExpenseFilter
        {
            Ara = Ara,
            Plaka = Plaka,
            CariId = Guid.TryParse(CariId, out var cid) ? cid : null,
            Tip = Enum.TryParse<ExpenseType>(Tip, out var t) ? t : null,
            Sube = Sube,
            Bas = Date(Bas),
            // Üst sınır GÜN SONUNA genişletilir: tarih girişi 00:00'a düşüyor, aksi hâlde
            // "bit" günündeki giderler dışarıda kalırdı.
            Bit = Date(Bit)?.AddDays(1).AddTicks(-1)
        });

        // FAZ-64: ödeme durumları TEK sorguda (satır başına sorgu değil).
        _statuses = await Expenses.PaymentStatusesAsync(_list);
        _rentals = await Rentals.SearchAsync(new RentalFilter());
        _rentalMap = _rentals.ToDictionary(r => r.Id, r => r.SozlesmeNo);

        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        FinansYetkili = user.IsInRole("Admin") || user.IsInRole("Yonetici") || user.IsInRole("Muhasebe");
    }

    private static DateTimeOffset? Date(string? s)
        => DateTimeOffset.TryParse(s, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? d.ToUniversalTime() : null;

    /// <summary>Aramayı export bağlantılarına aynen taşır (ekranda gördüğün = indirdiğin).</summary>
    private string Qs(string format)
    {
        var p = new List<string> { "format=" + format };
        void Add(string name, string? value)
        {
            if (!string.IsNullOrWhiteSpace(value)) p.Add($"{name}={Uri.EscapeDataString(value)}");
        }
        Add("ara", Ara); Add("plaka", Plaka); Add("cariId", CariId);
        Add("tip", Tip); Add("sube", Sube); Add("bas", Bas); Add("bit", Bit);
        return string.Join("&", p);
    }

    private string RefLabel(Expense e)
    {
        if (e.VehicleId is Guid v && _vehMap.TryGetValue(v, out var p)) return p;
        if (e.CariId is Guid c && _custMap.TryGetValue(c, out var n)) return n;
        return "—";
    }
}
