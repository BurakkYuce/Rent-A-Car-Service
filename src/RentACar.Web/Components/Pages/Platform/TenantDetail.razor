@page "/platform/tenants/{Id:guid}"
@attribute [Authorize(Policy = "PlatformAdmin")]
@layout PlatformLayout
@inject PlatformAdminService Platform

<PageTitle>Tenant Detayı — Platform</PageTitle>

@if (_d is null)
{
    <div class="page-head"><h1>Tenant Detayı</h1></div>
    <p class="error">Tenant bulunamadı.</p>
    <p><a class="link" href="/platform/tenants">← Konsola dön</a></p>
}
else
{
    <div class="page-head">
        <h1>@_d.Name <span class="mono muted">(@_d.Code)</span></h1>
        <div class="actions"><a href="/platform/tenants">← Konsol</a></div>
    </div>

    @if (Ok == "1") { <p class="ok">İşlem tamamlandı.</p> }
    @if (Hata == "onay") { <p class="error">Onay kodu uyuşmadı — firma KAPATILMADI. Kapatmak için firma kodunu aynen yazın.</p> }
    else if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }

    <p>
        @* rozet önceliği: Kapalı damgası IsActive'den bağımsız kazanır *@
        <span class="status-pill @(_d.Durum switch { "Kapalı" => "sp-danger", "Aktif" => "sp-success", _ => "sp-warn" })">@_d.Durum</span>
        @if (_d.KapanisTarihiUtc is { } kt) { <span class="muted small"> — kapanış: @kt.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</span> }
        <span class="muted small"> · oluşturma: @_d.CreatedAtUtc.LocalDateTime.ToString("dd.MM.yyyy")</span>
        @if (_d.UpdatedAtUtc is { } ut) { <span class="muted small"> · güncelleme: @ut.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</span> }
    </p>

    @* ---- Metrikler (owner cross-tenant sayımları) ---- *@
    <div class="cards">
        <div class="card"><div class="card-num">@_d.UserCount</div><div class="card-label">Kullanıcı</div></div>
        <div class="card"><div class="card-num">@_d.AracSayisi</div><div class="card-label">Araç</div></div>
        <div class="card"><div class="card-num">@_d.AktifKira / @_d.ToplamKira</div><div class="card-label">Aktif / Toplam Kira</div></div>
        <div class="card"><div class="card-num">@_d.Gelir30Gun.ToString("N0")</div><div class="card-label">Son 30 Gün Gelir ₺ (defter)</div></div>
    </div>
    <p class="muted small">Son giriş: <strong>@(_d.SonGiris?.LocalDateTime.ToString("dd.MM.yyyy HH:mm") ?? "—")</strong></p>

    @* ---- Bilgi / iletişim düzenleme ---- *@
    <h2>Firma Bilgileri</h2>
    <form method="post" action="/platform/tenants/update" class="grid-form"><AntiforgeryToken />
        <input type="hidden" name="id" value="@_d.Id" />
        <label>Firma Adı<input name="name" required maxlength="256" value="@_d.Name" /></label>
        <label>Yetkili Adı<input name="yetkiliAd" maxlength="128" value="@_d.YetkiliAd" /></label>
        <label>E-posta<input name="eposta" type="email" maxlength="256" value="@_d.Eposta" /></label>
        <label>Telefon<input name="telefon" maxlength="32" value="@_d.Telefon" /></label>
        <label>Plan<input name="plan" maxlength="64" value="@_d.Plan" placeholder="Deneme / Standart / Pro" list="plan-list" /></label>
        <datalist id="plan-list"><option>Deneme</option><option>Standart</option><option>Pro</option></datalist>
        <label class="u-col-full">Platform Notu<textarea name="notlar" rows="3" maxlength="2000">@_d.Notlar</textarea></label>
        <button type="submit">Kaydet</button>
    </form>
    <p class="muted small">Firma kodu (<code>@_d.Code</code>) login anahtarıdır — değiştirilemez.</p>

    @* ---- Tehlike bölgesi ---- *@
    <h2>Erişim Yönetimi</h2>
    <div class="import-card">
        @if (_d.KapanisTarihiUtc is null)
        {
            <form method="post" action="/platform/tenants/toggle" class="tahsil-mini"
                  data-confirm="@_d.Code @(_d.IsActive ? "pasifleştirilsin" : "aktifleştirilsin") mi?"><AntiforgeryToken />
                <input type="hidden" name="id" value="@_d.Id" />
                <input type="hidden" name="active" value="@((!_d.IsActive).ToString().ToLowerInvariant())" />
                <button type="submit" class="@(_d.IsActive ? "kf-btn-danger" : "kf-btn")">@(_d.IsActive ? "Pasifleştir" : "Aktifleştir")</button>
                <span class="muted small">Geçici askıya alma — tek tıkla geri açılır; oturumlar anında düşer.</span>
            </form>
            <hr />
            <form method="post" action="/platform/tenants/close" class="tahsil-mini"><AntiforgeryToken />
                <input type="hidden" name="id" value="@_d.Id" />
                <input name="onayKod" required placeholder="Onay için firma kodunu yazın" autocomplete="off" />
                <button type="submit" class="kf-btn-danger">Firmayı Kapat</button>
                <span class="muted small">Kapalı = damgalı ayrı durum; giriş engellenir, VERİ SİLİNMEZ. Onay: firma kodunu (@_d.Code) aynen yazın.</span>
            </form>
        }
        else
        {
            <form method="post" action="/platform/tenants/reopen" class="tahsil-mini"
                  data-confirm="@_d.Code yeniden açılsın mı?"><AntiforgeryToken />
                <input type="hidden" name="id" value="@_d.Id" />
                <button type="submit" class="kf-btn">Yeniden Aç</button>
                <span class="muted small">Kapanış damgası temizlenir, erişim geri gelir — veri hiç silinmemişti.</span>
            </form>
        }
    </div>

    @* ---- PR-A: PDF LOGOSU. Tenant kendi /ayarlar'ından da yükleyebilir; bu EK kanal.
       Tek alan (TenantSettings.LogoBytes) — son yazan kazanır. ---- *@
    <h2>PDF Logosu</h2>
    <div class="kf-panel">
        @if (_loguVar)
        {
            @* BASKI BOYUTUNDA önizleme: PDF'te logo 38 pt yüksekliğe sığdırılıyor (PdfExportService:65).
               Ekranda 38 px göstermek bulanıklığı PDF üretmeden, müşteriye gitmeden görünür kılar. *@
            <p class="muted small">Sözleşme/fatura başlığında görünen boyut:</p>
            <div style="border:1px solid var(--tr-line);padding:.5rem;display:inline-block;background:#fff">
                <img src="/platform/tenants/@_d.Id/logo" alt="Logo önizleme" style="height:38px;width:auto" />
            </div>
            <p class="muted small">
                @_logoBilgi
                @if (_logoUyari is not null)
                {
                    <br /><span class="badge warn">@_logoUyari</span>
                }
            </p>
            <form method="post" action="/platform/tenants/logo-sil" class="tahsil-mini"
                  data-confirm="@_d.Code logosu kaldırılsın mı? PDF'lerde firma adı basılacak."><AntiforgeryToken />
                <input type="hidden" name="id" value="@_d.Id" />
                <button type="submit" class="kf-btn">Logoyu Kaldır</button>
            </form>
        }
        else
        {
            <p class="muted">Logo yüklü değil — PDF başlıklarında firma adı basılıyor.</p>
        }

        <form method="post" action="/platform/tenants/logo" enctype="multipart/form-data" class="grid-form">
            <AntiforgeryToken />
            <input type="hidden" name="id" value="@_d.Id" />
            <label>Logo (PNG)<input type="file" name="logo" accept="image/png" required /></label>
            <button type="submit" class="kf-btn">Yükle</button>
        </form>
        <p class="muted small">Yalnız <strong>PNG</strong> (şeffaf zemin gerekiyor).
            En az <strong>@LogoValidationRules.RecommendedWidth px</strong> genişlik önerilir — altında baskıda
            bulanık çıkar. <strong>@LogoValidationRules.IgnoredWidth px altındaki logo PDF'te yok sayılır</strong>
            ve yerine firma adı basılır. Üst sınır @LogoValidationRules.MaxWidth px / 1 MB.</p>
    </div>

    @* ---- PR-12: MODÜL LİSANSI (satın alma). Tenant bunu kendi ERP'sinde GÖREMEZ/AÇAMAZ —
       `Tenant` platform tablosunda tutuluyor. Tenant'ın kendi "Sitemi Aç" tercihinden AYRI
       kademedir: site ancak İKİSİ de açıkken görünür. Kapatmak veri SİLMEZ. ---- *@
    <h2>Modüller</h2>
    <div class="kf-panel">
        <form method="post" action="/platform/tenants/modul-web-sitesi" class="tahsil-mini"
              data-confirm="@(_d.WebSitesiModulu ? $"{_d.Code} için Web Sitesi modülü KAPATILSIN mı? (ilanlar silinmez, site erişime kapanır)" : $"{_d.Code} için Web Sitesi modülü açılsın mı?")">
            <AntiforgeryToken />
            <input type="hidden" name="id" value="@_d.Id" />
            <input type="hidden" name="aktif" value="@(_d.WebSitesiModulu ? "false" : "true")" />
            <strong>Web Sitesi</strong>
            <span class="badge @(_d.WebSitesiModulu ? "ok" : "warn")">@(_d.WebSitesiModulu ? "Satın alındı" : "Yok")</span>
            <button type="submit" class="kf-btn">@(_d.WebSitesiModulu ? "Kapat" : "Aç")</button>
        </form>
        <p class="muted small">Firmanın ERP'sinde "Web Sitesi" bölümünü ve halka açık siteyi açar.
            Firma bu anahtarı kendisi göremez/değiştiremez. Kapatıldığında mevcut ilanlar SİLİNMEZ,
            yalnız erişim ve site kapanır. Değişiklik en geç 60 saniyede tüm süreçlere yansır.</p>
    </div>

    @* ---- F4.6: YENİ ARAYÜZ PİLOTU (TenantSettings.YeniArayuzPilot). Firma kendi Ayarlar'ından
       açamaz; yalnız platform operatörü. Kapatmak ANINDA eski arayüze döndürür (bayrak önbelleksiz). ---- *@
    <h2>Yeni Arayüz</h2>
    <div class="kf-panel">
        <form method="post" action="/platform/tenants/yeni-arayuz-pilot" class="tahsil-mini"
              data-confirm="@(_d.YeniArayuzPilot ? $"{_d.Code} için yeni arayüz pilotu KAPATILSIN mı? (Panel ve Kira ekranları eski arayüze döner)" : $"{_d.Code} için yeni arayüz pilotu açılsın mı? (Panel ve Kira ekranları /app'e yönlenir)")">
            <AntiforgeryToken />
            <input type="hidden" name="id" value="@_d.Id" />
            <input type="hidden" name="aktif" value="@(_d.YeniArayuzPilot ? "false" : "true")" />
            <strong>Yeni Arayüz Pilotu</strong>
            <span class="badge @(_d.YeniArayuzPilot ? "ok" : "warn")">@(_d.YeniArayuzPilot ? "Açık" : "Kapalı")</span>
            <button type="submit" class="kf-btn">@(_d.YeniArayuzPilot ? "Kapat" : "Aç")</button>
        </form>
        <p class="muted small">Açıkken firmanın Panel ve Kira ekranları (liste, sözleşme formu, yazdırma) yeni
            arayüzde (<code>/app</code>) açılır; eski adresler oraya yönlenir. PDF, dışa aktarma ve diğer modüller
            değişmez. Kapatınca bir sonraki istekte eski arayüz döner. İşlem firmanın denetim kaydına yazılır.</p>
    </div>

    @* ---- PR-9: halka açık site görünürlüğü (SALT-OKUNUR). Site açma/kapama tenant'ın kendi
       "Sitemi Aç" self-servisinde kalır — platform admin'in zorla kapatması AYRI bir özellik. ---- *@
    <h2>Halka Açık Site</h2>
    <div class="kf-panel">
        <p>
            @(_d.PublicSiteEnabled ? "Site AÇIK" : "Site kapalı")
            @if (_d.PublicSiteEnabled && !_d.WebSitesiModulu)
            {
                <span class="badge warn">modül kapalı — site YAYINDA DEĞİL</span>
            }
        </p>
        @if (_d.Domainler.Count > 0)
        {
            <div class="table-scroll">
            <table class="grid tr-grid">
                <thead><tr><th>Host</th><th>Tür</th><th>Durum</th></tr></thead>
                <tbody>
                    @foreach (var dm in _d.Domainler)
                    {
                        <tr><td class="mono">@dm.Host</td><td>@dm.Tur</td><td>@dm.Durum</td></tr>
                    }
                </tbody>
            </table>
            </div>
        }
        else
        {
            <p class="muted small">Tanımlı host yok (firma "Sitemi Aç" demedi).</p>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private PlatformTenantDetay? _d;
    // PR-A logo durumu (byte'ın kendisi tutulmaz — önizleme ayrı uçtan servis edilir).
    private bool _loguVar;
    private string? _logoBilgi;
    private string? _logoUyari;

    protected override async Task OnInitializedAsync()
    {
        _d = await Platform.GetTenantAsync(Id);
        if (_d is null) return;
        var (bytes, degerlendirme) = await Platform.GetTenantLogoAsync(Id);
        _loguVar = bytes is { Length: > 0 };
        if (degerlendirme is { } d)
        {
            _logoBilgi = d.Genislik is { } g && d.Yukseklik is { } y
                ? $"{g}×{y} px · {d.Bayt / 1024} KB"
                : $"{d.Bayt} bayt · ölçü okunamadı";
            _logoUyari = d.Uyari;
        }
    }
}
