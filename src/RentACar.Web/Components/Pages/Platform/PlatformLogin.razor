@page "/platform/login"
@attribute [AllowAnonymous]
@layout PlatformLayout
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

<PageTitle>Platform Girişi — RentPro</PageTitle>

<div class="login-card">
    <h1>Platform Girişi</h1>
    <p class="muted">SaaS operatörü konsolu — tüm tenant'ları yönet.</p>

    @if (Hata == "1") { <p class="error">Kullanıcı adı veya şifre hatalı.</p> }
    @if (Hata == "limit") { <p class="error">Çok fazla giriş denemesi. Bir dakika bekleyip yeniden deneyin.</p> }

    <form method="post" action="/platform/auth/login"><AntiforgeryToken />
        <label>Kullanıcı
            <input name="kullanici" value="@(Env.IsDevelopment() ? "admin" : "")" autocomplete="off" />
        </label>
        <label>Şifre
            <input name="sifre" type="password" value="@(Env.IsDevelopment() ? "platform1376" : "")" />
        </label>
        <button type="submit">Giriş</button>
    </form>
    @if (Env.IsDevelopment())
    {
        <p class="muted small">Dev: <code>admin</code> / <code>platform1376</code> (config: <code>Platform:AdminUser/AdminPasswordHash</code>).</p>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
}
