@page "/arac-tipleri"
@attribute [Authorize(Roles = "Admin,Yonetici,Operator")]
@inject VehicleTypeService AracTipleri
@inject BrandService Markalar
@inject VehicleGroupService AracGruplari

<PageTitle>Araç Tipleri — RentPro</PageTitle>

<div class="page-head"><h1>Araç Tip Tanımları</h1><div class="actions"></div></div>
<p class="muted small">Araç modellerinin sözlüğü (ör. "Egea", "Clio"). Araç formundaki Tip açılır
    listesini besler. Marka opsiyonel (serbest metin).</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_list.Count == 0)">
    <summary>+ Yeni Araç Tipi</summary>
    <form method="post" action="/arac-tipleri/create" class="grid-form"><AntiforgeryToken />
        <label>Kod<input name="kod" required placeholder="EGEA" /></label>
        <label>Ad<input name="ad" required placeholder="Fiat Egea" /></label>
        <ComboBox Name="marka" Label="Marka" Options="_markaOpts" Placeholder="(opsiyonel)" />
        <label>Vites<input name="vites" placeholder="Manuel/Otomatik" /></label>
        <label>Yakıt<input name="yakit" placeholder="Benzin/Dizel/Elektrik" /></label>
        <ComboBox Name="grup" Label="Grup" Options="_grupOpts" Placeholder="(opsiyonel)" />
        <button type="submit">Oluştur</button>
    </form>
</details>

<table class="grid tr-grid">
    <thead><tr><th>Kod</th><th>Ad</th><th>Marka</th><th>Vites</th><th>Yakıt</th><th>Grup</th><th>Durum</th><th>İşlem</th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="8" class="muted">Araç tipi tanımlı değil.</td></tr>
        }
        @foreach (var t in _list)
        {
            <tr>
                <td class="mono">@t.Kod</td>
                <td>@t.Ad</td>
                <td>@t.Marka</td>
                <td>@t.Vites</td>
                <td>@t.Yakit</td>
                <td>@t.Grup</td>
                <td>@(t.Aktif ? "Aktif" : "Pasif")</td>
                <td>
                    <details>
                        <summary class="link">Düzenle</summary>
                        <form method="post" action="/arac-tipleri/update" class="grid-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@t.Id" />
                            <label>Kod<input name="kod" value="@t.Kod" required /></label>
                            <label>Ad<input name="ad" value="@t.Ad" required /></label>
                            <ComboBox Name="marka" Label="Marka" Value="@t.Marka" Options="_markaOpts" ListId="dl-marka-edit" />
                            <label>Vites<input name="vites" value="@t.Vites" /></label>
                            <label>Yakıt<input name="yakit" value="@t.Yakit" /></label>
                            <ComboBox Name="grup" Label="Grup" Value="@t.Grup" Options="_grupOpts" ListId="dl-grup-edit" />
                            <label>Durum
                                <select name="aktif">
                                    <option value="true" selected="@t.Aktif">Aktif</option>
                                    <option value="false" selected="@(!t.Aktif)">Pasif</option>
                                </select>
                            </label>
                            <button type="submit">Kaydet</button>
                        </form>
                    </details>
                    <form method="post" action="/arac-tipleri/delete" onsubmit="return confirm('Araç tipi silinsin mi?')"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private IReadOnlyList<VehicleType> _list = [];
    private List<string> _markaOpts = [], _grupOpts = [];

    // Seç-veya-yaz önerileri: master tanım listesi ∪ mevcut kayıtların distinct'i.
    private static List<string> Opts(params IEnumerable<string?>[] sources) =>
        sources.SelectMany(s => s).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.CurrentCulture).ToList();

    protected override async Task OnInitializedAsync()
    {
        _list = await AracTipleri.ListAsync();
        var markalar = await Markalar.ListActiveAsync();
        var gruplar = await AracGruplari.ListActiveAsync();
        _markaOpts = Opts(markalar.Select(m => m.Ad), _list.Select(t => t.Marka));
        _grupOpts = Opts(gruplar.Select(g => g.Ad), _list.Select(t => t.Grup));
    }
}
