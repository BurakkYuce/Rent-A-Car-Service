@page "/arac-gruplari"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@inject VehicleGroupService AracGruplari
@inject BrandService Markalar

<PageTitle>Araç Grupları — RentPro</PageTitle>

<div class="page-head"><h1>Araç Grubu Tanımları</h1><div class="actions"></div></div>
<p class="muted small">Araçların gruplandığı liste (ör. "EKO" = Ekonomik, "SUV") VE gruba bağlı kira
    kuralları (SIPP/segment/kasa türü, koltuk/kapı/bagaj, sürücü yaşı/ehliyet yılı, provizyon/muafiyet,
    günlük KM limiti + aşım ücreti). Araç formundaki Grup açılır listesi buradan beslenir. Kural
    alanları opsiyoneldir — yalnız Kod/Ad ile basit sözlük olarak da kullanılabilir.</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

@* `?bilgi=` ARTIK LAYOUT'UN: MainLayout global şerit basıyor. Burada da basmak mesajı İKİ KEZ
   gösterirdi (UcBilgiTekKaynakTests bunu kilitler). *@
@if (_unmatched.Count > 0)
{
    <details class="unmatched-grup" open>
        <summary class="link">⚠ Hiçbir gruba eşleşmeyen @(_unmatched.Count) araç grup değeri (tanılama)</summary>
        <p class="muted small">Filodaki bu <code>Grup</code> değerleri aşağıdaki tanımlı hiçbir araç grubu
            adına eşleşmiyor (Türkçe büyük/küçük harf farkları dahil karşılaştırıldı) — <strong>bu araçlar
            vitrine ve müsaitlik aramasına girmez.</strong> Hedef grubu seçip "Ata" ile toplu
            düzeltebilirsiniz; taşıma araçların <code>Grup</code> alanını günceller (denetime yazılır).</p>
        <div class="table-scroll">
            <table class="grid tr-grid">
                <thead><tr><th>Grup değeri</th><th class="num">Araç sayısı</th><th>Hedef grup</th></tr></thead>
                <tbody>
                    @foreach (var u in _unmatched)
                    {
                        <tr>
                            <td class="mono">@u.Grup</td>
                            <td class="num">@u.AracSayisi</td>
                            <td>
                                <form method="post" action="/arac-gruplari/ata" class="inline-form"><AntiforgeryToken />
                                    <input type="hidden" name="kaynak" value="@u.Grup" />
                                    <input type="hidden" name="bos" value="@(u.Bos ? "true" : "false")" />
                                    <select name="hedefGrupId" required>
                                        <option value="">(seçiniz)</option>
                                        @foreach (var g in _list.Where(x => x.Aktif))
                                        {
                                            <option value="@g.Id">@g.Ad</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn-sm">Ata</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
}

<details class="new-vehicle" open="@(_list.Count == 0)">
    <summary>+ Yeni Araç Grubu</summary>
    <form method="post" action="/arac-gruplari/create" class="grid-form"><AntiforgeryToken />
        <label>Kod<input name="kod" required placeholder="EKO" /></label>
        <label>Ad<input name="ad" required placeholder="Ekonomik" /></label>
        <label>Açıklama<input name="aciklama" placeholder="(opsiyonel)" /></label>
        <label>SIPP<input name="sipp" maxlength="4" placeholder="CDMD" /></label>
        <ComboBox Name="segment" Label="Segment" Options="_segmentOpts" />
        <label>Kasa Türü<input name="kasaTuru" placeholder="Sedan/SUV…" /></label>
        <label>Koltuk<input name="koltukSayisi" type="number" min="0" /></label>
        <label>Kapı<input name="kapiSayisi" type="number" min="0" /></label>
        <label>Bagaj<input name="bagajSayisi" type="number" min="0" /></label>
        <label>Sürücü Min. Yaş<input name="surucuMinYas" type="number" min="16" max="99" /></label>
        <label>Genç Sürücü Yaşı<input name="gencSurucuYas" type="number" min="16" max="99" /></label>
        <label>Genç Sürücü Ücreti (KDV hariç/gün)<input name="gencSurucuUcretGunluk" type="number" step="0.01" min="0" /></label>
        <label>Ek Sürücü Ücreti (KDV hariç/gün)<input name="ekSurucuUcretGunluk" type="number" step="0.01" min="0" /></label>
        <label>Ehliyet Min. Yıl<input name="ehliyetMinYil" type="number" min="0" max="80" /></label>
        <label>Provizyon<input name="provizyon" type="number" step="0.01" min="0" /></label>
        <label>Muafiyet Tutarı<input name="muafiyetTutari" type="number" step="0.01" min="0" /></label>
        <label>Günlük KM Limiti<input name="gunlukKmLimiti" type="number" min="0" /></label>
        <label>Aşım KM Ücreti<input name="asimKmUcreti" type="number" step="0.01" min="0" /></label>
        <ComboBox Name="marka" Label="Marka" Options="_brandOpts" />
        <label>Tip<input name="tipi" /></label>
        <label>Küçük Bagaj<input name="kucukBagaj" type="number" min="0" /></label>
        <label>Büyük Bagaj<input name="buyukBagaj" type="number" min="0" /></label>
        <label>Genç Ehliyet Yılı<input name="gencEhliyetMinYil" type="number" min="0" max="80" /></label>
        <label>Provizyon 2<input name="provizyon2" type="number" step="0.01" min="0" /></label>
        <label>Muafiyet 2<input name="muafiyet2" type="number" step="0.01" min="0" /></label>
        <label>Aylık Max KM<input name="aylikMaxKm" type="number" min="0" /></label>
        <label>Yakıt Fiyatı<input name="yakitFiyati" type="number" step="0.01" min="0" /></label>
        <label>Sonra Öde Oranı %<input name="sonraOdeOran" type="number" step="0.01" min="0" max="100" /></label>
        <label>Kredi Kartı Şartı
            <select name="krediKartiSart"><option value="">—</option><option value="true">Evet</option><option value="false">Hayır</option></select>
        </label>
        <label>Web Sıra<input name="webSira" type="number" min="0" /></label>
        <label>Upgrade Sıra<input name="upgradeSira" type="number" min="0" /></label>
        <label>Provizyon Dövizi<input name="provizyonDoviz" maxlength="3" placeholder="EUR" /></label>
        <label>Provizyon 2 Dövizi<input name="provizyon2Doviz" maxlength="3" /></label>
        <label>Yakıt Türü
            <select name="yakitTuru"><option value="">—</option>
                @foreach (var y in Enum.GetValues<FuelType>()) { <option value="@y">@y</option> }
            </select>
        </label>
        <label>Vites
            <select name="vites"><option value="">—</option>
                @foreach (var v in Enum.GetValues<Transmission>()) { <option value="@v">@v</option> }
            </select>
        </label>
        <label>Entegrasyon Kodu<input name="entegrasyonKod1" maxlength="64" /></label>
        <label>Web ID<input name="webId" maxlength="64" /></label>
        <label>Servis ID<input name="servisId" maxlength="64" /></label>
        <button type="submit">Oluştur</button>
    </form>
</details>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Kod</th><th>Ad</th><th>Açıklama</th><th>SIPP</th><th>Segment</th><th class="num">Araç Sayısı</th><th class="num">Günlük KM</th><th class="num">Provizyon</th><th>Web ID</th><th>Servis ID</th><th class="num">Sürücü Yaşı</th><th class="num">Ehliyet Yılı</th><th>Durum</th><th>İşlem</th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="14" class="muted">Araç grubu tanımlı değil.</td></tr>
        }
        @foreach (var g in _list)
        {
            <tr>
                <td class="mono">@g.Kod</td>
                <td>@g.Ad</td>
                <td>@(string.IsNullOrWhiteSpace(g.Aciklama) ? "—" : g.Aciklama)</td>
                <td class="mono">@g.Sipp</td>
                <td>@g.Segment</td>
                @* Araç sayısı: grup ADI eşlemesiyle (Vehicle.Grup metin alanı, FK değil) —
                   "eşleşmeyen değerler" paneliyle AYNI Türkçe-duyarlı kural. *@
                <td class="num">@_vehicleCount.GetValueOrDefault(g.Id)</td>
                <td class="num">@(g.GunlukKmLimiti?.ToString() ?? "—")</td>
                <td class="num">@(g.Provizyon?.ToString("N2") ?? "—")@(string.IsNullOrWhiteSpace(g.ProvizyonDoviz) ? "" : " " + g.ProvizyonDoviz)</td>
                <td>@(g.WebId ?? "—")</td>
                <td>@(g.ServisId ?? "—")</td>
                <td class="num">@(g.SurucuMinYas?.ToString() ?? "—")</td>
                <td class="num">@(g.EhliyetMinYil?.ToString() ?? "—")</td>
                <td>@(g.Aktif ? "Aktif" : "Pasif")</td>
                <td>
                    <details>
                        <summary class="link">Düzenle</summary>
                        <form method="post" action="/arac-gruplari/update" class="grid-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@g.Id" />
                            <label>Kod<input name="kod" value="@g.Kod" required /></label>
                            <label>Ad<input name="ad" value="@g.Ad" required /></label>
                            <label>Açıklama<input name="aciklama" value="@g.Aciklama" /></label>
                            <label>SIPP<input name="sipp" value="@g.Sipp" maxlength="4" /></label>
                            <ComboBox Name="segment" Label="Segment" Value="@g.Segment" Options="_segmentOpts" ListId="dl-segment-edit" />
                            <label>Kasa Türü<input name="kasaTuru" value="@g.KasaTuru" /></label>
                            <label>Koltuk<input name="koltukSayisi" type="number" min="0" value="@g.KoltukSayisi" /></label>
                            <label>Kapı<input name="kapiSayisi" type="number" min="0" value="@g.KapiSayisi" /></label>
                            <label>Bagaj<input name="bagajSayisi" type="number" min="0" value="@g.BagajSayisi" /></label>
                            <label>Sürücü Min. Yaş<input name="surucuMinYas" type="number" min="16" max="99" value="@g.SurucuMinYas" /></label>
                            <label>Genç Sürücü Yaşı<input name="gencSurucuYas" type="number" min="16" max="99" value="@g.GencSurucuYas" /></label>
                            <label>Genç Sürücü Ücreti (KDV hariç/gün)<input name="gencSurucuUcretGunluk" type="number" step="0.01" min="0" value="@g.GencSurucuUcretGunluk" /></label>
                            <label>Ek Sürücü Ücreti (KDV hariç/gün)<input name="ekSurucuUcretGunluk" type="number" step="0.01" min="0" value="@g.EkSurucuUcretGunluk" /></label>
                            <label>Ehliyet Min. Yıl<input name="ehliyetMinYil" type="number" min="0" max="80" value="@g.EhliyetMinYil" /></label>
                            <label>Provizyon<input name="provizyon" type="number" step="0.01" min="0" value="@g.Provizyon" /></label>
                            <label>Muafiyet Tutarı<input name="muafiyetTutari" type="number" step="0.01" min="0" value="@g.MuafiyetTutari" /></label>
                            <label>Günlük KM Limiti<input name="gunlukKmLimiti" type="number" min="0" value="@g.GunlukKmLimiti" /></label>
                            <label>Aşım KM Ücreti<input name="asimKmUcreti" type="number" step="0.01" min="0" value="@g.AsimKmUcreti" /></label>
                            <ComboBox Name="marka" Label="Marka" Value="@g.Marka" Options="_brandOpts" ListId="dl-marka-edit" />
                            <label>Tip<input name="tipi" value="@g.Tipi" /></label>
                            <label>Küçük Bagaj<input name="kucukBagaj" type="number" min="0" value="@g.KucukBagaj" /></label>
                            <label>Büyük Bagaj<input name="buyukBagaj" type="number" min="0" value="@g.BuyukBagaj" /></label>
                            <label>Genç Ehliyet Yılı<input name="gencEhliyetMinYil" type="number" min="0" max="80" value="@g.GencEhliyetMinYil" /></label>
                            <label>Provizyon 2<input name="provizyon2" type="number" step="0.01" min="0" value="@g.Provizyon2" /></label>
                            <label>Muafiyet 2<input name="muafiyet2" type="number" step="0.01" min="0" value="@g.Muafiyet2" /></label>
                            <label>Aylık Max KM<input name="aylikMaxKm" type="number" min="0" value="@g.AylikMaxKm" /></label>
                            <label>Yakıt Fiyatı<input name="yakitFiyati" type="number" step="0.01" min="0" value="@g.YakitFiyati" /></label>
                            <label>Sonra Öde Oranı %<input name="sonraOdeOran" type="number" step="0.01" min="0" max="100" value="@g.SonraOdeOran" /></label>
                            <label>Kredi Kartı Şartı
                                <select name="krediKartiSart">
                                    <option value="" selected="@(g.KrediKartiSart == null)">—</option>
                                    <option value="true" selected="@(g.KrediKartiSart == true)">Evet</option>
                                    <option value="false" selected="@(g.KrediKartiSart == false)">Hayır</option>
                                </select>
                            </label>
                            <label>Web Sıra<input name="webSira" type="number" min="0" value="@g.WebSira" /></label>
                            <label>Upgrade Sıra<input name="upgradeSira" type="number" min="0" value="@g.UpgradeSira" /></label>
                            <label>Provizyon Dövizi<input name="provizyonDoviz" maxlength="3" value="@g.ProvizyonDoviz" /></label>
                            <label>Provizyon 2 Dövizi<input name="provizyon2Doviz" maxlength="3" value="@g.Provizyon2Doviz" /></label>
                            <label>Yakıt Türü
                                <select name="yakitTuru"><option value="">—</option>
                                    @foreach (var y in Enum.GetValues<FuelType>()) { <option value="@y" selected="@(g.YakitTuru == y)">@y</option> }
                                </select>
                            </label>
                            <label>Vites
                                <select name="vites"><option value="">—</option>
                                    @foreach (var v in Enum.GetValues<Transmission>()) { <option value="@v" selected="@(g.Vites == v)">@v</option> }
                                </select>
                            </label>
                            <label>Entegrasyon Kodu<input name="entegrasyonKod1" maxlength="64" value="@g.EntegrasyonKod1" /></label>
                            <label>Web ID<input name="webId" maxlength="64" value="@g.WebId" /></label>
                            <label>Servis ID<input name="servisId" maxlength="64" value="@g.ServisId" /></label>
                            <label>Durum
                                <select name="aktif">
                                    <option value="true" selected="@g.Aktif">Aktif</option>
                                    <option value="false" selected="@(!g.Aktif)">Pasif</option>
                                </select>
                            </label>
                            <button type="submit">Kaydet</button>
                        </form>
                    </details>
                    <form method="post" action="/arac-gruplari/delete" data-confirm="Araç grubu silinsin mi?"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@g.Id" />
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private IReadOnlyList<VehicleGroup> _list = [];
    private List<string> _brandOpts = [], _segmentOpts = [];
    private IReadOnlyList<UnmatchedGrupValue> _unmatched = [];
    private IReadOnlyDictionary<Guid, int> _vehicleCount = new Dictionary<Guid, int>();

    // Seç-veya-yaz önerileri: master tanım listesi ∪ mevcut kayıtların distinct'i.
    private static List<string> Opts(params IEnumerable<string?>[] sources) =>
        sources.SelectMany(s => s).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.CurrentCulture).ToList();

    protected override async Task OnInitializedAsync()
    {
        _list = await AracGruplari.ListAsync();
        var brands = await Markalar.ListActiveAsync();
        _brandOpts = Opts(brands.Select(m => m.Ad), _list.Select(g => g.Marka));
        _segmentOpts = Opts(_list.Select(g => g.Segment));
        _unmatched = await AracGruplari.ListUnmatchedGroupValuesAsync();
        _vehicleCount = await AracGruplari.VehicleCountsAsync();
    }
}
