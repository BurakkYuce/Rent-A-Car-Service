@page "/gelen-talepler"
@attribute [Authorize(Roles = "Admin,Yonetici,Operator")]
@using RentACar.Application.Availability
@using RentACar.Application.Common
@using RentACar.Application.PublicSite
@using RentACar.Domain.Entities
@inject PublicBookingRequestService Talepler
@inject AvailabilityService Musaitlik

<PageTitle>Gelen Talepler — RentPro</PageTitle>

<div class="page-head">
    <h1>Gelen Talepler</h1>
    <div class="actions">
        @if (_ozet is { Yeni: > 0 } o)
        {
            <span class="badge warn">@o.Yeni yeni@(o.EnEskiGun is { } g and > 0 ? $" · en eskisi {g} gündür bekliyor" : "")</span>
        }
    </div>
</div>
<p class="muted small">Halka açık sitedeki formdan gelen teklif talepleri. Bunlar <strong>rezervasyon
    değildir</strong> — "Dönüştür" ile müşteri kaydı (telefonu eşleşen cari varsa yeniden açılmaz) +
    gerçek rezervasyon oluşturulur. Dönüştürürken talebin tarihlerinde <strong>müsait bir araç
    seçmeniz</strong> gerekir.</p>

@if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }
@if (Ok == "1") { <p class="ok">Kaydedildi.</p> }

@* ---- Filtre: durum + arama. GET formu (PRG) — sayfa yenilenebilir/paylaşılabilir olsun. ---- *@
<form method="get" action="/gelen-talepler" class="grid-form card">
    <label>Durum
        <select name="durum">
            <option value="">Tümü</option>
            @foreach (var d in TalepDurumu.GosterimSirasi)
            {
                <option value="@((int)d)" selected="@(Durum == (int)d)">@TalepDurumu.Etiket(d)</option>
            }
        </select>
    </label>
    <label>Ara (ad veya telefon)
        <input name="ara" value="@Ara" placeholder="Ahmet / 0532…" /></label>
    <div class="form-actions">
        <button type="submit" class="kf-btn">Filtrele</button>
        <a class="link" href="/gelen-talepler">Temizle</a>
    </div>
</form>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr>
        <th>Tarih</th><th>Ad Soyad</th><th>Telefon</th><th>E-posta</th>
        <th>Alış</th><th>İade</th><th>Araç</th><th>Şube</th><th class="num">Gösterilen ₺/gün</th>
        <th>Durum</th><th>Takip</th><th>İşlem</th>
    </tr></thead>
    <tbody>
        @if (_satirlar.Count == 0)
        {
            <tr><td colspan="12" class="muted">Bu filtreyle talep yok.</td></tr>
        }
        @foreach (var s in _satirlar)
        {
            var t = s.Talep;
            <tr>
                <td>
                    @t.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    @* Yaşlanma rozeti YALNIZ açık taleplerde: kapanmışta "12 gündür bekliyor" yanıltır. *@
                    @if (TalepDurumu.Aktif(t.Durum) && s.BekleyenGun >= 1)
                    {
                        <br /><span class="badge @(s.BekleyenGun >= 3 ? "danger" : "warn")">@s.BekleyenGun gün</span>
                    }
                </td>
                <td>@t.AdSoyad</td>
                <td class="mono">@t.Telefon</td>
                <td>@t.Email</td>
                <td>@t.BasTar.ToString("dd.MM.yyyy")</td>
                <td>@t.BitTar.ToString("dd.MM.yyyy")</td>
                <td>@(t.IlanBaslik ?? t.AracGrupKod)</td>
                <td>@t.Sube</td>
                <td class="num">
                    @if (t.GosterilenGunlukUcretKdvDahil is { } f)
                    {
                        <text>@f.ToString("N2")</text>
                        <span class="muted small">@(t.GosterilenKdvDahil == false ? "+ KDV" : "KDV dahil")</span>
                    }
                    else { <text>—</text> }
                </td>
                <td>
                    <span class="badge @DurumSinif(t.Durum)">@TalepDurumu.Etiket(t.Durum)</span>
                    @if (t.Durum == PublicBookingRequestDurum.Donustu && t.DonusenReservationId is null)
                    {
                        @* Claim/release deseninde process çökerse kalabilecek TEK yarım durum — sessiz bırakılmaz. *@
                        <br /><span class="error small">(rezervasyonu bulunamadı)</span>
                    }
                    @if (t.AtananAd is { Length: > 0 } ad)
                    {
                        <br /><span class="muted small">@ad</span>
                    }
                </td>
                <td class="muted small">
                    @if (!string.IsNullOrWhiteSpace(t.Not)) { <div><em>@t.Not</em></div> }
                    @if (s.NotSayisi > 0)
                    {
                        <details>
                            <summary class="link">@s.NotSayisi not</summary>
                            @foreach (var n in _notlar.GetValueOrDefault(t.Id) ?? [])
                            {
                                <div>@n.ZamanUtc.ToLocalTime().ToString("dd.MM HH:mm")
                                    @if (!string.IsNullOrWhiteSpace(n.Kullanici)) { <text>· @n.Kullanici</text> }
                                    <br />@n.Metin</div>
                            }
                        </details>
                    }
                    @if (TalepDurumu.Aktif(t.Durum))
                    {
                        <form method="post" action="/gelen-talepler/not" class="inline-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@t.Id" />
                            <input name="metin" placeholder="Not ekle…" maxlength="@PublicBookingRequestService.MaxNot" required style="min-width:9rem" />
                            <button type="submit" class="link">Ekle</button>
                        </form>
                    }
                </td>
                <td>
                    @* Hızlı temas: link üretimi SUNUCUDA (TelefonLink) — rc-kira-tabs.js'teki JS
                       normalizasyon kuralının ikinci kopyası çıkarılmıyor. *@
                    @if (TelefonLink.Tel(t.Telefon) is { } tel)
                    {
                        <a class="link" href="@tel">Ara</a>
                    }
                    @if (TelefonLink.Wa(t.Telefon, WaMesaj(t)) is { } wa)
                    {
                        <a class="link" href="@wa" target="_blank" rel="noopener">WhatsApp</a>
                    }

                    @if (TalepDurumu.Aktif(t.Durum))
                    {
                        @* Üstlenme YALNIZ kendine — kullanıcı listesi ManageUsers kilidi ardında. *@
                        <form method="post" action="/gelen-talepler/ustlen" class="inline-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@t.Id" />
                            <input type="hidden" name="ustlen" value="@(t.AtananKullaniciId is null ? "true" : "false")" />
                            <button type="submit" class="link">@(t.AtananKullaniciId is null ? "Bana ata" : "Bırak")</button>
                        </form>

                        @foreach (var hedef in Ilerlemeler(t.Durum))
                        {
                            <form method="post" action="/gelen-talepler/durum" class="inline-form"><AntiforgeryToken />
                                <input type="hidden" name="id" value="@t.Id" />
                                <input type="hidden" name="durum" value="@((int)hedef)" />
                                <button type="submit" class="link">@TalepDurumu.Etiket(hedef)</button>
                            </form>
                        }

                        @if (Donustur != t.Id)
                        {
                            @* Müsaitlik sorgusu ancak BU bağlantıya basılınca koşar (N+1 yok). *@
                            <a class="link" href="@DonusturLinki(t.Id)">Dönüştür</a>
                        }
                        else
                        {
                            var musait = _musait.GetValueOrDefault(t.Id) ?? [];
                            @if (musait.Count == 0)
                            {
                                <p class="muted small">Bu tarihlerde müsait araç yok.</p>
                            }
                            else
                            {
                                <form method="post" action="/gelen-talepler/donustur" class="grid-form"><AntiforgeryToken />
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <label>Araç
                                        <select name="vehicleId" required>
                                            @foreach (var v in musait)
                                            {
                                                <option value="@v.Id">@v.Plaka — @v.Marka @v.Tip (@v.Grup)</option>
                                            }
                                        </select>
                                    </label>
                                    <button type="submit">Rezervasyona Dönüştür</button>
                                </form>
                            }
                            <a class="link" href="@Link(SayfaNo)">Vazgeç</a>
                        }
                        <form method="post" action="/gelen-talepler/reddet" data-confirm="Talep reddedilsin mi?"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@t.Id" />
                            <button type="submit" class="link danger">Reddet</button>
                        </form>
                    }
                    else if (t.DonusenReservationId is { } rid)
                    {
                        <a href="/rezervasyonlar?vurgu=@rid">Rezervasyon →</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@if (_toplam > Boyut)
{
    <div class="form-actions">
        <span class="muted small">@_toplam talep · sayfa @SayfaNo / @((_toplam + Boyut - 1) / Boyut)</span>
        @if (SayfaNo > 1) { <a class="link" href="@Link(SayfaNo - 1)">← Önceki</a> }
        @if (SayfaNo * Boyut < _toplam) { <a class="link" href="@Link(SayfaNo + 1)">Sonraki →</a> }
    </div>
}

@code {
    /// <summary>Sayfa boyutu — eski ekran TÜM talepleri çekiyordu (sınırsız liste).</summary>
    private const int Boyut = 25;

    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public int? Durum { get; set; }
    [SupplyParameterFromQuery(Name = "ara")] public string? Ara { get; set; }
    [SupplyParameterFromQuery(Name = "sayfa")] public int? Sayfa { get; set; }
    /// <summary>Müsait araç listesi YALNIZ bu talep için çekilir (N+1 yerine istek-üzerine).</summary>
    [SupplyParameterFromQuery(Name = "donustur")] public Guid? Donustur { get; set; }

    private int SayfaNo => Math.Max(1, Sayfa ?? 1);

    private IReadOnlyList<TalepSatiri> _satirlar = [];
    private Dictionary<Guid, IReadOnlyList<Vehicle>> _musait = [];
    private Dictionary<Guid, IReadOnlyList<TalepNotu>> _notlar = [];
    private TalepOzet? _ozet;
    private int _toplam;

    /// <summary>Mevcut filtre/sayfayı koruyarak "dönüştür" panelini AÇAN adres.</summary>
    private string DonusturLinki(Guid id) => Link(SayfaNo) + "&donustur=" + id;

    private string Link(int sayfa)
        => $"/gelen-talepler?sayfa={sayfa}" +
           (Durum is { } d ? $"&durum={d}" : "") +
           (string.IsNullOrWhiteSpace(Ara) ? "" : $"&ara={Uri.EscapeDataString(Ara)}");

    private static string DurumSinif(PublicBookingRequestDurum d) => d switch
    {
        PublicBookingRequestDurum.Yeni => "warn",
        PublicBookingRequestDurum.Donustu => "ok",
        PublicBookingRequestDurum.Reddedildi or PublicBookingRequestDurum.Kayip => "danger",
        _ => "",
    };

    /// <summary>Bir durumdan ELLE geçilebilecek hedefler. "Dönüştü" listede YOK — o yalnız
    /// Dönüştür akışıyla atanır (elle atanması defterle çelişen bir lead durumu üretirdi).</summary>
    private static PublicBookingRequestDurum[] Ilerlemeler(PublicBookingRequestDurum d) => d switch
    {
        PublicBookingRequestDurum.Yeni => [PublicBookingRequestDurum.Iletisimde, PublicBookingRequestDurum.Kayip],
        PublicBookingRequestDurum.Iletisimde => [PublicBookingRequestDurum.TeklifVerildi, PublicBookingRequestDurum.Kayip],
        PublicBookingRequestDurum.TeklifVerildi => [PublicBookingRequestDurum.Kayip],
        _ => [],
    };

    private static string WaMesaj(PublicBookingRequest t)
        => $"Merhaba {t.AdSoyad}, {t.BasTar.LocalDateTime:dd.MM.yyyy}-{t.BitTar.LocalDateTime:dd.MM.yyyy} " +
           $"tarihleri için araç kiralama talebiniz hakkında görüşmek istiyoruz.";

    protected override async Task OnInitializedAsync()
    {
        var durum = Durum is { } d && Enum.IsDefined(typeof(PublicBookingRequestDurum), d)
            ? (PublicBookingRequestDurum?)d : null;

        (_satirlar, _toplam) = await Talepler.ListeleAsync(new TalepFiltre(durum, Ara, SayfaNo, Boyut));
        _ozet = await Talepler.OzetAsync();

        // PR-21 — N+1 KALDIRILDI. Eskiden AÇIK her satır için müsaitlik sorgusu koşuyordu:
        // 25 satırlık bir sayfada 25 ek sorgu. Ölçüldü: aynı sayfa, satırlar kapalıyken 19 ms,
        // açıkken 52 ms — fark tamamen bu döngüydü. PR-17'de döngüyü "yalnız Yeni" iken "tüm aktif
        // durumlar"a genişletmiştim, yani maliyeti ben büyütmüştüm.
        // Artık müsait araç listesi YALNIZ dönüştürülecek TEK talep için çekiliyor (`?donustur={id}`);
        // personel "Dönüştür"e bastığında sayfa o satırla birlikte yeniden basılır.
        if (Donustur is Guid dId && _satirlar.FirstOrDefault(x => x.Talep.Id == dId) is { } hedef
            && TalepDurumu.Aktif(hedef.Talep.Durum))
        {
            _musait[dId] = await Musaitlik.FindAvailableAsync(
                hedef.Talep.BasTar, hedef.Talep.BitTar, null, hedef.Talep.Sube);
        }

        // Notlar: yalnız NOTU OLAN satırlar için (sayı zaten tek sorguyla geldi) — notsuz satır
        // sorgu üretmez.
        foreach (var s in _satirlar.Where(x => x.NotSayisi > 0))
            _notlar[s.Talep.Id] = await Talepler.NotlarAsync(s.Talep.Id);
    }
}
