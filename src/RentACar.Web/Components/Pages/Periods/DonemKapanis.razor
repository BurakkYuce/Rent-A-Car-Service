@page "/donem-kapanis"
@attribute [Authorize(Policy = "izin:FinanceWrite")]
@inject PeriodLockService Donem
@inject RentACar.Application.Reporting.ReportService Rapor

<PageTitle>Dönem Kapanışı — RentPro</PageTitle>

<div class="page-head"><h1>Dönem Kapanışı</h1><div class="actions"></div></div>
@if (Ok == "1")
{
    <p class="ok">Dönem kapatıldı / kilit güncellendi.</p>
}
@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<p>Mevcut kilit: <strong>@(_closing is { } kapanis ? RentACar.Application.Periods.PeriodLock.LocalDay(kapanis).ToString("yyyy-MM-dd") : "yok (tüm dönemler açık)")</strong></p>
<p class="muted small">Kapanış tarihi ve <strong>öncesine</strong> tahsilat/ödeme/virman/cari-virman/ters kayıt/
    fatura/gider/ceza yansıtma/HGS yansıtma postlanamaz. İleri tarihe taşıma serbest. "Dönemi Kapat" ayrıca
    <strong>kapanış fişi</strong> keser: Gelir/Gider hesaplarını sıfırlayıp net dönem sonucunu
    <em>Dönem Sonucu</em> hesabına taşır (KDV/Kasa/Banka/Cari bilanço hesapları dokunulmaz).</p>

<h2>Güncel Mizan (bugüne kadar)</h2>
@if (_mizan is { Count: > 0 })
{
    <div class="table-scroll">
    <table class="grid">
        <thead><tr><th>Hesap</th><th class="num">Borç</th><th class="num">Alacak</th><th class="num">Bakiye</th></tr></thead>
        <tbody>
        @foreach (var m in _mizan)
        {
            <tr>
                <td>@m.Ad</td>
                <td class="num">@m.Borc.ToString("N2")</td>
                <td class="num">@m.Alacak.ToString("N2")</td>
                <td class="num">@m.Bakiye.ToString("N2")</td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <td><strong>Toplam</strong></td>
                <td class="num"><strong>@_mizan.Sum(x => x.Borc).ToString("N2")</strong></td>
                <td class="num"><strong>@_mizan.Sum(x => x.Alacak).ToString("N2")</strong></td>
                <td class="num"><strong>@_mizan.Sum(x => x.Bakiye).ToString("N2")</strong></td>
            </tr>
        </tfoot>
    </table>
    </div>
    <p class="muted small">Bakiye toplamı 0 olmalı (çift-taraflı defter dengesi).</p>
}
else
{
    <p class="muted">Defter boş.</p>
}

@if (_onizleme is { } o)
{
    <p>Şu an kapatılacak (güncel Gelir/Gider bakiyesi): <strong>Gelir @o.Gelir.ToString("N2")</strong> −
        <strong>Gider @o.Gider.ToString("N2")</strong> = <strong>Dönem Sonucu @o.DonemSonucu.ToString("N2")</strong>
        (@(o.DonemSonucu >= 0 ? "kâr" : "zarar")).</p>
}

@* Yolunda silme/iptal fiili yok ama geri alınamaz: kapanış fişi değişmez deftere yazılır.
   YikiciFormOnayTests bu iki ucu adıyla listeler. *@
<form method="post" action="/donem-kapanis/kilitle" class="grid-form"
      data-confirm="Dönem seçilen kapanış tarihine kadar kapatılsın mı? Gelir/Gider bakiyeleri kapanış fişiyle Dönem Sonucu hesabına aktarılır (defter kaydı silinemez) ve bu tarih ile öncesine artık tahsilat, fatura, gider veya ters kayıt girilemez. Kilidi kaldırmak kapanış fişini geri almaz."><AntiforgeryToken />
    <label>Kapanış Tarihi<input name="kapanisTarihi" type="date" required /></label>
    <button type="submit">Dönemi Kapat (fiş + kilit)</button>
</form>

@* Kilit TAMAMEN kalkar (tarih null — DonemKilidiService.UnlockAsync); fiş ters kaydedilmez. Kullanıcı
   "kapanışı geri aldım" sanmasın diye mesaj bunu açıkça söyler. *@
<form method="post" action="/donem-kapanis/ac"
      data-confirm="Dönem kilidi TAMAMEN kaldırılsın mı? Kapalı tüm geçmiş dönemler yeniden kayda açılır. Kesilmiş kapanış fişi GERİ ALINMAZ; dönemi yeniden kapatmak yalnız aradaki farkı yeni bir fişle kapatır."><AntiforgeryToken />
    <button type="submit" class="btn-secondary">Kilidi Kaldır</button>
</form>

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private DateTimeOffset? _closing;
    private IReadOnlyList<RentACar.Application.Reporting.MizanSatirDto>? _mizan;
    private RentACar.Application.Periods.DonemKapanisOnizleme? _onizleme;

    protected override async Task OnInitializedAsync()
    {
        _closing = await Donem.GetClosingDateAsync();
        _mizan = await Rapor.GetTrialBalanceAsync();
        // Önizleme GÜNCEL mizan bakiyesinden (kapanışın gerçekten sıfırlayacağı tutar): Gelir Alacak bakiyesi
        // (negatif) → gelir = −bakiye; Gider Borç bakiyesi (pozitif) → gider = bakiye.
        decimal Bakiye(LedgerAccountType t) => _mizan.FirstOrDefault(m => m.Tip == t)?.Bakiye ?? 0m;
        var gelir = -Bakiye(LedgerAccountType.Gelir);
        var gider = Bakiye(LedgerAccountType.Gider);
        _onizleme = new RentACar.Application.Periods.DonemKapanisOnizleme(gelir, gider, gelir - gider);
    }
}
