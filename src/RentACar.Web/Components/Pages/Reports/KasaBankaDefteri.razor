@page "/raporlar/kasa-banka"
@attribute [Authorize(Policy = "izin:ViewReports")]
@using RentACar.Domain.Entities
@using RentACar.Domain.Enums
@inject ReportService Reports
@inject FinancialAccountService Hesaplar

<PageTitle>Kasa / Banka Defteri — RentPro</PageTitle>

<div class="page-head">
    <h1>Kasa / Banka Defteri</h1>
    <div class="actions">
        <a href="@ExportUrl("excel")">Excel</a> ·
        <a href="@ExportUrl("csv")">CSV</a>
    </div>
</div>

<form method="get" class="grid-form">
    <label>Hesap
        <select name="hesap">
            <option value="Kasa" selected="@(_account == LedgerAccountType.Kasa)">Kasa</option>
            <option value="Banka" selected="@(_account == LedgerAccountType.Banka)">Banka</option>
        </select>
    </label>
    @* FAZ-50 — spesifik hesap filtresi. "Hesap belirtilmemiş" AYRI bir seçenektir: bu fazdan
       önceki kayıtların hangi kasadan geçtiği bilinmiyor ve rastgele bir hesaba yedirilmiyor. *@
    <label>Kasa/Banka Hesabı
        <select name="hesapId">
            <option value="">— tümü —</option>
            <option value="@Guid.Empty" selected="@(HesapId == Guid.Empty.ToString())">— hesap belirtilmemiş —</option>
            @foreach (var h in _accounts)
            {
                <option value="@h.Id" selected="@(HesapId == h.Id.ToString())">@h.Ad (@h.Kod)</option>
            }
        </select>
    </label>
    @* FAZ-57 — canlı banka_hesap_hareketleri / banka_nakit_listesi / banka_para_listesi /
       kasa_dagilimi ekranlarının dördü de bu tek sayfa + süzgeç bileşimiyle karşılanır. *@
    <label>Döviz
        <select name="doviz">
            <option value="">Tümü</option>
            @foreach (var d in _currencies) { <option value="@d" selected="@(Doviz == d)">@d</option> }
        </select>
    </label>
    <label>İşlem Türü
        <select name="tur">
            <option value="">Tümü</option>
            @foreach (var t in _types) { <option value="@t" selected="@(Tur == t)">@t</option> }
        </select>
    </label>
    <label>Şube
        <select name="sube">
            <option value="">Tümü</option>
            @foreach (var b in _branches) { <option value="@b" selected="@(Sube == b)">@b</option> }
        </select>
    </label>
    <label>Başlangıç<input name="from" type="date" value="@From" /></label>
    <label>Bitiş<input name="to" type="date" value="@To" /></label>
    <label class="check"><input type="checkbox" name="devir" value="true" checked="@(Devir == "true")" />
        Devir göster</label>
    <button type="submit">Göster</button>
</form>

<div class="cards">
    <div class="card">
        <div class="card-num @(_summary.KasaBakiye < 0 ? "neg" : "pos")">@_summary.KasaBakiye.ToString("N2")</div>
        <div class="card-label">Kasa Bakiye ₺</div>
    </div>
    <div class="card">
        <div class="card-num @(_summary.BankaBakiye < 0 ? "neg" : "pos")">@_summary.BankaBakiye.ToString("N2")</div>
        <div class="card-label">Banka Bakiye ₺</div>
    </div>
    <div class="card">
        <div class="card-num pos">@Giris.ToString("N2")</div>
        <div class="card-label">@_account Giriş ₺</div>
    </div>
    <div class="card">
        <div class="card-num neg">@Cikis.ToString("N2")</div>
        <div class="card-label">@_account Çıkış ₺</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(HesapId))
{
    <p class="muted small">Yukarıdaki kartlar <strong>türün tamamını</strong> gösterir (hesap süzgecinden
        etkilenmez); seçili hesabın bakiyesi aşağıdaki tabloda ve hareket listesindedir.</p>
}

<h2>Hesap Bazlı Bakiye</h2>
<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Tür</th><th>Hesap</th><th class="num">Giriş ₺</th><th class="num">Çıkış ₺</th><th class="num">Bakiye ₺</th></tr></thead>
    <tbody>
        @if (_accountSummary.Count == 0)
        {
            <tr><td colspan="5" class="muted">Hareket yok.</td></tr>
        }
        @foreach (var o in _accountSummary)
        {
            <tr>
                <td>@o.Tur</td>
                <td>
                    @if (o.HesapId is { } hid)
                    {
                        @(_names.TryGetValue(hid, out var name) ? name : "(silinmiş hesap)")
                    }
                    else
                    {
                        <span class="muted" title="Bu satırlarda kasa/banka hesabı seçilmemiş: ya bu özellik eklenmeden önce yazıldılar ya da işlem sırasında hesap seçilmedi (ör. gece çalışan otomatik tahsilat).">hesap belirtilmemiş</span>
                    }
                </td>
                <td class="num">@o.Giris.ToString("N2")</td>
                <td class="num">@o.Cikis.ToString("N2")</td>
                <td class="num @(o.Bakiye < 0 ? "neg" : "pos")">@o.Bakiye.ToString("N2")</td>
            </tr>
        }
    </tbody>
</table>
</div>

<h2>Hareketler</h2>
<div class="table-scroll">
<table class="grid tr-grid">
    <thead>
        <tr><th>Tarih</th><th>Kaynak</th><th>Hesap</th><th>Hesap No / IBAN</th><th>Cari</th>
            <th>Evrak No</th><th>Şube</th><th>Kanal</th><th>Açıklama</th>
            <th class="num">Tutar (kendi dövizinde)</th><th>Döviz</th>
            <th>Giriş (Borç)</th><th>Çıkış (Alacak)</th><th>Bakiye</th></tr>
    </thead>
    <tbody>
        @if (_lines.Count == 0)
        {
            <tr><td colspan="14" class="muted">Hareket yok.</td></tr>
        }
        @foreach (var l in _lines)
        {
            <tr class="@(l.DevirMi ? "row-strong" : null)">
                <td>@l.Tarih.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@l.SourceType</td>
                <td>@(l.HesapId is { } lh ? (_names.TryGetValue(lh, out var lad) ? lad : "(silinmiş hesap)") : "—")</td>
                <td>@(l.HesapId is { } lh2 && _accountNo.TryGetValue(lh2, out var hn) ? hn : "—")</td>
                <td>@(l.CariAd ?? "—")</td>
                <td>@(l.BelgeNo ?? "—")</td>
                <td>@(l.Sube ?? "—")</td>
                <td>@(l.Kanal ?? "—")</td>
                <td>@l.Aciklama</td>
                <td class="num">@(l.DevirMi ? "" : l.Native.ToString("N2"))</td>
                <td>@(l.DevirMi ? "" : l.Doviz)</td>
                <td>@(l.Borc > 0 ? l.Borc.ToString("N2") : "")</td>
                <td>@(l.Alacak > 0 ? l.Alacak.ToString("N2") : "")</td>
                <td class="@(l.YuruyenBakiye < 0 ? "neg" : "pos")">@l.YuruyenBakiye.ToString("N2")</td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hesap")] public string? Hesap { get; set; }
    [SupplyParameterFromQuery(Name = "hesapId")] public string? HesapId { get; set; }
    // ---- FAZ-57 süzgeçleri ----
    [SupplyParameterFromQuery(Name = "doviz")] public string? Doviz { get; set; }
    [SupplyParameterFromQuery(Name = "tur")] public string? Tur { get; set; }
    [SupplyParameterFromQuery(Name = "sube")] public string? Sube { get; set; }
    [SupplyParameterFromQuery(Name = "devir")] public string? Devir { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? To { get; set; }

    private LedgerAccountType _account = LedgerAccountType.Kasa;
    private CashboxSummaryDto _summary = new(0, 0, 0, 0, 0, 0);
    private IReadOnlyList<LedgerLineDto> _lines = [];
    private IReadOnlyList<HesapOzetDto> _accountSummary = [];
    private IReadOnlyList<FinancialAccount> _accounts = [];
    private Dictionary<Guid, string> _names = new();
    private Dictionary<Guid, string> _accountNo = new();
    private IReadOnlyList<string> _currencies = [];
    private IReadOnlyList<string> _types = [];
    private IReadOnlyList<string> _branches = [];

    /// <summary>Ekrandaki süzgeç export'a AYNEN taşınır ("gördüğün = indirdiğin").</summary>
    private string ExportUrl(string format)
        => $"/raporlar/export/kasa-banka?format={format}&hesap={Hesap}&hesapId={HesapId}" +
           $"&from={From}&to={To}&doviz={Doviz}&tur={Tur}&sube={Uri.EscapeDataString(Sube ?? "")}&devir={Devir}";

    private decimal Giris => _account == LedgerAccountType.Kasa ? _summary.KasaGiris : _summary.BankaGiris;
    private decimal Cikis => _account == LedgerAccountType.Kasa ? _summary.KasaCikis : _summary.BankaCikis;

    protected override async Task OnInitializedAsync()
    {
        _account = string.Equals(Hesap, "Banka", StringComparison.OrdinalIgnoreCase)
            ? LedgerAccountType.Banka : LedgerAccountType.Kasa;
        var from = ParseDate(From);
        var to = ParseDate(To)?.AddDays(1).AddTicks(-1); // gün sonuna dek dahil

        // Guid.Empty = "yalnız hesap belirtilmemiş"; boş = tümü (bkz. GetAccountLedgerAsync).
        Guid? accountFilter = Guid.TryParse(HesapId, out var hf) ? hf : null;

        _summary = await Reports.GetCashBankSummaryAsync(from, to);
        _accountSummary = await Reports.GetAccountBasedSummaryAsync(from, to);
        _lines = await Reports.GetAccountLedgerAsync(_account, from, to, accountFilter,
            currency: Doviz, transactionType: Tur, branch: Sube, carryForward: Devir == "true");
        _accounts = await Hesaplar.ListAsync();
        _names = _accounts.ToDictionary(h => h.Id, h => h.Ad);
        // Hesap No / IBAN — banka_hesap_hareketleri.aspx kolonu; IBAN varsa o, yoksa hesap no.
        _accountNo = _accounts
            .Where(h => !string.IsNullOrWhiteSpace(h.Iban) || !string.IsNullOrWhiteSpace(h.HesapNo))
            .ToDictionary(h => h.Id, h => (h.Iban ?? h.HesapNo)!);

        // Süzgeç seçenekleri VERİDEN türetilir: sabit liste bakımı unutulur ve gerçekte var olan
        // bir işlem türü listede görünmezse kullanıcı onu hiç süzemez.
        var all = await Reports.GetAccountLedgerAsync(_account, from, to);
        _currencies = [.. all.Select(x => x.Doviz).Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.Ordinal)];
        _types = [.. all.Select(x => x.SourceType).Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.Ordinal).OrderBy(x => x, StringComparer.Ordinal)];
        _branches = [.. all.Select(x => x.Sube).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.CurrentCulture)];
    }

    private static DateTimeOffset? ParseDate(string? s)
        => DateTimeOffset.TryParse(s, out var d) ? new DateTimeOffset(d.Date, TimeSpan.Zero) : null;
}
