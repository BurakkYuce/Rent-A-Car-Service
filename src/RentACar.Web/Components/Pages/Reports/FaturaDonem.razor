@page "/raporlar/fatura-donem"
@attribute [Authorize(Policy = "izin:ViewReports")]
@inject ReportService Reports
@inject BranchService Branches

<PageTitle>Fatura Dönem Raporu — RentPro</PageTitle>

@* FAZ-53 — iki sekme AYNI dönemi iki yönden anlatır:
   "Kesilen Faturalar" (mevcut rapor, fatura tarihine göre) ve "Kira Faturalama Durumu"
   (dönemle KESİŞEN kiralar + faturalanıp faturalanmadığı). İkincisi fatura kaçağını bulur. *@

<div class="page-head">
    <h1>Fatura Dönem Raporu</h1>
    <div class="actions">
        @if (KiraSekmesi)
        {
            <a href="/raporlar/export/kira-fatura-durum?format=excel&amp;@KiraQuery">Excel</a> <text>·</text>
            <a href="/raporlar/export/kira-fatura-durum?format=csv&amp;@KiraQuery">CSV</a>
        }
        else
        {
            <a href="/raporlar/export/fatura-donem?format=excel&amp;from=@From&amp;to=@To">Excel</a> <text>·</text>
            <a href="/raporlar/export/fatura-donem?format=csv&amp;from=@From&amp;to=@To">CSV</a>
        }
    </div>
</div>

<nav class="tabs">
    <a class="tab @(KiraSekmesi ? null : "active")"
       href="/raporlar/fatura-donem?from=@From&amp;to=@To">Kesilen Faturalar</a>
    <a class="tab @(KiraSekmesi ? "active" : null)"
       href="/raporlar/fatura-donem?sekme=kira&amp;from=@From&amp;to=@To">Kira Faturalama Durumu</a>
</nav>

@if (!KiraSekmesi)
{
    <p class="muted">Dönem faturaları: tarih/vade/cari/tutar/durum (fatura tarihine göre).</p>

    <form method="get" class="grid-form">
        <label>Başlangıç<input name="from" type="date" value="@From" /></label>
        <label>Bitiş<input name="to" type="date" value="@To" /></label>
        <button type="submit">Göster</button>
    </form>

    <div class="table-scroll">
    <table class="grid tr-grid">
        <thead><tr><th>No</th><th>Tarih</th><th>Vade</th><th>Cari</th><th class="num">Toplam</th><th>Döviz</th><th>Durum</th><th>İade</th></tr></thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="8" class="muted">Bu aralıkta fatura yok.</td></tr>
            }
            @foreach (var r in _rows)
            {
                <tr>
                    <td>@r.No</td>
                    <td>@r.Tarih.ToString("yyyy-MM-dd")</td>
                    <td>@(r.VadeTarihi?.ToString("yyyy-MM-dd") ?? "—")</td>
                    <td>@r.Cari</td>
                    <td class="num">@r.GenelToplam.ToString("N2")</td>
                    <td>@(r.Currency == "TRY" ? "TL" : $"{r.Currency} @ {r.Kur.ToString("N4")} → {(r.GenelToplam * r.Kur).ToString("N2")} TL")</td>
                    <td>@r.Durum</td>
                    <td>@(r.IadeMi ? "Evet" : "")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
else
{
    <p class="muted small">Dönemle <strong>kesişen</strong> kiralar (başlangıcı dönemden önce olsa da
        bitişi dönem içindeyse listelenir) ve her birinin faturalanma durumu. "Faturalanan" kuralı
        fatura ekranıyla aynıdır: kiranın base faturası veya fark/dönem faturası — İptal ve iade hariç.
        Tutar iade-netlidir, baz parada (kur uygulanmış).</p>

    <div class="filter-panel">
    <form method="get" class="filter-bar">
        <input type="hidden" name="sekme" value="kira" />
        <label>Başlangıç<input name="from" type="date" value="@From" /></label>
        <label>Bitiş<input name="to" type="date" value="@To" /></label>
        <label>Cari / Sözleşme / Plaka<input name="q" value="@Q" placeholder="Ara" /></label>
        <label>Fatura Durumu
            <select name="faturaDurum">
                <option value="" selected="@(FaturaDurum is null or "")">Hepsi</option>
                <option value="yok" selected="@(FaturaDurum == "yok")">Faturalanmamış</option>
                <option value="var" selected="@(FaturaDurum == "var")">Faturalanmış</option>
            </select>
        </label>
        <label>İşlem Şube
            <select name="sube">
                <option value="">Tümü</option>
                @foreach (var s in _branches)
                {
                    <option value="@s.Id" selected="@(Sube == s.Id.ToString())">@s.Ad</option>
                }
            </select>
        </label>
        <button type="submit">Göster</button>
        <a href="/raporlar/fatura-donem?sekme=kira" class="link">Temizle</a>
    </form>
    </div>

    <div class="cards">
        <div class="card">
            <div class="card-num">@_rentalRows.Count(k => !k.Faturalanan)</div>
            <div class="card-label">Faturalanmamış Kira</div>
        </div>
        <div class="card">
            <div class="card-num">@_rentalRows.Count(k => k.Faturalanan)</div>
            <div class="card-label">Faturalanmış Kira</div>
        </div>
        <div class="card">
            <div class="card-num">@_rentalRows.Sum(k => k.FaturalananTutar).ToString("N2")</div>
            <div class="card-label">Faturalanan Tutar ₺</div>
        </div>
    </div>

    <div class="table-scroll">
    <table class="grid tr-grid">
        <thead>
            <tr><th>Kayıt No</th><th>Plaka</th><th>Cari</th><th>Baş. Tarih</th><th>Bit. Tarih</th>
                <th>Kira Durumu</th><th>Çıkış Ofisi</th><th>Faturalanan</th><th class="num">Fatura Adet</th>
                <th class="num">Faturalanan Tutar ₺</th></tr>
        </thead>
        <tbody>
            @if (_rentalRows.Count == 0)
            {
                <tr><td colspan="10" class="muted">Bu süzgeçle kira yok.</td></tr>
            }
            @foreach (var k in _rentalRows)
            {
                <tr>
                    <td><a href="/kiralar/@k.RentalId">@k.SozlesmeNo</a></td>
                    <td>@k.Plaka</td>
                    <td>@k.Cari</td>
                    <td>@k.BasTar.ToString("yyyy-MM-dd")</td>
                    <td>@k.BitTar.ToString("yyyy-MM-dd")</td>
                    <td>@k.Durum</td>
                    <td>@(k.Ofis ?? "—")</td>
                    <td>
                        @if (k.Faturalanan)
                        {
                            <span class="badge ok">Evet</span>
                        }
                        else
                        {
                            <span class="badge warn">Hayır</span>
                        }
                    </td>
                    <td class="num">@k.FaturaAdet</td>
                    <td class="num">@k.FaturalananTutar.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? To { get; set; }
    [SupplyParameterFromQuery(Name = "sekme")] public string? Sekme { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "faturaDurum")] public string? FaturaDurum { get; set; }
    [SupplyParameterFromQuery(Name = "sube")] public string? Sube { get; set; }

    private IReadOnlyList<FaturaDonemRow> _rows = [];
    private IReadOnlyList<KiraFaturaDurumRow> _rentalRows = [];
    private IReadOnlyList<Branch> _branches = [];

    private bool KiraSekmesi => string.Equals(Sekme, "kira", StringComparison.OrdinalIgnoreCase);

    /// <summary>Export bağlantısı ekrandaki süzgeci AYNEN taşır (görünen ≠ inen olmasın).</summary>
    private string KiraQuery =>
        $"from={Uri.EscapeDataString(From ?? "")}&to={Uri.EscapeDataString(To ?? "")}" +
        $"&q={Uri.EscapeDataString(Q ?? "")}&faturaDurum={Uri.EscapeDataString(FaturaDurum ?? "")}" +
        $"&sube={Uri.EscapeDataString(Sube ?? "")}";

    protected override async Task OnInitializedAsync()
    {
        var from = ParseDate(From);
        var to = ParseDate(To)?.AddDays(1).AddTicks(-1);

        if (!KiraSekmesi)
        {
            _rows = await Reports.GetInvoicePeriodAsync(from, to);
            return;
        }

        _branches = await Branches.ListActiveAsync();
        _rentalRows = await Reports.GetRentalInvoiceStatusAsync(from, to, new KiraFaturaDurumFilter
        {
            Q = string.IsNullOrWhiteSpace(Q) ? null : Q,
            Faturalanan = FaturaDurum switch { "yok" => false, "var" => true, _ => null },
            SubeId = Guid.TryParse(Sube, out var sid) ? sid : null
        });
    }

    private static DateTimeOffset? ParseDate(string? s)
        => DateTimeOffset.TryParse(s, out var d) ? new DateTimeOffset(d.Date, TimeSpan.Zero) : null;
}
