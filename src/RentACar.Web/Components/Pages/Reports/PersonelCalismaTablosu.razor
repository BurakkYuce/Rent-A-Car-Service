@page "/raporlar/personel-calisma"
@attribute [Authorize(Roles = "Admin,Yonetici,Operator,Muhasebe")]
@inject StaffShiftService Vardiyalar
@inject PersonnelService Personeller
@inject BranchService Subeler

<PageTitle>Personel Çalışma (Vardiya) — RentPro</PageTitle>

<div class="page-head"><h1>Personel Çalışma Grafiği (Vardiya)</h1></div>
@* CRM'deki "Personel Çalışma (BAF)" araç TAHSİS sayısını gösterir — bambaşka bir metrik.
   İki ekranın karışmaması için başlıklar ayrıştırıldı. *@
<p class="muted small">Personelin hangi gün, hangi şubede, hangi saatler arasında çalıştığı.
    Bölünmüş mesai serbest (aynı güne birden çok vardiya); <strong>gece vardiyası</strong>
    (22:00-06:00) desteklenir ve <strong>(+1)</strong> ile gösterilir. Aynı personel için
    <strong>çakışan</strong> vardiya kabul edilmez.</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<form method="get" class="filter-bar">
    <label>Başlangıç<input name="bas" type="date" value="@_start.ToString("yyyy-MM-dd")" /></label>
    <label>Bitiş<input name="bit" type="date" value="@_bit.ToString("yyyy-MM-dd")" /></label>
    <label>Personel
        <select name="personelFiltre">
            <option value="">— tümü —</option>
            @foreach (var p in _personnel)
            {
                <option value="@p.Id" selected="@(p.Id.ToString() == PersonelFiltre)">@p.Ad @p.Soyad</option>
            }
        </select>
    </label>
    <label>Şube
        <select name="subeFiltre">
            <option value="">— tümü —</option>
            @foreach (var s in _branches) { <option value="@s" selected="@(s == SubeFiltre)">@s</option> }
        </select>
    </label>
    <button type="submit">Göster</button>
</form>

<p class="muted small">
    @_start.ToString("dd.MM.yyyy") - @_bit.ToString("dd.MM.yyyy") · @_matrix.Gunler.Count gün ·
    @_matrix.Satirlar.Count personel · @_matrix.ToplamVardiya vardiya ·
    toplam @ShiftFormat.HourText(_matrix.ToplamDk)
    @if (_truncated)
    {
        <span class="warn"> · aralık @StaffShiftService.MaxDays güne kırpıldı</span>
    }
</p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead>
        <tr>
            <th>Personel</th>
            @foreach (var g in _matrix.Gunler)
            {
                <th class="@(g.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? "muted" : null)">
                    @g.ToString("dd.MM")<br /><span class="small">@DayShort(g)</span>
                </th>
            }
            <th class="num">Toplam</th>
        </tr>
    </thead>
    <tbody>
        @if (_matrix.Satirlar.Count == 0)
        {
            <tr><td colspan="@(_matrix.Gunler.Count + 2)" class="muted">Bu aralıkta vardiya kaydı yok.</td></tr>
        }
        @foreach (var row in _matrix.Satirlar)
        {
            <tr>
                <td>@row.PersonelAd</td>
                @foreach (var g in _matrix.Gunler)
                {
                    <td>
                        @if (row.Gunler.TryGetValue(g, out var shifts))
                        {
                            @foreach (var v in shifts)
                            {
                                <div class="mono small" title="@CellHint(v)">@ShiftFormat.Range(v)</div>
                            }
                        }
                        else
                        {
                            <span class="muted">—</span>
                        }
                    </td>
                }
                <td class="num">@row.ToplamSaatMetni</td>
            </tr>
        }
    </tbody>
</table>
</div>

<h2 class="dash-h2">@(_edit is null ? "Vardiya Ekle" : "Vardiyayı Düzenle")</h2>
<form method="post" action="@(_edit is null ? "/raporlar/personel-calisma/create" : "/raporlar/personel-calisma/update")" class="grid-form"><AntiforgeryToken />
    @if (_edit is not null)
    {
        <input type="hidden" name="id" value="@_edit.Id" />
    }
    @* Görüntülenen pencere hidden olarak taşınır — kaydettikten sonra kullanıcı aynı haftada kalır. *@
    <input type="hidden" name="bas" value="@_start.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="bit" value="@_bit.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="personelFiltre" value="@PersonelFiltre" />
    <input type="hidden" name="subeFiltre" value="@SubeFiltre" />

    <label>Personel
        <select name="personelId" required>
            <option value="">—</option>
            @foreach (var p in _personnel)
            {
                <option value="@p.Id" selected="@(p.Id == _edit?.PersonelId)">@p.Ad @p.Soyad</option>
            }
        </select>
    </label>
    <label>Tarih<input name="tarih" type="date" required
        value="@((_edit?.Tarih ?? _start).ToString("yyyy-MM-dd"))" /></label>
    <label>Başlangıç<input name="baslangicSaat" type="time" required
        value="@(_edit?.BaslangicSaat.ToString("HH\\:mm") ?? "08:00")" /></label>
    <label>Bitiş<input name="bitisSaat" type="time" required
        value="@(_edit?.BitisSaat.ToString("HH\\:mm") ?? "18:00")" /></label>
    <label>Şube
        <select name="sube">
            <option value="">—</option>
            @foreach (var s in _branches) { <option value="@s" selected="@(s == _edit?.Sube)">@s</option> }
        </select>
    </label>
    <label class="u-col-full">Açıklama<input name="aciklama" value="@_edit?.Aciklama" maxlength="512" /></label>
    <button type="submit">@(_edit is null ? "Ekle" : "Kaydet")</button>
    @if (_edit is not null)
    {
        <a href="@Back()" class="btn-secondary">İptal</a>
    }
</form>

<h2 class="dash-h2">Vardiya Listesi</h2>
<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Personel</th><th>Tarih</th><th>Saat</th><th class="num">Süre</th><th>Şube</th><th>Kadro Şubesi</th><th>Açıklama</th><th></th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="8" class="muted">Kayıt yok.</td></tr>
        }
        @foreach (var r in _list)
        {
            <tr>
                <td>@r.PersonelAd</td>
                <td>@r.Vardiya.Tarih.ToString("dd.MM.yyyy")</td>
                <td class="mono">@ShiftFormat.Range(r.Vardiya)</td>
                <td class="num">@ShiftFormat.HourText(r.Vardiya.SureDk)</td>
                <td>@(r.Vardiya.Sube ?? "—")</td>
                @* Kadro şubesi bilgi amaçlı: vardiya şubesinden FARKLI olabilir (rotasyon/destek). *@
                <td class="muted">@(r.PersonelKadroSube ?? "—")</td>
                <td>@(r.Vardiya.Aciklama ?? "—")</td>
                <td>
                    <a href="@Back(r.Vardiya.Id)" class="link">Düzenle</a>
                    <form method="post" action="/raporlar/personel-calisma/delete" data-confirm="Vardiya silinsin mi?" class="inline"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@r.Vardiya.Id" />
                        <input type="hidden" name="bas" value="@_start.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="bit" value="@_bit.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="personelFiltre" value="@PersonelFiltre" />
                        <input type="hidden" name="subeFiltre" value="@SubeFiltre" />
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }
    [SupplyParameterFromQuery(Name = "personelFiltre")] public string? PersonelFiltre { get; set; }
    [SupplyParameterFromQuery(Name = "subeFiltre")] public string? SubeFiltre { get; set; }
    [SupplyParameterFromQuery(Name = "duzenle")] public Guid? Duzenle { get; set; }
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private VardiyaMatris _matrix = new([], [], 0, 0);
    private IReadOnlyList<VardiyaSatir> _list = [];
    private IReadOnlyList<PersonelSecim> _personnel = [];
    private string[] _branches = [];
    private PersonelVardiya? _edit;
    private DateOnly _start, _bit;
    private bool _truncated;

    private static string DayShort(DateOnly g) => g.DayOfWeek switch
    {
        DayOfWeek.Monday => "Pzt", DayOfWeek.Tuesday => "Sal", DayOfWeek.Wednesday => "Çar",
        DayOfWeek.Thursday => "Per", DayOfWeek.Friday => "Cum", DayOfWeek.Saturday => "Cmt", _ => "Paz"
    };

    /// <summary>Matris hücresi ipucu: şube (+ varsa açıklama) — hücre dar olduğu için tam metin burada.</summary>
    private static string CellHint(PersonelVardiya v)
    {
        var s = v.Sube ?? "şube belirtilmemiş";
        return string.IsNullOrWhiteSpace(v.Aciklama) ? s : $"{s} — {v.Aciklama}";
    }

    /// <summary>Aynı pencere/filtreye dönüş bağlantısı (düzenle/iptal).</summary>
    private string Back(Guid? edit = null)
    {
        var q = new List<string>
        {
            $"bas={_start:yyyy-MM-dd}", $"bit={_bit:yyyy-MM-dd}"
        };
        if (!string.IsNullOrWhiteSpace(PersonelFiltre)) q.Add($"personelFiltre={Uri.EscapeDataString(PersonelFiltre)}");
        if (!string.IsNullOrWhiteSpace(SubeFiltre)) q.Add($"subeFiltre={Uri.EscapeDataString(SubeFiltre)}");
        if (edit is Guid id) q.Add($"duzenle={id}");
        return "/raporlar/personel-calisma?" + string.Join("&", q);
    }

    protected override async Task OnInitializedAsync()
    {
        // Personel dropdown'u PII'sız uç (ListAsync ManageUsers ister → Operatör rolünde patlar).
        _personnel = await Personeller.ListForSelectAsync();
        _branches = (await Subeler.ListActiveAsync()).Select(b => b.Ad).OrderBy(a => a).ToArray();

        var filter = new VardiyaFilter
        {
            Bas = DateOnly.TryParse(Bas, out var b) ? b : null,
            Bit = DateOnly.TryParse(Bit, out var t) ? t : null,
            PersonelId = Guid.TryParse(PersonelFiltre, out var pid) ? pid : null,
            Sube = SubeFiltre
        };
        // Sunucu pencereyi düzeltebilir (ters aralık, tavan) — sayfa GERÇEKTEN gösterileni yazar.
        (_start, _bit) = StaffShiftService.Window(filter);
        _truncated = filter.Bas is { } fb && filter.Bit is { } fEnd
            && Math.Abs(fEnd.DayNumber - fb.DayNumber) + 1 > StaffShiftService.MaxDays;

        _matrix = await Vardiyalar.MatrixAsync(filter);
        _list = await Vardiyalar.ListAsync(filter);

        if (Duzenle is { } id) _edit = await Vardiyalar.GetAsync(id);
    }
}
