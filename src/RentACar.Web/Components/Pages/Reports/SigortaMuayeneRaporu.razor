@page "/raporlar/sigorta-muayene"
@attribute [Authorize(Roles = "Admin,Yonetici,Operator,Muhasebe")]
@inject ReportService Reports

<PageTitle>Sigorta / Muayene Envanteri — RentPro</PageTitle>

<div class="page-head"><h1>Sigorta / Muayene Belge Envanteri</h1></div>
@* /vade panosunun YERİNE GEÇMEZ: orası "yaklaşan vadeler" akışıdır (kova + kalan gün), burası
   araç bazlı BELGE ENVANTERİ — her araç bir satır, belgesi olmayan araç da görünür. *@
<p class="muted small">Her araç için Trafik / Kasko / Muayene / MTV / Z-İzni / Seyrüsefer bilgisi
    <strong>tek satırda</strong>. Belgesi olmayan araç da listelenir — eksik belge bu raporun asıl
    konusudur. Yaklaşan vadeleri kova/kalan-gün olarak görmek için
    <a href="/vade">Vade Panosu</a>'nu kullanın; bu ekran onun yerine geçmez.</p>

<form method="get" class="filter-bar">
    <label>Tür
        <select name="tur">
            @foreach (var t in Enum.GetValues<InsuranceInspectionType>())
            {
                <option value="@t" selected="@(t.ToString() == Tur)">@(t == InsuranceInspectionType.Hepsi ? "— hepsi —" : t.ToString())</option>
            }
        </select>
    </label>
    <label>Bitiş En Geç<input name="engec" type="date" value="@EnGec" title="Seçilen türün bitişi bu tarihten önce olanlar" /></label>
    <label>Araç Sahibi
        <select name="sahip">
            <option value="">— tümü —</option>
            @foreach (var o in _sahipOpts) { <option value="@o" selected="@(o == Sahip)">@o</option> }
        </select>
    </label>
    <label>Plaka<input name="plaka" value="@Plaka" placeholder="34 AB (boşluk serbest)" /></label>
    <button type="submit">Filtrele</button>
    @if (FiltreVar) { <a class="link" href="/raporlar/sigorta-muayene">Temizle</a> }
</form>

<p class="muted small">@_rows.Count araç@(FiltreVar ? " (filtreli)" : "") ·
    @_rows.Count(r => r.TrafikBitis is null) trafik yok ·
    @_rows.Count(r => r.MuayeneBitis is null) muayene yok ·
    @_rows.Count(r => !r.MtvOdendi && r.MtvVade is not null) MTV borçlu</p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Plaka</th><th>Marka</th><th>Tipi</th><th class="num">Yılı</th><th>Yakıt</th><th>Vites</th>
        <th>Grup</th><th>Şube</th><th>Araç Sahibi</th><th>Şasi No</th><th>Motor No</th>
        <th>Belge No</th><th>Kimde</th>
        <th>Trafik</th><th>Kasko</th><th>Muayene</th><th>MTV Vade</th><th>MTV</th>
        <th>Z-İzni</th><th>Seyrüsefer</th></tr></thead>
    <tbody>
        @if (_rows.Count == 0)
        {
            <tr><td colspan="20" class="muted">@(FiltreVar ? "Filtreye uyan araç yok." : "Araç yok.")</td></tr>
        }
        @foreach (var r in _rows)
        {
            <tr>
                <td class="mono">@r.Plaka</td>
                <td>@r.Marka</td>
                <td>@r.Tip</td>
                <td class="num">@(r.ModelYili?.ToString() ?? "—")</td>
                <td>@(r.Yakit ?? "—")</td>
                <td>@(r.Vites ?? "—")</td>
                <td>@(r.Grup ?? "—")</td>
                <td>@(r.Sube ?? "—")</td>
                <td>@(r.AracSahibi ?? "—")</td>
                <td class="mono small">@(r.SasiNo ?? "—")</td>
                <td class="mono small">@(r.MotorNo ?? "—")</td>
                <td>@(r.BelgeNo ?? "—")</td>
                <td>@(r.Kimde ?? "—")</td>
                <td class="@Sinif(r.TrafikBitis)">@Tarih(r.TrafikBitis)</td>
                <td class="@Sinif(r.KaskoBitis)">@Tarih(r.KaskoBitis)</td>
                <td class="@Sinif(r.MuayeneBitis)">@Tarih(r.MuayeneBitis)</td>
                <td class="@Sinif(r.MtvVade)">@Tarih(r.MtvVade)</td>
                <td>
                    @if (r.MtvVade is null) { <span class="muted">—</span> }
                    else
                    {
                        <span class="status-pill @(r.MtvOdendi ? "sp-success" : "sp-warn")">@(r.MtvOdendi ? "Ödendi" : "Borçlu")</span>
                    }
                </td>
                @* Z-izni: BAYRAK "var mı", TARİH "ne zamana kadar" — ikisi farklı soru, ikisi de gösteriliyor. *@
                <td class="@Sinif(r.ZIzniBitis)">@(r.ZIzni ? "Var " : "")@Tarih(r.ZIzniBitis)</td>
                <td class="@Sinif(r.SeyrusiferBitis)">@Tarih(r.SeyrusiferBitis)</td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tur")] public string? Tur { get; set; }
    [SupplyParameterFromQuery(Name = "engec")] public string? EnGec { get; set; }
    [SupplyParameterFromQuery(Name = "sahip")] public string? Sahip { get; set; }
    [SupplyParameterFromQuery(Name = "plaka")] public string? Plaka { get; set; }

    private IReadOnlyList<SigortaMuayeneRow> _rows = [];
    private string[] _sahipOpts = [];

    private bool FiltreVar => (!string.IsNullOrWhiteSpace(Tur) && Tur != nameof(InsuranceInspectionType.Hepsi))
        || !string.IsNullOrWhiteSpace(EnGec) || !string.IsNullOrWhiteSpace(Sahip) || !string.IsNullOrWhiteSpace(Plaka);

    private static string Tarih(DateTimeOffset? d) => d?.LocalDateTime.ToString("dd.MM.yyyy") ?? "—";

    /// <summary>Geçmiş vade kırmızı, 30 günden yakın sarı. Boş belge nötr — "yok" bir vade değildir.</summary>
    private static string? Sinif(DateTimeOffset? d)
    {
        if (d is not { } t) return "muted";
        var kalan = (t.UtcDateTime.Date - DateTimeOffset.UtcNow.UtcDateTime.Date).Days;
        return kalan < 0 ? "neg" : kalan <= 30 ? "warn" : null;
    }

    protected override async Task OnInitializedAsync()
    {
        _rows = await Reports.GetInsuranceInspectionAsync(new SigortaMuayeneFilter
        {
            Tur = Enum.TryParse<InsuranceInspectionType>(Tur, out var t) ? t : InsuranceInspectionType.Hepsi,
            AracSahibi = Sahip,
            Plaka = Plaka,
            BitisEnGec = DateTimeOffset.TryParse(EnGec, out var e)
                ? new DateTimeOffset(e.Date, TimeSpan.Zero).AddDays(1).AddTicks(-1) : null
        });

        // Sahip seçenekleri FİLTRESİZ listeden; filtrelenmişten türetilseydi bir seçim sonrası
        // diğer sahipler kaybolur ve filtre kendini kilitlerdi.
        _sahipOpts = (await Reports.GetInsuranceInspectionAsync()).Select(r => r.AracSahibi)
            .Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim())
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .OrderBy(x => x, StringComparer.CurrentCulture).ToArray();
    }
}
