@page "/raporlar/karsilastirmali-analiz"
@attribute [Authorize(Roles = "Admin,Yonetici,Muhasebe,Operator")]
@inject ReportService Reports
@inject LocationService Ofisler

<PageTitle>Karşılaştırmalı Durum Analizi — RentPro</PageTitle>

<div class="page-head">
    <h1>Karşılaştırmalı Durum Analizi</h1>
    <div class="actions">
        <a href="/raporlar/export/karsilastirmali-analiz?@Qs("excel")">Excel</a> ·
        <a href="/raporlar/export/karsilastirmali-analiz?@Qs("csv")">CSV</a> ·
        <a href="/raporlar/export/karsilastirmali-analiz?@Qs("pdf")">PDF</a>
    </div>
</div>
<p class="muted small">Kira/rezervasyon <strong>hacmini</strong> aylık kolonlarda karşılaştırır.
    Bu rapor <strong>tutar üretmez</strong> — yalnız adet ya da gün sayar; ciro/kâr için Gelir-Gider
    ve Kârlılık raporlarına bakın. İptal edilmiş kayıtlar sayılmaz.</p>

<form method="get" class="filter-bar">
    <label>Tablo
        <select name="tablo">
            <option value="Kira" selected="@(Tablo != "Rezervasyon")">Kira</option>
            <option value="Rezervasyon" selected="@(Tablo == "Rezervasyon")">Rezervasyon</option>
        </select>
    </label>
    <label>Veri Türü
        <select name="veri">
            <option value="Adet" selected="@(Veri != "Gun")">Adet</option>
            <option value="Gun" selected="@(Veri == "Gun")">Gün</option>
        </select>
    </label>
    <label>Kırılım
        <select name="kirilim">
            <option value="AracGrubu" selected="@(Kirilim != "RezKaynagi" && Kirilim != "CikisNoktasi")">Araç Grubu</option>
            <option value="RezKaynagi" selected="@(Kirilim == "RezKaynagi")">Rezervasyon Kaynağı</option>
            <option value="CikisNoktasi" selected="@(Kirilim == "CikisNoktasi")">Çıkış Noktası</option>
        </select>
    </label>
    <label>İşlem Şube
        <select name="ofis">
            <option value="">— tümü —</option>
            @foreach (var o in _offices) { <option value="@o" selected="@(o == Ofis)">@o</option> }
        </select>
    </label>
    <label>Başlangıç ≥<input name="bas" type="date" value="@Bas" /></label>
    <label>Başlangıç ≤<input name="bit" type="date" value="@Bit" /></label>
    <button type="submit">Göster</button>
    @if (FiltreVar) { <a class="link" href="/raporlar/karsilastirmali-analiz">Temizle</a> }
</form>

<p class="muted small">@_d.Satirlar.Count satır · @_d.AyAnahtarlari.Count ay ·
    Genel toplam <strong>@_d.GenelToplam.ToString("N0")</strong>
    (@(_d.VeriTuru == "Gun" ? "gün" : "adet"))</p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead>
        <tr>
            <th>@KirilimBaslik</th>
            @foreach (var month in _d.AyAnahtarlari) { <th class="num">@MonthLabel(month)</th> }
            <th class="num">Toplam</th>
        </tr>
    </thead>
    <tbody>
        @if (_d.Satirlar.Count == 0)
        {
            <tr><td colspan="@(_d.AyAnahtarlari.Count + 2)" class="muted">Seçilen aralıkta kayıt yok.</td></tr>
        }
        @foreach (var sell in _d.Satirlar)
        {
            <tr>
                <td>@sell.Kirilim</td>
                @foreach (var month in _d.AyAnahtarlari)
                {
                    var v = sell.Month(month);
                    <td class="num">@(v == 0m ? "" : v.ToString("N0"))</td>
                }
                <td class="num"><strong>@sell.Toplam.ToString("N0")</strong></td>
            </tr>
        }
        @if (_d.Satirlar.Count > 0)
        {
            <tr>
                <td><strong>Toplam</strong></td>
                @foreach (var month in _d.AyAnahtarlari)
                {
                    <td class="num"><strong>@_d.MonthTotal(month).ToString("N0")</strong></td>
                }
                <td class="num"><strong>@_d.GenelToplam.ToString("N0")</strong></td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tablo")] public string? Tablo { get; set; }
    [SupplyParameterFromQuery(Name = "veri")] public string? Veri { get; set; }
    [SupplyParameterFromQuery(Name = "kirilim")] public string? Kirilim { get; set; }
    [SupplyParameterFromQuery(Name = "ofis")] public string? Ofis { get; set; }
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }

    private KarsilastirmaliAnalizDto _d = new([], [], "Kira", "Adet", "AracGrubu");
    private string[] _offices = [];

    private bool FiltreVar => !string.IsNullOrWhiteSpace(Tablo) || !string.IsNullOrWhiteSpace(Veri)
        || !string.IsNullOrWhiteSpace(Kirilim) || !string.IsNullOrWhiteSpace(Ofis)
        || !string.IsNullOrWhiteSpace(Bas) || !string.IsNullOrWhiteSpace(Bit);

    private string KirilimBaslik => _d.Kirilim switch
    {
        "RezKaynagi" => "Rezervasyon Kaynağı",
        "CikisNoktasi" => "Çıkış Noktası",
        _ => "Araç Grubu"
    };

    protected override async Task OnInitializedAsync()
    {
        _offices = (await Ofisler.ListActiveAsync()).Select(o => o.Ad).OrderBy(a => a).ToArray();
        _d = await Reports.GetComparativeAnalysisAsync(new KarsilastirmaliAnalizFilter
        {
            Tablo = Tablo ?? "Kira",
            VeriTuru = Veri ?? "Adet",
            Kirilim = Kirilim ?? "AracGrubu",
            Ofis = Ofis,
            Bas = Date(Bas),
            // Üst sınır GÜN SONUNA genişletilir (tarih girişi 00:00'a düşer).
            Bit = Date(Bit)?.AddDays(1).AddTicks(-1)
        });
    }

    private static DateTimeOffset? Date(string? s)
        => DateTimeOffset.TryParse(s, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? d.ToUniversalTime() : null;

    /// <summary>"2026-08" → "08.2026" (grid başlığında kısa ve sıralanabilir kalsın).</summary>
    private static string MonthLabel(string key)
        => key.Length == 7 ? key[5..] + "." + key[..4] : key;

    private string Qs(string format)
    {
        var p = new List<string> { "format=" + format };
        void Add(string name, string? value)
        {
            if (!string.IsNullOrWhiteSpace(value)) p.Add($"{name}={Uri.EscapeDataString(value)}");
        }
        Add("tablo", Tablo); Add("veri", Veri); Add("kirilim", Kirilim);
        Add("ofis", Ofis); Add("bas", Bas); Add("bit", Bit);
        return string.Join("&", p);
    }
}
