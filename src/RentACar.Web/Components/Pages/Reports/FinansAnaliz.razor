@page "/raporlar/finans-analiz"
@attribute [Authorize(Policy = "izin:ViewReports")]
@inject ReportService Reports
@using RentACar.Web.Components.Shared.Charts

<PageTitle>Finans Analiz — RentPro</PageTitle>

<div class="page-head"><h1>Finans Analiz</h1></div>

<p class="muted small">Görsel finansal özet — tüm sayılar defterden (base TL, iade netlenmiş).
    12-ay trend ve 30-gün doluluk sabit pencere; kırılım/yaşlandırma/mutabakat aşağıdaki tarih filtresine uyar
    (boş = tüm zaman).</p>

@* 12-AY TREND — Gelir/Gider çubuk + Net Kâr çizgi (36 çubuk mobilde okunmaz → 24 çubuk + çizgi) *@
<div class="analiz-blok">
    <SvgBarChart Baslik="Son 12 Ay — Gelir / Gider / Net Kâr (₺)"
                 Etiketler="_monthLabels"
                 Seriler="_monthSeries"
                 CizgiSeri="_netProfitSeries"
                 Format="@(v => v.ToString("N0"))" />
</div>

<form method="get" class="grid-form">
    <label>Başlangıç<input name="from" type="date" value="@From" /></label>
    <label>Bitiş<input name="to" type="date" value="@To" /></label>
    <button type="submit">Göster</button>
</form>

<div class="report-cols">
    <div class="analiz-blok">
        <YatayKirilim Baslik="Gelir Kırılımı (₺)" Dilimler="_revenueBucket" Bos="Gelir yok."
                      Format="@(v => v.ToString("N0"))" />
    </div>
    <div class="analiz-blok">
        <YatayKirilim Baslik="Gider Kırılımı (₺)" Dilimler="_expenseBucket" Bos="Gider yok."
                      Format="@(v => v.ToString("N0"))" />
    </div>
</div>

<div class="report-cols">
    <div class="analiz-blok">
        <YatayKirilim Baslik="Cari Yaşlandırma — vadesi geçen alacak (₺)" Dilimler="_agingBucket" Bos="Alacak yok."
                      Format="@(v => v.ToString("N0"))" />
    </div>
    <div class="analiz-blok">
        <YatayKirilim Baslik="Fatura vs Tahsilat (₺)" Dilimler="_reconciliation" Bos="Kayıt yok."
                      Format="@(v => v.ToString("N0"))" />
        <p class="muted small">Fark (açık bakiye): <strong class="@(_difference > 0 ? "neg" : "pos")">@_difference.ToString("N2") ₺</strong>
            — pozitif = faturalanmış ama tahsil edilmemiş.</p>
    </div>
</div>

<div class="analiz-blok">
    <SvgLineArea Baslik="Son 30 Gün — Filo Doluluk (%)"
                 Etiketler="_occupancyDays" Degerler="_occupancyPercent" RenkIndeks="2"
                 Format="@(v => "%" + v.ToString("0.#"))" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? To { get; set; }

    private List<string> _monthLabels = [];
    private List<SvgSeri> _monthSeries = [];
    private SvgSeri? _netProfitSeries;
    private List<SvgDilim> _revenueBucket = [], _expenseBucket = [], _agingBucket = [], _reconciliation = [];
    private decimal _difference;
    private List<string> _occupancyDays = [];
    private List<decimal> _occupancyPercent = [];

    protected override async Task OnInitializedAsync()
    {
        // 12-ay trend (sabit pencere — filtreden bağımsız).
        var trend = await Reports.GetMonthlyRevenueExpenseTrendAsync(12);
        _monthLabels = trend.Select(t => t.AyBas.ToString("MM.yy")).ToList();
        _monthSeries =
        [
            new SvgSeri("Gelir", trend.Select(t => t.Gelir).ToList(), 1),   // dv-1 amber
            new SvgSeri("Gider", trend.Select(t => t.Gider).ToList(), 6),   // dv-6 gri
        ];
        _netProfitSeries = new SvgSeri("Net Kâr", trend.Select(t => t.NetKar).ToList(), 2); // dv-2 mavi çizgi

        // Dönem analizi (tarih filtresi — GelirGider ile aynı yorum: boş = tüm zaman).
        var from = ParseDate(From);
        var to = ParseDate(To)?.AddDays(1).AddTicks(-1);
        var gg = await Reports.GetRevenueExpenseAsync(from, to);
        _revenueBucket = gg.GelirKirilim.Select((k, i) => new SvgDilim(SourceName(k.SourceType), k.Tutar, ColorOrder(i))).ToList();
        _expenseBucket = gg.GiderKirilim.Select((k, i) => new SvgDilim(SourceName(k.SourceType), k.Tutar, ColorOrder(i))).ToList();

        // Yaşlandırma: kova toplamları (tüm cariler; asOf = filtre bitişi ya da şimdi).
        var aging = await Reports.GetAgingAsync(to ?? DateTimeOffset.UtcNow);
        _agingBucket =
        [
            new SvgDilim("0–30 gün", aging.Sum(a => a.B0_30), 3),
            new SvgDilim("31–60 gün", aging.Sum(a => a.B31_60), 1),
            new SvgDilim("61–90 gün", aging.Sum(a => a.B61_90), 5),
            new SvgDilim("90+ gün", aging.Sum(a => a.B90Plus), 6),
        ];

        // Fatura vs tahsilat mutabakatı.
        var tf = await Reports.GetCollectionInvoiceAsync(from, to);
        _reconciliation =
        [
            new SvgDilim($"Fatura ({tf.FaturaAdet})", tf.FaturaToplam, 2),
            new SvgDilim($"Tahsilat ({tf.TahsilatAdet})", tf.TahsilatToplam, 3),
        ];
        _difference = tf.Fark;

        // Son 30 gün doluluk (günlük tarihsel seri).
        var today = DateTimeOffset.UtcNow.Date;
        var tracking = await Reports.GetVehicleStatusTrackingAsync(
            new DateTimeOffset(today.AddDays(-29), TimeSpan.Zero), new DateTimeOffset(today, TimeSpan.Zero));
        _occupancyDays = tracking.Select(g => g.Gun.ToString("dd.MM")).ToList();
        _occupancyPercent = tracking.Select(g => g.ToplamArac == 0 ? 0m : Math.Round(100m * g.Dolu / g.ToplamArac, 1)).ToList();
    }

    private static DateTimeOffset? ParseDate(string? s)
        => DateTimeOffset.TryParse(s, out var d) ? d : null;

    /// <summary>Kırılım satır rengi — dataviz paletinde sırayla döner (1..6).</summary>
    private static int ColorOrder(int i) => (i % 6) + 1;

    private static string SourceName(string sourceType) => sourceType switch
    {
        "Fatura" => "Fatura",
        "AracSatis" => "Araç Satış",
        "Ceza" => "Ceza Yansıtma",
        "Hgs" => "HGS Yansıtma",
        "Gider" => "Gider",
        _ => sourceType
    };
}
