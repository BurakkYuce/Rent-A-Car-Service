@page "/raporlar/tahsilat-fatura"
@attribute [Authorize(Roles = "Admin,Yonetici,Muhasebe")]
@inject ReportService Reports

<PageTitle>Tahsilat-Fatura Mutabakatı — RentPro</PageTitle>

<div class="page-head">
    <h1>Tahsilat-Fatura Mutabakatı</h1>
    <div class="actions">
        <a href="/raporlar/export/tahsilat-fatura?format=excel&amp;from=@From&amp;to=@To">Excel</a> ·
        <a href="/raporlar/export/tahsilat-fatura?format=csv&amp;from=@From&amp;to=@To">CSV</a>
    </div>
</div>
<p class="muted small">Seçilen dönemde kesilen fatura toplamı (İptal hariç) ile alınan tahsilat
    toplamı (ters kayıt hariç) ve fark. Fark = Fatura − Tahsilat (pozitif = tahsil edilmemiş bakiye).</p>

<form method="get" class="grid-form">
    <label>Başlangıç<input name="from" type="date" value="@From" /></label>
    <label>Bitiş<input name="to" type="date" value="@To" /></label>
    <button type="submit">Göster</button>
</form>

<div class="cards">
    <div class="card">
        <div class="card-num">@_data.FaturaAdet</div>
        <div class="card-label">Fatura Adedi</div>
    </div>
    <div class="card">
        <div class="card-num neg">@_data.FaturaToplam.ToString("N2")</div>
        <div class="card-label">Fatura Toplam ₺</div>
    </div>
    <div class="card">
        <div class="card-num">@_data.TahsilatAdet</div>
        <div class="card-label">Tahsilat Adedi</div>
    </div>
    <div class="card">
        <div class="card-num pos">@_data.TahsilatToplam.ToString("N2")</div>
        <div class="card-label">Tahsilat Toplam ₺</div>
    </div>
    <div class="card">
        <div class="card-num @(_data.Fark > 0 ? "neg" : "pos")">@_data.Fark.ToString("N2")</div>
        <div class="card-label">Fark (Fatura − Tahsilat) ₺</div>
    </div>
</div>

@* FAZ-68 — SÖZLEŞME-SATIRI mutabakat modu. Yukarıdaki dönem-toplamı görünümü DEĞİŞMEDİ;
   bu onun yerine geçmiyor, yanına ekleniyor. *@
<h2 class="dash-h2">Sözleşme Bazlı Mutabakat</h2>
<p class="muted small">Her satır bir kira sözleşmesi: ne kadar borçlandı, ne kadarı faturalandı,
    ne kadarı tahsil edildi. <strong>Ayrım</strong> kolonu, sözleşme satırındaki tahsilat ile kasa
    hareketlerinden yeniden toplanan tahsilatın farkıdır — <strong>sıfır olmalıdır</strong>;
    sıfırdan farklıysa o sözleşmede bir tutarsızlık vardır.</p>

<form method="get" class="filter-bar">
    <input type="hidden" name="from" value="@From" />
    <input type="hidden" name="to" value="@To" />
    <label>Ara<input name="ara" value="@Ara" placeholder="sözleşme no / plaka / müşteri" /></label>
    <label>Durum
        <select name="durum">
            <option value="">— tümü —</option>
            @foreach (var d in Enum.GetValues<RentACar.Domain.Enums.RentalStatus>())
            { <option value="@d" selected="@(d.ToString() == Durum)">@d</option> }
        </select>
    </label>
    <label>Bakiye
        <select name="bakiye">
            <option value="" selected="@(string.IsNullOrEmpty(BakiyeDurumu))">— tümü —</option>
            <option value="acik" selected="@(BakiyeDurumu == "acik")">Bakiyesi olanlar</option>
            <option value="kapali" selected="@(BakiyeDurumu == "kapali")">Kapanmış</option>
        </select>
    </label>
    <label>Tutarsızlık
        <select name="tutarsiz">
            <option value="" selected="@(Tutarsiz != "1")">Tümü</option>
            <option value="1" selected="@(Tutarsiz == "1")">Yalnız tutarsız satırlar</option>
        </select>
    </label>
    <button type="submit">Filtrele</button>
</form>

<p class="muted small">@_satirlar.Count sözleşme · @_satirlar.Count(x => x.Tutarsiz) tutarsız ·
    Borç @_satirlar.Sum(x => x.GenelToplam).ToString("N2") ·
    Faturalanan @_satirlar.Sum(x => x.Faturalanan).ToString("N2") ·
    Tahsilat @_satirlar.Sum(x => x.Tahsilat).ToString("N2")</p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead>
        <tr><th>Sözleşme No</th><th>Plaka</th><th>Müşteri</th><th>Başlangıç</th><th>Durum</th><th>Döviz</th>
            <th class="num">Matrah</th><th class="num">Damga</th><th class="num">Genel Toplam</th>
            <th class="num">Faturalanan</th><th class="num">Fatura Farkı</th>
            <th class="num">Tahsilat</th><th class="num">Bakiye</th><th class="num">Ayrım</th>
            <th class="num">Müşteri Bakiyesi</th></tr>
    </thead>
    <tbody>
        @if (_satirlar.Count == 0)
        {
            <tr><td colspan="15" class="muted">Sözleşme yok.</td></tr>
        }
        @foreach (var x in _satirlar)
        {
            <tr>
                <td class="mono">@x.SozlesmeNo</td>
                <td>@(x.Plaka ?? "—")</td>
                <td>@x.MusteriAd</td>
                <td>@x.BasTar.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td>@x.Durum</td>
                <td>@x.Doviz</td>
                <td class="num">@x.Matrah.ToString("N2")</td>
                <td class="num">@(x.DamgaVergisi == 0m ? "" : x.DamgaVergisi.ToString("N2"))</td>
                <td class="num">@x.GenelToplam.ToString("N2")</td>
                <td class="num">@x.Faturalanan.ToString("N2")</td>
                <td class="num @(x.FaturaFarki > 0 ? "neg" : null)">@(x.FaturaFarki == 0m ? "" : x.FaturaFarki.ToString("N2"))</td>
                <td class="num">@x.Tahsilat.ToString("N2")</td>
                <td class="num @(x.Bakiye > 0 ? "neg" : "pos")">@x.Bakiye.ToString("N2")</td>
                <td class="num">
                    @if (x.Tutarsiz)
                    {
                        <span class="status-pill sp-danger">@x.TahsilatAyrimi.ToString("N2")</span>
                    }
                    else
                    {
                        <span class="muted">0,00</span>
                    }
                </td>
                <td class="num">@x.MusteriBakiye.ToString("N2")</td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? To { get; set; }
    [SupplyParameterFromQuery(Name = "ara")] public string? Ara { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }
    [SupplyParameterFromQuery(Name = "bakiye")] public string? BakiyeDurumu { get; set; }
    [SupplyParameterFromQuery(Name = "tutarsiz")] public string? Tutarsiz { get; set; }

    private TahsilatFaturaDto _data = new(0, 0m, 0, 0m, 0m);
    private IReadOnlyList<TahsilatMutabakatRowDto> _satirlar = [];

    protected override async Task OnInitializedAsync()
    {
        var from = ParseDate(From);
        var to = ParseDate(To)?.AddDays(1).AddTicks(-1);
        _data = await Reports.GetTahsilatFaturaAsync(from, to);

        // Satır modu AYNI dönem penceresini kullanır (kira başlangıcına göre) — iki bölüm
        // birbirinden bağımsız dönemler göstermesin.
        _satirlar = await Reports.GetTahsilatMutabakatAsync(new TahsilatMutabakatFilter
        {
            Ara = Ara,
            Durum = Enum.TryParse<RentACar.Domain.Enums.RentalStatus>(Durum, out var d) ? d : null,
            BakiyeDurumu = BakiyeDurumu,
            YalnizTutarsiz = Tutarsiz == "1",
            Bas = from, Bit = to
        });
    }

    private static DateTimeOffset? ParseDate(string? s)
        => DateTimeOffset.TryParse(s, out var d) ? new DateTimeOffset(d.Date, TimeSpan.Zero) : null;
}
