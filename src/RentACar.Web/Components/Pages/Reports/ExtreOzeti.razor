@page "/raporlar/extre-ozeti"
@attribute [Authorize(Policy = "izin:ViewReports")]
@inject ReportService Reports
@inject CustomerService Customers
@inject LocationService Ofisler

<PageTitle>Extre Özeti — RentPro</PageTitle>

<div class="page-head"><h1>Extre Özeti</h1></div>
<p class="muted">Müşteri + plaka + vade bazlı <strong>fatura</strong> satırları. Bu ekran
    <a href="/raporlar/cari-bakiye">Cari Bakiye</a> ile karıştırılmamalıdır: orası carinin NET
    bakiyesini (tüm defter hareketleri) verir, burası tek tek faturaları listeler.</p>
<p class="muted small"><strong>Tutarlar brüttür.</strong> Sistemde fatura-bazlı tahsilat mahsubu
    yoktur — tahsilatlar cari bakiyesine yazılır, tek tek faturalara kapatılmaz. Dolayısıyla
    "bu faturanın ne kadarı ödendi" bilgisi veriye dayanmaz ve uydurulmaz. Carinin gerçek net
    durumu için Cari Bakiye ekranına bakın. İade faturaları negatif işaretlidir; iptal faturalar
    hiç listelenmez.</p>

<form method="get" class="filter-bar">
    <label>Cari
        <select name="cariId">
            <option value="">— tümü —</option>
            @foreach (var c in _customers)
            {
                <option value="@c.Id" selected="@(c.Id.ToString() == CariId)">@c.DisplayName</option>
            }
        </select>
    </label>
    <label>Plaka<input name="plaka" value="@Plaka" placeholder="34 AB" /></label>
    <label>Çıkış Ofisi
        <select name="ofis">
            <option value="">— tümü —</option>
            @foreach (var o in _ofisler) { <option value="@o" selected="@(o == Ofis)">@o</option> }
        </select>
    </label>
    <label>Fatura Tarihi ≥<input name="bas" type="date" value="@Bas" /></label>
    <label>Fatura Tarihi ≤<input name="bit" type="date" value="@Bit" /></label>
    <label>Kapsam
        <select name="gecikmis">
            <option value="" selected="@(Gecikmis != "1")">Tümü</option>
            <option value="1" selected="@(Gecikmis == "1")">Yalnız vadesi geçmiş</option>
        </select>
    </label>
    <button type="submit">Filtrele</button>
    @if (FiltreVar) { <a class="link" href="/raporlar/extre-ozeti">Temizle</a> }
</form>

<p class="muted small">@_rows.Count fatura · @_rows.Count(r => (r.KalanGun(_asOf) ?? 0) < 0 && r.VadeTarihi is not null) vadesi geçmiş ·
    <strong>Brüt toplam @_rows.Sum(r => r.IsaretliTutarTl).ToString("N2") ₺</strong>
    <span class="muted">(iadeler negatif, TL-baz)</span></p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead>
        <tr><th>Vade</th><th class="num">Kalan Gün</th><th>Fatura No</th><th>Fatura Tarihi</th>
            <th>Cari</th><th>Plaka</th><th>Sözleşme No</th><th>Çıkış Ofisi</th>
            <th class="num">Brüt Tutar</th><th>Döviz</th><th>Tür</th></tr>
    </thead>
    <tbody>
        @if (_rows.Count == 0)
        {
            <tr><td colspan="11" class="muted">@(FiltreVar ? "Filtreye uyan fatura yok." : "Fatura yok.")</td></tr>
        }
        @foreach (var r in _rows)
        {
            var kalan = r.KalanGun(_asOf);
            <tr>
                <td>@(r.VadeTarihi?.LocalDateTime.ToString("dd.MM.yyyy") ?? "—")</td>
                <td class="num @(kalan is < 0 ? "neg" : null)">@(kalan?.ToString() ?? "—")</td>
                <td class="mono">@r.FaturaNo</td>
                <td>@r.Tarih.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td>@r.CariAd</td>
                <td>@(r.Plaka ?? "—")</td>
                <td>@(r.SozlesmeNo ?? "—")</td>
                <td>@(r.CikisOfisi ?? "—")</td>
                <td class="num">@r.IsaretliTutar.ToString("N2")</td>
                <td>@r.Doviz</td>
                <td>
                    @if (r.IadeMi)
                    {
                        <span class="status-pill sp-warn">İade</span>
                    }
                    else if (kalan is < 0)
                    {
                        <span class="status-pill sp-danger">Vadesi geçti</span>
                    }
                    else
                    {
                        <span class="status-pill sp-success">Geçerli</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "cariId")] public string? CariId { get; set; }
    [SupplyParameterFromQuery(Name = "plaka")] public string? Plaka { get; set; }
    [SupplyParameterFromQuery(Name = "ofis")] public string? Ofis { get; set; }
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }
    [SupplyParameterFromQuery(Name = "gecikmis")] public string? Gecikmis { get; set; }

    private IReadOnlyList<ExtreOzetiRowDto> _rows = [];
    private IReadOnlyList<Customer> _customers = [];
    private string[] _ofisler = [];
    private DateTimeOffset _asOf = DateTimeOffset.UtcNow;

    private bool FiltreVar => !string.IsNullOrWhiteSpace(CariId) || !string.IsNullOrWhiteSpace(Plaka)
        || !string.IsNullOrWhiteSpace(Ofis) || !string.IsNullOrWhiteSpace(Bas)
        || !string.IsNullOrWhiteSpace(Bit) || !string.IsNullOrWhiteSpace(Gecikmis);

    protected override async Task OnInitializedAsync()
    {
        _customers = await Customers.ListAsync();
        _ofisler = (await Ofisler.ListActiveAsync()).Select(o => o.Ad).OrderBy(a => a).ToArray();

        _rows = await Reports.GetExtreOzetiAsync(new ExtreOzetiFilter
        {
            CariId = Guid.TryParse(CariId, out var cid) ? cid : null,
            Plaka = Plaka,
            Ofis = Ofis,
            Bas = Tarih(Bas),
            // Üst sınır GÜN SONUNA genişletilir (tarih girişi 00:00'a düşer).
            Bit = Tarih(Bit)?.AddDays(1).AddTicks(-1),
            YalnizGecikmis = Gecikmis == "1"
        }, _asOf);
    }

    private static DateTimeOffset? Tarih(string? s)
        => DateTimeOffset.TryParse(s, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? d.ToUniversalTime() : null;
}
