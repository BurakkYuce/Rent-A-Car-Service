@page "/raporlar/gunluk"
@attribute [Authorize(Policy = "izin:ViewReports")]
@inject ReportService Reports
@inject BranchService Subeler

<PageTitle>Günlük Faaliyet — RentPro</PageTitle>

<div class="page-head">
    <h1>Günlük Faaliyet Raporu</h1>
    <div class="actions">
        <a href="/raporlar/export/gunluk?format=excel&amp;gun=@GunStr">Excel</a> ·
        <a href="/raporlar/export/gunluk?format=csv&amp;gun=@GunStr">CSV</a>
    </div>
</div>
<p class="muted small">Seçilen günün operasyonel özeti: yeni rezervasyon/kira, çıkış (kira başlangıcı),
    dönüş (gerçek dönüş), tahsilat ve fatura. Tutarlar baz para (₺). Salt-okunur.</p>

<div class="filter-panel">
<form method="get" class="filter-bar">
    <label>Gün<input name="gun" type="date" value="@GunStr" /></label>
    <label>İşlem Şubesi
        <select name="sube">
            <option value="">— tümü —</option>
            @foreach (var o in _subeOpts) { <option value="@o" selected="@(o == Sube)">@o</option> }
        </select>
    </label>
    <button type="submit">Göster</button>
    @if (!string.IsNullOrWhiteSpace(Sube)) { <a class="link" href="/raporlar/gunluk">Temizle</a> }
</form>
@if (!string.IsNullOrWhiteSpace(Sube))
{
    @* Şube süzgeci YALNIZ operasyon sayaçlarına uygulanır: tahsilat ve fatura şube boyutu taşımaz.
       Filtrelenmiş gibi göstermek yanlış olurdu; sınır açıkça yazılıyor. *@
    <p class="muted small"><strong>@Sube</strong> süzgeci rezervasyon / kira / çıkış / dönüş
        sayaçlarına uygulandı. <strong>Tahsilat ve fatura kartları tüm firmayı gösterir</strong> —
        bu kayıtlar şube boyutu taşımıyor.</p>
}
</div>

<p class="muted small">@_gun.ToString("dd.MM.yyyy") günü</p>

<div class="cards">
    <div class="card">
        <div class="card-num">@_data.YeniRezervasyon</div>
        <div class="card-label">Yeni Rezervasyon</div>
    </div>
    <div class="card">
        <div class="card-num">@_data.YeniKira</div>
        <div class="card-label">Yeni Kira</div>
    </div>
    <div class="card">
        <div class="card-num">@_data.Cikis</div>
        <div class="card-label">Çıkış (Teslim)</div>
    </div>
    <div class="card">
        <div class="card-num">@_data.Donus</div>
        <div class="card-label">Dönüş</div>
    </div>
    <div class="card">
        <div class="card-num">@_data.TahsilatAdet</div>
        <div class="card-label">Tahsilat Adedi</div>
    </div>
    <div class="card">
        <div class="card-num">@_data.TahsilatTutar.ToString("N2")</div>
        <div class="card-label">Tahsilat Tutarı ₺</div>
    </div>
    <div class="card">
        <div class="card-num">@_data.FaturaAdet</div>
        <div class="card-label">Fatura Adedi</div>
    </div>
    <div class="card">
        <div class="card-num">@_data.FaturaTutar.ToString("N2")</div>
        <div class="card-label">Fatura Tutarı ₺</div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "gun")] public string? GunStr { get; set; }
    [SupplyParameterFromQuery(Name = "sube")] public string? Sube { get; set; }

    private string[] _subeOpts = [];
    private DateTimeOffset _gun;
    private GunlukFaaliyetDto _data = new(0, 0, 0, 0, 0, 0, 0, 0);

    protected override async Task OnInitializedAsync()
    {
        var parsed = DateTimeOffset.TryParse(GunStr, out var d)
            ? new DateTimeOffset(d.Date, TimeSpan.Zero)
            : new DateTimeOffset(DateTimeOffset.Now.Date, TimeSpan.Zero);
        _gun = parsed;
        GunStr ??= parsed.ToString("yyyy-MM-dd");
        _data = await Reports.GetDailyActivityAsync(parsed, Sube);
        _subeOpts = (await Subeler.ListActiveAsync()).Select(b => b.Ad).OrderBy(a => a).ToArray();
    }
}
