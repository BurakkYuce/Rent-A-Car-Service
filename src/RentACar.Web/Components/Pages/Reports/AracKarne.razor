@page "/raporlar/arac-karne/{VehicleId:guid}"
@attribute [Authorize(Roles = "Admin,Yonetici,Muhasebe")]
@inject ReportService Reports
@inject RentACar.Application.Regulation.VadeService Vadeler

<PageTitle>Araç Karnesi — RentPro</PageTitle>

@if (_d is null)
{
    <p class="error">Araç bulunamadı.</p>
    <a href="/vehicles">← Araçlar</a>
}
else
{
    var h = _d.Header;
    <div class="page-head">
        <h1>Araç Karnesi — @h.Plaka <span class="muted">@h.Marka @h.Tip</span></h1>
        <div class="actions">
            <a href="/araclar/@h.VehicleId">Operasyonel Geçmiş →</a> ·
            <a href="/raporlar/karlilik">Kârlılık Raporu</a> ·
            <span>
                <a href="/raporlar/export/arac-karne?vehicleId=@VehicleId&amp;format=excel&amp;from=@From&amp;to=@To">Excel</a> ·
                <a href="/raporlar/export/arac-karne?vehicleId=@VehicleId&amp;format=csv&amp;from=@From&amp;to=@To">CSV</a> ·
                <a href="/raporlar/export/arac-karne?vehicleId=@VehicleId&amp;format=pdf&amp;from=@From&amp;to=@To">PDF</a>
            </span>
        </div>
    </div>

    @* Kimlik + edinim/filo yaşam döngüsü *@
    <div class="kv-inline">
        <span>Grup: <strong>@(h.Grup ?? "—")</strong></span>
        <span>Segment: <strong>@(h.Segment ?? "—")</strong></span>
        <span>Şube: <strong>@(h.Sube ?? "—")</strong></span>
        <span>Sahibi: <strong>@(h.AracSahibi ?? "—")</strong></span>
        <span>Durum: <strong>@h.Durum</strong></span>
        <span>KM: <strong>@h.Km.ToString("N0")</strong></span>
    </div>
    <div class="kv-inline">
        <span>Alım Bedeli: <strong>@Para(h.AlimBedeli)</strong></span>
        <span>Alım Tarihi: <strong>@Tarih(h.AlimTarihi)</strong></span>
        <span>İkinci El Değeri: <strong>@Para(h.IkinciElDeger)</strong></span>
        <span>Filo Giriş: <strong>@Tarih(h.FiloGirisTarih)</strong></span>
        <span>Filo Çıkış: <strong>@Tarih(h.FiloCikisTarih)</strong></span>
        <span>Son Bakım: <strong>@Tarih(h.SonBakimTarih)@(h.SonBakimKm is int sk ? $" ({sk:N0} km)" : "")</strong></span>
    </div>

    <form method="get" class="grid-form">
        <label>Başlangıç<input name="from" type="date" value="@From" /></label>
        <label>Bitiş<input name="to" type="date" value="@To" /></label>
        <button type="submit">Göster</button>
    </form>
    <p class="muted small">Dönem filtresi P&amp;L bölümlerini (toplam/yıllık/kırılım) ve olay listesini daraltır;
        <strong>KPI kartları daima ömür boyudur</strong> (sahiplik penceresi). Araca atfedilemeyen gelir/gider
        ("(Atanmamış)") bu karnede yer almaz — filo toplamı için Kârlılık Raporu'na bakın. Dövizli kayıtlarda
        olay tutarı belge para birimindedir; defter katkısı giriş kuruna göre TL'dir.</p>

    @* P&L özeti (dönem) *@
    <div class="cards">
        <div class="card"><div class="card-num">@_d.ToplamGelir.ToString("N2")</div><div class="card-label">Gelir</div></div>
        <div class="card"><div class="card-num">@_d.ToplamGider.ToString("N2")</div><div class="card-label">Gider</div></div>
        <div class="card"><div class="card-num">@_d.ToplamNetKar.ToString("N2")</div><div class="card-label">Net Kâr (defter)</div></div>
        <div class="card"><div class="card-num">@Para(_d.Kpi.EkonomikKar)</div><div class="card-label">Ekonomik Kâr (− amortisman, ömür boyu)</div></div>
    </div>

    @* Kurumsal KPI'lar (ömür boyu) *@
    <h2>KPI — Ömür Boyu</h2>
    <div class="cards">
        <div class="card"><div class="card-num">@Yuzde(_d.Kpi.DolulukYuzde)</div><div class="card-label">Doluluk</div></div>
        <div class="card"><div class="card-num">@Para(_d.Kpi.RevPacd)</div><div class="card-label">RevPACD (ciro ÷ sahiplik günü)</div></div>
        <div class="card"><div class="card-num">@Para(_d.Kpi.Adr)</div><div class="card-label">ADR (ciro ÷ kiralanan gün)</div></div>
        <div class="card"><div class="card-num">@Para(_d.Kpi.KmBasinaMaliyet)</div><div class="card-label">Km Başına Maliyet</div></div>
    </div>
    <div class="cards">
        <div class="card"><div class="card-num">@Yuzde(_d.Kpi.NetMarjYuzde)</div><div class="card-label">Net Marj</div></div>
        <div class="card"><div class="card-num">@Yuzde(_d.Kpi.RoiYuzde)</div><div class="card-label">ROI@(h.Durum == VehicleStatus.Satildi ? " (kapanış)" : "")</div></div>
        <div class="card"><div class="card-num">@(_d.Kpi.GeriOdemeAy?.ToString() ?? "—")</div><div class="card-label">Geri Ödeme (ay)</div></div>
        <div class="card"><div class="card-num">@_d.Kpi.Tco.ToString("N2")</div><div class="card-label">TCO (alım + gider)</div></div>
    </div>
    <div class="kv-inline">
        <span>Sahiplik: <strong>@_d.Kpi.SahiplikGun gün</strong></span>
        <span>Kiralanan: <strong>@_d.Kpi.KiralananGun gün</strong></span>
        <span>Serviste: <strong>@_d.Kpi.ServisGun gün</strong></span>
        <span>Boş: <strong>@_d.Kpi.BosGun gün</strong></span>
        <span>Kira Sayısı: <strong>@_d.Kpi.KiraSayisi</strong></span>
        <span>Katedilen KM: <strong>@_d.Kpi.ToplamKatedilenKm.ToString("N0")</strong></span>
        <span>Gerçekleşen Amortisman: <strong>@Para(_d.Kpi.GerceklesenAmortisman)</strong></span>
        <span>Aylık Amortisman: <strong>@Para(_d.Kpi.AylikAmortisman)</strong></span>
    </div>

    @* Yıllık P&L *@
    <h2>Yıllık Kâr/Zarar</h2>
    <table class="grid tr-grid">
        <thead><tr><th>Yıl</th><th class="num">Gelir</th><th class="num">Gider</th><th class="num">Net Kâr</th></tr></thead>
        <tbody>
            @if (_d.YillikPnl.Count == 0) { <tr><td colspan="4" class="muted">Kayıt yok.</td></tr> }
            @foreach (var y in _d.YillikPnl)
            {
                <tr><td>@y.Yil</td><td class="num">@y.Gelir.ToString("N2")</td>
                    <td class="num">@y.Gider.ToString("N2")</td><td class="num">@y.NetKar.ToString("N2")</td></tr>
            }
        </tbody>
        <tfoot><tr><th>TOPLAM</th><th class="num">@_d.ToplamGelir.ToString("N2")</th>
            <th class="num">@_d.ToplamGider.ToString("N2")</th><th class="num">@_d.ToplamNetKar.ToString("N2")</th></tr></tfoot>
    </table>

    @* Kırılımlar *@
    <div class="report-cols">
        <div>
            <h2>Gelir Kaynakları</h2>
            <table class="grid tr-grid">
                <thead><tr><th>Kaynak</th><th class="num">Tutar</th><th class="num">% Gelir</th></tr></thead>
                <tbody>
                    @if (_d.GelirKaynak.Count == 0) { <tr><td colspan="3" class="muted">Kayıt yok.</td></tr> }
                    @foreach (var r in _d.GelirKaynak)
                    {
                        <tr><td>@r.Kategori</td><td class="num">@r.Tutar.ToString("N2")</td><td class="num">@Yuzde(r.YuzdeGelir)</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div>
            <h2>Gider Kategorileri</h2>
            <table class="grid tr-grid">
                <thead><tr><th>Kategori</th><th class="num">Tutar</th><th class="num">% Gelir</th></tr></thead>
                <tbody>
                    @if (_d.GiderKategori.Count == 0) { <tr><td colspan="3" class="muted">Kayıt yok.</td></tr> }
                    @foreach (var r in _d.GiderKategori)
                    {
                        <tr><td>@r.Kategori</td><td class="num">@r.Tutar.ToString("N2")</td><td class="num">@Yuzde(r.YuzdeGelir)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Amortisman / başabaş modeli *@
    @if (_d.MaliyetModel is { } m)
    {
        <h2>Amortisman / Başabaş Modeli <span class="muted small">(şeffaf varsayım modeli — ömür boyu)</span></h2>
        <div class="kv-inline">
            <span>Kalıntı Değer: <strong>@m.ResidualDeger.ToString("N2")</strong></span>
            <span>Net Amortisman: <strong>@m.NetAmortisman.ToString("N2")</strong></span>
            <span>Toplam İşletme Gideri: <strong>@m.ToplamGider.ToString("N2")</strong></span>
            <span>Toplam Maliyet: <strong>@m.ToplamMaliyet.ToString("N2")</strong></span>
            <span>Başabaş (aylık): <strong>@m.BasaBasAylik.ToString("N2")</strong></span>
        </div>
    }

    @* FAZ 2.2: Tut/Sat (defleet) sinyali *@
    @if (_d.TutSat.Sinyal > 0)
    {
        <div class="cards">
            <div class="card" style="border-color:#d97706;">
                <div class="card-num">Tut/Sat: @_d.TutSat.Sinyal sinyal</div>
                <div class="card-label">
                    @foreach (var g in _d.TutSat.Gerekceler) { <div>@g</div> }
                    <div class="muted small">Şeffaf eşik kuralları — yatırım tavsiyesi değildir.</div>
                </div>
            </div>
        </div>
    }

    @* FAZ 2.1: Yaklaşan vadeler (sigorta/kasko/MTV/muayene) + bakım-km *@
    <h2>Yaklaşan Vadeler</h2>
    <table class="grid tr-grid">
        <thead><tr><th>Tür</th><th>Bitiş / Hedef</th><th class="num">Kalan</th><th>Durum</th></tr></thead>
        <tbody>
            @if (_vadeler.Count == 0 && _bakimKm?.SonrakiBakimKm is null)
            { <tr><td colspan="4" class="muted">Kayıtlı vade yok (sigorta/MTV/muayene girilmemiş olabilir).</td></tr> }
            @foreach (var vi in _vadeler)
            {
                <tr>
                    <td>@vi.Tur</td>
                    <td>@vi.Bitis.UtcDateTime.ToString("dd.MM.yyyy")</td>
                    <td class="num">@vi.KalanGun gün</td>
                    <td>@(vi.Bucket switch {
                        RentACar.Domain.Enums.VadeBucket.Gecmis => "GEÇMİŞ",
                        RentACar.Domain.Enums.VadeBucket.YediGun => "≤7 gün",
                        RentACar.Domain.Enums.VadeBucket.OtuzGun => "≤30 gün",
                        _ => "İleri" })</td>
                </tr>
            }
            @if (_bakimKm is { SonrakiBakimKm: { } hedefKm, KalanKm: { } kalanKm })
            {
                <tr>
                    <td>Periyodik Bakım (KM)</td>
                    <td>hedef @hedefKm.ToString("N0") km</td>
                    <td class="num">@kalanKm.ToString("N0") km</td>
                    <td>@(kalanKm <= 0 ? "GEÇMİŞ" : kalanKm <= 1000 ? "YAKIN" : "İleri")</td>
                </tr>
            }
        </tbody>
    </table>

    @* Olay zaman çizelgesi *@
    <h2>Olay Geçmişi — Neyi Ne Zaman</h2>
    <table class="grid tr-grid">
        <thead><tr><th>Tarih</th><th>Tür</th><th>Açıklama</th><th class="num">Tutar</th><th>Defter</th></tr></thead>
        <tbody>
            @if (_d.Olaylar.Count == 0) { <tr><td colspan="5" class="muted">Kayıt yok.</td></tr> }
            @foreach (var o in _d.Olaylar)
            {
                <tr>
                    <td>@o.Tarih.UtcDateTime.ToString("dd.MM.yyyy")</td>
                    <td>@o.Tur</td>
                    <td>@o.Aciklama</td>
                    <td class="num">@(o.Tutar?.ToString("N2") ?? "—")</td>
                    <td>@if (o.DeftereYansir) { <span>Evet</span> } else { <span class="muted small">bilgi — deftere yansımaz</span> }</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="muted small">Olay tutarları kaynak belgeden (brüt/belge para birimi) BİLGİ amaçlıdır ve P&amp;L'e
        toplanmaz — P&amp;L yalnız çift-taraflı defterden türetilir. "bilgi" satırları (ör. servis maliyeti)
        deftere yazılmayan operasyonel kayıtlardır; gerçek gider ayrıca Gider dilimi olarak girilir.</p>
}

@code {
    [Parameter] public Guid VehicleId { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? To { get; set; }

    private AracKarneDto? _d;
    private IReadOnlyList<RentACar.Application.Regulation.VadeItem> _vadeler = [];
    private PeriyodikServisRow? _bakimKm;

    private static string Para(decimal? d) => d?.ToString("N2") ?? "—";
    private static string Yuzde(decimal? d) => d is { } x ? x.ToString("N2") + "%" : "—";
    private static string Tarih(DateTimeOffset? t) => t?.UtcDateTime.ToString("dd.MM.yyyy") ?? "—";

    protected override async Task OnInitializedAsync()
    {
        DateTimeOffset? f = DateTimeOffset.TryParse(From, out var x) ? x : null;
        DateTimeOffset? t = DateTimeOffset.TryParse(To, out var y) ? y : null;
        _d = await Reports.GetAracKarneAsync(VehicleId, f, t);
        if (_d is not null)
        {
            _vadeler = await Vadeler.GetForVehicleAsync(VehicleId); // FAZ 2.1 (ömür-boyu vade — pencereden bağımsız)
            _bakimKm = (await Reports.GetPeriyodikServisAsync()).FirstOrDefault(r => r.Plaka == _d.Header.Plaka);
        }
    }
}
