@page "/raporlar/periyodik-servis"
@attribute [Authorize(Roles = "Admin,Yonetici,Operator,Muhasebe")]
@inject ReportService Reports
@inject BranchService Subeler

<PageTitle>Periyodik Servis Raporu — RentPro</PageTitle>

<div class="page-head">
    <h1>Periyodik Servis (KM Bakım Uyarısı)</h1>
    <div class="actions">
        <a href="/raporlar/export/periyodik-servis?format=excel">Excel</a> ·
        <a href="/raporlar/export/periyodik-servis?format=csv">CSV</a> · <a href="/raporlar/export/periyodik-servis?format=pdf">PDF</a>
    </div>
</div>
<p class="muted">Her aracın sonraki bakım KM hedefine kalan mesafe (kalan KM artan sıralı). Negatif = bakım zamanı geçti.
Kaynak: <strong>Servis</strong> = servis kaydında elle girilen hedef; <strong>Tanım</strong> = Son Bakım KM + araç tipinin periyodik
aralığı (Servis Tanımları). Hedefsiz araçlar "tanım yok" olarak listelenir (gizlenmez).</p>

<form method="get" class="filter-bar">
    <label>Plaka<input name="plaka" value="@Plaka" placeholder="34 AB (boşluk serbest)" /></label>
    <label>Şube
        <select name="sube">
            <option value="">— tümü —</option>
            @foreach (var o in _subeOpts) { <option value="@o" selected="@(o == Sube)">@o</option> }
        </select>
    </label>
    <label>Durum
        <select name="durum">
            <option value="">— tümü —</option>
            <option value="true" selected="@(Durum == "true")">Aktif</option>
            <option value="false" selected="@(Durum == "false")">Pasif</option>
        </select>
    </label>
    <label>Uyarı Eşiği (kalan km)<input name="esik" type="number" min="0" value="@Esik" placeholder="ör. 1000" /></label>
    <button type="submit">Filtrele</button>
    @if (FiltreVar) { <a class="link" href="/raporlar/periyodik-servis">Temizle</a> }
</form>
@* Uyarı eşiği verilince hedefi OLMAYAN araç ELENMEZ — eksik tanım da bir uyarıdır. *@
<p class="muted small">@_rows.Count araç@(FiltreVar ? " (filtreli)" : "") · uyarı eşiği verilirse
    hedefi olmayan ("tanım yok") araçlar da listede kalır.</p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Plaka</th><th>Marka</th><th>Tipi</th><th class="num">Yılı</th><th>Yakıt</th><th>Vites</th><th>Şube</th>
        <th>Son Servis</th><th class="num">Son Servis KM</th><th class="num">Güncel KM</th><th class="num">Sonraki Bakım KM</th><th class="num">Kalan KM</th><th>Kaynak</th><th></th></tr></thead>
    <tbody>
        @if (_rows.Count == 0)
        {
            <tr><td colspan="13" class="muted">@(FiltreVar ? "Filtreye uyan araç yok." : "Araç yok.")</td></tr>
        }
        @foreach (var r in _rows)
        {
            <tr>
                <td class="mono">@r.Plaka</td>
                <td>@(r.Marka ?? "—")</td>
                <td>@(r.Tip ?? "—")</td>
                <td class="num">@(r.ModelYili?.ToString() ?? "—")</td>
                <td>@(r.Yakit ?? "—")</td>
                <td>@(r.Vites ?? "—")</td>
                <td>@(r.Sube ?? "—")</td>
                <td>@(r.SonServisTarihi?.LocalDateTime.ToString("dd.MM.yyyy") ?? "—")</td>
                <td class="num">@(r.SonServisKm?.ToString("N0") ?? "—")</td>
                <td class="num">@r.GuncelKm</td>
                <td class="num">@(r.SonrakiBakimKm?.ToString() ?? "—")</td>
                <td class="num">@(r.KalanKm?.ToString() ?? "—")</td>
                <td>@(r.Kaynak ?? "")</td>
                <td>@(r.KalanKm is null ? "tanım yok" : r.KalanKm <= 0 ? "geçti" : r.KalanKm <= 1000 ? "yaklaştı" : "")</td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "plaka")] public string? Plaka { get; set; }
    [SupplyParameterFromQuery(Name = "sube")] public string? Sube { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }
    [SupplyParameterFromQuery(Name = "esik")] public string? Esik { get; set; }

    private IReadOnlyList<PeriyodikServisRow> _rows = [];
    private string[] _subeOpts = [];

    private bool FiltreVar => !string.IsNullOrWhiteSpace(Plaka) || !string.IsNullOrWhiteSpace(Sube)
        || !string.IsNullOrWhiteSpace(Durum) || !string.IsNullOrWhiteSpace(Esik);

    protected override async Task OnInitializedAsync()
    {
        _rows = await Reports.GetPeriyodikServisAsync(new PeriyodikServisFilter
        {
            Plaka = Plaka, Sube = Sube,
            Aktif = bool.TryParse(Durum, out var a) ? a : null,
            UyariEsigi = int.TryParse(Esik, out var e) ? e : null
        });
        _subeOpts = (await Subeler.ListActiveAsync()).Select(b => b.Ad).OrderBy(x => x).ToArray();
    }
}
