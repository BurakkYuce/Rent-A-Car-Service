@page "/raporlar/rezervasyon-kaynak"
@attribute [Authorize(Policy = "izin:ViewReports")]
@inject ReportService Reports
@inject BranchService Subeler
@inject VehicleGroupService Gruplar

<PageTitle>Rezervasyon Kaynak Raporu — RentPro</PageTitle>

<div class="page-head">
    <h1>Rezervasyon Kaynak Raporu</h1>
    <div class="actions">
        <a href="/raporlar/export/rezervasyon-kaynak?format=excel&amp;from=@From&amp;to=@To">Excel</a> ·
        <a href="/raporlar/export/rezervasyon-kaynak?format=csv&amp;from=@From&amp;to=@To">CSV</a>
    </div>
</div>
@* FAZ-76 DÜZELTME: İPTAL rezervasyonlar adet/gün/CİROYA dahil ediliyordu — gerçekleşmemiş iş
   ciro sayılıyordu. Artık varsayılan olarak dışarıda; adedi ayrı kolonda görünür kalıyor. *@
<p class="muted">Kaynak/kanal başına rezervasyon adedi, toplam gün ve ciro.
    <strong>İptal rezervasyonlar sayılmaz</strong> (adetleri ayrı kolonda görünür) — istenirse
    aşağıdan dahil edilebilir. Tarih filtresi hangi alana uygulanacağını siz seçersiniz.</p>

<form method="get" class="filter-bar">
    <label>Başlangıç<input name="from" type="date" value="@From" /></label>
    <label>Bitiş<input name="to" type="date" value="@To" /></label>
    <label>Tarih Alanı
        <select name="tarihTipi">
            <option value="Cikis" selected="@(TarihTipi is null or "Cikis")">Çıkış</option>
            <option value="Donus" selected="@(TarihTipi == "Donus")">Dönüş</option>
            <option value="Kayit" selected="@(TarihTipi == "Kayit")">Kayıt</option>
        </select>
    </label>
    <label>Çıkış Ofisi
        <select name="ofis">
            <option value="">— tümü —</option>
            @foreach (var o in _officeOpts) { <option value="@o" selected="@(o == Ofis)">@o</option> }
        </select>
    </label>
    <label>Araç Grubu
        <select name="grup">
            <option value="">— tümü —</option>
            @foreach (var g in _groupOpts) { <option value="@g" selected="@(g == Grup)">@g</option> }
        </select>
    </label>
    <label class="kf-inline"><input type="checkbox" name="iptal" value="true" checked="@(Iptal == "true")" /> İptalleri dahil et</label>
    <button type="submit">Göster</button>
</form>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Kaynak</th><th class="num">Adet</th><th class="num">Toplam Gün</th><th class="num">Toplam Ciro</th><th class="num">İptal Adet</th></tr></thead>
    <tbody>
        @if (_rows.Count == 0)
        {
            <tr><td colspan="5" class="muted">Bu aralıkta rezervasyon yok.</td></tr>
        }
        @foreach (var r in _rows)
        {
            <tr><td>@r.Kaynak</td><td class="num">@r.Adet</td><td class="num">@r.ToplamGun</td><td class="num">@r.ToplamCiro.ToString("N2")</td><td class="num muted">@r.IptalAdet</td></tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? To { get; set; }
    [SupplyParameterFromQuery(Name = "tarihTipi")] public string? TarihTipi { get; set; }
    [SupplyParameterFromQuery(Name = "ofis")] public string? Ofis { get; set; }
    [SupplyParameterFromQuery(Name = "grup")] public string? Grup { get; set; }
    [SupplyParameterFromQuery(Name = "iptal")] public string? Iptal { get; set; }

    private IReadOnlyList<RezervasyonKaynakRow> _rows = [];
    private string[] _officeOpts = [], _groupOpts = [];

    protected override async Task OnInitializedAsync()
    {
        var from = ParseDate(From);
        var to = ParseDate(To)?.AddDays(1).AddTicks(-1);
        _rows = await Reports.GetReservationSourceAsync(new RezervasyonKaynakFilter
        {
            Bas = from, Bit = to, TarihTipi = TarihTipi ?? "Cikis",
            Ofis = Ofis, Grup = Grup, IptalleriDahilEt = Iptal == "true"
        });
        _officeOpts = (await Subeler.ListActiveAsync()).Select(b => b.Ad).OrderBy(a => a).ToArray();
        _groupOpts = (await Gruplar.ListActiveAsync()).Select(g => g.Kod)
            .Where(x => !string.IsNullOrWhiteSpace(x)).OrderBy(x => x).ToArray();
    }

    private static DateTimeOffset? ParseDate(string? s)
        => DateTimeOffset.TryParse(s, out var d) ? new DateTimeOffset(d.Date, TimeSpan.Zero) : null;
}
