@page "/raporlar/ek-hizmet"
@attribute [Authorize(Policy = "izin:ViewReports")]
@inject ReportService Reports
@inject PersonelService Personeller
@inject LocationService Ofisler

<PageTitle>Ek Hizmet Raporu — RentPro</PageTitle>

<div class="page-head">
    <h1>Ek Hizmet Satış Raporu</h1>
    <div class="actions">
        <a href="/raporlar/export/ek-hizmet?format=excel&amp;from=@From&amp;to=@To">Excel</a> ·
        <a href="/raporlar/export/ek-hizmet?format=csv&amp;from=@From&amp;to=@To">CSV</a>
        @if (PivotModu)
        {
            <span> · <a href="/raporlar/export/ek-hizmet-arac?format=excel&amp;from=@From&amp;to=@To">Pivot Excel</a> ·
                <a href="/raporlar/export/ek-hizmet-arac?format=csv&amp;from=@From&amp;to=@To">Pivot CSV</a></span>
        }
    </div>
</div>
<p class="muted small">Seçilen dönemde (kalem eklenme tarihi) İptal olmayan kiralara satılan ek
    hizmetlerin adına göre özeti. Tutarlar baz para (₺). Salt-okunur.</p>

<div class="filter-panel">
<form method="get" class="filter-bar">
    <label>Başlangıç<input name="from" type="date" value="@From" /></label>
    <label>Bitiş<input name="to" type="date" value="@To" /></label>
    <button type="submit">Göster</button>
    @if (!string.IsNullOrEmpty(From) || !string.IsNullOrEmpty(To))
    {
        <a href="/raporlar/ek-hizmet" class="link">Temizle</a>
    }
</form>
</div>

<div class="cards">
    <div class="card">
        <div class="card-num">@_data.ToplamNet.ToString("N2")</div>
        <div class="card-label">Toplam Net ₺</div>
    </div>
    <div class="card">
        <div class="card-num">@_data.ToplamKdv.ToString("N2")</div>
        <div class="card-label">Toplam KDV ₺</div>
    </div>
    <div class="card">
        <div class="card-num">@_data.ToplamBrut.ToString("N2")</div>
        <div class="card-label">Genel Toplam ₺</div>
    </div>
    <div class="card">
        <div class="card-num">@_data.KiraAdet</div>
        <div class="card-label">Kira Adedi</div>
    </div>
</div>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead>
        <tr><th>Ek Hizmet</th><th class="num">Toplam Miktar</th><th class="num">Kira Adedi</th><th class="num">Net</th><th class="num">KDV</th><th class="num">Brüt</th></tr>
    </thead>
    <tbody>
        @if (_data.Satirlar.Count == 0)
        {
            <tr><td colspan="6" class="muted">Bu dönemde satılan ek hizmet yok.</td></tr>
        }
        @foreach (var s in _data.Satirlar)
        {
            <tr>
                <td>@s.Ad</td>
                <td class="num">@s.ToplamMiktar.ToString("0.##")</td>
                <td class="num">@s.KiraAdet</td>
                <td class="num">@s.Net.ToString("N2")</td>
                <td class="num">@s.Kdv.ToString("N2")</td>
                <td class="num">@s.Brut.ToString("N2")</td>
            </tr>
        }
    </tbody>
    @if (_data.Satirlar.Count > 0)
    {
        <tfoot>
            <tr>
                <th>Toplam</th>
                <th></th>
                <th class="num">@_data.KiraAdet</th>
                <th class="num">@_data.ToplamNet.ToString("N2")</th>
                <th class="num">@_data.ToplamKdv.ToString("N2")</th>
                <th class="num">@_data.ToplamBrut.ToString("N2")</th>
            </tr>
        </tfoot>
    }
</table>
</div>

@* FAZ-12 Bölüm C (kullanıcı kararı "Seçenek B") — ad-bazlı özet ile araç-bazlı pivot AYNI ekranda,
   ikinci bir bakış açısı olarak. Karlılık / Filo Analiz / Ek Hizmet üçlüsü BİRLEŞTİRİLMEDİ. *@
<p class="muted small"><strong>Alt görünüm:</strong>
    <a href="@AltUrl(null)">@(PivotModu ? Plain("Satır detayı") : Bold("Satır detayı"))</a> ·
    <a href="@AltUrl("arac")">@(PivotModu ? Bold("Araç bazlı pivot") : Plain("Araç bazlı pivot"))</a>
</p>

@if (PivotModu)
{
<h2 class="dash-h2">Araç Bazlı Pivot</h2>
<p class="muted small">Satır = araç, sütun = ek hizmet, hücre = <strong>brüt</strong> tutar (₺).
    En çok satan hizmet solda. Pivot yeni para üretmez: genel toplamı yukarıdaki ad-bazlı özetin
    <strong>Genel Toplam</strong>'ıyla aynıdır (@_pivot.GenelToplam.ToString("N2") ≡
    @_data.ToplamBrut.ToString("N2")). Araç kaydı silinmiş kalemler "(bilinmeyen araç)" satırında
    kalır — atılsalardı toplam kayardı.</p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead>
        <tr><th>Plaka</th><th>Grup</th><th>SIPP</th>
            @foreach (var k in _pivot.Kolonlar) { <th class="num">@k</th> }
            <th class="num">Toplam</th><th class="num">Kalem</th></tr>
    </thead>
    <tbody>
        @if (_pivot.Satirlar.Count == 0)
        {
            <tr><td colspan="6" class="muted">Bu dönemde satılan ek hizmet yok.</td></tr>
        }
        @foreach (var s in _pivot.Satirlar)
        {
            <tr>
                <td>
                    @if (s.VehicleId is { } vid) { <a class="link" href="/araclar/@vid">@s.Plaka</a> }
                    else { <span class="muted">@s.Plaka</span> }
                </td>
                <td>@(s.Grup ?? "—")</td>
                <td>@(s.Sipp ?? "—")</td>
                @foreach (var h in s.Hucreler)
                {
                    <td class="num">@(h == 0m ? "—" : h.ToString("N2"))</td>
                }
                <td class="num"><strong>@s.Toplam.ToString("N2")</strong></td>
                <td class="num muted">@s.KalemAdet</td>
            </tr>
        }
    </tbody>
    @if (_pivot.Satirlar.Count > 0)
    {
        <tfoot>
            <tr>
                <th colspan="3">TOPLAM (@_pivot.Satirlar.Count araç)</th>
                @foreach (var t in _pivot.KolonToplam) { <th class="num">@t.ToString("N2")</th> }
                <th class="num">@_pivot.GenelToplam.ToString("N2")</th>
                <th class="num">@_pivot.Satirlar.Sum(s => s.KalemAdet)</th>
            </tr>
        </tfoot>
    }
</table>
</div>
}
else
{
@* FAZ-78 — SATIR-BAZLI detay. Yukarıdaki ad-bazlı özet DEĞİŞMEDİ; bu onun yerine geçmiyor. *@
<h2 class="dash-h2">Satır Detayı</h2>
<p class="muted small">Her satır bir ek hizmet kalemi: hangi sözleşmede, hangi araçta, hangi
    müşteriye, kim sattı. <strong>İlk Tahsilat</strong> kalemin değil KİRANIN en erken tahsilatıdır —
    sistemde kalem-bazlı tahsilat izi yoktur.</p>

<form method="get" class="filter-bar">
    <input type="hidden" name="from" value="@From" />
    <input type="hidden" name="to" value="@To" />
    <label>Ara<input name="ara" value="@Ara" placeholder="hizmet / sözleşme / plaka / müşteri" /></label>
    <label>Satan Personel
        <select name="personelId">
            <option value="">— tümü —</option>
            @foreach (var p in _personeller)
            {
                <option value="@p.Id" selected="@(p.Id.ToString() == PersonelId)">@p.Ad @p.Soyad</option>
            }
        </select>
    </label>
    <label>Çıkış Ofisi
        <select name="ofis">
            <option value="">— tümü —</option>
            @foreach (var o in _ofisler) { <option value="@o" selected="@(o == Ofis)">@o</option> }
        </select>
    </label>
    <label>Rez. Kaynağı<input name="kaynak" value="@Kaynak" /></label>
    <label>Sistem kalemleri
        <select name="sys">
            <option value="" selected="@(Sys != "gizle")">Göster</option>
            <option value="gizle" selected="@(Sys == "gizle")">Gizle</option>
        </select>
    </label>
    <button type="submit">Filtrele</button>
</form>

<p class="muted small">@_detay.Count kalem · Net @_detay.Sum(x => x.Net).ToString("N2") ·
    KDV @_detay.Sum(x => x.Kdv).ToString("N2") · Brüt @_detay.Sum(x => x.Brut).ToString("N2")</p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead>
        <tr><th>Eklenme</th><th>Sözleşme No</th><th>Plaka</th><th>Müşteri</th><th>Çıkış Ofisi</th>
            <th>Rez. Kaynağı</th><th>Hizmet</th><th class="num">Miktar</th><th class="num">Birim Net</th>
            <th class="num">KDV %</th><th class="num">Net</th><th class="num">KDV</th><th class="num">Brüt</th>
            <th>Satan Personel</th><th class="num">Kira İlk Tahsilat</th></tr>
    </thead>
    <tbody>
        @if (_detay.Count == 0)
        {
            <tr><td colspan="15" class="muted">Ek hizmet kalemi yok.</td></tr>
        }
        @foreach (var x in _detay)
        {
            <tr>
                <td>@x.EklenmeTarihi.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td class="mono">@x.SozlesmeNo</td>
                <td>@x.Plaka</td>
                <td>@x.MusteriAd</td>
                <td>@(x.CikisOfisi ?? "—")</td>
                <td>@(x.RezKaynagi ?? "—")</td>
                <td>@x.Ad @if (x.SistemKalemi) { <span class="muted small">(sistem)</span> }</td>
                <td class="num">@x.Miktar.ToString("N2")</td>
                <td class="num">@x.BirimNetFiyat.ToString("N2")</td>
                <td class="num">@((x.KdvOrani * 100).ToString("0.##"))</td>
                <td class="num">@x.Net.ToString("N2")</td>
                <td class="num">@x.Kdv.ToString("N2")</td>
                <td class="num">@x.Brut.ToString("N2")</td>
                <td>@(x.SatanPersonel ?? "—")</td>
                <td class="num">@(x.IlkTahsilat?.ToString("N2") ?? "—")</td>
            </tr>
        }
    </tbody>
</table>
</div>
}

@code {
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? To { get; set; }
    [SupplyParameterFromQuery(Name = "ara")] public string? Ara { get; set; }
    [SupplyParameterFromQuery(Name = "personelId")] public string? PersonelId { get; set; }
    [SupplyParameterFromQuery(Name = "ofis")] public string? Ofis { get; set; }
    [SupplyParameterFromQuery(Name = "kaynak")] public string? Kaynak { get; set; }
    [SupplyParameterFromQuery(Name = "sys")] public string? Sys { get; set; }
    [SupplyParameterFromQuery(Name = "pivot")] public string? Pivot { get; set; }

    private EkHizmetRaporDto _data = new([], 0, 0, 0, 0);
    private EkHizmetAracPivotDto _pivot = new([], [], [], 0m);
    private IReadOnlyList<EkHizmetDetayRow> _detay = [];
    private IReadOnlyList<PersonelSecim> _personeller = [];
    private string[] _ofisler = [];

    private bool PivotModu => Pivot == "arac";

    protected override async Task OnInitializedAsync()
    {
        var from = ParseDate(From);
        var to = ParseDate(To)?.AddDays(1).AddTicks(-1); // gün sonuna dek dahil
        _data = await Reports.GetEkHizmetRaporuAsync(from, to);

        // Personel listesi PII'sız uç (ListForSelectAsync) — ListAsync ManageUsers ister ve
        // Muhasebe rolünde patlar (kira mega-formunda öğrenilen ders).
        _personeller = await Personeller.ListForSelectAsync();
        _ofisler = (await Ofisler.ListActiveAsync()).Select(o => o.Ad).OrderBy(a => a).ToArray();

        // Pivot ve satır-detayı birbirinin alternatifi — ikisini birden çekmek gereksiz iş.
        if (PivotModu)
        {
            // Pivot BİLEREK yalnız tarih penceresini alır: detay süzgeçleri (ofis/personel/kaynak/
            // sistem-kalemi) uygulansaydı pivot toplamı ad-bazlı özetten kayar ve iki tablo aynı
            // ekranda birbirini yalanlardı.
            _pivot = await Reports.GetEkHizmetAracPivotAsync(from, to);
            return;
        }

        _detay = await Reports.GetEkHizmetDetayAsync(new EkHizmetDetayFilter
        {
            Bas = from, Bit = to,
            Ara = Ara,
            PersonelId = Guid.TryParse(PersonelId, out var pid) ? pid : null,
            Ofis = Ofis,
            RezKaynagi = Kaynak,
            SistemKalemleriniGizle = Sys == "gizle"
        });
    }

    private static DateTimeOffset? ParseDate(string? s)
        => DateTimeOffset.TryParse(s, out var d) ? new DateTimeOffset(d.Date, TimeSpan.Zero) : null;

    /// <summary>Alt görünüm anahtarı — tarih penceresi KORUNUR (üstteki özet ikisinde de aynı).</summary>
    private string AltUrl(string? pivot)
    {
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(From)) qs.Add($"from={Uri.EscapeDataString(From)}");
        if (!string.IsNullOrWhiteSpace(To)) qs.Add($"to={Uri.EscapeDataString(To)}");
        if (pivot is not null) qs.Add($"pivot={pivot}");
        return "/raporlar/ek-hizmet" + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
    }

    private static MarkupString Bold(string s) => new($"<strong>{s}</strong>");
    private static MarkupString Plain(string s) => new(s);
}
