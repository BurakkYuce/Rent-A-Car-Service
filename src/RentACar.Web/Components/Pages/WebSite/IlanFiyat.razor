@page "/web-sitesi/ilan/{Id:guid}/fiyat"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@using RentACar.Application.WebSite
@using RentACar.Domain.Common
@using RentACar.Infrastructure.Persistence
@inject WebListingService Ilanlar
@inject ITenantContext Tenant
@inject TenantStatusCache Durum

<PageTitle>Fiyat — Web Sitesi</PageTitle>

@if (!_module || _detail is null)
{
    <div class="page-head"><h1>Web Sitesi</h1></div>
    <p class="empty-state">@(_module ? "İlan bulunamadı." : "Bu modül firmanızda etkin değil.")</p>
}
else
{
    <div class="page-head">
        <h1>@_detail.Ilan.Baslik <span class="muted small">— 2/3 fiyat</span></h1>
        <div class="actions"><a class="link" href="/web-sitesi">← İlanlar</a></div>
    </div>

    @if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }

    <p class="muted small">
        Bu ilan <strong>@_detail.Araclar.Count araç</strong> içeriyor.
        @if (_siblingCount > 0)
        {
            <text>Aynı modelden <strong>@_siblingCount taslak ilan</strong> daha var — girdiğiniz
            fiyat onlara da uygulanacak (sonra tek tek düzenleyebilirsiniz).</text>
        }
    </p>

    <form method="post" action="/web-sitesi/ilan/@Id/fiyat/kaydet" class="grid-form"><AntiforgeryToken />
        <label>Günlük Fiyat <span class="req">*</span>
            <input name="gunlukFiyat" type="number" step="0.01" min="0.01" required
                   value="@(_detail.Ilan.GunlukFiyat > 0 ? _detail.Ilan.GunlukFiyat : null)" />
            <span class="hint">1–7 günlük kiralamalarda geçerli.</span>
        </label>
        @* DİKKAT: bunlar TOPLAM tutardır (7/30 günün parası), günlük ücret DEĞİL. Tarife matrisindeki
           "GunHaftalik/GunAylik" alanları günlük ücrettir — karıştırmak fiyatı ~7 kat yanlış basar. *@
        <label>Haftalık Toplam
            <input name="haftalikToplam" type="number" step="0.01" min="0.01" value="@_detail.Ilan.HaftalikToplam" />
            <span class="hint">7 günün TOPLAM tutarı. 8–29 gün için kullanılır; boşsa günlük fiyattan hesaplanır.</span>
        </label>
        <label>Aylık Toplam
            <input name="aylikToplam" type="number" step="0.01" min="0.01" value="@_detail.Ilan.AylikToplam" />
            <span class="hint">30 günün TOPLAM tutarı. 30 gün ve üzeri için kullanılır.</span>
        </label>
        <label class="check">
            <input type="hidden" name="kdvDahil" value="false" />
            <input type="checkbox" name="kdvDahil" value="true" checked="@_detail.Ilan.KdvDahil" />
            Bu fiyatlara KDV dahil
            <span class="hint">Kartın altında "KDV dahil" ya da "+ KDV" olarak yazar.</span>
        </label>
        <div class="form-actions">
            <button type="submit" class="kf-btn primary">İleri →</button>
        </div>
    </form>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private bool _module;
    private WebIlanDetay? _detail;
    private int _siblingCount;

    protected override async Task OnInitializedAsync()
    {
        _module = Tenant.TenantId is { } t && await Durum.WebsiteModuleAsync(t);
        if (!_module) return;
        _detail = await Ilanlar.GetAsync(Id);
        if (_detail is not null) _siblingCount = await Ilanlar.SiblingDraftCountAsync(Id);
    }
}
