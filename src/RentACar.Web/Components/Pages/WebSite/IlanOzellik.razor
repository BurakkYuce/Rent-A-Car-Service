@page "/web-sitesi/ilan/{Id:guid}/ozellikler"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@using RentACar.Application.WebSite
@using RentACar.Domain.Common
@using RentACar.Infrastructure.Persistence
@inject WebListingService Ilanlar
@inject ITenantContext Tenant
@inject TenantStatusCache Durum

<PageTitle>Teknik Özellikler — Web Sitesi</PageTitle>

@if (!_module || _detail is null)
{
    <div class="page-head"><h1>Web Sitesi</h1></div>
    <p class="empty-state">@(_module ? "İlan bulunamadı." : "Bu modül firmanızda etkin değil.")</p>
}
else
{
    <div class="page-head">
        <h1>@_detail.Ilan.Baslik <span class="muted small">— 3/3 teknik özellikler</span></h1>
        <div class="actions"><a class="link" href="/web-sitesi">← İlanlar</a></div>
    </div>

    @if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }

    @* ---- FOTOĞRAFLAR ----
       Vitrinin yayın şartlarından biri "üye araçlardan en az birinin fotoğrafı var"
       (FleetShowcaseService). Bu blok olmadan sihirbazın mutlu yolu, sitede ASLA görünemeyecek bir
       ilan üretiyordu. Yükleme formu özellik formunun DIŞINDA (statik SSR'da iç içe form yasak) ve
       bu kart özellik tablosundan ÖNCE geliyor — eksik olduğunda ilk görülen şey olsun. *@
    <div class="card">
        <div class="page-head" style="margin:0">
            <h2 style="margin:0;font-size:1.05rem">Fotoğraflar</h2>
            @if (_photos.Count == 0)
            {
                <span class="badge warn" title="Fotoğrafsız ilan halka açık sitede gösterilmez">
                    Zorunlu — sitede görünmesi için en az 1 fotoğraf
                </span>
            }
            else
            {
                <span class="badge ok">@_photos.Count fotoğraf · ilk fotoğraf kapak olur</span>
            }
        </div>

        @if (_photos.Count > 0)
        {
            <div style="display:flex;flex-wrap:wrap;gap:.75rem;margin:.75rem 0">
                @foreach (var f in _photos)
                {
                    <figure style="margin:0;text-align:center">
                        @* Küçük görsel mevcut araç ucundan servis edilir (yeni okuma ucu AÇILMADI). *@
                        <img src="/vehicles/@f.VehicleId/photos/@f.PhotoId/thumb" alt="İlan fotoğrafı"
                             style="width:130px;height:90px;object-fit:cover;border-radius:6px;display:block" />
                        <figcaption class="muted small" style="margin-top:.2rem">@f.Plaka</figcaption>
                        @* Uç ilan-özel bir bağı değil ARACIN fotoğrafını siler (VehiclePhotoService.DeleteAsync) —
                           kullanıcı "yalnız ilandan çıkıyor" sanmasın diye mesaj bunu açıkça söyler. *@
                        <form method="post" action="/web-sitesi/ilan/@Id/foto/@f.VehicleId/@f.PhotoId/sil"
                              style="margin:.2rem 0 0"
                              data-confirm="@f.Plaka aracının bu fotoğrafı KALICI olarak silinsin mi? Fotoğraf yalnız ilandan değil aracın kendi kaydından da silinir; geri alınamaz."><AntiforgeryToken />
                            <button type="submit" class="link danger">Sil</button>
                        </form>
                    </figure>
                }
            </div>
        }

        <form method="post" action="/web-sitesi/ilan/@Id/foto" enctype="multipart/form-data"
              class="grid-form" style="margin:0"><AntiforgeryToken />
            <label>Fotoğraf ekle (PNG/JPEG/WebP, ≤2 MB)
                <input name="foto" type="file" accept="image/png,image/jpeg,image/webp" required /></label>
            <button type="submit" class="kf-btn">Yükle</button>
        </form>
        @if (_detail.Araclar.Count > 1)
        {
            <p class="muted small" style="margin:.5rem 0 0">Bu ilan @_detail.Araclar.Count aynı aracı
                birlikte gösteriyor; sitede tek kart çıktığı için <strong>tek fotoğraf yeterli</strong>
                (aynı görsel araç başına kopyalanmaz).</p>
        }
    </div>

    <p class="muted small">Aşağıdaki özellikler araç kayıtlarınızdan getirildi. <strong>İşaretli
        olanlar sitede görünür.</strong> Değerleri düzenleyebilir, sağ üstteki <strong>+</strong> ile
        yeni satır ekleyebilirsiniz (en fazla @FeatureSnapshot.MaxRows satır).
        @if (_detail.Araclar.Count > 1)
        {
            <text> Bu ilan @_detail.Araclar.Count araç içerdiği için <strong>araçlar arasında farklı
            olan alanlar (ör. renk) listeye eklenmedi</strong> — sitede yanlış bilgi çıkmasın diye.</text>
        }
    </p>

    @* Satır ekle/sil `rc-web-ilan.js` ile YENİLEMESİZ yapılır (CSP-uyumlu JS adası, inline handler
       yok). JS yüklenmezse ekran YİNE ÇALIŞIR: "+" bir <a> linkidir ve sayfayı `?bos=N+1` ile
       yeniden basar, silme ise satırı boşaltmakla olur (sunucu boş satırları ayıklar). *@
    <form method="post" action="/web-sitesi/ilan/@Id/ozellikler/kaydet"><AntiforgeryToken />
        <div class="table-scroll">
        <table class="grid tr-grid" data-ozellik-tablo data-max-satir="@FeatureSnapshot.MaxRows">
            <thead>
                <tr>
                    <th style="width:5rem">Sitede</th>
                    <th style="width:30%">Özellik</th>
                    <th>Değer</th>
                    <th style="width:3rem"></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < _rows.Count; i++)
                {
                    var s = _rows[i];
                    <tr>
                        @* Checkbox değeri satır İNDEKSİDİR — sunucu paralel dizilerle eşler.
                           JS satır silince bu değerleri YENİDEN NUMARALANDIRIR (yoksa görünürlük kayar). *@
                        <td><input type="checkbox" name="gorunur" value="@i" checked="@s.Gorunur" /></td>
                        <td><input name="etiket" value="@s.Etiket" maxlength="@FeatureSnapshot.MaxLabel" /></td>
                        <td><input name="deger" value="@s.Deger" maxlength="@FeatureSnapshot.MaxValue" /></td>
                        <td class="row-actions">
                            <button type="button" class="link danger" data-ozellik-sil
                                    title="Satırı sil" aria-label="Satırı sil">✕</button>
                        </td>
                    </tr>
                }
                @for (var i = _rows.Count; i < _rows.Count + _emptyRow; i++)
                {
                    <tr>
                        <td><input type="checkbox" name="gorunur" value="@i" checked /></td>
                        <td><input name="etiket" placeholder="Özellik adı" maxlength="@FeatureSnapshot.MaxLabel" /></td>
                        <td><input name="deger" placeholder="Değer" maxlength="@FeatureSnapshot.MaxValue" /></td>
                        <td class="row-actions">
                            <button type="button" class="link danger" data-ozellik-sil
                                    title="Satırı sil" aria-label="Satırı sil">✕</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <div class="form-actions">
            <a class="kf-btn" data-ozellik-ekle href="/web-sitesi/ilan/@Id/ozellikler?bos=@(_emptyRow + 1)"
               title="Yeni özellik satırı ekle">+ Özellik ekle</a>
            <button type="submit" class="kf-btn primary">
                @(_photos.Count == 0 ? "Özellikleri Kaydet" : "Yayınla")
            </button>
            @if (_photos.Count == 0)
            {
                <span class="muted small" style="align-self:center">Fotoğraf eklenene kadar ilan
                    taslakta kalır (kaydettiğiniz özellikler korunur).</span>
            }
        </div>
    </form>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    /// <summary>Kaç BOŞ satır gösterilsin ("+" her basışta bir artar). Statik SSR'da JS'siz satır ekleme.</summary>
    [SupplyParameterFromQuery(Name = "bos")] public int? Bos { get; set; }

    private bool _module;
    private WebIlanDetay? _detail;
    private IReadOnlyList<OzellikSatiri> _rows = [];
    private IReadOnlyList<IlanFotoSatiri> _photos = [];
    private int _emptyRow = 1;

    protected override async Task OnInitializedAsync()
    {
        _module = Tenant.TenantId is { } t && await Durum.WebsiteModuleAsync(t);
        if (!_module) return;
        _detail = await Ilanlar.GetAsync(Id);
        if (_detail is null) return;
        _rows = await Ilanlar.SuggestedFeaturesAsync(Id);
        _photos = await Ilanlar.PhotosAsync(Id);
        _emptyRow = Math.Clamp(Bos ?? 1, 1, FeatureSnapshot.MaxRows);
    }
}
