@page "/web-sitesi"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@using RentACar.Application.Vehicles
@using RentACar.Application.WebSite
@using RentACar.Domain.Common
@using RentACar.Domain.Entities
@using RentACar.Infrastructure.Persistence
@inject WebIlanService Ilanlar
@inject ITenantContext Tenant
@inject TenantStatusCache Durum

<PageTitle>Web Sitesi — RentPro</PageTitle>

@* PR-12: SAYFA da sunucuda modülü doğrular. `[Authorize]` yalnız rolü kontrol eder; menüyü
   gizlemek tek başına koruma değildir. *@
@if (!_modul)
{
    <div class="page-head"><h1>Web Sitesi</h1></div>
    <p class="empty-state">Bu modül firmanızda etkin değil.</p>
}
else
{
    <div class="page-head">
        <h1>Web Sitesi — İlanlar</h1>
        <div class="actions"><a class="kf-btn primary" href="/web-sitesi/arac-ekle">+ Araç Ekle</a></div>
    </div>

    @if (Ok == "1") { <p class="ok">Kaydedildi.</p> }
    @if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }

    <p class="muted small">Halka açık sitenizde hangi araçların, hangi fiyatla ve hangi teknik
        özelliklerle görüneceğini buradan yönetirsiniz. Bir ilan; tek bir aracı ya da birbirinin
        aynısı birden çok aracı temsil edebilir.</p>

    @if (_ilansiz > 0)
    {
        <p class="warn-strip">Sitede yayınlanmamış <strong>@_ilansiz araç</strong> var —
            "Araç Ekle" ile yayınlayabilirsiniz.</p>
    }

    @if (_satirlar.Count == 0)
    {
        <p class="empty-state">Henüz ilan oluşturmadınız — "Araç Ekle" ile başlayın.</p>
    }
    else
    {
        <div class="table-scroll">
        <table class="grid tr-grid">
            <thead>
                <tr>
                    <th>İlan</th><th class="num">Araç</th><th class="num">Vitrinde</th>
                    <th class="num">Günlük</th><th>Durum</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _satirlar)
                {
                    <tr>
                        <td>
                            @s.Baslik
                            @if (s.OzellikBayat)
                            {
                                <span class="badge warn" title="Araç bilgileri değişmiş ama ilandaki teknik özellikler eski değeri gösteriyor.">özellikler eskimiş</span>
                            }
                        </td>
                        <td class="num">@s.AracSayisi</td>
                        <td class="num">@s.Adet</td>
                        <td class="num">
                            @(s.GunlukFiyat > 0 ? s.GunlukFiyat.ToString("N2") : "—")
                            @if (s.GunlukFiyat > 0)
                            {
                                <span class="muted small">@(s.KdvDahil ? "KDV dahil" : "+ KDV")</span>
                            }
                        </td>
                        <td>
                            @if (s.Yayinda)
                            {
                                <span class="badge ok">Yayında</span>
                            }
                            else
                            {
                                @* Teşhis TIKLANABİLİR olmalı: "Foto yok" rozetini görüp de çareye
                                   ulaşamamak canlıda tam olarak yaşandı (tek yol araç ekranıydı). *@
                                @if (s.Eksikler.Contains("Foto yok"))
                                {
                                    <a class="badge warn" href="/web-sitesi/ilan/@s.Id/ozellikler"
                                       title="Fotoğraf eklemek için tıklayın — fotoğrafsız ilan sitede görünmez">
                                        Foto yok → ekle
                                    </a>
                                    @foreach (var e in s.Eksikler.Where(x => x != "Foto yok"))
                                    {
                                        <span class="badge warn">@e</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge warn">@string.Join(" · ", s.Eksikler)</span>
                                }
                            }
                        </td>
                        <td class="row-actions">
                            <a class="link" href="/web-sitesi/ilan/@s.Id/fiyat">Fiyat</a>
                            <a class="link" href="/web-sitesi/ilan/@s.Id/ozellikler">Özellikler / Foto</a>
                            @if (s.Durum == WebIlanDurum.Yayinda)
                            {
                                <form method="post" action="/web-sitesi/ilan/@s.Id/durum" class="inline-form"><AntiforgeryToken />
                                    <input type="hidden" name="durum" value="pasif" />
                                    <button type="submit" class="link">Gizle</button>
                                </form>
                            }
                            else if (s.Durum == WebIlanDurum.Pasif)
                            {
                                <form method="post" action="/web-sitesi/ilan/@s.Id/durum" class="inline-form"><AntiforgeryToken />
                                    <input type="hidden" name="durum" value="yayinda" />
                                    <button type="submit" class="link">Yayınla</button>
                                </form>
                            }
                            <form method="post" action="/web-sitesi/ilan/@s.Id/sil" class="inline-form"
                                  data-confirm="'@s.Baslik' ilanı silinsin mi? Araçlar silinmez, yalnız siteden kalkar."><AntiforgeryToken />
                                <button type="submit" class="link danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private bool _modul;
    private IReadOnlyList<WebIlanSatiri> _satirlar = [];
    private int _ilansiz;

    protected override async Task OnInitializedAsync()
    {
        _modul = Tenant.TenantId is { } id && await Durum.WebSitesiModuluAsync(id);
        if (!_modul) return;

        _satirlar = await Ilanlar.ListAsync(); // foto durumu servis içinde TEK toplu sorguyla
        _ilansiz = await Ilanlar.IlansizAracSayisiAsync();
    }
}
