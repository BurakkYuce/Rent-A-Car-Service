@page "/web-sitesi/arac-ekle"
@attribute [Authorize(Roles = "Admin,Yonetici,Operator")]
@using RentACar.Application.WebSite
@using RentACar.Domain.Common
@using RentACar.Infrastructure.Persistence
@inject WebIlanService Ilanlar
@inject ITenantContext Tenant
@inject TenantStatusCache Durum

<PageTitle>Araç Ekle — Web Sitesi</PageTitle>

@if (!_modul)
{
    <div class="page-head"><h1>Web Sitesi</h1></div>
    <p class="empty-state">Bu modül firmanızda etkin değil.</p>
}
else
{
    <div class="page-head">
        <h1>Araç Ekle <span class="muted small">— 1/3 araç seçimi</span></h1>
        <div class="actions"><a class="link" href="/web-sitesi">← İlanlar</a></div>
    </div>

    @if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }

    @if (_havuz.Count == 0)
    {
        <p class="empty-state">Yayınlanmayı bekleyen araç yok — filodaki tüm araçlar zaten bir ilana bağlı.</p>
    }
    else
    {
        @* Mod anahtarı: statik SSR'da JS yok → query string ile (araç listesindeki "görünüm"
           anahtarının aynı deseni). Seçim formu moda göre farklı satırlar basar. *@
        <div class="view-toggle">
            <a href="/web-sitesi/arac-ekle" class="@(_ayri ? "" : "on")">Aynı araçları beraber göster</a>
            <a href="/web-sitesi/arac-ekle?mod=ayri" class="@(_ayri ? "on" : "")">Ayrı göster</a>
        </div>
        <p class="muted small">
            @if (_ayri)
            {
                <text><strong>Ayrı:</strong> seçtiğiniz her araç sitede KENDİ kartı olur. Fiyat ve
                teknik özellikleri bir kez girersiniz, hepsine aynısı uygulanır; sonra tek tek
                düzenleyebilirsiniz.</text>
            }
            else
            {
                <text><strong>Beraber:</strong> birbirinin aynısı araçlar sitede TEK kart olur
                ("4 araç" olarak görünür). Bir satırı seçtiğinizde o modeldeki araçların hepsi seçilir.</text>
            }
        </p>

        <form method="post" action="/web-sitesi/ilan/olustur"><AntiforgeryToken />
            <input type="hidden" name="mod" value="@(_ayri ? "ayri" : "beraber")" />
            <div class="table-scroll">
            <table class="grid tr-grid">
                <thead>
                    <tr>
                        <th style="width:2.5rem"></th>
                        <th>Araç</th>
                        <th>Yıl</th>
                        @if (_ayri) { <th>Plaka</th> } else { <th class="num">Adet</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in _havuz)
                    {
                        @if (_ayri)
                        {
                            @foreach (var v in k.Araclar)
                            {
                                <tr>
                                    <td><input type="checkbox" name="aracId" value="@v.Id" /></td>
                                    <td>@k.Baslik</td>
                                    <td>@(v.ModelYili?.ToString() ?? "—")</td>
                                    <td class="mono">@v.Plaka</td>
                                </tr>
                            }
                        }
                        else
                        {
                            @* Beraber modda checkbox ARAÇ ID'si değil İMZA taşır; sunucu onu o anda
                               uygun olan araçlara açar. "Bir satırı seçince o modeldeki araçların
                               hepsi seçilsin" davranışı statik SSR'da (JS yok) böyle sağlanır. *@
                            <tr>
                                <td><input type="checkbox" name="imza" value="@k.Imza" /></td>
                                <td>@k.Baslik</td>
                                <td>@(k.YilAralik ?? "—")</td>
                                <td class="num">@k.Araclar.Count</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            </div>
            <div class="form-actions">
                <button type="submit" class="kf-btn primary">İleri →</button>
            </div>
        </form>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "mod")] public string? Mod { get; set; }
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private bool _modul;
    private bool _ayri;
    private IReadOnlyList<AracKumesi> _havuz = [];

    protected override async Task OnInitializedAsync()
    {
        _modul = Tenant.TenantId is { } id && await Durum.WebSitesiModuluAsync(id);
        if (!_modul) return;
        _ayri = string.Equals(Mod, "ayri", StringComparison.OrdinalIgnoreCase);
        _havuz = await Ilanlar.HavuzAsync();
    }
}
