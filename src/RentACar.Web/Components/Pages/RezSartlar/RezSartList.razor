@page "/rez-sartlari"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@inject ReservationTermService RezSartlari
@inject CustomerService Customers

<PageTitle>Rez Şartları — RentPro</PageTitle>

<div class="page-head"><h1>Rez Şartları (Müşteri Özel Talepleri)</h1></div>
<p class="muted small">Rezervasyon/teklif üzerindeki müşteri özel talepleri ve karşılanma takibi.
    Operasyonel not defteridir: para taşımaz, deftere kayıt postlamaz, fiyatı etkilemez.
    Ücretli ek hizmet için kira ekranındaki Ek Hizmet satırlarını kullanın.</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_list.Count == 0)">
    <summary>+ Yeni Şart / Talep</summary>
    <form method="post" action="/rez-sartlari/create" class="grid-form"><AntiforgeryToken />
        <label>Müşteri
            <select name="musteriId" required>
                <option value="">— seç —</option>
                @foreach (var c in _customers)
                {
                    <option value="@c.Id">@c.DisplayName</option>
                }
            </select>
        </label>
        <label>Şart / Talep<input name="sart" maxlength="512" required placeholder="Bebek koltuğu istiyor" /></label>
        <label>Grup<input name="grup" maxlength="64" list="rezsart-gruplar" placeholder="Ekipman / Teslim / Ödeme" />
            <datalist id="rezsart-gruplar">
                @foreach (var g in _groups) { <option value="@g"></option> }
            </datalist>
        </label>
        <label>Geçerlilik Baş<input name="basTar" type="date" /></label>
        <label>Geçerlilik Bit<input name="bitTar" type="date" /></label>
        <label>Talep Tarihi<input name="talepTarihi" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" /></label>
        <label>Teslim Eden<input name="teslimEden" maxlength="128" /></label>
        <button type="submit">Oluştur</button>
    </form>
</details>

@* Filtre GET formu: JS yok, URL paylaşılabilir (?durum=bekleyen&musteriId=…). *@
<form method="get" class="filter-bar">
    <label>Müşteri
        <select name="musteriId">
            <option value="">— tümü —</option>
            @foreach (var c in _customers)
            {
                <option value="@c.Id" selected="@(c.Id.ToString() == MusteriId)">@c.DisplayName</option>
            }
        </select>
    </label>
    <label>Durum
        <select name="durum">
            <option value="" selected="@(string.IsNullOrEmpty(Durum))">— tümü —</option>
            <option value="bekleyen" selected="@(Durum == "bekleyen")">Karşılanmadı</option>
            <option value="karsilanan" selected="@(Durum == "karsilanan")">Karşılandı</option>
        </select>
    </label>
    <label>Talep Baş<input name="bas" type="date" value="@Bas" /></label>
    <label>Talep Bit<input name="bit" type="date" value="@Bit" /></label>
    <button type="submit">Filtrele</button>
    @if (FiltreVar)
    {
        <a class="link" href="/rez-sartlari">Temizle</a>
    }
</form>

<p class="muted small">@_list.Count kayıt · @_list.Count(r => r.KarsilamaTarihi is null) bekleyen</p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead>
        <tr><th>Talep Tarihi</th><th>Müşteri</th><th>Grup</th><th>Şart / Talep</th><th>Geçerlilik</th><th>Durum</th><th>Teslim Eden</th><th>İşlem</th></tr>
    </thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="8" class="muted">Kayıt yok.</td></tr>
        }
        @foreach (var r in _list)
        {
            <tr>
                <td>@r.TalepTarihi.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td>@Cust(r.MusteriId)</td>
                <td>@(r.Grup ?? "—")</td>
                <td>@r.Sart</td>
                <td>@RangeLabel(r)</td>
                <td>
                    @if (r.KarsilamaTarihi is { } k)
                    {
                        <span class="status-pill sp-success">Karşılandı @k.LocalDateTime.ToString("dd.MM.yyyy")</span>
                    }
                    else
                    {
                        <span class="status-pill sp-warn">Bekliyor</span>
                    }
                </td>
                <td>@(r.TeslimEden ?? "—")</td>
                <td class="row-actions">
                    @if (r.KarsilamaTarihi is null)
                    {
                        <form method="post" action="/rez-sartlari/karsilandi"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="link">Karşılandı</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" action="/rez-sartlari/geri-al"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="link">Geri Al</button>
                        </form>
                    }
                    <details>
                        <summary class="link">Düzenle</summary>
                        <form method="post" action="/rez-sartlari/update" class="grid-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@r.Id" />
                            <label>Müşteri
                                <select name="musteriId" required>
                                    @foreach (var c in _customers) { <option value="@c.Id" selected="@(c.Id == r.MusteriId)">@c.DisplayName</option> }
                                </select>
                            </label>
                            <label>Şart / Talep<input name="sart" maxlength="512" value="@r.Sart" required /></label>
                            <label>Grup<input name="grup" maxlength="64" value="@r.Grup" list="rezsart-gruplar" /></label>
                            <label>Geçerlilik Baş<input name="basTar" type="date" value="@r.BasTar?.LocalDateTime.ToString("yyyy-MM-dd")" /></label>
                            <label>Geçerlilik Bit<input name="bitTar" type="date" value="@r.BitTar?.LocalDateTime.ToString("yyyy-MM-dd")" /></label>
                            <label>Talep Tarihi<input name="talepTarihi" type="date" value="@r.TalepTarihi.LocalDateTime.ToString("yyyy-MM-dd")" /></label>
                            <label>Karşılama Tarihi<input name="karsilamaTarihi" type="date" value="@r.KarsilamaTarihi?.LocalDateTime.ToString("yyyy-MM-dd")" /></label>
                            <label>Teslim Eden<input name="teslimEden" maxlength="128" value="@r.TeslimEden" /></label>
                            <button type="submit">Kaydet</button>
                        </form>
                    </details>
                    <form method="post" action="/rez-sartlari/delete" data-confirm="Talep silinsin mi?"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@r.Id" />
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "musteriId")] public string? MusteriId { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }

    private IReadOnlyList<RezSart> _list = [];
    private IReadOnlyList<Customer> _customers = [];
    private Dictionary<Guid, string> _custMap = new();
    private string[] _groups = [];

    private bool FiltreVar => !string.IsNullOrWhiteSpace(MusteriId) || !string.IsNullOrWhiteSpace(Durum)
        || !string.IsNullOrWhiteSpace(Bas) || !string.IsNullOrWhiteSpace(Bit);

    protected override async Task OnInitializedAsync()
    {
        _customers = await Customers.ListAsync();
        _custMap = _customers.ToDictionary(c => c.Id, c => c.DisplayName);

        var filter = new RezSartFilter
        {
            MusteriId = Guid.TryParse(MusteriId, out var m) ? m : null,
            Karsilandi = Durum switch { "bekleyen" => false, "karsilanan" => true, _ => (bool?)null },
            TarihBas = Date(Bas),
            // Üst sınır GÜN SONUNA genişletilir: "…bit=05.08" seçildiğinde o günün kayıtları
            // dışarıda kalmamalı (tarih girişi 00:00'a düşer).
            TarihBit = Date(Bit)?.AddDays(1).AddTicks(-1)
        };
        _list = await RezSartlari.ListAsync(filter);

        _groups = (await RezSartlari.ListAsync())
            .Select(r => r.Grup).Where(g => !string.IsNullOrWhiteSpace(g))
            .Select(g => g!).Distinct().OrderBy(g => g).ToArray();
    }

    private static DateTimeOffset? Date(string? s)
        => DateTimeOffset.TryParse(s, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? d.ToUniversalTime() : null;

    private string Cust(Guid id) => _custMap.GetValueOrDefault(id, "—");

    private static string RangeLabel(RezSart r) => (r.BasTar, r.BitTar) switch
    {
        ({ } b, { } t) => $"{b.LocalDateTime:dd.MM.yyyy} – {t.LocalDateTime:dd.MM.yyyy}",
        ({ } b, null) => $"{b.LocalDateTime:dd.MM.yyyy} –",
        (null, { } t) => $"– {t.LocalDateTime:dd.MM.yyyy}",
        _ => "—"
    };
}
