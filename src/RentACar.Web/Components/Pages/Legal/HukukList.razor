@page "/hukuk"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@inject HukukDosyaService Hukuk
@inject CustomerService Cariler
@using System.Globalization
@using RentACar.Application.Legal
@using RentACar.Domain.Enums

<PageTitle>Hukuk — RentPro</PageTitle>

<div class="page-head"><h1>Hukuk Dosyaları</h1>
    <div class="actions">
        <a href="/listeler/export/hukuk?@Qs("excel")">Excel</a> ·
        <a href="/listeler/export/hukuk?@Qs("csv")">CSV</a> ·
        <a href="/listeler/export/hukuk?@Qs("pdf")">PDF</a>
    </div>
</div>

@* Kullanıcıya YAZILI çit: bu ekrandaki para alanları muhasebeye girmez (KARARLAR.md genel politikası). *@
<p class="muted small"><strong>Tutar / Tahsilat / Kalan bilgi amaçlıdır — muhasebe defterine ve cari
    bakiyeye İŞLEMEZ.</strong> Gerçek tahsilat Kasa/Banka ekranından cari üzerine girilir; buraya
    yazılan rakam hiçbir mali raporu değiştirmez.</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<form method="get" class="filter-bar">
    <label>Ad Soyad (müşteri)
        <select name="cariId">
            <option value="">— tümü —</option>
            @foreach (var c in _cariler) { <option value="@c.Id" selected="@(c.Id.ToString() == CariId)">@c.DisplayName</option> }
        </select>
    </label>
    <label>Dosya No<input name="dosyaNo" value="@DosyaNo" placeholder="içinde geçen" /></label>
    <label>Fatura No<input name="faturaNo" value="@FaturaNo" placeholder="içinde geçen" /></label>
    <label>Tarih Baş.<input name="bas" type="date" value="@Bas" /></label>
    <label>Tarih Bit.<input name="bit" type="date" value="@Bit" /></label>
    <label>Tür
        <select name="tur">
            <option value="">— tümü —</option>
            @foreach (var t in Enum.GetValues<HukukTuru>()) { <option value="@t" selected="@(t.ToString() == Tur)">@t</option> }
        </select>
    </label>
    <label>Durum
        <select name="durum">
            <option value="">— tümü —</option>
            @foreach (var d in Enum.GetValues<HukukDurum>()) { <option value="@d" selected="@(d.ToString() == Durum)">@d</option> }
        </select>
    </label>
    <label>Ara<input name="ara" value="@Ara" placeholder="avukat / açıklama" /></label>
    <button type="submit">Filtrele</button>
    @if (FiltreVar) { <a class="link" href="/hukuk">Temizle</a> }
</form>

<p class="muted small">@_rows.Count dosya · @_rows.Count(x => x.Dosya.Durum == HukukDurum.Acik) açık ·
    toplam tutar @Toplam(_rows.Sum(x => x.Dosya.Tutar)) · tahsilat @Toplam(_rows.Sum(x => x.Dosya.Tahsilat ?? 0m)) ·
    kalan @Toplam(_rows.Sum(x => x.Dosya.Kalan)) <em>(bilgi)</em></p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Dosya No</th><th>Müşteri</th><th>Fatura No</th><th>Tür</th><th>Avukat</th>
        <th>Avukat Tel</th><th>2. Avukat</th><th class="num">Tutar</th><th class="num">Tahsilat</th>
        <th class="num">Kalan</th><th>Durum</th><th>Tarih</th><th></th></tr></thead>
    <tbody>
        @if (_rows.Count == 0)
        {
            <tr><td colspan="13" class="muted">@(FiltreVar ? "Filtreye uyan dosya yok." : "Kayıt yok.")</td></tr>
        }
        @foreach (var r in _rows)
        {
            var h = r.Dosya;
            <tr>
                <td>@h.DosyaNo</td>
                @* Müşteri adı dosyada SAKLANMAZ, cariden çözülür — cari yeniden adlandırılırsa liste doğru kalır. *@
                <td>@(r.MusteriAd ?? "—")</td>
                <td class="mono">@(h.FaturaNoTemp ?? "—")</td>
                <td>@h.Tur</td>
                <td>@(h.Avukat ?? "—")</td>
                <td>@(h.AvukatTel ?? "—")</td>
                <td>@(h.Avukat2Ad ?? "—")</td>
                <td class="num">@h.Tutar.ToString("N2")</td>
                <td class="num">@(h.Tahsilat?.ToString("N2") ?? "—")</td>
                <td class="num">@h.Kalan.ToString("N2")</td>
                <td>
                    <span class="status-pill @(h.Durum == HukukDurum.Acik ? "sp-warn" : "sp-success")">@h.Durum</span>
                </td>
                <td>@h.Tarih.LocalDateTime.ToString("yyyy-MM-dd")</td>
                <td><a href="/hukuk?duzenle=@h.Id" class="link">Düzenle</a></td>
            </tr>
        }
    </tbody>
</table>
</div>

<h2 class="dash-h2">@(_edit is null ? "Yeni Dosya" : $"Düzenle: {_edit.DosyaNo}")</h2>
<form method="post" action="@(_edit is null ? "/hukuk/create" : "/hukuk/update")" class="grid-form"><AntiforgeryToken />
    @if (_edit is not null)
    {
        <input type="hidden" name="id" value="@_edit.Id" />
    }
    <label>Dosya No<input name="dosyaNo" value="@_edit?.DosyaNo" required maxlength="64" /></label>
    <label>Fatura No<input name="faturaNoTemp" value="@_edit?.FaturaNoTemp" maxlength="64" /></label>
    <label>Tür
        <select name="tur">
            @foreach (var t in Enum.GetValues<HukukTuru>())
            {
                <option value="@t" selected="@(_edit?.Tur == t)">@t</option>
            }
        </select></label>
    <label>Müşteri (cari)
        <select name="cariId">
            <option value="">—</option>
            @foreach (var c in _cariler) { <option value="@c.Id" selected="@(c.Id == _edit?.CariId)">@c.DisplayName</option> }
        </select></label>
    <label>Avukat<input name="avukat" value="@_edit?.Avukat" maxlength="128" /></label>
    <label>Avukat Tel<input name="avukatTel" value="@_edit?.AvukatTel" maxlength="32" /></label>
    <label>Avukat E-posta<input name="avukatMail" type="email" value="@_edit?.AvukatMail" maxlength="256" /></label>
    <label>2. Avukat<input name="avukat2Ad" value="@_edit?.Avukat2Ad" maxlength="128" /></label>
    <label>2. Avukat Tel<input name="avukat2Tel" value="@_edit?.Avukat2Tel" maxlength="32" /></label>
    <label>2. Avukat E-posta<input name="avukat2Mail" type="email" value="@_edit?.Avukat2Mail" maxlength="256" /></label>
    @* decimal → InvariantCulture: tr-TR biçimi ("1.234,50") input[type=number]'da veri kaybettirir. *@
    <label>Tutar (bilgi)<input name="tutar" type="number" step="0.01" min="0" value="@Inv(_edit?.Tutar)" /></label>
    <label>Tahsilat (bilgi)<input name="tahsilat" type="number" step="0.01" min="0" value="@Inv(_edit?.Tahsilat)" /></label>
    <label>Kalan (hesaplanan)
        <input value="@Inv(_edit?.Kalan)" readonly disabled />
        <span class="muted small">Kalan = Tutar − Tahsilat. Deftere işlemez.</span>
    </label>
    <label>Durum
        <select name="durum">
            @foreach (var d in Enum.GetValues<HukukDurum>())
            {
                <option value="@d" selected="@(_edit?.Durum == d)">@d</option>
            }
        </select></label>
    <label>Tarih<input name="tarih" type="date" value="@(_edit?.Tarih.LocalDateTime.ToString("yyyy-MM-dd"))" /></label>
    <label class="u-col-full">Açıklama<input name="aciklama" value="@_edit?.Aciklama" maxlength="1024" /></label>
    <label>Aktif<input name="aktif" type="checkbox" value="true" checked="@(_edit?.Aktif ?? true)" /></label>
    <button type="submit">@(_edit is null ? "Ekle" : "Kaydet")</button>
    @if (_edit is not null)
    {
        <a href="/hukuk" class="btn-secondary">İptal</a>
    }
</form>

@if (_edit is not null)
{
    <form method="post" action="/hukuk/delete" data-confirm="Dosya silinsin mi?"><AntiforgeryToken />
        <input type="hidden" name="id" value="@_edit.Id" />
        <button type="submit" class="btn-danger">Sil</button>
    </form>
}

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "duzenle")] public Guid? Duzenle { get; set; }
    [SupplyParameterFromQuery(Name = "cariId")] public string? CariId { get; set; }
    [SupplyParameterFromQuery(Name = "dosyaNo")] public string? DosyaNo { get; set; }
    [SupplyParameterFromQuery(Name = "faturaNo")] public string? FaturaNo { get; set; }
    [SupplyParameterFromQuery(Name = "bas")] public string? Bas { get; set; }
    [SupplyParameterFromQuery(Name = "bit")] public string? Bit { get; set; }
    [SupplyParameterFromQuery(Name = "tur")] public string? Tur { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }
    [SupplyParameterFromQuery(Name = "ara")] public string? Ara { get; set; }

    private IReadOnlyList<HukukDosyaSatirDto> _rows = [];
    private RentACar.Domain.Entities.HukukDosya? _edit;
    private IReadOnlyList<Customer> _cariler = [];

    private bool FiltreVar => !string.IsNullOrWhiteSpace(CariId) || !string.IsNullOrWhiteSpace(DosyaNo)
        || !string.IsNullOrWhiteSpace(FaturaNo) || !string.IsNullOrWhiteSpace(Bas) || !string.IsNullOrWhiteSpace(Bit)
        || !string.IsNullOrWhiteSpace(Tur) || !string.IsNullOrWhiteSpace(Durum) || !string.IsNullOrWhiteSpace(Ara);

    protected override async Task OnInitializedAsync()
    {
        _cariler = await Cariler.ListAsync();
        _rows = await Hukuk.SearchAsync(new HukukDosyaFilter
        {
            CariId = FormParse.Id(CariId),
            DosyaNo = DosyaNo,
            FaturaNo = FaturaNo,
            Bas = FormParse.Date(Bas),
            // Bitiş GÜN SONUNA genişletilir; aksi halde "01.03" seçmek o günün kayıtlarını dışarıda bırakırdı.
            Bit = FormParse.Date(Bit)?.AddDays(1).AddTicks(-1),
            Tur = Enum.TryParse<HukukTuru>(Tur, out var t) ? t : null,
            Durum = Enum.TryParse<HukukDurum>(Durum, out var d) ? d : null,
            Ara = Ara
        });

        if (Duzenle is { } id) _edit = await Hukuk.GetAsync(id);
    }

    private static string? Inv(decimal? d) => d?.ToString(CultureInfo.InvariantCulture);
    private static string Toplam(decimal d) => d.ToString("N2");

    private string Qs(string format)
    {
        var p = new List<string> { "format=" + format };
        void Ekle(string ad, string? deger)
        {
            if (!string.IsNullOrWhiteSpace(deger)) p.Add($"{ad}={Uri.EscapeDataString(deger)}");
        }
        Ekle("cariId", CariId); Ekle("dosyaNo", DosyaNo); Ekle("faturaNo", FaturaNo);
        Ekle("bas", Bas); Ekle("bit", Bit); Ekle("tur", Tur); Ekle("durum", Durum); Ekle("ara", Ara);
        return string.Join("&", p);
    }
}
