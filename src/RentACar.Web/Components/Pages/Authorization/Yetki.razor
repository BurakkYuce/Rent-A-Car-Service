@page "/yetki"
@attribute [Authorize(Roles = "Admin")]
@inject ScreenPermissionService Yetkiler
@using RentACar.Domain.Enums

<PageTitle>Ekran Yetkileri — RentPro</PageTitle>

<div class="page-head"><h1>Ekran Yetkileri (override)</h1><div class="actions"></div></div>
<p class="muted small">Rol-izin matrisi (floor) ÜSTÜNE ekran-bazlı sıkılaştırma. Bir ekran için override
    tanımlarsanız <strong>yalnız seçili roller</strong> erişir (deny-by-default), ama matris izni yine şarttır
    (override yetkiyi GENİŞLETMEZ). Override yoksa matris aynen geçerlidir.</p>
@if (Ok == "1")
{
    <p class="ok">Kaydedildi.</p>
}
@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Ekran Kodu</th><th>İzinli Roller</th><th>Aktif</th><th></th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="4" class="muted">Override yok (tüm ekranlar matris floor'una göre).</td></tr>
        }
        @foreach (var s in _list)
        {
            <tr>
                <td>@s.EkranKodu</td>
                <td>@s.AllowedRolesCsv</td>
                <td>@(s.Aktif ? "Evet" : "Hayır")</td>
                <td>
                    <form method="post" action="/yetki/sil" data-confirm="Override kaldırılsın mı?">
                        <input type="hidden" name="ekranKodu" value="@s.EkranKodu" />
                        <button type="submit" class="btn-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<h2>Override Ekle / Güncelle</h2>
<form method="post" action="/yetki/set" class="grid-form">
    <label>Ekran Kodu<input name="ekranKodu" placeholder="ör. personel, donem-kapanis" required /></label>
    <fieldset>
        <legend>İzinli Roller</legend>
        @foreach (var r in Enum.GetValues<UserRole>())
        {
            <label><input type="checkbox" name="roller" value="@r" /> @r</label>
        }
    </fieldset>
    <label>Aktif<input type="checkbox" name="aktif" value="true" checked /></label>
    <button type="submit">Kaydet</button>
</form>

<h2>Rol Yetki Kopyala (şablon)</h2>
<p class="muted small">Kaynak rolün erişebildiği TÜM ekran override'larına hedef rolü ekler (yalnız ekleme;
    kimsenin erişimi kaldırılmaz). Yeni bir rolü hızlı yetkilendirmek için.</p>
<form method="post" action="/yetki/kopyala" class="grid-form" data-confirm="Kaynak rolün ekran erişimi hedefe kopyalansın mı?">
    <label>Kaynak Rol
        <select name="kaynak" required>
            @foreach (var r in Enum.GetValues<UserRole>()) { <option value="@r">@r</option> }
        </select>
    </label>
    <label>Hedef Rol
        <select name="hedef" required>
            @foreach (var r in Enum.GetValues<UserRole>()) { <option value="@r">@r</option> }
        </select>
    </label>
    <button type="submit">Kopyala</button>
</form>

<h2>Yetki Grupları (şablon)</h2>
<p class="muted small">Mevcut TÜM ekran-izni yapılandırmasını isimli bir profil olarak kaydet; sonra tek tıkla
    yeniden uygula. GÜVENLİK: uygulamak yalnız ekran-override'larını yazar — rol-izin matrisi (floor) değişmez,
    bir profil kimseye rolünün ötesinde erişim VEREMEZ.</p>
<form method="post" action="/yetki/grup/kaydet" class="grid-form">
    <label>Şablon Adı<input name="ad" placeholder="ör. Sıkı Şube Profili" required /></label>
    <button type="submit">Mevcut Yapılandırmayı Kaydet</button>
</form>
@if (_gruplar is { Count: > 0 })
{
    <div class="table-scroll">
    <table class="grid">
        <thead><tr><th>Şablon</th><th>Ekran Sayısı</th><th></th></tr></thead>
        <tbody>
        @foreach (var g in _gruplar)
        {
            <tr>
                <td>@g.Ad</td>
                <td>@KalemSayisi(g.KalemlerJson)</td>
                <td>
                    <form method="post" action="/yetki/grup/uygula" data-confirm="'@g.Ad' şablonu uygulansın mı?">
                        <input type="hidden" name="ad" value="@g.Ad" /><button type="submit">Uygula</button>
                    </form>
                    <form method="post" action="/yetki/grup/sil" data-confirm="'@g.Ad' şablonu silinsin mi?">
                        <input type="hidden" name="ad" value="@g.Ad" /><button type="submit" class="btn-secondary">Sil</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
else
{
    <p class="muted">Kayıtlı şablon yok.</p>
}

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    private IReadOnlyList<RentACar.Domain.Entities.ScreenPermission> _list = [];
    private IReadOnlyList<RentACar.Domain.Entities.YetkiGrup> _gruplar = [];

    protected override async Task OnInitializedAsync()
    {
        _list = await Yetkiler.ListAsync();
        _gruplar = await Yetkiler.ListGruplarAsync();
    }

    private static int KalemSayisi(string json)
    {
        try { return System.Text.Json.JsonSerializer.Deserialize<List<RentACar.Application.Authorization.YetkiGrupKalem>>(json)?.Count ?? 0; }
        catch { return 0; }
    }
}
