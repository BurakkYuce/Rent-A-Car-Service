@page "/doluluk-kurallari"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@using RentACar.Application.DolulukFiyat
@inject OccupancyPriceRuleService Kurallar
@inject VehicleGroupService Gruplar
@inject BranchService Subeler

<PageTitle>Doluluk Fiyat Kuralları — RentPro</PageTitle>

<div class="page-head"><h1>Doluluk Fiyat Kuralları</h1></div>
<p class="muted small">Grup doluluğu eşiği aşınca OTOMATİK tarife fiyatına +% çarpan (tavan %50; yalnız motor
    fiyatı — manuel fiyat etkilenmez; rezervasyon güncellemesinde uygulanmaz). İndirim/hediye matrahı çarpanlı bazdan.</p>
@if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }

<form method="post" action="/doluluk-kurallari/create" class="grid-form"><AntiforgeryToken />
    <label>Kod<input name="kod" maxlength="32" required /></label>
    <label>Ad<input name="ad" maxlength="128" required /></label>
    <label>Araç Grubu (boş = tümü)
        <select name="aracGrupKod"><option value="">—</option>
            @foreach (var g in _gruplar) { <option value="@g.Kod">@g.Kod — @g.Ad</option> }
        </select>
    </label>
    <label>Doluluk Eşiği %<input name="esikYuzde" type="number" min="1" max="100" required /></label>
    <label>Çarpan % (tavan 50)<input name="carpanYuzde" type="number" step="0.01" min="0" max="50" required /></label>
    <ComboBox Name="sube" Label="Şube" Options="_subeOpts" Placeholder="(tümü)" />
    <label>Sadece Kendi Şubeleri
        <select name="sadeceKendiSubeleri"><option value="false">Hayır</option><option value="true">Evet</option></select>
    </label>
    <label>Geçerlilik Başlangıç<input name="gecerlilikBas" type="date" /></label>
    <label>Geçerlilik Bitiş<input name="gecerlilikBit" type="date" /></label>
    <button type="submit">Ekle</button>
</form>

@* FAZ-73 — canlı doluluk_algoritma.aspx paritesi: aynı grup için 10 kademe TEK formda.
   Motor/entity DEĞİŞMEZ; bu yalnız 10 ayrı "Ekle" tıklamasının kısayolu (kod = ön ek + eşik).
   Boş bırakılan satırlar atlanır; herhangi bir satır geçersizse HİÇBİRİ yazılmaz (yarım merdiven
   bırakmamak için servis önce tümünü doğrular). *@
<details class="new-vehicle">
    <summary>+ Toplu Kademe Girişi (10 kademe tek formda)</summary>
    <p class="muted small">Ortak kapsam bir kez girilir, kademeler aşağıdaki satırlara yazılır.
        Kod = <code>ÖNEK-eşik</code>, ad = <code>Ad öneki %eşik</code>. Boş satırlar atlanır; bir satır
        bile geçersizse hiçbir kademe kaydedilmez.</p>
    <form method="post" action="/doluluk-kurallari/toplu" class="grid-form"><AntiforgeryToken />
        <label>Kod Ön Eki<input name="kodOnEk" maxlength="24" required placeholder="YAZ-EKO" /></label>
        <label>Ad Ön Eki<input name="adOnEk" maxlength="100" required placeholder="Yaz Doluluk" /></label>
        <label>Araç Grubu (boş = tümü)
            <select name="aracGrupKod"><option value="">—</option>
                @foreach (var g in _gruplar) { <option value="@g.Kod">@g.Kod — @g.Ad</option> }
            </select>
        </label>
        <ComboBox Name="sube" Label="Şube" Options="_subeOpts" Placeholder="(tümü)" ListId="dl-sube-toplu" />
        <label>Sadece Kendi Şubeleri
            <select name="sadeceKendiSubeleri"><option value="false">Hayır</option><option value="true">Evet</option></select>
        </label>
        <label>Geçerlilik Başlangıç<input name="gecerlilikBas" type="date" /></label>
        <label>Geçerlilik Bitiş<input name="gecerlilikBit" type="date" /></label>
        @for (var i = 0; i < 10; i++)
        {
            var n = i;
            <label>Kademe @(n + 1) — Eşik %<input name="esik_@n" type="number" min="1" max="100" /></label>
            <label>Kademe @(n + 1) — Çarpan %<input name="carpan_@n" type="number" step="0.01" min="0" max="50" /></label>
        }
        <button type="submit">Kademeleri Kaydet</button>
    </form>
</details>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Kod</th><th>Ad</th><th>Grup</th><th class="num">Eşik %</th><th class="num">Çarpan %</th>
        <th>Şube Kapsamı</th><th>Geçerlilik</th><th>Aktif</th><th></th></tr></thead>
    <tbody>
        @if (_list.Count == 0) { <tr><td colspan="9" class="muted">Kayıt yok.</td></tr> }
        @foreach (var k in _list)
        {
            <tr>
                <td>@k.Kod</td><td>@k.Ad</td><td>@(k.AracGrupKod ?? "Tümü")</td>
                <td class="num">@k.EsikYuzde</td><td class="num">@k.CarpanYuzde.ToString("N2")</td>
                @* Bayrak kapalıyken şube metni motorda HİÇ okunmaz — kullanıcı bunu görsün. *@
                <td>@(k.SadeceKendiSubeleri ? $"Yalnız {k.Sube}" : "Tüm şubeler")</td>
                <td>@(k.GecerlilikBas?.LocalDateTime.ToString("dd.MM.yyyy") ?? "—") → @(k.GecerlilikBit?.LocalDateTime.ToString("dd.MM.yyyy") ?? "—")</td>
                <td>@(k.Aktif ? "Evet" : "Hayır")</td>
                <td>
                    <details><summary class="link">Düzenle</summary>
                        <form method="post" action="/doluluk-kurallari/update" class="grid-form"><AntiforgeryToken />
                            <input type="hidden" name="id" value="@k.Id" />
                            <label>Kod<input name="kod" maxlength="32" value="@k.Kod" required /></label>
                            <label>Ad<input name="ad" maxlength="128" value="@k.Ad" required /></label>
                            <label>Araç Grubu
                                <select name="aracGrupKod"><option value="">—</option>
                                    @foreach (var g in _gruplar) { <option value="@g.Kod" selected="@(g.Kod == k.AracGrupKod)">@g.Kod</option> }
                                </select>
                            </label>
                            <label>Eşik %<input name="esikYuzde" type="number" min="1" max="100" value="@k.EsikYuzde" required /></label>
                            <label>Çarpan %<input name="carpanYuzde" type="number" step="0.01" min="0" max="50" value="@k.CarpanYuzde" required /></label>
                            <ComboBox Name="sube" Label="Şube" Value="@k.Sube" Options="_subeOpts" ListId="dl-sube-edit" />
                            <label>Sadece Kendi Şubeleri
                                <select name="sadeceKendiSubeleri">
                                    <option value="false" selected="@(!k.SadeceKendiSubeleri)">Hayır</option>
                                    <option value="true" selected="@k.SadeceKendiSubeleri">Evet</option>
                                </select>
                            </label>
                            <label>Geç. Başlangıç<input name="gecerlilikBas" type="date" value="@k.GecerlilikBas?.ToString("yyyy-MM-dd")" /></label>
                            <label>Geç. Bitiş<input name="gecerlilikBit" type="date" value="@k.GecerlilikBit?.ToString("yyyy-MM-dd")" /></label>
                            <label>Aktif
                                <select name="aktif">
                                    <option value="true" selected="@k.Aktif">Evet</option>
                                    <option value="false" selected="@(!k.Aktif)">Hayır</option>
                                </select>
                            </label>
                            <button type="submit">Kaydet</button>
                        </form>
                        <form method="post" action="/doluluk-kurallari/delete" style="display:inline"
                              data-confirm="'@k.Kod' doluluk kuralı KALICI olarak silinsin mi? Geri alınamaz; fiyat motoru bu çarpanı yeni hesaplarda artık uygulamaz (pasife almak için Aktif=Hayır kaydedin)."><AntiforgeryToken />
                            <input type="hidden" name="id" value="@k.Id" /><button type="submit" class="link danger">Sil</button>
                        </form>
                    </details>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    private IReadOnlyList<RentACar.Domain.Entities.DolulukFiyatKural> _list = [];
    private IReadOnlyList<RentACar.Domain.Entities.VehicleGroup> _gruplar = [];
    private List<string> _subeOpts = [];

    protected override async Task OnInitializedAsync()
    {
        _list = await Kurallar.ListAsync();
        _gruplar = await Gruplar.ListAsync();
        _subeOpts = (await Subeler.ListActiveAsync()).Select(s => s.Ad).ToList();
    }
}
