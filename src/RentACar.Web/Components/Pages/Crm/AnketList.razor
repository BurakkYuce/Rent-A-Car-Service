@page "/anketler"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@using RentACar.Domain.Enums
@inject AnketService Anketler
@inject ReservationSourceService Kaynaklar
@inject CustomerService Cariler
@inject RentalService Kiralar

<PageTitle>Anketler — RentPro</PageTitle>

<div class="page-head"><h1>Müşteri Anketleri</h1></div>
@* Soru METNİ cevapla birlikte saklanır (snapshot): form güncellense de geçmiş anketler hangi
   soruya ne cevap verildiğini olduğu gibi taşır. *@
<p class="muted small">Anket bir kira sözleşmesine bağlanabilir (<strong>Çıkış</strong> veya
    <strong>Dönüş</strong> anı). <strong>Yapılmadı</strong> da bir kayıttır — müşterinin anketi
    reddettiği bilgisi de operasyonel değer taşır. Soru metinleri cevapla birlikte saklanır;
    form ileride değişse bile eski anketler bozulmaz.</p>

@if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }

<form method="get" class="filter-bar">
    <label>Müşteri
        <select name="cariF">
            <option value="">— tümü —</option>
            @foreach (var c in _cariler) { <option value="@c.Id" selected="@(c.Id.ToString() == CariF)">@c.DisplayName</option> }
        </select>
    </label>
    <label>Anket Türü
        <select name="tur">
            <option value="">— tümü —</option>
            @foreach (var t in Enum.GetValues<AnketTuru>()) { <option value="@t" selected="@(t.ToString() == Tur)">@t</option> }
        </select>
    </label>
    <label>Durum
        <select name="durumF">
            <option value="">— tümü —</option>
            @foreach (var d in Enum.GetValues<AnketDurum>()) { <option value="@d" selected="@(d.ToString() == DurumF)">@d</option> }
        </select>
    </label>
    <label>Başlangıç<input name="min" type="date" value="@Min" /></label>
    <label>Bitiş<input name="max" type="date" value="@Max" /></label>
    <label>Çıkış Ofisi
        <select name="ofis">
            <option value="">— tümü —</option>
            @foreach (var o in _ofisOpts) { <option value="@o" selected="@(o == Ofis)">@o</option> }
        </select>
    </label>
    <button type="submit">Filtrele</button>
    @if (FiltreVar) { <a class="link" href="/anketler">Temizle</a> }
</form>

<p class="muted small">@_list.Count anket · @_list.Count(x => x.Durum == AnketDurum.Yapildi) yapıldı ·
    @_list.Count(x => x.Durum == AnketDurum.Yapilmadi) yapılmadı</p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Tarih</th><th>Tür</th><th>Durum</th><th>Müşteri</th><th>Sözleşme</th>
        <th>Çıkış Ofisi</th><th class="num">Puan</th><th class="num">Cevap</th><th>Yorum</th><th>Kaynak</th><th></th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="11" class="muted">@(FiltreVar ? "Filtreye uyan anket yok." : "Kayıt yok.")</td></tr>
        }
        @foreach (var a in _list)
        {
            <tr>
                <td>@a.Tarih.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td>@(a.AnketTuru?.ToString() ?? "—")</td>
                <td>
                    <span class="status-pill @(a.Durum == AnketDurum.Yapildi ? "sp-success" : "sp-warn")">@a.Durum</span>
                </td>
                <td>@(_cariAd.GetValueOrDefault(a.CariId ?? Guid.Empty) ?? "—")</td>
                <td class="mono">@(_sozNo.GetValueOrDefault(a.RentalId ?? Guid.Empty) ?? "—")</td>
                <td>@(a.CikisOfisi ?? "—")</td>
                <td class="num">@a.Puan</td>
                <td class="num">@_cevapSayisi.GetValueOrDefault(a.Id)</td>
                <td>@a.Yorum</td>
                <td>@a.Kaynak</td>
                <td>
                    <a href="@Geri(a.Id)" class="link">Düzenle</a>
                    <form method="post" action="/anketler/delete" class="inline" data-confirm="Silinsin mi?"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@a.Id" /><button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<h2 class="dash-h2">@(_edit is null ? "Yeni Anket" : "Anketi Düzenle")</h2>
<form method="post" action="@(_edit is null ? "/anketler/create" : "/anketler/update")" class="grid-form"><AntiforgeryToken />
    @if (_edit is not null) { <input type="hidden" name="id" value="@_edit.Anket.Id" /> }

    <label>Müşteri
        <select name="cariId">
            <option value="">—</option>
            @foreach (var c in _cariler) { <option value="@c.Id" selected="@(c.Id == _edit?.Anket.CariId)">@c.DisplayName</option> }
        </select>
    </label>
    <label>Sözleşme (ops.)
        <select name="rentalId">
            <option value="">— sözleşmesiz genel anket —</option>
            @foreach (var k in _kiralar) { <option value="@k.Id" selected="@(k.Id == _edit?.Anket.RentalId)">@k.SozlesmeNo — @k.Plaka</option> }
        </select>
    </label>
    <label>Anket Türü
        <select name="anketTuru">
            <option value="">—</option>
            @foreach (var t in Enum.GetValues<AnketTuru>()) { <option value="@t" selected="@(_edit?.Anket.AnketTuru == t)">@t</option> }
        </select>
    </label>
    <label>Durum
        <select name="durum">
            @foreach (var d in Enum.GetValues<AnketDurum>()) { <option value="@d" selected="@(_edit?.Anket.Durum == d)">@d</option> }
        </select>
    </label>
    @* Boş bırakılırsa sözleşmeden kopyalanır; yazılan değer KORUNUR. *@
    <label>Çıkış Ofisi<input name="cikisOfisi" value="@_edit?.Anket.CikisOfisi" maxlength="128" placeholder="(sözleşmeden)" /></label>
    <label>Tarih<input name="tarih" type="date" value="@(_edit?.Anket.Tarih.UtcDateTime.ToString("yyyy-MM-dd"))" /></label>
    <label>Puan (0-10)<input name="puan" type="number" min="0" max="10" value="@(_edit?.Anket.Puan ?? 0)" required /></label>
    <ComboBox Name="kaynak" Label="Kaynak" Value="@_edit?.Anket.Kaynak" Options="_kaynakOpts" Placeholder="Telefon/Web/..." />
    <label class="u-col-full">Yorum<input name="yorum" value="@_edit?.Anket.Yorum" /></label>

    <div class="u-col-full">
        <div class="muted small">Sorular — soru metni boş bırakılan satır kaydedilmez.</div>
        <div class="table-scroll">
            <table class="grid tr-grid">
                <thead><tr><th>#</th><th>Soru</th><th>Cevap</th><th>Açıklama</th></tr></thead>
                <tbody>
                    @for (var i = 1; i <= AnketService.VarsayilanSorular.Length; i++)
                    {
                        var no = i;
                        var mevcut = _edit?.Cevaplar.FirstOrDefault(c => c.SoruNo == no);
                        <tr>
                            <td>@no</td>
                            <td><input name="soru@(no)" value="@(mevcut?.Soru ?? AnketService.VarsayilanSorular[no - 1])" maxlength="512" /></td>
                            <td><input name="cevap@(no)" value="@mevcut?.Cevap" maxlength="1024" /></td>
                            <td><input name="aciklama@(no)" value="@mevcut?.Aciklama" maxlength="1024" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <button type="submit">@(_edit is null ? "Ekle" : "Kaydet")</button>
    @if (_edit is not null) { <a href="@Geri()" class="btn-secondary">İptal</a> }
</form>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "duzenle")] public Guid? Duzenle { get; set; }
    [SupplyParameterFromQuery(Name = "cariF")] public string? CariF { get; set; }
    [SupplyParameterFromQuery(Name = "tur")] public string? Tur { get; set; }
    [SupplyParameterFromQuery(Name = "durumF")] public string? DurumF { get; set; }
    [SupplyParameterFromQuery(Name = "min")] public string? Min { get; set; }
    [SupplyParameterFromQuery(Name = "max")] public string? Max { get; set; }
    [SupplyParameterFromQuery(Name = "ofis")] public string? Ofis { get; set; }

    private IReadOnlyList<Anket> _list = [];
    private AnketDetay? _edit;
    private List<string> _kaynakOpts = [];
    private string[] _ofisOpts = [];
    private IReadOnlyList<Customer> _cariler = [];
    private IReadOnlyList<RentalRow> _kiralar = [];
    private Dictionary<Guid, string> _cariAd = new();
    private Dictionary<Guid, string> _sozNo = new();
    private Dictionary<Guid, int> _cevapSayisi = new();

    private bool FiltreVar => !string.IsNullOrWhiteSpace(CariF) || !string.IsNullOrWhiteSpace(Tur)
        || !string.IsNullOrWhiteSpace(DurumF) || !string.IsNullOrWhiteSpace(Min)
        || !string.IsNullOrWhiteSpace(Max) || !string.IsNullOrWhiteSpace(Ofis);

    private string Geri(Guid? duzenle = null)
    {
        var q = new List<string>();
        void Ekle(string ad, string? v) { if (!string.IsNullOrWhiteSpace(v)) q.Add($"{ad}={Uri.EscapeDataString(v)}"); }
        Ekle("cariF", CariF); Ekle("tur", Tur); Ekle("durumF", DurumF);
        Ekle("min", Min); Ekle("max", Max); Ekle("ofis", Ofis);
        if (duzenle is Guid id) q.Add($"duzenle={id}");
        return "/anketler" + (q.Count > 0 ? "?" + string.Join("&", q) : "");
    }

    protected override async Task OnInitializedAsync()
    {
        _list = await Anketler.SearchAsync(new AnketFilter
        {
            CariId = Guid.TryParse(CariF, out var cid) ? cid : null,
            AnketTuru = Enum.TryParse<AnketTuru>(Tur, out var t) ? t : null,
            Durum = Enum.TryParse<AnketDurum>(DurumF, out var d) ? d : null,
            TarihMin = DateTimeOffset.TryParse(Min, out var a) ? new DateTimeOffset(a.Date, TimeSpan.Zero) : null,
            // Bitiş günü DAHİL.
            TarihMax = DateTimeOffset.TryParse(Max, out var b) ? new DateTimeOffset(b.Date, TimeSpan.Zero).AddDays(1).AddTicks(-1) : null,
            CikisOfisi = Ofis
        });

        _kaynakOpts = (await Kaynaklar.ListActiveAsync()).Select(k => k.Ad).ToList();
        _cariler = await Cariler.ListAsync();
        _kiralar = await Kiralar.SearchAsync(new RentalFilter());
        _cariAd = _cariler.ToDictionary(c => c.Id, c => c.DisplayName);
        _sozNo = _kiralar.ToDictionary(k => k.Id, k => k.SozlesmeNo);

        // Ofis seçenekleri FİLTRESİZ listeden; filtrelenmişten türetilseydi bir seçim sonrası
        // diğer ofisler kaybolur ve filtre kendini kilitlerdi.
        _ofisOpts = (await Anketler.ListAsync()).Select(x => x.CikisOfisi)
            .Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim())
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .OrderBy(x => x, StringComparer.CurrentCulture).ToArray();

        // Cevap sayıları: yalnız listelenen anketler için (tek tek sorgu N+1 olurdu ama liste
        // sayfalanmadığı ve anket sayısı düşük olduğu için kabul edilebilir; tavan filtreyle gelir).
        foreach (var anket in _list)
            _cevapSayisi[anket.Id] = (await Anketler.GetDetayAsync(anket.Id))?.Cevaplar.Count ?? 0;

        if (Duzenle is { } id) _edit = await Anketler.GetDetayAsync(id);
    }
}
