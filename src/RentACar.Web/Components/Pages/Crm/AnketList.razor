@page "/anketler"
@attribute [Authorize(Roles = "Admin,Yonetici,Operator")]
@inject AnketService Anketler
@inject ReservationSourceService Kaynaklar

<PageTitle>Anketler — RentPro</PageTitle>

<div class="page-head"><h1>Müşteri Anketleri</h1><div class="actions"></div></div>
@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<table class="grid tr-grid">
    <thead><tr><th>Tarih</th><th class="num">Puan</th><th>Yorum</th><th>Kaynak</th><th></th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="5" class="muted">Kayıt yok.</td></tr>
        }
        @foreach (var a in _list)
        {
            <tr>
                <td>@a.Tarih.ToString("yyyy-MM-dd")</td>
                <td class="num">@a.Puan</td>
                <td>@a.Yorum</td>
                <td>@a.Kaynak</td>
                <td>
                    <form method="post" action="/anketler/delete" onsubmit="return confirm('Silinsin mi?');"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@a.Id" /><button type="submit" class="btn-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<h2>Yeni Anket</h2>
<form method="post" action="/anketler/create" class="grid-form"><AntiforgeryToken />
    <label>Puan (0-10)<input name="puan" type="number" min="0" max="10" required /></label>
    <label>Yorum<input name="yorum" /></label>
    <ComboBox Name="kaynak" Label="Kaynak" Options="_kaynakOpts" Placeholder="Telefon/Web/..." />
    <label>Cari ID (ops.)<input name="cariId" /></label>
    <label>Tarih<input name="tarih" type="date" /></label>
    <button type="submit">Ekle</button>
</form>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    private IReadOnlyList<RentACar.Domain.Entities.Anket> _list = [];
    private List<string> _kaynakOpts = [];

    protected override async Task OnInitializedAsync()
    {
        _list = await Anketler.ListAsync();
        var kaynaklar = await Kaynaklar.ListActiveAsync();

        // Seç-veya-yaz önerileri: master tanım (Ad) ∪ mevcut kayıtların distinct'i.
        _kaynakOpts = kaynaklar.Select(k => k.Ad)
            .Concat(_list.Select(a => a.Kaynak))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.CurrentCulture)
            .ToList();
    }
}
