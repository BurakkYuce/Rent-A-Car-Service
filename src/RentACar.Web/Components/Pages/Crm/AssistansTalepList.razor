@page "/assistans"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@inject AssistanceRequestService Talepler
@inject RentalService Kiralar

<PageTitle>Assistans Talepleri — RentPro</PageTitle>

<div class="page-head"><h1>Assistans (Yol Yardım) Talepleri</h1></div>
@* Şikayet dikeyi plakayı sözleşmeden CANLI çözer; burada TERSİ yapılır ve bilinçlidir: assistans
   kaydı bir OLAY TUTANAĞIDIR — araç değişse ya da müşteri telefonunu güncellese de "o gece hangi
   araç, hangi numara arandı" sabit kalmalıdır. *@
<p class="muted small">Kiradaki araçtan gelen yol yardım çağrıları. Sözleşme seçilirse
    <strong>plaka / ad / telefon sözleşmeden kopyalanır</strong> — kopya olduğu için sonradan araç
    veya müşteri bilgisi değişse bile kayıt olduğu gibi kalır. Elle yazılan değer sözleşmeden
    gelen değeri <strong>ezmez</strong> (çağrıyı yapan kişi müşteri olmayabilir).
    Sözleşmesiz çağrı da kaydedilebilir.</p>

@if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }

<form method="get" class="filter-bar">
    <label>Plaka<input name="plakaF" value="@PlakaF" placeholder="34 AA (boşluk serbest)" /></label>
    <label>Başlangıç<input name="min" type="date" value="@Min" /></label>
    <label>Bitiş<input name="max" type="date" value="@Max" /></label>
    <label>Ara<input name="ara" value="@Ara" placeholder="mesaj / sebep / ad / telefon" /></label>
    <label>Durum
        <select name="durum">
            <option value="">— tümü —</option>
            <option value="acik" selected="@(Durum == "acik")">Açık</option>
            <option value="kapali" selected="@(Durum == "kapali")">Kapalı</option>
            <option value="cekici" selected="@(Durum == "cekici")">Çekici gerekenler</option>
            <option value="lastik" selected="@(Durum == "lastik")">Yedek lastik</option>
        </select>
    </label>
    <button type="submit">Filtrele</button>
    @if (FiltreVar) { <a class="link" href="/assistans">Temizle</a> }
</form>

<p class="muted small">@_list.Count talep · @_list.Count(x => !x.Kapandi) açık ·
    @_list.Count(x => !x.AracHareketMi) araç hareket edemiyor</p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Zaman</th><th>Plaka</th><th>Ad Soyad</th><th>Cep Tel</th><th>Mesaj</th>
        <th>Sebep</th><th>Yedek Lastik</th><th>Araç Hareket</th><th>Durum</th><th>Çözüm</th><th></th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="11" class="muted">@(FiltreVar ? "Filtreye uyan talep yok." : "Kayıt yok.")</td></tr>
        }
        @foreach (var t in _list)
        {
            <tr>
                <td>@t.Zaman.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                <td class="mono">@(t.Plaka ?? "—")</td>
                <td>@(t.AdSoyad ?? "—")</td>
                <td>@(t.CepTel ?? "—")</td>
                <td>@t.Mesaj</td>
                <td>@(t.Sebep ?? "—")</td>
                <td>@(t.YedekLastikMi ? "Evet" : "—")</td>
                <td>
                    @* Hareket edemiyor = çekici gerekir; operatörün ilk baktığı bilgi bu. *@
                    <span class="status-pill @(t.AracHareketMi ? "sp-success" : "sp-warn")">
                        @(t.AracHareketMi ? "Edebiliyor" : "Edemiyor")
                    </span>
                </td>
                <td>
                    <span class="status-pill @(t.Kapandi ? "sp-success" : "sp-warn")">@(t.Kapandi ? "Kapalı" : "Açık")</span>
                </td>
                <td>@(t.Cozum ?? "—")</td>
                <td><a href="@Back(t.Id)" class="link">Düzenle</a></td>
            </tr>
        }
    </tbody>
</table>
</div>

<h2 class="dash-h2">@(_edit is null ? "Yeni Talep" : "Talebi Düzenle")</h2>
<form method="post" action="@(_edit is null ? "/assistans/create" : "/assistans/update")" class="grid-form"><AntiforgeryToken />
    @if (_edit is not null) { <input type="hidden" name="id" value="@_edit.Id" /> }
    @Gizli

    <label>Sözleşme (ops.)
        <select name="rentalId">
            <option value="">— sözleşmesiz çağrı —</option>
            @foreach (var k in _rentals)
            {
                <option value="@k.Id" selected="@(k.Id == _edit?.RentalId)">@k.SozlesmeNo — @k.Plaka — @k.MusteriAd</option>
            }
        </select>
    </label>
    <label>Plaka<input name="plaka" value="@_edit?.Plaka" maxlength="16" placeholder="(sözleşmeden)" /></label>
    <label>Ad Soyad<input name="adSoyad" value="@_edit?.AdSoyad" maxlength="256" placeholder="(sözleşmeden)" /></label>
    <label>Cep Tel<input name="cepTel" value="@_edit?.CepTel" maxlength="32" placeholder="(sözleşmeden)" /></label>
    <label>Zaman<input name="zaman" type="datetime-local"
        value="@(_edit?.Zaman.UtcDateTime.ToString("yyyy-MM-ddTHH:mm"))" /></label>
    <label>Sebep<input name="sebep" value="@_edit?.Sebep" maxlength="512" /></label>
    <label class="kf-inline"><input type="checkbox" name="yedekLastikMi" value="true" checked="@(_edit?.YedekLastikMi == true)" /> Yedek lastik gerekiyor</label>
    <label class="kf-inline"><input type="checkbox" name="aracHareketMi" value="true" checked="@(_edit?.AracHareketMi == true)" /> Araç hareket edebiliyor</label>
    <label class="kf-inline"><input type="checkbox" name="kapandi" value="true" checked="@(_edit?.Kapandi == true)" /> Kapandı</label>
    <label class="u-col-full">Mesaj<input name="mesaj" value="@_edit?.Mesaj" maxlength="2048" required /></label>
    <label class="u-col-full">Çözüm<input name="cozum" value="@_edit?.Cozum" maxlength="1024" /></label>
    <button type="submit">@(_edit is null ? "Ekle" : "Kaydet")</button>
    @if (_edit is not null) { <a href="@Back()" class="btn-secondary">İptal</a> }
</form>

@if (_edit is not null)
{
    <form method="post" action="/assistans/delete" data-confirm="Talep silinsin mi?"><AntiforgeryToken />
        <input type="hidden" name="id" value="@_edit.Id" />@Gizli
        <button type="submit" class="link danger">Sil</button>
    </form>
}

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "duzenle")] public Guid? Duzenle { get; set; }
    [SupplyParameterFromQuery(Name = "plakaF")] public string? PlakaF { get; set; }
    [SupplyParameterFromQuery(Name = "min")] public string? Min { get; set; }
    [SupplyParameterFromQuery(Name = "max")] public string? Max { get; set; }
    [SupplyParameterFromQuery(Name = "ara")] public string? Ara { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }

    private IReadOnlyList<AssistansTalep> _list = [];
    private IReadOnlyList<RentalRow> _rentals = [];
    private AssistansTalep? _edit;

    private bool FiltreVar => !string.IsNullOrWhiteSpace(PlakaF) || !string.IsNullOrWhiteSpace(Min)
        || !string.IsNullOrWhiteSpace(Max) || !string.IsNullOrWhiteSpace(Ara) || !string.IsNullOrWhiteSpace(Durum);

    private RenderFragment Gizli => @<text>
        <input type="hidden" name="plakaF" value="@PlakaF" />
        <input type="hidden" name="min" value="@Min" />
        <input type="hidden" name="max" value="@Max" />
        <input type="hidden" name="ara" value="@Ara" />
        <input type="hidden" name="durum" value="@Durum" />
    </text>;

    private string Back(Guid? edit = null)
    {
        var q = new List<string>();
        void Add(string name, string? v) { if (!string.IsNullOrWhiteSpace(v)) q.Add($"{name}={Uri.EscapeDataString(v)}"); }
        Add("plakaF", PlakaF); Add("min", Min); Add("max", Max); Add("ara", Ara); Add("durum", Durum);
        if (edit is Guid id) q.Add($"duzenle={id}");
        return "/assistans" + (q.Count > 0 ? "?" + string.Join("&", q) : "");
    }

    protected override async Task OnInitializedAsync()
    {
        var f = new AssistansFilter
        {
            Plaka = PlakaF,
            TarihMin = DateTimeOffset.TryParse(Min, out var a) ? new DateTimeOffset(a.Date, TimeSpan.Zero) : null,
            // Bitiş günü DAHİL: kullanıcı "8 Ağustos" yazınca o günün 23:59'una kadar beklenir.
            TarihMax = DateTimeOffset.TryParse(Max, out var b) ? new DateTimeOffset(b.Date, TimeSpan.Zero).AddDays(1).AddTicks(-1) : null,
            Ara = Ara,
            Kapandi = Durum switch { "acik" => false, "kapali" => true, _ => null },
            HareketEdemiyor = Durum == "cekici" ? true : null,
            YedekLastikMi = Durum == "lastik" ? true : null
        };
        _list = await Talepler.SearchAsync(f);
        _rentals = await Kiralar.SearchAsync(new RentalFilter());
        if (Duzenle is { } id) _edit = await Talepler.GetAsync(id);
    }
}
