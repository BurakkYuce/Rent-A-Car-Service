@page "/sikayetler"
@attribute [Authorize(Policy = "izin:OperationsWrite")]
@inject SikayetService Sikayetler
@inject CustomerService Cariler
@inject PersonelService Personeller
@inject RentalService Kiralar
@inject LocationService Ofisler
@using RentACar.Domain.Enums

<PageTitle>Şikayetler — RentPro</PageTitle>

<div class="page-head"><h1>Müşteri Şikayetleri</h1></div>
<p class="muted small">Şikayet bir kira sözleşmesine bağlanabilir; bağlandığında plaka ve sözleşme no
    <strong>sözleşmeden okunur</strong> (kopyalanmaz — araç değişirse liste doğru kalır). Sözleşmesiz
    genel şikayet de girilebilir.</p>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<form method="get" class="filter-bar">
    <label>Müşteri
        <select name="cariId">
            <option value="">— tümü —</option>
            @foreach (var c in _cariler) { <option value="@c.Id" selected="@(c.Id.ToString() == CariId)">@c.DisplayName</option> }
        </select>
    </label>
    <label>Çıkış Ofisi
        <select name="ofis">
            <option value="">— tümü —</option>
            @foreach (var o in _ofisler) { <option value="@o" selected="@(o == Ofis)">@o</option> }
        </select>
    </label>
    <label>Şikayet Yeri
        <select name="yer">
            <option value="">— tümü —</option>
            @foreach (var y in Enum.GetValues<SikayetYeri>()) { <option value="@y" selected="@(y.ToString() == Yer)">@y</option> }
        </select>
    </label>
    <label>Kanal
        <select name="kanal">
            <option value="">— tümü —</option>
            @foreach (var k in _kanallar) { <option value="@k" selected="@(k == Kanal)">@k</option> }
        </select>
    </label>
    <label>Durum
        <select name="durum">
            <option value="">— tümü —</option>
            @foreach (var d in Enum.GetValues<SikayetDurum>()) { <option value="@d" selected="@(d.ToString() == Durum)">@d</option> }
        </select>
    </label>
    <label>Ara<input name="ara" value="@Ara" placeholder="konu / detay / sözleşme / plaka" /></label>
    <button type="submit">Filtrele</button>
    @if (FiltreVar) { <a class="link" href="/sikayetler">Temizle</a> }
</form>

<p class="muted small">@_rows.Count şikayet · @_rows.Count(x => x.Sikayet.Durum == SikayetDurum.Acik) açık</p>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead>
        <tr><th>Tarih</th><th>Müşteri</th><th>Cep Tel</th><th>Sözleşme No</th><th>Plaka</th>
            <th>Çıkış Ofisi</th><th>Yer</th><th>Kanal</th><th class="num">Puan</th>
            <th>Teslim Alan</th><th>Teslim Eden</th><th>Konu</th><th>Durum</th><th>Çözüm</th><th></th></tr>
    </thead>
    <tbody>
        @if (_rows.Count == 0)
        {
            <tr><td colspan="15" class="muted">@(FiltreVar ? "Filtreye uyan şikayet yok." : "Kayıt yok.")</td></tr>
        }
        @foreach (var r in _rows)
        {
            var s = r.Sikayet;
            <tr>
                <td>@s.Tarih.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td>@(r.MusteriAd ?? "—")</td>
                <td>@(r.MusteriTel ?? "—")</td>
                <td class="mono">@(r.SozlesmeNo ?? "—")</td>
                @* Plaka sözleşmeden ÇÖZÜLÜR — şikayette saklanmaz. *@
                <td class="mono">@(r.Plaka ?? "—")</td>
                <td>@(s.CikisOfisi ?? "—")</td>
                <td>@(s.SikayetYeri?.ToString() ?? "—")</td>
                <td>@(s.SikayetKanali ?? "—")</td>
                <td class="num">@(s.Puan?.ToString() ?? "—")</td>
                <td>@(r.TeslimAlanAd ?? "—")</td>
                <td>@(r.TeslimEdenAd ?? "—")</td>
                <td>@s.Konu</td>
                <td>
                    <span class="status-pill @(s.Durum == SikayetDurum.Acik ? "sp-warn" : "sp-success")">@s.Durum</span>
                </td>
                <td>@(s.Cozum ?? "—")</td>
                <td><a href="/sikayetler?duzenle=@s.Id" class="link">Düzenle</a></td>
            </tr>
        }
    </tbody>
</table>
</div>

<h2 class="dash-h2">@(_edit is null ? "Yeni Şikayet" : "Şikayeti Düzenle")</h2>
<form method="post" action="@(_edit is null ? "/sikayetler/create" : "/sikayetler/update")" class="grid-form"><AntiforgeryToken />
    @if (_edit is not null)
    {
        <input type="hidden" name="id" value="@_edit.Id" />
    }
    <label>Müşteri
        <select name="cariId">
            <option value="">—</option>
            @foreach (var c in _cariler) { <option value="@c.Id" selected="@(c.Id == _edit?.CariId)">@c.DisplayName</option> }
        </select>
    </label>
    <label>Sözleşme (opsiyonel)
        <select name="rentalId">
            <option value="">— sözleşmesiz genel şikayet —</option>
            @foreach (var k in _kiralar) { <option value="@k.Id" selected="@(k.Id == _edit?.RentalId)">@k.SozlesmeNo — @k.Plaka</option> }
        </select>
    </label>
    <label>Şikayet Yeri
        <select name="sikayetYeri">
            <option value="">—</option>
            @foreach (var y in Enum.GetValues<SikayetYeri>()) { <option value="@y" selected="@(_edit?.SikayetYeri == y)">@y</option> }
        </select>
    </label>
    <label>Kanal<input name="sikayetKanali" list="dl-sikayet-kanal" value="@_edit?.SikayetKanali" maxlength="64" />
        <datalist id="dl-sikayet-kanal">
            <option value="Telefon"></option><option value="Web"></option><option value="Yüz Yüze"></option><option value="E-posta"></option>
        </datalist>
    </label>
    <label>Çıkış Ofisi<input name="cikisOfisi" list="dl-sikayet-ofis" value="@_edit?.CikisOfisi" maxlength="128" />
        <datalist id="dl-sikayet-ofis">
            @foreach (var o in _ofisler) { <option value="@o"></option> }
        </datalist>
    </label>
    @* Bu iki alan ŞİKAYETİN KENDİ alanıdır; sözleşmedeki personelden kopya DEĞİLDİR.
       Sözleşmeyle çelişebilir ve bu bilinçlidir (şikayeti alan/işleyen kişi farklı olabilir). *@
    <label>Teslim Alan Personel
        <select name="teslimAlanPersonelId">
            <option value="">—</option>
            @foreach (var p in _personeller) { <option value="@p.Id" selected="@(p.Id == _edit?.TeslimAlanPersonelId)">@p.Ad @p.Soyad</option> }
        </select>
    </label>
    <label>Teslim Eden Personel
        <select name="teslimEdenPersonelId">
            <option value="">—</option>
            @foreach (var p in _personeller) { <option value="@p.Id" selected="@(p.Id == _edit?.TeslimEdenPersonelId)">@p.Ad @p.Soyad</option> }
        </select>
    </label>
    <label>Puan (1-5)<input name="puan" type="number" min="1" max="5" value="@_edit?.Puan" /></label>
    <label>Tarih<input name="tarih" type="date" value="@(_edit?.Tarih.LocalDateTime.ToString("yyyy-MM-dd"))" /></label>
    <label class="u-col-full">Konu<input name="konu" value="@_edit?.Konu" required /></label>
    <label class="u-col-full">Detay<input name="detay" value="@_edit?.Detay" /></label>
    <label>Durum
        <select name="durum">
            @foreach (var d in Enum.GetValues<SikayetDurum>()) { <option value="@d" selected="@(_edit?.Durum == d)">@d</option> }
        </select>
    </label>
    <label class="u-col-full">Çözüm<input name="cozum" value="@_edit?.Cozum" /></label>
    <button type="submit">@(_edit is null ? "Ekle" : "Kaydet")</button>
    @if (_edit is not null)
    {
        <a href="/sikayetler" class="btn-secondary">İptal</a>
    }
</form>

@if (_edit is not null)
{
    <form method="post" action="/sikayetler/delete" data-confirm="Bu şikâyet kaydı kalıcı olarak silinsin mi? Kayıt geri getirilemez."><AntiforgeryToken />
        <input type="hidden" name="id" value="@_edit.Id" /><button type="submit" class="link danger">Sil</button>
    </form>
}

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "duzenle")] public Guid? Duzenle { get; set; }
    [SupplyParameterFromQuery(Name = "cariId")] public string? CariId { get; set; }
    [SupplyParameterFromQuery(Name = "ofis")] public string? Ofis { get; set; }
    [SupplyParameterFromQuery(Name = "yer")] public string? Yer { get; set; }
    [SupplyParameterFromQuery(Name = "kanal")] public string? Kanal { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }
    [SupplyParameterFromQuery(Name = "ara")] public string? Ara { get; set; }

    private IReadOnlyList<SikayetSatirDto> _rows = [];
    private RentACar.Domain.Entities.Sikayet? _edit;
    private IReadOnlyList<Customer> _cariler = [];
    private IReadOnlyList<PersonelSecim> _personeller = [];
    private IReadOnlyList<RentalRow> _kiralar = [];
    private string[] _ofisler = [];
    private string[] _kanallar = [];

    private bool FiltreVar => !string.IsNullOrWhiteSpace(CariId) || !string.IsNullOrWhiteSpace(Ofis)
        || !string.IsNullOrWhiteSpace(Yer) || !string.IsNullOrWhiteSpace(Kanal)
        || !string.IsNullOrWhiteSpace(Durum) || !string.IsNullOrWhiteSpace(Ara);

    protected override async Task OnInitializedAsync()
    {
        _cariler = await Cariler.ListAsync();
        // PII'sız uç: ListAsync ManageUsers ister ve Operatör rolünde patlar (kira mega-form dersi).
        _personeller = await Personeller.ListForSelectAsync();
        _kiralar = await Kiralar.SearchAsync(new RentalFilter());
        _ofisler = (await Ofisler.ListActiveAsync()).Select(o => o.Ad).OrderBy(a => a).ToArray();

        _rows = await Sikayetler.SearchAsync(new SikayetFilter
        {
            CariId = Guid.TryParse(CariId, out var cid) ? cid : null,
            Ofis = Ofis,
            Yer = Enum.TryParse<SikayetYeri>(Yer, out var y) ? y : null,
            Kanal = Kanal,
            Durum = Enum.TryParse<SikayetDurum>(Durum, out var d) ? d : null,
            Ara = Ara
        });

        // Kanal filtresi seçenekleri MEVCUT kayıtlardan (master tablo yok) — filtrelenmiş listeden
        // türetilseydi bir seçimden sonra diğer kanallar kaybolurdu.
        _kanallar = (await Sikayetler.SearchAsync()).Select(x => x.Sikayet.SikayetKanali)
            .Where(k => !string.IsNullOrWhiteSpace(k)).Select(k => k!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(k => k).ToArray();

        if (Duzenle is { } id) _edit = await Sikayetler.GetAsync(id);
    }
}
