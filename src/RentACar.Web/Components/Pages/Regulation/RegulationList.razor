@page "/regulasyon"
@attribute [Authorize]
@inject RegulationService Reg
@inject VehicleService Vehicles
@inject InsuranceCompanyService SigortaSirketleri

<PageTitle>Sigorta / MTV / Muayene — RentPro</PageTitle>

<div class="page-head"><h1>Sigorta / MTV / Muayene</h1><div class="actions"><a href="/vade">Vade Uyarıları →</a></div></div>
@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<h2>Sigorta</h2>
<form method="post" action="/regulasyon/sigorta" class="grid-form"><AntiforgeryToken />
    <label>Araç @VehicleSelect("vehicleId")</label>
    <label>Tip<select name="tip">@foreach (var t in Enum.GetValues<InsuranceType>()){<option value="@t">@t</option>}</select></label>
    <label>Başlangıç<input name="baslangic" type="date" required /></label>
    <label>Bitiş<input name="bitis" type="date" required /></label>
    <label>Prim<input name="prim" type="number" step="0.01" value="0" /></label>
    <label>Döviz<select name="doviz">@foreach (var d in Dovizler){<option value="@d">@d</option>}</select></label>
    <label>Poliçe No<input name="policeNo" /></label>
    <ComboBox Name="firma" Label="Firma" Options="_firmaOpts" />
    @* FAZ-15 sigorta değer tabanı — BİLGİ alanları; hiçbir hesaba/deftere girmez. *@
    <label>Araç Değeri<input name="aracDegeri" type="number" step="0.01" min="0" title="Kasko araç değeri (bilgi)" /></label>
    <label>İMM Değeri<input name="immDegeri" type="number" step="0.01" min="0" title="İhtiyari Mali Mesuliyet teminatı (bilgi)" /></label>
    <label>Aksesuar Değeri<input name="aksesuarDegeri" type="number" step="0.01" min="0" title="Aksesuar teminatı (bilgi)" /></label>
    <button type="submit">Ekle</button>
</form>
<p class="muted small">Araç/İMM/Aksesuar değeri ve Kalan yalnızca <strong>bilgi</strong> alanlarıdır: muhasebe defterine
yazılmaz, gelir-gider ve cari bakiyeyi etkilemez. Kalan, poliçe ödendiğinde otomatik 0'a düşer.</p>
<div class="table-scroll">
<table class="grid tr-grid"><thead><tr><th>Araç</th><th>Tip</th><th>Bitiş</th><th class="num">Prim</th><th>Döviz</th><th>Firma</th><th class="num">Araç Değ.</th><th class="num">İMM</th><th class="num">Aksesuar</th><th class="num">Kalan</th><th>Ödendi</th><th></th></tr></thead><tbody>
@foreach (var s in _ins)
{
    <tr><td>@Plaka(s.VehicleId)</td><td>@s.Tip</td><td>@s.Bitis.LocalDateTime.ToString("dd.MM.yyyy")</td><td class="num">@s.Prim.ToString("N2")</td><td>@s.Currency</td><td>@s.Firma</td>
        <td class="num">@(s.AracDegeri?.ToString("N2") ?? "—")</td>
        <td class="num">@(s.ImmDegeri?.ToString("N2") ?? "—")</td>
        <td class="num">@(s.AksesuarDegeri?.ToString("N2") ?? "—")</td>
        <td class="num">@s.Kalan.ToString("N2")</td>
        <td>@(s.Odendi ? "Evet" : "Hayır")</td>
        <td>
            @if (!s.Odendi)
            {
                <form method="post" action="/regulasyon-odeme/sigorta" style="display:inline"><AntiforgeryToken />
                    <input type="hidden" name="id" value="@s.Id" />
                    <select name="hesap"><option>Kasa</option><option>Banka</option></select>
                    <HesapSecici Etiket="" />
                    <input name="zeyil" type="number" step="0.01" min="0" value="0" style="width:6em" title="Zeyil ek prim" />
                    @if (s.Currency != "TRY")
                    {
                        @* FX poliçe: kur ZORUNLU + boş — operatör 1:1 bırakıp primi sessizce düşük kaydetmesin. *@
                        <input name="kur" type="number" step="0.0001" min="0.0001" placeholder="boş = otomatik" style="width:7em" title="@(s.Currency) → TRY kuru — boş bırakılırsa sabit kur/TCMB'den otomatik çözülür (bulunamazsa işlem reddedilir)" />
                    }
                    <button type="submit">Öde</button>
                </form>
            }
        </td>
    </tr>
}
</tbody></table>
</div>

<h3 id="zeyil">Zeyil (Poliçe Ekleri)</h3>
<p class="muted small">Zeyil = poliçe eki (zam/tenzil/değişiklik). Kayıtlar <strong>bilgi ve geçmiş</strong> amaçlıdır:
Değer/Brüt/Net/Fon-Vergi tutarları <strong>muhasebe defterine yazılmaz</strong>, gelir-gider ve cari bakiyeyi
değiştirmez ve poliçenin Kalan bakiyesine eklenmez. Zeyil primi tahsil/ödeme yapıldığında normal
Kasa/Banka akışı kullanılır — iki yolu birden açmak çift-sayım üretirdi.</p>
@if (_ins.Count == 0)
{
    <p class="muted">Önce bir sigorta poliçesi ekleyin; zeyil bir poliçeye bağlanır.</p>
}
else
{
    <form method="post" action="/regulasyon/zeyil" class="grid-form"><AntiforgeryToken />
        <label>Poliçe<select name="policyId" required>
            <option value="">— seç —</option>
            @foreach (var p in _ins)
            {
                <option value="@p.Id">@PoliceEtiket(p)</option>
            }
        </select></label>
        <label>Zeyil No<input name="zeyilNo" maxlength="32" required /></label>
        <label>Tarih<input name="tarih" type="date" required /></label>
        <label>Tanzim<input name="tanzim" type="date" /></label>
        <label>Değer<input name="deger" type="number" step="0.01" min="0" title="Zeyille değişen sigorta değeri (bilgi)" /></label>
        @* Brüt/Net/Fon-Vergi tenzil (iade) zeylinde NEGATİF olabilir → min yok. *@
        <label>Brüt<input name="brut" type="number" step="0.01" title="Brüt prim farkı — tenzil zeylinde negatif (bilgi)" /></label>
        <label>Net<input name="net" type="number" step="0.01" title="Net prim farkı (bilgi)" /></label>
        <label>Fon+Vergi<input name="fonVergi" type="number" step="0.01" title="Fon ve vergi payı (bilgi)" /></label>
        <ComboBox Name="tipi" Label="Tipi" Options="_zeyilTipiOpts" Extra="@(new Dictionary<string, object> { ["maxlength"] = "64" })" />
        <label class="u-col-full">Neden<input name="neden" maxlength="512" /></label>
        <button type="submit">Zeyil Ekle</button>
    </form>
}
<div class="table-scroll">
<table class="grid tr-grid"><thead><tr><th>Poliçe</th><th>Zeyil No</th><th>Tarih</th><th>Tanzim</th><th class="num">Değer</th><th class="num">Brüt</th><th class="num">Net</th><th class="num">Fon-Vergi</th><th>Tipi</th><th>Neden</th><th></th></tr></thead><tbody>
@if (_zeyil.Count == 0)
{
    <tr><td colspan="11" class="muted">Zeyil kaydı yok.</td></tr>
}
@foreach (var z in _zeyil)
{
    <tr>
        <td>@PoliceEtiket(z.PolicyId)</td>
        <td>@z.ZeyilNo</td>
        <td>@z.Tarih.LocalDateTime.ToString("dd.MM.yyyy")</td>
        <td>@(z.Tanzim?.LocalDateTime.ToString("dd.MM.yyyy") ?? "—")</td>
        <td class="num">@z.Deger.ToString("N2")</td>
        <td class="num">@z.Brut.ToString("N2")</td>
        <td class="num">@z.Net.ToString("N2")</td>
        <td class="num">@z.FonVergi.ToString("N2")</td>
        <td>@(z.Tipi ?? "—")</td>
        <td>@(z.Neden ?? "—")</td>
        <td>
            @* Zeyil mali belge değil (defter kaydı üretmez) → doğrudan silinebilir, ters kayıt gerekmez. *@
            <form method="post" action="/regulasyon/zeyil/sil" class="inline-form"><AntiforgeryToken />
                <input type="hidden" name="id" value="@z.Id" />
                <button type="submit" class="danger">Sil</button>
            </form>
        </td>
    </tr>
}
</tbody></table>
</div>

<h2>MTV</h2>
<form method="post" action="/regulasyon/mtv" class="grid-form"><AntiforgeryToken />
    <label>Araç @VehicleSelect("vehicleId")</label>
    <label>Dönem<input name="donem" placeholder="2026-1" required /></label>
    <label>Tutar<input name="tutar" type="number" step="0.01" value="0" /></label>
    <label>Vade<input name="vade" type="date" required /></label>
    <label class="u-col-full">Açıklama<input name="aciklama" maxlength="512" /></label>
    <button type="submit">Ekle</button>
</form>
<div class="table-scroll">
<table class="grid tr-grid"><thead><tr><th>Araç</th><th>Dönem</th><th class="num">Tutar</th><th class="num">Kalan</th><th>Vade</th><th>Ödendi</th><th>Açıklama</th><th>Ödeme</th></tr></thead><tbody>
@foreach (var m in _mtv)
{
    <tr><td>@Plaka(m.VehicleId)</td><td>@m.Donem</td><td class="num">@m.Tutar.ToString("N2")</td>
        <td class="num">@m.Kalan.ToString("N2")</td>
        <td>@m.Vade.LocalDateTime.ToString("dd.MM.yyyy")</td><td>@(m.Odendi ? "Evet" : "Hayır")</td>
        <td>@(m.Aciklama ?? "—")</td>
        <td>
            @if (!m.Odendi)
            {
                @* Kısmi ödeme: Tutar BOŞ bırakılırsa kalanın tamamı ödenir. islemAnahtari her
                   render'da yeni GUID — çift-submit kısmi unique index'e takılır. *@
                <form method="post" action="/regulasyon-odeme/mtv" class="inline-form"><AntiforgeryToken />
                    <input type="hidden" name="id" value="@m.Id" />
                    <input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />
                    <select name="hesap"><option>Kasa</option><option>Banka</option></select>
                    <HesapSecici Etiket="" />
                    <input name="tutar" type="number" step="0.01" min="0.01" max="@m.Kalan.ToString(System.Globalization.CultureInfo.InvariantCulture)" placeholder="tümü" title="Kısmi tutar (boş = kalanın tamamı)" />
                    <input name="odemeTarihi" type="date" title="Ödeme tarihi (boş = bugün)" />
                    <input name="evrakNo" placeholder="Evrak No" maxlength="64" />
                    <input name="islemYapan" placeholder="İşlem Yapan" maxlength="128" />
                    <input name="kasaKodu" placeholder="Kasa Kodu" maxlength="64" />
                    <input name="hesapNo" placeholder="Hesap/IBAN" maxlength="64" />
                    <input name="odemeAciklama" placeholder="Açıklama" maxlength="512" />
                    <button type="submit">Öde</button>
                </form>
            }
            @if (_mtvOdeme.TryGetValue(m.Id, out var gecmis))
            {
                <div class="muted small">
                    @foreach (var o in gecmis)
                    {
                        <div>#@o.Sira · @o.Tarih.LocalDateTime.ToString("dd.MM.yyyy") · @o.Tutar.ToString("N2") · kalan @o.KalanSonrasi.ToString("N2")@(string.IsNullOrWhiteSpace(o.EvrakNo) ? "" : " · " + o.EvrakNo)</div>
                    }
                </div>
            }
        </td>
    </tr>
}
</tbody></table>
</div>

<h2>Muayene</h2>
<form method="post" action="/regulasyon/muayene" class="grid-form"><AntiforgeryToken />
    <label>Araç @VehicleSelect("vehicleId")</label>
    <label>Muayene Tarihi<input name="muayeneTarihi" type="date" required /></label>
    <label>Bitiş<input name="bitis" type="date" required /></label>
    <label>Ücret<input name="ucret" type="number" step="0.01" value="0" /></label>
    <label>İşlem KM<input name="islemKm" type="number" min="0" step="1" /></label>
    <label class="u-col-full">Açıklama<input name="aciklama" maxlength="512" /></label>
    <button type="submit">Ekle</button>
</form>
<div class="table-scroll">
<table class="grid tr-grid"><thead><tr><th>Araç</th><th>Muayene</th><th>Bitiş</th><th class="num">Ücret</th><th class="num">Ceza</th><th class="num">Kalan</th><th class="num">İşlem KM</th><th>Ödendi</th><th>Açıklama</th><th>Ödeme</th></tr></thead><tbody>
@foreach (var m in _insp)
{
    <tr><td>@Plaka(m.VehicleId)</td><td>@m.MuayeneTarihi.LocalDateTime.ToString("dd.MM.yyyy")</td><td>@m.Bitis.LocalDateTime.ToString("dd.MM.yyyy")</td>
        <td class="num">@m.Ucret.ToString("N2")</td>
        <td class="num">@m.Ceza.ToString("N2")</td>
        <td class="num">@m.Kalan.ToString("N2")</td>
        <td class="num">@(m.IslemKm?.ToString("N0") ?? "—")</td>
        <td>@(m.Odendi ? "Evet" : "Hayır")</td>
        <td>@(m.Aciklama ?? "—")</td>
        <td>
            @if (!m.Odendi)
            {
                @* Ceza BORCU ARTIRIR: girilen ceza kalana eklenir, ödenen tutar düşülür. *@
                <form method="post" action="/regulasyon-odeme/muayene" class="inline-form"><AntiforgeryToken />
                    <input type="hidden" name="id" value="@m.Id" />
                    <input type="hidden" name="islemAnahtari" value="@Guid.NewGuid()" />
                    <select name="hesap"><option>Kasa</option><option>Banka</option></select>
                    <HesapSecici Etiket="" />
                    <input name="ceza" type="number" step="0.01" min="0" value="0" title="Ceza (borcu artırır)" />
                    <input name="tutar" type="number" step="0.01" min="0.01" placeholder="tümü" title="Kısmi tutar (boş = kalan + ceza)" />
                    <input name="odemeTarihi" type="date" title="Ödeme tarihi (boş = bugün)" />
                    <input name="evrakNo" placeholder="Evrak No" maxlength="64" />
                    <input name="islemYapan" placeholder="İşlem Yapan" maxlength="128" />
                    <input name="kasaKodu" placeholder="Kasa Kodu" maxlength="64" />
                    <input name="hesapNo" placeholder="Hesap/IBAN" maxlength="64" />
                    <input name="odemeAciklama" placeholder="Açıklama" maxlength="512" />
                    <button type="submit">Öde</button>
                </form>
            }
            @if (_muayeneOdeme.TryGetValue(m.Id, out var gecmis))
            {
                <div class="muted small">
                    @foreach (var o in gecmis)
                    {
                        <div>#@o.Sira · @o.Tarih.LocalDateTime.ToString("dd.MM.yyyy") · @o.Tutar.ToString("N2")@(o.Ceza > 0 ? $" (+ceza {o.Ceza:N2})" : "") · kalan @o.KalanSonrasi.ToString("N2")</div>
                    }
                </div>
            }
        </td>
    </tr>
}
</tbody></table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }

    // Sigorta poliçesi para birimleri (ithal araçta EUR/USD; yerelde TRY). Servis normalize eder.
    private static readonly string[] Dovizler = ["TRY", "EUR", "USD", "GBP"];

    private IReadOnlyList<InsurancePolicy> _ins = [];
    private IReadOnlyList<InsurancePolicyZeyil> _zeyil = [];
    private Dictionary<Guid, InsurancePolicy> _insMap = new();
    private List<string> _zeyilTipiOpts = [];
    private IReadOnlyList<MtvRecord> _mtv = [];
    private IReadOnlyList<InspectionRecord> _insp = [];
    private Dictionary<Guid, IReadOnlyList<MtvOdeme>> _mtvOdeme = new();
    private Dictionary<Guid, IReadOnlyList<MuayeneOdeme>> _muayeneOdeme = new();
    private IReadOnlyList<Vehicle> _vehicles = [];
    private Dictionary<Guid, string> _vehMap = new();
    private List<string> _firmaOpts = [];

    protected override async Task OnInitializedAsync()
    {
        _ins = await Reg.ListInsuranceAsync();
        _insMap = _ins.ToDictionary(p => p.Id);
        // FAZ-15: zeyiller TEK sorguda (poliçe başına sorgu atmamak için — MTV ödeme geçmişi deseni).
        _zeyil = await Reg.ListZeyilHepsiAsync();
        _mtv = await Reg.ListMtvAsync();
        _insp = await Reg.ListInspectionAsync();

        // Ödeme geçmişi TEK sorguda ve KAYIT KAPANSA DA gösterilir. Önceki hâli "kısmen ödenmiş"
        // filtresi kullanıyordu; kayıt kapanınca (Kalan=0) geçmiş ekrandan KAYBOLUYORDU — oysa
        // evrak numaraları ve kasa/banka dağılımı yalnız burada görünüyor ve ödemeler değişmez.
        _mtvOdeme = (await Reg.ListMtvOdemeHepsiAsync())
            .GroupBy(x => x.MtvId).ToDictionary(g => g.Key, g => (IReadOnlyList<MtvOdeme>)g.OrderBy(x => x.Sira).ToList());
        _muayeneOdeme = (await Reg.ListMuayeneOdemeHepsiAsync())
            .GroupBy(x => x.InspectionId).ToDictionary(g => g.Key, g => (IReadOnlyList<MuayeneOdeme>)g.OrderBy(x => x.Sira).ToList());
        _vehicles = await Vehicles.ListAsync();
        _vehMap = _vehicles.ToDictionary(v => v.Id, v => v.Plaka);

        // Seç-veya-yaz önerileri: master tanım (Ad) ∪ mevcut kayıtların distinct'i.
        var sirketler = await SigortaSirketleri.ListActiveAsync();
        _firmaOpts = sirketler.Select(s => s.Ad)
            .Concat(_ins.Select(i => i.Firma))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.CurrentCulture)
            .ToList();

        // Zeyil tipi seç-veya-yaz önerileri: yaygın tipler ∪ mevcut kayıtların distinct'i.
        // Sabit liste DEĞİL (canlıda da serbest metin) → ComboBox, <select> değil.
        _zeyilTipiOpts = new[] { "Zam", "Tenzil", "Değişiklik", "İptal", "Yenileme" }
            .Concat(_zeyil.Select(z => z.Tipi))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.CurrentCulture)
            .ToList();
    }

    private string Plaka(Guid id) => _vehMap.GetValueOrDefault(id, "—");

    /// <summary>Poliçe etiketi: plaka · tip · poliçe no (zeyil formunda/listesinde ayırt edici).</summary>
    private string PoliceEtiket(InsurancePolicy p)
        => $"{Plaka(p.VehicleId)} · {p.Tip}" + (string.IsNullOrWhiteSpace(p.PoliceNo) ? "" : $" · {p.PoliceNo}");

    private string PoliceEtiket(Guid policyId)
        => _insMap.TryGetValue(policyId, out var p) ? PoliceEtiket(p) : "—";

    private RenderFragment VehicleSelect(string name) =>@<select name="@name" required>
        <option value="">— seç —</option>
        @foreach (var v in _vehicles)
        {
            <option value="@v.Id">@v.Plaka</option>
        }
    </select>;
}
