@page "/vade"
@attribute [Authorize]
@inject VadeService Vade
@inject VehicleService Vehicles

<PageTitle>Vade Uyarıları — RentPro</PageTitle>

<div class="page-head"><h1>Vade Uyarıları</h1><div class="actions"><a href="/listeler/export/vade">Excel</a> · <a href="/listeler/export/vade?format=csv">CSV</a> · <a href="/listeler/export/vade?format=pdf">PDF</a></div></div>
<p class="muted">Sigorta / MTV / Muayene bitiş takibi.</p>

<form method="get" class="grid-form">
    <label>Plaka<input name="plaka" value="@PlakaFiltre" placeholder="ör. 34ABC" /></label>
    <button type="submit">Filtrele</button>
</form>

<div class="table-scroll">
@* kart-mobil: 640px altında satırlar karta döner. Telefonda "hangi araç, neyin vadesi,
   ne zaman doluyor, ne kadar kaldı, ne kadar acil" — beş alanın hepsi karar için gerekli. *@
<table class="grid tr-grid kart-mobil">
    <thead>
        <tr><th>Araç</th><th>Tür</th><th>Bitiş</th><th>Kalan Gün</th><th>Durum</th></tr>
    </thead>
    <tbody>
        @if (_items.Count == 0)
        {
            <tr><td colspan="5" class="muted">Yaklaşan vade yok.</td></tr>
        }
        @foreach (var i in _items.Where(x => PlakaUyar(x.VehicleId)))
        {
            <tr>
                <td class="kart-baslik">@Plaka(i.VehicleId)</td>
                <td data-etiket="Tür">@i.Tur</td>
                <td data-etiket="Bitiş">@i.Bitis.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td data-etiket="Kalan Gün">@i.KalanGun</td>
                <td data-etiket="Durum"><span class="badge @BucketClass(i.Bucket)">@BucketLabel(i.Bucket)</span></td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "plaka")] public string? PlakaFiltre { get; set; }

    private IReadOnlyList<VadeItem> _items = [];
    private Dictionary<Guid, string> _vehMap = new();

    protected override async Task OnInitializedAsync()
    {
        _items = await Vade.GetAllAsync();
        _vehMap = (await Vehicles.ListAsync()).ToDictionary(v => v.Id, v => v.Plaka);
    }

    private string Plaka(Guid id) => _vehMap.GetValueOrDefault(id, "—");

    // FAZ 2.1: plaka filtresi (?plaka=) — normalize karşılaştırma (boşluksuz, case-insensitive).
    private bool PlakaUyar(Guid id)
        => string.IsNullOrWhiteSpace(PlakaFiltre)
           || Plaka(id).Replace(" ", "").Contains(PlakaFiltre.Replace(" ", ""), StringComparison.OrdinalIgnoreCase);

    private static string BucketClass(VadeBucket b) => b switch
    {
        VadeBucket.Gecmis => "danger",
        VadeBucket.YediGun => "danger",
        VadeBucket.OtuzGun => "warn",
        _ => ""
    };

    private static string BucketLabel(VadeBucket b) => b switch
    {
        VadeBucket.Gecmis => "Geçmiş",
        VadeBucket.YediGun => "≤ 7 gün",
        VadeBucket.OtuzGun => "≤ 30 gün",
        _ => "İleri"
    };
}
