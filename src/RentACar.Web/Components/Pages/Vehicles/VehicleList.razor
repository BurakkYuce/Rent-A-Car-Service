@page "/vehicles"
@attribute [Authorize]
@using System.Globalization
@inject VehicleService Vehicles
@inject BrandService Markalar
@inject VehicleGroupService AracGruplari
@inject VarsayilanGrupCozucu VarsayilanGrup
@inject BranchService Subeler
@inject VehicleColorService Renkler
@inject VehicleSegmentService Segmentler
@inject VehicleTypeService AracTipleri

<PageTitle>Araçlar — RentPro</PageTitle>
@* Zengin araç listesi: aracı ayırt etmeye yeten tüm sütunlar tek tabloda; dar ekranda yatay kaydırılır. *@
@* .model-grup / .view-toggle stilleri app.css'e taşındı (merkezi tema; gerçek token'larla). *@
<style>
    /* Araç tablosu yalnız burada taşar → sayfa-özel yatay kaydırma sarmalayıcısı.
       FAZ-11 ile kolon sayısı arttı (alış/filo/belge/lastik/GPS + çözülen kira-servis-kredi). */
    .arac-grid-wrap { overflow-x: auto; width: 100%; }
    .arac-grid-wrap table { min-width: 3200px; }
    .arac-grid-wrap th, .arac-grid-wrap td { white-space: nowrap; }
</style>

<div class="page-head">
    <h1>Araç Listesi</h1>
    <div class="actions">
        <a href="/listeler/export/araclar">Excel'e Aktar</a>
        <a href="/listeler/export/araclar?format=csv">CSV</a> · <a href="/listeler/export/araclar?format=pdf">PDF</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_page.Total == 0)">
    <summary>+ Yeni Araç</summary>
    <form method="post" action="/vehicles/create" class="grid-form"><AntiforgeryToken />
        <label>Plaka<input name="plaka" required /></label>
        <ComboBox Name="marka" Label="Marka" Options="_markaOpts" />
        @* PR-10: Grup artık serbest metin DEĞİL — tanımlı gruplardan seçilir (serbest metin, hiçbir
           gruba eşleşmeyen ve bu yüzden vitrine/aramaya hiç girmeyen araçlar üretiyordu). Varsayılan
           grup ÖNSEÇİLİ gelir; "(Grupsuz)" bilinçli bir seçimdir ve varsayılana snap'lenmez. *@
        <label>Grup
            <select name="grup">
                <option value="">(Grupsuz)</option>
                @foreach (var g in _gruplar)
                {
                    <option value="@g.Ad" selected="@(TurkishText.EqualsIgnoreTurkishCase(g.Ad, _varsayilanGrupAd))">@g.Ad</option>
                }
            </select>
        </label>
        <ComboBox Name="tip" Label="Tip" Options="_tipOpts" />
        <ComboBox Name="segment" Label="Segment" Options="_segmentOpts" />
        <label>SIPP<input name="sipp" maxlength="4" placeholder="CDMD" /></label>
        <ComboBox Name="renk" Label="Renk" Options="_renkOpts" />
        <ComboBox Name="modelYili" Label="Model Yılı" Options="_yilOpts" />
        <label>Vites
            <select name="vites">
                <option value="">—</option>
                @foreach (var vt in Enum.GetValues<Vites>())
                {
                    <option value="@vt">@vt</option>
                }
            </select>
        </label>
        <label>Şasi No<input name="sasiNo" /></label>
        <label>Motor No<input name="motorNo" /></label>
        <ComboBox Name="sube" Label="Şube" Options="_subeOpts" />
        <label>Durum
            <select name="durum">
                @foreach (var s in Enum.GetValues<VehicleStatus>())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </label>
        <label>Filo Status
            <select name="filoDurum">
                <option value="">—</option>
                @foreach (var fs in Enum.GetValues<FiloStatus>())
                {
                    <option value="@fs">@fs</option>
                }
            </select>
        </label>
        <label>KM<input name="km" type="number" value="0" /></label>
        <label>Yakıt
            <select name="yakit">
                @foreach (var f in Enum.GetValues<FuelType>())
                {
                    <option value="@f">@f</option>
                }
            </select>
        </label>
        <button type="submit">Kaydet</button>
    </form>
</details>

<datalist id="arac-grup-list">
    @foreach (var g in _gruplar)
    {
        <option value="@g.Ad">@g.Kod</option>
    }
</datalist>

<div class="filter-panel">
    <form method="get" class="filter-bar">
        <input name="q" value="@Q" placeholder="Plaka / marka ara" />
        @* FAZ-11 "Grup Türü" anahtarı: aynı kutu Grup ya da SIPP kodunu arar (canlı parite).
           SIPP seçiliyken datalist grup adları önerirdi → yalnız Grup modunda bağlanır. *@
        <select name="grupTuru">
            <option value="Grup" selected="@(GrupTuru != "Sipp")">Grup</option>
            <option value="Sipp" selected="@(GrupTuru == "Sipp")">SIPP</option>
        </select>
        <input name="grup" value="@Grup" list="@(GrupTuru == "Sipp" ? null : "arac-grup-list")"
               placeholder="@(GrupTuru == "Sipp" ? "SIPP (ör. CDMD)" : "Grup")" />
        <select name="durum">
            <option value="">Durum (tümü)</option>
            @foreach (var s in Enum.GetValues<VehicleStatus>())
            {
                <option value="@s" selected="@(Durum == s.ToString())">@s</option>
            }
        </select>
        @* Canlıdaki "Ofis" filtresi bizde ŞUBE'dir — araç kaydında ayrı bir ofis alanı yok. *@
        <select name="sube">
            <option value="">Şube (tümü)</option>
            @foreach (var b in _subeOpts)
            {
                <option value="@b" selected="@(Sube == b)">@b</option>
            }
        </select>
        @* Araç sahibi: TAHMİN yerine SEÇİM. "Sahibi dolu = dış araç" varsayımı canlı veride
           çürüdü (tüm kayıtlarda alan "Bizim" metniyle doluydu) → sahipler listeden seçilir,
           ayrıca "girilmemiş" kovası veri eksiğini avlamak için ayrı seçenektir. *@
        <select name="sahip">
            <option value="">Araç sahibi (hepsi)</option>
            <option value="@SahipBosKod" selected="@(Sahip == SahipBosKod)">(sahibi girilmemiş)</option>
            @foreach (var s in _sahipOpts)
            {
                <option value="@s" selected="@(Sahip == s)">@s</option>
            }
        </select>
        <select name="tarihTuru" title="Tarih aralığının uygulanacağı alan">
            <option value="">Tarih türü (yok)</option>
            <option value="FiloGiris" selected="@(TarihTuru == "FiloGiris")">Filo Giriş</option>
            <option value="FiloCikis" selected="@(TarihTuru == "FiloCikis")">Filo Çıkış</option>
            <option value="Tescil" selected="@(TarihTuru == "Tescil")">İlk Tescil</option>
        </select>
        <input name="tarihBas" type="date" value="@TarihBas" title="Aralık başlangıcı" />
        <input name="tarihBit" type="date" value="@TarihBit" title="Aralık bitişi (gün dahil)" />
        <button type="submit">Filtrele</button>
        <span class="count-badge">Kayıt: @_page.Total</span>
        @if (_filtreVar)
        {
            <a href="/vehicles" class="link">Temizle</a>
        }
    </form>
</div>

<div class="summary-strip">
    <div class="cell"><div class="s-k">Toplam</div><div class="s-v">@_toplam</div></div>
    <div class="cell"><div class="s-k">Müsait</div><div class="s-v">@_musait</div></div>
    <div class="cell"><div class="s-k">Serviste</div><div class="s-v">@_serviste</div></div>
    <div class="cell"><div class="s-k">Doluluk</div><div class="s-v">%@_doluluk</div></div>
</div>

@* Görünüm anahtarı: düz liste (varsayılan) ↔ modele göre grupla (aynı marka+tip araçlar tek başlık altında). *@
<div class="view-toggle">
    <span class="muted small">Görünüm:</span>
    <a href="@ViewUrl(null)" class="@(_grupluMod ? "" : "on")">Liste</a>
    <a href="@ViewUrl("grup")" class="@(_grupluMod ? "on" : "")">Modele göre grupla</a>
</div>

@* ---- MODELE GÖRE GRUPLU GÖRÜNÜM (Marka+Tip) ---- *@
@if (_grupluMod)
{
    @if (_grupToplam > 200)
    {
        <p class="muted small">İlk 200 araç gruplandı (@_grupToplam kayıttan) — daraltmak için üstteki filtreyi kullanın.</p>
    }
    @if (_modelGruplari.Count == 0)
    {
        <p class="muted">Kayıtlı araç yok.</p>
    }
    @foreach (var m in _modelGruplari)
    {
        <details class="model-grup" open>
            <summary>
                <span class="mg-ad">@m.Etiket</span>
                @if (!string.IsNullOrEmpty(m.Grup)) { <span class="badge">@m.Grup</span> }
                @if (!string.IsNullOrEmpty(m.YilAralik)) { <span class="mg-say">Yıl @m.YilAralik</span> }
                <span class="mg-say">
                    <strong>@m.Toplam</strong> araç · @m.Musait müsait@(m.Kirada > 0 ? $" · {m.Kirada} kirada" : "")@(m.Serviste > 0 ? $" · {m.Serviste} serviste" : "")
                </span>
            </summary>
            <div class="mg-body">
                <div class="table-scroll">
                    <table class="grid tr-grid">
                        <thead>
                            <tr>
                                <th>Plaka</th><th>Model Yılı</th><th>Renk</th><th>Vites</th><th>Yakıt</th>
                                <th>KM</th><th>Şube</th><th>Durum</th><th>SIPP</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in m.Araclar)
                            {
                                <tr>
                                    <td class="kart-baslik"><a href="/vehicles/@v.Id">@v.Plaka</a></td>
                                    <td data-etiket="Yıl">@v.ModelYili</td>
                                    <td data-etiket="Renk">@v.Renk</td>
                                    <td data-etiket="Vites">@v.Vites</td>
                                    <td>@(v.Yakit?.ToString() ?? "—")</td>
                                    <td class="num" data-etiket="KM">@v.Km</td>
                                    <td data-etiket="Şube">@v.Sube</td>
                                    <td data-etiket="Durum"><StatusBadge Durum="@v.Durum" /></td>
                                    <td>@v.Sipp</td>
                                    <td class="kart-aksiyon">
                                        <a href="/araclar/@v.Id" class="link">Detay</a>
                                        <AuthorizeView Roles="Admin,Yonetici,Muhasebe" Context="karneGrpCtx">
                                            <a href="/raporlar/arac-karne/@v.Id" class="link" title="Ön muhasebe 360°">Karne</a>
                                        </AuthorizeView>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </details>
    }
}
else
{
<div class="arac-grid-wrap">
<div class="table-scroll">
    @* kart-mobil: 640px altında satırlar karta döner. Kartta YALNIZ data-etiket taşıyan hücreler
       görünür — 49 kolonu telefona dökmek tabloyu okumaktan da kötü olurdu. *@
    <table class="grid tr-grid kart-mobil">
        <thead>
            <tr>
                <th>Plaka</th><th>Marka</th><th>Tip</th><th>Detay Tipi</th><th>Grup</th><th>Segment</th><th>SIPP</th>
                <th>Model Yılı</th><th>Renk</th><th>Vites</th><th>Yakıt</th><th>KM</th><th>Şube</th><th>Durum</th>
                <th>Filo Durumu</th><th>Şasi No</th><th>Motor No</th><th>Motor Gücü</th><th>Araç Sahibi</th>
                <th>HGS No</th><th>OGS No</th><th>Kasa Tipi</th><th>Son Bakım KM</th>
                @* --- FAZ-11: canlı arac_listesi kolonları (hepsi araç kartının kendi alanları) --- *@
                <th class="num">Alış Bedeli</th><th>Filo Giriş</th><th>Filo Çıkış</th><th>İlk Tescil</th>
                <th>Alınan Firma</th><th>Ruhsat No</th><th class="num">2.El Değeri</th>
                <th class="num">Kasko Değeri</th><th>Yedek Anahtar</th><th>Kar Lastiği</th><th>Lastik Bilgisi</th>
                <th>Z-İzni</th><th>Statü</th><th>Lokasyon</th><th>GPS Takip No</th><th>Teyp Kodu</th><th>Açıklama</th>
                @* --- FAZ-11: diğer tablolardan CANLI çözülen kolonlar --- *@
                <th>Aktif Söz. No</th><th>Servis</th><th>BAF</th><th>Satış</th>
                <th>Kasko Bitiş</th><th class="num">Kasko Primi</th><th>Kredi Kuruluşu</th><th>Kredi Son Tarih</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_page.Items.Count == 0)
            {
                <tr><td colspan="49" class="muted">Kayıtlı araç yok.</td></tr>
            }
            @foreach (var v in _page.Items)
            {
                var ek = _ek.GetValueOrDefault(v.Id);
                <tr>
                    <td class="kart-baslik"><a href="/vehicles/@v.Id">@v.Plaka</a></td>
                    <td data-etiket="Marka">@v.Marka</td>
                    <td data-etiket="Tip">@v.Tip</td>
                    <td>@v.DetayTipi</td>
                    <td data-etiket="Grup">@v.Grup</td>
                    <td>@v.Segment</td>
                    <td>@v.Sipp</td>
                    <td>@v.ModelYili</td>
                    <td>@v.Renk</td>
                    <td>@v.Vites</td>
                    <td>@(v.Yakit?.ToString() ?? "—")</td>
                    <td class="num" data-etiket="KM">@v.Km</td>
                    <td data-etiket="Şube">@v.Sube</td>
                    <td data-etiket="Durum"><StatusBadge Durum="@v.Durum" /></td>
                    <td>@v.FiloDurum</td>
                    <td>@v.SasiNo</td>
                    <td>@v.MotorNo</td>
                    <td class="num">@v.MotorGucu</td>
                    <td>@v.AracSahibi</td>
                    <td>@v.HgsNo</td>
                    <td>@v.OgsNo</td>
                    <td>@v.KasaTipi</td>
                    <td class="num">@v.SonBakimKm</td>
                    <td class="num">@Para(v.AlimBedeli)</td>
                    <td>@Gun(v.FiloGirisTarih)</td>
                    <td>@Gun(v.FiloCikisTarih)</td>
                    <td>@Gun(v.TescilTarihi)</td>
                    <td>@v.AlimYapilanFirma</td>
                    <td>@v.RuhsatNo</td>
                    <td class="num">@Para(v.IkinciElDeger)</td>
                    <td class="num">@Para(v.TsbKaskoDegeri)</td>
                    <td>@(v.YedekAnahtar ? "Var" : "—")</td>
                    <td>@(v.KarLastigi ? "Var" : "—")</td>
                    <td>@v.LastikDurumu</td>
                    <td>@(v.ZIzni ? "Var" : "—")</td>
                    <td>@v.SonDurum</td>
                    <td>@v.Konum</td>
                    <td>@v.TakipNo</td>
                    <td>@v.TeypKodu</td>
                    <td>@v.Aciklama</td>
                    <td>@(ek?.AktifKiraSozlesmeNo ?? "—")</td>
                    <td>@(ek?.AcikServis == true ? "Açık" : "—")</td>
                    <td>@(ek?.AcikBaf == true ? "Tahsisli" : "—")</td>
                    <td>@(ek?.SatisVar == true ? "Var" : "—")</td>
                    <td>@Gun(ek?.KaskoBitis)</td>
                    <td class="num">@Para(ek?.KaskoPrim)</td>
                    <td>@ek?.KrediKurulusu</td>
                    <td>@Gun(ek?.KrediSonTarih)</td>
                    <td>
                        <a href="/araclar/@v.Id" class="link">Detay</a>
                        <AuthorizeView Roles="Admin,Yonetici,Muhasebe" Context="karneCtx">
                            <a href="/raporlar/arac-karne/@v.Id" class="link" title="Ön muhasebe 360°">Karne</a>
                        </AuthorizeView>
                        @* Yetki çiti: bu uç grup kapısından DAHA DAR bir izin istiyor (UcIzinKapsamaTests). Kapılanmazsa kullanıcı düğmeyi açık görür, basar, 403 alır ve /yetkisiz'e düşer. *@
                        <AuthorizeView Policy="izin:OperationsDelete" Context="silCtx">
                            <form method="post" action="/vehicles/delete" data-confirm="Silinsin mi?"><AntiforgeryToken />
                                <input type="hidden" name="id" value="@v.Id" />
                                <button type="submit" class="link danger">Sil</button>
                            </form>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>

@if (_page.TotalPages > 1)
{
    <nav class="pager">
        @if (_page.HasPrev) { <a href="@PageUrl(_page.Page - 1)">← Önceki</a> }
        <span class="muted">Sayfa @_page.Page / @_page.TotalPages (@_page.Total kayıt)</span>
        @if (_page.HasNext) { <a href="@PageUrl(_page.Page + 1)">Sonraki →</a> }
    </nav>
}
}

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "grup")] public string? Grup { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? Page { get; set; }
    [SupplyParameterFromQuery(Name = "gorunum")] public string? Gorunum { get; set; }
    // FAZ-11 filtreleri
    [SupplyParameterFromQuery(Name = "grupTuru")] public string? GrupTuru { get; set; }
    [SupplyParameterFromQuery(Name = "sube")] public string? Sube { get; set; }
    [SupplyParameterFromQuery(Name = "sahip")] public string? Sahip { get; set; }
    [SupplyParameterFromQuery(Name = "tarihTuru")] public string? TarihTuru { get; set; }
    [SupplyParameterFromQuery(Name = "tarihBas")] public string? TarihBas { get; set; }
    [SupplyParameterFromQuery(Name = "tarihBit")] public string? TarihBit { get; set; }

    private bool _grupluMod;
    private bool _filtreVar;
    private IReadOnlyDictionary<Guid, VehicleListeEk> _ek = new Dictionary<Guid, VehicleListeEk>();
    private List<string> _sahipOpts = [];

    /// <summary>"Sahibi girilmemiş" kovasının query değeri. Gerçek bir sahip adıyla çakışmasın
    /// diye parantezli/normal metinde geçmeyecek bir kod seçildi.</summary>
    private const string SahipBosKod = "-bos-";
    private List<ModelGrup> _modelGruplari = [];
    private int _grupToplam;

    /// <summary>Modele göre grup: aynı Marka+Tip ("model") araçlar tek başlık altında + durum sayaçları.</summary>
    private sealed record ModelGrup(string Etiket, string? Grup, string YilAralik,
        int Toplam, int Musait, int Kirada, int Serviste, List<Vehicle> Araclar);

    private PagedResult<Vehicle> _page = new([], 0, 1, 20);
    private IReadOnlyList<Brand> _markalar = [];
    private IReadOnlyList<VehicleGroup> _gruplar = [];
    private string? _varsayilanGrupAd; // PR-10
    private IReadOnlyList<Branch> _subeler = [];
    private List<string> _markaOpts = [], _grupOpts = [], _tipOpts = [], _segmentOpts = [], _renkOpts = [], _subeOpts = [], _yilOpts = [];
    private int _toplam, _musait, _serviste, _doluluk;

    // Seç-veya-yaz önerileri: master tanım listesi ∪ mevcut kayıtların distinct'i (veri girildikçe kendini besler).
    private static List<string> Opts(params IEnumerable<string?>[] sources) =>
        sources.SelectMany(s => s).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.CurrentCulture).ToList();

    /// <summary>Sayfa filtrelerini tek yerden kurar — liste ile gruplu görünüm ASLA ayrışmasın
    /// (eskiden iki ayrı kopya vardı; yeni bir filtre eklenince biri güncellenmeden kalırdı).</summary>
    private VehicleFilter Filtre(int page, int pageSize) => new()
    {
        Query = Q,
        Grup = Grup,
        GrupTuru = Enum.TryParse<AracGrupTuru>(GrupTuru, ignoreCase: true, out var gt) ? gt : AracGrupTuru.Grup,
        Sube = string.IsNullOrWhiteSpace(Sube) ? null : Sube,
        Sahiplik = Sahip == SahipBosKod ? AracSahiplik.Girilmemis : AracSahiplik.Hepsi,
        AracSahibi = Sahip == SahipBosKod || string.IsNullOrWhiteSpace(Sahip) ? null : Sahip,
        TarihTuru = Enum.TryParse<AracTarihTuru>(TarihTuru, ignoreCase: true, out var tt) ? tt : AracTarihTuru.Yok,
        TarihBas = Tarih(TarihBas),
        TarihBit = Tarih(TarihBit),
        Durum = Enum.TryParse<VehicleStatus>(Durum, out var d) ? d : null,
        Page = page,
        PageSize = pageSize
    };

    /// <summary>Filtre kutusundaki "yyyy-MM-dd" → o günün YEREL gece yarısı (UTC'ye çevrilmiş).
    /// Tarih alanları forma da yerel gün olarak girildiği için (FormParse.Date) aralık da aynı
    /// çerçevede kurulmalı; UTC gece yarısı almak sınır günlerde bir gün kaydırırdı.</summary>
    private static DateTimeOffset? Tarih(string? s)
        => DateTime.TryParse(s, CultureInfo.InvariantCulture, DateTimeStyles.None, out var d)
            ? new DateTimeOffset(d.Date, TimeZoneInfo.Local.GetUtcOffset(d.Date)).ToUniversalTime()
            : null;

    protected override async Task OnInitializedAsync()
    {
        _filtreVar = !string.IsNullOrEmpty(Q) || !string.IsNullOrEmpty(Grup) || !string.IsNullOrEmpty(Durum)
            || !string.IsNullOrEmpty(Sube) || !string.IsNullOrEmpty(Sahip)
            || !string.IsNullOrEmpty(TarihTuru) || !string.IsNullOrEmpty(GrupTuru);

        _page = await Vehicles.SearchAsync(Filtre(Page ?? 1, 20));
        // Ek bilgi YALNIZ görünen sayfa için (20 satır) — tüm filo taranmaz.
        _ek = await Vehicles.ListeEkAsync(_page.Items.Select(v => v.Id).ToList());

        // Modele göre gruplu görünüm: aynı filtreyle (SearchAsync semantiği) ilk 200 aracı çek, Marka+Tip
        // bazında grupla. Sayfalama yok (grup üzerinde <details>); 200 üstü net not (sessiz kırpma yok).
        _grupluMod = string.Equals(Gorunum, "grup", StringComparison.OrdinalIgnoreCase);
        if (_grupluMod)
        {
            var grupSonuc = await Vehicles.SearchAsync(Filtre(1, 200));
            _grupToplam = grupSonuc.Total;
            _modelGruplari = grupSonuc.Items
                .GroupBy(v => $"{(v.Marka ?? "").Trim()}|{(v.Tip ?? "").Trim()}".ToLowerInvariant())
                .Select(g =>
                {
                    var ilk = g.First();
                    var etiket = $"{ilk.Marka} {ilk.Tip}".Trim();
                    if (string.IsNullOrWhiteSpace(etiket)) etiket = "(model belirtilmemiş)";
                    var yillar = g.Where(v => v.ModelYili is > 0).Select(v => v.ModelYili!.Value).ToList();
                    var yilAralik = yillar.Count == 0 ? ""
                        : (yillar.Min() == yillar.Max() ? yillar.Min().ToString() : $"{yillar.Min()}–{yillar.Max()}");
                    return new ModelGrup(etiket, ilk.Grup, yilAralik,
                        g.Count(),
                        g.Count(v => v.Durum == VehicleStatus.Musait),
                        g.Count(v => v.Durum == VehicleStatus.Kirada),
                        g.Count(v => v.Durum == VehicleStatus.Serviste),
                        g.OrderByDescending(v => v.ModelYili ?? 0).ThenBy(v => v.Plaka, StringComparer.CurrentCulture).ToList());
                })
                .OrderByDescending(m => m.Toplam).ThenBy(m => m.Etiket, StringComparer.CurrentCulture)
                .ToList();
        }

        _markalar = await Markalar.ListActiveAsync();
        _gruplar = await AracGruplari.ListActiveAsync();
        _varsayilanGrupAd = await VarsayilanGrup.AdAsync(); // PR-10: yeni araç formunda önseçili gelir
        _subeler = await Subeler.ListActiveAsync();
        var renkler = await Renkler.ListActiveAsync();
        var segmentler = await Segmentler.ListActiveAsync();
        var tipler = await AracTipleri.ListActiveAsync();

        // Özet şerit (tüm filo — canlıdaki Boş/Kira/Bakım/Toplam/Doluluk şeridi).
        var all = await Vehicles.ListAsync();
        _toplam = all.Count;

        // Seç-veya-yaz önerileri (master tanımlar ∪ mevcut kayıt değerleri).
        _markaOpts = Opts(_markalar.Select(m => m.Ad), all.Select(v => v.Marka));
        _grupOpts = Opts(_gruplar.Select(g => g.Ad), all.Select(v => v.Grup));
        _tipOpts = Opts(tipler.Select(t => t.Ad), all.Select(v => v.Tip));
        _segmentOpts = Opts(segmentler.Select(s => s.Ad), all.Select(v => v.Segment));
        _renkOpts = Opts(renkler.Select(r => r.Ad), all.Select(v => v.Renk));
        _subeOpts = Opts(_subeler.Select(s => s.Ad), all.Select(v => v.Sube));
        // FAZ-11 araç sahibi filtresi: kayıtlarda GEÇEN sahipler (master listesi değil — filtre,
        // tanımlı ama hiç kullanılmamış bir sahibi göstererek boş sonuç vaat etmemeli).
        _sahipOpts = Opts(all.Select(v => v.AracSahibi));

        // Model yılı: gelecek yıl → ~30 yıl geriye (seç-veya-yaz; asıl sınır server doğrulaması).
        var maxYil = DateTimeOffset.UtcNow.Year + 1;
        _yilOpts = Enumerable.Range(maxYil - 30, 31).Select(y => y.ToString()).Reverse().ToList();
        _musait = all.Count(v => v.Durum == VehicleStatus.Musait);
        _serviste = all.Count(v => v.Durum == VehicleStatus.Serviste);
        _doluluk = _toplam == 0 ? 0 : (int)Math.Round(100.0 * (_toplam - _musait) / _toplam);
    }

    /// <summary>Aktif filtrelerin query-string'i — sayfalama ve görünüm anahtarı ORTAK kullanır.
    /// Tek yerde tutulmazsa yeni bir filtre eklendiğinde "2. sayfaya geçince filtre kayboldu"
    /// hatası doğar (bu sayfada iki ayrı kopya vardı).</summary>
    private List<string> FiltreQs()
    {
        var qs = new List<string>();
        if (!string.IsNullOrEmpty(Q)) qs.Add($"q={Uri.EscapeDataString(Q)}");
        if (!string.IsNullOrEmpty(Grup)) qs.Add($"grup={Uri.EscapeDataString(Grup)}");
        if (!string.IsNullOrEmpty(GrupTuru)) qs.Add($"grupTuru={Uri.EscapeDataString(GrupTuru)}");
        if (!string.IsNullOrEmpty(Durum)) qs.Add($"durum={Durum}");
        if (!string.IsNullOrEmpty(Sube)) qs.Add($"sube={Uri.EscapeDataString(Sube)}");
        if (!string.IsNullOrEmpty(Sahip)) qs.Add($"sahip={Uri.EscapeDataString(Sahip)}");
        if (!string.IsNullOrEmpty(TarihTuru)) qs.Add($"tarihTuru={Uri.EscapeDataString(TarihTuru)}");
        if (!string.IsNullOrEmpty(TarihBas)) qs.Add($"tarihBas={Uri.EscapeDataString(TarihBas)}");
        if (!string.IsNullOrEmpty(TarihBit)) qs.Add($"tarihBit={Uri.EscapeDataString(TarihBit)}");
        return qs;
    }

    private string PageUrl(int p)
    {
        var qs = FiltreQs();
        qs.Insert(0, $"page={p}");
        return "/vehicles?" + string.Join("&", qs);
    }

    // Görünüm anahtarı URL'i (mevcut filtreleri korur; gorunum=null → düz liste).
    private string ViewUrl(string? gorunum)
    {
        var qs = FiltreQs();
        if (gorunum is not null) qs.Add($"gorunum={gorunum}");
        return "/vehicles" + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
    }

    /// <summary>Para gösterimi (kültüre duyarlı, binlik ayraçlı); null → "—".</summary>
    private static string Para(decimal? d) => d?.ToString("N2") ?? "—";

    /// <summary>Tarih gösterimi: depolanan UTC anı YEREL güne çevirir (VehicleEdit'teki Gun()
    /// yardımcısıyla aynı çerçeve — tarihler yerel gün olarak yazılıyor).</summary>
    private static string Gun(DateTimeOffset? d) => d?.LocalDateTime.ToString("dd.MM.yyyy") ?? "—";
}
