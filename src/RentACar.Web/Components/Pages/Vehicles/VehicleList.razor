@page "/vehicles"
@attribute [Authorize]
@inject VehicleService Vehicles
@inject BrandService Markalar
@inject VehicleGroupService AracGruplari
@inject BranchService Subeler
@inject VehicleColorService Renkler
@inject VehicleSegmentService Segmentler
@inject VehicleTypeService AracTipleri

<PageTitle>Araçlar — RentPro</PageTitle>

<div class="page-head">
    <h1>Araç Listesi</h1>
    <div class="actions">
        <a href="/listeler/export/araclar">Excel'e Aktar</a>
        <a href="/listeler/export/araclar?format=csv">CSV</a> · <a href="/listeler/export/araclar?format=pdf">PDF</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Hata))
{
    <p class="error">@Hata</p>
}

<details class="new-vehicle" open="@(_page.Total == 0)">
    <summary>+ Yeni Araç</summary>
    <form method="post" action="/vehicles/create" class="grid-form"><AntiforgeryToken />
        <label>Plaka<input name="plaka" required /></label>
        <ComboBox Name="marka" Label="Marka" Options="_markaOpts" />
        <ComboBox Name="grup" Label="Grup" Options="_grupOpts" />
        <ComboBox Name="tip" Label="Tip" Options="_tipOpts" />
        <ComboBox Name="segment" Label="Segment" Options="_segmentOpts" />
        <label>SIPP<input name="sipp" maxlength="4" placeholder="CDMD" /></label>
        <ComboBox Name="renk" Label="Renk" Options="_renkOpts" />
        <ComboBox Name="modelYili" Label="Model Yılı" Options="_yilOpts" />
        <label>Vites
            <select name="vites">
                <option value="">—</option>
                @foreach (var vt in Enum.GetValues<Vites>())
                {
                    <option value="@vt">@vt</option>
                }
            </select>
        </label>
        <label>Şasi No<input name="sasiNo" /></label>
        <label>Motor No<input name="motorNo" /></label>
        <ComboBox Name="sube" Label="Şube" Options="_subeOpts" />
        <label>Durum
            <select name="durum">
                @foreach (var s in Enum.GetValues<VehicleStatus>())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </label>
        <label>Filo Status
            <select name="filoDurum">
                <option value="">—</option>
                @foreach (var fs in Enum.GetValues<FiloStatus>())
                {
                    <option value="@fs">@fs</option>
                }
            </select>
        </label>
        <label>KM<input name="km" type="number" value="0" /></label>
        <label>Yakıt
            <select name="yakit">
                @foreach (var f in Enum.GetValues<FuelType>())
                {
                    <option value="@f">@f</option>
                }
            </select>
        </label>
        <button type="submit">Kaydet</button>
    </form>
</details>

<datalist id="arac-grup-list">
    @foreach (var g in _gruplar)
    {
        <option value="@g.Ad">@g.Kod</option>
    }
</datalist>

<div class="filter-panel">
    <form method="get" class="filter-bar">
        <input name="q" value="@Q" placeholder="Plaka / marka ara" />
        <input name="grup" value="@Grup" list="arac-grup-list" placeholder="Grup" />
        <select name="durum">
            <option value="">Durum (tümü)</option>
            @foreach (var s in Enum.GetValues<VehicleStatus>())
            {
                <option value="@s" selected="@(Durum == s.ToString())">@s</option>
            }
        </select>
        <button type="submit">Filtrele</button>
        <span class="count-badge">Kayıt: @_page.Total</span>
        @if (!string.IsNullOrEmpty(Q) || !string.IsNullOrEmpty(Grup) || !string.IsNullOrEmpty(Durum))
        {
            <a href="/vehicles" class="link">Temizle</a>
        }
    </form>
</div>

<div class="summary-strip">
    <div class="cell"><div class="s-k">Toplam</div><div class="s-v">@_toplam</div></div>
    <div class="cell"><div class="s-k">Müsait</div><div class="s-v">@_musait</div></div>
    <div class="cell"><div class="s-k">Serviste</div><div class="s-v">@_serviste</div></div>
    <div class="cell"><div class="s-k">Doluluk</div><div class="s-v">%@_doluluk</div></div>
</div>

<table class="grid tr-grid">
    <thead>
        <tr>
            <th>Plaka</th><th>Marka</th><th>Grup</th><th>Şube</th>
            <th>Durum</th><th>KM</th><th>Yakıt</th><th></th>
        </tr>
    </thead>
    <tbody>
        @if (_page.Items.Count == 0)
        {
            <tr><td colspan="8" class="muted">Kayıtlı araç yok.</td></tr>
        }
        @foreach (var v in _page.Items)
        {
            <tr>
                <td><a href="/vehicles/@v.Id">@v.Plaka</a></td>
                <td>@v.Marka</td>
                <td>@v.Grup</td>
                <td>@v.Sube</td>
                <td>@v.Durum</td>
                <td>@v.Km</td>
                <td>@v.Yakit</td>
                <td>
                    <a href="/araclar/@v.Id" class="link">Detay</a>
                    <form method="post" action="/vehicles/delete" onsubmit="return confirm('Silinsin mi?')"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@v.Id" />
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (_page.TotalPages > 1)
{
    <nav class="pager">
        @if (_page.HasPrev) { <a href="@PageUrl(_page.Page - 1)">← Önceki</a> }
        <span class="muted">Sayfa @_page.Page / @_page.TotalPages (@_page.Total kayıt)</span>
        @if (_page.HasNext) { <a href="@PageUrl(_page.Page + 1)">Sonraki →</a> }
    </nav>
}

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "grup")] public string? Grup { get; set; }
    [SupplyParameterFromQuery(Name = "durum")] public string? Durum { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? Page { get; set; }

    private PagedResult<Vehicle> _page = new([], 0, 1, 20);
    private IReadOnlyList<Brand> _markalar = [];
    private IReadOnlyList<VehicleGroup> _gruplar = [];
    private IReadOnlyList<Branch> _subeler = [];
    private List<string> _markaOpts = [], _grupOpts = [], _tipOpts = [], _segmentOpts = [], _renkOpts = [], _subeOpts = [], _yilOpts = [];
    private int _toplam, _musait, _serviste, _doluluk;

    // Seç-veya-yaz önerileri: master tanım listesi ∪ mevcut kayıtların distinct'i (veri girildikçe kendini besler).
    private static List<string> Opts(params IEnumerable<string?>[] sources) =>
        sources.SelectMany(s => s).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.CurrentCulture).ToList();

    protected override async Task OnInitializedAsync()
    {
        var filter = new VehicleFilter
        {
            Query = Q, Grup = Grup, Page = Page ?? 1,
            Durum = Enum.TryParse<VehicleStatus>(Durum, out var d) ? d : null
        };
        _page = await Vehicles.SearchAsync(filter);
        _markalar = await Markalar.ListActiveAsync();
        _gruplar = await AracGruplari.ListActiveAsync();
        _subeler = await Subeler.ListActiveAsync();
        var renkler = await Renkler.ListActiveAsync();
        var segmentler = await Segmentler.ListActiveAsync();
        var tipler = await AracTipleri.ListActiveAsync();

        // Özet şerit (tüm filo — canlıdaki Boş/Kira/Bakım/Toplam/Doluluk şeridi).
        var all = await Vehicles.ListAsync();
        _toplam = all.Count;

        // Seç-veya-yaz önerileri (master tanımlar ∪ mevcut kayıt değerleri).
        _markaOpts = Opts(_markalar.Select(m => m.Ad), all.Select(v => v.Marka));
        _grupOpts = Opts(_gruplar.Select(g => g.Ad), all.Select(v => v.Grup));
        _tipOpts = Opts(tipler.Select(t => t.Ad), all.Select(v => v.Tip));
        _segmentOpts = Opts(segmentler.Select(s => s.Ad), all.Select(v => v.Segment));
        _renkOpts = Opts(renkler.Select(r => r.Ad), all.Select(v => v.Renk));
        _subeOpts = Opts(_subeler.Select(s => s.Ad), all.Select(v => v.Sube));

        // Model yılı: gelecek yıl → ~30 yıl geriye (seç-veya-yaz; asıl sınır server doğrulaması).
        var maxYil = DateTimeOffset.UtcNow.Year + 1;
        _yilOpts = Enumerable.Range(maxYil - 30, 31).Select(y => y.ToString()).Reverse().ToList();
        _musait = all.Count(v => v.Durum == VehicleStatus.Musait);
        _serviste = all.Count(v => v.Durum == VehicleStatus.Serviste);
        _doluluk = _toplam == 0 ? 0 : (int)Math.Round(100.0 * (_toplam - _musait) / _toplam);
    }

    private string PageUrl(int p)
    {
        var qs = new List<string> { $"page={p}" };
        if (!string.IsNullOrEmpty(Q)) qs.Add($"q={Uri.EscapeDataString(Q)}");
        if (!string.IsNullOrEmpty(Grup)) qs.Add($"grup={Uri.EscapeDataString(Grup)}");
        if (!string.IsNullOrEmpty(Durum)) qs.Add($"durum={Durum}");
        return "/vehicles?" + string.Join("&", qs);
    }
}
