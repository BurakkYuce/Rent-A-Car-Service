@page "/vehicles/{Id:guid}"
@attribute [Authorize]
@inject VehicleService Vehicles
@inject BrandService Markalar
@inject VehicleGroupService AracGruplari
@inject BranchService Subeler
@inject VehicleColorService Renkler
@inject VehicleSegmentService Segmentler
@inject VehicleTypeService AracTipleri
@inject NavigationManager Nav
@inject VehiclePhotoService Fotograflar

<PageTitle>Araç Düzenle — RentPro</PageTitle>

@if (_vehicle is null)
{
    <div class="page-head"><h1>Araç Düzenle</h1></div>
    <p class="error">Araç bulunamadı.</p>
    <a href="/vehicles">← Listeye dön</a>
}
else
{
    <div class="page-head">
        <h1>@_vehicle.Plaka — Araç Düzenle</h1>
        <div class="actions">
            <button type="submit" form="veh-form">Kaydet</button>
            <a href="/vehicles">Araç Listesi</a>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(Hata))
    {
        <p class="error">@Hata</p>
    }

    <form id="veh-form" method="post" action="/vehicles/update" class="grid-form"><AntiforgeryToken />
        <input type="hidden" name="id" value="@_vehicle.Id" />
        <label>Plaka<input name="plaka" value="@_vehicle.Plaka" required /></label>
        <ComboBox Name="marka" Label="Marka" Value="@_vehicle.Marka" Options="_markaOpts" />
        @* PR-10: Grup tanımlı gruplardan seçilir. TUZAK: bu aracın mevcut değeri hiçbir gruba
           eşleşmeyen serbest metin olabilir (ör. "FİAT-EGEA-MANUEL-DİZEL"). Katı bir select onu
           listede bulamayıp ALAKASIZ bir düzenlemede sessizce silerdi → mevcut tanımsız değer
           ayrı bir seçenek olarak korunur ve seçili gelir. Toplu düzeltme yeri: Araç Grupları ekranı. *@
        <label>Grup
            <select name="grup">
                <option value="">(Grupsuz)</option>
                @if (_grupTanimsiz is not null)
                {
                    <option value="@_grupTanimsiz" selected>@_grupTanimsiz — tanımsız</option>
                }
                @foreach (var g in _gruplar)
                {
                    <option value="@g.Ad" selected="@(TurkishText.EqualsIgnoreTurkishCase(g.Ad, _vehicle.Grup))">@g.Ad</option>
                }
            </select>
        </label>
        <ComboBox Name="tip" Label="Tip" Value="@_vehicle.Tip" Options="_tipOpts" />
        <ComboBox Name="segment" Label="Segment" Value="@_vehicle.Segment" Options="_segmentOpts" />
        <label>SIPP<input name="sipp" value="@_vehicle.Sipp" maxlength="4" placeholder="CDMD" /></label>
        <ComboBox Name="renk" Label="Renk" Value="@_vehicle.Renk" Options="_renkOpts" />
        <ComboBox Name="modelYili" Label="Model Yılı" Value="@(_vehicle.ModelYili?.ToString())" Options="_yilOpts" />
        <label>Vites
            <select name="vites">
                <option value="">—</option>
                @foreach (var vt in Enum.GetValues<Vites>())
                {
                    <option value="@vt" selected="@(_vehicle.Vites == vt)">@vt</option>
                }
            </select>
        </label>
        <label>Şasi No<input name="sasiNo" value="@_vehicle.SasiNo" /></label>
        <label>Motor No<input name="motorNo" value="@_vehicle.MotorNo" /></label>
        <ComboBox Name="sube" Label="Şube" Value="@_vehicle.Sube" Options="_subeOpts" />
        <label>Durum
            <select name="durum">
                @foreach (var s in Enum.GetValues<VehicleStatus>())
                {
                    <option value="@s" selected="@(s == _vehicle.Durum)">@s</option>
                }
            </select>
        </label>
        <label>Filo Status
            <select name="filoDurum">
                <option value="">—</option>
                @foreach (var fs in Enum.GetValues<FiloStatus>())
                {
                    <option value="@fs" selected="@(_vehicle.FiloDurum == fs)">@fs</option>
                }
            </select>
        </label>
        <label>KM<input name="km" type="number" value="@_vehicle.Km" /></label>
        <label>Yakıt
            @* PR-21: "Belirtilmedi" GERÇEK bir seçenek. Eskiden alan zorunluydu ve varsayılanı
               Benzin'di; yakıtı bilinmeyen her araç sessizce "Benzin" kaydediliyor ve bu bilgi
               halka açık siteye, ilan başlığına ve sözleşmeye basılıyordu. *@
            <select name="yakit">
                <option value="" selected="@(_vehicle.Yakit is null)">— Belirtilmedi —</option>
                @foreach (var f in Enum.GetValues<FuelType>())
                {
                    <option value="@f" selected="@(f == _vehicle.Yakit)">@f</option>
                }
            </select>
        </label>
        <label>Araç Sahibi<input name="aracSahibi" value="@_vehicle.AracSahibi" /></label>
        <label>Motor Gücü (HP)<input name="motorGucu" type="number" min="0" value="@_vehicle.MotorGucu" /></label>
        <label>Silindir Hacmi (cc)<input name="silindirHacmi" type="number" min="0" value="@_vehicle.SilindirHacmi" /></label>
        <label>Ruhsat No<input name="ruhsatNo" value="@_vehicle.RuhsatNo" /></label>
        <label>Tescil Tarihi<input name="tescilTarihi" type="date" value="@Gun(_vehicle.TescilTarihi)" /></label>
        <label>Alım Bedeli<input name="alimBedeli" type="number" step="0.01" min="0" value="@Inv(_vehicle.AlimBedeli)" /></label>
        <label>Alım Tarihi<input name="alimTarihi" type="date" value="@Gun(_vehicle.AlimTarihi)" /></label>
        <label>Alış Vergisiz<input name="alisVergisiz" type="number" step="0.01" min="0" value="@Inv(_vehicle.AlisVergisiz)" /></label>
        <label>Alış ÖTV<input name="alisOtv" type="number" step="0.01" min="0" value="@Inv(_vehicle.AlisOtv)" /></label>
        <label>Alış KDV<input name="alisKdv" type="number" step="0.01" min="0" value="@Inv(_vehicle.AlisKdv)" /></label>
        <label>Aylık Maliyet<input name="aylikMaliyet" type="number" step="0.01" min="0" value="@Inv(_vehicle.AylikMaliyet)" /></label>
        <label>Filo Yön. Maliyeti<input name="filoYonetimMaliyeti" type="number" step="0.01" min="0" value="@Inv(_vehicle.FiloYonetimMaliyeti)" /></label>
        <label>2.El Değer<input name="ikinciElDeger" type="number" step="0.01" min="0" value="@Inv(_vehicle.IkinciElDeger)" /></label>
        <label>Filo Giriş<input name="filoGirisTarih" type="date" value="@Gun(_vehicle.FiloGirisTarih)" /></label>
        <label>Filo Çıkış<input name="filoCikisTarih" type="date" value="@Gun(_vehicle.FiloCikisTarih)" /></label>
        <label>Özel Kod 1<input name="ozelKod1" value="@_vehicle.OzelKod1" /></label>
        <label>Özel Kod 2<input name="ozelKod2" value="@_vehicle.OzelKod2" /></label>
        <label>Özel Kod 3<input name="ozelKod3" value="@_vehicle.OzelKod3" /></label>
        <label>Özel Kod 4<input name="ozelKod4" value="@_vehicle.OzelKod4" /></label>
        <label>Özel Kod 5<input name="ozelKod5" value="@_vehicle.OzelKod5" /></label>
        <label>HGS No<input name="hgsNo" value="@_vehicle.HgsNo" /></label>
        <label>OGS No<input name="ogsNo" value="@_vehicle.OgsNo" /></label>
        <label>Kasa Tipi<input name="kasaTipi" value="@_vehicle.KasaTipi" /></label>
        <label>Detay Tipi<input name="detayTipi" value="@_vehicle.DetayTipi" placeholder="Sedan/SUV/Van..." /></label>
        <label>Alım Fatura No<input name="alimFaturaNo" value="@_vehicle.AlimFaturaNo" /></label>
        <label>Alım Yapılan Firma<input name="alimYapilanFirma" value="@_vehicle.AlimYapilanFirma" /></label>
        <label>Kira KM Limiti<input name="kiraKmLimiti" type="number" min="0" value="@_vehicle.KiraKmLimiti" /></label>
        <label>Son Bakım Tarihi<input name="sonBakimTarih" type="date" value="@Gun(_vehicle.SonBakimTarih)" /></label>
        <label>Son Bakım KM<input name="sonBakimKm" type="number" min="0" value="@_vehicle.SonBakimKm" /></label>
        <label>Lastik Durumu<input name="lastikDurumu" value="@_vehicle.LastikDurumu" placeholder="Yazlık/Kışlık..." /></label>
        @* PR-11: elinde aynı araçtan N adet olup hepsini ayrı ayrı kaydetmek istemeyen firma için.
           YALNIZ vitrin gösterimi — rezervasyon/kira/müsaitlik bu alanı OKUMAZ (iç sistem plaka
           başına tekil araçla çalışır). Kirayı sistemde tutuyorsanız her araç için ayrı kayıt açın:
           tek kayıt kiraya çıktığında grup aramada N'den 0'a inmez, TAMAMEN kaybolur. *@
        <label>Vitrin Adedi<input name="vitrinAdet" type="number" min="1" max="999" value="@_vehicle.VitrinAdet"
            placeholder="1" title="Halka açık sitede kaç araç olarak gösterilsin (boş = 1). Yalnız gösterim." /></label>
        @* FAZ-28 — detaylı liste alanları. Ayrı bir katlanır bölüm: hepsi BİLGİ alanı, hiçbiri
           fiyat motoruna / deftere / müsaitliğe girmez. "Kiralama anlık görüntüsü" başlığındakiler
           ELLE girilen notlardır; aracın GERÇEK aktif kirası her zaman kira kayıtlarından okunur
           (Detaylı Liste ekranındaki "Aktif Kira" kolonları). *@
        <details class="u-col-full">
            <summary class="link">Detay Alanları (ruhsat / ticari / kiralama notu)</summary>
            <div class="grid-form">
                <label>Belge No<input name="belgeNo" value="@_vehicle.BelgeNo" /></label>
                <label>Ruhsat Sahibi<input name="ruhsatSahibi" value="@_vehicle.RuhsatSahibi" /></label>
                <label>Sözleşme No<input name="sozNo" value="@_vehicle.SozNo" /></label>
                <label>Aracı Alan<input name="araciAlan" value="@_vehicle.AraciAlan" /></label>
                <label>Ödeme Şekli<input name="odemeSekli" value="@_vehicle.OdemeSekli" /></label>
                <label>Assistans Firma<input name="assistanFirma" value="@_vehicle.AssistanFirma" /></label>
                <label>HGS Firma<input name="hgsFirma" value="@_vehicle.HgsFirma" /></label>
                <label>Yurt Dışı KM Limiti<input name="disKmLimit" type="number" min="0" value="@_vehicle.DisKmLimit" /></label>
                <label>TSB Kodu<input name="tsbKodu" value="@_vehicle.TsbKodu" /></label>
                <label>TSB Kasko Değeri<input name="tsbKaskoDegeri" type="number" step="0.01" min="0" value="@Inv(_vehicle.TsbKaskoDegeri)" /></label>
                <label class="check"><input type="checkbox" name="alisEuro" value="true" checked="@(_vehicle.AlisEuro == true)" /> Alım EURO bazlı</label>
                <label>Alış EURO Fiyatı<input name="alisEuroFiyat" type="number" step="0.01" min="0" value="@Inv(_vehicle.AlisEuroFiyat)" /></label>
                <label>Hedef Satış EURO<input name="satisEuroFiyat" type="number" step="0.01" min="0" value="@Inv(_vehicle.SatisEuroFiyat)" /></label>
                <label>Pasif Sebebi<input name="pasifSebep" value="@_vehicle.PasifSebep" /></label>
                <label>Son Durum Notu<input name="sonDurum" value="@_vehicle.SonDurum" /></label>
                <label>Son Teslim KM<input name="sonTeslimKm" type="number" min="0" value="@_vehicle.SonTeslimKm" /></label>
                <label>Son Teslim Tarihi<input name="sonTeslimTarihi" type="date" value="@_vehicle.SonTeslimTarihi?.LocalDateTime.ToString("yyyy-MM-dd")" /></label>
                <label>Kiralayan (not)<input name="kiralayan" value="@_vehicle.Kiralayan" /></label>
                <label>Kira Gün (not)<input name="kiraGun" type="number" min="0" value="@_vehicle.KiraGun" /></label>
                <label>Kira Fiyatı (not)<input name="kiraFiyat" type="number" step="0.01" min="0" value="@Inv(_vehicle.KiraFiyat)" /></label>
                <label>Kira Bitiş (not)<input name="kiraBitTar" type="date" value="@_vehicle.KiraBitTar?.LocalDateTime.ToString("yyyy-MM-dd")" /></label>
                <label>Beklenen Dönüş (not)<input name="kiraBekTar" type="date" value="@_vehicle.KiraBekTar?.LocalDateTime.ToString("yyyy-MM-dd")" /></label>
            </div>
        </details>

        @* FAZ-10 — canlı arac_kayit.aspx kartındaki kalan alanlar. HEPSİ BİLGİ: fiyat motoru,
           müsaitlik, defter ve karne/karlılık hesapları bu alanları OKUMAZ. *@
        <details class="u-col-full">
            <summary class="link">Kart Derinliği (entegrasyon / GPS / sahiplik / kapanış)</summary>
            <div class="grid-form">
                <label>TSRB Marka Kodu<input name="tsrbMarkaKodu" value="@_vehicle.TsrbMarkaKodu" maxlength="32" /></label>
                <label>TSRB Tip Kodu<input name="tsrbTipKodu" value="@_vehicle.TsrbTipKodu" maxlength="32" /></label>
                <label>Alt Grup Adı<input name="altGrupAdi" value="@_vehicle.AltGrupAdi" maxlength="64"
                    title="Serbest kırılım — araç grubu (fiyatlama) DEĞİL" /></label>
                <label>Entegrasyon Kodu<input name="entegrasyonKodu" value="@_vehicle.EntegrasyonKodu" maxlength="64" /></label>
                <label>Teyp Kodu<input name="teypKodu" value="@_vehicle.TeypKodu" maxlength="64" /></label>
                @* GPS takip HGS/OGS'den AYRI cihazdır — aynı kutuya koymak ikisini karıştırırdı. *@
                <label>Takip Cihazı Markası<input name="takipMarka" value="@_vehicle.TakipMarka" maxlength="64"
                    title="GPS takip cihazı — HGS/OGS'den ayrı" /></label>
                <label>Takip Cihazı No<input name="takipNo" value="@_vehicle.TakipNo" maxlength="64" /></label>
                <label>Sahip Grubu<input name="sahipGrup" value="@_vehicle.SahipGrup" maxlength="64" /></label>
                <label>Araç Sahibi No<input name="aracSahibiNo" value="@_vehicle.AracSahibiNo" maxlength="64" /></label>
                <label>2. Araç Sahibi<input name="aracSahibi2" value="@_vehicle.AracSahibi2" maxlength="128" /></label>
                <label>Kredi Firması<input name="krediFirma" value="@_vehicle.KrediFirma" maxlength="128" /></label>
                <label>Kapatma Tarihi<input name="kapatmaTarih" type="date" value="@Gun(_vehicle.KapatmaTarih)" /></label>
                @* PLANLANAN çıkış — GERÇEKLEŞEN çıkış FiloCikisTarih'tir; planı oraya yazmak
                   aracı filodan düşürürdü. *@
                <label>Çıkması Planlanan Tarih<input name="cikmasiPlananTarih" type="date" value="@Gun(_vehicle.CikmasiPlananTarih)"
                    title="Plan — gerçekleşen çıkış Filo Çıkış Tarihi alanıdır" /></label>
                <label>Satış KM<input name="aracSatisKm" type="number" min="0" value="@_vehicle.AracSatisKm" /></label>
                <label>Konum<input name="konum" value="@_vehicle.Konum" maxlength="128"
                    title="Fiziksel konum notu — şube alanı ayrıdır" /></label>
                <label class="u-col-full">Açıklama<input name="aciklama" value="@_vehicle.Aciklama" maxlength="1024" /></label>
            </div>
            @* Kur alanları SALT BİLGİDİR: karne/karlılık P&L yalnız defterden hesaplanır. Bunu
               ekranda da söylüyoruz ki kullanıcı "kuru girdim, rapor düzelir" beklemesin. *@
            <p class="muted small" style="margin:.5rem 0 .25rem;"><strong>Kur alanları salt bilgidir</strong> —
                araç karnesi, karlılık ve gelir-gider raporları bu değerleri okumaz (P&amp;L yalnız defterden).</p>
            <div class="grid-form">
                <label>Alım Bedeli Kuru<input name="alimBedeliKur" type="number" step="0.0001" min="0" value="@Inv(_vehicle.AlimBedeliKur)" /></label>
                <label>2. Araç Fiyat Kuru<input name="arac2FiyatKur" type="number" step="0.0001" min="0" value="@Inv(_vehicle.Arac2FiyatKur)" /></label>
                <label>Şimdiki Kur<input name="simdiKur" type="number" step="0.0001" min="0" value="@Inv(_vehicle.SimdiKur)" /></label>
                <label>Aylık Maliyet (Döviz)<input name="aylikMaliyetDoviz" type="number" step="0.01" min="0" value="@Inv(_vehicle.AylikMaliyetDoviz)" /></label>
            </div>

            @* Son 3 KM kaydı SALT OKUNUR: periyodik bakım/km-tespit geçmişi zaten VehicleKmLog'da
               yaşıyor (Dönüş/Servis/Manuel). Buraya yazılabilir alan koymak ikinci bir gerçek
               kaynağı olurdu; giriş tek yerde (araç detayındaki "Manuel KM Gir") kalıyor. *@
            <p class="muted small" style="margin:.5rem 0 .25rem;">Son 3 KM kaydı (salt okunur) —
                tam geçmiş ve manuel giriş için <a href="/araclar/@_vehicle.Id">araç detayı</a>.</p>
            <div class="table-scroll">
                <table class="grid tr-grid">
                    <thead><tr><th>Tarih</th><th class="num">KM</th><th>Kaynak</th></tr></thead>
                    <tbody>
                        @if (_sonKm.Count == 0) { <tr><td colspan="3" class="muted">KM kaydı yok.</td></tr> }
                        @foreach (var k in _sonKm)
                        {
                            <tr>
                                <td>@k.Tarih.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="num">@k.Km.ToString("N0")</td>
                                <td>@(k.Kaynak switch { KmLogKaynak.Donus => "Kira dönüşü", KmLogKaynak.Servis => "Servis çıkışı", _ => "Manuel" })</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>

        <fieldset class="flags">
            <legend>Operasyon Bayrakları</legend>
            <label><input type="checkbox" name="webRezKapat" value="true" checked="@_vehicle.WebRezKapat" /> Web rez. kapalı</label>
            <label><input type="checkbox" name="ofisRezKapat" value="true" checked="@_vehicle.OfisRezKapat" /> Ofis rez. kapalı</label>
            <label><input type="checkbox" name="zIzni" value="true" checked="@_vehicle.ZIzni" /> Z izni</label>
            <label><input type="checkbox" name="utts" value="true" checked="@_vehicle.Utts" /> UTTS</label>
            <label><input type="checkbox" name="karLastigi" value="true" checked="@_vehicle.KarLastigi" /> Kar lastiği</label>
            <label><input type="checkbox" name="yedekAnahtar" value="true" checked="@_vehicle.YedekAnahtar" /> Yedek anahtar</label>
            <label><input type="checkbox" name="temizlik" value="true" checked="@_vehicle.Temizlik" /> Temizlik</label>
            <label><input type="checkbox" name="rehin" value="true" checked="@_vehicle.Rehin" /> Rehin</label>
        </fieldset>
        <button type="submit">Güncelle</button>
        <a href="/vehicles" class="link">İptal</a>
    </form>

    <fieldset>
        <legend>Fotoğraflar</legend>
        <p class="muted small">Fotoğraf işlemleri anında kaydedilir (ana formdaki Kaydet'i beklemez). En fazla 20 fotoğraf, ≤2 MB, PNG/JPEG/WebP.</p>
        <p class="muted small">@_photos.Count/20 fotoğraf</p>
        <div class="photo-grid">
            @for (var i = 0; i < _photos.Count; i++)
            {
                var p = _photos[i];
                <div class="photo-cell">
                    <img src="/vehicles/@Id/photos/@p.Id/thumb" alt="Araç fotoğrafı" />
                    @if (i == 0)
                    {
                        <span class="badge">Kapak</span>
                    }
                    <div class="photo-actions">
                        <form method="post" action="/vehicles/@Id/photos/@p.Id/yukari"><AntiforgeryToken />
                            <button type="submit" disabled="@(i == 0)">↑</button>
                        </form>
                        <form method="post" action="/vehicles/@Id/photos/@p.Id/asagi"><AntiforgeryToken />
                            <button type="submit" disabled="@(i == _photos.Count - 1)">↓</button>
                        </form>
                        <form method="post" action="/vehicles/@Id/photos/@p.Id/sil"><AntiforgeryToken />
                            <button type="submit" class="btn-secondary">Sil</button>
                        </form>
                    </div>
                </div>
            }
        </div>
        <form method="post" action="/vehicles/@Id/photos" enctype="multipart/form-data" class="grid-form"><AntiforgeryToken />
            <label>Fotoğraf yükle (PNG/JPEG/WebP, ≤2 MB)<input name="foto" type="file" accept="image/png,image/jpeg,image/webp" required /></label>
            <button type="submit">Yükle</button>
        </form>
    </fieldset>
}

@code {
    [Parameter] public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "hata")]
    public string? Hata { get; set; }

    private Vehicle? _vehicle;
    private IReadOnlyList<VehicleGroup> _gruplar = [];
    /// <summary>PR-10: aracın hiçbir aktif gruba eşleşmeyen mevcut Grup değeri (varsa) — select'te
    /// korunur ki alakasız bir düzenleme onu silmesin.</summary>
    private string? _grupTanimsiz;
    private IReadOnlyList<VehiclePhotoMeta> _photos = [];
    /// <summary>FAZ-10 — kartın altındaki salt-okunur KM özeti (en yeni 3).</summary>
    private IReadOnlyList<VehicleKmLog> _sonKm = [];
    private List<string> _markaOpts = [], _grupOpts = [], _tipOpts = [], _segmentOpts = [], _renkOpts = [], _subeOpts = [], _yilOpts = [];

    /// <summary>type=number değeri INVARIANT olmalı: tr-TR "1,2500" basıldığında tarayıcı alanı
    /// geçersiz sayıp BOŞALTIR ve kaydetmede değer sessizce null'lanır (FAZ-22 H1 dersi).</summary>
    private static string? Inv(decimal? v) => v?.ToString(System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>
    /// date input prefill'i LOCAL gün olmalı. Bu formdaki tarihler <c>FormParse.Date</c> ile
    /// yazılıyor; o da "2026-04-30"u SUNUCU YERELİNDE çözüp UTC'ye çeviriyor (+03:00 → 29 Nisan
    /// 21:00Z). UtcDateTime basmak bu yüzden her kaydetmede günü BİR GERİ kaydırıyordu (canlı
    /// duman testinde yakalandı: 30 Nisan girildi, 29 Nisan geri geldi). LocalDateTime aynı
    /// dönüşümü tersine çevirir → gün birebir round-trip eder.
    /// </summary>
    private static string? Gun(DateTimeOffset? d) => d?.LocalDateTime.ToString("yyyy-MM-dd");

    // Seç-veya-yaz önerileri: master tanım listesi ∪ mevcut kayıtların distinct'i (VehicleList ile aynı desen).
    private static List<string> Opts(params IEnumerable<string?>[] sources) =>
        sources.SelectMany(s => s).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.CurrentCulture).ToList();

    protected override async Task OnInitializedAsync()
    {
        _vehicle = await Vehicles.GetAsync(Id);
        if (_vehicle is not null)
        {
            _photos = await Fotograflar.ListMetaAsync(Id);
            _sonKm = await Vehicles.KmLoglariAsync(Id, 3);
        }
        var markalar = await Markalar.ListActiveAsync();
        var gruplar = await AracGruplari.ListActiveAsync();
        _gruplar = gruplar;
        _grupTanimsiz = !string.IsNullOrWhiteSpace(_vehicle?.Grup)
            && !gruplar.Any(g => TurkishText.EqualsIgnoreTurkishCase(g.Ad, _vehicle.Grup))
                ? _vehicle!.Grup : null;
        var subeler = await Subeler.ListActiveAsync();
        var renkler = await Renkler.ListActiveAsync();
        var segmentler = await Segmentler.ListActiveAsync();
        var tipler = await AracTipleri.ListActiveAsync();
        var all = await Vehicles.ListAsync();

        _markaOpts = Opts(markalar.Select(m => m.Ad), all.Select(v => v.Marka));
        _grupOpts = Opts(gruplar.Select(g => g.Ad), all.Select(v => v.Grup));
        _tipOpts = Opts(tipler.Select(t => t.Ad), all.Select(v => v.Tip));
        _segmentOpts = Opts(segmentler.Select(s => s.Ad), all.Select(v => v.Segment));
        _renkOpts = Opts(renkler.Select(r => r.Ad), all.Select(v => v.Renk));
        _subeOpts = Opts(subeler.Select(s => s.Ad), all.Select(v => v.Sube));

        var maxYil = DateTimeOffset.UtcNow.Year + 1;
        _yilOpts = Enumerable.Range(maxYil - 30, 31).Select(y => y.ToString()).Reverse().ToList();
    }
}
