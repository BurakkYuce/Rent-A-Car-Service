@page "/vehicles/{Id:guid}"
@attribute [Authorize]
@inject VehicleService Vehicles
@inject BrandService Markalar
@inject VehicleGroupService AracGruplari
@inject BranchService Subeler
@inject VehicleColorService Renkler
@inject VehicleSegmentService Segmentler
@inject VehicleTypeService AracTipleri
@inject NavigationManager Nav
@inject VehiclePhotoService Fotograflar

<PageTitle>Araç Düzenle — RentPro</PageTitle>

@if (_vehicle is null)
{
    <div class="page-head"><h1>Araç Düzenle</h1></div>
    <p class="error">Araç bulunamadı.</p>
    <a href="/vehicles">← Listeye dön</a>
}
else
{
    <div class="page-head">
        <h1>@_vehicle.Plaka — Araç Düzenle</h1>
        <div class="actions">
            <button type="submit" form="veh-form">Kaydet</button>
            <a href="/vehicles">Araç Listesi</a>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(Hata))
    {
        <p class="error">@Hata</p>
    }

    <form id="veh-form" method="post" action="/vehicles/update" class="grid-form"><AntiforgeryToken />
        <input type="hidden" name="id" value="@_vehicle.Id" />
        <label>Plaka<input name="plaka" value="@_vehicle.Plaka" required /></label>
        <ComboBox Name="marka" Label="Marka" Value="@_vehicle.Marka" Options="_markaOpts" />
        @* PR-10: Grup tanımlı gruplardan seçilir. TUZAK: bu aracın mevcut değeri hiçbir gruba
           eşleşmeyen serbest metin olabilir (ör. "FİAT-EGEA-MANUEL-DİZEL"). Katı bir select onu
           listede bulamayıp ALAKASIZ bir düzenlemede sessizce silerdi → mevcut tanımsız değer
           ayrı bir seçenek olarak korunur ve seçili gelir. Toplu düzeltme yeri: Araç Grupları ekranı. *@
        <label>Grup
            <select name="grup">
                <option value="">(Grupsuz)</option>
                @if (_grupTanimsiz is not null)
                {
                    <option value="@_grupTanimsiz" selected>@_grupTanimsiz — tanımsız</option>
                }
                @foreach (var g in _gruplar)
                {
                    <option value="@g.Ad" selected="@(TurkishText.EqualsIgnoreTurkishCase(g.Ad, _vehicle.Grup))">@g.Ad</option>
                }
            </select>
        </label>
        <ComboBox Name="tip" Label="Tip" Value="@_vehicle.Tip" Options="_tipOpts" />
        <ComboBox Name="segment" Label="Segment" Value="@_vehicle.Segment" Options="_segmentOpts" />
        <label>SIPP<input name="sipp" value="@_vehicle.Sipp" maxlength="4" placeholder="CDMD" /></label>
        <ComboBox Name="renk" Label="Renk" Value="@_vehicle.Renk" Options="_renkOpts" />
        <ComboBox Name="modelYili" Label="Model Yılı" Value="@(_vehicle.ModelYili?.ToString())" Options="_yilOpts" />
        <label>Vites
            <select name="vites">
                <option value="">—</option>
                @foreach (var vt in Enum.GetValues<Vites>())
                {
                    <option value="@vt" selected="@(_vehicle.Vites == vt)">@vt</option>
                }
            </select>
        </label>
        <label>Şasi No<input name="sasiNo" value="@_vehicle.SasiNo" /></label>
        <label>Motor No<input name="motorNo" value="@_vehicle.MotorNo" /></label>
        <ComboBox Name="sube" Label="Şube" Value="@_vehicle.Sube" Options="_subeOpts" />
        <label>Durum
            <select name="durum">
                @foreach (var s in Enum.GetValues<VehicleStatus>())
                {
                    <option value="@s" selected="@(s == _vehicle.Durum)">@s</option>
                }
            </select>
        </label>
        <label>Filo Status
            <select name="filoDurum">
                <option value="">—</option>
                @foreach (var fs in Enum.GetValues<FiloStatus>())
                {
                    <option value="@fs" selected="@(_vehicle.FiloDurum == fs)">@fs</option>
                }
            </select>
        </label>
        <label>KM<input name="km" type="number" value="@_vehicle.Km" /></label>
        <label>Yakıt
            <select name="yakit">
                @foreach (var f in Enum.GetValues<FuelType>())
                {
                    <option value="@f" selected="@(f == _vehicle.Yakit)">@f</option>
                }
            </select>
        </label>
        <label>Araç Sahibi<input name="aracSahibi" value="@_vehicle.AracSahibi" /></label>
        <label>Motor Gücü (HP)<input name="motorGucu" type="number" min="0" value="@_vehicle.MotorGucu" /></label>
        <label>Silindir Hacmi (cc)<input name="silindirHacmi" type="number" min="0" value="@_vehicle.SilindirHacmi" /></label>
        <label>Ruhsat No<input name="ruhsatNo" value="@_vehicle.RuhsatNo" /></label>
        <label>Tescil Tarihi<input name="tescilTarihi" type="date" value="@(_vehicle.TescilTarihi?.ToString("yyyy-MM-dd"))" /></label>
        <label>Alım Bedeli<input name="alimBedeli" type="number" step="0.01" min="0" value="@_vehicle.AlimBedeli" /></label>
        <label>Alım Tarihi<input name="alimTarihi" type="date" value="@(_vehicle.AlimTarihi?.ToString("yyyy-MM-dd"))" /></label>
        <label>Alış Vergisiz<input name="alisVergisiz" type="number" step="0.01" min="0" value="@_vehicle.AlisVergisiz" /></label>
        <label>Alış ÖTV<input name="alisOtv" type="number" step="0.01" min="0" value="@_vehicle.AlisOtv" /></label>
        <label>Alış KDV<input name="alisKdv" type="number" step="0.01" min="0" value="@_vehicle.AlisKdv" /></label>
        <label>Aylık Maliyet<input name="aylikMaliyet" type="number" step="0.01" min="0" value="@_vehicle.AylikMaliyet" /></label>
        <label>Filo Yön. Maliyeti<input name="filoYonetimMaliyeti" type="number" step="0.01" min="0" value="@_vehicle.FiloYonetimMaliyeti" /></label>
        <label>2.El Değer<input name="ikinciElDeger" type="number" step="0.01" min="0" value="@_vehicle.IkinciElDeger" /></label>
        <label>Filo Giriş<input name="filoGirisTarih" type="date" value="@(_vehicle.FiloGirisTarih?.ToString("yyyy-MM-dd"))" /></label>
        <label>Filo Çıkış<input name="filoCikisTarih" type="date" value="@(_vehicle.FiloCikisTarih?.ToString("yyyy-MM-dd"))" /></label>
        <label>Özel Kod 1<input name="ozelKod1" value="@_vehicle.OzelKod1" /></label>
        <label>Özel Kod 2<input name="ozelKod2" value="@_vehicle.OzelKod2" /></label>
        <label>Özel Kod 3<input name="ozelKod3" value="@_vehicle.OzelKod3" /></label>
        <label>Özel Kod 4<input name="ozelKod4" value="@_vehicle.OzelKod4" /></label>
        <label>Özel Kod 5<input name="ozelKod5" value="@_vehicle.OzelKod5" /></label>
        <label>HGS No<input name="hgsNo" value="@_vehicle.HgsNo" /></label>
        <label>OGS No<input name="ogsNo" value="@_vehicle.OgsNo" /></label>
        <label>Kasa Tipi<input name="kasaTipi" value="@_vehicle.KasaTipi" /></label>
        <label>Detay Tipi<input name="detayTipi" value="@_vehicle.DetayTipi" placeholder="Sedan/SUV/Van..." /></label>
        <label>Alım Fatura No<input name="alimFaturaNo" value="@_vehicle.AlimFaturaNo" /></label>
        <label>Alım Yapılan Firma<input name="alimYapilanFirma" value="@_vehicle.AlimYapilanFirma" /></label>
        <label>Kira KM Limiti<input name="kiraKmLimiti" type="number" min="0" value="@_vehicle.KiraKmLimiti" /></label>
        <label>Son Bakım Tarihi<input name="sonBakimTarih" type="date" value="@_vehicle.SonBakimTarih?.ToString("yyyy-MM-dd")" /></label>
        <label>Son Bakım KM<input name="sonBakimKm" type="number" min="0" value="@_vehicle.SonBakimKm" /></label>
        <label>Lastik Durumu<input name="lastikDurumu" value="@_vehicle.LastikDurumu" placeholder="Yazlık/Kışlık..." /></label>
        <fieldset class="flags">
            <legend>Operasyon Bayrakları</legend>
            <label><input type="checkbox" name="webRezKapat" value="true" checked="@_vehicle.WebRezKapat" /> Web rez. kapalı</label>
            <label><input type="checkbox" name="ofisRezKapat" value="true" checked="@_vehicle.OfisRezKapat" /> Ofis rez. kapalı</label>
            <label><input type="checkbox" name="zIzni" value="true" checked="@_vehicle.ZIzni" /> Z izni</label>
            <label><input type="checkbox" name="utts" value="true" checked="@_vehicle.Utts" /> UTTS</label>
            <label><input type="checkbox" name="karLastigi" value="true" checked="@_vehicle.KarLastigi" /> Kar lastiği</label>
            <label><input type="checkbox" name="yedekAnahtar" value="true" checked="@_vehicle.YedekAnahtar" /> Yedek anahtar</label>
            <label><input type="checkbox" name="temizlik" value="true" checked="@_vehicle.Temizlik" /> Temizlik</label>
            <label><input type="checkbox" name="rehin" value="true" checked="@_vehicle.Rehin" /> Rehin</label>
        </fieldset>
        <button type="submit">Güncelle</button>
        <a href="/vehicles" class="link">İptal</a>
    </form>

    <fieldset>
        <legend>Fotoğraflar</legend>
        <p class="muted small">Fotoğraf işlemleri anında kaydedilir (ana formdaki Kaydet'i beklemez). En fazla 20 fotoğraf, ≤2 MB, PNG/JPEG/WebP.</p>
        <p class="muted small">@_photos.Count/20 fotoğraf</p>
        <div class="photo-grid">
            @for (var i = 0; i < _photos.Count; i++)
            {
                var p = _photos[i];
                <div class="photo-cell">
                    <img src="/vehicles/@Id/photos/@p.Id/thumb" alt="Araç fotoğrafı" />
                    @if (i == 0)
                    {
                        <span class="badge">Kapak</span>
                    }
                    <div class="photo-actions">
                        <form method="post" action="/vehicles/@Id/photos/@p.Id/yukari"><AntiforgeryToken />
                            <button type="submit" disabled="@(i == 0)">↑</button>
                        </form>
                        <form method="post" action="/vehicles/@Id/photos/@p.Id/asagi"><AntiforgeryToken />
                            <button type="submit" disabled="@(i == _photos.Count - 1)">↓</button>
                        </form>
                        <form method="post" action="/vehicles/@Id/photos/@p.Id/sil"><AntiforgeryToken />
                            <button type="submit" class="btn-secondary">Sil</button>
                        </form>
                    </div>
                </div>
            }
        </div>
        <form method="post" action="/vehicles/@Id/photos" enctype="multipart/form-data" class="grid-form"><AntiforgeryToken />
            <label>Fotoğraf yükle (PNG/JPEG/WebP, ≤2 MB)<input name="foto" type="file" accept="image/png,image/jpeg,image/webp" required /></label>
            <button type="submit">Yükle</button>
        </form>
    </fieldset>
}

@code {
    [Parameter] public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "hata")]
    public string? Hata { get; set; }

    private Vehicle? _vehicle;
    private IReadOnlyList<VehicleGroup> _gruplar = [];
    /// <summary>PR-10: aracın hiçbir aktif gruba eşleşmeyen mevcut Grup değeri (varsa) — select'te
    /// korunur ki alakasız bir düzenleme onu silmesin.</summary>
    private string? _grupTanimsiz;
    private IReadOnlyList<VehiclePhotoMeta> _photos = [];
    private List<string> _markaOpts = [], _grupOpts = [], _tipOpts = [], _segmentOpts = [], _renkOpts = [], _subeOpts = [], _yilOpts = [];

    // Seç-veya-yaz önerileri: master tanım listesi ∪ mevcut kayıtların distinct'i (VehicleList ile aynı desen).
    private static List<string> Opts(params IEnumerable<string?>[] sources) =>
        sources.SelectMany(s => s).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.CurrentCulture).ToList();

    protected override async Task OnInitializedAsync()
    {
        _vehicle = await Vehicles.GetAsync(Id);
        if (_vehicle is not null) _photos = await Fotograflar.ListMetaAsync(Id);
        var markalar = await Markalar.ListActiveAsync();
        var gruplar = await AracGruplari.ListActiveAsync();
        _gruplar = gruplar;
        _grupTanimsiz = !string.IsNullOrWhiteSpace(_vehicle?.Grup)
            && !gruplar.Any(g => TurkishText.EqualsIgnoreTurkishCase(g.Ad, _vehicle.Grup))
                ? _vehicle!.Grup : null;
        var subeler = await Subeler.ListActiveAsync();
        var renkler = await Renkler.ListActiveAsync();
        var segmentler = await Segmentler.ListActiveAsync();
        var tipler = await AracTipleri.ListActiveAsync();
        var all = await Vehicles.ListAsync();

        _markaOpts = Opts(markalar.Select(m => m.Ad), all.Select(v => v.Marka));
        _grupOpts = Opts(gruplar.Select(g => g.Ad), all.Select(v => v.Grup));
        _tipOpts = Opts(tipler.Select(t => t.Ad), all.Select(v => v.Tip));
        _segmentOpts = Opts(segmentler.Select(s => s.Ad), all.Select(v => v.Segment));
        _renkOpts = Opts(renkler.Select(r => r.Ad), all.Select(v => v.Renk));
        _subeOpts = Opts(subeler.Select(s => s.Ad), all.Select(v => v.Sube));

        var maxYil = DateTimeOffset.UtcNow.Year + 1;
        _yilOpts = Enumerable.Range(maxYil - 30, 31).Select(y => y.ToString()).Reverse().ToList();
    }
}
