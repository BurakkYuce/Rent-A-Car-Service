@page "/maliyet-teklifleri"
@attribute [Authorize(Policy = "izin:FinanceWrite")]
@using System.Globalization
@using RentACar.Application.Pricing
@using RentACar.Domain.Enums
@inject CostQuotationService Teklifler
@inject CustomerService Cariler

<PageTitle>Kayıtlı Maliyet Teklifleri — RentPro</PageTitle>

<div class="page-head"><h1>Kayıtlı Maliyet Teklifleri</h1>
    <div class="actions"><a href="/maliyet-hesapla" class="btn-secondary">Yeni Hesap</a></div></div>
<p class="muted small"><strong>Bu ekran deftere yazmaz.</strong> Teklif bir planlama/simülasyon
    belgesidir; gelir-gider, cari bakiye ve araç karnesi rakamlarına HİÇBİR satır eklemez. Gerçek para
    hareketi Kasa/Banka tahsilat-ödeme akışından geçer.</p>
<p class="muted small">Girdi ve sonuç alanları kayıt anındaki hâliyle <strong>saklanır (snapshot)</strong>
    — varsayılanlar sonradan değişse geçmiş teklif kaymaz.</p>

@if (!string.IsNullOrEmpty(Hata)) { <p class="error">@Hata</p> }

<form method="get" class="filter-bar">
    <label>Ara (başlık / no / açıklama)<input name="q" value="@Q" /></label>
    <label>Plaka<input name="plaka" value="@PlakaF" /></label>
    <label>Cari
        <select name="cariF">
            <option value="">— tümü —</option>
            @foreach (var c in _cariler) { <option value="@c.Id" selected="@(c.Id.ToString() == CariF)">@c.DisplayName</option> }
        </select>
    </label>
    <label>Tarih Baş.<input name="min" type="date" value="@Min" /></label>
    <label>Tarih Bit.<input name="max" type="date" value="@Max" /></label>
    <label>Aylık Net ≥<input name="fmin" type="number" step="0.01" value="@FMin" /></label>
    <label>Aylık Net ≤<input name="fmax" type="number" step="0.01" value="@FMax" /></label>
    <button type="submit">Filtrele</button>
    @if (FiltreVar) { <a class="link" href="/maliyet-teklifleri">Temizle</a> }
</form>

@* Özet FİLO toplamıdır (araç-başı × adet) — araç-başı rakamları toplamak farklı adetli
   teklifleri aynı kefeye koyardı. *@
<div class="cards">
    <div class="card"><div class="card-num">@_ozet.Adet</div><div class="card-label">Teklif</div></div>
    <div class="card"><div class="card-num">@_ozet.AracAdet</div><div class="card-label">Toplam Araç</div></div>
    <div class="card"><div class="card-num">@_ozet.FiloAylikNet.ToString("N2")</div><div class="card-label">Filo Aylık Net ₺</div></div>
    <div class="card"><div class="card-num">@_ozet.FiloKdvli.ToString("N2")</div><div class="card-label">Filo KDV'li ₺</div></div>
</div>

<div class="table-scroll">
<table class="grid tr-grid">
    <thead><tr><th>Kayıt No</th><th>Tarih</th><th>Başlık</th><th>Plaka</th><th>Cari</th>
        <th class="num">Alış</th><th class="num">Ay</th><th class="num">Adet</th>
        <th class="num">Başabaş/Ay</th><th class="num">Aylık Net</th><th class="num">KDV'li</th>
        <th class="num">Filo Aylık Net</th><th></th></tr></thead>
    <tbody>
        @if (_list.Count == 0)
        {
            <tr><td colspan="13" class="muted">@(FiltreVar ? "Filtreye uyan teklif yok." : "Kayıt yok.")</td></tr>
        }
        @foreach (var t in _list)
        {
            <tr>
                <td class="mono">@t.KayitNo</td>
                <td>@t.Tarih.LocalDateTime.ToString("dd.MM.yyyy")</td>
                <td>@t.Baslik</td>
                <td class="mono">@(t.Plaka ?? "—")</td>
                <td>@(t.CariId is Guid c ? _cariAd.GetValueOrDefault(c) ?? "—" : "—")</td>
                <td class="num">@t.AlisBedeli.ToString("N2")</td>
                <td class="num">@t.SureAy</td>
                <td class="num">@t.AracSayisi</td>
                <td class="num">@t.BasaBasAylik.ToString("N2")</td>
                <td class="num">@t.TeklifAylikNet.ToString("N2")</td>
                <td class="num">@t.TeklifKdvli.ToString("N2")</td>
                <td class="num">@t.FiloTeklifAylikNet.ToString("N2")</td>
                <td>
                    <a class="link" href="@FormaYukle(t)">Forma Yükle</a>
                    <form method="post" action="/maliyet-teklifi/delete" class="inline" data-confirm="Teklif silinsin mi?"><AntiforgeryToken />
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="link danger">Sil</button>
                    </form>
                </td>
            </tr>
            @if (Detay == t.Id.ToString())
            {
                <tr>
                    <td colspan="13">
                        <strong>Gider kalemleri (kayıtlı girdiden yeniden üretildi)</strong>
                        <div class="table-scroll">
                            <table class="grid tr-grid">
                                <thead><tr><th>Kalem</th><th>Periyot</th><th class="num">Birim</th><th class="num">Dönem</th></tr></thead>
                                <tbody>
                                    @foreach (var k in CostQuotationService.Items(t))
                                    {
                                        <tr><td>@k.Ad</td><td>@k.Periyot</td>
                                            <td class="num">@k.Birim.ToString("N2")</td>
                                            <td class="num">@k.DonemTutar.ToString("N2")</td></tr>
                                    }
                                    <tr><td colspan="3"><strong>Toplam İşletme Gideri (snapshot)</strong></td>
                                        <td class="num"><strong>@t.ToplamGider.ToString("N2")</strong></td></tr>
                                </tbody>
                            </table>
                        </div>
                        <p class="muted small">Kredi hesap şekli: <strong>@t.KrediHesaplamaSekli</strong> ·
                            Enflasyon: @t.EnflasyonOran.ToString("N4") · Kâr marjı: @t.KarMarji.ToString("N4") ·
                            KDV: @t.KdvOran.ToString("N4")</p>
                        <a class="link" href="@Yol()">Kapat</a>
                    </td>
                </tr>
            }
            else
            {
                <tr class="u-hide-print"><td colspan="13"><a class="link" href="@Yol(t.Id)">Kalem dökümünü göster</a></td></tr>
            }
        }
    </tbody>
</table>
</div>

@code {
    [SupplyParameterFromQuery(Name = "hata")] public string? Hata { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "plaka")] public string? PlakaF { get; set; }
    [SupplyParameterFromQuery(Name = "cariF")] public string? CariF { get; set; }
    [SupplyParameterFromQuery(Name = "min")] public string? Min { get; set; }
    [SupplyParameterFromQuery(Name = "max")] public string? Max { get; set; }
    [SupplyParameterFromQuery(Name = "fmin")] public string? FMin { get; set; }
    [SupplyParameterFromQuery(Name = "fmax")] public string? FMax { get; set; }
    [SupplyParameterFromQuery(Name = "detay")] public string? Detay { get; set; }

    private IReadOnlyList<MaliyetTeklifi> _list = [];
    private MaliyetTeklifiOzet _ozet = new(0, 0, 0m, 0m);
    private IReadOnlyList<Customer> _cariler = [];
    private Dictionary<Guid, string> _cariAd = new();

    private bool FiltreVar => !string.IsNullOrWhiteSpace(Q) || !string.IsNullOrWhiteSpace(PlakaF)
        || !string.IsNullOrWhiteSpace(CariF) || !string.IsNullOrWhiteSpace(Min)
        || !string.IsNullOrWhiteSpace(Max) || !string.IsNullOrWhiteSpace(FMin)
        || !string.IsNullOrWhiteSpace(FMax);

    private string Yol(Guid? detay = null)
    {
        var q = new List<string>();
        void Ekle(string ad, string? v) { if (!string.IsNullOrWhiteSpace(v)) q.Add($"{ad}={Uri.EscapeDataString(v)}"); }
        Ekle("q", Q); Ekle("plaka", PlakaF); Ekle("cariF", CariF);
        Ekle("min", Min); Ekle("max", Max); Ekle("fmin", FMin); Ekle("fmax", FMax);
        if (detay is Guid id) q.Add($"detay={id}");
        return "/maliyet-teklifleri" + (q.Count > 0 ? "?" + string.Join("&", q) : "");
    }

    /// <summary>
    /// Kayıtlı teklifi hesap ekranına geri yükler. Sayılar <b>InvariantCulture</b> ile yazılır —
    /// tr-TR virgüllü basılsaydı hesap ekranı değeri okuyamaz ve teklif sessizce sıfırlanırdı.
    /// </summary>
    private static string FormaYukle(MaliyetTeklifi t)
    {
        var g = CostQuotationService.ToInput(t);
        string D(decimal v) => Uri.EscapeDataString(v.ToString(CultureInfo.InvariantCulture));
        var q = new List<string>
        {
            $"alisBedeli={D(g.AlisBedeli)}", $"residual={D(g.ResidualYuzde)}", $"sureAy={g.SureAy}",
            $"faiz={D(g.FaizOran)}", $"kkdf={D(g.KkdfOran)}", $"bsmv={D(g.BsmvOran)}",
            $"damga={D(g.DamgaOran)}", $"aylikGider={D(g.AylikGider)}", $"kar={D(g.KarMarji)}",
            $"kdv={D(g.KdvOran)}", $"kasko={D(g.KaskoYillik)}", $"trafik={D(g.TrafikSigortasiYillik)}",
            $"mtv={D(g.MtvYillik)}", $"bakim={D(g.BakimYillik)}", $"lastik={D(g.LastikYillik)}",
            $"lastikKis={D(g.LastikKisYillik)}", $"takip={D(g.AracTakipYillik)}",
            $"tescil={D(g.TescilPlakaYillik)}", $"muayene={D(g.MuayeneEmisyonYillik)}",
            $"yedek={D(g.YedekAracYillik)}", $"yonetim={D(g.YonetimGideriAylik)}",
            $"dosya={D(g.BankaDosyaDigerMasraf)}", $"enflasyon={D(g.EnflasyonOran)}",
            $"kredi={g.KrediHesaplamaSekli}", $"adet={g.AracSayisi}"
        };
        return "/maliyet-hesapla?" + string.Join("&", q);
    }

    protected override async Task OnInitializedAsync()
    {
        _list = await Teklifler.SearchAsync(new MaliyetTeklifiFilter
        {
            Metin = Q,
            Plaka = PlakaF,
            CariId = Guid.TryParse(CariF, out var c) ? c : null,
            TarihMin = DateTimeOffset.TryParse(Min, CultureInfo.InvariantCulture, out var a)
                ? new DateTimeOffset(a.Date, TimeSpan.Zero) : null,
            // Bitiş günü DAHİL.
            TarihMax = DateTimeOffset.TryParse(Max, CultureInfo.InvariantCulture, out var b)
                ? new DateTimeOffset(b.Date, TimeSpan.Zero).AddDays(1).AddTicks(-1) : null,
            FiyatMin = decimal.TryParse(FMin, NumberStyles.Number, CultureInfo.InvariantCulture, out var f1) ? f1 : null,
            FiyatMax = decimal.TryParse(FMax, NumberStyles.Number, CultureInfo.InvariantCulture, out var f2) ? f2 : null
        });
        _ozet = CostQuotationService.Summary(_list);
        _cariler = await Cariler.ListAsync();
        _cariAd = _cariler.ToDictionary(x => x.Id, x => x.DisplayName);
    }
}
