@inherits LayoutComponentBase

@* Platform operatörü kabuğu — tenant sidebar'ı YOK (tenant modüllerinden tamamen ayrı). *@
<div class="platform-shell">
    <header class="platform-top">
        <span class="platform-brand">RentPro · <b>Platform</b></span>
        @* PR-B: konsol ikinci bir sayfa kazandı → gezinme linkleri (öncesinde tek sayfa vardı). *@
        <AuthorizeView Policy="PlatformAdmin" Context="navCtx">
            <nav class="platform-nav" style="display:flex;gap:1rem;margin-left:1.5rem">
                <a href="/platform/tenants">Firmalar</a>
                <a href="/platform/belgeler">Belge Merkezi</a>
            </nav>
        </AuthorizeView>
        <span class="spacer"></span>
        <AuthorizeView Policy="PlatformAdmin">
            <span class="platform-user">@context.User.Identity?.Name</span>
            <form method="post" action="/platform/auth/logout" style="margin:0"><AntiforgeryToken />
                <button type="submit" class="link">Çıkış</button>
            </form>
        </AuthorizeView>
    </header>
    <main class="platform-body">
        @Body
    </main>
</div>
