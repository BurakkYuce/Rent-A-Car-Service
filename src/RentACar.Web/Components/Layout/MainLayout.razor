                        </details>
                        <details class="nav-group" open="@Acik("/markalar","/arac-gruplari","/ceza-turleri","/kdv-oranlari","/lokasyonlar","/yakit-turleri","/vites-turleri","/renkler","/musteri-gruplari","/sigorta-sirketleri","/bankalar","/departmanlar","/odeme-tipleri","/ulkeler","/aksesuarlar","/iptal-sebepleri","/rezervasyon-kaynaklari","/gider-turleri","/hesaplar","/ozel-kodlar","/dovizler","/hesap-kodlari","/drop-tanimlari")">
                            <summary><span class="ic"></span> Tanımlar <span class="chev"></span></summary>
                            <div class="sub">
                                <a href="/markalar">Markalar</a>
                                <a href="/arac-gruplari">Araç Grupları</a>
                                <a href="/arac-tipleri">Araç Tipleri</a>
                                <a href="/lokasyonlar">Lokasyonlar</a>
                                <a href="/yakit-turleri">Yakıt Türleri</a>
                                <a href="/vites-turleri">Vites Türleri</a>
                                <a href="/renkler">Renkler</a>
                                <a href="/segmentler">Segmentler</a>
                                <a href="/musteri-gruplari">Müşteri Grupları</a>
                                <a href="/sigorta-sirketleri">Sigorta Şirketleri</a>
                                <a href="/bankalar">Bankalar</a>
                                <a href="/departmanlar">Departmanlar</a>
                                <a href="/odeme-tipleri">Ödeme Tipleri</a>
                                <a href="/ulkeler">Ülkeler</a>
                                <a href="/aksesuarlar">Aksesuarlar</a>
                                <a href="/iptal-sebepleri">İptal Sebepleri</a>
