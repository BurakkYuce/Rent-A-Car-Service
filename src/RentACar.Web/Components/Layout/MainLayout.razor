                        </details>
                        <details class="nav-group" open="@Acik("/tarifeler","/tarife-matris","/sigorta-urunleri","/kira-kurallari","/broker-yasaklari","/fiyat-hesapla","/maliyet-hesapla","/ek-hizmetler")">
                            <summary><span class="ic"></span> Fiyat & Tarife <span class="chev"></span></summary>
                            <div class="sub">
