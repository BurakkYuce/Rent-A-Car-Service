@inherits LayoutComponentBase
@inject RentACar.Application.Notifications.BildirimService Bildirimler
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        <div class="app">
            <aside class="sidebar">
                <div class="sb-brand">
                    <span class="logo">RP</span>
                    <a class="name" href="/">RentPro</a>
                    <span class="badge-user">@context.User.Identity?.Name?.ToUpperInvariant()</span>
                </div>

                <form method="get" action="/ara" class="sb-search">
