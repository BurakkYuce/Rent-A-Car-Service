                    </AuthorizeView>

                    @* ---- Raporlar ---- *@
                    <AuthorizeView Roles="Admin,Yonetici,Muhasebe" Context="repCtx">
                        <details class="nav-group" open="@Acik("/raporlar")">
                            <summary><span class="ic"></span> Raporlar <span class="chev"></span></summary>
                            <div class="sub">
