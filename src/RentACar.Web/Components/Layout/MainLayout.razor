                            <div class="sub">
                                <a href="/vehicles">Araç Listesi</a>
                                <a href="/arac-durum">Araç Durum</a>
                                <a href="/arac-siparis">Araç Sipariş</a>
                                <a href="/arac-kredi">Araç Kredisi</a>
                                <a href="/baf">BAF (Tahsis)</a>
                                <a href="/hasar">Hasar</a>
                                <a href="/arac-tipleri">Araç Tipleri</a>
                                <a href="/arac-sahipleri">Araç Sahipleri</a>
