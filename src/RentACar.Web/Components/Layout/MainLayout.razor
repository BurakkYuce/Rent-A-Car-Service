@inherits LayoutComponentBase
@inject RentACar.Application.Notifications.InAppNotificationService Bildirimler
@inject NavigationManager Nav
@inject RentACar.Domain.Common.ITenantContext Tenant
@inject RentACar.Infrastructure.Persistence.TenantStatusCache TenantDurum
@inject RentACar.Application.PublicSite.PublicBookingRequestService Talepler
@* FAZ-81: renk kodları hassas olmayan bir ayar → admin-gate'li TenantSettingsService yerine
   repo DOĞRUDAN okunur (KdvVarsayilan/VarsayilanGrupCozucu ile aynı desen). Layout HER rolde
   render olduğu için ManageUsers guard'ına çarpmamalı. *@
@inject RentACar.Application.TenantSettings.ITenantSettingsRepository AyarRepo

@* Tenant renk kodları CSS özel değişkeni olarak basılır; CSS tarafı var(--x, eski-sabit) ile
   okuduğu için renk seçilmemişse görünüm DEĞİŞMEZ. Değerler servis katmanında #rrggbb olarak
   doğrulanıyor (serbest metin CSS'e sızamaz). *@
@if (_colors.Length > 0)
{
    <style>:root { @((MarkupString)_colors) }</style>
}

<AuthorizeView>
    <Authorized>
        <div class="app">
            <aside class="sidebar" id="sb-menu">
                <div class="sb-brand">
                    <span class="logo">RP</span>
                    <a class="name" href="/">RentPro</a>
                    <span class="badge-user">@context.User.Identity?.Name?.ToUpperInvariant()</span>
                </div>

                <form method="get" action="/ara" class="sb-search">
                    <input name="q" placeholder="Evrak No / Plaka ara…" />
                </form>

                @* F4.6: menü KAYITTAN çizilir (Api/Menu/MenuKaydi.cs — yeni arayüzle TEK kaynak). Görünürlük
                   ROLDEN değil ETKİN İZİNDEN (MenuApi.Gorunur: rol matrisi + kullanıcı-bazlı ek/yasak) ve modül
                   bayrağından. KASITLI davranış değişikliği (F4.6 PR'ındaki önce/sonra tablosu): açılamayacak öğe
                   gösterilmez, kullanıcıya verilmiş ek izin menüye yansır. `spa` öğeleri pilot firmada yeni
                   arayüzü (/app) açar, pilot olmayanda Blazor karşılığını (IlkKesis.BlazorKarsiligi). *@
                @if (_menu.Hizli.Count > 0)
                {
                    <div class="sb-quick">
                        @foreach (var o in _menu.Hizli)
                        {
                            <a href="@Address(o)" data-enhance-nav="@EnhanceNav(o)"><span class="ic"></span> @o.Etiket</a>
                        }
                    </div>
                }

                <nav class="sb-nav">
                    @foreach (var block in _menu.Bloklar)
                    {
                        if (block.Grup.Length == 0)
                        {
                            var o = block.Ogeler[0];
                            <a class="nav-solo" href="@Address(o)" data-enhance-nav="@EnhanceNav(o)" style="display:flex;align-items:center;gap:.4rem;padding:.6rem 1rem;color:var(--tr-sidebar-tx);text-decoration:none;">
                                <span class="ic" style="width:1.2rem;display:inline-block;text-align:center;"></span> @o.Etiket
                                @if (Badge(o) is > 0 and var n) { <span class="badge-unread">@n</span> }
                            </a>
                        }
                        else
                        {
                            <details class="nav-group" open="@IsGroupOpen(block)">
                                <summary><span class="ic"></span> @block.Grup <span class="chev"></span></summary>
                                <div class="sub">
                                    @foreach (var o in block.Ogeler)
                                    {
                                        <a href="@Address(o)" data-enhance-nav="@EnhanceNav(o)">@o.Etiket @if (Badge(o) is > 0 and var n) { <span class="badge warn">@n</span> }</a>
                                    }
                                </div>
                            </details>
                        }
                    }
                </nav>
            </aside>

            @* Çekmece perdesi: açıkken arka planı karartır ve dışına dokununca kapatır.
               `hidden` ile başlar — JS yoksa hiç görünmez ve sayfa bugünkü gibi çalışır. *@
            <div class="menu-perde" data-menu-kapat hidden></div>

            <div class="main">
                <header class="topbar">
                    @* Çekmece açma düğmesi — YALNIZ mobilde görünür (CSS). Statik SSR olduğu için
                       davranış harici js/rc-ui.js'te data-* delegasyonuyla; inline onclick CSP'ye
                       (script-src 'self') takılırdı. *@
                    <button type="button" class="menu-btn" data-menu-ac
                            aria-label="Menüyü aç" aria-expanded="false" aria-controls="sb-menu">
                        <span class="menu-cizgi" aria-hidden="true"></span>
                    </button>
                    <form method="get" action="/ara" class="tb-search">
                        <span></span>
                        <input name="q" placeholder="Hızlı Arama — Müşteri, Plaka, RA No, TC…" />
                        <span class="kbd">Ctrl + K</span>
                        <button type="submit" aria-label="Ara">→</button>
                    </form>
                    <span class="spacer"></span>
                    <span class="user">
                        @context.User.Identity?.Name
                        <span class="muted">@context.User.FindFirst("tenant_code")?.Value</span>
                    </span>
                    <button type="button" class="link theme-toggle" data-theme-toggle aria-label="Tema değiştir" title="Açık/Koyu tema geçişi">
                        <span data-theme-label>Koyu</span>
                    </button>
                    @* FAZ-83: her rol kendi parolasını değiştirebilir (admin gerekmez). *@
                    <a class="link" href="/profil/sifre-degistir" title="Kendi parolanızı değiştirin">Şifre</a>
                    <form method="post" action="/auth/logout" class="logout-form"><AntiforgeryToken />
                        <button type="submit" class="link">Çıkış</button>
                    </form>
                </header>

                <main class="content">
                    @Body
                </main>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <main class="content">
            @Body
        </main>
    </NotAuthorized>
</AuthorizeView>

@* İŞLEM SONUCU ŞERİDİ — `?bilgi=` ile gelen başarı mesajı (bkz. Common/Sonuc.cs).
   AuthorizeView'in DIŞINDA: hem girişli hem girişsiz akışlarda görünür.
   `position: fixed` (app.css) → sayfa akışına yükseklik EKLEMEZ; aksi halde her POST sonrası
   içerik bir şerit kadar aşağı kayardı. rc-bildirim.js 5 sn sonra kapatır ve `bilgi`
   parametresini URL'den düşürür (F5'te mesaj tekrar çıkmasın). *@
@if (_info is not null)
{
    <div id="rc-bildirim" class="ok" role="status" aria-live="polite" data-rc-bildirim>@_info</div>
}

<div id="blazor-error-ui" data-nosnippet>
    Beklenmeyen bir hata oluştu.
    @* Göreli nokta-href DEĞİL: `<base href="/">` yüzünden köke çözülüyordu → "Yenile"
       kullanıcıyı bulunduğu sayfadan ana ekrana atıyordu. Buton + rc-ui.js reload(). *@
    <button type="button" class="reload" data-rc-reload>Yenile</button>
    <span class="dismiss"></span>
</div>

@code {
    /// <summary>":root" içine basılacak --tr-renk-* bildirimleri (boşsa hiç style basılmaz).</summary>
    private string _colors = string.Empty;

    private int _unread;
    private string _path = "";
    /// <summary>`?bilgi=` ile taşınan işlem-sonucu mesajı (yoksa şerit hiç render edilmez).</summary>
    private string? _info;
    private bool _websiteModule; // PR-12
    private int _newRequests;        // PR-17 cevaplanmamış site talebi sayacı
    private bool _pilot;           // F4.6: yeni arayüz pilotu (spa menü öğeleri /app'i açar)
    private MenuGorunumu _menu = MenuGorunumu.Empty;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Görünür menü: hızlı bağlantılar + (grup | tekil öğe) blokları, kayıt sırasıyla (SPA menü modeliyle aynı kural).</summary>
    private sealed record MenuBlogu(string Grup, List<RentACar.Web.Api.Menu.MenuOgesi> Ogeler);
    private sealed record MenuGorunumu(IReadOnlyList<RentACar.Web.Api.Menu.MenuOgesi> Hizli, IReadOnlyList<MenuBlogu> Bloklar)
    {
        public static readonly MenuGorunumu Empty = new([], []);

        public static MenuGorunumu Setup(IEnumerable<RentACar.Web.Api.Menu.MenuOgesi> visible)
        {
            var sorted = visible.OrderBy(o => o.Sira).ToList();
            var blocks = new List<MenuBlogu>();
            var groups = new Dictionary<string, MenuBlogu>(StringComparer.Ordinal);
            foreach (var o in sorted.Where(o => !o.HizliBaglanti))
            {
                if (o.Grup.Length == 0) { blocks.Add(new MenuBlogu("", [o])); continue; }
                if (!groups.TryGetValue(o.Grup, out var g))
                {
                    g = new MenuBlogu(o.Grup, []);
                    groups[o.Grup] = g;
                    blocks.Add(g);
                }
                g.Ogeler.Add(o);
            }
            return new MenuGorunumu(sorted.Where(o => o.HizliBaglanti).ToList(), blocks);
        }
    }

    /// <summary>Öğenin açacağı adres: `spa` öğesi pilot firmada /app rotası, pilot olmayanda Blazor karşılığı.</summary>
    private string Address(RentACar.Web.Api.Menu.MenuOgesi o)
        => o.Sahip == RentACar.Web.Api.Menu.MenuRegistry.Spa && !_pilot
            ? RentACar.Web.Spa.Cutover.BlazorEquivalent(o.Rota) ?? o.Rota
            : o.Rota;

    /// <summary>/app bağlantısı Blazor enhanced navigation'a girmez (tam sayfa geçiş; SPA kendi kabuğunu yükler).</summary>
    private string? EnhanceNav(RentACar.Web.Api.Menu.MenuOgesi o)
        => RentACar.Web.Spa.Cutover.IsSpaPath(Address(o)) ? "false" : null;

    private int Badge(RentACar.Web.Api.Menu.MenuOgesi o) => o.RozetKodu switch
    {
        RentACar.Web.Api.Menu.MenuRegistry.BadgeUnreadNotification => _unread,
        RentACar.Web.Api.Menu.MenuRegistry.BadgeNewRequest => _newRequests,
        _ => 0,
    };

    /// <summary>Grup, mevcut sayfa öğelerinden birinin altındaysa AÇIK (Raporlar: tüm /raporlar/* — drill-down dahil).</summary>
    private bool IsGroupOpen(MenuBlogu block)
        => IsOpen(block.Ogeler.Select(Address).Concat(block.Grup == "Raporlar" ? new[] { "/raporlar" } : Array.Empty<string>()).ToArray());

    protected override async Task OnInitializedAsync()
    {
        _path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');

        // TUZAK: Layout routable DEĞİL → [SupplyParameterFromQuery] burada ÇALIŞMAZ.
        // Query, NavigationManager'ın URI'sinden okunur. try/catch: layout hiçbir koşulda düşmemeli.
        try
        {
            var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
            if (q.TryGetValue("bilgi", out var v))
            {
                var m = v.ToString();
                if (!string.IsNullOrWhiteSpace(m)) _info = m.Length > 300 ? m[..300] : m;
            }
        }
        catch { _info = null; }
        try { _unread = await Bildirimler.UnreadCountAsync(); }
        catch { _unread = 0; }
        // 60 sn cache'li tek okuma; platformdan açılınca en geç o kadar sonra menüde belirir.
        try { _websiteModule = Tenant.TenantId is { } id && await TenantDurum.WebsiteModuleAsync(id); }
        catch { _websiteModule = false; } // menü hiçbir koşulda sayfayı düşürmemeli
        // PR-17: yalnız modül açıkken sorulur (kapalıysa menü de yok). Yetkisiz rolde guard atar →
        // sayaç 0 gösterilir; menü hiçbir koşulda sayfayı düşürmemeli.
        if (_websiteModule)
        {
            try { _newRequests = (await Talepler.SummaryAsync()).Yeni; }
            catch { _newRequests = 0; }
        }

        // FAZ-81: tenant renk kodları. Hata hiçbir koşulda layout'u düşürmemeli → boş bırakılır,
        // CSS fallback zinciri eski sabit renkleri kullanır. F4.6: aynı satırdan pilot bayrağı (menü adresleri).
        try
        {
            var setting = Tenant.TenantId is null ? null : await AyarRepo.GetAsync();
            _colors = ColorNotifications(setting);
            _pilot = setting?.YeniArayuzPilot == true;
        }
        catch { _colors = ""; _pilot = false; }

        // F4.6: menü kayıttan, etkin izne + modüle göre (yeni arayüzün GET /api/ui/v1/menu'süyle AYNI süzgeç).
        try
        {
            var user = AuthState is null ? null : (await AuthState).User;
            _menu = user?.Identity?.IsAuthenticated == true
                ? MenuGorunumu.Setup(RentACar.Web.Api.Menu.MenuApi.Visible(user, _websiteModule))
                : MenuGorunumu.Empty;
        }
        catch { _menu = MenuGorunumu.Empty; }
    }

    /// <summary>
    /// Ayarlardaki renk kodlarını CSS özel değişkeni bildirimlerine çevirir. Seçilmemiş (null) renk
    /// için HİÇ bildirim basılmaz — böylece CSS'teki var(--x, eski-sabit) fallback'i devreye girer
    /// ve renk seçmemiş tenant'ta görünüm birebir korunur.
    ///
    /// <para>"-soft" varyantı arka plan için: seçilen renk %12 opaklıkla yüzeye harmanlanır
    /// (status-pill'lerdeki color-mix deseniyle aynı).</para>
    ///
    /// <para>Değerler servis katmanında <c>#rrggbb</c> olarak DOĞRULANIYOR; burada ikinci bir
    /// savunma olarak biçim yeniden sınanır — bu metin doğrudan &lt;style&gt; içine yazılıyor.</para>
    /// </summary>
    private static string ColorNotifications(RentACar.Domain.Entities.TenantSettings? a)
    {
        if (a is null) return "";
        var sb = new System.Text.StringBuilder();
        void Add(string name, string? renk)
        {
            if (renk is null || !System.Text.RegularExpressions.Regex.IsMatch(renk, "^#[0-9a-fA-F]{6}$")) return;
            sb.Append("--tr-renk-").Append(name).Append(':').Append(renk).Append(';');
            sb.Append("--tr-renk-").Append(name).Append("-soft:color-mix(in srgb,")
              .Append(renk).Append(" 12%, var(--surface));");
            // Rengin ZEMİN olarak kullanıldığı yerde (acil "Gecikmiş" çipi) üstüne yazılacak metin:
            // sabit beyaz, açık renk seçen tenant'ta okunmuyordu (RenkKontrast).
            if (ColorContrast.TextOn(renk) is { } onTop)
                sb.Append("--tr-renk-").Append(name).Append("-on:").Append(onTop).Append(';');
        }
        Add("gecikenler", a.RenkGecikenler);
        Add("bugun-donecekler", a.RenkBugunDonecekler);
        Add("bugun-cikacaklar", a.RenkBugunCikacaklar);
        Add("opsiyonlu", a.RenkOpsiyonlu);
        Add("limit-bakiye", a.RenkLimitBakiye);
        Add("alacakli", a.RenkAlacakli);
        Add("rez-atanan-plaka", a.RenkRezAtananPlaka);
        Add("kiralanmayan", a.RenkKiralanmayan);
        return sb.ToString();
    }

    // Mevcut sayfa bu modülün altındaysa grubu AÇIK render et (JS'siz oryantasyon).
    private bool IsOpen(params string[] prefixes)
        => prefixes.Any(p => _path == p || _path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase));
}
