                                <a href="/raporlar/km-detay">KM Detay</a>
                                <a href="/raporlar/rezervasyon-kaynak">Rezervasyon Kaynak</a>
                                <a href="/raporlar/fatura-donem">Fatura Dönem</a>
                                <a href="/raporlar/arac-durum-takip">Araç Durum Takip</a>
                            </div>
                        </details>
                    </AuthorizeView>

                    @* ---- Vade + Bildirim (tüm roller) ---- *@
                    <a class="nav-solo" href="/vade" style="display:block;padding:.6rem 1rem;color:var(--tr-sidebar-tx);text-decoration:none;">
                        <span class="ic" style="width:1.2rem;display:inline-block;text-align:center;"></span> Vade Panosu
                    </a>
                    <a class="nav-solo" href="/bildirimler" style="display:flex;align-items:center;gap:.4rem;padding:.6rem 1rem;color:var(--tr-sidebar-tx);text-decoration:none;">
                        <span class="ic" style="width:1.2rem;display:inline-block;text-align:center;"></span> Bildirimler
                        @if (_okunmamis > 0) { <span class="badge-unread">@_okunmamis</span> }
                    </a>
                    <a class="nav-solo" href="/takvim-abonelik" style="display:flex;align-items:center;gap:.4rem;padding:.6rem 1rem;color:var(--tr-sidebar-tx);text-decoration:none;">
                        <span class="ic" style="width:1.2rem;display:inline-block;text-align:center;"></span> Takvim Aboneliği
                    </a>

                    @* ---- Sistem (yalnız Admin) ---- *@
                    <AuthorizeView Roles="Admin" Context="adminCtx">
                        <details class="nav-group" open="@Acik("/subeler","/kullanicilar","/personel","/ayarlar","/yetki","/denetim","/ice-aktar")">
                            <summary><span class="ic"></span> Sistem <span class="chev"></span></summary>
                            <div class="sub">
                                <a href="/subeler">Şubeler</a>
                                <a href="/kullanicilar">Kullanıcılar</a>
                                <a href="/personel">Personel</a>
                                <a href="/ayarlar">Ayarlar</a>
                                <a href="/yetki">Ekran Yetkileri</a>
                                <a href="/denetim">Denetim</a>
                                <a href="/ice-aktar">Veri İçe Aktar</a>
                            </div>
                        </details>
                    </AuthorizeView>
                </nav>
            </aside>

            <div class="main">
                <header class="topbar">
                    <form method="get" action="/ara" class="tb-search">
                        <span></span>
                        <input name="q" placeholder="Hızlı Arama — Müşteri, Plaka, RA No, TC…" />
                        <span class="kbd">Ctrl + K</span>
                        <button type="submit" aria-label="Ara">→</button>
                    </form>
                    <span class="spacer"></span>
                    <span class="user">
                        @context.User.Identity?.Name
                        <span class="muted">@context.User.FindFirst("tenant_code")?.Value</span>
                    </span>
                    <form method="post" action="/auth/logout" class="logout-form"><AntiforgeryToken />
                        <button type="submit" class="link">Çıkış</button>
                    </form>
                </header>

                <main class="content">
                    @Body
                </main>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <main class="content">
            @Body
        </main>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    Beklenmeyen bir hata oluştu.
    <a href="." class="reload">Yenile</a>
    <span class="dismiss"></span>
</div>

@code {
    private int _okunmamis;
    private string _path = "";

    protected override async Task OnInitializedAsync()
    {
        _path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        try { _okunmamis = await Bildirimler.UnreadCountAsync(); }
        catch { _okunmamis = 0; }
    }

    // Mevcut sayfa bu modülün altındaysa grubu AÇIK render et (JS'siz oryantasyon).
    private bool Acik(params string[] prefixler)
        => prefixler.Any(p => _path == p || _path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase));
}
