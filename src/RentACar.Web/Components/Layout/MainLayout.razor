                            </div>
                        </details>
                        <details class="nav-group" open="@Acik("/cariler","/crm","/sikayetler","/hukuk","/anketler")">
                            <summary><span class="ic"></span> Cariler & CRM <span class="chev"></span></summary>
                            <div class="sub">
                                <a href="/cariler">Cariler</a>
                                <a href="/crm">CRM Analiz</a>
                                <a href="/sikayetler">Şikayetler</a>
                                <a href="/hukuk">Hukuk</a>
                                <a href="/anketler">Anketler</a>
                            </div>
                        </details>
                        <details class="nav-group" open="@Acik("/servisler","/servis-tanimlari","/regulasyon")">
