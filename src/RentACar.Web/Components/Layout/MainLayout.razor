                            <div class="sub">
                                <a href="/kasa">Kasa / Banka</a>
                                <a href="/kurlar">Döviz Kurları</a>
                                <a href="/faturalar">Faturalar</a>
                                <a href="/gelen-efatura">Gelen e-Fatura</a>
                                <a href="/giderler">Giderler</a>
                                <a href="/satislar">Satışlar</a>
                                <a href="/cari-virman">Cari Virman</a>
                                <a href="/depozito">Depozito</a>
                                <a href="/toplu-tahsilat">Toplu Tahsilat</a>
                                <a href="/toplu-gider">Toplu Gider</a>
                                <a href="/cezalar">Cezalar</a>
