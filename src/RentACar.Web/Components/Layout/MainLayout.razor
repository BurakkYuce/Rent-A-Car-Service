            <div class="main">
                <header class="topbar">
                    <form method="get" action="/ara" class="tb-search">
                        <span></span>
                        <input name="q" placeholder="Hızlı Arama — Müşteri, Plaka, RA No, TC…" />
                        <span class="kbd">Ctrl + K</span>
                        <button type="submit" aria-label="Ara">→</button>
                    </form>
                    <span class="spacer"></span>
                    <span class="user">
                        @context.User.Identity?.Name
                        <span class="muted">@context.User.FindFirst("tenant_code")?.Value</span>
                    </span>
                    <button type="button" class="link theme-toggle" data-theme-toggle aria-label="Tema değiştir" title="Açık/Koyu tema geçişi">
                        <span data-theme-label>Koyu</span>
                    </button>
                    @* FAZ-83: her rol kendi parolasını değiştirebilir (admin gerekmez). *@
                    <a class="link" href="/profil/sifre-degistir" title="Kendi parolanızı değiştirin">Şifre</a>
                    <form method="post" action="/auth/logout" class="logout-form"><AntiforgeryToken />
                        <button type="submit" class="link">Çıkış</button>
                    </form>
                </header>

                <main class="content">
                    @Body
                </main>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <main class="content">
            @Body
        </main>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    Beklenmeyen bir hata oluştu.
    <a href="." class="reload">Yenile</a>
    <span class="dismiss"></span>
</div>

@code {
    private int _okunmamis;
    private string _path = "";
    private bool _webSitesiModulu; // PR-12
    private int _yeniTalep;        // PR-17 cevaplanmamış site talebi sayacı

    protected override async Task OnInitializedAsync()
    {
        _path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        try { _okunmamis = await Bildirimler.UnreadCountAsync(); }
        catch { _okunmamis = 0; }
        // 60 sn cache'li tek okuma; platformdan açılınca en geç o kadar sonra menüde belirir.
        try { _webSitesiModulu = Tenant.TenantId is { } id && await TenantDurum.WebSitesiModuluAsync(id); }
        catch { _webSitesiModulu = false; } // menü hiçbir koşulda sayfayı düşürmemeli
        // PR-17: yalnız modül açıkken sorulur (kapalıysa menü de yok). Yetkisiz rolde guard atar →
        // sayaç 0 gösterilir; menü hiçbir koşulda sayfayı düşürmemeli.
        if (_webSitesiModulu)
        {
            try { _yeniTalep = (await Talepler.OzetAsync()).Yeni; }
            catch { _yeniTalep = 0; }
        }
    }

    // Mevcut sayfa bu modülün altındaysa grubu AÇIK render et (JS'siz oryantasyon).
    private bool Acik(params string[] prefixler)
        => prefixler.Any(p => _path == p || _path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase));
}
