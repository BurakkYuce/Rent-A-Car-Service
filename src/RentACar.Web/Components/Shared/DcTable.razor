@* Dashboard Dönüşler/Çıkışlar tablosu. Href verilen satırda Plaka linke dönüşür; Islem fragment'ı
   verilirse (yalnız Dönüşler + finans-yetkili) 5. "İşlem" kolonu render edilir. *@
<div class="dc-table-wrap">
    <table class="dc-table">
        <thead>
            <tr><th>Tarih / Saat</th><th>Ad Soyad</th><th>Plaka</th><th>Şube</th>@if (Islem is not null) { <th>İşlem</th> }</tr>
        </thead>
        <tbody>
            @if (Rows.Count == 0)
            {
                <tr><td colspan="@(Islem is null ? 4 : 5)" class="muted">@Empty</td></tr>
            }
            @foreach (var r in Rows)
            {
                <tr style="@RowStyle">
                    <td>@r.Tar.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@r.Ad</td>
                    <td class="mono">
                        @if (r.Href is not null) { <a href="@r.Href">@r.Plaka</a> }
                        else { @r.Plaka }
                    </td>
                    <td>@r.Sube</td>
                    @if (Islem is not null) { <td class="row-actions">@Islem(r)</td> }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public IReadOnlyList<DcRow> Rows { get; set; } = [];
    [Parameter] public string Empty { get; set; } = "Kayıt yok.";
    [Parameter] public RenderFragment<DcRow>? Islem { get; set; }
    /// <summary>FAZ-81 — satıra uygulanacak satır-içi stil (tenant renk kodu vurgusu). Boş → vurgu yok.</summary>
    [Parameter] public string? RowStyle { get; set; }
}
