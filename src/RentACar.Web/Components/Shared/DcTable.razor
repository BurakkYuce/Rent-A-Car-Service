@* Dashboard Dönüşler/Çıkışlar tablosu. *@
<div class="dc-table-wrap">
    <table class="dc-table">
        <thead>
            <tr><th>Tarih / Saat</th><th>Ad Soyad</th><th>Plaka</th><th>Şube</th></tr>
        </thead>
        <tbody>
            @if (Rows.Count == 0)
            {
                <tr><td colspan="4" class="muted">@Empty</td></tr>
            }
            @foreach (var r in Rows)
            {
                <tr>
                    <td>@r.Tar.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@r.Ad</td>
                    <td class="mono">@r.Plaka</td>
                    <td>@r.Sube</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public IReadOnlyList<DcRow> Rows { get; set; } = [];
    [Parameter] public string Empty { get; set; } = "Kayıt yok.";
}
