@* Seç-veya-yaz alanı (pick-or-type): native <input list> + <datalist>. Static-SSR uyumlu (JS/circuit YOK) —
   form POST'una input'un değeri (YAZILAN veya SEÇİLEN) gider; tanımlı listeden öneri + serbest metin, arama-çubuğu
   gibi yazdıkça filtreler. Kullanım: <ComboBox Name="renk" Label="Renk" Value="@v.Renk" Options="_renkOpts" />.
   Extra ile required/maxlength vb. geçilir. Enum alanlarında KULLANMA (serbest metin enum'a parse olmaz → <select>). *@
<label>
    @Label
    <input name="@Name" value="@Value" list="@ResolvedListId" placeholder="@Placeholder"
           autocomplete="off" @attributes="Extra" />
</label>
<datalist id="@ResolvedListId">
    @foreach (var o in SafeOptions.Where(o => !string.IsNullOrWhiteSpace(o)).Distinct(StringComparer.OrdinalIgnoreCase))
    {
        <option value="@o"></option>
    }
</datalist>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = default!;
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public IEnumerable<string?>? Options { get; set; }
    [Parameter] public string? Placeholder { get; set; } = "Seç veya yaz";
    [Parameter] public string? ListId { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Extra { get; set; }

    private IEnumerable<string?> SafeOptions => Options ?? [];
    private string ResolvedListId => ListId ?? $"dl-{Name}";
}
