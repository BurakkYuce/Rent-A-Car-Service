@using RentACar.Domain.Enums

@* Araç durumu rozeti — TEK merkezî durum→renk eşlemesi (her ekranda aynı). Radzen'den arındırıldı:
   saf CSS .status-pill (renkli nokta + METİN → a11y: yalnız renge dayanmaz). Statik SSR uyumlu. *@
<span class="status-pill @Cls(Durum)">@Metin(Durum)</span>

@code {
    [Parameter, EditorRequired] public VehicleStatus Durum { get; set; }

    /// <summary>Durum → pill varyant sınıfı (kirada/boş/servis/satıldı her yerde aynı renk).</summary>
    public static string Cls(VehicleStatus s) => s switch
    {
        VehicleStatus.Musait => "sp-success",   // boşta / kiraya hazır
        VehicleStatus.Kirada => "sp-info",      // kirada
        VehicleStatus.Serviste => "sp-warn",    // serviste
        VehicleStatus.Satildi => "sp-dim",      // satıldı
        _ => "sp-muted"                          // pasif vd.
    };

    private static string Metin(VehicleStatus s) => s.ToString();
}
