@using System.Globalization

@* Sunucu-çizimi SVG çubuk grafik (CSP script-src 'self' → JS'siz; renkler CSS token .dv-fN → dark-mode
   otomatik). Tekli/gruplu dikey çubuk + opsiyonel ÇİZGİ overlay (ör. Net Kâr — 12 ay × 3 seri 36 çubuk
   mobilde okunmazdı; 2 çubuk + çizgi). Negatif değerler taban çizgisinin ALTINA çizilir (çizgi serisi
   için tipik). Erişilebilirlik: role="img" + aria-label, çubuk başına <title> tooltip, ekran-okuyucu
   için gizli veri tablosu (.sr-only) — grafik yalnız renge dayanmaz, değerler tabloda. *@
<figure class="svg-chart">
    @if (!string.IsNullOrEmpty(Baslik)) { <figcaption>@Baslik</figcaption> }
    <svg viewBox="0 0 @W @H" role="img" aria-label="@AriaLabel" preserveAspectRatio="xMidYMid meet">
        @* y-eksen çizgileri + etiketleri (0, orta, max — negatif varsa min) *@
        @foreach (var t in Ticks())
        {
            <line x1="@PadL" y1="@S(Y(t))" x2="@(W - PadR)" y2="@S(Y(t))" class="ch-grid" />
            @SvgText(PadL - 6, Y(t) + 4, "ch-ytick", "end", Short(t))
        }
        @* taban çizgisi (0) *@
        <line x1="@PadL" y1="@S(Y(0m))" x2="@(W - PadR)" y2="@S(Y(0m))" class="ch-axis" />

        @* çubuklar: her etiket için seri grubu *@
        @for (int i = 0; i < Etiketler.Count; i++)
        {
            var gx = GroupX(i);
            for (int s = 0; s < Seriler.Count; s++)
            {
                var v = Value(Seriler[s], i);
                var y0 = Y(0m); var yv = Y(v);
                var yTop = Math.Min(y0, yv); var h = Math.Abs(y0 - yv);
                <rect x="@S(gx + s * (BarW + 2))" y="@S(yTop)" width="@S(BarW)" height="@S(Math.Max(h, v == 0m ? 0 : 1))"
                      class="dv-f@(Seriler[s].RenkIndeks)" rx="1.5">
                    <title>@Etiketler[i] — @Seriler[s].Ad: @Fmt(v)</title>
                </rect>
            }
            @SvgText(gx + GrupW / 2, H - 6, "ch-xtick", "middle", Etiketler[i])
        }

        @* opsiyonel çizgi overlay (ör. Net Kâr) — nokta + polyline *@
        @if (CizgiSeri is not null)
        {
            <polyline points="@LinePoints()" class="ch-line dv-s@(CizgiSeri.RenkIndeks)" fill="none" />
            @for (int i = 0; i < Etiketler.Count; i++)
            {
                var v = Value(CizgiSeri, i);
                <circle cx="@S(GroupX(i) + GrupW / 2)" cy="@S(Y(v))" r="3" class="dv-f@(CizgiSeri.RenkIndeks)">
                    <title>@Etiketler[i] — @CizgiSeri.Ad: @Fmt(v)</title>
                </circle>
            }
        }
    </svg>
    <div class="ch-legend">
        @foreach (var s in Seriler) { <span class="ch-leg"><span class="ch-swatch dv-b@(s.RenkIndeks)"></span>@s.Ad</span> }
        @if (CizgiSeri is not null) { <span class="ch-leg"><span class="ch-swatch ch-swatch-line dv-b@(CizgiSeri.RenkIndeks)"></span>@CizgiSeri.Ad (çizgi)</span> }
    </div>
    @* Ekran okuyucu / veri fallback tablosu *@
    <table class="sr-only">
        <caption>@AriaLabel</caption>
        <thead><tr><th>Dönem</th>@foreach (var s in AllSeries()) { <th>@s.Ad</th> }</tr></thead>
        <tbody>
            @for (int i = 0; i < Etiketler.Count; i++)
            {
                <tr><td>@Etiketler[i]</td>@foreach (var s in AllSeries()) { <td>@Fmt(Value(s, i))</td> }</tr>
            }
        </tbody>
    </table>
</figure>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Etiketler { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<SvgSeri> Seriler { get; set; } = [];
    [Parameter] public SvgSeri? CizgiSeri { get; set; }
    [Parameter] public string? Baslik { get; set; }
    [Parameter] public Func<decimal, string>? Format { get; set; }

    private const int W = 720, H = 240, PadL = 56, PadR = 8, PadT = 10, PadB = 26;

    private string AriaLabel => Baslik ?? "Çubuk grafik";
    private string Fmt(decimal v) => Format?.Invoke(v) ?? v.ToString("N0");

    private static decimal Value(SvgSeri s, int i) => i < s.Degerler.Count ? s.Degerler[i] : 0m;
    private IEnumerable<SvgSeri> AllSeries() => CizgiSeri is null ? Seriler : Seriler.Append(CizgiSeri);

    private decimal Min => Math.Min(0m, AllSeries().SelectMany(s => s.Degerler).DefaultIfEmpty(0m).Min());
    private decimal Max
    {
        get
        {
            var m = AllSeries().SelectMany(s => s.Degerler).DefaultIfEmpty(0m).Max();
            return m <= Min ? Min + 1m : m; // max<=min guard (tümü 0/negatif) → düz taban, bölme sıfırlanmaz
        }
    }

    // Değer → y pikseli (üst=PadT, alt=H-PadB). decimal hassasiyetle oranla, double'a en sonda in.
    private double Y(decimal v)
    {
        var rate = (double)((v - Min) / (Max - Min));
        return (H - PadB) - rate * (H - PadB - PadT);
    }

    private double GrupW => (double)(W - PadL - PadR) / Math.Max(1, Etiketler.Count);
    private double BarW => Math.Max(3, (GrupW - 8) / Math.Max(1, Seriler.Count) - 2);
    private double GroupX(int i) => PadL + i * GrupW + (GrupW - (BarW + 2) * Math.Max(1, Seriler.Count)) / 2;

    private IEnumerable<decimal> Ticks()
    {
        yield return Max;
        yield return (Min + Max) / 2;
        if (Min < 0m) yield return Min;
    }

    private string LinePoints() => string.Join(" ",
        Enumerable.Range(0, Etiketler.Count).Select(i =>
            $"{S(GroupX(i) + GrupW / 2)},{S(Y(Value(CizgiSeri!, i)))}"));

    // SVG öznitelikleri InvariantCulture ister (tr-TR virgül basar → bozuk SVG).
    private static string S(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    // Razor'da <text> özel anahtar-etiket (RZ1023) → SVG text elemanı MarkupString ile basılır.
    // İçerik HtmlEncode'lu (etiketler veriden gelebilir — XSS çiti).
    private static MarkupString SvgText(double x, double y, string cls, string anchor, string content)
        => (MarkupString)$"<text x=\"{S(x)}\" y=\"{S(y)}\" class=\"{cls}\" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(content)}</text>";

    private static string Short(decimal v) => Math.Abs(v) switch
    {
        >= 1_000_000m => (v / 1_000_000m).ToString("0.#") + "M",
        >= 1_000m => (v / 1_000m).ToString("0.#") + "K",
        _ => v.ToString("0.#")
    };
}
