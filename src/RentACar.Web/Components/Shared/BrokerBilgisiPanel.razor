@* FAZ-48 — "Brokerden Gelen Bilgisi" (OTA/kanal bileşen bedelleri). Rezervasyon oluştur ve düzenle
   formlarının İKİSİ de bunu kullanır (8 alan iki yerde kopyalanmasın; alan adları POST'ta birebir aynı).

   ÖNEMLİ (KARARLAR genel politikası): bu alanlar SALT BİLGİDİR — fiyat motoru, kira tutarı, cari
   bakiye veya muhasebe defteri bunları OKUMAZ. Kanaldan gelen dökümü kaydetmeye yarar; gerçek para
   hareketi her zaman Kasa/Banka tahsilat-ödeme akışından geçer. *@
<details>
    <summary class="link">Brokerden Gelen Bilgisi (bilgi amaçlı — fiyata/deftere yansımaz)</summary>
    <div class="grid-form">
        <label>Kira Bedeli<input name="otaKiraBedeli" type="number" step="0.01" min="0" value="@Fmt(KiraBedeli)" /></label>
        <label>Drop Bedeli<input name="otaDropBedeli" type="number" step="0.01" min="0" value="@Fmt(DropBedeli)" /></label>
        <label>Bebek Koltuğu<input name="otaBebekKoltugu" type="number" step="0.01" min="0" value="@Fmt(BebekKoltugu)" /></label>
        <label>Navigasyon<input name="otaNavigasyon" type="number" step="0.01" min="0" value="@Fmt(Navigasyon)" /></label>
        <label>LCF<input name="otaLcf" type="number" step="0.01" min="0" value="@Fmt(Lcf)" /></label>
        <label>CDW<input name="otaCdw" type="number" step="0.01" min="0" value="@Fmt(Cdw)" /></label>
        <label>SCDW<input name="otaScdw" type="number" step="0.01" min="0" value="@Fmt(Scdw)" /></label>
        <label>Ek Sürücü<input name="otaEkSurucu" type="number" step="0.01" min="0" value="@Fmt(EkSurucu)" /></label>
    </div>
</details>

@code {
    [Parameter] public decimal? KiraBedeli { get; set; }
    [Parameter] public decimal? DropBedeli { get; set; }
    [Parameter] public decimal? BebekKoltugu { get; set; }
    [Parameter] public decimal? Navigasyon { get; set; }
    [Parameter] public decimal? Lcf { get; set; }
    [Parameter] public decimal? Cdw { get; set; }
    [Parameter] public decimal? Scdw { get; set; }
    [Parameter] public decimal? EkSurucu { get; set; }

    /// <summary>Prefill DAİMA InvariantCulture: number input'u "1234,50" değerini reddeder (boş görünür),
    /// FormParse.Dec de Invariant okur — yerel kültürle basmak her round-trip'te sessiz veri kaybıdır.</summary>
    private static string? Fmt(decimal? d)
        => d?.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
