<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Geliştirme sırları (Seed:Parola, Platform:AdminPasswordHash…) repoda değil user-secrets'ta
         (dotnet user-secrets set Seed:Parola …; bkz. CLAUDE.md §7). -->
    <UserSecretsId>rentacar-web-7f447107-3b01-43af-bc1a-d1b6cf1b4000</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RentACar.Application\RentACar.Application.csproj" />
    <ProjectReference Include="..\RentACar.Infrastructure\RentACar.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- dotnet ef CLI'nin Web'i startup project olarak kullanabilmesi için -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <!-- Rapor export (roadmap B1): Excel (.xlsx) -->
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <!-- PDF export (roadmap F4): sözleşme/fatura -->
    <PackageReference Include="QuestPDF" />
    <!-- Back-office interaktif grid (Radzen DataGrid) — ağır liste ekranları için. -->
    <PackageReference Include="Radzen.Blazor" />
    <!-- F1.2: /api/ui/v1 OpenAPI belgesi (yalnız Development; anlık görüntü docs/api/ui-v1.json) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sözleşme ekspertiz araç şeması (orijinal YÜCE RENT sözleşmesinden) — PDF'e gömülü. -->
    <EmbeddedResource Include="Reports/ekspertiz-sema.png" />
  </ItemGroup>

</Project>
